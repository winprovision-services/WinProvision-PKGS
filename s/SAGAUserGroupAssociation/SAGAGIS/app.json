{"architectures":["x64","x86"],"id":"SAGAUserGroupAssociation.SAGAGIS","latestVersion":"9.2.0","media":{"icons":[],"screenshots":[]},"package":{"description":"System for Automated Geoscientific Analyses","license":"GPL","licenseUrl":"https://www.gnu.org/licenses/old-licenses/gpl-2.0.html","locale":"en-US","localizations":{"en-US":{"description":"System for Automated Geoscientific Analyses","license":"GPL","licenseUrl":"https://www.gnu.org/licenses/old-licenses/gpl-2.0.html","locale":"en-US","longDescription":"SAGA GIS (System for Automated Geoscientific Analyses) is a free and open source geographic information system used for editing and analysing spatial data. It includes a large number of modules for the analysis of vector (point, line and polygon), table, grid and image data. Among others the package includes modules for geostatistics, image classification, projections, simulation of dynamic processes (hydrology, landscape development) and terrain analysis. The functionality can be accessed through a GUI, the command line or by using the C++ API.","moniker":"saga","name":"SAGA - System for Automated Geoscientific Analyses","packageUrl":"http://www.saga-gis.org/en/index.html","publisher":"SAGA User Group Association","publisherUrl":"https://sourceforge.net/projects/saga-gis/","releaseNotesUrl":"https://sourceforge.net/p/saga-gis/wiki/Changelog%209.2.0/attachment/changelog_saga_9.2.0.txt","tags":["geography","geospatial","gis","point-cloud","raster","science","simulation","topography","vector"]}},"longDescription":"SAGA GIS (System for Automated Geoscientific Analyses) is a free and open source geographic information system used for editing and analysing spatial data. It includes a large number of modules for the analysis of vector (point, line and polygon), table, grid and image data. Among others the package includes modules for geostatistics, image classification, projections, simulation of dynamic processes (hydrology, landscape development) and terrain analysis. The functionality can be accessed through a GUI, the command line or by using the C++ API.","moniker":"saga","name":"SAGA - System for Automated Geoscientific Analyses","packageUrl":"http://www.saga-gis.org/en/index.html","publisher":"SAGA User Group Association","publisherUrl":"https://sourceforge.net/projects/saga-gis/","releaseNotesUrl":"https://sourceforge.net/p/saga-gis/wiki/Changelog%209.2.0/attachment/changelog_saga_9.2.0.txt","tags":["geography","geospatial","gis","point-cloud","raster","science","simulation","topography","vector"]},"schemaVersion":1,"source":"winget","versions":[{"architectures":["x64"],"detailPath":"versions/9.2.0/app.json","detailSha256":"60be6f98739e207f3982198f532ece87b98c427b2513e752dafedca1146e5e05","releaseDate":"2023-10-05","releaseDateSource":"manifest","version":"9.2.0"},{"architectures":["x64","x86"],"detailPath":"versions/8.5.0/app.json","detailSha256":"626dfedc2926f681a5a5febb08f653d1e4ca8af965c678974bbc6138d0262443","releaseDate":"2022-12-20","releaseDateSource":"manifest","version":"8.5.0"},{"architectures":["x64","x86"],"detailPath":"versions/8.2.2/app.json","detailSha256":"8f2c909d743dc29ffe5df3b153a5f1f277407c1076d64769af3def563114332f","releaseDate":"2022-06-14","releaseDateSource":"manifest","version":"8.2.2"},{"architectures":["x64","x86"],"detailPath":"versions/8.2.1.0/app.json","detailSha256":"1c30b8aa24db858dc3e52078b8a27a0ffec7d10ecf6822bf88eca3328f51eb45","releaseDate":"2022-04-20","releaseDateSource":"manifest","version":"8.2.1.0"},{"architectures":["x64","x86"],"detailPath":"versions/8.2.0.0/app.json","detailSha256":"36b8b04d80b00647f27f28bc84117b855abfa2fddb730d704d926cb57ba0387f","releaseDate":"2022-03-30","releaseDateSource":"manifest","version":"8.2.0.0"},{"architectures":["x64","x86"],"detailPath":"versions/8.1.3.0/app.json","detailSha256":"8674d43cc45ae2a8793b9b998f091004998793cb7ddba638e77e256c6f3476c1","releaseDate":"2022-03-14","releaseDateSource":"manifest","version":"8.1.3.0"},{"architectures":["x6