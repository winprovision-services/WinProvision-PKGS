{"defaultLocale":"en-US","id":"smartmontools.smartmontools","installers":[{"appsAndFeaturesEntries":[{"DisplayName":"smartmontools","InstallerType":"nullsoft","ProductCode":"smartmontools","Publisher":"smartmontools.org"}],"architecture":"x64","dependencies":[],"elevation":{"requirement":"elevationRequired","source":"inferred"},"id":"x64-machine-nullsoft","installModes":["interactive","silent"],"minimumOSVersion":"10.0.0.0","platforms":["Windows.Desktop"],"priority":1,"scope":"machine","sha256":"6fcdfd72f486f74700810ff1b8016ec842a3495990f356c2f76b984cbbc89e2a","silent":{"arguments":"/S","source":"default"},"successCodes":[],"type":"nullsoft","upgradeBehavior":"install","url":"https://sourceforge.net/projects/smartmontools/files/smartmontools/7.3/smartmontools-7.3-1.win32-setup.exe/download"}],"licenseUrl":"https://sourceforge.net/p/smartmontools/code/HEAD/tree/tags/RELEASE_7_3/smartmontools/COPYING","packageLocalizations":{"en-US":{"description":"smartmontools contains utility programs (smartctl, smartd) to control/monitor storage systems using the Self-Monitoring, Analysis and Reporting Technology System (S.M.A.R.T.) built into most modern ATA and SCSI disks. It is derived from smartsuite.","license":"GNU GPL version 2","licenseUrl":"https://sourceforge.net/p/smartmontools/code/HEAD/tree/tags/RELEASE_7_3/smartmontools/COPYING","locale":"en-US","longDescription":"The smartmontools package contains two utility programs (smartctl and smartd) to control and monitor storage systems using the Self-Monitoring, Analysis and Reporting Technology System (SMART) built into most modern ATA/SATA, SCSI/SAS and NVMe disks.\nIn many cases, these utilities will provide advanced warning of disk degradation and failure.\nSmartmontools was originally derived from the Linux ​smartsuite package and actually supports ATA/SATA, SCSI/SAS and NVMe disks and also SCSI/SAS tape devices.\nIt should run on any modern Linux, FreeBSD, NetBSD, OpenBSD, Darwin (macOS), Solaris, Windows, Cygwin, OS/2, eComStation or QNX system.\nSmartmontools can also be run from one of many different Live CDs/DVDs.","moniker":"smartmontools","name":"smartmontools","packageUrl":"https://sourceforge.net/projects/smartmontools","publisher":"smartmontools.org","publisherUrl":"https://www.smartmontools.org/","releaseNotesUrl":"https://sourceforge.net/p/smartmontools/code/HEAD/tree/tags/RELEASE_7_3/smartmontools/ChangeLog","tags":["disk-monitoring","disk-utility","s.m.a.r.t","smartctl","smartd"]}},"publisherUrl":"https://www.smartmontools.org/","releaseDate":"2022-02-28","releaseDateSource":"manifest","releaseNotesUrl":"https://sourceforge.net/p/smartmontools/code/HEAD/tree/tags/RELEASE_7_3/smartmontools/ChangeLog","schemaVersion":1,"source":"winget","upstream":{"commit":"97d6aa2689f0a05f7847653a62b8624720d15b5d","manifestVersion":"1.9.0","manifests":[{"path":"manifests/s/smartmontools/smartmontools/7.3 2022-02-28 r5338 (sf-7.3-1)/smartmontools.smartmontools.yaml","sha256":"15a85dada5ad9897426b4ce7eb25844a8c84fec0450bc453146fd8ea283fa1c0"},{"path":"manifests/s/smartmontools/smartmontools/7.3 2022-02-28 r5338 (sf-7.3-1)/smartmontools.smartmontools.installer.yaml","sha256":"227f5b644ab3525e82661c8d38799d78a679df9b97e1d39a2f8cad317b8944dd"},{"path":"manifests/s/smartmontools/smartmontools/7.3 2022-02-28 r5338 (sf-7.3-1)/smartmontools.smartmontools.locale.en-US.yaml","sha256":"08ea962146c9ae31272e379987be243f5554eef8e1ba664183eb2265d04a8cdd"}],"repository":"microsoft/winget-pkgs"},"version":"7.3 2022-02-28 r5338 (sf-7.3-1)"}