{"architectures":["x64"],"id":"SosomLab.NexaDir.Portable","latestVersion":"0.29.0","media":{"icons":[],"screenshots":[]},"package":{"description":"Lightweight dual-panel file explorer that looks identical on Windows, macOS and Linux (portable)","license":"PolyForm Noncommercial 1.0.0","licenseUrl":"https://github.com/SosomLab/nexa-dir3/blob/main/LICENSE.md","locale":"en-US","localizations":{"en-US":{"description":"Lightweight dual-panel file explorer that looks identical on Windows, macOS and Linux (portable)","license":"PolyForm Noncommercial 1.0.0","licenseUrl":"https://github.com/SosomLab/nexa-dir3/blob/main/LICENSE.md","locale":"en-US","longDescription":"A lightweight dual-panel file explorer that looks and behaves the same on\nWindows, macOS and Linux. It is a single statically linked executable written\nentirely in Rust and draws its own UI - no Qt, WebView or Electron.\n\nPortable build: unzip and run. Create a data folder next to nexa-dir.exe to\nkeep settings there; otherwise they live in %APPDATA%\\nexa-dir.\n\nFeatures: tabs, inline tree, preview pane (text, images, archive listings,\nWASM plugins), built-in terminal, batch rename, checksums, duplicate finder,\nfolder compare and sync, fast copy, favorites, trash with restore.\n\nLicense: PolyForm Noncommercial 1.0.0 - free for noncommercial use only;\ncommercial use requires a license.","moniker":"nexa-dir-portable","name":"Nexa Dir (Portable)","packageUrl":"https://github.com/SosomLab/nexa-dir3","publisher":"SosomLab","publisherUrl":"https://github.com/SosomLab","releaseNotesUrl":"https://github.com/SosomLab/nexa-dir3/releases/tag/v0.29.0","tags":["file-manager","file-explorer","dual-panel","cross-platform","portable"]}},"longDescription":"A lightweight dual-panel file explorer that looks and behaves the same on\nWindows, macOS and Linux. It is a single statically linked executable written\nentirely in Rust and draws its own UI - no Qt, WebView or Electron.\n\nPortable build: unzip and run. Create a data folder next to nexa-dir.exe to\nkeep settings there; otherwise they live in %APPDATA%\\nexa-dir.\n\nFeatures: tabs, inline tree, preview pane (text, images, archive listings,\nWASM plugins), built-in terminal, batch rename, checksums, duplicate finder,\nfolder compare and sync, fast copy, favorites, trash with restore.\n\nLicense: PolyForm Noncommercial 1.0.0 - free for noncommercial use only;\ncommercial use requires a license.","moniker":"nexa-dir-portable","name":"Nexa Dir (Portable)","packageUrl":"https://github.com/SosomLab/nexa-dir3","publisher":"SosomLab","publisherUrl":"https://github.com/SosomLab","releaseNotesUrl":"https://github.com/SosomLab/nexa-dir3/releases/tag/v0.29.0","tags":["file-manager","file-explorer","dual-panel","cross-platform","portable"]},"schemaVersion":1,"source":"winget","versions":[{"architectures":["x64"],"detailPath":"versions/0.29.0/app.json","detailSha256":"941a329f9823455a30c33a5b18bc0f45309e5b34b2ca65dd45b094a607d270d9","releaseDate":"2026-11-03","releaseDateSource":"manifest","version":"0.29.0"},{"architectures":["x64"],"detailPath":"versions/0.28.0/app.json","detailSha256":"3a6a85273d5671d012ee7b3ecc73c18c9fdc8251968c41b84a67af684c8e7dea","releaseDate":"2026-11-01","releaseDateSource":"manifest","version":"0.28.0"},{"architectures":["x64"],"detailPath":"versions/0.27.0/app.json","detailSha256":"5d401b7339982ea5ad525841a8bd42da35e346b7a24fc78bbe815f5c4c98ebe6","releaseDate":"2026-10-26","releaseDateSource":"manifest","version":"0.27.0"},{"architectures":["x64"],"detailPath":"versions/0.26.0/app.json","detailSha256":"392f7b070f2f2e2c1f57d3c43d2d3095054c60228f74b37a82ce6c03d79d543d","releaseDate":"2026-10-20","releaseDateSource":"manifest","version":"0.26.0"},{"architectures":["x64"],"detailPath":"versions/0.25.0/app.json","detailSha256":"4e43065eb600b1e24dac48010d26b2a65343d988224bc32a39edc10104ad8f8f","releaseDate":"2026-10-18","releaseDateSource":"manifest","version":"0.25.0"},{"architectures":["x64"],"detailPath":"versions/0.