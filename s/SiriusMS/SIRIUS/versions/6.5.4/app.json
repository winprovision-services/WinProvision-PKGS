{"defaultLocale":"en-US","id":"SiriusMS.SIRIUS","installers":[{"appsAndFeaturesEntries":[{"UpgradeCode":"{5E660105-397C-4AB7-8D7E-69B4CE2C9564}"}],"architecture":"x64","commands":["sirius"],"dependencies":[],"elevation":{"requirement":"elevationRequired","source":"inferred"},"id":"x64-machine-wix","installerSwitches":{"InstallLocation":"INSTALLDIR=\"<INSTALLPATH>\""},"priority":2,"scope":"machine","sha256":"0254ad8fddc51196dd78e94c894c13158d328eb7c22c2047d14fb76209bed590","silent":{"arguments":"/quiet /norestart","source":"default"},"successCodes":[],"type":"wix","uninstall":{"type":"productCode","value":"{6F280E25-28C9-3329-9DD5-53B88EE26C99}"},"url":"https://github.com/sirius-ms/sirius/releases/download/v6.5.4/sirius-6.5.4-win-x64.msi"}],"licenseUrl":"https://github.com/sirius-ms/sirius/blob/HEAD/LICENSE.txt","packageLocalizations":{"en-US":{"description":"A software framework for the de-novo identification of metabolites using tandem mass spectrometry","license":"AGPL-3.0","licenseUrl":"https://github.com/sirius-ms/sirius/blob/HEAD/LICENSE.txt","locale":"en-US","longDescription":"SIRIUS is a Java-based software framework for the analysis of LC-MS/MS data of metabolites and other small molecules of biological interest. It integrates a collection of tools, including CSI:FingerID (with COSMIC), ZODIAC and CANOPUS. Both the graphical user interface and the command line version seamlessly integrate the CSI:FingerID, CANOPUS and MSNovelist web services, and the packaged Windows version includes the Java Runtime Environment.","name":"SIRIUS","packageUrl":"https://github.com/sirius-ms/sirius","publisher":"SIRIUS","publisherUrl":"https://github.com/sirius-ms","releaseNotesUrl":"https://v6.docs.sirius-ms.io/changelog/","tags":["bioinformatics","mass-spectrometry","metabolomics"]},"zh-CN":{"description":"用于串联质谱数据的代谢物从头鉴定软件框架","locale":"zh-CN","longDescription":"SIRIUS 是一个基于 Java 的软件框架，用于分析代谢物及其他「生物相关小分子」的 LC-MS/MS 数据。它集成了包括 CSI:FingerID（含 COSMIC）、ZODIAC 和 CANOPUS 在内的一系列工具，图