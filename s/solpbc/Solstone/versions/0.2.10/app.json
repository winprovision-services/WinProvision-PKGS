{"defaultLocale":"en-US","id":"solpbc.Solstone","installers":[{"appsAndFeaturesEntries":[{"DisplayName":"sol","ProductCode":"Solstone"}],"architecture":"x64","dependencies":[{"PackageDependencies":[{"PackageIdentifier":"Microsoft.EdgeWebView2Runtime"}]}],"id":"x64-user-exe","installModes":["silent","silentWithProgress"],"installerSwitches":{"InstallLocation":"--installto \"<INSTALLPATH>\"","Log":"--log \"<LOGPATH>\"","Silent":"--silent","SilentWithProgress":"--silent"},"minimumOSVersion":"10.0.18362.0","priority":1,"scope":"user","sha256":"276e7db783c6e4fc5794a0057e20cfa44763da94756dd7d17ee692da309f123e","silent":{"arguments":"--silent","source":"manifest"},"successCodes":[],"type":"exe","uninstall":{"type":"productCode","value":"Solstone"},"upgradeBehavior":"install","url":"https://github.com/solpbc/solstone-windows/releases/download/v0.2.10/solstone-setup-0.2.10.exe"}],"licenseUrl":"https://github.com/solpbc/solstone-windows/blob/main/LICENSE","packageLocalizations":{"en-US":{"description":"sol for Windows, part of solstone — a per-user, non-elevated, tray-resident app that takes in your screen and system audio (plus the microphone when one is present) and keeps it in local, owner-controlled segments for your journal.","license":"AGPL-3.0-only","licenseUrl":"https://github.com/solpbc/solstone-windows/blob/main/LICENSE","locale":"en-US","longDescription":"solstone is an open-source, privacy-respecting way to collect and gain insight from your own\npersonal data. sol for Windows is a per-user, non-elevated, tray-resident app that takes in what\nhappens on your PC — screen and system audio, plus the microphone when one is present — and keeps\nit in local, owner-controlled segments for your journal.\n\nEverything stays yours: there is no analytics, telemetry, tracking, or crash reporting, and\nnothing phones home. State is always earned — the app never shows 'on' unless it truly is.\nUpdates are delivered by the app itself.","moniker":"solstone","name":"solstone","pac