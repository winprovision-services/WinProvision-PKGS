{"defaultLocale":"en-US","id":"SalvatoreSorvillo.VistaCare","installers":[{"architecture":"x64","commands":["vistacare"],"dependencies":[],"id":"x64-portable","priority":4,"sha256":"d7fd2d6488251aabbd0cb3b31727143698a3d87be2cca3d8cad16f56ff85cd22","successCodes":[],"type":"portable","url":"https://github.com/SalvatoreSorvillo/VistaCare/releases/download/v1.0.0/VistaCare.exe"}],"licenseUrl":"https://github.com/SalvatoreSorvillo/VistaCare/blob/main/LICENSE","packageLocalizations":{"en-US":{"description":"Dim all your monitors below their hardware minimum, via the GPU gamma ramp.","license":"MIT","licenseUrl":"https://github.com/SalvatoreSorvillo/VistaCare/blob/main/LICENSE","locale":"en-US","longDescription":"VistaCare is a tiny single-exe Windows tray app that dims every monitor below its hardware\nminimum by scaling the GPU gamma ramp. Because gamma is applied at the final display stage,\nthe cursor, taskbar, Start menu and fullscreen apps all dim uniformly - no overlay, and none\nof the bright-cursor / bright-taskbar bugs that overlay dimmers have. Includes a tray slider,\nbrightness presets, global hotkeys, a pause toggle, and a configurable evening auto-start.","moniker":"vistacare","name":"VistaCare","packageUrl":"https://github.com/SalvatoreSorvillo/VistaCare","publisher":"Salvatore Sorvillo","publisherUrl":"https://github.com/SalvatoreSorvillo","tags":["screen-dimmer","brightness","monitor","dimmer","dark","eye-strain","night"]}},"publisherUrl":"https://github.com/SalvatoreSorvillo","schemaVersion":1,"source":"winget","upstream":{"commit":"97d6aa2689f0a05f7847653a62b8624720d15b5d","manifestVersion":"1.6.0","manifests":[{"path":"manifests/s/SalvatoreSorvillo/VistaCare/1.0.0/SalvatoreSorvillo.VistaCare.yaml","sha256":"6f96789d220b64a391b0ba762f428d4f304f57c8a46f29bace2ac0a7a9c641b0"},{"path":"manifests/s/SalvatoreSorvillo/VistaCare/1.0.0/SalvatoreSorvillo.VistaCare.installer.yaml","sha256":"c739c29b9f8f43b136476b1ed25c7d3069a91d824ddf38b3132419df4d585f1c"},{"pat