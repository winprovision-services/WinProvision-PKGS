{"architectures":["arm64","x64"],"id":"steipete.discrawl","latestVersion":"0.19.0","media":{"icons":[],"screenshots":[]},"package":{"description":"CLI for Discord with SQLite backend","license":"MIT","licenseUrl":"https://github.com/openclaw/discrawl/blob/HEAD/LICENSE","locale":"en-US","localizations":{"en-US":{"description":"CLI for Discord with SQLite backend","license":"MIT","licenseUrl":"https://github.com/openclaw/discrawl/blob/HEAD/LICENSE","locale":"en-US","longDescription":"discrawl mirrors Discord guild data into local SQLite so you can search, inspect, and query server history without depending on Discord search.\n\nIt is a bot-token crawler. No user-token hacks. Data stays local.\n\nWhat It Does\n- discovers every guild the configured bot can access\n- syncs channels, threads, members, and message history into SQLite\n- maintains FTS5 search indexes for fast local text search\n- builds an offline member directory from archived profile payloads\n- extracts small text-like attachments into the local search index\n- records structured user and role mentions for direct querying\n- tails Gateway events for live updates, with periodic repair syncs\n- exposes read-only SQL for ad hoc analysis\n- keeps schema multi-guild ready while preserving a simple single-guild default UX","moniker":"discrawl","name":"discrawl","packageUrl":"https://github.com/steipete/discrawl","publisher":"Peter Steinberger","publisherUrl":"https://steipete.me/","releaseNotesUrl":"https://github.com/openclaw/discrawl/releases/tag/v0.19.0","tags":[]}},"longDescription":"discrawl mirrors Discord guild data into local SQLite so you can search, inspect, and query server history without depending on Discord search.\n\nIt is a bot-token crawler. No user-token hacks. Data stays local.\n\nWhat It Does\n- discovers every guild the configured bot can access\n- syncs channels, threads, members, and message history into SQLite\n- maintains FTS5 search indexes for fast local text search\n- builds an offline member directory from archived profile payloads\n- extracts small text-like attachments into the local search index\n- records structured user and role mentions for direct querying\n- tails Gateway events for live updates, with periodic repair syncs\n- exposes read-only SQL for ad hoc analysis\n- keeps schema multi-guild ready while preserving a simple single-guild default UX","moniker":"discrawl","name":"discrawl","packageUrl":"https://github.com/steipete/discrawl","publisher":"Peter Steinberger","publisherUrl":"https://steipete.me/","releaseNotesUrl":"https://github.com/openclaw/discrawl/releases/tag/v0.19.0","tags":[]},"schemaVersion":1,"source":"winget","versions":[{"architectures":["arm64","x64"],"detailPath":"versions/0.19.0/app.json","detailSha256":"96be47213d119da0553862bf4ef24bfe08cebcf0f85d83d64777c9939c0b8080","releaseDate":"2026-10-28","releaseDateSource":"manifest","version":"0.19.0"},{"architectures":["arm64","x64"],"detailPath":"versions/0.18.0/app.json","detailSha256":"1eff0f04de73f21ce2b50f56ef8bdd24c0bb652aacb698ada623224383257c0b","releaseDate":"2026-10-27","releaseDateSource":"manifest","version":"0.18.0"},{"architectures":["arm64","x64"],"detailPath":"versions/0.17.0/app.json","detailSha256":"3177fbe67d24bb574ae9e6573727a6fe48e2ffafc56e022831c95a1bc7ecf09a","releaseDate":"2026-10-23","releaseDateSource":"manifest","version":"0.17.0"},{"architectures":["arm64","x64"],"detailPath":"versions/0.16.0/app.json","detailSha256":"d51730345b281db7d19ff5c198fbd14f647c3fcc959dde707447c238596ad441","releaseDate":"2026-10-21","releaseDateSource":"manifest","version":"0.16.0"},{"architectures":["arm64","x64"],"detailPath":"versions/0.15.8/app.json","detailSha256":"3a35e1ec543144fd5bbd87d877a8d08ff1e583fd58c500631e8cbc2675e43de3","releaseDate":"2026-10-16","releaseDateSource":"manifest","version":"0.15.8"},{"architectures":["arm64","x64"],"detailPath":"versions/0.15.7/app.json","detailSha256":"39759abcf91405f1b40f233ae944011e7ca7cd40c130098d9ba99803addb5a7