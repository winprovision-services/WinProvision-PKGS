{"defaultLocale":"en-US","id":"SoftPerfect.ConnectionQualityMonitor","installers":[{"architecture":"x64","dependencies":[],"elevation":{"requirement":"elevationRequired","source":"inferred"},"id":"x64-machine-inno","priority":1,"scope":"machine","sha256":"794afbae856e9b4469afd424e8bd0246ccc7638cfb9750f678f4e8690f312fc4","silent":{"arguments":"/VERYSILENT /SUPPRESSMSGBOXES /NORESTART /SP-","source":"default"},"successCodes":[],"type":"inno","uninstall":{"type":"productCode","value":"{A1E12BB7-59F9-419D-A92F-A28428A4085D}_is1"},"url":"https://www.softperfect.com/download/files/connection_quality_monitor_setup.exe"}],"licenseUrl":"https://www.softperfect.com/company/terms.htm","packageLocalizations":{"en-US":{"description":"Internet connection status tracking","license":"Proprietary","licenseUrl":"https://www.softperfect.com/company/terms.htm","locale":"en-US","longDescription":"Connection Quality Monitor is a software package that monitors the health of your Internet connection. It periodically checks whether the connection is online, and records ping time, jitter and downtime. Additionally, it periodically performs a speed test and records the measured upload and download speeds.\nThis information is presented in a chart, making it easy to spot any intermittent connection issues and verify if download/upload speeds are stable and up to your Internet service provider promises.\nConnection Quality Monitor can be used in multiple locations, for example in several offices connected via VPN, and all its instances can be managed from a single point, such as a network administrator workstation.","name":"Connection Quality Monitor","packageUrl":"https://www.softperfect.com/products/qualitymonitor/","publisher":"SoftPerfect Pty Ltd","publisherUrl":"https://www.softperfect.com/","releaseNotesUrl":"https://www.softperfect.com/products/changelog.php?product_id=20","tags":["connection","connection-quality","internet","network"]},"zh-CN":{"description":"互联网连接状态跟踪","license":"专有软件","locale":"zh-CN","longDescription":"连接质量监测器是一款用于监控互联网连接健康状况的软件包。它会定期检测网络是否在线，并记录 ping 值、抖动和宕机时间。此外，该软件还会周期性进行网速测试，记录实测的上传与下载速度。\n所有监测数据均以图表形式直观呈现，便于用户快速发现间歇性连接问题，并验证下载/上传速度是否稳定达标，是否符合网络服务商的承诺。\n该监测系统支持多地点部署（例如通过 VPN 连接的多个办公场所），所有监测节点均可通过单一控制点（如网络管理员工作站）进行集中管理。","tags":["互联网","网络","连接","连接质量"]}},"publisherUrl":"https://www.softperfect.com/","releaseDate":"2024-09-04","releaseDateSource":"manifest","releaseNotesUrl":"https://www.softperfect.com/products/changelog.php?product_id=20","schemaVersion":1,"source":"winget","upstream":{"commit":"97d6aa2689f0a05f7847653a62b8624720d15b5d","manifestVersion":"1.12.0","manifests":[{"path":"manifests/s/SoftPerfect/ConnectionQualityMonitor/1.1/SoftPerfect.ConnectionQualityMonitor.yaml","sha256":"60137cff35129f957cd21f1a24106d97675946149f871b3fd0c62beb8c343787"},{"path":"manifests/s/SoftPerfect/ConnectionQualityMonitor/1.1/SoftPerfect.ConnectionQualityMonitor.installer.yaml","sha256":"7496f69802a6e653cdb1f9487f20dfea28d9c8d7a8cb38bc734dc71b9b20f1c6"},{"path":"manifests/s/SoftPerfect/ConnectionQualityMonitor/1.1/SoftPerfect.ConnectionQualityMonitor.locale.en-US.yaml","sha256":"104218e6152d39899a7b404538f397682a53da086f66d15a1d1a801e34dea4ba"},{"path":"manifests/s/SoftPerfect/ConnectionQualityMonitor/1.1/SoftPerfect.ConnectionQualityMonitor.locale.zh-CN.yaml","sha256":"1a8b9847d6184b8c1f1b76173392b06eda28e2a616114eab7a3c61ac14134b60"}],"repository":"microsoft/winget-pkgs"},"version":"1.1"}