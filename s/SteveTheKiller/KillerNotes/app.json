{"architectures":["x64"],"id":"SteveTheKiller.KillerNotes","latestVersion":"1.6.1","media":{"icons":[],"screenshots":[]},"package":{"description":"A searchable, encrypted notepad for techs - rich text, inline images, real tables, full-text search, and tear-off .knote sharing.","license":"GPL-3.0","licenseUrl":"https://github.com/SteveTheKiller/KillerNotes/blob/HEAD/LICENSE","locale":"en-US","localizations":{"en-US":{"description":"A searchable, encrypted notepad for techs - rich text, inline images, real tables, full-text search, and tear-off .knote sharing.","license":"GPL-3.0","licenseUrl":"https://github.com/SteveTheKiller/KillerNotes/blob/HEAD/LICENSE","locale":"en-US","longDescription":"KillerNotes is a searchable, encrypted notepad built for techs who live in a dozen Notepad windows. Every note saves itself on every pause, note switch, and close, and full-text search finds any note as fast as you can type. Rich text with inline screenshots, real tables, a full color picker, adjustable font size, and color-coded tags. Optional whole-database SQLCipher AES-256 encryption. Share a note as a tear-off .knote (drag it into Teams or Outlook) or a whole database as .kndb. Opens and exports .txt, .md, .html, .rtf, and images, with a markdown/HTML preview. Single signed exe, portable or one-click install with /silent for RMM, no account, no cloud, no telemetry, GPLv3. Windows 10/11.","moniker":"killernotes","name":"KillerNotes","packageUrl":"https://killernotes.net/","publisher":"Steve the Killer","publisherUrl":"https://thekiller.net/","releaseNotesUrl":"https://github.com/SteveTheKiller/KillerNotes/releases/tag/v1.6.1","tags":["csharp","dotnet","encrypted-notes","encryption","full-text-search","note-taking","notepad","notes","portable","rich-text-editor","sqlcipher","sqlite","sysadmin","windows","wpf"]}},"longDescription":"KillerNotes is a searchable, encrypted notepad built for techs who live in a dozen Notepad windows. Every note saves itself on every pause, note switch, and close, and full-text search finds any note as fast as you can type. Rich text with inline screenshots, real tables, a full color picker, adjustable font size, and color-coded tags. Optional whole-database SQLCipher AES-256 encryption. Share a note as a tear-off .knote (drag it into Teams or Outlook) or a whole database as .kndb. Opens and exports .txt, .md, .html, .rtf, and images, with a markdown/HTML preview. Single signed exe, portable or one-click install with /silent for RMM, no account, no cloud, no telemetry, GPLv3. Windows 10/11.","moniker":"killernotes","name":"KillerNotes","packageUrl":"https://killernotes.net/","publisher":"Steve the Killer","publisherUrl":"https://thekiller.net/","releaseNotesUrl":"https://github.com/SteveTheKiller/KillerNotes/releases/tag/v1.6.1","tags":["csharp","dotnet","encrypted-notes","encryption","full-text-search","note-taking","notepad","notes","portable","rich-text-editor","sqlcipher","sqlite","sysadmin","windows","wpf"]},"schemaVersion":1,"source":"winget","versions":[{"architectures":["x64"],"detailPath":"versions/1.6.1/app.json","detailSha256":"0b6b318e52b7743c083fe13ecd11b9f996a0737dd7cdef7dace50a5861f68344","releaseDate":"2026-11-01","releaseDateSource":"manifest","version":"1.6.1"},{"architectures":["x64"],"detailPath":"versions/1.6.0/app.json","detailSha256":"b6c9349f08c1168149553560a0ad1191329453795e6840cb297b94f2ffb4fd7d","releaseDate":"2026-10-22","releaseDateSource":"manifest","version":"1.6.0"},{"architectures":["x64"],"detailPath":"versions/1.5.1/app.json","detailSha256":"67a8e6e7a36228237ebd6c3abfa75f5bc5f262ba51317cac8ade380f38a2c1ac","releaseDate":"2026-10-19","releaseDateSource":"manifest","version":"1.5.1"},{"architectures":["x64"],"detailPath":"versions/1.5.0/app.json","detailSha256":"9492cb82269831734be9d1b9681b8ba94116a562022b2fa2fe64e15091c5f053","releaseDate":"2026-10-15","releaseDateSource":"manifest","version":"1.5.0"},{"architectures":["x64"],"detailPath":"versions/1.4.3/app.json","detailSha2