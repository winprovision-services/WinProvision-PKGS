{"defaultLocale":"en-US","id":"SteveTheKiller.KillerNotes","installers":[{"appsAndFeaturesEntries":[{"DisplayName":"KillerNotes","DisplayVersion":"1.6.0","ProductCode":"KillerNotes","Publisher":"Steve the Killer"}],"architecture":"x64","dependencies":[],"elevation":{"requirement":"elevationRequired","source":"inferred"},"fileExtensions":["kndb","knote"],"id":"x64-machine-exe","installModes":["silent","silentWithProgress"],"installerSwitches":{"Silent":"/silent","SilentWithProgress":"/silent"},"priority":1,"scope":"machine","sha256":"3d70ab43a85a0b384928d9d33798195e728d1a865c16251a28bb38f3b55bf144","silent":{"arguments":"/silent","source":"manifest"},"successCodes":[],"type":"exe","upgradeBehavior":"install","url":"https://github.com/SteveTheKiller/KillerNotes/releases/download/v1.6.0/KillerNotes.exe"}],"licenseUrl":"https://github.com/SteveTheKiller/KillerNotes/blob/HEAD/LICENSE","packageLocalizations":{"en-US":{"description":"A searchable, encrypted notepad for techs - rich text, inline images, real tables, full-text search, and tear-off .knote sharing.","license":"GPL-3.0","licenseUrl":"https://github.com/SteveTheKiller/KillerNotes/blob/HEAD/LICENSE","locale":"en-US","longDescription":"KillerNotes is a searchable, encrypted notepad built for techs who live in a dozen Notepad windows. Every note saves itself on every pause, note switch, and close, and full-text search finds any note as fast as you can type. Rich text with inline screenshots, real tables, a full color picker, adjustable font size, and color-coded tags. Optional whole-database SQLCipher AES-256 encryption. Share a note as a tear-off .knote (drag it into Teams or Outlook) or a whole database as .kndb. Opens and exports .txt, .md, .html, .rtf, and images, with a markdown/HTML preview. Single signed exe, portable or one-click install with /silent for RMM, no account, no cloud, no telemetry, GPLv3. Windows 10/11.","moniker":"killernotes","name":"KillerNotes","packageUrl":"https://killernotes.net/","publi