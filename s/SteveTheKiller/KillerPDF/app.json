{"architectures":["x64"],"id":"SteveTheKiller.KillerPDF","latestVersion":"1.9.2","media":{"icons":[],"screenshots":[]},"package":{"description":"PDF editor for Windows. No account, no subscription, no telemetry.","license":"GPL-3.0","licenseUrl":"https://github.com/SteveTheKiller/KillerPDF/blob/HEAD/LICENSE","locale":"en-US","localizations":{"en-US":{"description":"PDF editor for Windows. No account, no subscription, no telemetry.","license":"GPL-3.0","licenseUrl":"https://github.com/SteveTheKiller/KillerPDF/blob/HEAD/LICENSE","locale":"en-US","longDescription":"KillerPDF is a free, open-source PDF editor for Windows. View, annotate, edit text and paragraphs, OCR, merge, split, sign and verify signatures, fill and build forms, redact, protect, compare, print and flatten PDFs, export them to Word, Excel, PowerPoint, HTML or Markdown, and repeat the work with macros, watched folders and the command line, all without an Adobe subscription. WinGet installs machine-wide; the downloadable installer also supports per-user installation, and a separate portable build is available. Document processing stays on your computer, with no account, no subscription, and no telemetry. Open source under GPLv3.","moniker":"killerpdf","name":"KillerPDF","packageUrl":"https://github.com/SteveTheKiller/KillerPDF","publisher":"Steve the Killer","publisherUrl":"https://github.com/SteveTheKiller","releaseNotesUrl":"https://github.com/SteveTheKiller/KillerPDF/releases/tag/v1.9.2","tags":["dotnet","gplv3","ocr","opensource","pdf","pdf-editor","portable","redaction","windows","wpf"]}},"longDescription":"KillerPDF is a free, open-source PDF editor for Windows. View, annotate, edit text and paragraphs, OCR, merge, split, sign and verify signatures, fill and build forms, redact, protect, compare, print and flatten PDFs, export them to Word, Excel, PowerPoint, HTML or Markdown, and repeat the work with macros, watched folders and the command line, all without an Adobe subscription. WinGet installs m