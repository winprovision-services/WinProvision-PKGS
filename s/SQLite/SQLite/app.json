{"architectures":["arm64","x64","x86"],"id":"SQLite.SQLite","latestVersion":"3.54.1","media":{"icons":[],"screenshots":[]},"package":{"description":"Self-contained transactional SQL database engine","license":"Public Domain","locale":"en-US","localizations":{"en-US":{"description":"Self-contained transactional SQL database engine","license":"Public Domain","locale":"en-US","longDescription":"SQLite is an in-process library that implements a self-contained, serverless, zero-configuration, transactional SQL database engine.\nSQLite is an embedded SQL database engine.\nUnlike most other SQL databases, SQLite does not have a separate server process.\nSQLite reads and writes directly to ordinary disk files.\nA complete SQL database with multiple tables, indices, triggers, and views, is contained in a single disk file.","name":"SQLite","packageUrl":"https://sqlite.org/","publisher":"SQLite","publisherUrl":"https://sqlite.org/","tags":["sqlite","sqlite3"]}},"longDescription":"SQLite is an in-process library that implements a self-contained, serverless, zero-configuration, transactional SQL database engine.\nSQLite is an embedded SQL database engine.\nUnlike most other SQL databases, SQLite does not have a separate server process.\nSQLite reads and writes directly to ordinary disk files.\nA complete SQL database with multiple tables, indices, triggers, and views, is contained in a single disk file.","name":"SQLite","packageUrl":"https://sqlite.org/","publisher":"SQLite","publisherUrl":"https://sqlite.org/","tags":["sqlite","sqlite3"]},"schemaVersion":1,"source":"winget","versions":[{"architectures":["arm64","x64"],"detailPath":"versions/3.54.1/app.json","detailSha256":"1c154171b3c9253fca22269a41a1d2594b7fe2f92fa72363c08d39e5b11ea5ca","releaseDate":"2026-10-16","releaseDateSource":"manifest","version":"3.54.1"},{"architectures":["arm64","x64"],"detailPath":"versions/3.54.0/app.json","detailSha256":"2b903a18410a10cbfd9e04df12bc6c37d94abf29c5bc0efecd99169359bb17d3","releaseDat