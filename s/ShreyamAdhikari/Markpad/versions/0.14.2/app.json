{"defaultLocale":"en-US","id":"ShreyamAdhikari.Markpad","installers":[{"architecture":"x64","dependencies":[],"elevation":{"requirement":"elevationRequired","source":"inferred"},"id":"x64-machine-nullsoft","installModes":["interactive","silent"],"locale":"en-US","priority":1,"scope":"machine","sha256":"9e9a036a83249704edb818b1b20044db519945884363649e0bb2605a0f27f0a9","silent":{"arguments":"/S","source":"default"},"successCodes":[],"type":"nullsoft","upgradeBehavior":"install","url":"https://github.com/shreyam1008/markpad/releases/download/v0.14.2/markpad-setup.exe"}],"licenseUrl":"https://github.com/shreyam1008/markpad/blob/main/LICENSE","packageLocalizations":{"en-US":{"description":"Quillpane is a small native Markdown notepad and local-file viewer","license":"MIT","licenseUrl":"https://github.com/shreyam1008/markpad/blob/main/LICENSE","locale":"en-US","longDescription":"Quillpane (formerly Markpad) is a small native Markdown notepad and\nlocal-file viewer built with Go, Wails, and the operating system webview.\nSessions, drafts, and version history stay local, with no account, sync\nservice, or telemetry.\n\nFeatures include Markdown editor, split, and preview modes; bounded local\nhistory and recovery drafts; syntax-highlighted source viewing; command\npalette and keyboard navigation; local image preview; and external PDF\nhandoff to the system viewer. Markdown task files provide List, Board, and\nCalendar views with workflow columns, tags, due dates, custom colors, highlighted\nsearch, context actions, and recoverable task Trash.","moniker":"quillpane","name":"Quillpane","packageUrl":"https://quillpane.shreyam1008.com.np/","publisher":"Shreyam Adhikari","publisherUrl":"https://shreyam1008.com.np/","releaseNotesUrl":"https://github.com/shreyam1008/markpad/releases/tag/v0.14.2","tags":["markdown","notepad","editor","note","notes","text-editor","writer","local","offline"]}},"publisherUrl":"https://shreyam1008.com.np/","releaseNotesUrl":"https://github.com/shreyam1