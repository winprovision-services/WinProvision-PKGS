Kiwi Log Viewer.exe"}],"nestedInstallerType":"exe","priority":4,"scope":"machine","sha256":"78d1f3e8abad4f0ed56bc06e1260aff95f35c9eacf50de2a253c29f413d8880d","silent":{"arguments":"/quiet /norestart","source":"manifest"},"successCodes":[],"type":"zip","uninstall":{"type":"productCode","value":"{DE6321E3-E6CD-4C89-A8BA-B06D87742D6A}"},"url":"https://downloads.solarwinds.com/solarwinds/Release/Kiwi-KLV/SolarWinds-Kiwi-LogViewer-Eval.zip"}],"licenseUrl":"https://www.solarwinds.com/legal/eula","packageLocalizations":{"en-US":{"author":"SolarWinds, Inc.","copyright":"Copyright © 2026 SolarWinds, Inc. All rights reserved.","description":"Log analysis tool for displaying text-based log files in a tabular format with color highlighting","license":"Proprietary","licenseUrl":"https://www.solarwinds.com/legal/eula","locale":"en-US","longDescription":"Kiwi Log Viewer is a handy tool for monitoring log files. It displays text-based log files in a simple tabular format, and selected rows can be copied in tab-delimited format.\nEasily monitor log files for specific keywords, phrases, or patterns. Text string matching allows important text to be automatically highlighted by using colors or bold and italic font emphasis, with matching options including simple substring matching or more powerful PERL-style regular expression (regex) matching.\nFile tailing displays new entries to a specified log file in real time. Chunk mode saves memory by reading only a small section of the file from disk at a time, so Kiwi Log Viewer can read files up to 14 TB (if the OS supports it) even when they are too big to fit in memory.","name":"SolarWinds Kiwi Log Viewer","packageUrl":"https://www.solarwinds.com/kiwi-log-viewer","privacyUrl":"https://www.solarwinds.com/legal/privacy","publisher":"SolarWinds, Inc.","publisherSupportUrl":"https://support.solarwinds.com/","publisherUrl":"https://www.solarwinds.com/","tags":["log-analysis","log-viewer","logs"]},"zh-CN":{"description":"以表格形式显示文本日志文件并支持颜色突出显示的日志分析工具","license":"专有软件","locale":"zh-CN","longDescription":"Kiwi Log Viewer 是一款实用的日志监视工具。它以简洁的表格形式显示文本日志文件，选中的行可以制表符分隔格式复制。\n轻松监视日志文件中的特定关键字、短语或模式。文本字符串匹配可让重要文本自动以颜色或粗体、斜体字体突出显示，匹配方式包括简单子字符串匹配或更强大的 PERL 风格正则表达式（regex）匹配。\n文件尾随（file tailing）可实时显示指定日志文件的新增条目。分块模式每次仅从磁盘读取文件的一小部分以节省内存，因此即使日志文件过大无法载入内存，Kiwi Log Viewer 也能读取最大 14 TB（取决于操作系统支持）的文件。","tags":["日志","日志分析","日志查看器"]}},"publisherSupportUrl":"https://support.solarwinds.com/","publisherUrl":"https://www.solarwinds.com/","releaseDate":"2026-11-07","releaseDateSource":"commit","schemaVersion":1,"source":"winget","upstream":{"commit":"1f27126fb7edbf56b2d30f00dffcdc6f2b8b4e96","manifestVersion":"1.28.0","manifests":[{"path":"manifests/s/SolarWinds/KiwiLogViewer/26.1.0.60032/SolarWinds.KiwiLogViewer.installer.yaml","sha256":"693f5ce6430511910e894e46bafa088955832d7f8c2d556c75986a5df2a36697"},{"path":"manifests/s/SolarWinds/KiwiLogViewer/26.1.0.60032/SolarWinds.KiwiLogViewer.locale.en-US.yaml","sha256":"d07e4b119dc65caac10fe10d9ac95ae341d3e2a31b56a3702519d760c64c5234"},{"path":"manifests/s/SolarWinds/KiwiLogViewer/26.1.0.60032/SolarWinds.KiwiLogViewer.locale.zh-CN.yaml","sha256":"bd81040b07272fe6b8f6d408bb7b15d40fac1d00154e45b84130a49286612202"},{"path":"manifests/s/SolarWinds/KiwiLogViewer/26.1.0.60032/SolarWinds.KiwiLogViewer.yaml","sha256":"1bb8d9114516c5fc5103d701e9d6197eeb57211f5cc4e8f37e2c78ad3984a9c7"}],"repository":"microsoft/winget-pkgs"},"version":"26.1.0.60032"}