{"architectures":["x64"],"id":"SecretLUL.WinMedic","latestVersion":"0.12.0","media":{"icons":[],"screenshots":[]},"package":{"description":"High-performance Windows self-healing and diagnostic TUI written in Rust","license":"GPL-3.0","licenseUrl":"https://github.com/SecretLUL/WinMedic/blob/HEAD/LICENSE","locale":"en-US","localizations":{"en-US":{"description":"High-performance Windows self-healing and diagnostic TUI written in Rust","license":"GPL-3.0","licenseUrl":"https://github.com/SecretLUL/WinMedic/blob/HEAD/LICENSE","locale":"en-US","longDescription":"WinMedic is a terminal application that diagnoses and repairs Windows\nproblems: component-store and system-file corruption, stalled Windows\nUpdate queues, broken services, network stack and DNS faults, disk health\nand cache bloat. Diagnostic modules run in parallel and every finding is\nreported with its severity, the evidence behind it and the exact commands\na fix would run.\n\nRepairs are opt-in and reversible: a System Restore point and registry\nsnapshots are taken before anything is changed, a dry-run mode shows the\nplanned steps without touching the system, and any scan or repair can be\ninterrupted. It is a single native executable with no .NET, Python or\nother runtime dependency.","moniker":"winmedic","name":"WinMedic","packageUrl":"https://github.com/SecretLUL/WinMedic","publisher":"SecretLUL","publisherUrl":"https://github.com/SecretLUL","releaseNotesUrl":"https://github.com/SecretLUL/WinMedic/releases/tag/v0.12.0","tags":["cleanup","diagnostics","dism","repair","rust","sfc","system","troubleshooting","tui","windows"]}},"longDescription":"WinMedic is a terminal application that diagnoses and repairs Windows\nproblems: component-store and system-file corruption, stalled Windows\nUpdate queues, broken services, network stack and DNS faults, disk health\nand cache bloat. Diagnostic modules run in parallel and every finding is\nreported with its severity, the evidence behind it and the exact commands\na fix would run.\n\nRepairs are opt-in and reversible: a System Restore point and registry\nsnapshots are taken before anything is changed, a dry-run mode shows the\nplanned steps without touching the system, and any scan or repair can be\ninterrupted. It is a single native executable with no .NET, Python or\nother runtime dependency.","moniker":"winmedic","name":"WinMedic","packageUrl":"https://github.com/SecretLUL/WinMedic","publisher":"SecretLUL","publisherUrl":"https://github.com/SecretLUL","releaseNotesUrl":"https://github.com/SecretLUL/WinMedic/releases/tag/v0.12.0","tags":["cleanup","diagnostics","dism","repair","rust","sfc","system","troubleshooting","tui","windows"]},"schemaVersion":1,"source":"winget","versions":[{"architectures":["x64"],"detailPath":"versions/0.12.0/app.json","detailSha256":"81266a55e516ca4ef75e29ad66becfa9713c513661415856fa8b83e6906a78f3","releaseDate":"2026-10-14","releaseDateSource":"manifest","version":"0.12.0"},{"architectures":["x64"],"detailPath":"versions/0.11.0/app.json","detailSha256":"b850419f5fc483c0d12d065f772e17810be7658302c9e76bea347012f0011e76","releaseDate":"2026-10-12","releaseDateSource":"manifest","version":"0.11.0"},{"architectures":["x64"],"detailPath":"versions/0.10.2/app.json","detailSha256":"b79dc90092a8e66a55fab6b5d649a3862032583b8afdeb7ce24e9d23796a4776","releaseDate":"2026-10-11","releaseDateSource":"manifest","version":"0.10.2"},{"architectures":["x64"],"detailPath":"versions/0.10.1/app.json","detailSha256":"eb1d2257a8ad71cb69de8e9fa857e8d37930d13b1c694d7d322b94467c782b56","releaseDate":"2026-10-11","releaseDateSource":"manifest","version":"0.10.1"},{"architectures":["x64"],"detailPath":"versions/0.10.0/app.json","detailSha256":"4946bca7092449aa9b3bc7c5d68a295fa5faa607c4af3efd8b6ad71f022a9b47","releaseDate":"2026-10-10","releaseDateSource":"manifest","version":"0.10.0"},{"architectures":["x64"],"detailPath":"versions/0.9.0/app.json","detailSha256":"b7c5f9d1c6a52a38fc07e8874a22b69cbac1dd69879e734a93f47727a7861