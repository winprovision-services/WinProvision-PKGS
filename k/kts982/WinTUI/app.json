{"architectures":["arm64","x64"],"id":"kts982.WinTUI","latestVersion":"2.12.1","media":{"icons":[],"screenshots":[]},"package":{"description":"Terminal UI for winget on Windows.","license":"MIT","licenseUrl":"https://github.com/kts982/wintui/blob/main/LICENSE","locale":"en-US","localizations":{"en-US":{"description":"Terminal UI for winget on Windows.","license":"MIT","licenseUrl":"https://github.com/kts982/wintui/blob/main/LICENSE","locale":"en-US","longDescription":"WinTUI is a terminal user interface for Windows Package Manager featuring a split-panel workspace for browsing, searching, installing, upgrading, and managing packages. Includes disk-persistent cache for instant startup, background refresh, integrated search with install queue, batch operations with a single UAC prompt, per-package rules and ignore filters, live command preview, system health checks, registry-driven cleanup tab with per-target sizing and elevated-helper integration, an in-TUI history tab for browsing past install/upgrade/uninstall batches, package list export and import for moving installs across machines, eight curated color themes with light/dark adaptive variants, and a polished headless CLI — themed help and errors, shell completions, a release-notes viewer, action history, portable-package PATH protection, CLI theme switching, self-upgrade, package filtering, global settings and per-package rules management, and a read-only cleanup status report — for scripting and CI.","moniker":"wintui","name":"WinTUI","packageUrl":"https://github.com/kts982/wintui","publisher":"kts982","publisherUrl":"https://github.com/kts982","releaseNotesUrl":"https://github.com/kts982/wintui/releases/tag/v2.12.1","tags":["winget","windows","tui","terminal","package-manager","cli"]}},"longDescription":"WinTUI is a terminal user interface for Windows Package Manager featuring a split-panel workspace for browsing, searching, installing, upgrading, and managing packages. Includes disk-persistent cache for instant startup, background refresh, integrated search with install queue, batch operations with a single UAC prompt, per-package rules and ignore filters, live command preview, system health checks, registry-driven cleanup tab with per-target sizing and elevated-helper integration, an in-TUI history tab for browsing past install/upgrade/uninstall batches, package list export and import for moving installs across machines, eight curated color themes with light/dark adaptive variants, and a polished headless CLI — themed help and errors, shell completions, a release-notes viewer, action history, portable-package PATH protection, CLI theme switching, self-upgrade, package filtering, global settings and per-package rules management, and a read-only cleanup status report — for scripting and CI.","moniker":"wintui","name":"WinTUI","packageUrl":"https://github.com/kts982/wintui","publisher":"kts982","publisherUrl":"https://github.com/kts982","releaseNotesUrl":"https://github.com/kts982/wintui/releases/tag/v2.12.1","tags":["winget","windows","tui","terminal","package-manager","cli"]},"schemaVersion":1,"source":"winget","versions":[{"architectures":["arm64","x64"],"detailPath":"versions/2.12.1/app.json","detailSha256":"28e5e8c65e60443b658acc260fcfed45f93ffcb432b0512e223f0b3b9fefea2b","version":"2.12.1"},{"architectures":["arm64","x64"],"detailPath":"versions/2.12.0/app.json","detailSha256":"8b22b04e74904e71789e13a9daecf695b6c9f7e63fc42ebfe75fabfb65a9870a","version":"2.12.0"},{"architectures":["arm64","x64"],"detailPath":"versions/2.11.2/app.json","detailSha256":"bcf83a1569d9bf21c355b40b22602bd0433162d6302f9f3022a991282fde301f","version":"2.11.2"},{"architectures":["arm64","x64"],"detailPath":"versions/2.11.1/app.json","detailSha256":"e541b605ad585b8b019968808b4c21964e54624bfbb6f35b59cd89f93062316d","version":"2.11.1"},{"architectures":["arm64","x64"],"detailPath":"versions/2.11.0/app.json","detailSha256":"e239b6c87043bfd0f41d750ba2c2f38324bbee88102a4f0b5cd8f11448ab616a","version