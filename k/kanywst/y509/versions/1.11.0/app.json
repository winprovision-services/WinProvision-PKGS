{"defaultLocale":"en-US","id":"kanywst.y509","installers":[{"architecture":"arm64","dependencies":[],"id":"arm64-zip","nestedInstallerFiles":[{"RelativeFilePath":"y509.exe"}],"nestedInstallerType":"portable","priority":4,"sha256":"5e8bd7f1c400f1336c8a9b38a392a1bf7001ab04e2f48269c2dca5936b422697","successCodes":[],"type":"zip","url":"https://github.com/kanywst/y509/releases/download/v1.11.0/y509-1.11.0-windows-arm64.zip"},{"architecture":"x64","dependencies":[],"id":"x64-zip","nestedInstallerFiles":[{"RelativeFilePath":"y509.exe"}],"nestedInstallerType":"portable","priority":4,"sha256":"80ad81f9780fb5e41dfe78a204b74dc9c37b4ba415cece3fcf463c8d1a568f9f","successCodes":[],"type":"zip","url":"https://github.com/kanywst/y509/releases/download/v1.11.0/y509-1.11.0-windows-amd64.zip"}],"licenseUrl":"https://github.com/kanywst/y509/blob/HEAD/LICENSE","packageLocalizations":{"en-US":{"description":"A TUI for X.509 certificate chains","license":"Apache-2.0","licenseUrl":"https://github.com/kanywst/y509/blob/HEAD/LICENSE","locale":"en-US","longDescription":"y509 opens an X.509 certificate chain in a terminal UI. The chain can come from a PEM or DER file, from standard input, or from a live server, including one behind STARTTLS.\nIt answers two questions separately: whether the chain verifies against the system trust store, and whether the server actually served it correctly. The second one catches a missing intermediate, a redundant root, certificates sent out of order, and duplicates. That is the chain which passes in a browser and fails in curl, Go and Java, because only browsers chase the AIA URL to fetch a certificate the server never sent.\ny509 validate exits non-zero on anything a TLS client would reject, and --json reports trust and presentation as separate fields so a script can gate on either.","name":"y509","packageUrl":"https://github.com/kanywst/y509","publisher":"kanywst","publisherUrl":"https://github.com/kanywst","releaseNotesUrl":"https://github.com/kanywst/y509