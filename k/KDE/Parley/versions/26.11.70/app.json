ngs: article, comparison forms, conjugations, synonymes/antonyms/paraphrases","name":"parley","packageUrl":"https://apps.kde.org/parley/","publisher":"KDE e.V.","publisherUrl":"https://kde.org/","tags":["education","english","language","vocabulary"]},"zh-CN":{"description":"词汇练习器","locale":"zh-CN","longDescription":"Parley 是一个词汇练习器。无论是在学习外语还是在其它场景，它都可以帮助您记忆词汇。它支持许多特定语言的功能，也可用于其它学习任务。它采用间隔重复学习方法，让学习效果达到最佳。词汇集可通过“下载新的词汇表”下载，也可使用内置编辑器创建。\n训练模式：\n- 闪卡\n- 混合字母（单词字母排序）\n- 多项选择\n- 写作\n- 语言专项训练：冠词、比较形式、变位、同义词/反义词/释义","packageUrl":"https://apps.kde.org/zh-cn/parley/","publisherUrl":"https://kde.org/zh-cn/","tags":["教育","英语","词汇","语言"]}},"publisherUrl":"https://kde.org/","releaseDate":"2026-11-03","releaseDateSource":"manifest","schemaVersion":1,"source":"winget","upstream":{"commit":"97d6aa2689f0a05f7847653a62b8624720d15b5d","manifestVersion":"1.28.0","manifests":[{"path":"manifests/k/KDE/Parley/26.11.70/KDE.Parley.yaml","sha256":"873ba1a26c47937bfbd57dea9e1bedd0c8694d374c6dee87d3cd78ce84ef5513"},{"path":"manifests/k/KDE/Parley/26.11.70/KDE.Parley.installer.yaml","sha256":"405d0c73712c0c43ffd2cfc871bf206007748d4d41a5d389fc87ba55d851a024"},{"path":"manifests/k/KDE/Parley/26.11.70/KDE.Parley.locale.en-US.yaml","sha256":"bd06e6bcddd53dc1eae19a87f90cdb81c823c7764e1d10053c4d7e8a85c14d5d"},{"path":"manifests/k/KDE/Parley/26.11.70/KDE.Parley.locale.zh-CN.yaml","sha256":"e7a8690a099fcc694c55c852b6d37a5c0ab505b15891cd6b94525d71183dd17f"}],"repository":"microsoft/winget-pkgs"},"version":"26.11.70"}