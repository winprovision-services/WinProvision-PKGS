{"defaultLocale":"en-US","id":"KDE.KBruch","installers":[{"architecture":"x64","dependencies":[],"id":"x64-user-nullsoft","installerSwitches":{"Custom":"/CurrentUser"},"priority":1,"scope":"user","sha256":"9c27a9f7e8587f6f4f39e08c6d05614ce76ef24aff2a0940bffc03a4846038cd","successCodes":[],"type":"nullsoft","uninstall":{"type":"registryKey","value":"kbruch"},"upgradeBehavior":"install","url":"https://cdn.kde.org/ci-builds/education/kbruch/master/windows/kbruch-master-939-windows-cl-msvc2022-x86_64.exe"},{"architecture":"x64","dependencies":[],"elevation":{"requirement":"elevationRequired","source":"inferred"},"id":"x64-machine-nullsoft","installerSwitches":{"Custom":"/AllUsers"},"priority":1,"scope":"machine","sha256":"9c27a9f7e8587f6f4f39e08c6d05614ce76ef24aff2a0940bffc03a4846038cd","successCodes":[],"type":"nullsoft","uninstall":{"type":"registryKey","value":"kbruch"},"upgradeBehavior":"install","url":"https://cdn.kde.org/ci-builds/education/kbruch/master/windows/kbruch-master-939-windows-cl-msvc2022-x86_64.exe"}],"licenseUrl":"https://invent.kde.org/education/kbruch/-/blob/HEAD/LICENSES/GPL-2.0-or-later.txt","packageLocalizations":{"en-US":{"author":"KDE e.V.","copyright":"© 2002-2026, Sebastian Stein","description":"Exercise Fractions","documentations":[{"DocumentLabel":"Handbook","DocumentUrl":"https://docs.kde.org/?application=kbruch"}],"license":"GPL-2.0-or-later","licenseUrl":"https://invent.kde.org/education/kbruch/-/blob/HEAD/LICENSES/GPL-2.0-or-later.txt","locale":"en-US","longDescription":"KBruch is a small program to practice calculating with fractions and percentages. Different exercises are provided for this purpose and you can use the learning mode to practice with fractions. The program checks the user's input and gives feedback.\nFeatures:\n- Arithmetic exercise - in this exercise you have to solve a given fraction task. You have to enter the numerator and the denominator. This is the main exercise.\n- Comparison exercise - in this exercise you have to compare the size of 2 given fractions, using the symbols >, < or =.\n- Conversion exercise - in this exercise you have to convert a given number into a fraction.\n- Factorization exercise - in this exercise you have to factorize a given number into its prime factors.\n- Percentage exercise - in this exercise you have to calculate percentages.","name":"kbruch","packageUrl":"https://apps.kde.org/kbruch/","privacyUrl":"https://kde.org/privacypolicy/","publisher":"KDE e.V.","publisherSupportUrl":"https://kde.org/support/","publisherUrl":"https://kde.org/","releaseNotesUrl":"https://invent.kde.org/education/kbruch/-/blob/HEAD/ChangeLog","tags":["education","fraction","math","percentage"]},"zh-CN":{"description":"分数练习","locale":"zh-CN","longDescription":"KBruch 是用于练习分数及百分比计算的一个小程序。它提供了不同的练习，您可使用学习模式来练习分数计算。本程序会检查用户输入，并给出适时反馈。\n功能：\n- 算术练习——在此练习中，你需要解决所给的分数计算任务，输入分子和分母。此为主要练习。\n- 比较练习——在此练习中，您需要使用 >、< 或 = 符号来比较所给两个分数的大小。\n- 转换练习——在此练习中，您需要将所给数字转换为分数。\n- 因式分解练习——在此练习中，您需要将所给数字因式分解为质因子。\n- 百分比练习——在此练习中，您需要计算百分比。","packageUrl":"https://apps.kde.org/zh-cn/kbruch/","publisherSupportUrl":"https://kde.org/support/","publisherUrl":"https://kde.org/","tags":["分数","教育","数学","百分比"]}},"publisherSupportUrl":"https://kde.org/support/","publisherUrl":"https://kde.org/","releaseDate":"2026-11-13","releaseDateSource":"commit","releaseNotesUrl":"https://invent.kde.org/education/kbruch/-/blob/HEAD/ChangeLog","schemaVersion":1,"source":"winget","upstream":{"commit":"b9180d46bb146f4e62873fe517d615e846275a2f","manifestVersion":"1.28.0","manifests":[{"path":"manifests/k/KDE/KBruch/27.03.70/KDE.KBruch.installer.yaml","sha256":"cc0818733ad28c675129c529aeec48ee6cc1ec510861b597228409f121bc49fd"},{"path":"manifests/k/KDE/KBruch/27.03.70/KDE.KBruch.locale.en-US.yaml","sha256":"6463de482b7f6f1eb492a0548f7a482164ecaff0b05a662e335d9e3ba1669af5"},{"path":"manifests/k/KDE/KBruch/27.03.70/KDE.KBruch.locale.zh-CN.yaml","sha256":"7b72feb576a5d783d8c6f39234a43dc4b15a79304323d7a302f5a988d3eac967"},{"path":"