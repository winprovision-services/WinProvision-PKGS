{"defaultLocale":"en-US","id":"KDE.Blinken","installers":[{"architecture":"x64","dependencies":[],"elevation":{"requirement":"elevationRequired","source":"inferred"},"id":"x64-machine-nullsoft","installerSwitches":{"Custom":"/AllUsers"},"priority":1,"scope":"machine","sha256":"3245982e0bd156faad04b16b5e9059096d62c2c8b9dbe6df8f5d444e1892dd47","silent":{"arguments":"/S","source":"default"},"successCodes":[],"type":"nullsoft","uninstall":{"type":"productCode","value":"Blinken"},"upgradeBehavior":"install","url":"https://cdn.kde.org/ci-builds/education/blinken/master/windows/blinken-master-875-windows-cl-msvc2022-x86_64.exe"},{"architecture":"x64","dependencies":[],"id":"x64-user-nullsoft","installerSwitches":{"Custom":"/CurrentUser"},"priority":1,"scope":"user","sha256":"3245982e0bd156faad04b16b5e9059096d62c2c8b9dbe6df8f5d444e1892dd47","silent":{"arguments":"/S","source":"default"},"successCodes":[],"type":"nullsoft","uninstall":{"type":"productCode","value":"Blinken"},"upgradeBehavior":"install","url":"https://cdn.kde.org/ci-builds/education/blinken/master/windows/blinken-master-875-windows-cl-msvc2022-x86_64.exe"}],"licenseUrl":"https://invent.kde.org/education/blinken/-/blob/HEAD/LICENSES/GPL-2.0-or-later.txt","packageLocalizations":{"en-US":{"description":"Memory Enhancement Game","license":"GPL-2.0-or-later","licenseUrl":"https://invent.kde.org/education/blinken/-/blob/HEAD/LICENSES/GPL-2.0-or-later.txt","locale":"en-US","longDescription":"Blinken is based on an electronic game released in 1978, which challenges players to remember sequences of increasing length. On the face of the device, there are 4 different color buttons, each one with their own distinctive sound. These buttons light up randomly, creating the sequence that the player must then recall. If the player is successful in remembering the sequence of lights in the correct order, they advance to the next stage, where an identical sequence with one extra step is presented. If they are incorrect, the game is lost, and the player must start again from the beginning. The goal is to get a high score - each step in the sequence is worth one point, so correct entry of a sequence of 8 lights is worth 8 points on the high score table.","name":"Blinken","packageUrl":"https://apps.kde.org/blinken/","publisher":"KDE e.V.","publisherUrl":"https://kde.org/","tags":["game","memory"]},"zh-CN":{"description":"记忆力锻炼游戏","locale":"zh-CN","longDescription":"Blinken 基于一个 1978 年发布的电子游戏设计。该游戏会要求玩家记住越来越长的序列。在游戏机器的面板上有 4 个不同颜色的按钮，每个按钮会发出不同的声音。这些按钮会按随机顺序亮起，玩家必须正确重复该序列才能进入下一关。每一关都会在与前一关完全相同的序列上新增一位。如果玩家输入了错误的顺序，则挑战失败，新游戏必须从头开始挑战新的序列。游戏的目的是夺取高分榜的最高分。序列每增加一位就多一分，成功完成一个 8 位的序列可以得到 8 分。","packageUrl":"https://apps.kde.org/zh-cn/blinken/","publisherUrl":"https://kde.org/zh-cn/","tags":["游戏","记忆"]}},"publisherUrl":"https://kde.org/","releaseDate":"2026-11-02","releaseDateSource":"manifest","schemaVersion":1,"source":"winget","upstream":{"commit":"97d6aa2689f0a05f7847653a62b8624720d15b5d","manifestVersion":"1.28.0","manifests":[{"path":"manifests/k/KDE/Blinken/26.11.70/KDE.Blinken.yaml","sha256":"9a206a32142c54ed066542a77067588893b2d192d8dcd8208783d843df2f7016"},{"path":"manifests/k/KDE/Blinken/26.11.70/KDE.Blinken.installer.yaml","sha256":"387aac3645e1a9449bd166fbd22e8a1d32f58fc66c6171a7d7c82015773f1dc7"},{"path":"manifests/k/KDE/Blinken/26.11.70/KDE.Blinken.locale.en-US.yaml","sha256":"2cde2a7e5761d0df7e804defc4e34b19f168c53d97d733d8d3ed87fcd7384669"},{"path":"manifests/k/KDE/Blinken/26.11.70/KDE.Blinken.locale.zh-CN.yaml","sha256":"6a8fb2f5f0a14224c9607acf69749e23b99fec6cd1bec424d2cb21dfc5336c5b"}],"repository":"microsoft/winget-pkgs"},"version":"26.11.70"}