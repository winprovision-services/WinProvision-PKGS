{"defaultLocale":"en-US","id":"KCORES.core-to-core-latency-plus","installers":[{"architecture":"x64","commands":["core-to-core-latency-plus"],"dependencies":[{"PackageDependencies":[{"PackageIdentifier":"Microsoft.VCRedist.2015+.x64"}]}],"id":"x64-portable","priority":4,"sha256":"69f10b60f9355a2ff8dbdb085d979b2038d58483a89a725f74c236e3971fb9c1","successCodes":[],"type":"portable","url":"https://github.com/KCORES/core-to-core-latency-plus/releases/download/0.1.17/core-to-core-latency-plus-windows-amd64.exe"}],"licenseUrl":"https://github.com/KCORES/core-to-core-latency-plus/blob/HEAD/LICENSE","packageLocalizations":{"en-US":{"description":"Measures the latency between CPU cores, forked from nviennot/core-to-core-latency","license":"MIT","licenseUrl":"https://github.com/KCORES/core-to-core-latency-plus/blob/HEAD/LICENSE","locale":"en-US","longDescription":"core-to-core-latency-plus is used to calculate the communication latency between CPU cores.\nSpecifically, it fixes two threads on two different CPU cores and measures the latency by having the threads perform a series of compare-and-swap operations through the CPU cache coherence protocol.\nThis fork aims to improve the usability of the program and collect more CPU benchmark data for display.","moniker":"core-to-core-latency-plus","name":"core-to-core-latency-plus","packageUrl":"https://github.com/KCORES/core-to-core-latency-plus","publisher":"KCORES","publisherUrl":"https://kcores.com/","releaseNotesUrl":"https://github.com/KCORES/core-to-core-latency-plus/releases/tag/0.1.17","tags":["core","cpu","hardware","latency","performance"]},"zh-CN":{"description":"测量 CPU 核心间通信延迟，fork 自 nviennot/core-to-core-latency","locale":"zh-CN","longDescription":"该程序用来计算 CPU 核心间通信延迟。\n具体方式为，将两个线程固定在两个不同的 CPU 核心上，通过 CPU 缓存一致性协议，让线程执行一系列比较交换操作来测量延迟。\n该 fork 旨在提升程序的易用性并收集更多 CPU benckmark 数据来进行展示。","tags":["中央处理器","处理器","延迟","性能","核心","硬件"]}},"publisherUrl":"https://kcores.com/","releaseDate":"2024-10-07","releaseDateSource":"manifest",