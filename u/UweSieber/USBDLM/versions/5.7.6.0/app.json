l over Windows' drive letter\nassignment for USB drives.\n\nRunning as service makes it independent of the logged on user's privileges, so\nthere is no need to give the users the privilege to change drive letters. It\nautomatically solves conflicts between USB drives and network or subst drives of\nthe currently logged on user.\n\nFurthermore you can define new default letters for USB drives and much more.\n\nIt works on Windows XP to Windows 11 and Server 2003 to 2025.","moniker":"usbdlm","name":"USB Drive Letter Manager","packageUrl":"https://www.uwe-sieber.de/usbdlm_e.html","publisher":"uwe-sieber.de","publisherUrl":"https://www.uwe-sieber.de/","releaseNotesUrl":"https://www.uwe-sieber.de/usbdlm_e.html#history","tags":[]}},"publisherUrl":"https://www.uwe-sieber.de/","releaseNotesUrl":"https://www.uwe-sieber.de/usbdlm_e.html#history","schemaVersion":1,"source":"winget","upstream":{"commit":"97d6aa2689f0a05f7847653a62b8624720d15b5d","manifestVersion":"1.12.0","manifests":[{"path":"manifests/u/UweSieber/USBDLM/5.7.6.0/UweSieber.USBDLM.yaml","sha256":"aa9250040ad7bacdd04928ed3e146c0526fd8de7f09a067cd7f9cf4da0cba9a8"},{"path":"manifests/u/UweSieber/USBDLM/5.7.6.0/UweSieber.USBDLM.installer.yaml","sha256":"85247092eadbef74650ad2ba9afc6d073bef05bd1cb882cf8e1269ab5a35ceec"},{"path":"manifests/u/UweSieber/USBDLM/5.7.6.0/UweSieber.USBDLM.locale.en-US.yaml","sha256":"d236348bd8fcdb7536d3aa8977e97e5665f0ae8f1f59d5b3a6f6f9050d19f1db"}],"repository":"microsoft/winget-pkgs"},"version":"5.7.6.0"}