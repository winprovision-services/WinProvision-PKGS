{"defaultLocale":"en-US","id":"UtopianAcademy.Deckboy","installers":[{"architecture":"x64","dependencies":[],"elevation":{"requirement":"elevationRequired","source":"inferred"},"fileExtensions":["deckboy"],"id":"x64-machine-inno","installModes":["interactive","silent","silentWithProgress"],"installerSwitches":{"Custom":"/ALLUSERS"},"minimumOSVersion":"10.0.0.0","priority":1,"scope":"machine","sha256":"ed6ba62136162612755110f0187ba771fe96bbbd90233fa6ccc545c055cd672a","successCodes":[],"type":"inno","uninstall":{"type":"registryKey","value":"{7E2C9F41-6B3D-4E1A-B755-DECB0A0AD001}_is1"},"upgradeBehavior":"install","url":"https://github.com/Utopian-Academy/Deckboy/releases/download/v0.99.425/Deckboy-0.99.425-windows-x64-setup.exe"}],"licenseUrl":"https://github.com/Utopian-Academy/Deckboy/blob/main/LICENSE","packageLocalizations":{"en-US":{"description":"Cue-based media playback and show control for live video","license":"GPL-3.0-or-later","licenseUrl":"https://github.com/Utopian-Academy/Deckboy/blob/main/LICENSE","locale":"en-US","longDescription":"Deckboy is a native desktop application for video engineers, AV technicians and live\noperators who need a reliable way to organise media, trigger cues, loop content and send\nvideo to production displays.\n\nCues are arranged in a playlist with fades, loops and hold-last-frame behaviour, and sent\nto dedicated fullscreen outputs with per-output area of interest, edge feathering and\nwarp or keystone correction. Output can leave the machine as NDI, SRT, RTMP, Blackmagic\nSDI or SMPTE ST 2110, several at once. Playback is driven from a Stream Deck, Bitfocus\nCompanion, OSC, MIDI, Art-Net or LTC timecode.\n\nIt also converts media that will not play, reports codec, raster, frame rate and duration\nfor any file, normalises loudness to EBU R128, generates test patterns, and captures a\ncamera, window or screen as a cue. PDF, PowerPoint and Keynote decks import as one cue per\nslide, with presenter and prompter views available as output types.","moniker":"deckboy","name":"Deckboy","packageUrl":"https://utopian-academy.github.io/Deckboy/","privacyUrl":"https://github.com/Utopian-Academy/Deckboy#built-for-operators-not-data-harvesters","publisher":"Utopian Academy","publisherSupportUrl":"https://github.com/Utopian-Academy/Deckboy/issues","publisherUrl":"https://github.com/Utopian-Academy","releaseNotesUrl":"https://github.com/Utopian-Academy/Deckboy/releases/tag/v0.99.425","tags":["av","broadcast","cue","live-production","media-player","ndi","playback","playout","show-control","srt","video"]}},"publisherSupportUrl":"https://github.com/Utopian-Academy/Deckboy/issues","publisherUrl":"https://github.com/Utopian-Academy","releaseDate":"2026-11-07","releaseDateSource":"commit","releaseNotesUrl":"https://github.com/Utopian-Academy/Deckboy/releases/tag/v0.99.425","schemaVersion":1,"source":"winget","upstream":{"commit":"1e3956241368fadff8aa69834eecd687c8ed7276","manifestVersion":"1.28.0","manifests":[{"path":"manifests/u/UtopianAcademy/Deckboy/0.99.425/UtopianAcademy.Deckboy.installer.yaml","sha256":"c76d8ecab9f476ce038e8225b3f6235c8d19982b990f4b77816a6ff950761c5e"},{"path":"manifests/u/UtopianAcademy/Deckboy/0.99.425/UtopianAcademy.Deckboy.locale.en-US.yaml","sha256":"84200e427f299d9735bac51feab7ff94e08e7bd4229ed91831f27dc089e499fe"},{"path":"manifests/u/UtopianAcademy/Deckboy/0.99.425/UtopianAcademy.Deckboy.yaml","sha256":"88f6549371faced5ee5bea33cfc9313f1d156fee90ce850378a22bb821ee31b2"}],"repository":"microsoft/winget-pkgs"},"version":"0.99.425"}