{"architectures":["arm64","x64","x86"],"id":"UniversityOfAmsterdam.praat","latestVersion":"7.0.03","media":{"icons":[{"mimeType":"image/png","path":"media/icon.bee3d2f8.png","priority":1,"sha256":"bee3d2f8270d3b77d6eab221ca231449d9272a7229cc77fa07f21d2fb85eeeff","source":"winget-legacy"}],"screenshots":[]},"package":{"author":"Paul Boersma, David Weenink, Anastasia Shchupak","copyright":"© Paul Boersma 2026","copyrightUrl":"https://www.fon.hum.uva.nl/praat/manual/License.html","description":"Praat is a free, open-source program for speech analysis in phonetics.","documentations":[{"DocumentLabel":"Wiki","DocumentUrl":"https://github.com/praat/praat/wiki"}],"license":"GPL-3.0","licenseUrl":"https://www.fon.hum.uva.nl/praat/manual/General_Public_License__version_3.html","locale":"en-US","localizations":{"en-US":{"author":"Paul Boersma, David Weenink, Anastasia Shchupak","copyright":"© Paul Boersma 2026","copyrightUrl":"https://www.fon.hum.uva.nl/praat/manual/License.html","description":"Praat is a free, open-source program for speech analysis in phonetics.","documentations":[{"DocumentLabel":"Wiki","DocumentUrl":"https://github.com/praat/praat/wiki"}],"license":"GPL-3.0","licenseUrl":"https://www.fon.hum.uva.nl/praat/manual/General_Public_License__version_3.html","locale":"en-US","longDescription":"Praat is a free, open-source program for speech analysis in phonetics. It allows users to perform spectral, pitch, formant, and intensity analysis, as well as study jitter, shimmer, and voice breaks.","name":"Praat","packageUrl":"https://www.fon.hum.uva.nl/praat/","publisher":"University of Amsterdam","publisherSupportUrl":"https://github.com/praat/praat/issues","publisherUrl":"https://www.fon.hum.uva.nl/","releaseNotes":"- Allow concurrent use of Praat 6 and Praat 7.\n- Prevent potential division by zero in Sound: To Pitch... (this could cause incomplete drawing in the Pitch window).\n- Windows: repaired a bug by which PNG files could show IPA symbols incorrectly if the IP