o RealVNC Free Edition.\nHowever, in addition to remote control it adds various features, such as an encryption plugin to secure the client/server connection.\nIt also supports file transfers, chat functionality and various authentication methods.\nThe two computers must be able to communicate across a network, such as a local subnet, internal network, or the Internet.","moniker":"ultravnc","name":"UltraVnc","packageUrl":"https://www.uvnc.com/downloads/ultravnc.html","publisher":"uvnc bvba","publisherUrl":"https://www.uvnc.com","tags":["remote-desktop","vnc"]}},"publisherUrl":"https://www.uvnc.com","schemaVersion":1,"source":"winget","upstream":{"commit":"97d6aa2689f0a05f7847653a62b8624720d15b5d","manifestVersion":"1.10.0","manifests":[{"path":"manifests/u/uvncbvba/UltraVNC/1.3.8.1/uvncbvba.UltraVNC.yaml","sha256":"b80f1dd8159ec9f292ad419530f9840a89e72c74fae690b7bee637a701ec119c"},{"path":"manifests/u/uvncbvba/UltraVNC/1.3.8.1/uvncbvba.UltraVNC.installer.yaml","sha256":"52f677910c03b5ea9174f9fa830cc6e070bd7d20e11d88a09d14f331e23d0981"},{"path":"manifests/u/uvncbvba/UltraVNC/1.3.8.1/uvncbvba.UltraVNC.locale.en-US.yaml","sha256":"37dad17a939942807fda362da1852e7a1f4262dc9e162135447789bf4196471a"}],"repository":"microsoft/winget-pkgs"},"version":"1.3.8.1"}