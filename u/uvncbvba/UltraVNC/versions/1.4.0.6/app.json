o RealVNC Free Edition.\nHowever, in addition to remote control it adds various features, such as an encryption plugin to secure the client/server connection.\nIt also supports file transfers, chat functionality and various authentication methods.\nThe two computers must be able to communicate across a network, such as a local subnet, internal network, or the Internet.","moniker":"ultravnc","name":"UltraVnc","packageUrl":"https://www.uvnc.com/downloads/ultravnc.html","publisher":"uvnc bvba","publisherUrl":"https://www.uvnc.com","tags":["remote-desktop","vnc"]}},"publisherUrl":"https://www.uvnc.com","schemaVersion":1,"source":"winget","upstream":{"commit":"97d6aa2689f0a05f7847653a62b8624720d15b5d","manifestVersion":"1.10.0","manifests":[{"path":"manifests/u/uvncbvba/UltraVNC/1.4.0.6/uvncbvba.UltraVNC.yaml","sha256":"c7be7b277076fb52098a80ac631bf65ca1736f26968bd90398e6625f67eeed60"},{"path":"manifests/u/uvncbvba/UltraVNC/1.4.0.6/uvncbvba.UltraVNC.installer.yaml","sha256":"c5db87514f77c213eb0321ef40687f90a66a58f7c13375f37b7c636ea60e7c79"},{"path":"manifests/u/uvncbvba/UltraVNC/1.4.0.6/uvncbvba.UltraVNC.locale.en-US.yaml","sha256":"133500f0ebf4ba6fcb6564b75e8c9a5c93daf5b22821c8d01806388cd5dee73a"}],"repository":"microsoft/winget-pkgs"},"version":"1.4.0.6"}