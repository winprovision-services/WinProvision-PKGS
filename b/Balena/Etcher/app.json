{"architectures":["neutral","x64"],"id":"Balena.Etcher","latestVersion":"2.1.9","media":{"icons":[{"mimeType":"image/png","path":"media/icon.35ecf215.png","priority":1,"sha256":"35ecf215af26f08676d064cf938f01171aa9b199aa887e47dfd3e90eb9a901bc","source":"winget-legacy"}],"screenshots":[]},"package":{"description":"Flash OS images to SD cards & USB drives, safely and easily.","license":"Apache-2.0","licenseUrl":"https://github.com/balena-io/etcher/blob/HEAD/LICENSE","locale":"en-US","localizations":{"en-US":{"description":"Flash OS images to SD cards & USB drives, safely and easily.","license":"Apache-2.0","licenseUrl":"https://github.com/balena-io/etcher/blob/HEAD/LICENSE","locale":"en-US","longDescription":"Etcher is a powerful OS image flasher built with web technologies to ensure flashing an SDCard or USB drive is a pleasant and safe experience. It protects you from accidentally writing to your hard-drives, ensures every byte of data was written correctly, and much more. It can also directly flash Raspberry Pi devices that support USB device boot mode.","name":"balenaEtcher","packageUrl":"https://etcher.balena.io/","publisher":"Balena Ltd. <hello@balena.io>","publisherUrl":"https://www.balena.io/","releaseNotesUrl":"https://github.com/balena-io/etcher/releases/tag/v2.1.9","tags":["boot","dd","flash","format","image","img","iso","usb"]},"zh-CN":{"description":"安全轻松地将操作系统镜像刷入 SD 卡和 USB 驱动器。","license":"Apache-2.0","licenseUrl":"https://github.com/balena-io/etcher/blob/HEAD/LICENSE","locale":"zh-CN","longDescription":"Etcher 是一款功能强大的操作系统镜像刷写工具，采用网页技术，让刷写 SD 卡或 USB 驱动器变得愉快而安全。它能防止意外写入硬盘，确保每个字节的数据都被正确写入，等等，并能直接刷写支持 USB 设备启动模式的 Raspberry Pi 设备。","name":"balenaEtcher","packageUrl":"https://etcher.balena.io/","publisher":"Balena Ltd. <hello@balena.io>","publisherUrl":"https://www.balena.io/","releaseNotesUrl":"https://github.com/balena-io/etcher/releases/tag/v2.1.9","tags":["dd","img","iso","usb","刷入","刷写","启动","引导","格式化","烧录","镜像"]}},"longDescription":"Etcher is a powerf