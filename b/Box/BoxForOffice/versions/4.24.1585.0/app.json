e","value":"Box for Office 4.24.1585.0"},"upgradeBehavior":"install","url":"https://e3.boxcdn.net/box-installers/boxforoffice/currentrelease/BoxForOffice.exe"},{"appsAndFeaturesEntries":[{"UpgradeCode":"{E43A09BF-C7C4-4B45-9C6C-25DED779A30B}"}],"architecture":"x64","dependencies":[{"PackageDependencies":[{"PackageIdentifier":"Microsoft.VSTOR"}]}],"elevation":{"requirement":"elevationRequired","source":"inferred"},"id":"x64-machine-msi","installerSwitches":{"InstallLocation":"APPDIR=\"<INSTALLPATH>\""},"priority":2,"scope":"machine","sha256":"71be88fbf6557d8e7af1b79781509d10375d91cd6399db74075a10284ef4a805","silent":{"arguments":"/quiet /norestart","source":"default"},"successCodes":[],"type":"msi","uninstall":{"type":"productCode","value":"{975CBBA5-D30B-4393-A8C6-6F8A0C449DD2}"},"upgradeBehavior":"install","url":"https://e3.boxcdn.net/box-installers/boxforoffice/currentrelease/BoxForOffice.msi"}],"packageLocalizations":{"en-US":{"description":"An add-in for Microsoft Office that enables Box coauthoring and collaboration","license":"Proprietary","locale":"en-US","longDescription":"Box for Microsoft Office coauthoring enables real-time collaboration for Office files stored in Box with all edits autosaved to Box. Users have the flexibility to create, open, edit, collaborate on Microsoft Word, Excel, and PowerPoint documents in Box while working where they are — on desktop, web, or mobile.\nNow, right from within Word, Excel, and PowerPoint on desktop and mobile, you can:\n- Open files from Box, with easy access to recently accessed files and folders\n- Save files to Box, even with documents from your desktop\n- Access Box options directly from the ribbon in Office apps\n- Generate Box shared links and control their permissions\nIn addition, from Outlook you can:\n- Save attachments to Box from incoming email\n- Easily send links to files already stored in Box\n- Convert outgoing attachments to Box shared links","name":"Box for Office","packageUrl":"https://support.box.com/hc/sections/21356627124627","publisher":"Box","publisherUrl":"https://www.box.com/","tags":["box","collaborate","collaboration","excel","office","outlook","powerpoint","word"]},"zh-CN":{"description":"一款开启 Box 协同编辑与协作功能的 Microsoft Office 的插件。","license":"专有软件","locale":"zh-CN","longDescription":"Box for Microsoft Office 协同编辑功能支持实时协作处理存储在 Box 中的 Office 文件，所有编辑内容将自动保存至 Box。用户可灵活地在 Box 中创建、打开、编辑及协作处理 Microsoft Word、Excel、PowerPoint 文档，并支持跨平台操作——无论是在桌面端、网页端还是移动端。\n现在，您可以直接通过桌面端和移动端的 Word、Excel、PowerPoint 实现以下操作：\n- 从 Box 打开文件，快速访问近期使用过的文件和文件夹\n- 将文件保存至 Box，甚至支持桌面端文档的存储\n- 在 Office 应用的功能区直接访问 Box 选项\n- 生成 Box 共享链接并设置权限\n此外，通过 Outlook 您还能：\n- 将邮件附件直接保存至 Box\n- 快速发送已存储在 Box 中的文件链接\n- 将待发送附件转换为 Box 共享链接","tags":["box","excel","office","outlook","powerpoint","word","协作","协同"]}},"publisherUrl":"https://www.box.com/","schemaVersion":1,"source":"winget","upstream":{"commit":"97d6aa2689f0a05f7847653a62b8624720d15b5d","manifestVersion":"1.12.0","manifests":[{"path":"manifests/b/Box/BoxForOffice/4.24.1585.0/Box.BoxForOffice.yaml","sha256":"239a5631256fc258cdcf49067976fc1ebad18cca3e598a9fc6a3160bda0c2c52"},{"path":"manifests/b/Box/BoxForOffice/4.24.1585.0/Box.BoxForOffice.installer.yaml","sha256":"a2378bfb9d9a1479cdc5e9681db95a0f0347eaadeca1e62487f48f7d016a8d1a"},{"path":"manifests/b/Box/BoxForOffice/4.24.1585.0/Box.BoxForOffice.locale.en-US.yaml","sha256":"edfbf6996aced133c01afe645b92080a6ac7f766fc65fcb8cb045682b033deb5"},{"path":"manifests/b/Box/BoxForOffice/4.24.1585.0/Box.BoxForOffice.locale.zh-CN.yaml","sha256":"c29ed9817776bb7e7435726d1b76275257cf485e59d6811f60c3dc8ca3dc0c99"}],"repository":"microsoft/winget-pkgs"},"version":"4.24.1585.0"}