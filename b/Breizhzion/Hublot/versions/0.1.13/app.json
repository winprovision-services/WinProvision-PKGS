{"defaultLocale":"en-US","id":"Breizhzion.Hublot","installers":[{"architecture":"x64","dependencies":[],"id":"x64-user-inno","installModes":["interactive","silent","silentWithProgress"],"installerSwitches":{"Silent":"/VERYSILENT /SUPPRESSMSGBOXES /NORESTART","SilentWithProgress":"/SILENT /SUPPRESSMSGBOXES /NORESTART"},"priority":1,"scope":"user","sha256":"953532d7c1ac9a5ce9fb8dddcb245320a3d96cfbecf11f40fd85341a3ad8029e","silent":{"arguments":"/VERYSILENT /SUPPRESSMSGBOXES /NORESTART","source":"manifest"},"successCodes":[],"type":"inno","uninstall":{"type":"productCode","value":"{3F1A9C2E-6B4D-4F8A-9E3C-1D2B5A7C8E4F}_is1"},"upgradeBehavior":"install","url":"https://dl.breizhzion.com/hublot/Hublot-Setup-x64-0.1.13.exe"}],"licenseUrl":"https://github.com/bzhzion/hublot/blob/main/LICENSE.md","packageLocalizations":{"en-US":{"description":"A shared, visible Chromium that several AI agents can drive at once.","license":"BZ-1.1 (BREIZHZION Personal Use License)","licenseUrl":"https://github.com/bzhzion/hublot/blob/main/LICENSE.md","locale":"en-US","longDescription":"Hublot runs one visible Chromium browser behind a local broker, and gives each agent its\nown tab identified by a label, so several agents can work in the same browser without\ninterfering with each other. A human can also click and type in that window at any time,\nwhich is what makes it usable for the parts an agent cannot do, such as entering a\npassword or clearing a two-factor prompt.\n\nThe profile is persistent, so cookies and logged-in sessions survive a restart. The\ncommand line covers navigation, clicking, typing, extraction, accessibility snapshots,\nscreenshots and console or network logs.\n\nIt is a command-line tool: there is no window of its own beyond the browser it drives.","moniker":"hublot","name":"Hublot","packageUrl":"https://github.com/bzhzion/hublot","publisher":"BREIZHZION","publisherUrl":"https://breizhzion.com","releaseNotesUrl":"https://github.com/bzhzion/hublot/blob/main/CHANGELOG.m