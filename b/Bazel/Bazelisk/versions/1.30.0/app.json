{"defaultLocale":"en-US","id":"Bazel.Bazelisk","installers":[{"architecture":"x64","commands":["bazelisk"],"dependencies":{"PackageDependencies":[{"PackageIdentifier":"Microsoft.VCRedist.2015+.x64"}]},"id":"x64-portable","priority":4,"sha256":"5d14a31e9d8a363c48ba1900dbd56764d730835232eb0d113cce255856ffe3ef","successCodes":[],"type":"portable","url":"https://github.com/bazelbuild/bazelisk/releases/download/v1.30.0/bazelisk-windows-amd64.exe"},{"architecture":"arm64","commands":["bazelisk"],"dependencies":{"PackageDependencies":[{"PackageIdentifier":"Microsoft.VCRedist.2015+.arm64"}]},"id":"arm64-portable","priority":4,"sha256":"cb832b1d157e0dc5f89108da426f9c6fe087f5b15873e072480ec49cc5afe488","successCodes":[],"type":"portable","url":"https://github.com/bazelbuild/bazelisk/releases/download/v1.30.0/bazelisk-windows-arm64.exe"}],"licenseUrl":"https://github.com/bazelbuild/bazelisk/blob/HEAD/LICENSE","packageLocalizations":{"en-US":{"description":"A user-friendly launcher for Bazel.","license":"Apache-2.0","licenseUrl":"https://github.com/bazelbuild/bazelisk/blob/HEAD/LICENSE","locale":"en-US","longDescription":"Bazelisk is a wrapper for Bazel written in Go.\nIt automatically picks a good version of Bazel given your current working directory, downloads it from the official server (if required) and then transparently passes through all command-line arguments to the real Bazel binary.\nYou can call it just like you would call Bazel.","moniker":"bazelisk","name":"Bazelisk","packageUrl":"https://bazel.build/","publisher":"Bazel","publisherSupportUrl":"https://github.com/bazelbuild/bazelisk/issues","publisherUrl":"https://github.com/bazelbuild/bazelisk","releaseNotes":"Bazelisk v1.30.0 comes with new features and several improvements:\nSecurity Fixes (Go)\n- Updated Go to 1.27.3 to address CVE-2026-111943 / golang/go#82345 (#821).\n\nNew Features (Go)\n- Added support for patched Bazel release candidates (#814).\n\nBug Fixes & Improvements (Go)\n- Bazelisk now looks for configuration files in all parent directories (#805).\n\nBug Fixes & Improvements (Docs)\n- Improved documentation of USE_BAZEL_VERSION (#807).\n- Documented BAZELISK_WRAPPER_DIRECTORY (#815).\nWe’d like to thank our amazing contributors @dws, @keith, @marlamb, @matx-sjacob and @phst!","releaseNotesUrl":"https://github.com/bazelbuild/bazelisk/releases/tag/v1.30.0","tags":["bazel","build","development"]}},"publisherSupportUrl":"https://github.com/bazelbuild/bazelisk/issues","publisherUrl":"https://github.com/bazelbuild/bazelisk","releaseDate":"2026-11-05","releaseDateSource":"commit","releaseNotesUrl":"https://github.com/bazelbuild/bazelisk/releases/tag/v1.30.0","schemaVersion":1,"source":"winget","upstream":{"commit":"a4a78ef7dd5a1ec000e60392173b33bed55f7cbb","manifestVersion":"1.28.0","manifests":[{"path":"manifests/b/Bazel/Bazelisk/1.30.0/Bazel.Bazelisk.installer.yaml","sha256":"6170b0a6a88722e236fa2b521bfc1ecc1a3e2b13e4da54c6ec31aae6c4a9e620"},{"path":"manifests/b/Bazel/Bazelisk/1.30.0/Bazel.Bazelisk.locale.en-US.yaml","sha256":"da55fac51e57d4cba0cc3291c873362d81b2fa4d3535b610ec010d7546848dbb"},{"path":"manifests/b/Bazel/Bazelisk/1.30.0/Bazel.Bazelisk.yaml","sha256":"b9c8e50b3b6a896d5063287cb39ac4bde3a2cc4a450022afa6d8f779b1b44680"}],"repository":"microsoft/winget-pkgs"},"version":"1.30.0"}