ou take all of\nthem, and none at all if you do not.\n\nNothing about your files, your searches or your machine leaves it. There is one exception,\ndisclosed on the first screen and switchable off: an anonymous check for a newer version, at\nmost once a day.","name":"Findra","packageUrl":"https://github.com/blakazulu/findra","publisher":"blakazulu","publisherUrl":"https://github.com/blakazulu","tags":["search","files","desktop","ntfs","local"]}},"publisherUrl":"https://github.com/blakazulu","schemaVersion":1,"source":"winget","upstream":{"commit":"97d6aa2689f0a05f7847653a62b8624720d15b5d","manifestVersion":"1.6.0","manifests":[{"path":"manifests/b/blakazulu/Findra/0.1.0/blakazulu.Findra.yaml","sha256":"dc29cf2264eefc81ad3831bffdd892fbfb7abe3c89be47b1587aea856cfa508e"},{"path":"manifests/b/blakazulu/Findra/0.1.0/blakazulu.Findra.installer.yaml","sha256":"94038b52cb0352e3ea127836524967e4782343a386154e4cd37ad80edfcacf88"},{"path":"manifests/b/blakazulu/Findra/0.1.0/blakazulu.Findra.locale.en-US.yaml","sha256":"10aeba84b56028ff0220675fe5e0e9d1a94b4f30551c56e6945d2c4707768e9f"}],"repository":"microsoft/winget-pkgs"},"version":"0.1.0"}