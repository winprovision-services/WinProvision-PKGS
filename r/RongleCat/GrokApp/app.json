{"architectures":["x64"],"id":"RongleCat.GrokApp","latestVersion":"0.2.50","media":{"icons":[{"mimeType":"image/png","path":"media/icon.1915485b.png","priority":1,"sha256":"1915485bb15e964498a03ae030169745f7cef730b30a443857872c59579747e4","source":"winget-legacy"}],"screenshots":[]},"package":{"description":"Desktop workbench for Grok Build CLI — sessions, projects, media, automations (Tauri 2 · unofficial).","license":"MIT","licenseUrl":"https://github.com/RongleCat/grok-app/blob/HEAD/LICENSE","locale":"en-US","localizations":{"en-US":{"description":"Desktop workbench for Grok Build CLI — sessions, projects, media, automations (Tauri 2 · unofficial).","license":"MIT","licenseUrl":"https://github.com/RongleCat/grok-app/blob/HEAD/LICENSE","locale":"en-US","longDescription":"Grok App is not an official xAI product. It wraps the local Grok Build CLI (grok agent stdio) into a desktop workbench: sessions, projects, permissions, media previews, and scheduled tasks. Manage multiple projects and sessions, review permission requests, preview rich media, run scheduled tasks, and interact with the agent through a Chinese/English Tauri desktop interface.","name":"Grok App","packageUrl":"https://github.com/RongleCat/grok-app","publisher":"RongleCat","publisherUrl":"https://github.com/RongleCat","releaseNotesUrl":"https://github.com/RongleCat/grok-app/releases/tag/v0.2.50","tags":["agent","agentic","ai","chatbot","code","coding","grok","large-language-model","llm","programming"]},"zh-CN":{"description":"本机 Grok Build 的桌面指挥台：会话、项目、媒体与自动化（Tauri 2 · 非官方）。","locale":"zh-CN","longDescription":"Grok App 不是 xAI 官方产品。它把本机 Grok Build CLI（grok agent stdio）收成桌面工作台：会话、项目、权限、媒体预览与已安排任务。在终端里跑 grok 很强，但日常工作台还缺一块：多项目、多会话、权限条、富媒体预览、定时任务、中英文界面。Grok App 解决的就是「指挥台」问题：安装 App 并准备好 Grok Build CLI，添加项目、新建会话，连接 Agent 使用。","releaseNotesUrl":"https://github.com/RongleCat/grok-app/releases/tag/v0.2.11","tags":["grok","人工智能","代码","大语言模型","智能体","编程","聊天机器人","自主智能"]}},"longDescription":"Grok App is not an offi