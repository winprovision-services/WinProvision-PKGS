{"architectures":["arm64","x64"],"id":"RedEyeNetworks.HopMatrix","latestVersion":"1.19.0","media":{"icons":[{"mimeType":"image/png","path":"media/icon.4742373c.png","priority":1,"sha256":"4742373c8dc4b76d1c173d8cf9f936c12811a57878228dc8fae93d040c3148ef","source":"winget-legacy"}],"screenshots":[]},"package":{"description":"Visual multi-path traceroute, network monitoring, and analysis platform","license":"Proprietary","locale":"en-US","localizations":{"en-US":{"description":"Visual multi-path traceroute, network monitoring, and analysis platform","license":"Proprietary","locale":"en-US","longDescription":"HopMatrix is a portable, single-executable, cross-platform network analysis platform\nwith eight operational modes: Trace, Monitor, iPerf, OUI/MAC Lookup, Routing Analyzer,\nSNMP, Multicast and L2 Inspector, plus Quick Tools, a Tools menu of utility dialogs that open over\nwhichever mode is on screen. Features continuous multi-path traceroute with real-time\ntopology visualization, 256-endpoint fleet monitoring, iperf3-compatible bandwidth\ntesting, SNMP v1/v2c/v3 discovery, and multicast/CDP/LLDP analysis.","moniker":"hopmatrix","name":"HopMatrix","packageUrl":"https://redeyenetworks.com","publisher":"RedEye Network Solutions LLC","publisherUrl":"https://redeyenetworks.com","tags":["traceroute","network","monitoring","bandwidth","iperf","snmp","multicast","network-analysis","pathping","topology","cdp","lldp","nmap","oui"]}},"longDescription":"HopMatrix is a portable, single-executable, cross-platform network analysis platform\nwith eight operational modes: Trace, Monitor, iPerf, OUI/MAC Lookup, Routing Analyzer,\nSNMP, Multicast and L2 Inspector, plus Quick Tools, a Tools menu of utility dialogs that open over\nwhichever mode is on screen. Features continuous multi-path traceroute with real-time\ntopology visualization, 256-endpoint fleet monitoring, iperf3-compatible bandwidth\ntesting, SNMP v1/v2c/v3 discovery, and multicast/CDP/LLDP analysis.","moniker":"hopmat