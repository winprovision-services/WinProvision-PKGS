{"architectures":["x64"],"id":"RafalZG.ClaudeSessionsSidekick","latestVersion":"1.0.15","media":{"icons":[{"mimeType":"image/png","path":"media/icon.60e64115.png","priority":1,"sha256":"60e64115c48c626ecec3a3ae728613f511dc14304f8e54c485339a597c6a08d0","source":"winget-legacy"}],"screenshots":[]},"package":{"description":"Tray sidekick for Claude Code — usage tracking, session browser, quick launchers, prompt library.","license":"MIT","licenseUrl":"https://github.com/RafalZG/claude-sessions-sidekick/blob/HEAD/LICENSE","locale":"en-US","localizations":{"en-US":{"description":"Tray sidekick for Claude Code — usage tracking, session browser, quick launchers, prompt library.","license":"MIT","licenseUrl":"https://github.com/RafalZG/claude-sessions-sidekick/blob/HEAD/LICENSE","locale":"en-US","longDescription":"Claude Sessions Sidekick is a Windows tray utility that complements Anthropic's Claude Code CLI.\nIt provides a persistent at-a-glance view of usage limits (5-hour rolling block and weekly\nSonnet/Opus utilization), a searchable browser for past Claude Code sessions across projects\nwith per-session notes and color tags, project quick launchers with global hotkeys, a reusable\nprompt library, and an MCP server browser.\n\nThe app reads only local Claude Code data and uses the user's own OAuth token for the official\nClaude Code usage API — no telemetry, no third-party servers.","moniker":"claude-sessions-sidekick","name":"Claude Sessions Sidekick","packageUrl":"https://github.com/RafalZG/claude-sessions-sidekick","publisher":"Rafał Zygmunt","publisherUrl":"https://github.com/RafalZG","releaseNotesUrl":"https://github.com/RafalZG/claude-sessions-sidekick/releases/tag/v1.0.15","tags":["ai","anthropic","claude","claude-code","developer-tools","dotnet","llm","productivity","session-manager","tray"]}},"longDescription":"Claude Sessions Sidekick is a Windows tray utility that complements Anthropic's Claude Code CLI.\nIt provides a persistent at-a-glance view of usage lim