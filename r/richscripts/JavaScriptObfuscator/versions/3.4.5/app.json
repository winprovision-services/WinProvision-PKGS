{"defaultLocale":"en-US","id":"richscripts.JavaScriptObfuscator","installers":[{"architecture":"x64","dependencies":[],"id":"x64-zip","nestedInstallerFiles":[{"PortableCommandAlias":"javascriptobfuscator","RelativeFilePath":"javascriptobfuscator.exe"},{"PortableCommandAlias":"jso-local","RelativeFilePath":"cli\\jso-local.exe"}],"nestedInstallerType":"portable","priority":4,"sha256":"e693523c9bc8d84becc67820404dc166915d24b23e3c12dd504669353c84d8bd","successCodes":[],"type":"zip","url":"https://javascriptobfuscator.com/download/javascriptobfuscator-3.4.5.zip"}],"licenseUrl":"https://javascriptobfuscator.com/terms.aspx","packageLocalizations":{"en-US":{"description":"Obfuscate and protect JavaScript source on your own machine.","license":"Proprietary","licenseUrl":"https://javascriptobfuscator.com/terms.aspx","locale":"en-US","longDescription":"JavaScript Obfuscator renames identifiers, encodes strings, flattens control\nflow and compresses output so that shipped JavaScript is difficult to read and\nto reuse. It handles modern syntax including classes, modules, optional\nchaining, generators and template literals, and can target either ES5 or a\nmodern runtime.\n\nThe Windows app protects source locally: files never leave the machine. It\nships with jso-local, a command line front end for the same engine, so the\nsame protection can run in a build script or on a CI agent.\n\nA free tier is available. Paid plans unlock the stronger presets and larger\ninputs.","moniker":"javascriptobfuscator","name":"JavaScript Obfuscator","packageUrl":"https://javascriptobfuscator.com/","publisher":"richscripts inc","publisherUrl":"https://javascriptobfuscator.com/","releaseNotesUrl":"https://javascriptobfuscator.com/downloads.aspx","tags":["javascript","minify","obfuscation","obfuscator","protection","source-protection"]}},"publisherUrl":"https://javascriptobfuscator.com/","releaseNotesUrl":"https://javascriptobfuscator.com/downloads.aspx","schemaVersion":1,"source":"winget","upstream