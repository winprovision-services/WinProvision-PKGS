{"defaultLocale":"en-US","id":"RileyTestut.AltServer","installers":[{"appsAndFeaturesEntries":[{"ProductCode":"{F7B4312C-3208-43BD-8342-74E9F42006E4}","UpgradeCode":"{7D1A38CC-208D-4D3C-8D8B-BDFEC732880A}"}],"architecture":"x86","dependencies":[],"elevation":{"requirement":"elevationRequired","source":"inferred"},"id":"x86-machine-msi","priority":2,"scope":"machine","sha256":"faf38b9b35e5ba2ff2bb35601be2b25c425eb36fd65f85f5752fe45b5c0821c9","silent":{"arguments":"/quiet /norestart","source":"default"},"successCodes":[],"type":"msi","uninstall":{"type":"productCode","value":"{F7B4312C-3208-43BD-8342-74E9F42006E4}"},"upgradeBehavior":"install","url":"https://cdn.altstore.io/file/altstore/altserver-windows/1_4_3.msi"}],"licenseUrl":"https://github.com/rileytestut/AltStore/blob/master/LICENSE","packageLocalizations":{"en-US":{"description":"A companion application for your computer that allows AltStore to sideload apps onto your device.","license":"AGPL-3.0","licenseUrl":"https://github.com/rileytestut/AltStore/blob/master/LICENSE","locale":"en-US","longDescription":"AltServer is a companion application for your computer that allows AltStore to sideload apps onto your device.\nAs long as AltStore is on the same WiFi network as a computer running AltServer — or is plugged-in directly to the computer via USB — AltStore can sideload, refresh, activate, and deactivate apps.\nAltServer is also used to install AltStore in the first place, and if your AltStore expires you can manually refresh it by re-installing AltStore with AltServer without deleting AltStore first.","name":"AltServer","packageUrl":"https://altstore.io","publisher":"Riley Testut","publisherUrl":"https://altstore.io","releaseNotesUrl":"https://faq.altstore.io/release-notes/altserver","tags":["altstore","ios","ipad","ipados","iphone","sideload"]},"zh-CN":{"description":"运行在计算机上的配套应用程序，允许 AltStore 将应用侧载至您的设备。","license":"AGPL-3.0","licenseUrl":"https://github.com/rileytestut/AltStore/blob/master/LICENSE","locale":"zh-CN","longDescription":"AltServer 是一款运行在计算机上的配套应用程序，允许 AltStore 将应用侧载至您的设备。只要和运行 AltServer 的计算机处于同一 WiFi 网络，或是直接通过 USB 插入到计算机，AltStore 就可以侧载、刷新、激活和停用应用。AltServer 也用于安装 AltStore。如果 AltStore 过期，您可以使用 AltServer 重新安装 AltStore 来手动刷新它，不必先删除 AltStore。","name":"AltServer","packageUrl":"https://altstore.io","publisher":"Riley Testut","publisherUrl":"https://altstore.io","releaseNotesUrl":"https://faq.altstore.io/release-notes/altserver","tags":["altstore","ios","ipad","ipados","iphone","侧载"]}},"publisherUrl":"https://altstore.io","releaseNotesUrl":"https://faq.altstore.io/release-notes/altserver","schemaVersion":1,"source":"winget","upstream":{"commit":"97d6aa2689f0a05f7847653a62b8624720d15b5d","manifestVersion":"1.5.0","manifests":[{"path":"manifests/r/RileyTestut/AltServer/1.4.3/RileyTestut.AltServer.yaml","sha256":"288d2ee0e8ab447c858477f6785e7cb7a1df2eef7b668c7156b6e8db293d843d"},{"path":"manifests/r/RileyTestut/AltServer/1.4.3/RileyTestut.AltServer.installer.yaml","sha256":"764a4442712442486418a46c55a2b67e682552b351c26a4325dc83e1ae91114b"},{"path":"manifests/r/RileyTestut/AltServer/1.4.3/RileyTestut.AltServer.locale.en-US.yaml","sha256":"0da54f0dcd9db937070eff85a27e9d113aa61d25014a8754ce3e63f0dc47f3e2"},{"path":"manifests/r/RileyTestut/AltServer/1.4.3/RileyTestut.AltServer.locale.zh-CN.yaml","sha256":"e85936087cce79d887cdf34a793323b392fd600a7fcfb0e50a3eaaae67ab0aca"}],"repository":"microsoft/winget-pkgs"},"version":"1.4.3"}