{"architectures":["x64"],"id":"Ruihu.Apifox","latestVersion":"2.8.54","media":{"icons":[{"mimeType":"image/png","path":"media/icon.4c93032e.png","priority":1,"sha256":"4c93032e9a860a3efb6b9da93cd16b282680e848e7c81411040e576b21fd8f72","source":"winget-legacy"}],"screenshots":[]},"package":{"author":"广州睿狐科技有限公司","copyright":"Copyright © 2026 Apifox Team","description":"API 文档、API 调试、API Mock、API 自动化测试一体化协作平台","license":"免费软件","locale":"zh-CN","localizations":{"en-US":{"author":"Guangzhou Ruihu Technology Co., Ltd.","description":"All-in-one collaboration platform for API documentation, API debugging, API Mock and API test automation.","license":"Freeware","locale":"en-US","longDescription":"Apifox is an all-in-one collaboration platform for API documentation, API debugging, API Mock and API test automation, positioning Postman + Swagger + Mock + JMeter.\nWith one system and one data, it solves data sync problems among multiple systems.\nAs long as the API documentation is defined, API debugging, API data Mock, API test automation can be used directly without the need to redefine; API documentation shares the same tool with API development and debugging, so once the API debugging is completed, it can be ensured that it is identical to the definition of the API documentation.\nEfficient, timely and accurate!","tags":["api","automation","china","debug","develop","development","interface","internet","network","prc","request","response"]},"zh-CN":{"author":"广州睿狐科技有限公司","copyright":"Copyright © 2026 Apifox Team","description":"API 文档、API 调试、API Mock、API 自动化测试一体化协作平台","license":"免费软件","locale":"zh-CN","longDescription":"Apifox 是 API 文档、API 调试、API Mock、API 自动化测试一体化协作平台，定位 Postman + Swagger + Mock + JMeter。通过一套系统、一份数据，解决多个系统之间的数据同步问题。只要定义好 API 文档，API 调试、API 数据 Mock、API 自动化测试就可以直接使用，无需再次定义；API 文档和 API 开发调试使用同一个工具，API 调试完成后即可保证和 API 文档定义完全一致。高效、及时、准确！","name":"Apifox","publisher":"Apifox Team","tags":["api","互联网","响应","开发","接口","网络","自动化","请求","调试"]}},"longDescription":"Apifox 是 API 文档、API 调试、API Mock、API 自动化测试一体化协作平台，定位 Postman + Swagger + Mock + JMeter。通过一套系统、一份数据，解决多个系统之间的数据同步问题。只要定义好 API 文档，API 调试、API 数据 Mock、API 自动化测试就可以直接使用，无需再次定义；API 文档和 API 开发调试使用同一个工具，API 调试完成后即可保证和 API 文档定义完全一致。高效、及时、准确！","name":"Apifox","publisher":"Apifox Team","tags":["api","互联网","响应","开发","接口","网络","自动化","请求","调试"]},"schemaVersion":1,"source":"winget","versions":[{"architectures":["x64"],"detailPath":"versions/2.8.54/app.json","detailSha256":"db70b2ae13d17e139839cf142d0fcad171cefb54ee68a3955eaf7a376527ec5f","releaseDate":"2026-11-11","releaseDateSource":"commit","version":"2.8.54"},{"architectures":["x64"],"detailPath":"versions/2.8.52/app.json","detailSha256":"9fa92a8e88090b4d7e8957c98e7c9f1c3d0d8083e044fffadf9888a5f71f9ee2","releaseDate":"2026-10-22","releaseDateSource":"manifest","version":"2.8.52"},{"architectures":["x64"],"detailPath":"versions/2.8.51/app.json","detailSha256":"8f2c65e8c8e30f3c655f9eee42fe4c499e60cc2f2f0fe5ad16d48faeabe9701a","releaseDate":"2026-10-14","releaseDateSource":"manifest","version":"2.8.51"},{"architectures":["x64"],"detailPath":"versions/2.8.49/app.json","detailSha256":"e862cf7cd880ec06161c7bd986628a702031b40d1989f76d060903701daf7a90","releaseDate":"2026-09-28","releaseDateSource":"manifest","version":"2.8.49"},{"architectures":["x64"],"detailPath":"versions/2.8.48/app.json","detailSha256":"e91ac1fa465c4d36f6a638dcd0285e5b319c91712804232aef4bc531c44ce2b8","releaseDate":"2026-09-18","releaseDateSource":"manifest","version":"2.8.48"},{"architectures":["x64"],"detailPath":"versions/2.8.47/app.json","detailSha256":"201729923f789727fcfa821ef2a61ee1346fcd12da0c051955ae0f230fa34c9b","releaseDate":"2026-09-14","releaseDateSource":"manifest","version":"2.8.47"},{"architectures":["x64"],"detailPath":"versions/2.8.46/app.json","detailSha256":"4d761eedc0803f49e13407779be6efa30b5e291ab4511ca9630229f6af3d45ae","releaseDate":"2026-09-04","releaseDateSource":"manifest","version":"2.8.46"},{"architectures":["x64"],"detailPath":"versions/2.8.45