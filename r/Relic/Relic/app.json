ssword manager exclusion formats, and wipes copied secrets from the clipboard after 30 seconds. It also includes encrypted share links, offline QR sharing, a vault for items you want to keep forever, per-app capture blocking, and a command line tool that AI agents can use to read and write your local vault.","moniker":"relic","name":"Relic","packageUrl":"https://github.com/RelicSync/relic","publisher":"Relic","publisherUrl":"https://relic.space","tags":["clipboard","clipboard-manager","e2ee","encryption","ocr","open-source","productivity","search"]},"schemaVersion":1,"source":"winget","versions":[{"architectures":["x64"],"detailPath":"versions/1.0.66/app.json","detailSha256":"bb49c444b1f9359dc42223051bfef0bccf31a325543e04c19b514df13599d6db","version":"1.0.66"},{"architectures":["x64"],"detailPath":"versions/1.0.64/app.json","detailSha256":"8cdc4b153714752871465262f00fe31dfa57b1b5776b40faad2d25a1d9d9de1e","version":"1.0.64"},{"architectures":["x64"],"detailPath":"versions/1.0.63/app.json","detailSha256":"18e2285e9b9a3b446000ab8217f682408b5d5ba1568c791e26425f4084f48046","version":"1.0.63"},{"architectures":["x64"],"detailPath":"versions/1.0.62/app.json","detailSha256":"b4dbf92ef1eb734bcda564417aaf51630ff64a895c463ba4fa3162d1ff41f9b7","version":"1.0.62"},{"architectures":["x64"],"detailPath":"versions/1.0.60/app.json","detailSha256":"42550e2be7047eb57dc85cf218b40c3c4c1499eb29622bc466e0479d22ba243e","version":"1.0.60"},{"architectures":["x64"],"detailPath":"versions/1.0.59/app.json","detailSha256":"6525d1a3879d50f0868294eb9d0d0a9da282d407d8820c6c254be8cd65fe475f","version":"1.0.59"},{"architectures":["x64"],"detailPath":"versions/1.0.54/app.json","detailSha256":"9ef1630c166aadfe132324c27936037beb0a500431cbe81d5f7332fbe1496073","version":"1.0.54"},{"architectures":["x64"],"detailPath":"versions/1.0.53/app.json","detailSha256":"d53e31e5ac9fb376877471b46dbab4499bc70d5cbdb5eb8fe9ce120836490e53","version":"1.0.53"},{"architectures":["x64"],"detailPath":"versions/1.0.50/app.j