{"defaultLocale":"en-US","id":"RcloneUI.RcloneUI","installers":[{"appsAndFeaturesEntries":[{"ProductCode":"Rclone UI"}],"architecture":"arm64","dependencies":[],"elevation":{"requirement":"elevationRequired","source":"manifest"},"id":"arm64-machine-nullsoft","installerSwitches":{"Custom":"/allusers","Upgrade":"--updated"},"locale":"en-US","minimumOSVersion":"10.0.19042.0","platforms":["Windows.Desktop"],"priority":1,"scope":"machine","sha256":"1293fda84d3f7a47c46d35da80767587bee1d95332e6bb79c51658757c66485f","silent":{"arguments":"/S","source":"default"},"successCodes":[],"type":"nullsoft","uninstall":{"type":"productCode","value":"Rclone UI"},"upgradeBehavior":"install","url":"https://github.com/rclone-ui/rclone-ui/releases/download/v3.7.3/Rclone.UI_arm64.exe"},{"appsAndFeaturesEntries":[{"ProductCode":"Rclone UI"}],"architecture":"x64","dependencies":[],"elevation":{"requirement":"elevationRequired","source":"manifest"},"id":"x64-machine-nullsoft","installerSwitches":{"Custom":"/allusers","Upgrade":"--updated"},"locale":"en-US","minimumOSVersion":"10.0.19042.0","platforms":["Windows.Desktop"],"priority":1,"scope":"machine","sha256":"83be275e7cb6a136080daa380e1e7275b17a12ab2eed5822b734070eb88f0367","silent":{"arguments":"/S","source":"default"},"successCodes":[],"type":"nullsoft","uninstall":{"type":"productCode","value":"Rclone UI"},"upgradeBehavior":"install","url":"https://github.com/rclone-ui/rclone-ui/releases/download/v3.7.3/Rclone.UI_x64.exe"}],"licenseUrl":"https://github.com/rclone-ui/rclone-ui/blob/HEAD/LICENSE","packageLocalizations":{"en-US":{"description":"GUI for Rclone, the CLI for cloud storage & S3.","license":"Apache-2.0","licenseUrl":"https://github.com/rclone-ui/rclone-ui/blob/HEAD/LICENSE","locale":"en-US","longDescription":"Rclone UI is a light, transparent layer on top of rclone to manage your remotes & tasks in a more user-friendly way.\n\nFeatures:\n- Cross platform running on Windows, Linux, macOS (x64, Arm and Apple Silicon)\n- Works with your existing rclone installation (or can install rclone for you) and keeps it updated (with your approval)\n- Add/Edit/Remove Remotes\n- Sync, Copy, Move, Delete, Purge, Serve, Mount, etc\n- Save time by setting default flags for each Remote separately, for each operation (Mount, Sync, Copy, etc)\n- Customize the flags (parameters) when running an operation, on a case by case basis\n- Embedded documentation for each flag, no need to google what everything does!\n- File Browser\n- Proxy\n- Scheduled Tasks (cron)\n- Job Logs (visualize all background operations)\n- Start on boot (autostart) and Mount on start (automount)\n- Set a password for the Settings panel\n- Hide commands or Remotes from the tray menu\n- Import/Export Configs (encrypted with pass or command)","moniker":"rclone-ui","name":"Rclone UI","packageUrl":"https://github.com/rclone-ui/rclone-ui","publisher":"Rclone UI","publisherUrl":"https://github.com/rclone-ui","releaseNotesUrl":"https://github.com/rclone-ui/rclone-ui/releases/tag/v3.7.3","tags":["backup","file-manager","file-transfer","ftp","rclone","rsync","s3","storage","webdav"]}},"publisherUrl":"https://github.com/rclone-ui","releaseDate":"2026-08-20","releaseDateSource":"manifest","releaseNotesUrl":"https://github.com/rclone-ui/rclone-ui/releases/tag/v3.7.3","schemaVersion":1,"source":"winget","upstream":{"commit":"97d6aa2689f0a05f7847653a62b8624720d15b5d","manifestVersion":"1.12.0","manifests":[{"path":"manifests/r/RcloneUI/RcloneUI/3.7.3/RcloneUI.RcloneUI.yaml","sha256":"ea168fe75678dc6d29d75affcac86499a5be752561e9519d5de3add839af84e4"},{"path":"manifests/r/RcloneUI/RcloneUI/3.7.3/RcloneUI.RcloneUI.installer.yaml","sha256":"685de5e6cd372b179630f60ea716064c1376e241c929e2f846ef4248227803eb"},{"path":"manifests/r/RcloneUI/RcloneUI/3.7.3/RcloneUI.RcloneUI.locale.en-US.yaml","sha256":"a7b4d7281b02ba88f2aca3d3ad3d9499128a68f7c958ccfaa251c740189f3d71"}],"repository":"microsoft/winget-pkgs"},"version":"3.7.3"}