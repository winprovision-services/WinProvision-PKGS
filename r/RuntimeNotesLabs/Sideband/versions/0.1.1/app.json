{"defaultLocale":"en-US","id":"RuntimeNotesLabs.Sideband","installers":[{"architecture":"x64","commands":["sideband"],"dependencies":[],"id":"x64-portable","priority":4,"sha256":"d1fa02ca87dd20d76dbb57be7cae6bd6ad357d0df35f3bb11fcce609156bdf0c","successCodes":[],"type":"portable","url":"https://github.com/runtimenoteslabs/sideband-public/releases/download/v0.1.1/sideband.exe"}],"licenseUrl":"https://github.com/runtimenoteslabs/sideband-public/blob/main/LICENSE","packageLocalizations":{"en-US":{"description":"Vendor-neutral monitor control for Windows over DDC/CI, with window arrangement.","license":"MIT","licenseUrl":"https://github.com/runtimenoteslabs/sideband-public/blob/main/LICENSE","locale":"en-US","longDescription":"sideband reads and writes monitor settings over DDC/CI, the control channel compliant\ndisplays have carried since 1998. Brightness, contrast, volume, input source and colour\npresets are set from the command line or from the notification area. There is no support\nlist, so any brand answers or reports why it cannot. A laptop's built-in panel has no\nDDC/CI channel and is driven through the display driver instead.\n\nIt also arranges open windows into zone layouts, with an undo that puts every window back\nwhere it was.\n\nOne executable of about 347 KB. No installer, no service, no driver, no elevation, no\nnetwork access and no telemetry.","moniker":"sideband","name":"sideband","packageUrl":"https://sideband.runtimenotes.com","publisher":"RuntimeNotes Labs","publisherUrl":"https://runtimenotes.com","releaseNotesUrl":"https://github.com/runtimenoteslabs/sideband-public/releases/tag/v0.1.1","tags":["brightness","ddc-ci","display","edid","kvm","mccs","monitor","monitor-control","vesa","window-management"]}},"publisherUrl":"https://runtimenotes.com","releaseDate":"2026-09-02","releaseDateSource":"manifest","releaseNotesUrl":"https://github.com/runtimenoteslabs/sideband-public/releases/tag/v0.1.1","schemaVersion":1,"source":"winget","upstream":{"comm