{"defaultLocale":"en-US","id":"Resplendence.LatencyMon","installers":[{"architecture":"neutral","dependencies":[],"elevation":{"requirement":"elevationRequired","source":"inferred"},"id":"neutral-machine-inno","installModes":["interactive","silent","silentWithProgress"],"minimumOSVersion":"10.0.0.0","platforms":["Windows.Desktop"],"priority":1,"scope":"machine","sha256":"d4e472879954380f5fbc49e2d5be8c5dbd75d5cf8908dd77278472598c6d17af","silent":{"arguments":"/VERYSILENT /SUPPRESSMSGBOXES /NORESTART /SP-","source":"default"},"successCodes":[],"type":"inno","upgradeBehavior":"install","url":"https://www.resplendence.com/download/LatencyMon.exe"}],"packageLocalizations":{"en-US":{"description":"Real-time audio suitability checker","license":"Proprietary","locale":"en-US","longDescription":"LatencyMon checks if a system running Windows is suitable for processing real-time audio and other tasks. LatencyMon analyzes the possible causes of buffer underruns by measuring kernel timer latencies and reporting DPC and ISR execution times as well as hard pagefaults. It will provide a comprehensible report and find the kernel modules and processes responsible for causing audio latencies which result in drop outs. It also provides the functionality of an ISR monitor, DPC monitor and a hard pagefault monitor.","moniker":"latencymon","name":"LatencyMon","packageUrl":"https://www.resplendence.com/latencymon","publisher":"Resplendence Software Projects Sp.","publisherUrl":"https://www.resplendence.com/main","releaseNotesUrl":"https://www.resplendence.com/latencymon_whatsnew","tags":["diagnostic","dpc","latency"]}},"publisherUrl":"https://www.resplendence.com/main","releaseNotesUrl":"https://www.resplendence.com/latencymon_whatsnew","schemaVersion":1,"source":"winget","upstream":{"commit":"97d6aa2689f0a05f7847653a62b8624720d15b5d","manifestVersion":"1.5.0","manifests":[{"path":"manifests/r/Resplendence/LatencyMon/7.31/Resplendence.LatencyMon.yaml","sha256":"770b8a735b1d498de1bcf2c03b83