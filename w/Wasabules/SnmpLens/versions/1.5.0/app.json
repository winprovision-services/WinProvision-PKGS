{"defaultLocale":"en-US","id":"Wasabules.SnmpLens","installers":[{"architecture":"x64","dependencies":[],"id":"x64-user-nullsoft","priority":1,"scope":"user","sha256":"840c141ca7d4fe45a353ad899e6c7d9b2d6bdc4217707417b246858e4c2d04c6","silent":{"arguments":"/S","source":"default"},"successCodes":[],"type":"nullsoft","url":"https://github.com/Wasabules/SnmpLens/releases/download/v1.5.0/SnmpLens-windows-amd64-setup.exe"}],"licenseUrl":"https://github.com/Wasabules/SnmpLens/blob/main/LICENSE","packageLocalizations":{"en-US":{"description":"Free SNMP MIB browser, trap receiver and alert router. Walk devices over v1, v2c and v3, edit MIBs with diagnostics, chart OIDs and route alerts to syslog, a webhook or email.","license":"MIT","licenseUrl":"https://github.com/Wasabules/SnmpLens/blob/main/LICENSE","locale":"en-US","longDescription":"SnmpLens is an open-source SNMP MIB browser for Windows, macOS and Linux, in a single native binary with no runtime and no agent. It walks and sets OIDs over SNMPv1, v2c and v3, renders conceptual tables as tables by splitting the INDEX per RFC 2578, receives traps and INFORMs, charts polled OIDs over time, and routes alerts to syslog over UDP, TCP or TLS, to a webhook, or to email.","moniker":"snmplens","name":"SnmpLens","packageUrl":"https://snmplens.com/","publisher":"Wasabules","publisherUrl":"https://snmplens.com/","releaseNotesUrl":"https://github.com/Wasabules/SnmpLens/releases/tag/v1.5.0","tags":["snmp","mib","mib-browser","snmpv3","network-monitoring","trap-receiver"]}},"publisherUrl":"https://snmplens.com/","releaseNotesUrl":"https://github.com/Wasabules/SnmpLens/releases/tag/v1.5.0","schemaVersion":1,"source":"winget","upstream":{"commit":"97d6aa2689f0a05f7847653a62b8624720d15b5d","manifestVersion":"1.12.0","manifests":[{"path":"manifests/w/Wasabules/SnmpLens/1.5.0/Wasabules.SnmpLens.yaml","sha256":"919fe08884837beb114a0a3be7fd68237e2222e7e8cc4fd020e36f2cc48b496a"},{"path":"manifests/w/Wasabules/SnmpLens/1.5.0/Wasabules.SnmpLens.