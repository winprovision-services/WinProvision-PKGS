{"defaultLocale":"zh-CN","id":"wanghongyu666qiang.AskBridge","installers":[{"architecture":"x64","dependencies":[],"id":"x64-zip","minimumOSVersion":"10.0.17763.0","nestedInstallerFiles":[{"PortableCommandAlias":"askbridge","RelativeFilePath":"askbridge.exe"}],"nestedInstallerType":"portable","priority":4,"sha256":"0dc73be8d690310bae1c21dd1d78df1e2da3c1af3f7cdd7fa0af9092d40b3eeb","successCodes":[],"type":"zip","url":"https://github.com/wanghongyu666qiang/AskBridge/releases/download/v2.1.0/AskBridge-2.1.0-windows-x64.zip"}],"licenseUrl":"https://github.com/wanghongyu666qiang/AskBridge/blob/main/LICENSE","packageLocalizations":{"en-US":{"description":"Windows screenshot-to-AI bridge that stages a screen capture plus preset text into AI web chat boxes.","license":"Apache-2.0","licenseUrl":"https://github.com/wanghongyu666qiang/AskBridge/blob/main/LICENSE","locale":"en-US","longDescription":"AskBridge is a Windows screenshot-to-AI tool. After selecting a screen region, you can copy the capture, switch AI models, or stage the screenshot together with preset text into the input box of ChatGPT, Gemini, Claude, Doubao, DeepSeek, Zhipu Qingyan (GLM), Kimi, and other AI websites.\nThe app lives in the system tray and captures with Alt+Q. It never calls model APIs and never clicks a website's send button; whether to send is always decided by the user. In-app updates are verified with both SHA-256 and an offline Ed25519 signature.","name":"AskBridge","packageUrl":"https://github.com/wanghongyu666qiang/AskBridge","privacyUrl":"https://github.com/wanghongyu666qiang/AskBridge/blob/main/docs/PRIVACY.md","publisher":"wanghongyu666qiang","tags":["ai","chatgpt","clipboard","hotkey","screenshot"]},"zh-CN":{"description":"Windows 截图问答桥，把框选截图和预设文字准备到 AI 网页输入区。","license":"Apache-2.0","licenseUrl":"https://github.com/wanghongyu666qiang/AskBridge/blob/main/LICENSE","locale":"zh-CN","longDescription":"AskBridge 是一个 Windows 截图问答工具。框选屏幕内容后，可以复制截图、切换 AI 模型，或将截图和预设文字准备到 ChatGPT、Gemini、Claude、豆包、DeepSeek、智谱清言、Kimi 等网页的输入区。\n程序常驻系统托盘，通过 Alt+Q 快捷键框选截图；不调用模型 API，不自动点击发送按钮，最终是否发送始终由用户决定。应用内更新通过 SHA-256 与 Ed25519 离线签名双重校验。","name":"AskBridge","packageUrl":"https://github.com/wanghongyu666qiang/AskBridge","privacyUrl":"https://github.com/wanghongyu666qiang/AskBridge/blob/main/docs/PRIVACY.md","publisher":"wanghongyu666qiang","publisherSupportUrl":"https://github.com/wanghongyu666qiang/AskBridge/issues","publisherUrl":"https://github.com/wanghongyu666qiang","tags":["ai","chatgpt","clipboard","hotkey","screenshot"]}},"publisherSupportUrl":"https://github.com/wanghongyu666qiang/AskBridge/issues","publisherUrl":"https://github.com/wanghongyu666qiang","releaseDate":"2026-11-08","releaseDateSource":"commit","schemaVersion":1,"source":"winget","upstream":{"commit":"08937c3b6e9458bc83caa2e8eb86280833e9ca73","manifestVersion":"1.28.0","manifests":[{"path":"manifests/w/wanghongyu666qiang/AskBridge/2.1.0/wanghongyu666qiang.AskBridge.installer.yaml","sha256":"0b8e3a46fc06b95fbb5f91e22223cca1e0912dd12361595b83a571f706d474ca"},{"path":"manifests/w/wanghongyu666qiang/AskBridge/2.1.0/wanghongyu666qiang.AskBridge.locale.en-US.yaml","sha256":"3637d9258d1d0e83ae46aea00e0c04f68c17189ab33e821e12c76bb0b02e0e52"},{"path":"manifests/w/wanghongyu666qiang/AskBridge/2.1.0/wanghongyu666qiang.AskBridge.locale.zh-CN.yaml","sha256":"a275c31191a573a03baa088b74ec34e1075562c3aeddeaa5594afa4a68fb49cf"},{"path":"manifests/w/wanghongyu666qiang/AskBridge/2.1.0/wanghongyu666qiang.AskBridge.yaml","sha256":"6201fe9ef4505e8a0ae1484a75f1ac122a6c1abedb886f51360bdd8714b78d1c"}],"repository":"microsoft/winget-pkgs"},"version":"2.1.0"}