[],"elevation":{"requirement":"elevationRequired","source":"inferred"},"id":"x86-machine-wix","installModes":["interactive","silent","silentWithProgress"],"locale":"en-US","priority":2,"scope":"machine","sha256":"bc82eb0db690ad6194717566fa00338a3666b550ae01d87097ccd212e4d4c3b7","silent":{"arguments":"/quiet /norestart","source":"default"},"successCodes":[],"type":"wix","uninstall":{"type":"productCode","value":"{F5B79011-DDE5-4A0E-B085-69B0BABFE3AA}"},"url":"https://github.com/windirstat/windirstat/releases/download/beta/v2.5.6/2026-02-28/WinDirStat-x86.msi"}],"licenseUrl":"https://github.com/windirstat/windirstat/blob/HEAD/LICENSE.md","packageLocalizations":{"en-US":{"description":"Disk usage statistics viewer and cleanup tool","license":"GPL-2.0","licenseUrl":"https://github.com/windirstat/windirstat/blob/HEAD/LICENSE.md","locale":"en-US","longDescription":"WinDirStat is a program that allows you to find disk space hogs at a glance. It achieves that by displaying a drive, drives or directories in a treemap that assigns bigger areas to bigger files and directories. Making those areas visually separate by coloring and other means allows you to see literally at a glance what the space hogs are and where to dig deeper.\nThe directory tree is simultaneously shown as a tree list and as a treemap. One can effortlessly gain an impression of the proportions on the hard disk(s).\n\nMajor features\n  - Three views: Directory Tree, Treemap, and Extension\n  - Duplicate file detection\n  - Built-in cleanup actions including Open, Delete, Show Properties\n  - User-defined cleanup actions (command line based)","moniker":"windirstat-beta","name":"WinDirStat (Beta)","packageUrl":"https://windirstat.net/","publisher":"The WinDirStat Team","publisherUrl":"https://windirstat.net/","releaseNotesUrl":"https://github.com/windirstat/windirstat/releases/tag/beta/v2.5.6/2026-02-28","tags":["cleanup","disk-usage","kdirstat","organization","sequoiaview","statistics"]}},"publisherUrl":"https: