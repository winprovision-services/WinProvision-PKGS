[],"elevation":{"requirement":"elevationRequired","source":"inferred"},"id":"x86-machine-wix","installModes":["interactive","silent","silentWithProgress"],"locale":"en-US","priority":2,"scope":"machine","sha256":"3ce3083d65e7ce9191b9d2bac5612df0b65ddd88dd0658d9bbc36b760794deff","silent":{"arguments":"/quiet /norestart","source":"default"},"successCodes":[],"type":"wix","uninstall":{"type":"productCode","value":"{F7381129-B2ED-49F1-B1F2-792D93AD402D}"},"url":"https://github.com/windirstat/windirstat/releases/download/beta/v2.5.5/2026-02-27/WinDirStat-x86.msi"}],"licenseUrl":"https://github.com/windirstat/windirstat/blob/HEAD/LICENSE.md","packageLocalizations":{"en-US":{"description":"Disk usage statistics viewer and cleanup tool","license":"GPL-2.0","licenseUrl":"https://github.com/windirstat/windirstat/blob/HEAD/LICENSE.md","locale":"en-US","longDescription":"WinDirStat is a program that allows you to find disk space hogs at a glance. It achieves that by displaying a drive, drives or directories in a treemap that assigns bigger areas to bigger files and directories. Making those areas visually separate by coloring and other means allows you to see literally at a glance what the space hogs are and where to dig deeper.\nThe directory tree is simultaneously shown as a tree list and as a treemap. One can effortlessly gain an impression of the proportions on the hard disk(s).\n\nMajor features\n  - Three views: Directory Tree, Treemap, and Extension\n  - Duplicate file detection\n  - Built-in cleanup actions including Open, Delete, Show Properties\n  - User-defined cleanup actions (command line based)","moniker":"windirstat-beta","name":"WinDirStat (Beta)","packageUrl":"https://windirstat.net/","publisher":"The WinDirStat Team","publisherUrl":"https://windirstat.net/","releaseNotesUrl":"https://github.com/windirstat/windirstat/releases/tag/beta/v2.5.5/2026-02-27","tags":["cleanup","disk-usage","kdirstat","organization","sequoiaview","statistics"]}},"publisherUrl":"https: