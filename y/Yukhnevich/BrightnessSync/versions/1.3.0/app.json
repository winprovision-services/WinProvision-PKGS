{"defaultLocale":"en-US","id":"Yukhnevich.BrightnessSync","installers":[{"architecture":"neutral","commands":["brightnesssync"],"dependencies":[],"id":"neutral-portable","minimumOSVersion":"10.0.0.0","priority":4,"sha256":"0591a53570843178c037338ceb104b19d6bee486b96984ae6a673f9f83c92b74","successCodes":[],"type":"portable","url":"https://github.com/Yukhnevich/BrightnessSync/releases/download/v1.3.0/BrightnessSync.exe"}],"licenseUrl":"https://github.com/Yukhnevich/BrightnessSync/blob/main/LICENSE","packageLocalizations":{"en-US":{"description":"Keeps laptop brightness the same across Windows power plans and adjusts laptop and external monitors from the tray.","license":"MIT","licenseUrl":"https://github.com/Yukhnevich/BrightnessSync/blob/main/LICENSE","locale":"en-US","longDescription":"Windows stores display brightness separately for every power plan, so switching power modes\n(for example ASUS Armoury Crate Silent / Performance / Turbo) changes the brightness.\nBrightness Sync is a small tray utility that writes the current brightness into every power plan,\nso all modes share one brightness level.\n\nScroll over the tray icon to change the brightness of the laptop and external monitors (over DDC/CI).\nAll displays move together and keep the difference between them.\nIn HDR, monitors get SDR content brightness, and the laptop keeps its usual brightness apart from HDR's.","moniker":"brightnesssync","name":"Brightness Sync","packageUrl":"https://github.com/Yukhnevich/BrightnessSync","publisher":"Yukhnevich","publisherUrl":"https://github.com/Yukhnevich","releaseNotesUrl":"https://github.com/Yukhnevich/BrightnessSync/releases/tag/v1.3.0","tags":["brightness","display","power-plan","power-scheme","laptop","tray","armoury-crate","monitor","ddc-ci","hdr"]}},"publisherUrl":"https://github.com/Yukhnevich","releaseNotesUrl":"https://github.com/Yukhnevich/BrightnessSync/releases/tag/v1.3.0","schemaVersion":1,"source":"winget","upstream":{"commit":"97d6aa2689f0a05f7847653a62b