{"defaultLocale":"en-US","id":"YasinDeryaBilgin.WindowsCareKit","installers":[{"architecture":"x64","dependencies":[],"elevation":{"requirement":"elevationRequired","source":"inferred"},"id":"x64-machine-inno","installModes":["interactive","silent","silentWithProgress"],"minimumOSVersion":"10.0.19041.0","platforms":["Windows.Desktop"],"priority":1,"scope":"machine","sha256":"cd3ec08cafcb39f0687e665a965e96b94f90d882f0466e0654d4de08f4f7bfa2","silent":{"arguments":"/VERYSILENT /SUPPRESSMSGBOXES /NORESTART /SP-","source":"default"},"successCodes":[],"type":"inno","uninstall":{"type":"productCode","value":"{5CDA29A9-74D6-48D3-A70E-806E22E4A47A}_is1"},"upgradeBehavior":"install","url":"https://github.com/ydbilgin/windows-care-kit/releases/download/v0.2.0-beta/WindowsCareKit-Setup-v0.2.0-beta-win-x64.exe"}],"licenseUrl":"https://github.com/ydbilgin/windows-care-kit/blob/master/LICENSE","packageLocalizations":{"en-US":{"description":"Radically honest Windows format/reinstall toolkit — uninstall, clean, pre-format backup, reinstall, and settings migration that tells you what can't transfer instead of faking success.","license":"MIT","licenseUrl":"https://github.com/ydbilgin/windows-care-kit/blob/master/LICENSE","locale":"en-US","longDescription":"Windows Care Kit carries your settings, files, and app list across a Windows reinstall and puts\nthem back in the right place. Every destructive action is a dry-run first, behind an explicit\napproval gate, and it is radically honest — it tells you exactly what cannot transfer\n(machine-bound credentials, DPAPI-protected data) instead of faking success. Covers the full\nformat lifecycle: Uninstall, Clean, pre-format Backup, Reinstall, and Migration. The installer\nis component-based: install only the modules you want. Open-source, ad-free, .NET 10. Beta.","moniker":"windows-care-kit","name":"Windows Care Kit","packageUrl":"https://github.com/ydbilgin/windows-care-kit","publisher":"Yasin Derya Bilgin","publisherUrl":"https://github.c