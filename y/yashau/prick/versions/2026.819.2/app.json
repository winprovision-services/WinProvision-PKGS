 and an MCP server ship alongside the CLI.","moniker":"prk","name":"prick","packageUrl":"https://github.com/yashau/prick","publisher":"yashau","publisherUrl":"https://github.com/yashau","releaseNotesUrl":"https://github.com/yashau/prick/releases/tag/v2026.819.2","tags":["cli","cloudflare-access","cloudflare-d1","cloudflare-workers","developer-tools","devops","dotenv","environment-variables","rust","secrets-management","security","self-hosted","svelte"]}},"publisherUrl":"https://github.com/yashau","releaseDate":"2026-08-19","releaseDateSource":"manifest","releaseNotesUrl":"https://github.com/yashau/prick/releases/tag/v2026.819.2","schemaVersion":1,"source":"winget","upstream":{"commit":"97d6aa2689f0a05f7847653a62b8624720d15b5d","manifestVersion":"1.12.0","manifests":[{"path":"manifests/y/yashau/prick/2026.819.2/yashau.prick.yaml","sha256":"7febdad6b02cd5d3c362463c453ee07b0feeb20f296656a2b0bb90cf6e1b35fc"},{"path":"manifests/y/yashau/prick/2026.819.2/yashau.prick.installer.yaml","sha256":"55d3e33106ac63730db86543b5562afc8605b44f07adc15e475fc779fb1ac770"},{"path":"manifests/y/yashau/prick/2026.819.2/yashau.prick.locale.en-US.yaml","sha256":"acaf44a77b7d45d2c97ca0f4f07e6367f1af0eec6979e896b79b33e56d2da2db"}],"repository":"microsoft/winget-pkgs"},"version":"2026.819.2"}