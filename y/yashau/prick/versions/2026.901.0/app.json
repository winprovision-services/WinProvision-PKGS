 and an MCP server ship alongside the CLI.","moniker":"prk","name":"prick","packageUrl":"https://github.com/yashau/prick","publisher":"yashau","publisherUrl":"https://github.com/yashau","releaseNotesUrl":"https://github.com/yashau/prick/releases/tag/v2026.901.0","tags":["cli","cloudflare-access","cloudflare-d1","cloudflare-workers","developer-tools","devops","dotenv","environment-variables","rust","secrets-management","security","self-hosted","svelte"]}},"publisherUrl":"https://github.com/yashau","releaseDate":"2026-09-01","releaseDateSource":"manifest","releaseNotesUrl":"https://github.com/yashau/prick/releases/tag/v2026.901.0","schemaVersion":1,"source":"winget","upstream":{"commit":"97d6aa2689f0a05f7847653a62b8624720d15b5d","manifestVersion":"1.12.0","manifests":[{"path":"manifests/y/yashau/prick/2026.901.0/yashau.prick.yaml","sha256":"19c63ac9c624d3fb4f442001948f7971fcfe5263fbd2c38d1d9b513dfefbe110"},{"path":"manifests/y/yashau/prick/2026.901.0/yashau.prick.installer.yaml","sha256":"99d27135a9c86fb25e8ef695c291fb42ca051830f5f0ed2eb49a64354e030ed3"},{"path":"manifests/y/yashau/prick/2026.901.0/yashau.prick.locale.en-US.yaml","sha256":"cdb55454f347533acfffb6eeee264a65ea36abcd2af95849699b6077db255aa6"}],"repository":"microsoft/winget-pkgs"},"version":"2026.901.0"}