":["interactive","silent","silentWithProgress"],"installerSwitches":{"InstallLocation":"INSTALLDIR=\"<INSTALLPATH>\"","Log":"/log \"<LOGPATH>\"","Silent":"/quiet /norestart","SilentWithProgress":"/passive /norestart"},"priority":1,"sha256":"e5217ce869672ec818edea9afdcfbee3020eb66cee7f2d4a4586047e608f8c51","silent":{"arguments":"/quiet /norestart","source":"manifest"},"successCodes":[],"type":"exe","uninstall":{"type":"productCode","value":"{16FC80BD-D527-4367-AE41-596E3A11D5E0}"},"url":"https://dl.duosecurity.com/duo-win-login-6.0.1.exe"}],"licenseUrl":"https://duo.com/legal/terms","packageLocalizations":{"en-US":{"description":"Add two-factor authentication to Remote Desktop and local logons and credentialed UAC elevation prompts.","license":"Proprietary","licenseUrl":"https://duo.com/legal/terms","locale":"en-US","longDescription":"Duo Authentication for Windows Logon adds Duo two-factor authentication to these Windows and Windows Server logon scenarios:\n- Local or domain account logins\n- Logins at the local console and/or incoming Remote Desktop (RDP) connections\n- Credentialed User Access Control (UAC) elevation requests (e.g. Right-click + \"Run as administrator\") in v4.1.0 and later\nDuo's Windows Logon client does not add a secondary authentication prompt to the following logon types:\n- Shift + right-click \"Run as different user\"\n- PowerShell \"Enter-PSSession\" or \"Invoke-Command\" cmdlets\n- Non-interactive logons (i.e. Log on as a Service, Log on as Batch, Scheduled Tasks, drive mappings, etc.)\n- Pre-Logon Access Providers (PLAPs) such as Windows Always On VPN\n- RDP Restricted Admin Mode","name":"Duo Authentication for Windows Logon","packageUrl":"https://duo.com/docs/rdp","publisher":"Duo Security Inc.","publisherUrl":"https://duo.com/","releaseNotesUrl":"https://duo.com/docs/rdp-notes","tags":[]},"zh-CN":{"description":"为远程桌面和本地登录以及带凭据的 UAC 提权提示添加双重身份验证。","license":"专有软件","locale":"zh-CN","longDescription":"Duo Authentication for Windows Logon 将 Duo 双因素身份验证添加到以下 Windows 和 Windows Server 登录场景中：\n- 本地或域账户登录\n- 本地控制台登录和/或传入的远程桌面（RDP）连接\n- 使用凭证的用户访问控制（UAC）提权请求（例如，右键单击 + “以管理员身份运行”），在 v4.1.0 及更高版本中支持\nDuo 的 Windows 登录客户端不会为以下登录类型添加二次身份验证提示：\n- 按住 Shift 键并右键单击“以其他用户身份运行”\n- PowerShell 的 “Enter-PSSession” 或 “Invoke-Command” 命令\n- 非交互式登录（例如，以服务身份登录、以批处理身份登录、计划任务、驱动器映射等）\n- 登录前访问提供程序（PLAP），例如 Windows 始终连接的 VPN\n- RDP 受限管理模式","tags":[]}},"publisherUrl":"https://duo.com/","releaseDate":"2026-11-03","releaseDateSource":"manifest","releaseNotesUrl":"https://duo.com/docs/rdp-notes","schemaVersion":1,"source":"winget","upstream":{"commit":"97d6aa2689f0a05f7847653a62b8624720d15b5d","manifestVersion":"1.28.0","manifests":[{"path":"manifests/d/DuoSecurity/Duo2FAAuthenticationforWindows/6.0.1.4655/DuoSecurity.Duo2FAAuthenticationforWindows.yaml","sha256":"e395ffd7d36d5aab56c78b21c2001bcafd0c5527b9c5a122cd41279cc11692d2"},{"path":"manifests/d/DuoSecurity/Duo2FAAuthenticationforWindows/6.0.1.4655/DuoSecurity.Duo2FAAuthenticationforWindows.installer.yaml","sha256":"d129b46b9d105d7d2dbea11dd4ce8130e5e1b3f5417fcd68e7dfaedcf44baec0"},{"path":"manifests/d/DuoSecurity/Duo2FAAuthenticationforWindows/6.0.1.4655/DuoSecurity.Duo2FAAuthenticationforWindows.locale.en-US.yaml","sha256":"317f75d77e21d048dca01623630417bf05f04d545f5c943ba0a6eae820a38c3d"},{"path":"manifests/d/DuoSecurity/Duo2FAAuthenticationforWindows/6.0.1.4655/DuoSecurity.Duo2FAAuthenticationforWindows.locale.zh-CN.yaml","sha256":"11b27c513c9f40752a2818cb461b270ee9ba407097eee3b5c737981932102053"}],"repository":"microsoft/winget-pkgs"},"version":"6.0.1.4655"}