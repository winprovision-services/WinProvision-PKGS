":["interactive","silent","silentWithProgress"],"installerSwitches":{"InstallLocation":"INSTALLDIR=\"<INSTALLPATH>\"","Log":"/log \"<LOGPATH>\"","Silent":"/quiet /norestart","SilentWithProgress":"/passive /norestart"},"priority":1,"sha256":"e036c33d6c0c36184fd739da3944cd11f6a275e61a6315f2be59a50db0e4dcdd","silent":{"arguments":"/quiet /norestart","source":"manifest"},"successCodes":[],"type":"exe","uninstall":{"type":"productCode","value":"{E6CFB61A-8834-4302-8554-2FD86B1FB1E6}"},"url":"https://dl.duosecurity.com/duo-win-login-6.0.0.exe"}],"licenseUrl":"https://duo.com/legal/terms","packageLocalizations":{"en-US":{"description":"Add two-factor authentication to Remote Desktop and local logons and credentialed UAC elevation prompts.","license":"Proprietary","licenseUrl":"https://duo.com/legal/terms","locale":"en-US","longDescription":"Duo Authentication for Windows Logon adds Duo two-factor authentication to these Windows and Windows Server logon scenarios:\n- Local or domain account logins\n- Logins at the local console and/or incoming Remote Desktop (RDP) connections\n- Credentialed User Access Control (UAC) elevation requests (e.g. Right-click + \"Run as administrator\") in v4.1.0 and later\nDuo's Windows Logon client does not add a secondary authentication prompt to the following logon types:\n- Shift + right-click \"Run as different user\"\n- PowerShell \"Enter-PSSession\" or \"Invoke-Command\" cmdlets\n- Non-interactive logons (i.e. Log on as a Service, Log on as Batch, Scheduled Tasks, drive mappings, etc.)\n- Pre-Logon Access Providers (PLAPs) such as Windows Always On VPN\n- RDP Restricted Admin Mode","name":"Duo Authentication for Windows Logon","packageUrl":"https://duo.com/docs/rdp","publisher":"Duo Security Inc.","publisherUrl":"https://duo.com/","releaseNotesUrl":"https://duo.com/docs/rdp-notes","tags":[]},"zh-CN":{"description":"为远程桌面和本地登录以及带凭据的 UAC 提权提示添加双重身份验证。","license":"专有软件","locale":"zh-CN","longDescription":"Duo Authentication for Windows Logon 将 Duo 双因素身份验证添加到以下 Windows 和 Windows Server 登录场景中：\n- 本地或域账户登录\n- 本地控制台登录和/或传入的远程桌面（RDP）连接\n- 使用凭证的用户访问控制（UAC）提权请求（例如，右键单击 + “以管理员身份运行”），在 v4.1.0 及更高版本中支持\nDuo 的 Windows 登录客户端不会为以下登录类型添加二次身份验证提示：\n- 按住 Shift 键并右键单击“以其他用户身份运行”\n- PowerShell 的 “Enter-PSSession” 或 “Invoke-Command” 命令\n- 非交互式登录（例如，以服务身份登录、以批处理身份登录、计划任务、驱动器映射等）\n- 登录前访问提供程序（PLAP），例如 Windows 始终连接的 VPN\n- RDP 受限管理模式","tags":[]}},"publisherUrl":"https://duo.com/","releaseDate":"2026-09-03","releaseDateSource":"manifest","releaseNotesUrl":"https://duo.com/docs/rdp-notes","schemaVersion":1,"source":"winget","upstream":{"commit":"97d6aa2689f0a05f7847653a62b8624720d15b5d","manifestVersion":"1.12.0","manifests":[{"path":"manifests/d/DuoSecurity/Duo2FAAuthenticationforWindows/6.0.0.4198/DuoSecurity.Duo2FAAuthenticationforWindows.yaml","sha256":"76758c679c5a63bd51c76edf6022ee5f6ebbe0b6870d04bbfcc7e2785ba32c8a"},{"path":"manifests/d/DuoSecurity/Duo2FAAuthenticationforWindows/6.0.0.4198/DuoSecurity.Duo2FAAuthenticationforWindows.installer.yaml","sha256":"15dd714a55b9b3c8bb57b1a375c02a4d90ac393632d9a9ac02ec02a97aa2625b"},{"path":"manifests/d/DuoSecurity/Duo2FAAuthenticationforWindows/6.0.0.4198/DuoSecurity.Duo2FAAuthenticationforWindows.locale.en-US.yaml","sha256":"473e1c7257604a443aa22faf5ce09ca82896e3ab8dafd3c28fc77397b9957da3"},{"path":"manifests/d/DuoSecurity/Duo2FAAuthenticationforWindows/6.0.0.4198/DuoSecurity.Duo2FAAuthenticationforWindows.locale.zh-CN.yaml","sha256":"3279e034dcf36da7d360de69e6b7d5f2a4a4a800e24f4e4478ab72c0aaea0a82"}],"repository":"microsoft/winget-pkgs"},"version":"6.0.0.4198"}