{"defaultLocale":"en-US","id":"d4vid87.tempest-radar","installers":[{"architecture":"x64","commands":["TempestRadar"],"dependencies":[],"id":"x64-portable","installModes":["interactive","silent","silentWithProgress"],"priority":4,"sha256":"25f3b56e199846d1aa9b3245b880891f45120f6361a1bbe322ae7c96b7002ff7","successCodes":[],"type":"portable","upgradeBehavior":"uninstallPrevious","url":"https://github.com/d4vid87/tempest-radar/releases/download/v1.0.0/TempestRadar.exe"}],"licenseUrl":"https://github.com/d4vid87/tempest-radar/blob/master/LICENSE","packageLocalizations":{"en-US":{"description":"Tempest Radar","license":"MIT","licenseUrl":"https://github.com/d4vid87/tempest-radar/blob/master/LICENSE","locale":"en-US","longDescription":"A self-hosted severe-weather console that combines your WeatherFlow Tempest station, NEXRAD radar (tile loops and raw Level 2 with WebGL rendering), NWS alerts, and news tickers in one themeable web dashboard. The v2 interface is a full-bleed MapLibre GL console — floating control dock, bottom timeline, collapsible telemetry drawer — with the radar rendered as a native GPU custom layer driven by the map's own projection matrix (architecture modeled on the RadarOmega platform design: server-side decode → binary polar artifacts → catalog API → client WebGL with LUT color tables and a prefetching timeline). Runs anywhere Docker runs; open it from any browser on your network at http://<host>:5555.","moniker":"tempest-radar","name":"tempest-radar","packageUrl":"https://github.com/d4vid87/tempest-radar","publisher":"d4vid87","publisherUrl":"https://github.com/d4vid87","releaseNotesUrl":"https://github.com/d4vid87/tempest-radar/releases/tag/v1.0.0","tags":[]}},"publisherUrl":"https://github.com/d4vid87","releaseDate":"2026-07-05","releaseDateSource":"manifest","releaseNotesUrl":"https://github.com/d4vid87/tempest-radar/releases/tag/v1.0.0","schemaVersion":1,"source":"winget","upstream":{"commit":"97d6aa2689f0a05f7847653a62b8624720d15b5d","manifest