{"defaultLocale":"en-US","id":"Dilluti0n.DPIBreak","installers":[{"architecture":"x64","dependencies":[],"id":"x64-zip","nestedInstallerFiles":[{"PortableCommandAlias":"dpibreak","RelativeFilePath":"DPIBreak-0.6.1-x86_64-pc-windows-msvc\\dpibreak.exe"}],"nestedInstallerType":"portable","priority":4,"sha256":"09b7bf802d50a92de575caa6f13c838b22eda2c455bdb50d5bd72759bcbc18fa","successCodes":[],"type":"zip","url":"https://github.com/dilluti0n/dpibreak/releases/download/v0.6.1/DPIBreak-0.6.1-x86_64-pc-windows-msvc.zip"}],"licenseUrl":"https://raw.githubusercontent.com/dilluti0n/dpibreak/refs/heads/master/COPYING","packageLocalizations":{"en-US":{"description":"Fast and easy-to-use DPI circumvention tool in Rust","license":"GPL-3.0-or-later","licenseUrl":"https://raw.githubusercontent.com/dilluti0n/dpibreak/refs/heads/master/COPYING","locale":"en-US","longDescription":"Fast and easy-to-use tool for circumventing Deep Packet Inspection (DPI) on HTTPS connections. While your actual data is encrypted over HTTPS, there is a limitation: the TLS ClientHello packet - which contains the destination domain (aka SNI) - must be sent in plaintext during the initial handshake. DPI equipment inspects it at intermediate routers and drops the connection if its SNI is on their blacklist. The goal of DPIBreak is to manipulate outgoing TLS ClientHello packets in a standards-compliant way, so that DPI equipment can no longer detect the destination domain while the actual server still can.","moniker":"dpibreak","name":"DPIBreak","packageUrl":"https://github.com/dilluti0n/dpibreak","publisher":"Dilluti0n","publisherUrl":"https://github.com/dilluti0n","releaseNotesUrl":"https://github.com/dilluti0n/dpibreak/releases/tag/v0.6.1","tags":["dpi","privacy","censorship","firewall","tls","sni","vpn-alternative","network"]}},"publisherUrl":"https://github.com/dilluti0n","releaseDate":"2026-04-16","releaseDateSource":"manifest","releaseNotesUrl":"https://github.com/dilluti0n/dpibreak/releases/tag/v0.6.1