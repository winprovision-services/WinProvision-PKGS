{"defaultLocale":"en-US","id":"DarthDemono.PingDD","installers":[{"architecture":"x86","commands":["pingdd"],"dependencies":[],"id":"x86-portable","installLocationRequired":false,"priority":4,"sha256":"24f3c9e7876ca6eac378e03ce5c66a1ba11f38786b0ce762c3389c9308557023","successCodes":[],"type":"portable","upgradeBehavior":"uninstallPrevious","url":"https://github.com/darthdemono/PingDD/releases/download/v1.0.8/pingdd.exe"}],"licenseUrl":"https://github.com/DarthDemono/PingDD/blob/main/LICENSE","packageLocalizations":{"en-US":{"author":"DarthDemono","description":"Cross-platform command-line tool that checks whether a TCP port on a remote server is open and how fast it answers.","license":"MIT License","licenseUrl":"https://github.com/DarthDemono/PingDD/blob/main/LICENSE","locale":"en-US","longDescription":"PingDD is a cross-platform ping tool written in C for TCP port checking. Instead of ICMP, it connects to a specific TCP port on a host and reports whether the port is reachable and how long the connection took, so network administrators and enthusiasts can test the availability and responsiveness of a service on a remote server. It is a revival of Paping. Usage is `pingdd <hostname> -p <port> -c <count> -t <timeout>`: the port is required, the count defaults to infinite and the timeout is in milliseconds.\n","moniker":"pingdd","name":"PingDD","packageUrl":"https://darthdemono.github.io/PingDD/","publisher":"DarthDemono","publisherSupportUrl":"https://github.com/darthdemono/PingDD/issues","publisherUrl":"https://github.com/darthdemono","releaseNotesUrl":"https://github.com/darthdemono/PingDD/releases/tag/v1.0.8","tags":["ping","tcp","network","dns","diagnostics","terminal","ports"]}},"publisherSupportUrl":"https://github.com/darthdemono/PingDD/issues","publisherUrl":"https://github.com/darthdemono","releaseDate":"2026-11-06","releaseDateSource":"commit","releaseNotesUrl":"https://github.com/darthdemono/PingDD/releases/tag/v1.0.8","schemaVersion":1,"source":"winget","