ve","silent","silentWithProgress"],"locale":"en-US","priority":2,"scope":"machine","sha256":"c743055f24a51df10c5402d7fa6ba24f61938a4680dd1a98db7c539cfee629a2","silent":{"arguments":"/quiet /norestart","source":"default"},"successCodes":[],"type":"wix","uninstall":{"type":"productCode","value":"{D1680D5B-295F-0203-0000-250419162816}"},"upgradeBehavior":"deny","url":"https://github.com/dokan-dev/dokany/releases/download/v2.3.0.1000/Dokan_x86.msi"}],"licenseUrl":"https://github.com/dokan-dev/dokany/blob/master/license.mit.txt","packageLocalizations":{"en-US":{"description":"User mode file system library for windows with FUSE Wrapper","license":"LGPL/MIT","licenseUrl":"https://github.com/dokan-dev/dokany/blob/master/license.mit.txt","locale":"en-US","longDescription":"Dokany is a fork of Dokan 0.6.0 with bug fixes, clean change history and updated to build with latest tools.\n\nWhen you want to create a new file system on Windows, other than FAT or NTFS, you need to develop a file system driver. Developing a device driver that works in kernel mode on windows is extremely technical. By using Dokan, you can create your own file systems very easily without writing device drivers. Dokan is similar to FUSE (Linux file system in user space) but works on Windows. Moreover, dokany includes a FUSE wrapper that helps you to port your FUSE filesystems without changes.","moniker":"dokany","name":"Dokan Library","packageUrl":"https://dokan-dev.github.io/","publisher":"Dokany Project","publisherUrl":"https://dokan-dev.github.io/","releaseNotesUrl":"https://github.com/dokan-dev/dokany/releases/tag/v2.3.0.1000","tags":["driver","filesystem","fuse"]}},"publisherUrl":"https://dokan-dev.github.io/","releaseDate":"2025-04-20","releaseDateSource":"manifest","releaseNotesUrl":"https://github.com/dokan-dev/dokany/releases/tag/v2.3.0.1000","schemaVersion":1,"source":"winget","upstream":{"commit":"97d6aa2689f0a05f7847653a62b8624720d15b5d","manifestVersion":"1.10.0","manifests":[{"path":"manifes