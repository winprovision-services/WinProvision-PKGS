{"architectures":["x64"],"id":"degoya.rDownloader","latestVersion":"1.42.0","media":{"icons":[],"screenshots":[]},"package":{"description":"Local-first download manager with a web interface","license":"GPL-3.0-or-later","licenseUrl":"https://github.com/degoya/rDownloader/blob/v1.42.0/LICENSE","locale":"en-US","localizations":{"en-US":{"description":"Local-first download manager with a web interface","license":"GPL-3.0-or-later","licenseUrl":"https://github.com/degoya/rDownloader/blob/v1.42.0/LICENSE","locale":"en-US","longDescription":"rDownloader is a local-first download manager for HTTP, hosters, cloud drives, FTP/SFTP/WebDAV,\nUsenet, torrents, media, feeds, galleries and livestreams, collected in one LinkGrabber, run\nfrom one persistent queue and operated from the browser.\nStart the service with `start-rdownloader`, then open http://127.0.0.1:8710 for the setup\nwizard. The database and the default download folder stay in the package folder across\n`winget upgrade`; stop the service with `stop-rdownloader` before upgrading.","moniker":"rdownloader","name":"rDownloader","packageUrl":"https://rdownloader.net/","publisher":"DEGOYA.digital","publisherUrl":"https://github.com/degoya","releaseNotesUrl":"https://github.com/degoya/rDownloader/releases/tag/v1.42.0","tags":["download-manager","downloader","linkgrabber","self-hosted","torrent","usenet","yt-dlp"]}},"longDescription":"rDownloader is a local-first download manager for HTTP, hosters, cloud drives, FTP/SFTP/WebDAV,\nUsenet, torrents, media, feeds, galleries and livestreams, collected in one LinkGrabber, run\nfrom one persistent queue and operated from the browser.\nStart the service with `start-rdownloader`, then open http://127.0.0.1:8710 for the setup\nwizard. The database and the default download folder stay in the package folder across\n`winget upgrade`; stop the service with `stop-rdownloader` before upgrading.","moniker":"rdownloader","name":"rDownloader","packageUrl":"https://rdownloader.net/","publis