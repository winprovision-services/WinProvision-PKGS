{"defaultLocale":"en-US","id":"DifferentAI.OpenWork","installers":[{"appsAndFeaturesEntries":[{"UpgradeCode":"{2A300FB5-FA81-5886-A03C-B8C20DF4E74B}"}],"architecture":"x64","dependencies":[],"elevation":{"requirement":"elevatesSelf","source":"manifest"},"id":"x64-machine-wix","installerSwitches":{"InstallLocation":"INSTALLDIR=\"<INSTALLPATH>\""},"priority":2,"scope":"machine","sha256":"40c1221e6d5f040df42403885e279a4c090b43039de6196dc2fccbe46d286794","silent":{"arguments":"/quiet /norestart","source":"default"},"successCodes":[],"type":"wix","uninstall":{"type":"productCode","value":"{60CB9D8C-0B55-4493-929D-02901BC5FE40}"},"url":"https://github.com/different-ai/openwork/releases/download/v0.11.31/openwork-desktop-windows-x64.msi"}],"licenseUrl":"https://github.com/different-ai/openwork/blob/HEAD/LICENSE","packageLocalizations":{"en-US":{"description":"An open-source alternative to Claude Cowork, powered by OpenCode","license":"MIT","licenseUrl":"https://github.com/different-ai/openwork/blob/HEAD/LICENSE","locale":"en-US","longDescription":"OpenWork is an extensible, open-source “Claude Work” style system for knowledge workers.\nIt’s a native desktop app that runs OpenCode under the hood, but presents it as a clean, guided workflow:\n- pick a workspace\n- start a run\n- watch progress + plan updates\n- approve permissions when needed\n- reuse what works (templates + skills)\nThe goal: make “agentic work” feel like a product, not a terminal.","name":"OpenWork","packageUrl":"https://openwork.software/","publisher":"differentai","publisherUrl":"https://openwork.software/","releaseNotesUrl":"https://github.com/different-ai/openwork/releases/tag/v0.11.31","tags":["agent","agentic","ai","large-language-model","llm","opencode"]},"zh-CN":{"description":"由 OpenCode 驱动的 Claude Cowork 开源替代方案","locale":"zh-CN","longDescription":"OpenWork 是一个可扩展的开源“Claude Work”风格系统，专为知识工作者设计。\n它是一款原生桌面应用程序，底层运行 OpenCode，但以简洁、引导式的工作流呈现：\n- 选择一个工作区\n- 开始执行任务\n- 查看进度并规划更新\n- 在需要时批准权限\n- 复用有效内容（模板 + 技能）\n目标：让“自主智能式工作”感觉像一个产品，而不是一个终端。","tags":["opencode","人工智能","大语言模型","智能体","自主智能"]}},"publisherUrl":"https://openwork.software/","releaseDate":"2026-02-07","releaseDateSource":"manifest","releaseNotesUrl":"https://github.com/different-ai/openwork/releases/tag/v0.11.31","schemaVersion":1,"source":"winget","upstream":{"commit":"97d6aa2689f0a05f7847653a62b8624720d15b5d","manifestVersion":"1.12.0","manifests":[{"path":"manifests/d/DifferentAI/OpenWork/0.11.31/DifferentAI.OpenWork.yaml","sha256":"01e6752b3c20099a63b8d01441ff40fb7646d13a4704ca2d7898a2d655baf956"},{"path":"manifests/d/DifferentAI/OpenWork/0.11.31/DifferentAI.OpenWork.installer.yaml","sha256":"e06bc272f79d55ae8275698df30d8fd05cdc0d880d3357fef1a2dbec1659e64c"},{"path":"manifests/d/DifferentAI/OpenWork/0.11.31/DifferentAI.OpenWork.locale.en-US.yaml","sha256":"7bdad7ba2e7020d1e3818ecc772dade600ee292591ef178a223f02bc8a0878f8"},{"path":"manifests/d/DifferentAI/OpenWork/0.11.31/DifferentAI.OpenWork.locale.zh-CN.yaml","sha256":"d2520c3b50277eff194816aff1c462d929f822eac906cfab19ddc03fbf6937d4"}],"repository":"microsoft/winget-pkgs"},"version":"0.11.31"}