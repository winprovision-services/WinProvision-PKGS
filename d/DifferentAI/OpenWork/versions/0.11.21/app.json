{"defaultLocale":"en-US","id":"DifferentAI.OpenWork","installers":[{"appsAndFeaturesEntries":[{"UpgradeCode":"{2A300FB5-FA81-5886-A03C-B8C20DF4E74B}"}],"architecture":"x64","dependencies":[],"elevation":{"requirement":"elevatesSelf","source":"manifest"},"id":"x64-machine-wix","installerSwitches":{"InstallLocation":"INSTALLDIR=\"<INSTALLPATH>\""},"priority":2,"scope":"machine","sha256":"df66dbd6b6dccf4209a6c8964514f18b1bb917c62454afb0eb4320ea93bf704f","silent":{"arguments":"/quiet /norestart","source":"default"},"successCodes":[],"type":"wix","uninstall":{"type":"productCode","value":"{2ECD4325-4925-41D5-9EF7-EC8A97733173}"},"url":"https://github.com/different-ai/openwork/releases/download/v0.11.21/openwork-desktop-windows-x64.msi"}],"licenseUrl":"https://github.com/different-ai/openwork/blob/HEAD/LICENSE","packageLocalizations":{"en-US":{"description":"An open-source alternative to Claude Cowork, powered by OpenCode","license":"MIT","licenseUrl":"https://github.com/different-ai/openwork/blob/HEAD/LICENSE","locale":"en-US","longDescription":"OpenWork is an extensible, open-source “Claude Work” style system for knowledge workers.\nIt’s a native desktop app that runs OpenCode under the hood, but presents it as a clean, guided workflow:\n- pick a workspace\n- start a run\n- watch progress + plan updates\n- approve permissions when needed\n- reuse what works (templates + skills)\nThe goal: make “agentic work” feel like a product, not a terminal.","name":"OpenWork","packageUrl":"https://openwork.software/","publisher":"differentai","publisherUrl":"https://openwork.software/","releaseNotesUrl":"https://github.com/different-ai/openwork/releases/tag/v0.11.21","tags":["agent","agentic","ai","large-language-model","llm","opencode"]},"zh-CN":{"description":"由 OpenCode 驱动的 Claude Cowork 开源替代方案","locale":"zh-CN","longDescription":"OpenWork 是一个可扩展的开源“Claude Work”风格系统，专为知识工作者设计。\n它是一款原生桌面应用程序，底层运行 OpenCode，但以简洁、引导式的工作流呈现：\n- 选择一个工作区\n- 开始执行任务\n- 查看进度并规划更新\n- 在需要时批准权限\n- 复用有效内容（模板 + 技能）\n目标：让“自主智能式工作”感觉像一个产品，而不是一个终端。","tags":["opencode","人工智能","大语言模型","智能体","自主智能"]}},"publisherUrl":"https://openwork.software/","releaseDate":"2026-02-06","releaseDateSource":"manifest","releaseNotesUrl":"https://github.com/different-ai/openwork/releases/tag/v0.11.21","schemaVersion":1,"source":"winget","upstream":{"commit":"97d6aa2689f0a05f7847653a62b8624720d15b5d","manifestVersion":"1.12.0","manifests":[{"path":"manifests/d/DifferentAI/OpenWork/0.11.21/DifferentAI.OpenWork.yaml","sha256":"117b7aae282892cf11e48df2b95c660b4aa956144fb8f63e4f60e682fcfa862a"},{"path":"manifests/d/DifferentAI/OpenWork/0.11.21/DifferentAI.OpenWork.installer.yaml","sha256":"a50a6dced18dd2aeca765a764640a37f0df4e77c95e0584caf367ca5a706623d"},{"path":"manifests/d/DifferentAI/OpenWork/0.11.21/DifferentAI.OpenWork.locale.en-US.yaml","sha256":"c51a18c595e4dd341d29d025ab7285a315810faa3087a7bc6d37ef1e31cb3a36"},{"path":"manifests/d/DifferentAI/OpenWork/0.11.21/DifferentAI.OpenWork.locale.zh-CN.yaml","sha256":"0e2eb2283700313c6af862e4450cf119361ae40a24ec1f293414ba492c319eb9"}],"repository":"microsoft/winget-pkgs"},"version":"0.11.21"}