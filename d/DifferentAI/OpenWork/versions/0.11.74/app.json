{"defaultLocale":"en-US","id":"DifferentAI.OpenWork","installers":[{"appsAndFeaturesEntries":[{"UpgradeCode":"{2A300FB5-FA81-5886-A03C-B8C20DF4E74B}"}],"architecture":"x64","dependencies":[],"elevation":{"requirement":"elevatesSelf","source":"manifest"},"id":"x64-machine-wix","installerSwitches":{"InstallLocation":"INSTALLDIR=\"<INSTALLPATH>\""},"priority":2,"scope":"machine","sha256":"bfb2dc4392b99a78c4c7179ec567b0883d0910eb577206d5b5b770ddb4404280","silent":{"arguments":"/quiet /norestart","source":"default"},"successCodes":[],"type":"wix","uninstall":{"type":"productCode","value":"{3093A163-4BBB-4471-BB2A-9FF177718E25}"},"url":"https://github.com/different-ai/openwork/releases/download/v0.11.74/openwork-desktop-windows-x64.msi"}],"licenseUrl":"https://github.com/different-ai/openwork/blob/HEAD/LICENSE","packageLocalizations":{"en-US":{"description":"An open-source alternative to Claude Cowork, powered by OpenCode","license":"MIT","licenseUrl":"https://github.com/different-ai/openwork/blob/HEAD/LICENSE","locale":"en-US","longDescription":"OpenWork is an extensible, open-source “Claude Work” style system for knowledge workers.\nIt’s a native desktop app that runs OpenCode under the hood, but presents it as a clean, guided workflow:\n- pick a workspace\n- start a run\n- watch progress + plan updates\n- approve permissions when needed\n- reuse what works (templates + skills)\nThe goal: make “agentic work” feel like a product, not a terminal.","name":"OpenWork","packageUrl":"https://openwork.software/","publisher":"differentai","publisherUrl":"https://openwork.software/","releaseNotesUrl":"https://github.com/different-ai/openwork/releases/tag/v0.11.74","tags":["agent","agentic","ai","large-language-model","llm","opencode"]},"zh-CN":{"description":"由 OpenCode 驱动的 Claude Cowork 开源替代方案","locale":"zh-CN","longDescription":"OpenWork 是一个可扩展的开源“Claude Work”风格系统，专为知识工作者设计。\n它是一款原生桌面应用程序，底层运行 OpenCode，但以简洁、引导式的工作流呈现：\n- 选择一个工作区\n- 开始执行任务\n- 查看进度并规划更新\n- 在需要时批准权限\n- 复用有效内容（模板 + 技能）\n目标：让“自主智能式工作”感觉像一个产品，而不是一个终端。","tags":["opencode","人工智能","大语言模型","智能体","自主智能"]}},"publisherUrl":"https://openwork.software/","releaseDate":"2026-02-15","releaseDateSource":"manifest","releaseNotesUrl":"https://github.com/different-ai/openwork/releases/tag/v0.11.74","schemaVersion":1,"source":"winget","upstream":{"commit":"97d6aa2689f0a05f7847653a62b8624720d15b5d","manifestVersion":"1.12.0","manifests":[{"path":"manifests/d/DifferentAI/OpenWork/0.11.74/DifferentAI.OpenWork.yaml","sha256":"f4dd8fc9ae3a14f5214d1c6f579761bc053ad7e91f9c6473542c1f27b5cec798"},{"path":"manifests/d/DifferentAI/OpenWork/0.11.74/DifferentAI.OpenWork.installer.yaml","sha256":"2fcf6018536769f1e3b91bfb5ff77207f2f91b0f8953016508b7be5b067d9dce"},{"path":"manifests/d/DifferentAI/OpenWork/0.11.74/DifferentAI.OpenWork.locale.en-US.yaml","sha256":"ac763872149710dbdba48a8ed91e915db85bf70852c5b1c080f835eb6c542676"},{"path":"manifests/d/DifferentAI/OpenWork/0.11.74/DifferentAI.OpenWork.locale.zh-CN.yaml","sha256":"9532c25fadfd35f341f156b1ce65be0be3ed40d9ccd3aa78de65d188bbab9f33"}],"repository":"microsoft/winget-pkgs"},"version":"0.11.74"}