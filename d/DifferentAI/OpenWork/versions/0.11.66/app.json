{"defaultLocale":"en-US","id":"DifferentAI.OpenWork","installers":[{"appsAndFeaturesEntries":[{"UpgradeCode":"{2A300FB5-FA81-5886-A03C-B8C20DF4E74B}"}],"architecture":"x64","dependencies":[],"elevation":{"requirement":"elevatesSelf","source":"manifest"},"id":"x64-machine-wix","installerSwitches":{"InstallLocation":"INSTALLDIR=\"<INSTALLPATH>\""},"priority":2,"scope":"machine","sha256":"4c3c5976a97b89944bb5dbd6d5c0bc8233a3883429395b1afa196d541368928c","silent":{"arguments":"/quiet /norestart","source":"default"},"successCodes":[],"type":"wix","uninstall":{"type":"productCode","value":"{A2A0F700-E0F7-4766-AA80-9274B2A8A610}"},"url":"https://github.com/different-ai/openwork/releases/download/v0.11.66/openwork-desktop-windows-x64.msi"}],"licenseUrl":"https://github.com/different-ai/openwork/blob/HEAD/LICENSE","packageLocalizations":{"en-US":{"description":"An open-source alternative to Claude Cowork, powered by OpenCode","license":"MIT","licenseUrl":"https://github.com/different-ai/openwork/blob/HEAD/LICENSE","locale":"en-US","longDescription":"OpenWork is an extensible, open-source “Claude Work” style system for knowledge workers.\nIt’s a native desktop app that runs OpenCode under the hood, but presents it as a clean, guided workflow:\n- pick a workspace\n- start a run\n- watch progress + plan updates\n- approve permissions when needed\n- reuse what works (templates + skills)\nThe goal: make “agentic work” feel like a product, not a terminal.","name":"OpenWork","packageUrl":"https://openwork.software/","publisher":"differentai","publisherUrl":"https://openwork.software/","releaseNotesUrl":"https://github.com/different-ai/openwork/releases/tag/v0.11.66","tags":["agent","agentic","ai","large-language-model","llm","opencode"]},"zh-CN":{"description":"由 OpenCode 驱动的 Claude Cowork 开源替代方案","locale":"zh-CN","longDescription":"OpenWork 是一个可扩展的开源“Claude Work”风格系统，专为知识工作者设计。\n它是一款原生桌面应用程序，底层运行 OpenCode，但以简洁、引导式的工作流呈现：\n- 选择一个工作区\n- 开始执行任务\n- 查看进度并规划更新\n- 在需要时批准权限\n- 复用有效内容（模板 + 技能）\n目标：让“自主智能式工作”感觉像一个产品，而不是一个终端。","tags":["opencode","人工智能","大语言模型","智能体","自主智能"]}},"publisherUrl":"https://openwork.software/","releaseDate":"2026-02-13","releaseDateSource":"manifest","releaseNotesUrl":"https://github.com/different-ai/openwork/releases/tag/v0.11.66","schemaVersion":1,"source":"winget","upstream":{"commit":"97d6aa2689f0a05f7847653a62b8624720d15b5d","manifestVersion":"1.12.0","manifests":[{"path":"manifests/d/DifferentAI/OpenWork/0.11.66/DifferentAI.OpenWork.yaml","sha256":"6231ccefa68492e263cf58d9c422084d774b73edb5f7d54c34f7e2850aee0ab4"},{"path":"manifests/d/DifferentAI/OpenWork/0.11.66/DifferentAI.OpenWork.installer.yaml","sha256":"67c59fee976c736352335e55cb14c0c0c618688779f17b88495b6f5b31ff451a"},{"path":"manifests/d/DifferentAI/OpenWork/0.11.66/DifferentAI.OpenWork.locale.en-US.yaml","sha256":"7e15f00ce95a3d7f6444cda912dd0cc92abb69662e451c2c59b6740ea285ba60"},{"path":"manifests/d/DifferentAI/OpenWork/0.11.66/DifferentAI.OpenWork.locale.zh-CN.yaml","sha256":"1dc13b179dbb320e7482559502f78c7d019cf1f15afc13855076c1cbdedf07ff"}],"repository":"microsoft/winget-pkgs"},"version":"0.11.66"}