{"defaultLocale":"en-US","id":"DifferentAI.OpenWork","installers":[{"appsAndFeaturesEntries":[{"UpgradeCode":"{2A300FB5-FA81-5886-A03C-B8C20DF4E74B}"}],"architecture":"x64","dependencies":[],"elevation":{"requirement":"elevatesSelf","source":"manifest"},"id":"x64-machine-wix","installerSwitches":{"InstallLocation":"INSTALLDIR=\"<INSTALLPATH>\""},"priority":2,"scope":"machine","sha256":"ed92e42455e6f40fd25db73f4da6fe12cafa2a520248055e766ada222a891293","silent":{"arguments":"/quiet /norestart","source":"default"},"successCodes":[],"type":"wix","uninstall":{"type":"productCode","value":"{45A3E2FA-3EA7-4D15-9304-566D885C9062}"},"url":"https://github.com/different-ai/openwork/releases/download/v0.11.59/openwork-desktop-windows-x64.msi"}],"licenseUrl":"https://github.com/different-ai/openwork/blob/HEAD/LICENSE","packageLocalizations":{"en-US":{"description":"An open-source alternative to Claude Cowork, powered by OpenCode","license":"MIT","licenseUrl":"https://github.com/different-ai/openwork/blob/HEAD/LICENSE","locale":"en-US","longDescription":"OpenWork is an extensible, open-source “Claude Work” style system for knowledge workers.\nIt’s a native desktop app that runs OpenCode under the hood, but presents it as a clean, guided workflow:\n- pick a workspace\n- start a run\n- watch progress + plan updates\n- approve permissions when needed\n- reuse what works (templates + skills)\nThe goal: make “agentic work” feel like a product, not a terminal.","name":"OpenWork","packageUrl":"https://openwork.software/","publisher":"differentai","publisherUrl":"https://openwork.software/","releaseNotesUrl":"https://github.com/different-ai/openwork/releases/tag/v0.11.59","tags":["agent","agentic","ai","large-language-model","llm","opencode"]},"zh-CN":{"description":"由 OpenCode 驱动的 Claude Cowork 开源替代方案","locale":"zh-CN","longDescription":"OpenWork 是一个可扩展的开源“Claude Work”风格系统，专为知识工作者设计。\n它是一款原生桌面应用程序，底层运行 OpenCode，但以简洁、引导式的工作流呈现：\n- 选择一个工作区\n- 开始执行任务\n- 查看进度并规划更新\n- 在需要时批准权限\n- 复用有效内容（模板 + 技能）\n目标：让“自主智能式工作”感觉像一个产品，而不是一个终端。","tags":["opencode","人工智能","大语言模型","智能体","自主智能"]}},"publisherUrl":"https://openwork.software/","releaseDate":"2026-02-11","releaseDateSource":"manifest","releaseNotesUrl":"https://github.com/different-ai/openwork/releases/tag/v0.11.59","schemaVersion":1,"source":"winget","upstream":{"commit":"97d6aa2689f0a05f7847653a62b8624720d15b5d","manifestVersion":"1.12.0","manifests":[{"path":"manifests/d/DifferentAI/OpenWork/0.11.59/DifferentAI.OpenWork.yaml","sha256":"98c5955a45b36334c5526e019d8a9388dfc8311724a72469304a9bb433dff6bd"},{"path":"manifests/d/DifferentAI/OpenWork/0.11.59/DifferentAI.OpenWork.installer.yaml","sha256":"cbbe3e029e17dbfe7fd2f93cf7942a5b6717eb190d0ebf3ba44286658e639fe7"},{"path":"manifests/d/DifferentAI/OpenWork/0.11.59/DifferentAI.OpenWork.locale.en-US.yaml","sha256":"0abbf4997774c54842375ebbbac7e2b5a6003506214eb657d5396188272919f7"},{"path":"manifests/d/DifferentAI/OpenWork/0.11.59/DifferentAI.OpenWork.locale.zh-CN.yaml","sha256":"5f36dd8939983cdb27d5d3e443052f760acdec627a7bf8142de5bea8598f7f64"}],"repository":"microsoft/winget-pkgs"},"version":"0.11.59"}