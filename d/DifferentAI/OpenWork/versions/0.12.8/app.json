{"defaultLocale":"en-US","id":"DifferentAI.OpenWork","installers":[{"appsAndFeaturesEntries":[{"UpgradeCode":"{2A300FB5-FA81-5886-A03C-B8C20DF4E74B}"}],"architecture":"x64","dependencies":[],"elevation":{"requirement":"elevatesSelf","source":"manifest"},"id":"x64-machine-wix","installerSwitches":{"InstallLocation":"INSTALLDIR=\"<INSTALLPATH>\""},"priority":2,"scope":"machine","sha256":"b5e9f7d9e9b8eaef6c1ac5cd22e6cf8652842e4a57172e3f2f3e321463e25372","silent":{"arguments":"/quiet /norestart","source":"default"},"successCodes":[],"type":"wix","uninstall":{"type":"productCode","value":"{7C43FC4C-0829-4AD6-8074-2D4B30245767}"},"url":"https://github.com/different-ai/openwork/releases/download/v0.12.8/openwork-desktop-windows-x64.msi"}],"licenseUrl":"https://github.com/different-ai/openwork/blob/HEAD/LICENSE","packageLocalizations":{"en-US":{"description":"An open-source alternative to Claude Cowork, powered by OpenCode","license":"MIT","licenseUrl":"https://github.com/different-ai/openwork/blob/HEAD/LICENSE","locale":"en-US","longDescription":"OpenWork is an extensible, open-source “Claude Work” style system for knowledge workers.\nIt’s a native desktop app that runs OpenCode under the hood, but presents it as a clean, guided workflow:\n- pick a workspace\n- start a run\n- watch progress + plan updates\n- approve permissions when needed\n- reuse what works (templates + skills)\nThe goal: make “agentic work” feel like a product, not a terminal.","name":"OpenWork","packageUrl":"https://openwork.software/","publisher":"differentai","publisherUrl":"https://openwork.software/","releaseNotesUrl":"https://github.com/different-ai/openwork/releases/tag/v0.12.8","tags":["agent","agentic","ai","large-language-model","llm","opencode"]},"zh-CN":{"description":"由 OpenCode 驱动的 Claude Cowork 开源替代方案","locale":"zh-CN","longDescription":"OpenWork 是一个可扩展的开源“Claude Work”风格系统，专为知识工作者设计。\n它是一款原生桌面应用程序，底层运行 OpenCode，但以简洁、引导式的工作流呈现：\n- 选择一个工作区\n- 开始执行任务\n- 查看进度并规划更新\n- 在需要时批准权限\n- 复用有效内容（模板 + 技