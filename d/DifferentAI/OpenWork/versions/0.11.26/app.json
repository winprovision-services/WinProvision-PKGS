{"defaultLocale":"en-US","id":"DifferentAI.OpenWork","installers":[{"appsAndFeaturesEntries":[{"UpgradeCode":"{2A300FB5-FA81-5886-A03C-B8C20DF4E74B}"}],"architecture":"x64","dependencies":[],"elevation":{"requirement":"elevatesSelf","source":"manifest"},"id":"x64-machine-wix","installerSwitches":{"InstallLocation":"INSTALLDIR=\"<INSTALLPATH>\""},"priority":2,"scope":"machine","sha256":"18126a5c52bc8dffe21bda4106bdf4339b899f969b70f9b0266d0db62a024464","silent":{"arguments":"/quiet /norestart","source":"default"},"successCodes":[],"type":"wix","uninstall":{"type":"productCode","value":"{005160D1-A326-4C14-9D56-0CDE89456C5E}"},"url":"https://github.com/different-ai/openwork/releases/download/v0.11.26/openwork-desktop-windows-x64.msi"}],"licenseUrl":"https://github.com/different-ai/openwork/blob/HEAD/LICENSE","packageLocalizations":{"en-US":{"description":"An open-source alternative to Claude Cowork, powered by OpenCode","license":"MIT","licenseUrl":"https://github.com/different-ai/openwork/blob/HEAD/LICENSE","locale":"en-US","longDescription":"OpenWork is an extensible, open-source “Claude Work” style system for knowledge workers.\nIt’s a native desktop app that runs OpenCode under the hood, but presents it as a clean, guided workflow:\n- pick a workspace\n- start a run\n- watch progress + plan updates\n- approve permissions when needed\n- reuse what works (templates + skills)\nThe goal: make “agentic work” feel like a product, not a terminal.","name":"OpenWork","packageUrl":"https://openwork.software/","publisher":"differentai","publisherUrl":"https://openwork.software/","releaseNotesUrl":"https://github.com/different-ai/openwork/releases/tag/v0.11.26","tags":["agent","agentic","ai","large-language-model","llm","opencode"]},"zh-CN":{"description":"由 OpenCode 驱动的 Claude Cowork 开源替代方案","locale":"zh-CN","longDescription":"OpenWork 是一个可扩展的开源“Claude Work”风格系统，专为知识工作者设计。\n它是一款原生桌面应用程序，底层运行 OpenCode，但以简洁、引导式的工作流呈现：\n- 选择一个工作区\n- 开始执行任务\n- 查看进度并规划更新\n- 在需要时批准权限\n- 复用有效内容（模板 + 技能）\n目标：让“自主智能式工作”感觉像一个产品，而不是一个终端。","tags":["opencode","人工智能","大语言模型","智能体","自主智能"]}},"publisherUrl":"https://openwork.software/","releaseDate":"2026-02-07","releaseDateSource":"manifest","releaseNotesUrl":"https://github.com/different-ai/openwork/releases/tag/v0.11.26","schemaVersion":1,"source":"winget","upstream":{"commit":"97d6aa2689f0a05f7847653a62b8624720d15b5d","manifestVersion":"1.12.0","manifests":[{"path":"manifests/d/DifferentAI/OpenWork/0.11.26/DifferentAI.OpenWork.yaml","sha256":"a7fa15d461386a518b4205a2f3d49a878df10b52577d94616f0a17a9c28e625a"},{"path":"manifests/d/DifferentAI/OpenWork/0.11.26/DifferentAI.OpenWork.installer.yaml","sha256":"cba2a9d46be5b92a8491c021cae6f2b15c8419bcf2ed1e63515896a9baea413e"},{"path":"manifests/d/DifferentAI/OpenWork/0.11.26/DifferentAI.OpenWork.locale.en-US.yaml","sha256":"4367d206566e072cea0eeba741a10fd91cf7706ed9ae43e8618c2613beffd6e3"},{"path":"manifests/d/DifferentAI/OpenWork/0.11.26/DifferentAI.OpenWork.locale.zh-CN.yaml","sha256":"77f7e6bdd320f2fa7508b2c10a3b25b8470a53bac4dd1b517911af088b8596d9"}],"repository":"microsoft/winget-pkgs"},"version":"0.11.26"}