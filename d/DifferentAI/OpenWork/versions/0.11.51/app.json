{"defaultLocale":"en-US","id":"DifferentAI.OpenWork","installers":[{"appsAndFeaturesEntries":[{"UpgradeCode":"{2A300FB5-FA81-5886-A03C-B8C20DF4E74B}"}],"architecture":"x64","dependencies":[],"elevation":{"requirement":"elevatesSelf","source":"manifest"},"id":"x64-machine-wix","installerSwitches":{"InstallLocation":"INSTALLDIR=\"<INSTALLPATH>\""},"priority":2,"scope":"machine","sha256":"72519e39b64d653952af7fe761dc34d00cd5203969e09e50d409a4e88e27c592","silent":{"arguments":"/quiet /norestart","source":"default"},"successCodes":[],"type":"wix","uninstall":{"type":"productCode","value":"{20DD21AE-8A4E-41D4-9CBF-BDD69A99E4B7}"},"url":"https://github.com/different-ai/openwork/releases/download/v0.11.51/openwork-desktop-windows-x64.msi"}],"licenseUrl":"https://github.com/different-ai/openwork/blob/HEAD/LICENSE","packageLocalizations":{"en-US":{"description":"An open-source alternative to Claude Cowork, powered by OpenCode","license":"MIT","licenseUrl":"https://github.com/different-ai/openwork/blob/HEAD/LICENSE","locale":"en-US","longDescription":"OpenWork is an extensible, open-source “Claude Work” style system for knowledge workers.\nIt’s a native desktop app that runs OpenCode under the hood, but presents it as a clean, guided workflow:\n- pick a workspace\n- start a run\n- watch progress + plan updates\n- approve permissions when needed\n- reuse what works (templates + skills)\nThe goal: make “agentic work” feel like a product, not a terminal.","name":"OpenWork","packageUrl":"https://openwork.software/","publisher":"differentai","publisherUrl":"https://openwork.software/","releaseNotesUrl":"https://github.com/different-ai/openwork/releases/tag/v0.11.51","tags":["agent","agentic","ai","large-language-model","llm","opencode"]},"zh-CN":{"description":"由 OpenCode 驱动的 Claude Cowork 开源替代方案","locale":"zh-CN","longDescription":"OpenWork 是一个可扩展的开源“Claude Work”风格系统，专为知识工作者设计。\n它是一款原生桌面应用程序，底层运行 OpenCode，但以简洁、引导式的工作流呈现：\n- 选择一个工作区\n- 开始执行任务\n- 查看进度并规划更新\n- 在需要时批准权限\n- 复用有效内容（模板 + 技能）\n目标：让“自主智能式工作”感觉像一个产品，而不是一个终端。","tags":["opencode","人工智能","大语言模型","智能体","自主智能"]}},"publisherUrl":"https://openwork.software/","releaseDate":"2026-02-10","releaseDateSource":"manifest","releaseNotesUrl":"https://github.com/different-ai/openwork/releases/tag/v0.11.51","schemaVersion":1,"source":"winget","upstream":{"commit":"97d6aa2689f0a05f7847653a62b8624720d15b5d","manifestVersion":"1.12.0","manifests":[{"path":"manifests/d/DifferentAI/OpenWork/0.11.51/DifferentAI.OpenWork.yaml","sha256":"789dda40fcbd3ec29657de99a3e5f78a032d04413e59c887926b1e9416e96626"},{"path":"manifests/d/DifferentAI/OpenWork/0.11.51/DifferentAI.OpenWork.installer.yaml","sha256":"f95ae54a96ec85217cd3eaae258ab7ae8b07d516d6e2499c411b1023f428c7c2"},{"path":"manifests/d/DifferentAI/OpenWork/0.11.51/DifferentAI.OpenWork.locale.en-US.yaml","sha256":"3f507c09c45e79c4252e1d08f025a1ea6bac79c320ebfc292dd4224552738360"},{"path":"manifests/d/DifferentAI/OpenWork/0.11.51/DifferentAI.OpenWork.locale.zh-CN.yaml","sha256":"b3954033f27de2413ce838c37aeb1db4ba626d55a14e2bc52bc20bdaedfd89e8"}],"repository":"microsoft/winget-pkgs"},"version":"0.11.51"}