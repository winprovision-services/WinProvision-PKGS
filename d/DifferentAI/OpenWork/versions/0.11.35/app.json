{"defaultLocale":"en-US","id":"DifferentAI.OpenWork","installers":[{"appsAndFeaturesEntries":[{"UpgradeCode":"{2A300FB5-FA81-5886-A03C-B8C20DF4E74B}"}],"architecture":"x64","dependencies":[],"elevation":{"requirement":"elevatesSelf","source":"manifest"},"id":"x64-machine-wix","installerSwitches":{"InstallLocation":"INSTALLDIR=\"<INSTALLPATH>\""},"priority":2,"scope":"machine","sha256":"630f828de481a435c6c52d4588012f4eb9b3b455826cb9dd05d37f104b369776","silent":{"arguments":"/quiet /norestart","source":"default"},"successCodes":[],"type":"wix","uninstall":{"type":"productCode","value":"{4CD6671B-397A-4CD9-9EB0-1F2990CF0645}"},"url":"https://github.com/different-ai/openwork/releases/download/v0.11.35/openwork-desktop-windows-x64.msi"}],"licenseUrl":"https://github.com/different-ai/openwork/blob/HEAD/LICENSE","packageLocalizations":{"en-US":{"description":"An open-source alternative to Claude Cowork, powered by OpenCode","license":"MIT","licenseUrl":"https://github.com/different-ai/openwork/blob/HEAD/LICENSE","locale":"en-US","longDescription":"OpenWork is an extensible, open-source “Claude Work” style system for knowledge workers.\nIt’s a native desktop app that runs OpenCode under the hood, but presents it as a clean, guided workflow:\n- pick a workspace\n- start a run\n- watch progress + plan updates\n- approve permissions when needed\n- reuse what works (templates + skills)\nThe goal: make “agentic work” feel like a product, not a terminal.","name":"OpenWork","packageUrl":"https://openwork.software/","publisher":"differentai","publisherUrl":"https://openwork.software/","releaseNotesUrl":"https://github.com/different-ai/openwork/releases/tag/v0.11.35","tags":["agent","agentic","ai","large-language-model","llm","opencode"]},"zh-CN":{"description":"由 OpenCode 驱动的 Claude Cowork 开源替代方案","locale":"zh-CN","longDescription":"OpenWork 是一个可扩展的开源“Claude Work”风格系统，专为知识工作者设计。\n它是一款原生桌面应用程序，底层运行 OpenCode，但以简洁、引导式的工作流呈现：\n- 选择一个工作区\n- 开始执行任务\n- 查看进度并规划更新\n- 在需要时批准权限\n- 复用有效内容（模板 + 技能）\n目标：让“自主智能式工作”感觉像一个产品，而不是一个终端。","tags":["opencode","人工智能","大语言模型","智能体","自主智能"]}},"publisherUrl":"https://openwork.software/","releaseDate":"2026-02-09","releaseDateSource":"manifest","releaseNotesUrl":"https://github.com/different-ai/openwork/releases/tag/v0.11.35","schemaVersion":1,"source":"winget","upstream":{"commit":"97d6aa2689f0a05f7847653a62b8624720d15b5d","manifestVersion":"1.12.0","manifests":[{"path":"manifests/d/DifferentAI/OpenWork/0.11.35/DifferentAI.OpenWork.yaml","sha256":"50d9087c9c89eb1481d7ba8061403a07ab2c08594de1aea254261ef23ac499dc"},{"path":"manifests/d/DifferentAI/OpenWork/0.11.35/DifferentAI.OpenWork.installer.yaml","sha256":"30116df10016f112bb0ebf76911119c11480e563c2d0e635414d2b32cfa6fdbd"},{"path":"manifests/d/DifferentAI/OpenWork/0.11.35/DifferentAI.OpenWork.locale.en-US.yaml","sha256":"12f857d7d871346fb258d77b17b0c8dde84e1179b400080ce44c88a13e0d5acb"},{"path":"manifests/d/DifferentAI/OpenWork/0.11.35/DifferentAI.OpenWork.locale.zh-CN.yaml","sha256":"53ebb62281530237f650ec9bed5002ba9132c7dc96b4124880b503e44c7d5aae"}],"repository":"microsoft/winget-pkgs"},"version":"0.11.35"}