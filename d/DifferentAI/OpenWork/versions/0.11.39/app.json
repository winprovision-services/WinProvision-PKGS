{"defaultLocale":"en-US","id":"DifferentAI.OpenWork","installers":[{"appsAndFeaturesEntries":[{"UpgradeCode":"{2A300FB5-FA81-5886-A03C-B8C20DF4E74B}"}],"architecture":"x64","dependencies":[],"elevation":{"requirement":"elevatesSelf","source":"manifest"},"id":"x64-machine-wix","installerSwitches":{"InstallLocation":"INSTALLDIR=\"<INSTALLPATH>\""},"priority":2,"scope":"machine","sha256":"ae9a351ab7bdcb29048993ce5a76534e946121f780614ece8c4cb6179dc7a78e","silent":{"arguments":"/quiet /norestart","source":"default"},"successCodes":[],"type":"wix","uninstall":{"type":"productCode","value":"{D5C95B96-3DE6-4C6D-A464-73CDE8DFAB7D}"},"url":"https://github.com/different-ai/openwork/releases/download/v0.11.39/openwork-desktop-windows-x64.msi"}],"licenseUrl":"https://github.com/different-ai/openwork/blob/HEAD/LICENSE","packageLocalizations":{"en-US":{"description":"An open-source alternative to Claude Cowork, powered by OpenCode","license":"MIT","licenseUrl":"https://github.com/different-ai/openwork/blob/HEAD/LICENSE","locale":"en-US","longDescription":"OpenWork is an extensible, open-source “Claude Work” style system for knowledge workers.\nIt’s a native desktop app that runs OpenCode under the hood, but presents it as a clean, guided workflow:\n- pick a workspace\n- start a run\n- watch progress + plan updates\n- approve permissions when needed\n- reuse what works (templates + skills)\nThe goal: make “agentic work” feel like a product, not a terminal.","name":"OpenWork","packageUrl":"https://openwork.software/","publisher":"differentai","publisherUrl":"https://openwork.software/","releaseNotesUrl":"https://github.com/different-ai/openwork/releases/tag/v0.11.39","tags":["agent","agentic","ai","large-language-model","llm","opencode"]},"zh-CN":{"description":"由 OpenCode 驱动的 Claude Cowork 开源替代方案","locale":"zh-CN","longDescription":"OpenWork 是一个可扩展的开源“Claude Work”风格系统，专为知识工作者设计。\n它是一款原生桌面应用程序，底层运行 OpenCode，但以简洁、引导式的工作流呈现：\n- 选择一个工作区\n- 开始执行任务\n- 查看进度并规划更新\n- 在需要时批准权限\n- 复用有效内容（模板 + 技能）\n目标：让“自主智能式工作”感觉像一个产品，而不是一个终端。","tags":["opencode","人工智能","大语言模型","智能体","自主智能"]}},"publisherUrl":"https://openwork.software/","releaseDate":"2026-02-09","releaseDateSource":"manifest","releaseNotesUrl":"https://github.com/different-ai/openwork/releases/tag/v0.11.39","schemaVersion":1,"source":"winget","upstream":{"commit":"97d6aa2689f0a05f7847653a62b8624720d15b5d","manifestVersion":"1.12.0","manifests":[{"path":"manifests/d/DifferentAI/OpenWork/0.11.39/DifferentAI.OpenWork.yaml","sha256":"10b09eb0436719ed1e934ef94925dd316893bfcaa6ebc8e3c4429d4890444aec"},{"path":"manifests/d/DifferentAI/OpenWork/0.11.39/DifferentAI.OpenWork.installer.yaml","sha256":"bef72a2c32ab84351623c2b4b573eba5cd129804381c15813d03b6175fd2f3fa"},{"path":"manifests/d/DifferentAI/OpenWork/0.11.39/DifferentAI.OpenWork.locale.en-US.yaml","sha256":"a6cde5c722447035e64eb4066bdc8e1ef4b43db08033e1fb859a79e758e4dceb"},{"path":"manifests/d/DifferentAI/OpenWork/0.11.39/DifferentAI.OpenWork.locale.zh-CN.yaml","sha256":"ca75f7b9725a8f6414aad68b416835669c671e2936f6c495e06287d02465d6cb"}],"repository":"microsoft/winget-pkgs"},"version":"0.11.39"}