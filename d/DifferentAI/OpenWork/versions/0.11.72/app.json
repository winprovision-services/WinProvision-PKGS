{"defaultLocale":"en-US","id":"DifferentAI.OpenWork","installers":[{"appsAndFeaturesEntries":[{"UpgradeCode":"{2A300FB5-FA81-5886-A03C-B8C20DF4E74B}"}],"architecture":"x64","dependencies":[],"elevation":{"requirement":"elevatesSelf","source":"manifest"},"id":"x64-machine-wix","installerSwitches":{"InstallLocation":"INSTALLDIR=\"<INSTALLPATH>\""},"priority":2,"scope":"machine","sha256":"a84dc758de0a684a606820170f4e3f6867caf0e7bae31f9a187941daead40017","silent":{"arguments":"/quiet /norestart","source":"default"},"successCodes":[],"type":"wix","uninstall":{"type":"productCode","value":"{C2CB571B-FBD0-4B40-BA93-CD834A3C9FDA}"},"url":"https://github.com/different-ai/openwork/releases/download/v0.11.72/openwork-desktop-windows-x64.msi"}],"licenseUrl":"https://github.com/different-ai/openwork/blob/HEAD/LICENSE","packageLocalizations":{"en-US":{"description":"An open-source alternative to Claude Cowork, powered by OpenCode","license":"MIT","licenseUrl":"https://github.com/different-ai/openwork/blob/HEAD/LICENSE","locale":"en-US","longDescription":"OpenWork is an extensible, open-source “Claude Work” style system for knowledge workers.\nIt’s a native desktop app that runs OpenCode under the hood, but presents it as a clean, guided workflow:\n- pick a workspace\n- start a run\n- watch progress + plan updates\n- approve permissions when needed\n- reuse what works (templates + skills)\nThe goal: make “agentic work” feel like a product, not a terminal.","name":"OpenWork","packageUrl":"https://openwork.software/","publisher":"differentai","publisherUrl":"https://openwork.software/","releaseNotesUrl":"https://github.com/different-ai/openwork/releases/tag/v0.11.72","tags":["agent","agentic","ai","large-language-model","llm","opencode"]},"zh-CN":{"description":"由 OpenCode 驱动的 Claude Cowork 开源替代方案","locale":"zh-CN","longDescription":"OpenWork 是一个可扩展的开源“Claude Work”风格系统，专为知识工作者设计。\n它是一款原生桌面应用程序，底层运行 OpenCode，但以简洁、引导式的工作流呈现：\n- 选择一个工作区\n- 开始执行任务\n- 查看进度并规划更新\n- 在需要时批准权限\n- 复用有效内容（模板 + 技能）\n目标：让“自主智能式工作”感觉像一个产品，而不是一个终端。","tags":["opencode","人工智能","大语言模型","智能体","自主智能"]}},"publisherUrl":"https://openwork.software/","releaseDate":"2026-02-15","releaseDateSource":"manifest","releaseNotesUrl":"https://github.com/different-ai/openwork/releases/tag/v0.11.72","schemaVersion":1,"source":"winget","upstream":{"commit":"97d6aa2689f0a05f7847653a62b8624720d15b5d","manifestVersion":"1.12.0","manifests":[{"path":"manifests/d/DifferentAI/OpenWork/0.11.72/DifferentAI.OpenWork.yaml","sha256":"ea94d5d3bfc2d984d5a704e7971ee224785106bf7a032c7b05ad70c96812cd02"},{"path":"manifests/d/DifferentAI/OpenWork/0.11.72/DifferentAI.OpenWork.installer.yaml","sha256":"79986e7a5f99a5d24acc94278c94ca72e34762ae2d1ebdf804fcf2d07bdca2f5"},{"path":"manifests/d/DifferentAI/OpenWork/0.11.72/DifferentAI.OpenWork.locale.en-US.yaml","sha256":"9ce20e9fb6e3b692a5eb5cbef0bc5892e27a76401740d869e58a8f5a9281d8e5"},{"path":"manifests/d/DifferentAI/OpenWork/0.11.72/DifferentAI.OpenWork.locale.zh-CN.yaml","sha256":"e2ed36e4a6dbdeece310a61f756d96e5ef3771fed9fd63bf8f3c367195c9e066"}],"repository":"microsoft/winget-pkgs"},"version":"0.11.72"}