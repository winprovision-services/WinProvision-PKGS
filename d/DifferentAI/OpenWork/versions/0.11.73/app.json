{"defaultLocale":"en-US","id":"DifferentAI.OpenWork","installers":[{"appsAndFeaturesEntries":[{"UpgradeCode":"{2A300FB5-FA81-5886-A03C-B8C20DF4E74B}"}],"architecture":"x64","dependencies":[],"elevation":{"requirement":"elevatesSelf","source":"manifest"},"id":"x64-machine-wix","installerSwitches":{"InstallLocation":"INSTALLDIR=\"<INSTALLPATH>\""},"priority":2,"scope":"machine","sha256":"a108b72f7f2dfcb301409706b45ffc02597411fe7a9f4d45db317bae501a66d7","silent":{"arguments":"/quiet /norestart","source":"default"},"successCodes":[],"type":"wix","uninstall":{"type":"productCode","value":"{39E1B6D2-D7B9-4821-8BA6-1BE1D6D7BA6A}"},"url":"https://github.com/different-ai/openwork/releases/download/v0.11.73/openwork-desktop-windows-x64.msi"}],"licenseUrl":"https://github.com/different-ai/openwork/blob/HEAD/LICENSE","packageLocalizations":{"en-US":{"description":"An open-source alternative to Claude Cowork, powered by OpenCode","license":"MIT","licenseUrl":"https://github.com/different-ai/openwork/blob/HEAD/LICENSE","locale":"en-US","longDescription":"OpenWork is an extensible, open-source “Claude Work” style system for knowledge workers.\nIt’s a native desktop app that runs OpenCode under the hood, but presents it as a clean, guided workflow:\n- pick a workspace\n- start a run\n- watch progress + plan updates\n- approve permissions when needed\n- reuse what works (templates + skills)\nThe goal: make “agentic work” feel like a product, not a terminal.","name":"OpenWork","packageUrl":"https://openwork.software/","publisher":"differentai","publisherUrl":"https://openwork.software/","releaseNotesUrl":"https://github.com/different-ai/openwork/releases/tag/v0.11.73","tags":["agent","agentic","ai","large-language-model","llm","opencode"]},"zh-CN":{"description":"由 OpenCode 驱动的 Claude Cowork 开源替代方案","locale":"zh-CN","longDescription":"OpenWork 是一个可扩展的开源“Claude Work”风格系统，专为知识工作者设计。\n它是一款原生桌面应用程序，底层运行 OpenCode，但以简洁、引导式的工作流呈现：\n- 选择一个工作区\n- 开始执行任务\n- 查看进度并规划更新\n- 在需要时批准权限\n- 复用有效内容（模板 + 技能）\n目标：让“自主智能式工作”感觉像一个产品，而不是一个终端。","tags":["opencode","人工智能","大语言模型","智能体","自主智能"]}},"publisherUrl":"https://openwork.software/","releaseDate":"2026-02-15","releaseDateSource":"manifest","releaseNotesUrl":"https://github.com/different-ai/openwork/releases/tag/v0.11.73","schemaVersion":1,"source":"winget","upstream":{"commit":"97d6aa2689f0a05f7847653a62b8624720d15b5d","manifestVersion":"1.12.0","manifests":[{"path":"manifests/d/DifferentAI/OpenWork/0.11.73/DifferentAI.OpenWork.yaml","sha256":"ef02331e946d7dd256d7439fbf955655586ccc5d8e51fe64e6c5b00ebf374ad0"},{"path":"manifests/d/DifferentAI/OpenWork/0.11.73/DifferentAI.OpenWork.installer.yaml","sha256":"724c0de4deb3974743e63394e562f88ed94544add6d7b9a8dd96b47b524db8b5"},{"path":"manifests/d/DifferentAI/OpenWork/0.11.73/DifferentAI.OpenWork.locale.en-US.yaml","sha256":"ab5eba9235e4c117f664f468be722b88f2a2a62e8f3de6f08bb2e873ec1f4030"},{"path":"manifests/d/DifferentAI/OpenWork/0.11.73/DifferentAI.OpenWork.locale.zh-CN.yaml","sha256":"105dbcb15fa88a1cb7c04babb4064b5fdabb1b5097a8b2a4ea9c70ae755993f4"}],"repository":"microsoft/winget-pkgs"},"version":"0.11.73"}