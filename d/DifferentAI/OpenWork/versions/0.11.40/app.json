{"defaultLocale":"en-US","id":"DifferentAI.OpenWork","installers":[{"appsAndFeaturesEntries":[{"UpgradeCode":"{2A300FB5-FA81-5886-A03C-B8C20DF4E74B}"}],"architecture":"x64","dependencies":[],"elevation":{"requirement":"elevatesSelf","source":"manifest"},"id":"x64-machine-wix","installerSwitches":{"InstallLocation":"INSTALLDIR=\"<INSTALLPATH>\""},"priority":2,"scope":"machine","sha256":"ac958bd9c9cf46d3c27d7d80a087f241ca0e6eb49ca99edb1bafff2c1e041386","silent":{"arguments":"/quiet /norestart","source":"default"},"successCodes":[],"type":"wix","uninstall":{"type":"productCode","value":"{7A9DC12A-C1F4-44F4-A2CA-8E09A8E7AA15}"},"url":"https://github.com/different-ai/openwork/releases/download/v0.11.40/openwork-desktop-windows-x64.msi"}],"licenseUrl":"https://github.com/different-ai/openwork/blob/HEAD/LICENSE","packageLocalizations":{"en-US":{"description":"An open-source alternative to Claude Cowork, powered by OpenCode","license":"MIT","licenseUrl":"https://github.com/different-ai/openwork/blob/HEAD/LICENSE","locale":"en-US","longDescription":"OpenWork is an extensible, open-source “Claude Work” style system for knowledge workers.\nIt’s a native desktop app that runs OpenCode under the hood, but presents it as a clean, guided workflow:\n- pick a workspace\n- start a run\n- watch progress + plan updates\n- approve permissions when needed\n- reuse what works (templates + skills)\nThe goal: make “agentic work” feel like a product, not a terminal.","name":"OpenWork","packageUrl":"https://openwork.software/","publisher":"differentai","publisherUrl":"https://openwork.software/","releaseNotesUrl":"https://github.com/different-ai/openwork/releases/tag/v0.11.40","tags":["agent","agentic","ai","large-language-model","llm","opencode"]},"zh-CN":{"description":"由 OpenCode 驱动的 Claude Cowork 开源替代方案","locale":"zh-CN","longDescription":"OpenWork 是一个可扩展的开源“Claude Work”风格系统，专为知识工作者设计。\n它是一款原生桌面应用程序，底层运行 OpenCode，但以简洁、引导式的工作流呈现：\n- 选择一个工作区\n- 开始执行任务\n- 查看进度并规划更新\n- 在需要时批准权限\n- 复用有效内容（模板 + 技能）\n目标：让“自主智能式工作”感觉像一个产品，而不是一个终端。","tags":["opencode","人工智能","大语言模型","智能体","自主智能"]}},"publisherUrl":"https://openwork.software/","releaseDate":"2026-02-10","releaseDateSource":"manifest","releaseNotesUrl":"https://github.com/different-ai/openwork/releases/tag/v0.11.40","schemaVersion":1,"source":"winget","upstream":{"commit":"97d6aa2689f0a05f7847653a62b8624720d15b5d","manifestVersion":"1.12.0","manifests":[{"path":"manifests/d/DifferentAI/OpenWork/0.11.40/DifferentAI.OpenWork.yaml","sha256":"2030ff62c7cc95656df1677274f775b50295c5dbf206091170f658dbdbc124b5"},{"path":"manifests/d/DifferentAI/OpenWork/0.11.40/DifferentAI.OpenWork.installer.yaml","sha256":"c45ce1e1b0223c26fe231c722f5e3e2c8398d83aa1b028b960e740984b67bcbf"},{"path":"manifests/d/DifferentAI/OpenWork/0.11.40/DifferentAI.OpenWork.locale.en-US.yaml","sha256":"653aec51e4d3c766eaa7404616fefaaca865fed84d29b13f195df99e51dc3946"},{"path":"manifests/d/DifferentAI/OpenWork/0.11.40/DifferentAI.OpenWork.locale.zh-CN.yaml","sha256":"4fa639537a4dfc7b4ad15ca3b67416920418e604de6f7c7c1495d340a260d0e1"}],"repository":"microsoft/winget-pkgs"},"version":"0.11.40"}