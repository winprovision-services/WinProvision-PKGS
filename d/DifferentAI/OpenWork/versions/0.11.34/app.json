{"defaultLocale":"en-US","id":"DifferentAI.OpenWork","installers":[{"appsAndFeaturesEntries":[{"UpgradeCode":"{2A300FB5-FA81-5886-A03C-B8C20DF4E74B}"}],"architecture":"x64","dependencies":[],"elevation":{"requirement":"elevatesSelf","source":"manifest"},"id":"x64-machine-wix","installerSwitches":{"InstallLocation":"INSTALLDIR=\"<INSTALLPATH>\""},"priority":2,"scope":"machine","sha256":"4647450b24198b84c8ffb4c5509b5a760649c7da6b5a1b893196aa3ca39b7148","silent":{"arguments":"/quiet /norestart","source":"default"},"successCodes":[],"type":"wix","uninstall":{"type":"productCode","value":"{AFC7F29F-3031-4BFE-822A-F8AFA23228D9}"},"url":"https://github.com/different-ai/openwork/releases/download/v0.11.34/openwork-desktop-windows-x64.msi"}],"licenseUrl":"https://github.com/different-ai/openwork/blob/HEAD/LICENSE","packageLocalizations":{"en-US":{"description":"An open-source alternative to Claude Cowork, powered by OpenCode","license":"MIT","licenseUrl":"https://github.com/different-ai/openwork/blob/HEAD/LICENSE","locale":"en-US","longDescription":"OpenWork is an extensible, open-source “Claude Work” style system for knowledge workers.\nIt’s a native desktop app that runs OpenCode under the hood, but presents it as a clean, guided workflow:\n- pick a workspace\n- start a run\n- watch progress + plan updates\n- approve permissions when needed\n- reuse what works (templates + skills)\nThe goal: make “agentic work” feel like a product, not a terminal.","name":"OpenWork","packageUrl":"https://openwork.software/","publisher":"differentai","publisherUrl":"https://openwork.software/","releaseNotesUrl":"https://github.com/different-ai/openwork/releases/tag/v0.11.34","tags":["agent","agentic","ai","large-language-model","llm","opencode"]},"zh-CN":{"description":"由 OpenCode 驱动的 Claude Cowork 开源替代方案","locale":"zh-CN","longDescription":"OpenWork 是一个可扩展的开源“Claude Work”风格系统，专为知识工作者设计。\n它是一款原生桌面应用程序，底层运行 OpenCode，但以简洁、引导式的工作流呈现：\n- 选择一个工作区\n- 开始执行任务\n- 查看进度并规划更新\n- 在需要时批准权限\n- 复用有效内容（模板 + 技能）\n目标：让“自主智能式工作”感觉像一个产品，而不是一个终端。","tags":["opencode","人工智能","大语言模型","智能体","自主智能"]}},"publisherUrl":"https://openwork.software/","releaseDate":"2026-02-08","releaseDateSource":"manifest","releaseNotesUrl":"https://github.com/different-ai/openwork/releases/tag/v0.11.34","schemaVersion":1,"source":"winget","upstream":{"commit":"97d6aa2689f0a05f7847653a62b8624720d15b5d","manifestVersion":"1.12.0","manifests":[{"path":"manifests/d/DifferentAI/OpenWork/0.11.34/DifferentAI.OpenWork.yaml","sha256":"2018bc91fa9fe99425bbbe6d80500d2fd5d2e73c1c29dc66a60afbc19dccde36"},{"path":"manifests/d/DifferentAI/OpenWork/0.11.34/DifferentAI.OpenWork.installer.yaml","sha256":"607064bf05a4c11d8275e43ace91de295f3ceae0231d16ec7ca1f96f9b6d2eeb"},{"path":"manifests/d/DifferentAI/OpenWork/0.11.34/DifferentAI.OpenWork.locale.en-US.yaml","sha256":"17e93b1af76968641ddf6f30d62f916ce4b9679e5e877470810055649ba6a8b0"},{"path":"manifests/d/DifferentAI/OpenWork/0.11.34/DifferentAI.OpenWork.locale.zh-CN.yaml","sha256":"e35dfb57ea2e35a992669f7c6f6f03fa78d1515c4341064545b7e347fdcb3946"}],"repository":"microsoft/winget-pkgs"},"version":"0.11.34"}