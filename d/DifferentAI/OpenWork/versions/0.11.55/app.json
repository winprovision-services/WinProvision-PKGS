{"defaultLocale":"en-US","id":"DifferentAI.OpenWork","installers":[{"appsAndFeaturesEntries":[{"UpgradeCode":"{2A300FB5-FA81-5886-A03C-B8C20DF4E74B}"}],"architecture":"x64","dependencies":[],"elevation":{"requirement":"elevatesSelf","source":"manifest"},"id":"x64-machine-wix","installerSwitches":{"InstallLocation":"INSTALLDIR=\"<INSTALLPATH>\""},"priority":2,"scope":"machine","sha256":"7bb1e5ceb08077bceedde9597fe8006bc0ce8b1d18b5b1f3c7d0fa9760fa8f2b","silent":{"arguments":"/quiet /norestart","source":"default"},"successCodes":[],"type":"wix","uninstall":{"type":"productCode","value":"{61F1D7AC-5317-49CD-84A8-817FB2166ECF}"},"url":"https://github.com/different-ai/openwork/releases/download/v0.11.55/openwork-desktop-windows-x64.msi"}],"licenseUrl":"https://github.com/different-ai/openwork/blob/HEAD/LICENSE","packageLocalizations":{"en-US":{"description":"An open-source alternative to Claude Cowork, powered by OpenCode","license":"MIT","licenseUrl":"https://github.com/different-ai/openwork/blob/HEAD/LICENSE","locale":"en-US","longDescription":"OpenWork is an extensible, open-source “Claude Work” style system for knowledge workers.\nIt’s a native desktop app that runs OpenCode under the hood, but presents it as a clean, guided workflow:\n- pick a workspace\n- start a run\n- watch progress + plan updates\n- approve permissions when needed\n- reuse what works (templates + skills)\nThe goal: make “agentic work” feel like a product, not a terminal.","name":"OpenWork","packageUrl":"https://openwork.software/","publisher":"differentai","publisherUrl":"https://openwork.software/","releaseNotesUrl":"https://github.com/different-ai/openwork/releases/tag/v0.11.55","tags":["agent","agentic","ai","large-language-model","llm","opencode"]},"zh-CN":{"description":"由 OpenCode 驱动的 Claude Cowork 开源替代方案","locale":"zh-CN","longDescription":"OpenWork 是一个可扩展的开源“Claude Work”风格系统，专为知识工作者设计。\n它是一款原生桌面应用程序，底层运行 OpenCode，但以简洁、引导式的工作流呈现：\n- 选择一个工作区\n- 开始执行任务\n- 查看进度并规划更新\n- 在需要时批准权限\n- 复用有效内容（模板 + 技能）\n目标：让“自主智能式工作”感觉像一个产品，而不是一个终端。","tags":["opencode","人工智能","大语言模型","智能体","自主智能"]}},"publisherUrl":"https://openwork.software/","releaseDate":"2026-02-11","releaseDateSource":"manifest","releaseNotesUrl":"https://github.com/different-ai/openwork/releases/tag/v0.11.55","schemaVersion":1,"source":"winget","upstream":{"commit":"97d6aa2689f0a05f7847653a62b8624720d15b5d","manifestVersion":"1.12.0","manifests":[{"path":"manifests/d/DifferentAI/OpenWork/0.11.55/DifferentAI.OpenWork.yaml","sha256":"127928e2af770a89b8106f60cd8cdc1e27dab7cc3ced10f4c52aefdf1e1b21e1"},{"path":"manifests/d/DifferentAI/OpenWork/0.11.55/DifferentAI.OpenWork.installer.yaml","sha256":"6e7eaf8c1a8fcc5d99f1c3aa01b84386de793aa1cf233ebb9a63d4c4cbfc5638"},{"path":"manifests/d/DifferentAI/OpenWork/0.11.55/DifferentAI.OpenWork.locale.en-US.yaml","sha256":"b7d9821a16e92537398d826d0a2a3fe747ae0ad56d2ce2bb1e53cdc13fdeff91"},{"path":"manifests/d/DifferentAI/OpenWork/0.11.55/DifferentAI.OpenWork.locale.zh-CN.yaml","sha256":"b2ef98afe8322a93b2b1f98707196705062674c2f3656e917b58cbc0c88a4115"}],"repository":"microsoft/winget-pkgs"},"version":"0.11.55"}