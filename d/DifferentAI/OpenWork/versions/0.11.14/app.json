{"defaultLocale":"en-US","id":"DifferentAI.OpenWork","installers":[{"appsAndFeaturesEntries":[{"UpgradeCode":"{2A300FB5-FA81-5886-A03C-B8C20DF4E74B}"}],"architecture":"x64","dependencies":[],"elevation":{"requirement":"elevatesSelf","source":"manifest"},"id":"x64-machine-wix","installerSwitches":{"InstallLocation":"INSTALLDIR=\"<INSTALLPATH>\""},"priority":2,"scope":"machine","sha256":"97d0996d64f3aeb7b0bf80c06f1a0a0475f0934bd1aa85d19ebe3cd99ef73c70","silent":{"arguments":"/quiet /norestart","source":"default"},"successCodes":[],"type":"wix","uninstall":{"type":"productCode","value":"{F5D2AC15-1DDE-428C-8D60-28C3FCAE8BA1}"},"url":"https://github.com/different-ai/openwork/releases/download/v0.11.14/openwork-desktop-windows-x64.msi"}],"licenseUrl":"https://github.com/different-ai/openwork/blob/HEAD/LICENSE","packageLocalizations":{"en-US":{"description":"An open-source alternative to Claude Cowork, powered by OpenCode","license":"MIT","licenseUrl":"https://github.com/different-ai/openwork/blob/HEAD/LICENSE","locale":"en-US","longDescription":"OpenWork is an extensible, open-source “Claude Work” style system for knowledge workers.\nIt’s a native desktop app that runs OpenCode under the hood, but presents it as a clean, guided workflow:\n- pick a workspace\n- start a run\n- watch progress + plan updates\n- approve permissions when needed\n- reuse what works (templates + skills)\nThe goal: make “agentic work” feel like a product, not a terminal.","name":"OpenWork","packageUrl":"https://openwork.software/","publisher":"differentai","publisherUrl":"https://openwork.software/","releaseNotesUrl":"https://github.com/different-ai/openwork/releases/tag/v0.11.14","tags":["agent","agentic","ai","large-language-model","llm","opencode"]},"zh-CN":{"description":"由 OpenCode 驱动的 Claude Cowork 开源替代方案","locale":"zh-CN","longDescription":"OpenWork 是一个可扩展的开源“Claude Work”风格系统，专为知识工作者设计。\n它是一款原生桌面应用程序，底层运行 OpenCode，但以简洁、引导式的工作流呈现：\n- 选择一个工作区\n- 开始执行任务\n- 查看进度并规划更新\n- 在需要时批准权限\n- 复用有效内容（模板 + 技能）\n目标：让“自主智能式工作”感觉像一个产品，而不是一个终端。","tags":["opencode","人工智能","大语言模型","智能体","自主智能"]}},"publisherUrl":"https://openwork.software/","releaseDate":"2026-02-05","releaseDateSource":"manifest","releaseNotesUrl":"https://github.com/different-ai/openwork/releases/tag/v0.11.14","schemaVersion":1,"source":"winget","upstream":{"commit":"97d6aa2689f0a05f7847653a62b8624720d15b5d","manifestVersion":"1.12.0","manifests":[{"path":"manifests/d/DifferentAI/OpenWork/0.11.14/DifferentAI.OpenWork.yaml","sha256":"ce396f6a59cbcdcd0777c131ccd6a9500ce1f8c32bd45983f33bfef55aa0bbc5"},{"path":"manifests/d/DifferentAI/OpenWork/0.11.14/DifferentAI.OpenWork.installer.yaml","sha256":"33a2d8cc03751edcfb952aa9834f51e9cff135406c0fec855a54887ef75dea22"},{"path":"manifests/d/DifferentAI/OpenWork/0.11.14/DifferentAI.OpenWork.locale.en-US.yaml","sha256":"2bd54efff84a6580bbf0ec00f1cb65afb2bee79399473c485acff15271b7c272"},{"path":"manifests/d/DifferentAI/OpenWork/0.11.14/DifferentAI.OpenWork.locale.zh-CN.yaml","sha256":"eeeafc0a9dd0a499f4bb715ef02781633964f4f6973667e94633205c9d6343bc"}],"repository":"microsoft/winget-pkgs"},"version":"0.11.14"}