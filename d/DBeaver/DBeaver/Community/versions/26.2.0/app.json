aver/releases/tag/26.2.0","tags":["apache-hive","db2","firebird","mssql","mysql","oracle","phoenix","postgres","postgresql","presto","sql","sqlite","sybase","teradata","工具","数据库"]}},"publisherUrl":"https://dbeaver.io/","releaseDate":"2026-08-30","releaseDateSource":"manifest","releaseNotesUrl":"https://github.com/dbeaver/dbeaver/releases/tag/26.2.0","schemaVersion":1,"source":"winget","upstream":{"commit":"97d6aa2689f0a05f7847653a62b8624720d15b5d","manifestVersion":"1.12.0","manifests":[{"path":"manifests/d/DBeaver/DBeaver/Community/26.2.0/DBeaver.DBeaver.Community.yaml","sha256":"9fa52693136856559bd487993c91ef06f368919c8fbb3d9f35a9d4492ad3f228"},{"path":"manifests/d/DBeaver/DBeaver/Community/26.2.0/DBeaver.DBeaver.Community.installer.yaml","sha256":"18afc451ec1f8ccac6f9c1c428fa013f1dc502425723b88a1d718fe15ef38adf"},{"path":"manifests/d/DBeaver/DBeaver/Community/26.2.0/DBeaver.DBeaver.Community.locale.en-US.yaml","sha256":"ce19ce25f35bc0986fc63a80cb93ef59091651bc910d251058854b7bca3a318a"},{"path":"manifests/d/DBeaver/DBeaver/Community/26.2.0/DBeaver.DBeaver.Community.locale.zh-CN.yaml","sha256":"0ffb4b59357209c58d690c6d97427b15e2dc6f588a7e2caacced19d358f407a1"}],"repository":"microsoft/winget-pkgs"},"version":"26.2.0"}