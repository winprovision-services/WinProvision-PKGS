{"architectures":["arm64","x64","x86"],"id":"DBeaver.DBeaver.Community","latestVersion":"26.2.0","media":{"icons":[{"mimeType":"image/png","path":"media/icon.7934294e.png","priority":1,"sha256":"7934294e64278027090e2c6748eb94c092faf8e39349451a48c8ceeb5064a17a","source":"winget-legacy"}],"screenshots":[]},"package":{"description":"Free Universal Database Tool","license":"Apache-2.0","licenseUrl":"https://github.com/dbeaver/dbeaver/blob/HEAD/LICENSE.md","locale":"en-US","localizations":{"en-US":{"description":"Free Universal Database Tool","license":"Apache-2.0","licenseUrl":"https://github.com/dbeaver/dbeaver/blob/HEAD/LICENSE.md","locale":"en-US","longDescription":"DBeaver is free and open source universal database tool for developers and database administrators.\n- Usability is the main goal of this project, program UI is carefully designed and implemented.\n- It is free and open-source (ASL).\n- It is multiplatform.\n- It is based on opensource framework and allows writing of various extensions (plugins).\n- It supports any database having a JDBC driver.\n- It may handle any external datasource which may or may not have a JDBC driver.\n- There is a set of plugins for different databases and different database management utilities (e.g. ERD, data transfer, compare, data export/import, mock data generation, etc).\n- It has a great number of features.","moniker":"dbeaver","name":"DBeaver","packageUrl":"https://dbeaver.io/download/","publisher":"DBeaver Corp","publisherUrl":"https://dbeaver.io/","releaseNotesUrl":"https://github.com/dbeaver/dbeaver/releases/tag/26.2.0","tags":["apache-hive","database","db2","firebird","mssql","mysql","oracle","phoenix","postgres","postgresql","presto","sql","sqlite","sybase","teradata","tool"]},"zh-CN":{"description":"免费通用数据库工具","locale":"zh-CN","longDescription":"DBeaver 是一款面向开发者和数据库管理员的免费开源通用数据库工具。\n- 易用性是该项目的核心目标，软件界面经过精心设计与实现。\n- 采用免费开源协议（ASL）。\n- 支持跨平台运行。\n- 基于开源框架开发，可编写多样化扩展功能（插件）。\n- 兼容所有配备 JDBC 驱动的数据库。\n- 可处理任意外部数据源（无论是否具备 JDBC 驱动）。\n- 提供针对不同数据库的插件集及多样化数据库管理功能（如 ER 图、数据传输、结构对比、数据导入/导出、模拟数据生成等）。\n- 具备丰富的功能特性。","releaseNotesUrl":"https://github.com/dbeaver/dbeaver/releases/tag/26.2.0","tags":["apache-hive","db2","firebird","mssql","mysql","oracle","phoenix","postgres","postgresql","presto","sql","sqlite","sybase","teradata","工具","数据库"]}},"longDescription":"DBeaver is free and open source universal database tool for developers and database administrators.\n- Usability is the main goal of this project, program UI is carefully designed and implemented.\n- It is free and open-source (ASL).\n- It is multiplatform.\n- It is based on opensource framework and allows writing of various extensions (plugins).\n- It supports any database having a JDBC driver.\n- It may handle any external datasource which may or may not have a JDBC driver.\n- There is a set of plugins for different databases and different database management utilities (e.g. ERD, data transfer, compare, data export/import, mock data generation, etc).\n- It has a great number of features.","moniker":"dbeaver","name":"DBeaver","packageUrl":"https://dbeaver.io/download/","publisher":"DBeaver Corp","publisherUrl":"https://dbeaver.io/","releaseNotesUrl":"https://github.com/dbeaver/dbeaver/releases/tag/26.2.0","tags":["apache-hive","database","db2","firebird","mssql","mysql","oracle","phoenix","postgres","postgresql","presto","sql","sqlite","sybase","teradata","tool"]},"schemaVersion":1,"source":"winget","versions":[{"architectures":["arm64","x64"],"detailPath":"versions/26.2.0/app.json","detailSha256":"e63486ed20ecfd70a80918f498f7dd2c9b64c820bf3b888deefc563f39780198","releaseDate":"2026-08-30","releaseDateSource":"manifest","version":"26.2.0"},{"architectures":["arm64","x64"],"detailPath":"versions/26.1.5/app.json","detailSha256":"c4a4e047ea06de2ceec79c315bb1cdb77c1dc7fa86cf2f4017c21aa6bce023ab","releaseDate":"2026-08-16","releaseDateSource":"manifest","version":"26.1.5"},{"architectures":["arm64","x64"],"detailPath":"versions/26.1.4/app.js