{"defaultLocale":"en-US","id":"DerellLicht.PrettyReMark","installers":[{"architecture":"x64","dependencies":[{"PackageDependencies":[{"PackageIdentifier":"Microsoft.EdgeWebView2Runtime"}]}],"id":"x64-user-zip","installModes":["interactive","silent","silentWithProgress"],"minimumOSVersion":"10.0.17763.0","nestedInstallerFiles":[{"RelativeFilePath":"PrettyReMarkV1.20.setup.exe"}],"nestedInstallerType":"inno","platforms":["Windows.Desktop"],"priority":4,"scope":"user","sha256":"a675a1bf73122b2581af496cdec6cbdb7ec917cfab21fa778ac0e9c09c4073dd","successCodes":[],"type":"zip","upgradeBehavior":"install","url":"https://gitlab.com/DerellLicht/pretty-mark/-/releases/v1.20/downloads/PrettyReMarkV1.20.setup.zip"}],"licenseUrl":"https://gitlab.com/DerellLicht/pretty-mark/-/blob/main/LICENSE.MIT.txt","packageLocalizations":{"en-US":{"description":"A native, tabbed Markdown viewer for Windows with live reload and syntax highlighting (fork of eagle1's PrettyMark).","license":"MIT","licenseUrl":"https://gitlab.com/DerellLicht/pretty-mark/-/blob/main/LICENSE.MIT.txt","locale":"en-US","longDescription":"PrettyReMark is a native, tabbed Markdown viewer for\nWindows built with .NET 8 and WebView2. This fork adds a JSON-based user\ncolor-override config, an Options dialog, window position/size persistence,\nper-file scroll-position memory, and fixes for local file/image links and\nmailto: links. PrettyReMark is a fork of eagle1's PrettyMark.  \nFeatures carried over from upstream include GitHub-flavored\nMarkdown rendering, syntax highlighting, live reload on file save, dark\nmode, multi-tab support, drag and drop, find bar, print support, and\nmulti-language UI.  ","name":"PrettyReMark","packageUrl":"https://gitlab.com/DerellLicht/pretty-mark","publisher":"DerellLicht","publisherUrl":"https://gitlab.com/DerellLicht","tags":["markdown","viewer","markdown-viewer"]}},"publisherUrl":"https://gitlab.com/DerellLicht","schemaVersion":1,"source":"winget","upstream":{"commit":"97d6aa2689f0a05f7