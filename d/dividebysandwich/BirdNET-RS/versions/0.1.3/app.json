{"defaultLocale":"en-US","id":"dividebysandwich.BirdNET-RS","installers":[{"appsAndFeaturesEntries":[{"UpgradeCode":"{7F3A9C2E-5B1D-4E6A-9C84-2D1F6B0A3E57}"}],"architecture":"x64","dependencies":[],"elevation":{"requirement":"elevationRequired","source":"inferred"},"id":"x64-machine-wix","installerSwitches":{"InstallLocation":"INSTALLFOLDER=\"<INSTALLPATH>\""},"priority":2,"scope":"machine","sha256":"b173c84668b72b7b8e2f315d2a5c1ff29e2a51cab7c554d120099375e2fd67ce","silent":{"arguments":"/quiet /norestart","source":"default"},"successCodes":[],"type":"wix","uninstall":{"type":"productCode","value":"{2192DF85-E17A-41F7-AD69-2BF6083426ED}"},"url":"https://github.com/dividebysandwich/birdnet-rs/releases/download/v0.1.3/birdnet-rs-0.1.3-windows-x64.msi"}],"licenseUrl":"https://github.com/dividebysandwich/birdnet-rs/blob/HEAD/LICENSE","packageLocalizations":{"en-US":{"copyright":"Copyright (c) 2026 dividebysandwich","description":"Realtime bird sound recognition with a web dashboard.","license":"MIT","licenseUrl":"https://github.com/dividebysandwich/birdnet-rs/blob/HEAD/LICENSE","locale":"en-US","longDescription":"birdnet-rs is a self-hosted, realtime soundscape analyzer that listens to a microphone around the clock, identifies bird species with the BirdNET neural network, filters false positives, stores detections in a local database, saves audio clips, and shows them live in a built-in web dashboard. Start the server executable and open the dashboard in a browser. The bundled BirdNET GLOBAL 6K v2.4 model is licensed separately by Cornell Lab under CC BY-NC-SA 4.0 and is downloaded automatically on first run.","name":"BirdNET-RS","packageUrl":"https://github.com/dividebysandwich/birdnet-rs","publisher":"dividebysandwich","publisherSupportUrl":"https://github.com/dividebysandwich/birdnet-rs/issues","publisherUrl":"https://github.com/dividebysandwich","releaseNotes":"What's changed\n- New statistics page\n- New calendar page","releaseNotesUrl":"https://github.com/dividebysandwich/birdnet-rs/releases/tag/v0.1.3","tags":["bioacoustics","birdnet","birds","nature","sound-analysis","web-server"]},"zh-CN":{"description":"实时鸟类鸣声识别，附带网页仪表板。","locale":"zh-CN","longDescription":"birdnet-rs 是一款可自托管的实时声景分析工具，全天候监听麦克风，使用 BirdNET 神经网络识别鸟种，过滤误报，将检测结果存入本地数据库并保存音频片段，同时在内置网页仪表板中实时展示。启动服务程序后在浏览器中打开仪表板即可使用。随附的 BirdNET GLOBAL 6K v2.4 模型由康奈尔鸟类学实验室以 CC BY-NC-SA 4.0 单独授权，并会在首次运行时自动下载。","tags":["声音分析","观鸟","鸟类识别"]}},"publisherSupportUrl":"https://github.com/dividebysandwich/birdnet-rs/issues","publisherUrl":"https://github.com/dividebysandwich","releaseDate":"2026-11-10","releaseDateSource":"commit","releaseNotesUrl":"https://github.com/dividebysandwich/birdnet-rs/releases/tag/v0.1.3","schemaVersion":1,"source":"winget","upstream":{"commit":"06fe0c1922ea63380b4e7a9b4a957cc117ac9fe3","manifestVersion":"1.28.0","manifests":[{"path":"manifests/d/dividebysandwich/BirdNET-RS/0.1.3/dividebysandwich.BirdNET-RS.installer.yaml","sha256":"0711d6923ef2bc92c50ecd8f5c943afb45fc761a2ef6dcfea0986ae973702714"},{"path":"manifests/d/dividebysandwich/BirdNET-RS/0.1.3/dividebysandwich.BirdNET-RS.locale.en-US.yaml","sha256":"490360cce1848cab66bcc3f6f1b545a460c4653887e25f1ae4e70f395aaf2a92"},{"path":"manifests/d/dividebysandwich/BirdNET-RS/0.1.3/dividebysandwich.BirdNET-RS.locale.zh-CN.yaml","sha256":"9a219f17e25bd45e661b2cbda9bcaa7884496a5986b7e71f44e268f6e2a4684f"},{"path":"manifests/d/dividebysandwich/BirdNET-RS/0.1.3/dividebysandwich.BirdNET-RS.yaml","sha256":"9469f81e8ac125bc68e478ff0f565166c2f0932094781d74a7f5aab80fb20d8f"}],"repository":"microsoft/winget-pkgs"},"version":"0.1.3"}