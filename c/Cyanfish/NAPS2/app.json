{"architectures":["arm64","x64","x86"],"id":"Cyanfish.NAPS2","latestVersion":"8.6.0","media":{"icons":[],"screenshots":[]},"package":{"description":"Scan documents to PDF and other file types, as simply as possible.","license":"GPL-2.0","licenseUrl":"https://github.com/cyanfish/naps2/blob/HEAD/LICENSE","locale":"en-US","localizations":{"en-US":{"description":"Scan documents to PDF and other file types, as simply as possible.","license":"GPL-2.0","licenseUrl":"https://github.com/cyanfish/naps2/blob/HEAD/LICENSE","locale":"en-US","longDescription":"NAPS2 is a document scanning application with a focus on simplicity and ease of use. Scan your documents from WIA, TWAIN, SANE, and ESCL scanners, organize the pages as you like, and save them as PDF, TIFF, JPEG, or PNG. Optical character recognition (OCR) is available using Tesseract.","moniker":"naps2","name":"NAPS2","packageUrl":"https://www.naps2.com/","publisher":"NAPS2 Software","publisherUrl":"https://www.naps2.com/","releaseNotesUrl":"https://github.com/cyanfish/naps2/releases/tag/v8.6.0","tags":["pdf","scan","scanner"]},"zh-CN":{"description":"尽可能简单地将文档扫描为 PDF 和其他文件类型。","locale":"zh-CN","longDescription":"NAPS2 是一款专注于简洁易用的文档扫描应用。支持从 WIA、TWAIN、SANE 和 ESCL 扫描仪获取文档，自由编排页面顺序，并保存为 PDF、TIFF、JPEG 或 PNG 格式。通过 Tesseract 引擎提供光学字符识别（OCR）功能。","releaseNotesUrl":"https://github.com/cyanfish/naps2/releases/tag/v8.6.0","tags":[]}},"longDescription":"NAPS2 is a document scanning application with a focus on simplicity and ease of use. Scan your documents from WIA, TWAIN, SANE, and ESCL scanners, organize the pages as you like, and save them as PDF, TIFF, JPEG, or PNG. Optical character recognition (OCR) is available using Tesseract.","moniker":"naps2","name":"NAPS2","packageUrl":"https://www.naps2.com/","publisher":"NAPS2 Software","publisherUrl":"https://www.naps2.com/","releaseNotesUrl":"https://github.com/cyanfish/naps2/releases/tag/v8.6.0","tags":["pdf","scan","scanner"]},"schemaVersion":1,"source":"winget","versions":[{"archite