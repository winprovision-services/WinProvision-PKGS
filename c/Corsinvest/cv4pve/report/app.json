{"architectures":["arm64","x64","x86"],"id":"Corsinvest.cv4pve.report","latestVersion":"2.9.0","media":{"icons":[],"screenshots":[]},"package":{"description":"Report Tool for Proxmox VE","license":"GPL-3.0","licenseUrl":"https://github.com/Corsinvest/cv4pve-report/blob/HEAD/LICENSE.md","locale":"en-US","localizations":{"en-US":{"description":"Report Tool for Proxmox VE","license":"GPL-3.0","licenseUrl":"https://github.com/Corsinvest/cv4pve-report/blob/HEAD/LICENSE.md","locale":"en-US","longDescription":"cv4pve-report exports your entire Proxmox VE infrastructure to a single\nnavigable Excel file — nodes, VMs, containers, storages, users, firewall\nrules, backup jobs, resource pools and more. Every row is a hyperlink to\nits detail sheet.\n\nFeatures:\n- Single .xlsx file with one sheet per node, VM and storage\n- Fully navigable — summary rows link to detail sheets\n- Cluster: users, API tokens, TFA, groups, roles, ACL, firewall, backup jobs, replication, SDN, pools\n- Nodes: services, network, disks, SMART, RRD metrics, APT updates, SSL certificates, tasks\n- VMs/CTs: config, network, disks, RRD metrics, backups, snapshots, firewall, QEMU agent info\n- Storages: content inventory, RRD metrics\n- Three profiles: Fast, Standard, Full\n- Works with a read-only API token, no root access required","moniker":"cv4pve-report","name":"cv4pve-report","packageUrl":"https://github.com/Corsinvest/cv4pve-report","publisher":"Corsinvest Srl","publisherUrl":"https://www.corsinvest.it/","releaseNotesUrl":"https://github.com/Corsinvest/cv4pve-report/releases/tag/v2.9.0","tags":["corsinvest","excel","infrastructure","inventory","proxmox","proxmoxve","report","xlsx"]}},"longDescription":"cv4pve-report exports your entire Proxmox VE infrastructure to a single\nnavigable Excel file — nodes, VMs, containers, storages, users, firewall\nrules, backup jobs, resource pools and more. Every row is a hyperlink to\nits detail sheet.\n\nFeatures:\n- Single .xlsx file with one sheet per node, VM and storage\n- Fully navigable — summary rows link to detail sheets\n- Cluster: users, API tokens, TFA, groups, roles, ACL, firewall, backup jobs, replication, SDN, pools\n- Nodes: services, network, disks, SMART, RRD metrics, APT updates, SSL certificates, tasks\n- VMs/CTs: config, network, disks, RRD metrics, backups, snapshots, firewall, QEMU agent info\n- Storages: content inventory, RRD metrics\n- Three profiles: Fast, Standard, Full\n- Works with a read-only API token, no root access required","moniker":"cv4pve-report","name":"cv4pve-report","packageUrl":"https://github.com/Corsinvest/cv4pve-report","publisher":"Corsinvest Srl","publisherUrl":"https://www.corsinvest.it/","releaseNotesUrl":"https://github.com/Corsinvest/cv4pve-report/releases/tag/v2.9.0","tags":["corsinvest","excel","infrastructure","inventory","proxmox","proxmoxve","report","xlsx"]},"schemaVersion":1,"source":"winget","versions":[{"architectures":["arm64","x64","x86"],"detailPath":"versions/2.9.0/app.json","detailSha256":"884076bd571b0be6a367fea86cb52ebaa4e4420f88a9155ea20bc651c959e953","releaseDate":"2026-10-02","releaseDateSource":"manifest","version":"2.9.0"},{"architectures":["arm64","x64","x86"],"detailPath":"versions/2.8.1/app.json","detailSha256":"779c5d71275f03da5d7bcb62853be8a1e570228c46d53a4cac638255bd01576b","releaseDate":"2026-09-30","releaseDateSource":"manifest","version":"2.8.1"},{"architectures":["arm64","x64","x86"],"detailPath":"versions/2.5.1/app.json","detailSha256":"bbd19a469bc1001fb044db781bcf0dc571303496cc0446a49ca01be2006e5433","releaseDate":"2026-06-01","releaseDateSource":"manifest","version":"2.5.1"},{"architectures":["arm64","x64","x86"],"detailPath":"versions/2.5.0/app.json","detailSha256":"00e2b8f22ae5a486c9a640a55a865bee3e5d2964870965e1b49a6c5682e0e53e","releaseDate":"2026-05-27","releaseDateSource":"manifest","version":"2.5.0"},{"architectures":["arm64","x64","x86"],"detailPath":"versions/2.3.0/app.json","detailSha256":"1afb024da24bf8ab47b7a83b7833910b10a12af3eb4