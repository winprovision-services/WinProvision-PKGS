{"defaultLocale":"en-US","id":"CitrusSoda.ArcThumb","installers":[{"appsAndFeaturesEntries":[{"DisplayName":"ArcThumb 0.7.1","DisplayVersion":"0.12.0","InstallerType":"inno","ProductCode":"{DFE16BE0-6554-4F21-BB11-51601FD3FEC8}_is1","Publisher":"citrussoda-com"}],"architecture":"x64","dependencies":[],"elevation":{"requirement":"elevationRequired","source":"inferred"},"fileExtensions":["azw","azw3","cb7","cbr","cbt","cbz","epub","fb2","mobi"],"id":"x64-machine-inno","installModes":["interactive","silent","silentWithProgress"],"installerSwitches":{"Custom":"/ALLUSERS"},"priority":1,"scope":"machine","sha256":"a7c8d9438bec90aab87bd67b7c77b4a93ea4cbf79babafe8462d3f912309147e","silent":{"arguments":"/VERYSILENT /SUPPRESSMSGBOXES /NORESTART /SP-","source":"default"},"successCodes":[],"type":"inno","url":"https://github.com/citrussoda-com/ArcThumb/releases/download/v0.12.0/ArcThumb-Setup.exe"},{"appsAndFeaturesEntries":[{"DisplayName":"ArcThumb 0.7.1","DisplayVersion":"0.12.0","InstallerType":"inno","ProductCode":"{DFE16BE0-6554-4F21-BB11-51601FD3FEC8}_is1","Publisher":"citrussoda-com"}],"architecture":"x64","dependencies":[],"fileExtensions":["azw","azw3","cb7","cbr","cbt","cbz","epub","fb2","mobi"],"id":"x64-user-inno","installModes":["interactive","silent","silentWithProgress"],"installerSwitches":{"Custom":"/CURRENTUSER"},"priority":1,"scope":"user","sha256":"a7c8d9438bec90aab87bd67b7c77b4a93ea4cbf79babafe8462d3f912309147e","silent":{"arguments":"/VERYSILENT /SUPPRESSMSGBOXES /NORESTART /SP-","source":"default"},"successCodes":[],"type":"inno","url":"https://github.com/citrussoda-com/ArcThumb/releases/download/v0.12.0/ArcThumb-Setup.exe"}],"licenseUrl":"https://github.com/citrussoda-com/ArcThumb#license","packageLocalizations":{"en-US":{"description":"Windows Explorer thumbnail and preview handler for archive files and ebooks.","license":"MIT OR Apache-2.0","licenseUrl":"https://github.com/citrussoda-com/ArcThumb#license","locale":"en-US","longDescription":"ArcThumb is a Windows Shell Extension that adds thumbnail icons and preview-pane previews to Windows Explorer for archive files and ebooks. When a supported file contains images, ArcThumb decodes the first one and shows it as the file's thumbnail; the preview pane renders a larger version. Supported containers: ZIP, 7Z, RAR, TAR and their media variants (CBZ, CB7, CBR, CBT), plus ebooks in EPUB, FB2, MOBI, AZW, and AZW3. Images inside are decoded from JPEG, PNG, GIF, BMP, TIFF, ICO, and WebP. Optional JPEG XL support is available in custom builds. ArcThumb is a Rust-based successor to CBX Shell and DarkThumbs. A bundled configuration GUI lets you toggle formats, set decode limits, and register or unregister the extension. Installs per-user by default with no administrator privileges; running the installer elevated registers the extension machine-wide instead, which is required when Explorer runs at high integrity (such as Windows Sandbox). Requires Windows 10 or later on x64.","moniker":"arcthumb","name":"ArcThumb","packageUrl":"https://citrussoda.com/en/arcthumb","publisher":"citrussoda-com","publisherUrl":"https://citrussoda.com","releaseNotesUrl":"https://github.com/citrussoda-com/ArcThumb/releases/tag/v0.12.0","tags":["ebook-thumbnails","preview","file-explorer","fileexplorer","shell-extension","archives","ebook","zip","epub","cbz","cbxshell","darkthumbs"]}},"publisherUrl":"https://citrussoda.com","releaseDate":"2026-10-05","releaseDateSource":"manifest","releaseNotesUrl":"https://github.com/citrussoda-com/ArcThumb/releases/tag/v0.12.0","schemaVersion":1,"source":"winget","upstream":{"commit":"97d6aa2689f0a05f7847653a62b8624720d15b5d","manifestVersion":"1.12.0","manifests":[{"path":"manifests/c/CitrusSoda/ArcThumb/0.12.0/CitrusSoda.ArcThumb.yaml","sha256":"86e6194fe4cc77b0a142a55ec21f9b4e15455f4b4802cecd666e478d4e2415ca"},{"path":"manifests/c/CitrusSoda/ArcThumb/0.12.0/CitrusSoda.ArcThumb.installer.yaml","sha256":"569ff33b91ef2565c9ee0b8e4ea82dbd2d686d7f61f30a6980857df8f0