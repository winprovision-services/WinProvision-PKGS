{"defaultLocale":"en-US","id":"Codeby.RIGStats","installers":[{"architecture":"x64","dependencies":[],"elevation":{"requirement":"elevationRequired","source":"inferred"},"id":"x64-machine-nullsoft","installModes":["interactive","silent"],"installerSwitches":{"Silent":"/S","SilentWithProgress":"/S"},"locale":"en-US","minimumOSVersion":"10.0.0.0","platforms":["Windows.Desktop"],"priority":1,"scope":"machine","sha256":"5059bededdc9f2afa4f69c7cc4cedbf878d2a09c3d9d6b9c686c09afa4231514","silent":{"arguments":"/S","source":"manifest"},"successCodes":[],"type":"nullsoft","upgradeBehavior":"install","url":"https://github.com/dvalfrid/rigstats/releases/download/v1.35.1/RIGStats_1.35.1_x64-setup.exe"}],"licenseUrl":"https://github.com/dvalfrid/rigstats/blob/main/LICENSE","packageLocalizations":{"en-US":{"description":"Real-time hardware monitor for Windows gaming PCs","license":"MIT","licenseUrl":"https://github.com/dvalfrid/rigstats/blob/main/LICENSE","locale":"en-US","longDescription":"RIGStats is a free, open-source hardware monitor for Windows gaming PCs with a dedicated\nsecondary display. It shows CPU, GPU, RAM, network, disk, motherboard, and process data in\nreal time across portrait, landscape, and floating panel layouts.\n\nSensor data comes from LibreHardwareMonitor (kernel-level temps, clocks, power, fan speeds),\nthe sysinfo crate (CPU load, disk I/O, network throughput, processes), and WMI (GPU model,\nRAM spec, battery, system brand). That means per-core clocks, GPU hot-spot temperature, D3D\nengine workloads, DDR5 DIMM temperature, and NVMe temperature — not just OS counters.\n\nNo telemetry. No accounts. No cloud sync. MIT license.","moniker":"rigstats","name":"RIGStats","packageUrl":"https://rigstats.app","publisher":"Code By AB","publisherUrl":"https://rigstats.app","releaseNotesUrl":"https://github.com/dvalfrid/rigstats/releases/tag/v1.35.1","tags":["hardware","monitor","system-monitor","gpu","cpu","temperature","gaming","dashboard","sensors"]}},"publisherUrl":"https://rigstats.app","releaseNotesUrl":"https://github.com/dvalfrid/rigstats/releases/tag/v1.35.1","schemaVersion":1,"source":"winget","upstream":{"commit":"97d6aa2689f0a05f7847653a62b8624720d15b5d","manifestVersion":"1.6.0","manifests":[{"path":"manifests/c/Codeby/RIGStats/1.35.1/Codeby.RIGStats.yaml","sha256":"c17fcf8b24a848031e7c259ab1e287d9f4315114c53c079d173b386ecfd7e71a"},{"path":"manifests/c/Codeby/RIGStats/1.35.1/Codeby.RIGStats.installer.yaml","sha256":"5d4f3ac953ed97edb02abc0b12f2969d099acbdcb2f9c755c63eeeee622e02b9"},{"path":"manifests/c/Codeby/RIGStats/1.35.1/Codeby.RIGStats.locale.en-US.yaml","sha256":"c9d897c9a85a135197cae09322db184ce2174d486b00c0727501667f8038cc4c"}],"repository":"microsoft/winget-pkgs"},"version":"1.35.1"}