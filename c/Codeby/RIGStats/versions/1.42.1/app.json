{"defaultLocale":"en-US","id":"Codeby.RIGStats","installers":[{"architecture":"x64","dependencies":[{"PackageDependencies":[{"PackageIdentifier":"Microsoft.VCRedist.2015+.x64"}]}],"elevation":{"requirement":"elevationRequired","source":"inferred"},"id":"x64-machine-nullsoft","installModes":["interactive","silent"],"installerSwitches":{"Silent":"/S","SilentWithProgress":"/S"},"locale":"en-US","minimumOSVersion":"10.0.0.0","platforms":["Windows.Desktop"],"priority":1,"scope":"machine","sha256":"9ba69b01d01e600a33c5ca6bfd8a7ee2f4ca84a9ee81fa515244319fa8a79e75","silent":{"arguments":"/S","source":"manifest"},"successCodes":[],"type":"nullsoft","upgradeBehavior":"install","url":"https://github.com/dvalfrid/rigstats/releases/download/v1.42.1/RIGStats_1.42.1_x64-setup.exe"}],"licenseUrl":"https://github.com/dvalfrid/rigstats/blob/main/LICENSE","packageLocalizations":{"en-US":{"description":"Real-time hardware monitor for Windows gaming PCs","license":"MIT","licenseUrl":"https://github.com/dvalfrid/rigstats/blob/main/LICENSE","locale":"en-US","longDescription":"RIGStats is a free, open-source hardware monitor for Windows gaming PCs with a dedicated\nsecondary display. It shows CPU, GPU, RAM, network, disk, motherboard, and process data in\nreal time across portrait, landscape, and floating panel layouts.\n\nSensor data comes from LibreHardwareMonitor (kernel-level temps, clocks, power, fan speeds),\nthe sysinfo crate (CPU load, disk I/O, network throughput, processes), and WMI (GPU model,\nRAM spec, battery, system brand). That means per-core clocks, GPU hot-spot temperature, D3D\nengine workloads, DDR5 DIMM temperature, and NVMe temperature — not just OS counters.\n\nNo telemetry. No accounts. No cloud sync. MIT license.","moniker":"rigstats","name":"RIGStats","packageUrl":"https://rigstats.app","publisher":"codeby.se","publisherUrl":"https://rigstats.app","releaseNotesUrl":"https://github.com/dvalfrid/rigstats/releases/tag/v1.42.1","tags":["hardware","monitor","system-monitor","gpu","cpu","temperature","gaming","dashboard","sensors"]}},"publisherUrl":"https://rigstats.app","releaseDate":"2026-10-04","releaseDateSource":"manifest","releaseNotesUrl":"https://github.com/dvalfrid/rigstats/releases/tag/v1.42.1","schemaVersion":1,"source":"winget","upstream":{"commit":"97d6aa2689f0a05f7847653a62b8624720d15b5d","manifestVersion":"1.12.0","manifests":[{"path":"manifests/c/Codeby/RIGStats/1.42.1/Codeby.RIGStats.yaml","sha256":"2c192e646f6bf61dec0ae9bc11da877a679fd58272c80c1a19a8e1ccba8ceb68"},{"path":"manifests/c/Codeby/RIGStats/1.42.1/Codeby.RIGStats.installer.yaml","sha256":"a520872c0c58f16cc797a006a5eb0d61b24991285fb0f7789d48471349ce0652"},{"path":"manifests/c/Codeby/RIGStats/1.42.1/Codeby.RIGStats.locale.en-US.yaml","sha256":"92dba29a74128a5c29bd8396c21219b67d262f147a96ac2caaccb2de0869ca92"}],"repository":"microsoft/winget-pkgs"},"version":"1.42.1"}