{"defaultLocale":"en-US","id":"Codeby.RIGStats","installers":[{"architecture":"x64","dependencies":[{"PackageDependencies":[{"PackageIdentifier":"Microsoft.VCRedist.2015+.x64"}]}],"elevation":{"requirement":"elevationRequired","source":"inferred"},"id":"x64-machine-nullsoft","installModes":["interactive","silent"],"installerSwitches":{"Silent":"/S","SilentWithProgress":"/S"},"locale":"en-US","minimumOSVersion":"10.0.0.0","platforms":["Windows.Desktop"],"priority":1,"scope":"machine","sha256":"410835dac49323c7be8357f2ab5f74ead34d71f7e101ce8a3ecc6c1d0b3fe87e","silent":{"arguments":"/S","source":"manifest"},"successCodes":[],"type":"nullsoft","upgradeBehavior":"install","url":"https://github.com/dvalfrid/rigstats/releases/download/v1.39.0/RIGStats_1.39.0_x64-setup.exe"}],"licenseUrl":"https://github.com/dvalfrid/rigstats/blob/main/LICENSE","packageLocalizations":{"en-US":{"description":"Real-time hardware monitor for Windows gaming PCs","license":"MIT","licenseUrl":"https://github.com/dvalfrid/rigstats/blob/main/LICENSE","locale":"en-US","longDescription":"RIGStats is a free, open-source hardware monitor for Windows gaming PCs with a dedicated\nsecondary display. It shows CPU, GPU, RAM, network, disk, motherboard, and process data in\nreal time across portrait, landscape, and floating panel layouts.\n\nSensor data comes from LibreHardwareMonitor (kernel-level temps, clocks, power, fan speeds),\nthe sysinfo crate (CPU load, disk I/O, network throughput, processes), and WMI (GPU model,\nRAM spec, battery, system brand). That means per-core clocks, GPU hot-spot temperature, D3D\nengine workloads, DDR5 DIMM temperature, and NVMe temperature — not just OS counters.\n\nNo telemetry. No accounts. No cloud sync. MIT license.","moniker":"rigstats","name":"RIGStats","packageUrl":"https://rigstats.app","publisher":"codeby.se","publisherUrl":"https://rigstats.app","releaseNotesUrl":"https://github.com/dvalfrid/rigstats/releases/tag/v1.39.0","tags":["hardware","monitor","system-mon