{"defaultLocale":"en-US","id":"Codeby.RIGStats","installers":[{"architecture":"x64","dependencies":[{"PackageDependencies":[{"PackageIdentifier":"Microsoft.VCRedist.2015+.x64"}]}],"elevation":{"requirement":"elevationRequired","source":"inferred"},"id":"x64-machine-nullsoft","installModes":["interactive","silent"],"installerSwitches":{"Silent":"/S","SilentWithProgress":"/S"},"locale":"en-US","minimumOSVersion":"10.0.0.0","platforms":["Windows.Desktop"],"priority":1,"scope":"machine","sha256":"19e489f1149eb8f47227683f4a49fff8df9d34925164ef060a68d3071c1685ed","silent":{"arguments":"/S","source":"manifest"},"successCodes":[],"type":"nullsoft","upgradeBehavior":"install","url":"https://github.com/dvalfrid/rigstats/releases/download/v1.37.0/RIGStats_1.37.0_x64-setup.exe"}],"licenseUrl":"https://github.com/dvalfrid/rigstats/blob/main/LICENSE","packageLocalizations":{"en-US":{"description":"Real-time hardware monitor for Windows gaming PCs","license":"MIT","licenseUrl":"https://github.com/dvalfrid/rigstats/blob/main/LICENSE","locale":"en-US","longDescription":"RIGStats is a free, open-source hardware monitor for Windows gaming PCs with a dedicated\nsecondary display. It shows CPU, GPU, RAM, network, disk, motherboard, and process data in\nreal time across portrait, landscape, and floating panel layouts.\n\nSensor data comes from LibreHardwareMonitor (kernel-level temps, clocks, power, fan speeds),\nthe sysinfo crate (CPU load, disk I/O, network throughput, processes), and WMI (GPU model,\nRAM spec, battery, system brand). That means per-core clocks, GPU hot-spot temperature, D3D\nengine workloads, DDR5 DIMM temperature, and NVMe temperature — not just OS counters.\n\nNo telemetry. No accounts. No cloud sync. MIT license.","moniker":"rigstats","name":"RIGStats","packageUrl":"https://rigstats.app","publisher":"codeby.se","publisherUrl":"https://rigstats.app","releaseNotesUrl":"https://github.com/dvalfrid/rigstats/releases/tag/v1.37.0","tags":["hardware","monitor","system-monitor","gpu","cpu","temperature","gaming","dashboard","sensors"]}},"publisherUrl":"https://rigstats.app","releaseDate":"2026-08-22","releaseDateSource":"manifest","releaseNotesUrl":"https://github.com/dvalfrid/rigstats/releases/tag/v1.37.0","schemaVersion":1,"source":"winget","upstream":{"commit":"97d6aa2689f0a05f7847653a62b8624720d15b5d","manifestVersion":"1.12.0","manifests":[{"path":"manifests/c/Codeby/RIGStats/1.37.0/Codeby.RIGStats.yaml","sha256":"f8f5d94538125a5a14ecbaa42ff5a81b45eccf0176109a2db47e6544c0fe8b25"},{"path":"manifests/c/Codeby/RIGStats/1.37.0/Codeby.RIGStats.installer.yaml","sha256":"4ed5c10c65cb33a8ea199b40a1d2818aa48dacd4684fb2d825007b4c653daa79"},{"path":"manifests/c/Codeby/RIGStats/1.37.0/Codeby.RIGStats.locale.en-US.yaml","sha256":"6749359a5946cf7784efff84b7b20f9d1fde1e186d5d88dabfd473c34404ca34"}],"repository":"microsoft/winget-pkgs"},"version":"1.37.0"}