{"defaultLocale":"en-US","id":"Codeby.RIGStats","installers":[{"architecture":"x64","dependencies":[],"elevation":{"requirement":"elevationRequired","source":"inferred"},"id":"x64-machine-nullsoft","installModes":["interactive","silent"],"installerSwitches":{"Silent":"/S","SilentWithProgress":"/S"},"locale":"en-US","minimumOSVersion":"10.0.0.0","platforms":["Windows.Desktop"],"priority":1,"scope":"machine","sha256":"39dc1e41a1e924678bacdbab8d1bb4d4b42402afb4511c70edf0b95c83225ea1","silent":{"arguments":"/S","source":"manifest"},"successCodes":[],"type":"nullsoft","upgradeBehavior":"install","url":"https://github.com/dvalfrid/rigstats/releases/download/v1.35.2/RIGStats_1.35.2_x64-setup.exe"}],"licenseUrl":"https://github.com/dvalfrid/rigstats/blob/main/LICENSE","packageLocalizations":{"en-US":{"description":"Real-time hardware monitor for Windows gaming PCs","license":"MIT","licenseUrl":"https://github.com/dvalfrid/rigstats/blob/main/LICENSE","locale":"en-US","longDescription":"RIGStats is a free, open-source hardware monitor for Windows gaming PCs with a dedicated\nsecondary display. It shows CPU, GPU, RAM, network, disk, motherboard, and process data in\nreal time across portrait, landscape, and floating panel layouts.\n\nSensor data comes from LibreHardwareMonitor (kernel-level temps, clocks, power, fan speeds),\nthe sysinfo crate (CPU load, disk I/O, network throughput, processes), and WMI (GPU model,\nRAM spec, battery, system brand). That means per-core clocks, GPU hot-spot temperature, D3D\nengine workloads, DDR5 DIMM temperature, and NVMe temperature — not just OS counters.\n\nNo telemetry. No accounts. No cloud sync. MIT license.","moniker":"rigstats","name":"RIGStats","packageUrl":"https://rigstats.app","publisher":"Code By AB","publisherUrl":"https://rigstats.app","releaseNotesUrl":"https://github.com/dvalfrid/rigstats/releases/tag/v1.35.2","tags":["hardware","monitor","system-monitor","gpu","cpu","temperature","gaming","dashboard","sensors"]}},"publisherUrl":"https://rigstats.app","releaseDate":"2026-07-02","releaseDateSource":"manifest","releaseNotesUrl":"https://github.com/dvalfrid/rigstats/releases/tag/v1.35.2","schemaVersion":1,"source":"winget","upstream":{"commit":"97d6aa2689f0a05f7847653a62b8624720d15b5d","manifestVersion":"1.12.0","manifests":[{"path":"manifests/c/Codeby/RIGStats/1.35.2/Codeby.RIGStats.yaml","sha256":"a09c9aafdfae80a226b07ee58934ba845987ea9d96dc379edfc8255a46b720ed"},{"path":"manifests/c/Codeby/RIGStats/1.35.2/Codeby.RIGStats.installer.yaml","sha256":"48e74a4f0db8a298239c5e34391fd0dfd8350bb09e86598a3cd860a604e4f1dd"},{"path":"manifests/c/Codeby/RIGStats/1.35.2/Codeby.RIGStats.locale.en-US.yaml","sha256":"fea3b7a784adf2c46e99d78c8835cb18e276875fea993a185455e3c5f0e5ee34"}],"repository":"microsoft/winget-pkgs"},"version":"1.35.2"}