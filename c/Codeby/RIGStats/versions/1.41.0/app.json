{"defaultLocale":"en-US","id":"Codeby.RIGStats","installers":[{"architecture":"x64","dependencies":[{"PackageDependencies":[{"PackageIdentifier":"Microsoft.VCRedist.2015+.x64"}]}],"elevation":{"requirement":"elevationRequired","source":"inferred"},"id":"x64-machine-nullsoft","installModes":["interactive","silent"],"installerSwitches":{"Silent":"/S","SilentWithProgress":"/S"},"locale":"en-US","minimumOSVersion":"10.0.0.0","platforms":["Windows.Desktop"],"priority":1,"scope":"machine","sha256":"8bbcd7f34ba218a47dc66c2efdc4318de9cb90baf00ccc9a6dcee0287d854f6d","silent":{"arguments":"/S","source":"manifest"},"successCodes":[],"type":"nullsoft","upgradeBehavior":"install","url":"https://github.com/dvalfrid/rigstats/releases/download/v1.41.0/RIGStats_1.41.0_x64-setup.exe"}],"licenseUrl":"https://github.com/dvalfrid/rigstats/blob/main/LICENSE","packageLocalizations":{"en-US":{"description":"Real-time hardware monitor for Windows gaming PCs","license":"MIT","licenseUrl":"https://github.com/dvalfrid/rigstats/blob/main/LICENSE","locale":"en-US","longDescription":"RIGStats is a free, open-source hardware monitor for Windows gaming PCs with a dedicated\nsecondary display. It shows CPU, GPU, RAM, network, disk, motherboard, and process data in\nreal time across portrait, landscape, and floating panel layouts.\n\nSensor data comes from LibreHardwareMonitor (kernel-level temps, clocks, power, fan speeds),\nthe sysinfo crate (CPU load, disk I/O, network throughput, processes), and WMI (GPU model,\nRAM spec, battery, system brand). That means per-core clocks, GPU hot-spot temperature, D3D\nengine workloads, DDR5 DIMM temperature, and NVMe temperature — not just OS counters.\n\nNo telemetry. No accounts. No cloud sync. MIT license.","moniker":"rigstats","name":"RIGStats","packageUrl":"https://rigstats.app","publisher":"codeby.se","publisherUrl":"https://rigstats.app","releaseNotesUrl":"https://github.com/dvalfrid/rigstats/releases/tag/v1.41.0","tags":["hardware","monitor","system-monitor","gpu","cpu","temperature","gaming","dashboard","sensors"]}},"publisherUrl":"https://rigstats.app","releaseDate":"2026-09-29","releaseDateSource":"manifest","releaseNotesUrl":"https://github.com/dvalfrid/rigstats/releases/tag/v1.41.0","schemaVersion":1,"source":"winget","upstream":{"commit":"97d6aa2689f0a05f7847653a62b8624720d15b5d","manifestVersion":"1.12.0","manifests":[{"path":"manifests/c/Codeby/RIGStats/1.41.0/Codeby.RIGStats.yaml","sha256":"f6bed1db5fffae36dfbf641b94b6fdc16407eabb7cff9b742f225e09a1bf9161"},{"path":"manifests/c/Codeby/RIGStats/1.41.0/Codeby.RIGStats.installer.yaml","sha256":"9b4d79505231ec2b267bd549e7429d0963073a4e75cc88e60e6a483b133373e6"},{"path":"manifests/c/Codeby/RIGStats/1.41.0/Codeby.RIGStats.locale.en-US.yaml","sha256":"915306b0379f153540075b6782bccbbc6f0cc493057bd501ecd782f4f0f3fbe0"}],"repository":"microsoft/winget-pkgs"},"version":"1.41.0"}