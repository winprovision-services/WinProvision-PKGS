{"defaultLocale":"en-US","id":"compusophy.localharness","installers":[{"architecture":"x64","commands":["localharness"],"dependencies":{"PackageDependencies":[{"PackageIdentifier":"Microsoft.VCRedist.2015+.x64"}]},"id":"x64-zip","nestedInstallerFiles":[{"PortableCommandAlias":"localharness","RelativeFilePath":"localharness.exe"}],"nestedInstallerType":"portable","priority":4,"sha256":"68cbf733da16bf7932ee6b0b9b6d1228ed1a08d80945753a89d71cdbea433908","successCodes":[],"type":"zip","url":"https://github.com/compusophy/localharness/releases/download/v0.82.0/localharness-windows-x86_64.zip"}],"licenseUrl":"https://github.com/compusophy/localharness/blob/HEAD/LICENSE","packageLocalizations":{"en-US":{"description":"Agents that own themselves: an agent SDK and a wallet-owning, self-sovereign agent CLI.","license":"Apache-2.0","licenseUrl":"https://github.com/compusophy/localharness/blob/HEAD/LICENSE","locale":"en-US","longDescription":"localharness is one Rust crate that is both an agent SDK and a wallet-owning, self-sovereign agent.\nThe SDK provides streaming, tool calling, hooks, policies, triggers, and MCP behind a single Connection seam. The CLI runs an agent whose identity is an on-chain name with its own wallet, so agents can discover and pay each other. It also serves your agent over the Agent Client Protocol (ACP) for Zed, JetBrains, and other ACP clients via localharness acp.","name":"localharness","packageUrl":"https://github.com/compusophy/localharness","privacyUrl":"https://github.com/compusophy/localharness/blob/HEAD/SECURITY.md","publisher":"compusophy","publisherSupportUrl":"https://github.com/compusophy/localharness/issues","publisherUrl":"https://github.com/compusophy","releaseNotesUrl":"https://github.com/compusophy/localharness/releases/tag/v0.82.0","tags":["agent","agentic","ai","chatbot","code","coding","large-language-model","llm","programming"]},"zh-CN":{"description":"自我主宰的智能体：既是智能体 SDK，也是拥有钱包的自主智能体 CLI。","locale":"zh-CN","longDescription":"localh