eractive","silent","silentWithProgress"],"installerSwitches":{"InstallLocation":"APPDIR=\"<INSTALLPATH>\"","Log":"/log \"<LOGPATH>\"","Silent":"/exenoui /quiet /norestart","SilentWithProgress":"/exenoui /passive /norestart"},"nestedInstallerFiles":[{"RelativeFilePath":"ADPermissionsReporter.exe"}],"nestedInstallerType":"exe","priority":4,"scope":"machine","sha256":"cfe34edc8d523f19eac109f098b856aea7cbcb16ab32c9ffa996ff0f83ef163a","silent":{"arguments":"/exenoui /quiet /norestart","source":"manifest"},"successCodes":[],"type":"zip","uninstall":{"type":"productCode","value":"{B3CC750C-B11C-485C-B04B-9746E7C0CAFF}"},"url":"https://cjwdev-pub.s3.amazonaws.com/AdPermissionsReporter/ADPermissionsReporter.zip"}],"packageLocalizations":{"en-US":{"description":"Easily report on delegated permissions in your Active Directory domain structure","license":"Freeware","locale":"en-US","longDescription":"AD Permissions Reporter is a modern, intuitive program that makes it easy to report on security permissons on your Active Directory objects. It can be used to document all permissions in the domain, or you can use the powerful filtering capabilities to track down specific types of permissions that do not conform to your organisation's standards, or simply to see which AD objects a particular user has been granted access to.\n\nThe free edition is provided in the hope that it is useful to fellow IT Pros, it is not intended to just be a trial/demo of the standard edition (though you could use it as such if you are considering purchasing the standard edition). Whilst some features are only available in the standard edition, the free edition is still usefule. See below for a summary of the features that can be found in the free edition (and the standard edition)\n- Powerful - With options such as being able to view group members (and nested group and primary group members) directly within the report\n- Fast - Intelligent caching helps make this one of the fastest permissions reporting tools available\n- Accurate - Unlike some other tools, you will always get accurate representations of permissions with AD Permissions Reporter\n- User Friendly - Designed to be easy to use and modern, you can be running your first report within seconds of launching the application for the first time\n- Exportable - Easily export report results to file (CSV file or HTML file in free edition, additional formats in standard edition)\n- Multi-Domain Friendly - Correctly reports display names and other account details for accounts in external trusted domains","name":"AD Permissions Reporter","packageUrl":"https://cjwdev.com/Software/ADPermissionsReporter/Info.html","publisher":"Cjwdev","publisherUrl":"https://cjwdev.com/","tags":["active-directory","ad","permission"]},"zh-CN":{"description":"轻松报告您的 Active Directory 域结构中的委派权限","license":"免费软件","locale":"zh-CN","longDescription":"AD 权限报告器是一款现代化、直观的程序，可轻松报告 Active Directory 对象上的安全权限。它既可用于记录域中的所有权限，也能通过强大的筛选功能追踪不符合组织标准的特定权限类型，或直接查看特定用户被授予访问权限的 AD 对象。\n\n免费版旨在为 IT 专业人员提供实用工具，并非仅作为标准版的试用/演示版本（当然在考虑购买标准版时也可如此使用）。虽然部分功能仅限标准版，免费版仍具实用价值。以下是免费版（及标准版）功能概览：\n- 功能强大 - 支持直接在报告中查看组成员（包括嵌套组和主要组成员）\n- 运行迅捷 - 智能缓存技术使其成为当前最快的权限报告工具之一\n- 结果精准 - 与其他工具不同，AD 权限报告器始终提供精确的权限呈现\n- 用户友好 - 现代化设计即开即用，首次启动后数秒即可生成首份报告\n- 导出便捷 - 轻松将报告结果导出为文件（免费版支持 CSV/HTML 格式，标准版支持更多格式）\n- 多域兼容 - 准确显示外部信任域账户的显示名称及其他账户详情","tags":["active-directory","ad","权限"]}},"publisherUrl":"https://cjwdev.com/","schemaVersion":1,"source":"winget","upstream":{"commit":"97d6aa2689f0a05f7847653a62b8624720d15b5d","manifestVersion":"1.10.0","manifests":[{"path":"manifests/c/Cjwdev/ADPermissionsReporter/Free/1.1.0/Cjwdev.ADPermissionsReporter.Free.yaml","sha256":"cf8b8946b9b106e389e064b74b7b5d7e71e6e8d02315ced832914bc2f825ab15"},{"path":"manifests/c/Cjwdev/ADPermissionsReporter/Free/1.1.0/Cjwdev.ADPermissionsReporter.Free.installer.yaml","sha256":"093cfbe217b7dd92d500eb82367a948dc35c594a5747ccfa344d09372b718dad"},{"path":"manifests/c/Cjwdev/ADPermissionsReporter/Free/1.1.0/Cjwdev.ADPermissionsReporter.Free.locale.en-US.yaml","sha256":"55e81548666af55b5fcae90569924fdae1f9208adf4340daa9b88f0dc0eae10c"},{"path":"manifests/c/Cjwdev/ADPermissionsReporter/Free/1.1.0/Cjwdev.ADPermissionsReporter.Free.locale.zh-CN.yaml","sha256":"6f0058c577a513644af3aa6e46a1e8565980349f34af29f5f19e956ee274f309"}],"repository":"microsoft/winget-pkgs"},"version":"1.1.0"}