hes":{"InstallLocation":"APPDIR=\"<INSTALLPATH>\"","Log":"/log \"<LOGPATH>\"","Silent":"/exenoui /quiet /norestart","SilentWithProgress":"/exenoui /passive /norestart"},"nestedInstallerFiles":[{"RelativeFilePath":"FilePermissionsCheckInstaller.exe"}],"nestedInstallerType":"exe","priority":4,"scope":"machine","sha256":"9788673287fb4ad3a84f0946c2a78f47c03c45b1bd260f19e3912d61970a720d","silent":{"arguments":"/exenoui /quiet /norestart","source":"manifest"},"successCodes":[],"type":"zip","uninstall":{"type":"productCode","value":"{34CC4486-F744-4C02-A73F-0C37712CE749}"},"url":"https://cjwdev.com/Software/FilePermissions/FilePermissionsCheckInstaller.zip"}],"packageLocalizations":{"en-US":{"description":"Easily locate files that are not inheriting permissions from their parent folder or have additional explicit permissions. Export the results or optionally reset inheritance and remove explicit permissions.","license":"Freeware","locale":"en-US","longDescription":"File Permissions Check provides a simple and intuitive GUI that you can use to scan your file shares to discover files that are not compliant with the permissions you have placed on your folders. Once such files have been located by the program, you have the option to set them back to inheriting permissions and remove any explicit permissions on them\n\nFeatures\n- Easy to use, intuitive GUI\n- Scan multiple folders and optionally ignore system files/folders or files in sub folders more than a specified number of levels deep\n- Locate files that are not inheriting permissions or files that are inheriting but have additional explicit permissions, or both\n- Export results to CSV file or HTML file\n- Once files have been located, the program can reset inheritance and remove explicit permissions from any selected files","name":"File Permissions Check","packageUrl":"https://cjwdev.com/Software/FilePermissions/Info.html","publisher":"Cjwdev","publisherUrl":"https://cjwdev.com/","tags":["file","permission"]},"zh-CN":{"description":"轻松定位未从父文件夹继承权限或具有额外显式权限的文件。可导出结果，或选择重置继承并移除显式权限。","license":"免费软件","locale":"zh-CN","longDescription":"File Permissions Check 工具提供了一个简单直观的图形界面，可用于扫描文件共享，发现不符合文件夹权限设置的文件。当程序定位到这些文件后，您可以选择将其恢复为继承权限状态，并移除所有显式权限设置。\n\n功能特点\n- 操作简便的图形界面\n- 支持扫描多个文件夹，并可选择忽略系统文件/文件夹或指定层级深度之外的子文件夹文件\n- 可定位未继承权限的文件，或虽继承权限但存在额外显式权限的文件，或同时检测这两种情况\n- 支持将结果导出为 CSV 文件或 HTML 文件\n- 定位文件后，程序可重置继承权限并从选定文件中移除显式权限","tags":["文件","权限"]}},"publisherUrl":"https://cjwdev.com/","schemaVersion":1,"source":"winget","upstream":{"commit":"97d6aa2689f0a05f7847653a62b8624720d15b5d","manifestVersion":"1.10.0","manifests":[{"path":"manifests/c/Cjwdev/FilePermissionsCheck/1.0.0/Cjwdev.FilePermissionsCheck.yaml","sha256":"34fa8523cf24cf79416e44ad21d0f6b996d4ea68a334e3375852b50dba64fd55"},{"path":"manifests/c/Cjwdev/FilePermissionsCheck/1.0.0/Cjwdev.FilePermissionsCheck.installer.yaml","sha256":"a56d6586f9347890de5a2362274985c904bfbf46cd3371780f68d6ee67fb5baf"},{"path":"manifests/c/Cjwdev/FilePermissionsCheck/1.0.0/Cjwdev.FilePermissionsCheck.locale.en-US.yaml","sha256":"af292b2daaaff3dd63c7e9bf209f8877aac1541a18c60ee623591037483f07cc"},{"path":"manifests/c/Cjwdev/FilePermissionsCheck/1.0.0/Cjwdev.FilePermissionsCheck.locale.zh-CN.yaml","sha256":"c65a206f74ced1f5dd446c950e8a544e6a5bbd8d3b81b210854eb5c1eb82123c"}],"repository":"microsoft/winget-pkgs"},"version":"1.0.0"}