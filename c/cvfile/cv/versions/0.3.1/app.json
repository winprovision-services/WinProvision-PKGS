{"defaultLocale":"en-US","id":"cvfile.cv","installers":[{"architecture":"arm64","commands":["cv"],"dependencies":[],"fileExtensions":["cv"],"id":"arm64-user-zip","installModes":["interactive","silent","silentWithProgress"],"minimumOSVersion":"10.0.17763.0","nestedInstallerFiles":[{"PortableCommandAlias":"cv","RelativeFilePath":"cv.exe"}],"nestedInstallerType":"portable","priority":4,"scope":"user","sha256":"98f9600a9fddd287fcd28de5548d0b62eec15af813e3f04e3310daa52f5c3a57","successCodes":[],"type":"zip","url":"https://github.com/cvfile/cv/releases/download/v0.3.1/cv_0.3.1_windows_arm64.zip"},{"architecture":"x64","commands":["cv"],"dependencies":[],"fileExtensions":["cv"],"id":"x64-user-zip","installModes":["interactive","silent","silentWithProgress"],"minimumOSVersion":"10.0.17763.0","nestedInstallerFiles":[{"PortableCommandAlias":"cv","RelativeFilePath":"cv.exe"}],"nestedInstallerType":"portable","priority":4,"scope":"user","sha256":"7458f4076f2ff642fa82aa19541faf82462807151b1281cdec0c9d9a54458d39","successCodes":[],"type":"zip","url":"https://github.com/cvfile/cv/releases/download/v0.3.1/cv_0.3.1_windows_x86_64.zip"}],"licenseUrl":"https://github.com/cvfile/cv/blob/main/LICENSE","packageLocalizations":{"en-US":{"description":"CLI for the .cv open file format. Extract, inspect, validate, and semantic search across resume files.","license":"Apache-2.0","licenseUrl":"https://github.com/cvfile/cv/blob/main/LICENSE","locale":"en-US","longDescription":"The cv command line interface reads and writes files in the .cv open file\nformat. A .cv file is a valid PDF/A-3u document that also carries a clean\nMarkdown copy, an optional HTML copy, and pre computed BGE M3 semantic\nvectors as PDF Associated Files. One file opens visually in any PDF\nreader, parses cleanly in any applicant tracking system, embeds on any\nwebpage, and answers semantic queries from any retrieval pipeline.\n\nThe CLI ships the full reader and writer paths: pack a PDF plus text\nrepresentations into a .cv, extract a payload, inspect XMP metadata,\nvalidate against the cv 1.0 specification, and run semantic search over\nthe embedded vectors using the Hugging Face Inference API.\n\nThe full specification, the JavaScript and Python SDKs, the web\ncomponent, and the LangChain and LlamaIndex integrations live at\nhttps://github.com/cvfile/cv.","moniker":"cv","name":"cv","packageUrl":"https://cvfile.org","publisher":"cvfile.org","publisherUrl":"https://cvfile.org","releaseNotesUrl":"https://github.com/cvfile/cv/releases/tag/v0.3.1","tags":["cv","cvfile","resume","cli","pdf","pdfa","ats","embeddings","semantic","search","rag","ai"]}},"publisherUrl":"https://cvfile.org","releaseDate":"2026-07-02","releaseDateSource":"manifest","releaseNotesUrl":"https://github.com/cvfile/cv/releases/tag/v0.3.1","schemaVersion":1,"source":"winget","upstream":{"commit":"97d6aa2689f0a05f7847653a62b8624720d15b5d","manifestVersion":"1.6.0","manifests":[{"path":"manifests/c/cvfile/cv/0.3.1/cvfile.cv.yaml","sha256":"b2a68c057f431752549158594477844d0854f84726f66c7826c4695c31ae5af6"},{"path":"manifests/c/cvfile/cv/0.3.1/cvfile.cv.installer.yaml","sha256":"17acc1c49d845a0427fb190bd8c92de95fa7538fbacd47693c00ce3d9cb5b6ad"},{"path":"manifests/c/cvfile/cv/0.3.1/cvfile.cv.locale.en-US.yaml","sha256":"a549ec09b367bfab534bfb5a1807e8518e347db29b4637620527a2c43a4c6d1f"}],"repository":"microsoft/winget-pkgs"},"version":"0.3.1"}