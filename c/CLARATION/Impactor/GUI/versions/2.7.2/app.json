cur :)\nWhat's Changed\n- Fixed some issues with logins with help from @LukeZGD in #303\n\nNew Contributors\n- @LukeZGD made their first contribution in #303","releaseNotesUrl":"https://github.com/claration/impactor/releases/tag/v2.7.2","tags":["altstore","ios","ipa","ipados","livecontainer","sideload","sideloader","sideloading","sideloadly","sidestore","signature","signer","signing"]}},"publisherSupportUrl":"https://github.com/CLARATION/Impactor/issues","publisherUrl":"https://github.com/CLARATION","releaseDate":"2026-11-07","releaseDateSource":"commit","releaseNotesUrl":"https://github.com/claration/impactor/releases/tag/v2.7.2","schemaVersion":1,"source":"winget","upstream":{"commit":"744664bad9c815e008fd4699b4c420d0afcd488f","manifestVersion":"1.28.0","manifests":[{"path":"manifests/c/CLARATION/Impactor/GUI/2.7.2/CLARATION.Impactor.GUI.installer.yaml","sha256":"a51c8c64c798fb1779d2e859878de9013016e2d67c90779ff88637d0ce2de874"},{"path":"manifests/c/CLARATION/Impactor/GUI/2.7.2/CLARATION.Impactor.GUI.locale.en-US.yaml","sha256":"1e5be774869d42f00fe645f4f361ca609d58dee964756ca38be850bce9fb2f0e"},{"path":"manifests/c/CLARATION/Impactor/GUI/2.7.2/CLARATION.Impactor.GUI.yaml","sha256":"132b7a45d10c28b9953149c392dfa1a35c6857af04e9c92212db63b457b31376"}],"repository":"microsoft/winget-pkgs"},"version":"2.7.2"}