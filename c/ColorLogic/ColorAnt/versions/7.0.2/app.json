{"defaultLocale":"en-US","id":"ColorLogic.ColorAnt","installers":[{"appsAndFeaturesEntries":[{"ProductCode":"{C246A7FC-AAA8-4403-98D8-9A7967D130B6}_is1","Publisher":"ColorLogic GmbH"}],"architecture":"x64","dependencies":[],"elevation":{"requirement":"elevatesSelf","source":"manifest"},"fileExtensions":["aco","ase","csc","cxf","icc","txt","xml"],"id":"x64-machine-zip","installModes":["interactive","silent","silentWithProgress"],"locale":"en-US","nestedInstallerFiles":[{"RelativeFilePath":"ColorAntSetup.exe"}],"nestedInstallerType":"inno","priority":4,"scope":"machine","sha256":"bbf60674791e21e8524fd4e762126c5ba54630edb5993bb1bc9707073d4a4997","successCodes":[],"type":"zip","uninstall":{"type":"productCode","value":"{C246A7FC-AAA8-4403-98D8-9A7967D130B6}_is1"},"upgradeBehavior":"install","url":"https://colorlogic.de/Seiten/Download/ColorAnt-7.0.2-win.zip"}],"licenseUrl":"https://hybridsoftware.com/wp-content/uploads/software-license-agreement.pdf","packageLocalizations":{"en-US":{"description":"ColorAnt is an easy-to-use tool that measures test charts, corrects, and optimizes measurement data.","license":"Proprietary","licenseUrl":"https://hybridsoftware.com/wp-content/uploads/software-license-agreement.pdf","locale":"en-US","longDescription":"ColorAnt is a professional color data certification and profiling tool used in prepress and printing to analyze, optimize, and correct ICC profiles, measurement data, and color workflows for ISO-compliant results.\n\nKey Features:\n- Data Certification: Validates color data against ISO 12647/15339 standards.\n- Profile Optimization: Corrects gradients, smooths gamut mappings, and fixes profile errors.\n- Device Linking: Creates accurate device link profiles for complex print workflows.\n- Measurement Tools: Analyzes lab/Lch values, ΔE differences, and gamut volumes.\n- Hardware Integration: Works with major spectrophotometers (X-Rite, Barbieri, etc.).\n- Automation: Scriptable for batch processing and integration (e.g., with Ze