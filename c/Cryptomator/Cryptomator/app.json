{"architectures":["x64"],"id":"Cryptomator.Cryptomator","latestVersion":"1.19.6","media":{"icons":[],"screenshots":[]},"package":{"description":"Encryption made easy and optimized for the cloud","license":"GPL-3.0","licenseUrl":"https://github.com/cryptomator/cryptomator/blob/HEAD/LICENSE.txt","locale":"en-US","localizations":{"en-US":{"description":"Encryption made easy and optimized for the cloud","license":"GPL-3.0","licenseUrl":"https://github.com/cryptomator/cryptomator/blob/HEAD/LICENSE.txt","locale":"en-US","longDescription":"Cryptomator provides easy-to-use, transparent, client-side encryption for your cloud.\nIt protects your documents from unauthorized access and prying eyes, while you will still be able to view and edit your documents locally.\nBy not requiring any registration or account and performing all encryption locally, it gives you back control over your data and ensures your privacy.\nCryptomator is offered for all major platforms (including Android and iOS).\n\nCryptomator encrypts file contents and names using the widespread industry standard AES.\nYour passphrase is protected against brute forcing attempts using scrypt.\nAdditionally, directory structures get obfuscated.\nFor more info about the Cryptomator encryption scheme, check out the online documentation.\n\nCryptomator is a free and open-source software licensed under the GPLv3.\nThis allows anyone to check our code.\nThus, it is impossible to introduce backdoors for third parties or to hide vulnerabilities, so you do not need to trust Cryptomator.\nAlso, vendor lock-ins are impossible.\nEven if we decided to stop development: The source code is already cloned by hundreds of other developers and development can be picked up by others.\n\nCryptomator is provided free of charge as an open-source project despite the high development effort and is therefore dependent on support by the community.\nVisit https://cryptomator.org/ to read how you can support us!","moniker":"cryptomator","name":"Cryptomator","packageUrl":"https://cryptomator.org/","publisher":"Skymatic GmbH","publisherUrl":"https://cryptomator.org/","releaseNotesUrl":"https://github.com/cryptomator/cryptomator/releases/tag/1.19.6","tags":["cloud-storage","crypto","cryptography","cryptomator","privacy","security"]}},"longDescription":"Cryptomator provides easy-to-use, transparent, client-side encryption for your cloud.\nIt protects your documents from unauthorized access and prying eyes, while you will still be able to view and edit your documents locally.\nBy not requiring any registration or account and performing all encryption locally, it gives you back control over your data and ensures your privacy.\nCryptomator is offered for all major platforms (including Android and iOS).\n\nCryptomator encrypts file contents and names using the widespread industry standard AES.\nYour passphrase is protected against brute forcing attempts using scrypt.\nAdditionally, directory structures get obfuscated.\nFor more info about the Cryptomator encryption scheme, check out the online documentation.\n\nCryptomator is a free and open-source software licensed under the GPLv3.\nThis allows anyone to check our code.\nThus, it is impossible to introduce backdoors for third parties or to hide vulnerabilities, so you do not need to trust Cryptomator.\nAlso, vendor lock-ins are impossible.\nEven if we decided to stop development: The source code is already cloned by hundreds of other developers and development can be picked up by others.\n\nCryptomator is provided free of charge as an open-source project despite the high development effort and is therefore dependent on support by the community.\nVisit https://cryptomator.org/ to read how you can support us!","moniker":"cryptomator","name":"Cryptomator","packageUrl":"https://cryptomator.org/","publisher":"Skymatic GmbH","publisherUrl":"https://cryptomator.org/","releaseNotesUrl":"https://github.com/cryptomator/cryptomator/releases/tag/1.19.6","tags":["cloud-storage","crypto","cryptography","cryptomator","privacy","security"]},"schemaVersion":1,"source":"winget","versions":[{"architectures":["x64"],"detailPath":"versions/1.19.6/app.json","detailSha256":"fc56f5fc07b55968b76d9be85a0e14a810d756c556983c546493482330d2216e","releaseDate":"2026-10-30","releaseDateSource":"manifest","version":"1.19.6"},{"architectures":["x64"],"detailPath":"versions/1.19.5/app.json","detailSha256":"aa836e898470c756e223b78f9f200baa1ba44d24af65cb92f21ae6e741302b22","releaseDate":"2026-10-28","releaseDateSource":"manifest","version":"1.19.5"},{"architectures":["x64"],"detailPath":"versions/1.19.4/app.json","detailSha256":"d0a4a05f5f892b5f1fd4c2a5a6e4e223fa2f5db3c99737486ab31e6e7b7c3f9f","releaseDate":"2026-10-21","releaseDateSource":"manifest","version":"1.19.4"},{"architectures":["x64"],"detailPath":"versions/1.19.3/app.json","detailSha256":"80da03bc7e236a10b8010e2d0268dd1073346c1be4f5f60baead65d0b297d53d","releaseDate":"2026-06-29","releaseDateSource":"manifest","version":"1.19.3"},{"architectures":["x64"],"detailPath":"versions/1.19.2/app.json","detailSha256":"e8262aba9d50a4c8f72ecb1be51e58054ba914c1db7c893f6413a03774286577","releaseDate":"2026-03-20","releaseDateSource":"manifest","version":"1.19.2"},{"architectures":["x64"],"detailPath":"versions/1.19.1/app.json","detailSha256":"30bc196291fa34a5be805ffbe42bfa8fe78e730d17c222dcba294e0eb5819f34","releaseDate":"2026-03-12","releaseDateSource":"manifest","version":"1.19.1"},{"architectures":["x64"],"detailPath":"versions/1.19.0/app.json","detailSha256":"239507d87c66abcc1a93b66f69bde3426c125dbbda177c768e2a58288388c1fd","releaseDate":"2026-03-09","releaseDateSource":"manifest","version":"1.19.0"},{"architectures":["x64"],"detailPath":"versions/1.18.1/app.json","detailSha256":"c6aa12c799e86901d3ce55ccb947d7603bdfb410986a581e80d7fb33b75254c7","releaseDate":"2026-02-26","releaseDateSource":"manifest","version":"1.18.1"},{"architectures":["x64"],"detailPath":"versions/1.18.0/app.json","detailSha256":"994d1a