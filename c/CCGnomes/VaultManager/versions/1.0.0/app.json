{"defaultLocale":"en-US","id":"CCGnomes.VaultManager","installers":[{"appsAndFeaturesEntries":[{"DisplayName":"Vault Manager","InstallerType":"nullsoft","ProductCode":"Vault Manager","Publisher":"ccgnomes"}],"architecture":"x64","dependencies":[],"id":"x64-user-nullsoft","installModes":["interactive","silent","silentWithProgress"],"minimumOSVersion":"10.0.17763.0","platforms":["Windows.Desktop"],"priority":1,"protocols":["vaultflasher"],"scope":"user","sha256":"0844dc2e7d5bee544d8da6098234878885d1faab1f393ec6334c15b74abe9fb9","silent":{"arguments":"/S","source":"default"},"successCodes":[],"type":"nullsoft","upgradeBehavior":"install","url":"https://github.com/markCCGnomes/vault-flasher-releases/releases/download/v1.0.0/VaultManager-x64-setup.exe"}],"licenseUrl":"https://github.com/markCCGnomes/vault-flasher-releases/blob/main/LICENSE","packageLocalizations":{"en-US":{"description":"Flash a Vault Node USB stick, then set the node up and manage it","license":"Vault Ecosystem License v1.1","licenseUrl":"https://github.com/markCCGnomes/vault-flasher-releases/blob/main/LICENSE","locale":"en-US","longDescription":"Vault Manager flashes the official Vault Node image to a USB drive, then sets the node up and looks after it. It downloads the image, verifies its SHA-256 against the release's published digest, and writes it to a removable USB drive with a single click — with a read-back verification pass and optional WiFi presetting. It only ever offers removable USB drives (never an internal or system disk) and re-validates the target inside its elevated writer.\nIt can also set a node up on a Synology NAS through Container Manager, either automatically with your DSM login or with a click-by-click guide.\nThe same app then claims the node, hosts apps on it, pairs a website, manages storage and devices, and reads its health.","moniker":"vault-manager","name":"Vault Manager","packageUrl":"https://github.com/markCCGnomes/vault-flasher-releases","publisher":"CCGnomes","publisher