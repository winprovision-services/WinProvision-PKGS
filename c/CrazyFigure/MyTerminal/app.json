{"architectures":["x64"],"id":"CrazyFigure.MyTerminal","latestVersion":"1.0.5","media":{"icons":[{"mimeType":"image/png","path":"media/icon.91cfc923.png","priority":1,"sha256":"91cfc923c1e993849d154ce82dfbaf700da2aab690e1e54a65a04467d9fa65c8","source":"winget-legacy"}],"screenshots":[]},"package":{"copyright":"Copyright (c) 2026 CrazyFigure","description":"一个基于 Rust、Tauri 2 和 React 构建的现代桌面 SSH 终端管理工具。","license":"MIT","licenseUrl":"https://github.com/CrazyFigure/MyTerminal/blob/HEAD/LICENSE","locale":"zh-CN","localizations":{"en-US":{"description":"A modern desktop SSH terminal manager built with Rust, Tauri 2, and React.","locale":"en-US","longDescription":"A modern desktop SSH terminal manager built with Rust, Tauri 2, and React.\nMyTerminal brings terminal tabs, SSH profiles with jump hosts and proxies, SFTP file management, remote file editing, local port forwarding, and WebDAV backup into one clean desktop app. It is designed for developers and operators who want a lightweight, open, and hackable alternative to heavyweight remote terminal suites.","tags":["console","download","file","remote","server","sftp","shell","ssh","terminal","transfer","upload"]},"zh-CN":{"copyright":"Copyright (c) 2026 CrazyFigure","description":"一个基于 Rust、Tauri 2 和 React 构建的现代桌面 SSH 终端管理工具。","license":"MIT","licenseUrl":"https://github.com/CrazyFigure/MyTerminal/blob/HEAD/LICENSE","locale":"zh-CN","longDescription":"一个基于 Rust、Tauri 2 和 React 构建的现代桌面 SSH 终端管理工具。\nMyTerminal 把终端标签页、支持跳板机与代理的 SSH 连接管理、SFTP 文件管理、远程文件编辑、本地端口转发和 WebDAV 备份放到一个清爽的桌面应用里。它面向开发者和运维场景，希望提供一个轻量、开放、可折腾的远程终端工具。","name":"MyTerminal","packageUrl":"https://github.com/CrazyFigure/MyTerminal","publisher":"myterminal","publisherSupportUrl":"https://github.com/CrazyFigure/MyTerminal/issues","publisherUrl":"https://github.com/CrazyFigure","releaseNotes":"新增：\n- 本次暂无新增项。\n修复：\n- 🧭 右侧栏开关移至标题栏右上角，位置更直观、更易找到\n优化：\n- 🎨 界面整体去掉灰色填充，更清爽统一：终端区默认底色与左右侧栏一致，标签栏、文件面板、各类弹窗分区、按钮与列表行改为透明底、仅以边框区分，悬停与选中反馈保持不变；深色模式下边框加深一档，层次更清晰","releaseNotesUrl":"https://github.com/CrazyFigure/MyTerminal/releases/tag/v1.0.5","tags":["sftp","shell","ssh","上传","下载","传输","控制台","文件","服务器","终端","远程"]}},"longDescription":"一个基于 Rust、Tauri 2 和 React 构建的现代桌面 SSH 终端管理工具。\nMyTerminal 把终端标签页、支持跳板机与代理的 SSH 连接管理、SFTP 文件管理、远程文件编辑、本地端口转发和 WebDAV 备份放到一个清爽的桌面应用里。它面向开发者和运维场景，希望提供一个轻量、开放、可折腾的远程终端工具。","name":"MyTerminal","packageUrl":"https://github.com/CrazyFigure/MyTerminal","publisher":"myterminal","publisherSupportUrl":"https://github.com/CrazyFigure/MyTerminal/issues","publisherUrl":"https://github.com/CrazyFigure","releaseNotes":"新增：\n- 本次暂无新增项。\n修复：\n- 🧭 右侧栏开关移至标题栏右上角，位置更直观、更易找到\n优化：\n- 🎨 界面整体去掉灰色填充，更清爽统一：终端区默认底色与左右侧栏一致，标签栏、文件面板、各类弹窗分区、按钮与列表行改为透明底、仅以边框区分，悬停与选中反馈保持不变；深色模式下边框加深一档，层次更清晰","releaseNotesUrl":"https://github.com/CrazyFigure/MyTerminal/releases/tag/v1.0.5","tags":["sftp","shell","ssh","上传","下载","传输","控制台","文件","服务器","终端","远程"]},"schemaVersion":1,"source":"winget","versions":[{"architectures":["x64"],"detailPath":"versions/1.0.5/app.json","detailSha256":"ee84b05e66ad564d2c33cde3cdada0e2a2fed8220cdcd9b2b1efa36eba1cab66","releaseDate":"2026-11-12","releaseDateSource":"commit","version":"1.0.5"},{"architectures":["x64"],"detailPath":"versions/1.0.4/app.json","detailSha256":"08fee47cce261eeefaa38943f9097d7426fd1d4e0ba490fca38fd2eb17616f39","releaseDate":"2026-11-11","releaseDateSource":"commit","version":"1.0.4"},{"architectures":["x64"],"detailPath":"versions/1.0.3/app.json","detailSha256":"978b30ce8d1d431c717ed35edad045d890445c5ef550b43fe123fa88fad80821","releaseDate":"2026-11-09","releaseDateSource":"commit","version":"1.0.3"},{"architectures":["x64"],"detailPath":"versions/1.0.2/app.json","detailSha256":"9389abc3b533db76844b573093886a0ca9253845e7a6cd3ac019cedc31da1105","releaseDate":"2026-11-06","releaseDateSource":"commit","version":"1.0.2"},{"architectures":["x64"],"detailPath":"versions/1.0.1/app.json","detailSha256":"bf929cabc8c9e1810a4730c03d7eb213502f584262b1e843cf43decd2ebde138","releaseDate":"2026-11-05","releaseDateS