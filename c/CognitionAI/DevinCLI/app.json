{"architectures":["arm64","x64"],"id":"CognitionAI.DevinCLI","latestVersion":"3000.12.43","media":{"icons":[],"screenshots":[]},"package":{"author":"Cognition AI, Inc.","description":"A fast and minimal agent that lives both in your terminal and in the cloud.","documentations":[{"DocumentLabel":"Docs","DocumentUrl":"https://cli.devin.ai/docs"}],"license":"Proprietary","licenseUrl":"https://cognition.ai/terms-of-service","locale":"en-US","localizations":{"en-US":{"author":"Cognition AI, Inc.","description":"A fast and minimal agent that lives both in your terminal and in the cloud.","documentations":[{"DocumentLabel":"Docs","DocumentUrl":"https://cli.devin.ai/docs"}],"license":"Proprietary","licenseUrl":"https://cognition.ai/terms-of-service","locale":"en-US","name":"Devin CLI","packageUrl":"https://cli.devin.ai/docs","privacyUrl":"https://cognition.ai/privacy-policy","publisher":"Cognition AI, Inc.","purchaseUrl":"https://devin.ai/pricing","releaseNotes":"Added\n- Image reads take an image_size. The default sends 70% of the original’s longest side, at least 1024 px, and images sent to GPT and Gemini models use those models’ own size limits.\n\nChanged\n- When a response stops at the output limit before a tool call, the CLI continues the turn instead of ending it. --continue-on-output-truncation=false restores the old behavior.\n- GPT models keep working instead of stopping to ask for input they can work out, and add fewer low-value tests.","releaseNotesUrl":"https://cli.devin.ai/docs/changelog/stable","tags":["agent","agentic","ai","chatbot","code","coding","large-language-model","llm"]},"zh-CN":{"description":"一款快速且极简的智能体，既可在终端本地运行，也可在云端部署。","documentations":[{"DocumentLabel":"文档","DocumentUrl":"https://cli.devin.ai/docs"}],"license":"专有软件","locale":"zh-CN","tags":["人工智能","代码","大语言模型","智能体","编程","聊天机器人","自主智能"]}},"name":"Devin CLI","packageUrl":"https://cli.devin.ai/docs","privacyUrl":"https://cognition.ai/privacy-policy","publisher":"Cognition AI, Inc.","purchaseU