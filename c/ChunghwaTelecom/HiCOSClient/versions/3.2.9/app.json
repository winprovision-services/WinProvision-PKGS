{"defaultLocale":"zh-TW","id":"ChunghwaTelecom.HiCOSClient","installers":[{"architecture":"x86","dependencies":[],"id":"x86-zip","nestedInstallerFiles":[{"RelativeFilePath":"HiCOS_Client.exe"}],"nestedInstallerType":"burn","priority":4,"sha256":"abfbf692af32300d6e4f130a265fa9a89ce5ed62ad5a9ee82f2ff64b3064797b","successCodes":[],"type":"zip","url":"https://api-hisecurecdn.cdn.hinet.net/HiCOS_Client.zip"}],"licenseUrl":"https://moica.nat.gov.tw/copyright.html","packageLocalizations":{"zh-TW":{"description":"HiCOS 卡片管理工具是一種 CSP(Cryptography Service Provider)，係提供 IC 卡之憑證註冊至作業系統的工具，以利安全電子郵件或憑證應用應用系統使用密碼學之簽章或加密等功能。","license":"Proprietary","licenseUrl":"https://moica.nat.gov.tw/copyright.html","locale":"zh-TW","longDescription":"1.HiCOS卡片管理工具是一種CSP(Cryptography Service Provider)，係提供IC卡之憑證註冊至作業系統的工具，以利安全電子郵件或憑證應用應用系統使用密碼學之簽章或加密等功能，下載安裝後除HiCOS卡片管理工具外，並包含用戶端環境檢測工具與相關使用手冊。2.用戶端環境檢測工具，可協助檢查用戶IC卡與讀卡機驅動程式是否安裝成功，IC卡能否讀取，並提供PIN碼驗證，簽章驗章與加解密功能檢測。","moniker":"hicos","name":"HiCOS Client","packageUrl":"https://moica.nat.gov.tw/download_1.html","publisher":"Chunghwa Telecom Corp., Ltd.","publisherUrl":"https://moica.nat.gov.tw/","tags":[]}},"publisherUrl":"https://moica.nat.gov.tw/","schemaVersion":1,"source":"winget","upstream":{"commit":"97d6aa2689f0a05f7847653a62b8624720d15b5d","manifestVersion":"1.12.0","manifests":[{"path":"manifests/c/ChunghwaTelecom/HiCOSClient/3.2.9/ChunghwaTelecom.HiCOSClient.yaml","sha256":"bda8ca7178635e8aaf99e0f216995f595b9b8ca2f515666fceac5a5e5be2f8ce"},{"path":"manifests/c/ChunghwaTelecom/HiCOSClient/3.2.9/ChunghwaTelecom.HiCOSClient.installer.yaml","sha256":"913641f8421f0afd87a86cd1e309986c28b5caec98c6f04a2288775b6eaf70b1"},{"path":"manifests/c/ChunghwaTelecom/HiCOSClient/3.2.9/ChunghwaTelecom.HiCOSClient.locale.zh-TW.yaml","sha256":"d13db547b50666adb6edb92d723d8817dbd5bef0bf4bae499f34a094607566b4"}],"repository":"microsoft/winget-pkgs"},"version":"3.2.9"}