{"defaultLocale":"en-US","id":"InterceptSuite.ProxyBridge","installers":[{"appsAndFeaturesEntries":[{"DisplayName":"ProxyBridge 4.2.0","DisplayVersion":"4.2.0","ProductCode":"ProxyBridge"}],"architecture":"x64","dependencies":[],"elevation":{"requirement":"elevationRequired","source":"inferred"},"id":"x64-machine-nullsoft","locale":"en-US","priority":1,"scope":"machine","sha256":"d5c15de7d8f0daae785580d48e5787eadf060facf069dac722802dff3ffa2904","silent":{"arguments":"/S","source":"default"},"successCodes":[],"type":"nullsoft","uninstall":{"type":"productCode","value":"ProxyBridge"},"upgradeBehavior":"install","url":"https://github.com/InterceptSuite/ProxyBridge/releases/download/v4.2.0_Windows/ProxyBridge-Setup-4.2.0.exe"}],"licenseUrl":"https://github.com/InterceptSuite/ProxyBridge/blob/HEAD/LICENSE","packageLocalizations":{"en-US":{"description":"Redirect any Windows/MacOS TCP and UDP traffic to HTTP/Socks5 proxy","license":"MIT","licenseUrl":"https://github.com/InterceptSuite/ProxyBridge/blob/HEAD/LICENSE","locale":"en-US","longDescription":"ProxyBridge is a lightweight, open-source universal proxy client (Proxifier alternative) that provides transparent proxy routing for applications on Windows and macOS. It redirects TCP and UDP traffic from specific processes through SOCKS5 or HTTP proxies, with the ability to route, block, or allow traffic on a per-application basis. ProxyBridge fully supports both TCP and UDP proxy routing and works at the system level, making it compatible with proxy-unaware applications without requiring any configuration changes.","name":"ProxyBridge","packageUrl":"https://github.com/InterceptSuite/ProxyBridge","publisher":"InterceptSuite","publisherUrl":"https://interceptsuite.com/","releaseNotesUrl":"https://github.com/InterceptSuite/ProxyBridge/releases/tag/v4.2.0_Windows","tags":["network","proxy","request","response","traffic","web"]},"zh-CN":{"description":"将任何 Windows/MacOS 的 TCP 和 UDP 流量重定向到 HTTP/Socks5 代理","locale":"zh-CN","longDescription":"ProxyBridge 是一款轻量级、开源的通用代理客户端（Proxifier 替代方案），可为 Windows 和 macOS 上的应用程序提供透明代理路由。它能将特定进程的 TCP 和 UDP 流量通过 SOCKS5 或 HTTP 代理进行重定向，并支持按应用程序进行流量路由、阻止或允许。ProxyBridge 完全支持 TCP 和 UDP 代理路由，并在系统级别运行，因此无需任何配置更改即可兼容不支持代理的应用程序。","tags":["代理","响应","流量","网络","网页","请求"]}},"publisherUrl":"https://interceptsuite.com/","releaseDate":"2026-10-17","releaseDateSource":"manifest","releaseNotesUrl":"https://github.com/InterceptSuite/ProxyBridge/releases/tag/v4.2.0_Windows","schemaVersion":1,"source":"winget","upstream":{"commit":"97d6aa2689f0a05f7847653a62b8624720d15b5d","manifestVersion":"1.12.0","manifests":[{"path":"manifests/i/InterceptSuite/ProxyBridge/4.2.0/InterceptSuite.ProxyBridge.yaml","sha256":"2616d1c654f8a61d31962881d8fab80ed9c845b405a946eb97a25675050e30ed"},{"path":"manifests/i/InterceptSuite/ProxyBridge/4.2.0/InterceptSuite.ProxyBridge.installer.yaml","sha256":"5805d30a441f6aad784425e8377affc306c78efb82ca9f94cd8836de512beb30"},{"path":"manifests/i/InterceptSuite/ProxyBridge/4.2.0/InterceptSuite.ProxyBridge.locale.en-US.yaml","sha256":"f96ee3f9750a4ddf74fcc86728ea2b5b441a6103f748e68a55c109f02e16cc20"},{"path":"manifests/i/InterceptSuite/ProxyBridge/4.2.0/InterceptSuite.ProxyBridge.locale.zh-CN.yaml","sha256":"3b0b165ff92b2305bb628053a362695df5f47ccd227b30cac81fcda29bcbcf98"}],"repository":"microsoft/winget-pkgs"},"version":"4.2.0"}