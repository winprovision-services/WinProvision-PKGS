nstallerReturnCode":7,"ReturnResponse":"custom"},{"InstallerReturnCode":8,"ReturnResponse":"systemNotSupported"},{"InstallerReturnCode":3010,"ReturnResponse":"rebootRequiredToFinish"}],"id":"x64-user-exe","installModes":["interactive","silent","silentWithProgress"],"installerSwitches":{"InstallLocation":"--install-root \"<INSTALLPATH>\"","Log":"--log \"<LOGPATH>\"","Silent":"install --quiet --scope user","SilentWithProgress":"install --quiet --scope user"},"locale":"en-US","minimumOSVersion":"10.0.17763.0","platforms":["Windows.Desktop"],"priority":1,"scope":"user","sha256":"b1e5cc6ce1aaa17d09908c585547b674f685c251db1dc945ae8ab4e7e78691f7","silent":{"arguments":"install --quiet --scope user","source":"manifest"},"successCodes":[],"type":"exe","uninstall":{"type":"productCode","value":"ItTiger.TigerSetup"},"upgradeBehavior":"install","url":"https://github.com/rkozlowski/TigerSetup/releases/download/v0.15.0/TigerSetup-0.15.0-Setup.exe"}],"licenseUrl":"https://github.com/rkozlowski/TigerSetup/releases/download/v0.15.0/LICENSE.txt","packageLocalizations":{"en-US":{"description":"Command-line tool that builds small, self-contained Windows installers (Setup.exe).","license":"MIT","licenseUrl":"https://github.com/rkozlowski/TigerSetup/releases/download/v0.15.0/LICENSE.txt","locale":"en-US","longDescription":"TigerSetup is a command-line tool that builds Windows installers. Describe your\napplication in a TigerSetup.toml file, and tiger-setup build produces one\nself-contained Setup.exe with a wizard, a quiet mode for automation, upgrade,\nrepair and uninstall, and no runtime prerequisites on the target machine.\n\nAfter installing, open Start > TigerSetup > TigerSetup Shell: a command prompt\nwith tiger-setup ready to use, which opens on a short getting-started summary.\nStart > TigerSetup > TigerSetup Help opens the getting-started guide (PDF).\n\nFirst commands: tiger-setup build TigerSetup.toml, then tiger-setup inspect and\ntiger-setup verify on the Setup.exe it built.\n\nTigerSetup installs for the current user by default and adds tiger-setup to\nthat user's PATH; the PATH entry is optional. Installing for all users asks for\nadministrator approval. Uninstalling removes everything the installation added,\nexcept a file you changed after installing it.\n\ntiger-setup build contacts the WinGet community catalog only to resolve WinGet\ndependencies a package declares (tiger-setup build --offline makes no network\nrequest). The installers it builds download a prerequisite the package\ndeclares, from the WinGet catalog or from the address the package names, only\nwhen the computer lacks it. Reading product metadata from an MSBuild project\nneeds the .NET SDK. TigerSetup sends no telemetry.\n\nThe installers it builds are transactional: an install or upgrade completes or\nrolls back, and each installation records what it owns, so upgrade, uninstall\nand verification work from what is really installed.","moniker":"tigersetup","name":"TigerSetup","packageUrl":"https://github.com/rkozlowski/TigerSetup","publisher":"IT Tiger","publisherUrl":"https://www.ittiger.net/","releaseNotesUrl":"https://github.com/rkozlowski/TigerSetup/releases/tag/v0.15.0","tags":["installer","setup","packaging","cli","installer-builder"]}},"publisherUrl":"https://www.ittiger.net/","releaseNotesUrl":"https://github.com/rkozlowski/TigerSetup/releases/tag/v0.15.0","schemaVersion":1,"source":"winget","upstream":{"commit":"97d6aa2689f0a05f7847653a62b8624720d15b5d","manifestVersion":"1.12.0","manifests":[{"path":"manifests/i/ItTiger/TigerSetup/0.15.0/ItTiger.TigerSetup.yaml","sha256":"8bed7a1d50743287d5e328d2a80e25f714849a06aa02b74827e41da35de1f99e"},{"path":"manifests/i/ItTiger/TigerSetup/0.15.0/ItTiger.TigerSetup.installer.yaml","sha256":"d5d86a7e248e8091f8d66c155ff98d795d9c3d0007bcc7cc82a36a5c133ace19"},{"path":"manifests/i/ItTiger/TigerSetup/0.15.0/ItTiger.TigerSetup.locale.en-US.yaml","sha256":"508509df2f4bea02996d3945eb5d0951060603b06ee02c706a110e5d75ac5ab0"}],"repository":"microsoft/winget-pkgs"},"version":"0.15.0"}