f has no telemetry. Web images that a document refers to are downloaded from the addresses it names; in the viewer this is on by default and can be turned off under View > Rendering > Load Remote Images, while the tiger-mark command always downloads them. Links in a document never open files on network shares.","moniker":"tiger-markview","name":"TigerMarkView","packageUrl":"https://github.com/rkozlowski/TigerMarkView","publisher":"IT Tiger","publisherUrl":"https://www.ittiger.net/","releaseNotesUrl":"https://github.com/rkozlowski/TigerMarkView/releases/tag/v0.12.1","tags":["markdown","pdf","viewer"]}},"publisherUrl":"https://www.ittiger.net/","releaseNotesUrl":"https://github.com/rkozlowski/TigerMarkView/releases/tag/v0.12.1","schemaVersion":1,"source":"winget","upstream":{"commit":"97d6aa2689f0a05f7847653a62b8624720d15b5d","manifestVersion":"1.12.0","manifests":[{"path":"manifests/i/ItTiger/TigerMarkView/0.12.1/ItTiger.TigerMarkView.yaml","sha256":"07b7ebb4ae514ebb9166b4f6ce01df46b1c58c5b6d0323b9838b8cd42033a9fc"},{"path":"manifests/i/ItTiger/TigerMarkView/0.12.1/ItTiger.TigerMarkView.installer.yaml","sha256":"78ea3808be13456970b2c5358324329bad730cf014dac8a77dfd488f9363e286"},{"path":"manifests/i/ItTiger/TigerMarkView/0.12.1/ItTiger.TigerMarkView.locale.en-US.yaml","sha256":"afad133565964697cab6e30c43c2db2b0661507c42021c6bdfccfd17429d2466"}],"repository":"microsoft/winget-pkgs"},"version":"0.12.1"}