{"defaultLocale":"en-US","id":"idk-arsh.MultiTerm","installers":[{"architecture":"x64","commands":["multiterm"],"dependencies":[],"id":"x64-portable","priority":4,"sha256":"8ae2d02c5a09a674092d402b71fa540f58f0e003e920a19b2fb71520f6511b60","successCodes":[],"type":"portable","url":"https://github.com/idk-arsh/multiterm/releases/download/v1.1.0/MultiTerm.exe"}],"licenseUrl":"https://github.com/idk-arsh/multiterm/blob/main/LICENSE","packageLocalizations":{"en-US":{"description":"A multi-pane terminal workspace for Windows with workspaces, per-folder startup commands and broadcast typing.","license":"MIT","licenseUrl":"https://github.com/idk-arsh/multiterm/blob/main/LICENSE","locale":"en-US","longDescription":"MultiTerm opens several real Windows shells (cmd, PowerShell, PowerShell 7, Git Bash, WSL) side by side over ConPTY.\nA workspace is a project folder: its subfolders become panes, each can have a startup command, and opening the workspace starts everything in the layout you left it in.\nBroadcast typing sends every keystroke to every pane in a tab. Panes are a freeform split tree with drag-to-resize, maximise and presets.\nSingle portable executable, no installer, no admin rights, settings in %APPDATA%\\MultiTerm.","moniker":"multiterm","name":"MultiTerm","packageUrl":"https://github.com/idk-arsh/multiterm","publisher":"idk-arsh","publisherUrl":"https://github.com/idk-arsh","releaseNotesUrl":"https://github.com/idk-arsh/multiterm/releases/tag/v1.1.0","tags":["conpty","console","developer-tools","multiplexer","shell","terminal","terminal-emulator","workspace"]}},"publisherUrl":"https://github.com/idk-arsh","releaseDate":"2026-09-04","releaseDateSource":"manifest","releaseNotesUrl":"https://github.com/idk-arsh/multiterm/releases/tag/v1.1.0","schemaVersion":1,"source":"winget","upstream":{"commit":"97d6aa2689f0a05f7847653a62b8624720d15b5d","manifestVersion":"1.10.0","manifests":[{"path":"manifests/i/idk-arsh/MultiTerm/1.1.0/idk-arsh.MultiTerm.yaml","sha256":"e9204e6e