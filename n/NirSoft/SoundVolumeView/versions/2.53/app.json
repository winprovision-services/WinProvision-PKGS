{"defaultLocale":"en-US","id":"NirSoft.SoundVolumeView","installers":[{"architecture":"x64","dependencies":[],"id":"x64-zip","locale":"en-US","nestedInstallerFiles":[{"PortableCommandAlias":"SoundVolumeView","RelativeFilePath":"SoundVolumeView.exe"}],"nestedInstallerType":"portable","priority":4,"sha256":"ee2c45553fb9fb31b71db88b537c18e25c1a387a4a9009d081bdb38265c68e1f","successCodes":[],"type":"zip","url":"https://www.nirsoft.net/utils/soundvolumeview-x64.zip"},{"architecture":"x86","dependencies":[],"id":"x86-zip","locale":"en-US","nestedInstallerFiles":[{"PortableCommandAlias":"SoundVolumeView","RelativeFilePath":"SoundVolumeView.exe"}],"nestedInstallerType":"portable","priority":4,"sha256":"93064fbbdb8d3b42b9f5fcfb80c1ed8c17a21c207869052940683607e889054b","successCodes":[],"type":"zip","url":"https://www.nirsoft.net/utils/soundvolumeview.zip"}],"licenseUrl":"https://www.nirsoft.net/utils/sound_volume_view.html#:~:text=License","packageLocalizations":{"en-US":{"description":"View/Change sound volume on Windows 11/10/7/8/2008 from command-line or GUI, including on a per-program basis.","license":"Freeware","licenseUrl":"https://www.nirsoft.net/utils/sound_volume_view.html#:~:text=License","locale":"en-US","longDescription":"SoundVolumeView is a simple tool for Windows Vista/7/8/2008/10/11 that displays general information and current volume level for all active sound components on your system, and allows you to mute and unmute them instantly.\nSoundVolumeView also allows you to save a sound profile into a file, containing the current volume level and the mute/unmute state of all sound components, as well as the default sound devices, and then later, load the same file to restore exactly the same volume levels and settings. There is also extensive command-line support, which allows you to save/load profiles, change current volume of every sound component, and mute/unmute every sound component, without displaying any user interface.\n","moniker":"soundvolumeview","n