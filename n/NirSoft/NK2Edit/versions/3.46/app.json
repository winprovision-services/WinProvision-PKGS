cription":"Edit, delete, add, merge, and repair records in the AutoComplete files (.NK2) of Outlook.","license":"Freeware","licenseUrl":"https://www.nirsoft.net/utils/outlook_nk2_edit.html#:~:text=License","locale":"en-US","longDescription":"Every time that you type an email address or name in the message window of MS-Outlook, it automatically offer you a list of users and email address that you can choose.\nThis feature is known as 'AutoComplete' and Outlook automatically build this emails list according to user activity and save it into a file with .NK2 extension.\n\nIn some circumstances, you may need to repair or modify the values appeared in the AutoComplete list, or you may want to remove unwanted email addresses and/or to add new email addresses.\nMS-Outlook doesn't provide any ability to edit this AutoComplete list, so this is where NK2Edit software can help you.","moniker":"nk2edit","name":"NK2Edit","packageUrl":"https://www.nirsoft.net/utils/outlook_nk2_edit.html","publisher":"NirSoft","publisherUrl":"https://www.nirsoft.net/","releaseNotesUrl":"https://www.nirsoft.net/utils/outlook_nk2_edit.html#:~:text=Versions%20History","tags":[]}},"publisherUrl":"https://www.nirsoft.net/","releaseDate":"2023-08-29","releaseDateSource":"manifest","releaseNotesUrl":"https://www.nirsoft.net/utils/outlook_nk2_edit.html#:~:text=Versions%20History","schemaVersion":1,"source":"winget","upstream":{"commit":"97d6aa2689f0a05f7847653a62b8624720d15b5d","manifestVersion":"1.12.0","manifests":[{"path":"manifests/n/NirSoft/NK2Edit/3.46/NirSoft.NK2Edit.yaml","sha256":"57b3b71d519bdfcfc1f7349f65481782fad3b2048d637c52463c0e3fa1de83b4"},{"path":"manifests/n/NirSoft/NK2Edit/3.46/NirSoft.NK2Edit.installer.yaml","sha256":"8b4b82496df99c1af57d357435b2b3badaf661ccc600939791a37660bd0c39dd"},{"path":"manifests/n/NirSoft/NK2Edit/3.46/NirSoft.NK2Edit.locale.en-US.yaml","sha256":"c98be426bbe072a60ea71ca790d60198013762113cbeb9ad35bf430c07bed732"}],"repository":"microsoft/winget-pkgs"},"version":"3