{"defaultLocale":"en-US","id":"NirSoft.WakeMeOnLan","installers":[{"architecture":"x64","dependencies":[],"id":"x64-zip","locale":"en-US","nestedInstallerFiles":[{"PortableCommandAlias":"WakeMeOnLan","RelativeFilePath":"WakeMeOnLan.exe"}],"nestedInstallerType":"portable","priority":4,"sha256":"f1464495cf425910f735c3d1267993283a369d884eee4df4dff4944f5a459a8c","successCodes":[],"type":"zip","url":"https://www.nirsoft.net/utils/wakemeonlan-x64.zip"},{"architecture":"x86","dependencies":[],"id":"x86-zip","locale":"en-US","nestedInstallerFiles":[{"PortableCommandAlias":"WakeMeOnLan","RelativeFilePath":"WakeMeOnLan.exe"}],"nestedInstallerType":"portable","priority":4,"sha256":"22b0b62c744ab3951581551bd064f5f76fced86f38f6dd40c95eda9281645848","successCodes":[],"type":"zip","url":"https://www.nirsoft.net/utils/wakemeonlan.zip"}],"licenseUrl":"https://www.nirsoft.net/utils/wake_on_lan.html#:~:text=License","packageLocalizations":{"en-US":{"description":"Easily turn on one or more computers using Wake-on-LAN.","license":"Freeware","licenseUrl":"https://www.nirsoft.net/utils/wake_on_lan.html#:~:text=License","locale":"en-US","longDescription":"This utility allows you to easily turn on one or more computers remotely by sending Wake-on-LAN (WOL) packet to the remote computers.\nWhen your computers are turned on, WakeMeOnLan allows you to scan your network, and collect the MAC addresses of all your computers, and save the computers list into a file. Later, when your computers are turned off or in standby mode, you can use the stored computers list to easily choose the computer you want to turn on, and then turn on all these computers with a single click.\nWakeMeOnLan also allows you to turn on a computer from command-line, by specifying the computer name, IP address, or the MAC address of the remote network card.","moniker":"wakemeonlan","name":"WakeMeOnLan","packageUrl":"https://www.nirsoft.net/utils/wake_on_lan.html","publisher":"NirSoft","publisherUrl":"https://www.nirsoft.net