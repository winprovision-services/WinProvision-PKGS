{"defaultLocale":"en-US","id":"neyham.AIUsageDashboard","installers":[{"appsAndFeaturesEntries":[{"DisplayName":"AI Usage Dashboard","DisplayVersion":"0.9.0","ProductCode":"AI Usage Dashboard","Publisher":"neyha"}],"architecture":"x64","dependencies":[],"id":"x64-user-nullsoft","installModes":["interactive","silent","silentWithProgress"],"installerSwitches":{"Silent":"/S","SilentWithProgress":"/S"},"locale":"en-US","minimumOSVersion":"10.0.17763.0","priority":1,"scope":"user","sha256":"529ca4a4bb2ef5c2717f376fb559550144a6c3b8692ecc7e401bfa51e09cb281","silent":{"arguments":"/S","source":"manifest"},"successCodes":[],"type":"nullsoft","upgradeBehavior":"install","url":"https://github.com/neyham/ai-usage-dashboard/releases/download/v0.9.0/AI-Usage-Dashboard_0.9.0_x64-setup.exe"}],"licenseUrl":"https://github.com/neyham/ai-usage-dashboard/blob/v0.9.0/LICENSE","packageLocalizations":{"en-US":{"description":"Local Windows dashboard for Claude Code, Codex, Grok Build / X Subscription, Cursor, Antigravity, and DeepSeek usage.","license":"MIT","licenseUrl":"https://github.com/neyham/ai-usage-dashboard/blob/v0.9.0/LICENSE","locale":"en-US","longDescription":"AI Usage Dashboard is a local-first Windows desktop dashboard and screensaver\nfor viewing Claude Code, Codex, Grok Build, Cursor, and Antigravity usage\nwindows alongside a DeepSeek API balance. Display Settings provide a\nwrite-only DeepSeek API key field, optional Cursor and Antigravity panels\nthat stay off by default, and an optional Low Power Mode that disables\nanimation and reduces renderer update work. Credentials and provider\nrequests stay in the native Rust backend; the renderer receives sanitized\nusage summaries only. Accounts on the X Subscription show Grok and Cursor\nas one shared weekly pool split by product. The project has no\ndeveloper-operated server, analytics, or telemetry.","moniker":"ai-usage-dashboard","name":"AI Usage Dashboard","packageUrl":"https://github.com/neyham/ai-usage-dashboard","publi