eloper-operated server, analytics, or\ntelemetry.","moniker":"ai-usage-dashboard","name":"AI Usage Dashboard","packageUrl":"https://github.com/neyham/ai-usage-dashboard","publisher":"neyham","publisherSupportUrl":"https://github.com/neyham/ai-usage-dashboard/issues","publisherUrl":"https://github.com/neyham","releaseNotesUrl":"https://github.com/neyham/ai-usage-dashboard/releases/tag/v0.9.5","tags":["ai","antigravity","claude","claude-code","codex","cursor","dashboard","deepseek","grok","opencode","usage"]}},"publisherSupportUrl":"https://github.com/neyham/ai-usage-dashboard/issues","publisherUrl":"https://github.com/neyham","releaseDate":"2026-11-08","releaseDateSource":"commit","releaseNotesUrl":"https://github.com/neyham/ai-usage-dashboard/releases/tag/v0.9.5","schemaVersion":1,"source":"winget","upstream":{"commit":"570b22d476bfc0941e914efd60dc1032cf6ff791","manifestVersion":"1.12.0","manifests":[{"path":"manifests/n/neyham/AIUsageDashboard/0.9.5/neyham.AIUsageDashboard.installer.yaml","sha256":"0c2bef4e6fb986b66697f7f31c7488bcb163e0f36e6355139e221def23da4921"},{"path":"manifests/n/neyham/AIUsageDashboard/0.9.5/neyham.AIUsageDashboard.locale.en-US.yaml","sha256":"a811c710d5a20a8c746848ed56c16d6553c89ea03f4ebbfef55dcfb1344dd004"},{"path":"manifests/n/neyham/AIUsageDashboard/0.9.5/neyham.AIUsageDashboard.yaml","sha256":"1c5a4f2a824351ae56b65948592ca4552b35b51f41eff05f8ccef8ddb569633c"}],"repository":"microsoft/winget-pkgs"},"version":"0.9.5"}