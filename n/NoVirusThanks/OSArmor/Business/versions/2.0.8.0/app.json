{"defaultLocale":"en-US","id":"NoVirusThanks.OSArmor.Business","installers":[{"appsAndFeaturesEntries":[{"ProductCode":"NoVirusThanks OSArmor_is1"}],"architecture":"x86","dependencies":[],"elevation":{"requirement":"elevatesSelf","source":"manifest"},"id":"x86-machine-inno","installModes":["interactive","silent","silentWithProgress"],"locale":"en-US","priority":1,"scope":"machine","sha256":"f641d587c85c7a70d4de48b6c1726fd91a32f703734acc8a8e08069aa945e085","silent":{"arguments":"/VERYSILENT /SUPPRESSMSGBOXES /NORESTART /SP-","source":"default"},"successCodes":[],"type":"inno","uninstall":{"type":"productCode","value":"NoVirusThanks OSArmor_is1"},"upgradeBehavior":"install","url":"https://downloads.osarmor.com/latest/osarmor-business/setup"}],"licenseUrl":"https://www.osarmor.com/terms/","packageLocalizations":{"en-US":{"description":"Prevent Malware & Ransomware","license":"Proprietary (ToS)","licenseUrl":"https://www.osarmor.com/terms/","locale":"en-US","longDescription":"OSArmor is a Windows OS application that monitors and blocks suspicious processes behaviors to prevent infections by malware, ransomware, and other threats. This tool analyzes parent processes and prevents, for example, MS Word from running cmd.exe or powershell.exe. It prevents ransomware from deleting shadow copies of files via vssadmin.exe, blocks processes with double file extensions (i.e invoice.pdf.exe), blocks USB-spreading malware, and much more. It is lightweight, requires zero user input and protects your system while running in the background. In combination with OSArmor you can also use SysHardener to harden even more Windows OS settings.\n","name":"NoVirusThanks OSArmor (BUSINESS)","packageUrl":"https://www.osarmor.com/download/","publisher":"NoVirusThanks Company Srl","publisherUrl":"https://www.novirusthanks.com/company/","tags":[]}},"publisherUrl":"https://www.novirusthanks.com/company/","schemaVersion":1,"source":"winget","upstream":{"commit":"97d6aa2689f0a05f7847653a62b8624720d15b