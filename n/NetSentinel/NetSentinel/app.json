{"architectures":["x64"],"id":"NetSentinel.NetSentinel","latestVersion":"2.4.0","media":{"icons":[{"mimeType":"image/png","path":"media/icon.7a448d30.png","priority":1,"sha256":"7a448d307d713b6ab091479844bf8189ee8cd25dc56f68e1ea4ef124aa0c4de7","source":"winget-legacy"}],"screenshots":[]},"package":{"description":"Network security scanner — rogue device detector, STP monitor, and connectivity analyser","license":"MIT","licenseUrl":"https://raw.githubusercontent.com/ossianericson/netsentinel/main/LICENSE","locale":"en-US","localizations":{"en-US":{"description":"Network security scanner — rogue device detector, STP monitor, and connectivity analyser","license":"MIT","licenseUrl":"https://raw.githubusercontent.com/ossianericson/netsentinel/main/LICENSE","locale":"en-US","longDescription":"NetSentinel is a one-stop network diagnostic and security tool for Windows.\nIt combines several tools that previously required separate utilities:\n\n  • Device Fingerprinter  — scans your LAN's ARP table and identifies every\n    device by MAC OUI, hostname, and device type (camera, smart speaker, router, etc.)\n  • Rogue Bridge Detector — captures 802.1D/RSTP BPDUs and flags any device\n    that steals the Root Bridge role and causes periodic 15-45 second outages.\n  • Broadcast Storm Analyser — measures broadcast/multicast packet rates and\n    identifies which device is flooding the network.\n  • IoT Behavioral Baseline — learns normal IoT traffic patterns and raises\n    an alert if your smart fridge starts port-scanning or talking to a C2 server.\n  • Root Cause Correlator — links trace results, storm data, and STP findings\n    into a single plain-English verdict with actionable remediation steps.\n  • Connection Stability Monitor — long-term background ping logger with\n    outage detection, jitter analysis, and a 24-hour stability score.\n  • TCP Port Scanner, OS Fingerprinter, CVE Lookup, DNS Leak Test, Speed Test,\n    ARP spoof detector, DHCP monitor, SNMP poller, and more.\n\nMost features require Administrator privileges for raw packet capture.\nInstall Npcap (https://npcap.com) for STP, Storm, and ARP modules.","moniker":"netsentinel","name":"NetSentinel","packageUrl":"https://github.com/ossianericson/netsentinel","publisher":"NetSentinel Project","publisherUrl":"https://github.com/ossianericson/netsentinel","releaseNotesUrl":"https://github.com/ossianericson/netsentinel/releases/tag/v2.4.0","tags":["network","security","scanner","monitoring","diagnostics","lan","wifi","dns","iot","port-scanner","cve","speed-test","packet-capture","mqtt","home-assistant","network-health"]}},"longDescription":"NetSentinel is a one-stop network diagnostic and security tool for Windows.\nIt combines several tools that previously required separate utilities:\n\n  • Device Fingerprinter  — scans your LAN's ARP table and identifies every\n    device by MAC OUI, hostname, and device type (camera, smart speaker, router, etc.)\n  • Rogue Bridge Detector — captures 802.1D/RSTP BPDUs and flags any device\n    that steals the Root Bridge role and causes periodic 15-45 second outages.\n  • Broadcast Storm Analyser — measures broadcast/multicast packet rates and\n    identifies which device is flooding the network.\n  • IoT Behavioral Baseline — learns normal IoT traffic patterns and raises\n    an alert if your smart fridge starts port-scanning or talking to a C2 server.\n  • Root Cause Correlator — links trace results, storm data, and STP findings\n    into a single plain-English verdict with actionable remediation steps.\n  • Connection Stability Monitor — long-term background ping logger with\n    outage detection, jitter analysis, and a 24-hour stability score.\n  • TCP Port Scanner, OS Fingerprinter, CVE Lookup, DNS Leak Test, Speed Test,\n    ARP spoof detector, DHCP monitor, SNMP poller, and more.\n\nMost features require Administrator privileges for raw packet capture.\nInstall Npcap (https://npcap.com) for STP, Storm, and ARP modules.","moniker":"netsentinel","name":"NetSentinel","packageUrl":"https://github.com/ossianericson/netsentinel","publisher":"NetSentinel Project","publisherUrl":"https://github.com/ossianericson/netsentinel","releaseNotesUrl":"https://github.com/ossianericson/netsentinel/releases/tag/v2.4.0","tags":["network","security","scanner","monitoring","diagnostics","lan","wifi","dns","iot","port-scanner","cve","speed-test","packet-capture","mqtt","home-assistant","network-health"]},"schemaVersion":1,"source":"winget","versions":[{"architectures":["x64"],"detailPath":"versions/2.4.0/app.json","detailSha256":"74dfe2dd91cb7ca2b908e87a592a9f5e7df6a666aa5a8eb978536bcdc2e58ba8","releaseDate":"2026-09-21","releaseDateSource":"manifest","version":"2.4.0"},{"architectures":["x64"],"detailPath":"versions/2.3.0/app.json","detailSha256":"61573859428515537687188206353192f0d48dc249e893d53f14b863e9429ea1","releaseDate":"2026-09-06","releaseDateSource":"manifest","version":"2.3.0"},{"architectures":["x64"],"detailPath":"versions/2.2.8/app.json","detailSha256":"e3c2b7b7a1252b9f05fe605da5aa85aca091e5e53ca4f57eb47e5fe940ee231b","releaseDate":"2026-09-03","releaseDateSource":"manifest","version":"2.2.8"},{"architectures":["x64"],"detailPath":"versions/2.2.7/app.json","detailSha256":"5e5d0c42c7b8b186292b4e7b5f8da12edc359b05e6b9a6021f0229d4a918e937","releaseDate":"2026-08-14","releaseDateSource":"manifest","version":"2.2.7"},{"architectures":["x64"],"detailPath":"versions/2.2.6/app.json","detailSha256":"c5048489ac7f4f102810358e07b3a9518c2ed7a9f35828d0fab35636b73f737a","releaseDate":"2026-08-12","releaseDateSource":"manifest","version":"2.2.6"},{"architectures":["x64"],"detailPath":"versions/2.2.5/app.json","detailSha256":"514da15bf7eeb7a343b48247cee69adf2535780e292f7fb300a4975265bc2d41","releaseDate":"2026-08-08","releaseDateSource":"manifest","version":"2.2.5"},{"architectures":["x64"],"detailPath":"versions/2.2.4/app.json","detailSha256":"e38c629f760f7975ed1869d2351e53573927cc4733e8448131e8c1d43013389b","releaseDat