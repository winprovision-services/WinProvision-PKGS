":{"arguments":"/exenoui /quiet /norestart","source":"manifest"},"successCodes":[],"type":"zip","uninstall":{"type":"productCode","value":"TRBOnet Enterprise 6.4 6.4.0.8741"},"upgradeBehavior":"install","url":"https://cdn.trbonet.com/download/enterprise/6.4.0.8741/TRBOnet.Enterprise_6.4.0.8741.zip"}],"packageLocalizations":{"en-US":{"description":"Award-winning IP Dispatch System","license":"Proprietary","locale":"en-US","longDescription":"TRBOnet Enterprise is a feature-rich and robust control room solution designed to work with MOTOTRBO and DIMETRA Express two-way radio systems of any size and complexity. Selected non-MOTOTRBO systems based on SELEX and KAIROS repeaters, as well as Jotron TR-7750 and legacy radios, are also supported. The software was first launched in 2008, and has become one of the leading dispatch systems in the world.\nThis state-of-the-art IP-based dispatch system offers a wide choice of additional modules, which means that it can be tailored to individual requirements. The intuitive GUI greatly reduces learning time and allows operators to concentrate on tasks that matter. The IP nature of this product makes it extremely flexible and scalable, so your system can grow up with your requirements.","name":"TRBOnet Enterprise","packageUrl":"https://trbonet.com/products/enterprise/","publisher":"Neocom Software","publisherUrl":"https://trbonet.com/","tags":["sip","softphone","telephone","telephony"]},"zh-CN":{"description":"屡获殊荣的 IP 调度系统","license":"专有软件","locale":"zh-CN","longDescription":"TRBOnet Enterprise 是一款功能丰富且坚固耐用的调度室解决方案，专为与任何规模和复杂程度的 MOTOTRBO 和 DIMETRA Express 双向无线电系统配合使用而设计。同时支持基于 SELEX 和 KAIROS 中继器的特定非 MOTOTRBO 系统，以及 Jotron TR-7750 和传统无线电设备。该软件于 2008 年首次发布，现已成为全球领先的调度系统之一。\n这款先进的基于 IP 的调度系统提供多种可选附加模块，可根据用户具体需求进行定制。直观的图形用户界面显著缩短学习时间，使操作人员能够专注于关键任务。该产品基于 IP 架构，具备高度灵活性和可扩展性，可随您的需求不断发展成长。","tags":["sip","电话"]}},"publisherUrl":"https://trbonet.com/","schemaVersion":1,"source":"winget","upstream":{"commit":"97d6aa2689f0a05f7847653a62b8624720