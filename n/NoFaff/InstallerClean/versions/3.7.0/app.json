{"defaultLocale":"en-GB","id":"NoFaff.InstallerClean","installers":[{"appsAndFeaturesEntries":[{"DisplayVersion":"3.7.0","ProductCode":"InstallerClean_is1"}],"architecture":"x64","dependencies":[],"elevation":{"requirement":"elevationRequired","source":"inferred"},"id":"x64-machine-inno","priority":1,"scope":"machine","sha256":"bf035ff190738488bdb34f00e70d0daa0c6520e187b6790f0e414897f419a2cc","successCodes":[],"type":"inno","uninstall":{"type":"registryKey","value":"InstallerClean_is1"},"url":"https://github.com/no-faff/InstallerClean/releases/download/v3.7.0/InstallerClean-3.7.0-setup.exe"}],"licenseUrl":"https://github.com/no-faff/InstallerClean/blob/main/LICENSE","packageLocalizations":{"en-GB":{"author":"No Faff","copyright":"Copyright (c) 2026 No Faff","description":"Open source tool for the C:\\Windows\\Installer folder: move or delete the files nothing needs","license":"Apache-2.0","licenseUrl":"https://github.com/no-faff/InstallerClean/blob/main/LICENSE","locale":"en-GB","longDescription":"InstallerClean removes unneeded files from C:\\Windows\\Installer, a hidden folder that fills up as you install and update software. It asks Windows Installer what it still holds a record of, and reads the same records out of the registry as well, then offers a file only when nothing installed on the machine claims it, or a newer patch has replaced it. Where it cannot get a straight answer, it holds the file back. Delete is permanent; Move puts the files in a folder you choose instead. Free and open source, no ads, no tracking. The first time it finishes on a PC it can send one anonymous report of how the run went, if the box on the result screen is ticked.","moniker":"installerclean","name":"InstallerClean","packageUrl":"https://github.com/no-faff/InstallerClean","publisher":"No Faff","publisherSupportUrl":"https://github.com/no-faff/InstallerClean/issues","publisherUrl":"https://github.com/no-faff","releaseNotesUrl":"https://github.com/no-faff/InstallerClean/releases/tag/v3.7.0","tags":["cleanup","disk-space","installer","msi","open-source","patchcleaner","windows-installer"]}},"publisherSupportUrl":"https://github.com/no-faff/InstallerClean/issues","publisherUrl":"https://github.com/no-faff","releaseDate":"2026-11-04","releaseDateSource":"commit","releaseNotesUrl":"https://github.com/no-faff/InstallerClean/releases/tag/v3.7.0","schemaVersion":1,"source":"winget","upstream":{"commit":"8ab5b6a34a787eee24b0430c2fbd72515bd43638","manifestVersion":"1.12.0","manifests":[{"path":"manifests/n/NoFaff/InstallerClean/3.7.0/NoFaff.InstallerClean.installer.yaml","sha256":"da932336e87004bc86aec7d0ba6199d0b1fad13d8ce741ce9da7daa100c15c2b"},{"path":"manifests/n/NoFaff/InstallerClean/3.7.0/NoFaff.InstallerClean.locale.en-GB.yaml","sha256":"4605d620e6cbe78625f6f8ef6f6a4fef917ddd34ed9c93744f1ac337e141e8a6"},{"path":"manifests/n/NoFaff/InstallerClean/3.7.0/NoFaff.InstallerClean.yaml","sha256":"8746ed149cee85d40e3109b5840c75e30245759375dc938eca82ad6ea676a8bb"}],"repository":"microsoft/winget-pkgs"},"version":"3.7.0"}