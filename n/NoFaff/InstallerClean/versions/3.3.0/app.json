{"defaultLocale":"en-GB","id":"NoFaff.InstallerClean","installers":[{"appsAndFeaturesEntries":[{"DisplayVersion":"3.3.0","ProductCode":"InstallerClean_is1"}],"architecture":"x64","dependencies":[],"elevation":{"requirement":"elevationRequired","source":"inferred"},"id":"x64-machine-inno","priority":1,"scope":"machine","sha256":"523c2ad3e717992b878c43fa1dc982e07c0cbd25d5adef9d467f10dc4d645211","silent":{"arguments":"/VERYSILENT /SUPPRESSMSGBOXES /NORESTART /SP-","source":"default"},"successCodes":[],"type":"inno","uninstall":{"type":"productCode","value":"InstallerClean_is1"},"url":"https://github.com/no-faff/InstallerClean/releases/download/v3.3.0/InstallerClean-3.3.0-setup.exe"}],"licenseUrl":"https://github.com/no-faff/InstallerClean/blob/main/LICENSE","packageLocalizations":{"en-GB":{"description":"Open source tool for the C:\\Windows\\Installer folder: move or delete the files nothing needs","license":"Apache-2.0","licenseUrl":"https://github.com/no-faff/InstallerClean/blob/main/LICENSE","locale":"en-GB","longDescription":"InstallerClean removes unneeded files from C:\\Windows\\Installer, a hidden folder that fills up as you install and update software. It asks Windows Installer what it still holds a record of, and reads the same records out of the registry as well, then offers a file only when nothing installed on the machine claims it, or a newer patch has replaced it. Where it cannot get a straight answer, it holds the file back. Delete is permanent; Move puts the files in a folder you choose instead. Free and open source, no ads, no tracking. The first time it finishes on a PC it can send one anonymous report of how the run went, if the box on the result screen is ticked.","moniker":"installerclean","name":"InstallerClean","packageUrl":"https://github.com/no-faff/InstallerClean","publisher":"No Faff","publisherUrl":"https://github.com/no-faff","releaseNotesUrl":"https://github.com/no-faff/InstallerClean/releases/tag/v3.3.0","tags":["cleanup","disk-space","in