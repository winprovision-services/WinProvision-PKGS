{"architectures":["x64"],"id":"NoFaff.InstallerClean","latestVersion":"3.6.0","media":{"icons":[{"mimeType":"image/png","path":"media/icon.3d8c6de4.png","priority":1,"sha256":"3d8c6de46a3ee808a7586fb625d80c00b02e7058d94eb1e4bc2d7ed589f55487","source":"winget-legacy"}],"screenshots":[]},"package":{"description":"Open source tool for the C:\\Windows\\Installer folder: move or delete the files nothing needs","license":"Apache-2.0","licenseUrl":"https://github.com/no-faff/InstallerClean/blob/main/LICENSE","locale":"en-GB","localizations":{"en-GB":{"description":"Open source tool for the C:\\Windows\\Installer folder: move or delete the files nothing needs","license":"Apache-2.0","licenseUrl":"https://github.com/no-faff/InstallerClean/blob/main/LICENSE","locale":"en-GB","longDescription":"InstallerClean removes unneeded files from C:\\Windows\\Installer, a hidden folder that fills up as you install and update software. It asks Windows Installer what it still holds a record of, and reads the same records out of the registry as well, then offers a file only when nothing installed on the machine claims it, or a newer patch has replaced it. Where it cannot get a straight answer, it holds the file back. Delete is permanent; Move puts the files in a folder you choose instead. Free and open source, no ads, no tracking. The first time it finishes on a PC it can send one anonymous report of how the run went, if the box on the result screen is ticked.","moniker":"installerclean","name":"InstallerClean","packageUrl":"https://github.com/no-faff/InstallerClean","publisher":"No Faff","publisherUrl":"https://github.com/no-faff","releaseNotesUrl":"https://github.com/no-faff/InstallerClean/releases/tag/v3.6.0","tags":["cleanup","disk-space","installer","msi","open-source","patchcleaner","windows-installer"]}},"longDescription":"InstallerClean removes unneeded files from C:\\Windows\\Installer, a hidden folder that fills up as you install and update software. It asks Windows Installer what it still holds a record of, and reads the same records out of the registry as well, then offers a file only when nothing installed on the machine claims it, or a newer patch has replaced it. Where it cannot get a straight answer, it holds the file back. Delete is permanent; Move puts the files in a folder you choose instead. Free and open source, no ads, no tracking. The first time it finishes on a PC it can send one anonymous report of how the run went, if the box on the result screen is ticked.","moniker":"installerclean","name":"InstallerClean","packageUrl":"https://github.com/no-faff/InstallerClean","publisher":"No Faff","publisherUrl":"https://github.com/no-faff","releaseNotesUrl":"https://github.com/no-faff/InstallerClean/releases/tag/v3.6.0","tags":["cleanup","disk-space","installer","msi","open-source","patchcleaner","windows-installer"]},"schemaVersion":1,"source":"winget","versions":[{"architectures":["x64"],"detailPath":"versions/3.6.0/app.json","detailSha256":"921a8e2d8b29afdae00828298eba3e0314a6803c90c053b1643d784f575e2a7d","releaseDate":"2026-11-03","releaseDateSource":"manifest","version":"3.6.0"},{"architectures":["x64"],"detailPath":"versions/3.5.0/app.json","detailSha256":"2e4ebbc2227e4738ef79e252c1a70d2ccae66e777fa40bdf8956646bb424c96b","releaseDate":"2026-10-29","releaseDateSource":"manifest","version":"3.5.0"},{"architectures":["x64"],"detailPath":"versions/3.4.0/app.json","detailSha256":"cbf9f6dbb3f27d80d2bebcb1bb472046e32779b9d6063f948122a2c2594b4d8a","releaseDate":"2026-10-14","releaseDateSource":"manifest","version":"3.4.0"},{"architectures":["x64"],"detailPath":"versions/3.3.0/app.json","detailSha256":"a5b277ebdc3214b56d1f7e7df1547adaf9998a9d946d4cd32de6b34b09a551f1","releaseDate":"2026-10-13","releaseDateSource":"manifest","version":"3.3.0"},{"architectures":["x64"],"detailPath":"versions/3.2.0/app.json","detailSha256":"2f9dd9abc15f63c9cdd1d4adb4aebb12f9f715bda3abd85fb34889625957717f","releaseDate":"2026-10-13","releaseDateSource":"manif