censeUrl":"https://www.httpwatch.com/company/terms.aspx","packageLocalizations":{"en-US":{"description":"Become a debugging and web performance guru with the ultimate in-browser HTTP sniffer.","license":"Proprietary","licenseUrl":"https://www.httpwatch.com/company/terms.aspx","locale":"en-US","longDescription":"HttpWatch integrates with Google Chrome and Microsoft Edge to provide unrivaled levels of HTTP monitoring, without the need for separately configured proxies or network sniffers. Simply interact with a web site and HttpWatch will display a log of requests and responses alongside the web page itself. It even shows interactions between the browser and its cache. Each HTTP transaction can be examined to see the values of headers, cookies, query strings and other HTTP related data.\nCommercial web sites often use technologies such as HTTP compression, SSL encryption and chunked encoding to provide the best levels of security and performance. HttpWatch works with these technologies to provided a detail view of HTTP activity within the browser.\nHttpWatch has two components; an extension used to collect, view and save HTTP traffic within the browser and a standalone log file viewer know as HttpWatch Studio.","name":"HttpWatch Basic","packageUrl":"https://www.httpwatch.com/download/","publisher":"Neumetrix Limited","publisherUrl":"https://www.httpwatch.com/","releaseNotesUrl":"https://www.httpwatch.com/download/versionhistory/","tags":["debug","performance","web","webpage"]},"zh-CN":{"description":"使用浏览器内 HTTP 嗅探工具，成为调试与网页性能大师。","license":"专有软件","locale":"zh-CN","longDescription":"HttpWatch 无缝集成于 Google Chrome 与 Microsoft Edge 浏览器，提供无与伦比的 HTTP 监控体验，无需额外配置代理或网络嗅探工具。用户只需正常浏览网页，HttpWatch 即可在页面旁同步显示完整的请求与响应日志，甚至能捕捉浏览器与缓存之间的交互细节。每个 HTTP 事务均可深入分析，查看标头、Cookies、查询字符串等 HTTP 相关数据的详细内容。\n商业网站常采用 HTTP 压缩、SSL 加密和分块编码等技术来保障安全与性能。HttpWatch 全面兼容这些技术，为浏览器内的 HTTP 活动提供精细化监控视图。\nHttpWatch 由两大组件构成：一是浏览器扩展组件，用于采集、查看及保存 HTTP 流量数据；二是独立日志查看器 HttpWatch Studio，专为深度分析日志文件而设计。","tags":["性能","网页","调试"]}},"publisherUrl":"https://www.httpwatch.com/","releaseDate":"2026-10-13","releaseDateSource":"manifest","releaseNotesUrl":"https://www.httpwatch.com/download/versionhistory/","schemaVersion":1,"source":"winget","upstream":{"commit":"97d6aa2689f0a05f7847653a62b8624720d15b5d","manifestVersion":"1.28.0","manifests":[{"path":"manifests/n/Neumetrix/HttpWatch/Basic/16.2.11/Neumetrix.HttpWatch.Basic.yaml","sha256":"3b987f455d134d4955d056634820387072347116a07562a3262858f12b9e1f05"},{"path":"manifests/n/Neumetrix/HttpWatch/Basic/16.2.11/Neumetrix.HttpWatch.Basic.installer.yaml","sha256":"3599c9aae887da0cc9bd98b28454ec742cbcc38cc8bacbe67776b14bee847519"},{"path":"manifests/n/Neumetrix/HttpWatch/Basic/16.2.11/Neumetrix.HttpWatch.Basic.locale.en-US.yaml","sha256":"ffdfec4f557636f716f1d2ba08778d5c2354f2338e8845c7605321c0a8cf0f43"},{"path":"manifests/n/Neumetrix/HttpWatch/Basic/16.2.11/Neumetrix.HttpWatch.Basic.locale.zh-CN.yaml","sha256":"e7cab372ea24f3afb40d0432cb38864404be1a0c09c7fa8326d4b2b2ec7d8e3a"}],"repository":"microsoft/winget-pkgs"},"version":"16.2.11"}