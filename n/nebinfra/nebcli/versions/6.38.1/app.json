{"defaultLocale":"en-US","id":"nebinfra.nebcli","installers":[{"architecture":"x64","commands":["nebcli"],"dependencies":[],"id":"x64-zip","nestedInstallerFiles":[{"PortableCommandAlias":"nebcli","RelativeFilePath":"nebcli.exe"}],"nestedInstallerType":"portable","priority":4,"sha256":"abdeb70e939af97a72778bb525b4210c569437e7f6f436469915bd5e6a807043","successCodes":[],"type":"zip","url":"https://github.com/nebinfra/nebcli-dist/releases/download/v6.38.1/nebcli_6.38.1_windows_amd64.zip"},{"architecture":"arm64","commands":["nebcli"],"dependencies":[],"id":"arm64-zip","nestedInstallerFiles":[{"PortableCommandAlias":"nebcli","RelativeFilePath":"nebcli.exe"}],"nestedInstallerType":"portable","priority":4,"sha256":"6f535d06440e38da5107826fc289712ff1e56fffa56421fad85c10af608c2050","successCodes":[],"type":"zip","url":"https://github.com/nebinfra/nebcli-dist/releases/download/v6.38.1/nebcli_6.38.1_windows_arm64.zip"}],"licenseUrl":"https://github.com/nebinfra/nebcli-dist/blob/main/LICENSE","packageLocalizations":{"en-US":{"author":"Nebinfra Technologies","copyright":"Copyright (c) 2026 Nebinfra Technologies. All rights reserved.","copyrightUrl":"https://github.com/nebinfra/nebcli-dist/blob/main/LICENSE","description":"Command-line tool for the NebCore platform that brokers short-lived cloud, cluster, and code-host credentials.","documentations":[{"DocumentLabel":"Authentication","DocumentUrl":"https://docs.nebcore.ai/nebcli/authentication"},{"DocumentLabel":"Commands","DocumentUrl":"https://docs.nebcore.ai/nebcli/commands"},{"DocumentLabel":"Installation","DocumentUrl":"https://docs.nebcore.ai/installation"},{"DocumentLabel":"Overview","DocumentUrl":"https://docs.nebcore.ai/nebcli"}],"license":"Proprietary","licenseUrl":"https://github.com/nebinfra/nebcli-dist/blob/main/LICENSE","locale":"en-US","longDescription":"NebCLI is the single command-line tool for working with the NebCore platform from your terminal. You sign in once, and NebCLI then hands short-lived credentials to the standard tools you already use, including aws, kubectl, helm, and git. It never creates or stores a long-lived secret. When a task needs cloud, cluster, registry, or code-host access, NebCLI requests a short-lived credential, writes it where the matching standard tool already looks, and steps aside. NebCLI also validates Helm charts against platform rules before they merge, sets up and inspects clusters from a written description, and runs a self-check that diagnoses sign-in and connectivity problems.","moniker":"nebcli","name":"NebCLI","packageUrl":"https://docs.nebcore.ai/nebcli","publisher":"Nebinfra Technologies","publisherSupportUrl":"https://github.com/nebinfra/nebcli-dist/issues","publisherUrl":"https://nebinfra.com/","releaseNotes":"Signed release artifacts for nebcli v6.38.1.\nVerify per the repository README before use.","releaseNotesUrl":"https://github.com/nebinfra/nebcli-dist/releases/tag/v6.38.1","tags":["aws","cli","credentials","developer-tools","devops","helm","kubernetes","nebcore"]}},"publisherSupportUrl":"https://github.com/nebinfra/nebcli-dist/issues","publisherUrl":"https://nebinfra.com/","releaseDate":"2026-11-10","releaseDateSource":"commit","releaseNotesUrl":"https://github.com/nebinfra/nebcli-dist/releases/tag/v6.38.1","schemaVersion":1,"source":"winget","upstream":{"commit":"5310ba65c96db682499ef1cca3c7244fabace7d5","manifestVersion":"1.28.0","manifests":[{"path":"manifests/n/nebinfra/nebcli/6.38.1/nebinfra.nebcli.installer.yaml","sha256":"6fa15fbdb1afab8c2451ec19a986a990595d6694310b8932053bc4af886ac045"},{"path":"manifests/n/nebinfra/nebcli/6.38.1/nebinfra.nebcli.locale.en-US.yaml","sha256":"edf7dcd648060f4f5bc3194dfc38bf47c227c16e06df8dfe4bff88fa80abdb0b"},{"path":"manifests/n/nebinfra/nebcli/6.38.1/nebinfra.nebcli.yaml","sha256":"43fddf8b7f74b55661b01dfa7de5ca36093e66bd6bd7d4fdad6830b2ffc47583"}],"repository":"microsoft/winget-pkgs"},"version":"6.38.1"}