s://service.nospamproxy.de/file/OutlookAddinSetupMSI/15.1"},{"appsAndFeaturesEntries":[{"UpgradeCode":"{AC4AC732-32ED-4A5C-9623-E28159870E65}"}],"architecture":"x86","dependencies":[{"PackageDependencies":[{"PackageIdentifier":"Microsoft.VSTOR"},{"PackageIdentifier":"Microsoft.Office"}]}],"elevation":{"requirement":"elevationRequired","source":"inferred"},"id":"x86-machine-zip","nestedInstallerFiles":[{"RelativeFilePath":"OutlookAddinX86.msi"}],"nestedInstallerType":"wix","priority":4,"scope":"machine","sha256":"ed868d640e645beefe8f92dbe408d81e086fc9e3dca01e3bb05ff57a6aa68827","successCodes":[],"type":"zip","uninstall":{"type":"productCode","value":"{608481FF-6DB4-4618-9CA3-2C19BC0EB174}"},"url":"https://service.nospamproxy.de/file/OutlookAddinSetupMSI/15.1"}],"licenseUrl":"https://www.nospamproxy.de/en/license-agreement/","packageLocalizations":{"en-US":{"description":"NoSpamProxy Outlook add-in for secure email communication","license":"Proprietary","licenseUrl":"https://www.nospamproxy.de/en/license-agreement/","locale":"en-US","longDescription":"Functions of the Outlook Add-In when composing emails\n- Automatic Encryption| Enables the delivery of encrypted emails to recipients who do not have cryptographic keys in their possession. NoSpamProxy Encryption automatically selects the appropriate delivery method nd delivers the email securely.\n- PDF Mail| Converts the email content with all attachments into a PDF document and secures this document with a password. This allows you to securely deliver emails with all attachments even to recipients without cryptographic keys.\n- S/MIME or PGP| Allows the signature and encryption of emails using cryptographic keys such as PGP key pairs or S/MIME certificates.\n- Large Files| Transfers large files via the NoSpamProxy Web Portal. Instead of the file, a link is attached to the email, with the help of which the recipient(s) of the email can download the files secured by SSL. The link can be protected by a password.\n- De-Mail: Displays all the delivery options available to you for De-Mail delivery.\nFunctions of the Outlook Add-In when reading emails\n- Decrypting PDF attachments| Decrypts password-protected PDF attachments and removes passwords.\n- Deleting passwords| Deletes previously saved PDF decryption passwords.","name":"NoSpamProxy Outlook add-in","packageUrl":"https://www.nospamproxy.de/en/download/","publisher":"Net at Work GmbH","publisherUrl":"https://www.nospamproxy.de/en/","releaseNotesUrl":"https://docs.nospamproxy.com/Server/15/Suite/en-gb/Content/release-notes/overview-server.htm","tags":[]},"zh-CN":{"description":"NoSpamProxy Outlook 加载项，用于安全的电子邮件通信。","license":"专有软件","locale":"zh-CN","longDescription":"撰写邮件时 Outlook 插件的功能\n- 自动加密 | 支持向未持有加密密钥的收件人发送加密邮件。NoSpamProxy 加密系统自动选择最佳投递方式，确保邮件安全送达。\n- PDF 邮件 | 将邮件内容及所有附件转换为 PDF 文档，并通过密码保护。即使收件人没有加密密钥，也能安全接收带附件的邮件。\n- S/MIME 或 PGP | 支持使用 PGP 密钥对或 S/MIME 证书对邮件进行签名和加密。\n- 大文件传输 | 通过 NoSpamProxy 网页门户传输大文件。邮件中附加下载链接（SSL 加密保护），收件人可通过链接下载文件，链接可设置密码保护。\n- De-Mail | 显示所有可用的 De-Mail 投递选项。\n阅读邮件时 Outlook 插件的功能\n- 解密 PDF 附件 | 解密受密码保护的 PDF 附件并移除密码。\n- 删除密码 | 清除之前保存的 PDF 解密密码。","tags":[]}},"publisherUrl":"https://www.nospamproxy.de/en/","releaseNotesUrl":"https://docs.nospamproxy.com/Server/15/Suite/en-gb/Content/release-notes/overview-server.htm","schemaVersion":1,"source":"winget","upstream":{"commit":"97d6aa2689f0a05f7847653a62b8624720d15b5d","manifestVersion":"1.10.0","manifests":[{"path":"manifests/n/NetAtWork/NoSpamProxyOutlookAddin/15.1.24220.1319/NetAtWork.NoSpamProxyOutlookAddin.yaml","sha256":"c59d69c8a272b5966fcb4ff5a13bead5440bb9662e71ce162c510f9ed0f2fd39"},{"path":"manifests/n/NetAtWork/NoSpamProxyOutlookAddin/15.1.24220.1319/NetAtWork.NoSpamProxyOutlookAddin.installer.yaml","sha256":"f43d9dae2ef2ac73e641fd0925b0add3ddf79b6f243a1676a61a161380aca51d"},{"path":"manifests/n/NetAtWork/NoSpamProxyOutlookAddin/15.1.24220.1319/NetAtWork.NoSpamProxyOutlookAddin.locale.en-US.yaml","sha256":"2364e84294fa82f5823257c658df789cb2d4f7f75af95