{"defaultLocale":"en-US","id":"NoMachine.NoMachine.SmallBusinessCloudServer","installers":[{"architecture":"x64","dependencies":[],"elevation":{"requirement":"elevatesSelf","source":"manifest"},"fileExtensions":["nxr","nxs","nxv","nxw"],"id":"x64-machine-inno","priority":1,"scope":"machine","sha256":"6588e456c143df4de40963db843e4c78c539ade5169fa5aa81d7c2aadcd725fa","silent":{"arguments":"/VERYSILENT /SUPPRESSMSGBOXES /NORESTART /SP-","source":"default"},"successCodes":[],"type":"inno","uninstall":{"type":"productCode","value":"NoMachine_is1"},"upgradeBehavior":"install","url":"https://download.nomachine.com/packages/8.16-PRODUCTION/Windows/nomachine-small-business-cloud-server_8.16.1_1_x64.exe"},{"architecture":"x86","dependencies":[],"elevation":{"requirement":"elevatesSelf","source":"manifest"},"fileExtensions":["nxr","nxs","nxv","nxw"],"id":"x86-machine-inno","priority":1,"scope":"machine","sha256":"b3ffdb8ee7746ecb727b4c7e6deffcbdb7d53fbf5db3c4d19b3da00b29e9b05e","silent":{"arguments":"/VERYSILENT /SUPPRESSMSGBOXES /NORESTART /SP-","source":"default"},"successCodes":[],"type":"inno","uninstall":{"type":"productCode","value":"NoMachine_is1"},"upgradeBehavior":"install","url":"https://download.nomachine.com/packages/8.16-PRODUCTION/Windows/nomachine-small-business-cloud-server_8.16.1_1_x86.exe"}],"licenseUrl":"https://www.nomachine.com/licensing","packageLocalizations":{"en-US":{"description":"Offers the same rich feature-set as Cloud Server and is perfect for single departments and design studios that need to provide centralized access to remote users from outside the private network.","license":"Proprietary","licenseUrl":"https://www.nomachine.com/licensing","locale":"en-US","longDescription":"NoMachine Small Business Cloud Server centralizes user access through a single gateway allowing NoMachine client devices to connect securely from outside the corporate network to remote desktops and servers residing inside. It is tailored for small teams and allows up to 10 simultaneous connections. Since any number of NoMachine nodes such as Enterprise Desktops or even Terminal Servers can be added to it, this mini connection broker is perfect for set-ups where there are multiple NoMachine-enabled desktops and computers, but only a few users requesting offsite remote access at any given time.","name":"NoMachine Small Business Cloud Server","packageUrl":"https://downloads.nomachine.com/","publisher":"NoMachine S.a.r.l.","publisherUrl":"https://www.nomachine.com/","releaseNotesUrl":"https://kb.nomachine.com/SU01W00264","tags":["remote","remote-access","remote-control","remote-desktop"]},"zh-CN":{"description":"提供与云服务器相同的丰富功能，是单部门及设计工作室的理想选择，可为私有网络外的远程用户提供集中访问。小型企业云服务器支持 10 个 NoMachine 工作站同时连接。","license":"专有软件","locale":"zh-CN","longDescription":"NoMachine 小型企业云服务器通过单一网关集中管理用户访问，允许 NoMachine 客户端设备从企业网络外部安全连接至内部的远程桌面和服务器。该方案专为小型团队设计，最多支持 10 个并发连接。由于可无限添加 NoMachine 节点（如企业版桌面甚至终端服务器），这款迷你连接代理完美适配以下场景：部署多台 NoMachine 设备，但任意时段仅需为少数用户提供异地远程访问。","tags":["远程","远程控制","远程桌面","远程访问","远程连接"]}},"publisherUrl":"https://www.nomachine.com/","releaseDate":"2025-01-28","releaseDateSource":"manifest","releaseNotesUrl":"https://kb.nomachine.com/SU01W00264","schemaVersion":1,"source":"winget","upstream":{"commit":"97d6aa2689f0a05f7847653a62b8624720d15b5d","manifestVersion":"1.10.0","manifests":[{"path":"manifests/n/NoMachine/NoMachine/SmallBusinessCloudServer/8.16.1/NoMachine.NoMachine.SmallBusinessCloudServer.yaml","sha256":"1e10297933eb134f5fcf08a9dd9d6c098e38c19a73f80bdcd68ffeeb2dcb4dc6"},{"path":"manifests/n/NoMachine/NoMachine/SmallBusinessCloudServer/8.16.1/NoMachine.NoMachine.SmallBusinessCloudServer.installer.yaml","sha256":"d1356ac3dfc1f84afd9efe3c808cb1a77ac1ac64de4dc197d5e0b5a465320a7b"},{"path":"manifests/n/NoMachine/NoMachine/SmallBusinessCloudServer/8.16.1/NoMachine.NoMachine.SmallBusinessCloudServer.locale.en-US.yaml","sha256":"e1264e74fa94923786b9bb8b545fdd97c760672d734e1bea6c0b06a0187919aa"},{"path":"manifests/n/NoMachine/NoMachine/SmallBu