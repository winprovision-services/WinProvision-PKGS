{"defaultLocale":"en-US","id":"NoMachine.NoMachine.EnterpriseCloudServer","installers":[{"architecture":"x64","dependencies":[],"elevation":{"requirement":"elevatesSelf","source":"manifest"},"fileExtensions":["nxr","nxs","nxv","nxw"],"id":"x64-machine-inno","priority":1,"scope":"machine","sha256":"591ce9167505f255f5f57000d111b868d83867b4da110458d2d3e39de2c41de8","silent":{"arguments":"/VERYSILENT /SUPPRESSMSGBOXES /NORESTART /SP-","source":"default"},"successCodes":[],"type":"inno","uninstall":{"type":"productCode","value":"NoMachine_is1"},"upgradeBehavior":"install","url":"https://web9001.nomachine.com/download/10.1/Windows/nomachine-enterprise-cloud-server_10.1.7_1_x64.exe"},{"architecture":"x86","dependencies":[],"elevation":{"requirement":"elevatesSelf","source":"manifest"},"fileExtensions":["nxr","nxs","nxv","nxw"],"id":"x86-machine-inno","priority":1,"scope":"machine","sha256":"d01060d44d89c591ae22c95d06e390c5ab9ce245c885f3ac5fc058ccb476f95d","silent":{"arguments":"/VERYSILENT /SUPPRESSMSGBOXES /NORESTART /SP-","source":"default"},"successCodes":[],"type":"inno","uninstall":{"type":"productCode","value":"NoMachine_is1"},"upgradeBehavior":"install","url":"https://web9001.nomachine.com/download/10.1/Windows/nomachine-enterprise-cloud-server_10.1.7_1_x86.exe"}],"licenseUrl":"https://www.nomachine.com/licensing","packageLocalizations":{"en-US":{"description":"A remote access gateway which securely tunnels connections to NoMachine Windows, macOS or Linux nodes as well as foreign Unix hosts residing on the corporate network.","license":"Proprietary","licenseUrl":"https://www.nomachine.com/licensing","locale":"en-US","longDescription":"NoMachine Enterprise Cloud Server provides centralized remote access for unlimited users permitting work-from-home employees or off-site students to reach their desktop, on any OS, regardless of where they are or what device they’re using. By adding NoMachine Enterprise Desktops, Workstations, Terminal Servers, Enterprise Terminal Servers, even another Cloud Server, to Enterprise Cloud Server, organizations can unify access to any corporate computer and hosted resource. It conveniently converges any number of NoMachine nodes and also foreign X servers such as HP-UX, Solaris and AIX hosts.","name":"NoMachine Enterprise Cloud Server","packageUrl":"https://downloads.nomachine.com/","publisher":"NoMachine S.a.r.l.","publisherUrl":"https://www.nomachine.com/","releaseNotesUrl":"https://kb.nomachine.com/SU09X00287","tags":["remote","remote-access","remote-control","remote-desktop"]},"zh-CN":{"description":"一款远程接入网关，可安全建立通往 NoMachine Windows、macOS 或 Linux 节点以及企业网络内外部 Unix 主机的加密隧道。该方案完美实现大规模用户群体的统一接入，支持无限用户通过任意设备（包括网页浏览器）进行连接。","license":"专有软件","locale":"zh-CN","longDescription":"NoMachine 企业级云服务器为无限用户提供集中式远程访问，使居家办公人员或校外师生能够跨操作系统、跨地域、跨设备接入专属桌面。通过将 NoMachine 企业级桌面、工作站、终端服务器、企业级终端服务器乃至其他云服务器整合至企业级云服务器平台，机构可实现对所有企业计算机及托管资源的统一访问。该系统不仅能无缝汇聚任意数量的 NoMachine 节点，还可兼容 HP-UX、Solaris 和 AIX 等第三方 X 服务器主机。","tags":["远程","远程控制","远程桌面","远程访问","远程连接"]}},"publisherUrl":"https://www.nomachine.com/","releaseDate":"2026-09-14","releaseDateSource":"manifest","releaseNotesUrl":"https://kb.nomachine.com/SU09X00287","schemaVersion":1,"source":"winget","upstream":{"commit":"97d6aa2689f0a05f7847653a62b8624720d15b5d","manifestVersion":"1.12.0","manifests":[{"path":"manifests/n/NoMachine/NoMachine/EnterpriseCloudServer/10.1.7/NoMachine.NoMachine.EnterpriseCloudServer.yaml","sha256":"85f1f1a0a57f014f5253383af875f817826eca8b984dd0a8d2a13bae209831e4"},{"path":"manifests/n/NoMachine/NoMachine/EnterpriseCloudServer/10.1.7/NoMachine.NoMachine.EnterpriseCloudServer.installer.yaml","sha256":"c857c6d92ca703b81dfba79a54c1d4f51dc603799eeff064fcddf31b8ea7454a"},{"path":"manifests/n/NoMachine/NoMachine/EnterpriseCloudServer/10.1.7/NoMachine.NoMachine.EnterpriseCloudServer.locale.en-US.yaml","sha256":"e6b6f04b2ba418f14ba66db9265558cfd1f8811a204c4a022a74a7356cd2652b"},{"path":"manifests/n/NoMachine/NoMachine/EnterpriseCloudServer/10.1.7/NoMachine.