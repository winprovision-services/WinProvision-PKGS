{"defaultLocale":"en-US","id":"NoMachine.NoMachine.CloudServer","installers":[{"architecture":"x64","dependencies":[],"elevation":{"requirement":"elevatesSelf","source":"manifest"},"fileExtensions":["nxr","nxs","nxv","nxw"],"id":"x64-machine-inno","priority":1,"scope":"machine","sha256":"b6c6b5c0822bfe1b5efc78734534550d02ed6697f1a0ce4e5530273522dca70b","silent":{"arguments":"/VERYSILENT /SUPPRESSMSGBOXES /NORESTART /SP-","source":"default"},"successCodes":[],"type":"inno","uninstall":{"type":"productCode","value":"NoMachine_is1"},"upgradeBehavior":"install","url":"https://web9001.nomachine.com/download/10.2/Windows/nomachine-cloud-server_10.2.3_1_x64.exe"},{"architecture":"x86","dependencies":[],"elevation":{"requirement":"elevatesSelf","source":"manifest"},"fileExtensions":["nxr","nxs","nxv","nxw"],"id":"x86-machine-inno","priority":1,"scope":"machine","sha256":"68ccfc2609af0984b0c380425696a54156fb5b5a7b745e8f9f8dcb028a0057d2","silent":{"arguments":"/VERYSILENT /SUPPRESSMSGBOXES /NORESTART /SP-","source":"default"},"successCodes":[],"type":"inno","uninstall":{"type":"productCode","value":"NoMachine_is1"},"upgradeBehavior":"install","url":"https://web9001.nomachine.com/download/10.2/Windows/nomachine-cloud-server_10.2.3_1_x86.exe"}],"licenseUrl":"https://www.nomachine.com/licensing","packageLocalizations":{"en-US":{"description":"For smaller deployments Cloud Server permits up to 20 connections, connecting users located outside the LAN to their NoMachine-enabled computers. Users can connect from any device or Web browser to Windows, Mac or Linux desktops on the corporate network.","license":"Proprietary","licenseUrl":"https://www.nomachine.com/licensing","locale":"en-US","longDescription":"NoMachine Cloud Server provides centralized remote access for up to 20 connections. Suitable for teams and small departments, it allows any organization to converge point-of-entry to desktops and computers on the corporate network. Administrators can securely consolidate access to NoMachine-enabled hosts, such as Enterprise Desktops, which have been added to the gateway, making sure that those resources are never exposed to the internet.","name":"NoMachine Cloud Server","packageUrl":"https://downloads.nomachine.com/","publisher":"NoMachine S.a.r.l.","publisherUrl":"https://www.nomachine.com/","releaseNotesUrl":"https://kb.nomachine.com/SU09X00287","tags":["remote","remote-access","remote-control","remote-desktop"]},"zh-CN":{"description":"对于较小规模的部署，NoMachine 云服务器支持最多 20 个连接，使局域网外的用户能够访问其启用 NoMachine 的计算机。用户可通过任意设备或网页浏览器连接至企业网络中的 Windows、Mac 或 Linux 桌面。","license":"专有软件","locale":"zh-CN","longDescription":"NoMachine 云服务器为最多 20 个连接提供集中式远程访问方案。该解决方案适合团队和小型部门使用，可帮助各类组织统一接入企业网络内的桌面和计算机。管理员能够安全地整合对已添加至网关的 NoMachine 主机（如企业桌面）的访问权限，确保这些资源永不暴露在公网环境中。","tags":["远程","远程控制","远程桌面","远程访问","远程连接"]}},"publisherUrl":"https://www.nomachine.com/","releaseNotesUrl":"https://kb.nomachine.com/SU09X00287","schemaVersion":1,"source":"winget","upstream":{"commit":"97d6aa2689f0a05f7847653a62b8624720d15b5d","manifestVersion":"1.12.0","manifests":[{"path":"manifests/n/NoMachine/NoMachine/CloudServer/10.2.3/NoMachine.NoMachine.CloudServer.yaml","sha256":"1794360d97d1ab3599474112b69991f98d0377e3b7f6abd6917dbcd4ff46db83"},{"path":"manifests/n/NoMachine/NoMachine/CloudServer/10.2.3/NoMachine.NoMachine.CloudServer.installer.yaml","sha256":"ee9ff618aeb0f09ac965494768140140a8010d4be9cac211ba07417ad08dbbf3"},{"path":"manifests/n/NoMachine/NoMachine/CloudServer/10.2.3/NoMachine.NoMachine.CloudServer.locale.en-US.yaml","sha256":"b1c83a43d181bb33b65f8b210d9eda11547cb5e53b03af7753f8512b22955e91"},{"path":"manifests/n/NoMachine/NoMachine/CloudServer/10.2.3/NoMachine.NoMachine.CloudServer.locale.zh-CN.yaml","sha256":"7366c3319599e8c6b57bd81e206a8d6e37ae524f273043fae6544eeb02d98ca5"}],"repository":"microsoft/winget-pkgs"},"version":"10.2.3"}