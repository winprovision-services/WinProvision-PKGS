{"defaultLocale":"en-US","id":"NoMachine.NoMachine.CloudServer","installers":[{"architecture":"x64","dependencies":[],"elevation":{"requirement":"elevatesSelf","source":"manifest"},"fileExtensions":["nxr","nxs","nxv","nxw"],"id":"x64-machine-inno","priority":1,"scope":"machine","sha256":"611bb127b5c7e18a3f2ad3f77260c0c2d6669ff1d4279120be576c9625ae4543","silent":{"arguments":"/VERYSILENT /SUPPRESSMSGBOXES /NORESTART /SP-","source":"default"},"successCodes":[],"type":"inno","uninstall":{"type":"productCode","value":"NoMachine_is1"},"upgradeBehavior":"install","url":"https://web9001.nomachine.com/download/10.1/Windows/nomachine-cloud-server_10.1.7_1_x64.exe"},{"architecture":"x86","dependencies":[],"elevation":{"requirement":"elevatesSelf","source":"manifest"},"fileExtensions":["nxr","nxs","nxv","nxw"],"id":"x86-machine-inno","priority":1,"scope":"machine","sha256":"420d5462e50a0fce9d9cbf0f1d88474864d32ba2cf278329d712dfc7d9e07f12","silent":{"arguments":"/VERYSILENT /SUPPRESSMSGBOXES /NORESTART /SP-","source":"default"},"successCodes":[],"type":"inno","uninstall":{"type":"productCode","value":"NoMachine_is1"},"upgradeBehavior":"install","url":"https://web9001.nomachine.com/download/10.1/Windows/nomachine-cloud-server_10.1.7_1_x86.exe"}],"licenseUrl":"https://www.nomachine.com/licensing","packageLocalizations":{"en-US":{"description":"For smaller deployments Cloud Server permits up to 20 connections, connecting users located outside the LAN to their NoMachine-enabled computers. Users can connect from any device or Web browser to Windows, Mac or Linux desktops on the corporate network.","license":"Proprietary","licenseUrl":"https://www.nomachine.com/licensing","locale":"en-US","longDescription":"NoMachine Cloud Server provides centralized remote access for up to 20 connections. Suitable for teams and small departments, it allows any organization to converge point-of-entry to desktops and computers on the corporate network. Administrators can securely consolidate access to