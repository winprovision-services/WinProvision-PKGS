{"defaultLocale":"en-US","id":"NoMachine.NoMachine.CloudServer","installers":[{"architecture":"x64","dependencies":[],"elevation":{"requirement":"elevatesSelf","source":"manifest"},"fileExtensions":["nxr","nxs","nxv","nxw"],"id":"x64-machine-inno","priority":1,"scope":"machine","sha256":"2f150fdaddc5b01bf1ae7d091ca035c4be7bee38d52dcb6035f92ea0b9510c48","silent":{"arguments":"/VERYSILENT /SUPPRESSMSGBOXES /NORESTART /SP-","source":"default"},"successCodes":[],"type":"inno","uninstall":{"type":"productCode","value":"NoMachine_is1"},"upgradeBehavior":"install","url":"https://download.nomachine.com/packages/8.16-PRODUCTION/Windows/nomachine-cloud-server_8.16.1_1_x64.exe"},{"architecture":"x86","dependencies":[],"elevation":{"requirement":"elevatesSelf","source":"manifest"},"fileExtensions":["nxr","nxs","nxv","nxw"],"id":"x86-machine-inno","priority":1,"scope":"machine","sha256":"28e03aaa5faba76f563427d77d1dc5af128991e0f2e6796514b0703cd09b0bf2","silent":{"arguments":"/VERYSILENT /SUPPRESSMSGBOXES /NORESTART /SP-","source":"default"},"successCodes":[],"type":"inno","uninstall":{"type":"productCode","value":"NoMachine_is1"},"upgradeBehavior":"install","url":"https://download.nomachine.com/packages/8.16-PRODUCTION/Windows/nomachine-cloud-server_8.16.1_1_x86.exe"}],"licenseUrl":"https://www.nomachine.com/licensing","packageLocalizations":{"en-US":{"description":"For smaller deployments Cloud Server permits up to 20 connections, connecting users located outside the LAN to their NoMachine-enabled computers. Users can connect from any device or Web browser to Windows, Mac or Linux desktops on the corporate network.","license":"Proprietary","licenseUrl":"https://www.nomachine.com/licensing","locale":"en-US","longDescription":"NoMachine Cloud Server provides centralized remote access for up to 20 connections. Suitable for teams and small departments, it allows any organization to converge point-of-entry to desktops and computers on the corporate network. Administrators can secure