{"defaultLocale":"en-US","id":"zhitongblog.Ziplark","installers":[{"architecture":"x64","dependencies":[],"id":"x64-user-nullsoft","installModes":["silent","silentWithProgress"],"priority":1,"scope":"user","sha256":"05a447d04c9cc234e9d72e1e795d4ed5f626e8831db8d20ed3ab8d5b799a4bc5","silent":{"arguments":"/S","source":"default"},"successCodes":[],"type":"nullsoft","upgradeBehavior":"install","url":"https://github.com/zhitongblog/ziplark/releases/download/v0.2.2/Ziplark_0.2.2_x64-setup.exe"}],"licenseUrl":"https://github.com/zhitongblog/ziplark/blob/main/LICENSE","packageLocalizations":{"en-US":{"description":"Free, fast, cross-platform archiver (ZIP/RAR/7z/tar/ISO) with a desktop app, CLI and MCP server.","license":"MIT","licenseUrl":"https://github.com/zhitongblog/ziplark/blob/main/LICENSE","locale":"en-US","longDescription":"Ziplark extracts ZIP, RAR (incl. RAR5 and encrypted), 7z, tar, the compressed-tar\nvariants (tar.gz/.bz2/.xz/.zst/.lz4), single-stream gz/bz2/xz/zst/lz4, and ISO 9660 /\nJoliet disc images. It creates ZIP (AES-256), 7z (AES-256) and tar archives.\n\nOne small Rust engine drives three front-ends over the exact same code: a desktop app,\nthe ziplark command-line tool, and an MCP server so an LLM or agent can list, extract,\ntest and create archives itself.\n\nEvery extraction path is funnelled through a single zip-slip guard, so no entry can\nescape the destination directory. Free and open source (MIT), no ads, no telemetry.","moniker":"ziplark","name":"Ziplark","packageUrl":"https://ziplark.com","publisher":"zhitongblog","publisherUrl":"https://github.com/zhitongblog","releaseNotesUrl":"https://github.com/zhitongblog/ziplark/releases/tag/v0.2.2","tags":["7z","archive","archiver","compression","iso","mcp","rar","tar","unzip","zip","zstd"]}},"publisherUrl":"https://github.com/zhitongblog","releaseDate":"2026-08-27","releaseDateSource":"manifest","releaseNotesUrl":"https://github.com/zhitongblog/ziplark/releases/tag/v0.2.2","schemaVersion":1,"source