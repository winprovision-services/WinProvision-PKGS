{"defaultLocale":"en-US","id":"zachtbeer.SqlDataPack","installers":[{"architecture":"arm64","commands":["sqldatapack"],"dependencies":[],"id":"arm64-portable","minimumOSVersion":"10.0.14393.0","priority":4,"sha256":"5009f31ad6b4ba53ba24a555a354a89df526ffb27e73c73083638ac2a6fb486a","successCodes":[],"type":"portable","url":"https://github.com/zachtbeer/sqldatapack/releases/download/v1.1.0/sqldatapack-win-arm64.exe"},{"architecture":"x64","commands":["sqldatapack"],"dependencies":[],"id":"x64-portable","minimumOSVersion":"10.0.14393.0","priority":4,"sha256":"9e176dec1e88d21543fdfe7d5d8e958da160b8c5ebf22ffb7f39563dae55645b","successCodes":[],"type":"portable","url":"https://github.com/zachtbeer/sqldatapack/releases/download/v1.1.0/sqldatapack-win-x64.exe"}],"licenseUrl":"https://github.com/zachtbeer/sqldatapack/blob/main/LICENSE","packageLocalizations":{"en-US":{"description":"Export a slice of a SQL Server database into a single SQLite file, and import it back.","license":"MIT","licenseUrl":"https://github.com/zachtbeer/sqldatapack/blob/main/LICENSE","locale":"en-US","longDescription":"SqlDataPack exports part of a SQL Server database into one SQLite file and imports it back\ninto SQL Server. It is not a backup: you choose which tables, columns and rows come out.\n\nThe file it produces is ordinary SQLite, so you can open it in any SQLite tool and UPDATE,\nDELETE or INSERT before importing. That is how you cut a masked dev slice, hand a customer\na bug repro, or give someone a dataset without giving them access to the source.\n\nNothing is installed on the SQL Server. There is no telemetry and no outbound connection\nexcept to the server in your connection string.","moniker":"sqldatapack","name":"SqlDataPack","packageUrl":"https://github.com/zachtbeer/sqldatapack","publisher":"zachtbeer","publisherUrl":"https://github.com/zachtbeer","releaseNotesUrl":"https://github.com/zachtbeer/sqldatapack/releases/tag/v1.1.0","tags":["sql-server","sqlite","database","export","impor