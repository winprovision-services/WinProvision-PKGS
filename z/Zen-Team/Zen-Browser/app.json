{"architectures":["arm64","neutral","x64","x86"],"id":"Zen-Team.Zen-Browser","latestVersion":"1.24.1b","media":{"icons":[{"mimeType":"image/png","path":"media/icon.3ac89e24.png","priority":1,"sha256":"3ac89e24c4f20e227c8498f051a36140204fa2f77385223b60bddd604bb0b68f","source":"winget-legacy"}],"screenshots":[]},"package":{"copyright":"Zen OSS Team","description":"Zen is the best way to browse the web. Beautifully designed, privacy-focused, and packed with features. We care about your experience, not your data.","documentations":[{"DocumentLabel":"About","DocumentUrl":"https://zen-browser.app/about/"},{"DocumentLabel":"Documentation","DocumentUrl":"https://docs.zen-browser.app/"}],"license":"MPL-2.0","licenseUrl":"https://github.com/zen-browser/desktop/blob/HEAD/LICENSE","locale":"en-US","localizations":{"en-US":{"copyright":"Zen OSS Team","description":"Zen is the best way to browse the web. Beautifully designed, privacy-focused, and packed with features. We care about your experience, not your data.","documentations":[{"DocumentLabel":"About","DocumentUrl":"https://zen-browser.app/about/"},{"DocumentLabel":"Documentation","DocumentUrl":"https://docs.zen-browser.app/"}],"license":"MPL-2.0","licenseUrl":"https://github.com/zen-browser/desktop/blob/HEAD/LICENSE","locale":"en-US","moniker":"zen-browser","name":"Zen Browser","packageUrl":"https://zen-browser.app/","privacyUrl":"https://zen-browser.app/privacy-policy/","publisher":"Zen OSS Team","publisherSupportUrl":"https://github.com/zen-browser/desktop/issues","publisherUrl":"https://zen-browser.app/","releaseNotes":"Zen Stable Release\n\nSecurity\n- https://www.mozilla.org/en-US/security/advisories/mfsa2026-123/\n\nNew Features\n- Updated to Firefox 159.0.1\n- New grain options have been added to the theme picker. You can cycle through different grain effects by clicking on the circle inside the dial.\n\nFixes\n- Fixed a command prompt window briefly appearing on Windows when Zen restarts to apply an update.\n- Fixed