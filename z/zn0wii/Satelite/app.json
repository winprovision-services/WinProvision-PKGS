{"architectures":["x64"],"id":"zn0wii.Satelite","latestVersion":"1.0.46","media":{"icons":[],"screenshots":[]},"package":{"description":"一个轻量、好看的 sing-box 桌面代理客户端，基于 Tauri 2 + React + Rust 构建，支持 macOS 与 Windows。","license":"Apache-2.0","licenseUrl":"https://github.com/zn0wii/satelite-proxy/blob/HEAD/LICENSE","locale":"zh-CN","localizations":{"en-US":{"description":"A lightweight and modern proxy client for macOS and Windows, featuring subscription management, node switching, TUN mode, smart DNS, traffic monitoring and rule-based routing.","locale":"en-US","longDescription":"Satelite Proxy is a lightweight sing-box desktop proxy client built with Tauri 2, React and Rust. It supports importing Clash-compatible subscriptions by link or file, switching between SS, VMess, VLESS, Trojan, Hysteria2, TUIC, SOCKS5, AnyTLS and Snell nodes with one-click speed tests, rule-based routing with cached remote rule sets, smart DNS with DoH, DoT and FakeIP, system proxy and TUN mode, live connection and traffic monitoring, and a tray-resident background connection with auto-start.","tags":["clash","clash-meta","clash-verge","mihomo","network","proxy","vpn"]},"zh-CN":{"description":"一个轻量、好看的 sing-box 桌面代理客户端，基于 Tauri 2 + React + Rust 构建，支持 macOS 与 Windows。","license":"Apache-2.0","licenseUrl":"https://github.com/zn0wii/satelite-proxy/blob/HEAD/LICENSE","locale":"zh-CN","longDescription":"Satelite Proxy 是一个基于 Tauri 2、React 和 Rust 构建的轻量级 sing-box 桌面代理客户端。支持导入 Clash 兼容订阅（链接导入、文件导入、浏览器一键导入），在 SS、VMess、VLESS、Trojan、Hysteria2、TUIC、SOCKS5、AnyTLS、Snell 等协议节点间一键测速与快速切换，基于规则集的分流（支持远程规则集自动缓存），支持 DoH、DoT、FakeIP 的智能 DNS，系统代理与 TUN 模式，实时连接与流量监控，以及常驻托盘的自动启动与静默启动。","name":"Satelite","packageUrl":"https://github.com/zn0wii/satelite-proxy","publisher":"satelite","publisherUrl":"https://github.com/zn0wii","releaseNotesUrl":"https://github.com/zn0wii/satelite-proxy/releases/tag/v1.0.46","tags":["clash","clash-meta","clash-verge","mihomo","vpn","代理","网络"]}},"longDescription":"Satelite Proxy 是一个基于 Tauri 2、React 和 Rust 构建的轻量级 sing-box 桌面代理客户端。支持导入 Clash 兼容订阅（链接导入、文件导入、浏览器一键导入），在 SS、VMess、VLESS、Trojan、Hysteria2、TUIC、SOCKS5、AnyTLS、Snell 等协议节点间一键测速与快速切换，基于规则集的分流（支持远程规则集自动缓存），支持 DoH、DoT、FakeIP 的智能 DNS，系统代理与 TUN 模式，实时连接与流量监控，以及常驻托盘的自动启动与静默启动。","name":"Satelite","packageUrl":"https://github.com/zn0wii/satelite-proxy","publisher":"satelite","publisherUrl":"https://github.com/zn0wii","releaseNotesUrl":"https://github.com/zn0wii/satelite-proxy/releases/tag/v1.0.46","tags":["clash","clash-meta","clash-verge","mihomo","vpn","代理","网络"]},"schemaVersion":1,"source":"winget","versions":[{"architectures":["x64"],"detailPath":"versions/1.0.46/app.json","detailSha256":"b2c827c19093df3954dbd828e4615115f355645303ab36a9b339640d1fb3fe24","releaseDate":"2026-10-03","releaseDateSource":"manifest","version":"1.0.46"},{"architectures":["x64"],"detailPath":"versions/1.0.45/app.json","detailSha256":"7b0d7acdb561e93a2ba258dab1599fdad2cce850a6cfa0ecbcd7b42bf1c0d047","releaseDate":"2026-09-25","releaseDateSource":"manifest","version":"1.0.45"},{"architectures":["x64"],"detailPath":"versions/1.0.44/app.json","detailSha256":"0cc28976174b9e5d6f03207dc56f8c81683528009b39df56ee3cf8f3973dd646","releaseDate":"2026-09-24","releaseDateSource":"manifest","version":"1.0.44"},{"architectures":["x64"],"detailPath":"versions/1.0.43/app.json","detailSha256":"772f6d3dda5eed7aebe3b25b19e2f8cdcc5d2290796519264c6d73929e48e8f5","releaseDate":"2026-09-24","releaseDateSource":"manifest","version":"1.0.43"},{"architectures":["x64"],"detailPath":"versions/1.0.42/app.json","detailSha256":"90bd26f080d8a73f06566675af34985d7d9d353c8ba83b864ff566fc7ca7769d","releaseDate":"2026-09-24","releaseDateSource":"manifest","version":"1.0.42"},{"architectures":["x64"],"detailPath":"versions/1.0.40/app.json","detailSha256":"d5e9d5e67b48567af18b65b7000ca8812cfc99f6ca1639385ce3fbc49a30d64b","releaseDate":"2026-09-22","releaseDateSource":"manifest","version":"1.0.40"},{"architectures":["x64"],"detailPath":"versions/1.0.39/app.json","detailSh