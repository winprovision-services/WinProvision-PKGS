{"architectures":["arm64","x64"],"id":"Zoid.Meru","latestVersion":"3.64.2","media":{"icons":[],"screenshots":[]},"package":{"author":"Zoid Ltd","copyright":"Copyright (C) 2026-present Tim Cheung <tim@meru.so>","copyrightUrl":"https://meru.so/terms","description":"The Gmail experience you deserve","documentations":[{"DocumentLabel":"FAQ","DocumentUrl":"https://meru.so/#faq"}],"license":"AGPL-3.0","licenseUrl":"https://github.com/zoidsh/meru/blob/HEAD/LICENSE","locale":"en-US","localizations":{"en-US":{"author":"Zoid Ltd","copyright":"Copyright (C) 2026-present Tim Cheung <tim@meru.so>","copyrightUrl":"https://meru.so/terms","description":"The Gmail experience you deserve","documentations":[{"DocumentLabel":"FAQ","DocumentUrl":"https://meru.so/#faq"}],"license":"AGPL-3.0","licenseUrl":"https://github.com/zoidsh/meru/blob/HEAD/LICENSE","locale":"en-US","longDescription":"Meru is an open-source desktop application that brings your Gmail experience out of the browser and onto your desktop. It provides a cleaner, more focused way to access and manage your Gmail account(s).","name":"Meru","packageUrl":"https://meru.so/download","privacyUrl":"https://meru.so/privacy","publisher":"Tim Cheung","publisherSupportUrl":"https://github.com/zoidsh/meru/issues","publisherUrl":"https://meru.so/","purchaseUrl":"https://meru.so/#pricing","releaseNotes":"Fixed\n- Copy Link Address, Copy Image Address and Copy Email Address in the right-click menu copy again, where they had stopped doing anything.\n- Save Image As… in the right-click menu always asks where to save, starting in your download location, where it could save without asking or start in your Downloads folder.\n- Save Image As… no longer clears the unread count on Meru's Dock icon.\n- A download that loses its connection shows an error, in your language, and appears in your download history, where it failed silently and left the progress bar stuck.\n- Downloading two files of the same name at once keeps both, even when only their case differs, where one could overwrite the other.\n- A downloaded file with no extension in its name gets the usual one for its type, such as .jpg or .txt, where many common types got none.\n- The download notification shows a file name with text like \\x41 in it as saved, where it decoded that text into another character.\n- Cancelling a save dialog no longer adds a blank row to your download history.\n- The progress bar counts downloads from all your accounts together.\n- Clicking a link in Settings… → What's new opens it in your browser, instead of replacing Meru's window with the page.","releaseNotesUrl":"https://github.com/zoidsh/meru/releases/tag/v3.64.2","tags":["email","gmail","mail"]},"zh-CN":{"description":"您值得拥有的 Gmail 体验","documentations":[{"DocumentLabel":"常见问题","DocumentUrl":"https://meru.so/#faq"}],"locale":"zh-CN","longDescription":"Meru 是一个开源桌面应用程序，它将您的 Gmail 使用体验从浏览器带到桌面。它提供了一种更简洁、更专注的方式来访问和管理您的 Gmail 帐户。","tags":["gmail","电子邮件","邮件"]}},"longDescription":"Meru is an open-source desktop application that brings your Gmail experience out of the browser and onto your desktop. It provides a cleaner, more focused way to access and manage your Gmail account(s).","name":"Meru","packageUrl":"https://meru.so/download","privacyUrl":"https://meru.so/privacy","publisher":"Tim Cheung","publisherSupportUrl":"https://github.com/zoidsh/meru/issues","publisherUrl":"https://meru.so/","purchaseUrl":"https://meru.so/#pricing","releaseNotes":"Fixed\n- Copy Link Address, Copy Image Address and Copy Email Address in the right-click menu copy again, where they had stopped doing anything.\n- Save Image As… in the right-click menu always asks where to save, starting in your download location, where it could save without asking or start in your Downloads folder.\n- Save Image As… no longer clears the unread count on Meru's Dock icon.\n- A download that loses its connection shows an error, in your language, and appears in your download history, where it failed silently and left the progress bar stuck.\n- Downloading two files of the same name at once keeps both, even when only their case differs, where one could overwrite the other.\n- A downloaded file with no extension in its name gets the usual one for its type, such as .jpg or .txt, where many common types got none.\n- The download notification shows a file name with text like \\x41 in it as saved, where it decoded that text into another character.\n- Cancelling a save dialog no longer adds a blank row to your download history.\n- The progress bar counts downloads from all your accounts together.\n- Clicking a link in Settings… → What's new opens it in your browser, instead of replacing Meru's window with the page.","releaseNotesUrl":"https://github.com/zoidsh/meru/releases/tag/v3.64.2","tags":["email","gmail","mail"]},"schemaVersion":1,"source":"winget","versions":[{"architectures":["arm64","x64"],"detailPath":"versions/3.64.2/app.json","detailSha256":"712ff01163d75688d8461c97f1244fffbeba8b5ee6db80379ba86752697049c0","releaseDate":"2026-11-05","releaseDateSource":"commit","version":"3.64.2"},{"architectures":["arm64","x64"],"detailPath":"versions/3.64.1/app.json","detailSha256":"ed7290b251a6e564291cbcc4a94bf65a96645436203cf898815c2c989faaaad1","releaseDate":"2026-11-02","releaseDateSource":"manifest","version":"3.64.1"},{"architectures":["arm64","x64"],"detailPath":"versions/3.64.0/app.json","detailSha256":"c1b4aeb84861b3510f04b7302893ee2c04a881dd864c5b37798761f9ae2e6811","releaseDate":"2026-11-02","releaseDateSource":"manifest","version":"3.64.0"},{"architectures":["arm64","x64"],"detailPath":"versions/3.63.2/app.json","detailSha256":"127c619a69b1bafe3bba339c0bc3de08a524fed96c0d35fdb2f0e3765cbcbac1","releaseDate":"2026-10-09","releaseDateSource":"manifest","version":"3.63.2"},{"architectures":["arm64","x64"],"detailPath":"versions/3.63.1/app.json","detailSha256":"d0bd54367dd1b4a4f7ab91b5cab8c6086e97f5f188f65cccc5b604b4bf5fe9fd","releaseDate":"2026-10-07","releaseDateSource":"man