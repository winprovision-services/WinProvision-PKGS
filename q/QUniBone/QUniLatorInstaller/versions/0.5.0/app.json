{"defaultLocale":"en-US","id":"QUniBone.QUniLatorInstaller","installers":[{"architecture":"x64","commands":["qunilator-installer"],"dependencies":[],"id":"x64-portable","priority":4,"sha256":"fdbbd385c04559d02ffe628e533a9e85e9e6e0f26b9412814bf875cadadd4dcb","successCodes":[],"type":"portable","url":"https://github.com/QUniBone/qunilator-installer/releases/download/v0.5.0/qunilator-installer-windows-amd64.exe"}],"licenseUrl":"https://github.com/QUniBone/qunilator-installer/blob/main/LICENSE","packageLocalizations":{"en-US":{"description":"Writes a QUniLator image to an SD card and sets the card up before it boots","license":"BSD-2-Clause","licenseUrl":"https://github.com/QUniBone/qunilator-installer/blob/main/LICENSE","locale":"en-US","longDescription":"QUniLator drives a real UNIBUS or QBUS backplane from a BeagleBone Black, so a\nPDP-11 can boot from emulated disks and tapes. This writes its release image to\nan SD card: it fetches the release, writes the card, reads back what it wrote,\nand can settle the operator identity, host name, ssh keys and network address\non the card before it has ever booted.\n\nWriting a raw disk needs administrator rights, which it asks for as it starts.","moniker":"qunilator-installer","name":"QUniLator Installer","packageUrl":"https://github.com/QUniBone/qunilator-installer","publisher":"QUniBone","publisherUrl":"https://github.com/QUniBone","releaseNotesUrl":"https://github.com/QUniBone/qunilator-installer/releases/tag/v0.5.0","tags":["beaglebone","dec","emulator","imaging","pdp-11","sd-card","unibus"]}},"publisherUrl":"https://github.com/QUniBone","releaseDate":"2026-08-08","releaseDateSource":"manifest","releaseNotesUrl":"https://github.com/QUniBone/qunilator-installer/releases/tag/v0.5.0","schemaVersion":1,"source":"winget","upstream":{"commit":"97d6aa2689f0a05f7847653a62b8624720d15b5d","manifestVersion":"1.12.0","manifests":[{"path":"manifests/q/QUniBone/QUniLatorInstaller/0.5.0/QUniBone.QUniLatorInstaller.yaml","sha256":"694e39