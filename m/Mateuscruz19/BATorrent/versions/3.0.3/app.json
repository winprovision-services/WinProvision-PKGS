{"defaultLocale":"en-US","id":"Mateuscruz19.BATorrent","installers":[{"appsAndFeaturesEntries":[{"DisplayName":"BATorrent","DisplayVersion":"3.0.3","ProductCode":"BATorrent_is1","Publisher":"Mateuscruz19"}],"architecture":"x64","dependencies":[{"PackageDependencies":[{"PackageIdentifier":"Microsoft.VCRedist.2015+.x64"}]}],"id":"x64-user-inno","installModes":["interactive","silent","silentWithProgress"],"minimumOSVersion":"10.0.0.0","priority":1,"scope":"user","sha256":"ce0430f3b860390fce3b60f1457a829e13f42636dd32e6cd70bca3bf0f3f6af8","silent":{"arguments":"/VERYSILENT /SUPPRESSMSGBOXES /NORESTART /SP-","source":"default"},"successCodes":[],"type":"inno","upgradeBehavior":"install","url":"https://github.com/Mateuscruz19/BATorrent/releases/download/v3.0.3/BATorrent-setup-x86_64.exe"}],"licenseUrl":"https://github.com/Mateuscruz19/BATorrent/blob/main/LICENSE","packageLocalizations":{"en-US":{"description":"A privacy-first BitTorrent client with movie & game cover art, six themes, and zero ads.","license":"MIT","licenseUrl":"https://github.com/Mateuscruz19/BATorrent/blob/main/LICENSE","locale":"en-US","longDescription":"BATorrent is a free, open-source BitTorrent client for Windows, macOS, and Linux, built in C++/Qt 6 on the libtorrent engine. It shows your downloads as a grid of real movie, series, and game cover art (TMDB + IGDB) and can be themed six ways. It is privacy-first: VPN interface binding with a kill switch that drops all traffic if the tunnel dies, a Tor preset, anonymous handshake, and anti-leecher blocking. It also includes a browser WebUI with QR pairing, built-in search, RSS auto-download, stream-while-downloading, and Plex/Jellyfin/Emby library refresh. No ads, no telemetry, no \"Pro\" tier, and no account required.","moniker":"batorrent","name":"BATorrent","packageUrl":"https://github.com/Mateuscruz19/BATorrent","publisher":"Mateus Cruz","publisherUrl":"https://github.com/Mateuscruz19","releaseNotesUrl":"https://github.com/Mateuscruz19/BATorrent/rele