ewer.com/files/RadiAnt-2026.1-Setup.exe"},{"architecture":"x86","dependencies":[],"elevation":{"requirement":"elevationRequired","source":"manifest"},"fileExtensions":["dcm","dmz","rdvaddon","rdvdb"],"id":"x86-machine-nullsoft","priority":1,"scope":"machine","sha256":"bdb5c8ccc2dc72c6386998a9760121a0a295dd01b95e3e5703b8e302b61dd6dc","silent":{"arguments":"/S","source":"default"},"successCodes":[],"type":"nullsoft","uninstall":{"type":"productCode","value":"RadiAnt"},"upgradeBehavior":"install","url":"https://www.radiantviewer.com/files/RadiAnt-2026.1-Setup.exe"},{"architecture":"x86","dependencies":[],"fileExtensions":["dcm","dmz","rdvaddon","rdvdb"],"id":"x86-user-nullsoft","priority":1,"scope":"user","sha256":"bdb5c8ccc2dc72c6386998a9760121a0a295dd01b95e3e5703b8e302b61dd6dc","silent":{"arguments":"/S","source":"default"},"successCodes":[],"type":"nullsoft","uninstall":{"type":"productCode","value":"RadiAnt"},"upgradeBehavior":"install","url":"https://www.radiantviewer.com/files/RadiAnt-2026.1-Setup.exe"}],"licenseUrl":"https://www.radiantviewer.com/terms/","packageLocalizations":{"en-US":{"description":"A PACS DICOM viewer for medical images designed to provide you with a unique experience.","license":"Proprietary","licenseUrl":"https://www.radiantviewer.com/terms/","locale":"en-US","longDescription":"RadiAnt DICOM Viewer is an application for processing and displaying medical images in DICOM format (Digital Imaging and Communications in Medicine).\n\nThe viewer allows users to open studies from CD/DVD/BluRay disks, flash memory, local and network folders, and PACS locations.\n\nStudies obtained from different imaging modalities can be displayed in RadiAnt DICOM Viewer:\n- Digital Radiography (CR, DX)\n- Mammography, Digital Breast Tomosynthesis (MG)\n- Computed Tomography (CT)\n- Magnetic Resonance (MR)\n- Positron Emission Tomography PET-CT (PT)\n- Ultrasonography (US, IVUS)\n- Digital Angiography (XA)\n- Gamma camera, Nuclear medicine (NM)\n- Secondary Pictures and Scanned Images (SC)\n- Endoscopy (ES)\n- Microscopy (SM, GM)\n- Structured Reports (SR)\n- Encapsulated PDF Documents (OT)\n\nThe viewer can handle many types of DICOM images:\n- Monochromatic (e.g. CR, CT, MR) and color (e.g. US, 3D reconstruction)\n- Static images (e.g. CR, MG, CT) and dynamic sequences (e.g. XA, US)\n- Uncompressed and compressed (RLE, JPEG Lossy, JPEG Lossless, JPEG 2000, JPEG-LS)\n- MPEG2/MPEG4 compressed video files","name":"RadiAnt DICOM Viewer","packageUrl":"https://www.radiantviewer.com/products/radiant-dicom-viewer-standard/","publisher":"Medixant","publisherUrl":"https://www.radiantviewer.com/","releaseNotesUrl":"https://www.radiantviewer.com/products/versions/standard/","tags":["dicom","medical-imaging"]},"zh-CN":{"description":"专为医疗影像设计的 PACS DICOM 阅片系统，为您带来非凡体验。","license":"专有软件","locale":"zh-CN","longDescription":"RadiAnt DICOM Viewer 是一款专用于处理和显示 DICOM 格式（Digital Imaging and Communications in Medicine，医学数字成像与通信）医学影像的应用程序。\n该查看器支持从以下来源打开医学影像研究：\n- CD/DVD/蓝光光盘\n- 闪存设备\n- 本地及网络文件夹\n- PACS 存储系统\n\nRadiAnt DICOM Viewer 可显示来自不同成像模态的医学影像研究：\n- 数字 X 线摄影（CR、DX）\n- 乳腺 X 线摄影及数字乳腺断层合成（MG）\n- 计算机断层扫描（CT）\n- 磁共振成像（MR）\n- 正电子发射断层扫描 PET-CT（PT）\n- 超声检查（US、血管内超声 IVUS）\n- 数字血管造影（XA）\n- 伽马相机及核医学成像（NM）\n- 二次采集图像与扫描影像（SC）\n- 内窥镜检查（ES）\n- 显微镜成像（SM、GM）\n- 结构化报告（SR）\n- 封装 PDF 文档（OT）\n\n该查看器支持处理多种类型的 DICOM 影像：\n- 单色影像（如 CR、CT、MR）与彩色影像（如超声、三维重建）\n- 静态图像（如 CR、MG、CT）与动态序列（如 XA、US）\n- 未压缩及压缩格式（RLE、JPEG 有损、JPEG 无损、JPEG 2000、JPEG-LS）\n- MPEG2/MPEG4 压缩视频文件","tags":["dicom","医学成像"]}},"publisherUrl":"https://www.radiantviewer.com/","releaseDate":"2026-07-14","releaseDateSource":"manifest","releaseNotesUrl":"https://www.radiantviewer.com/products/versions/standard/","schemaVersion":1,"source":"winget","upstream":{"commit":"97d6aa2689f0a05f7847653a62b8624720d15b5d","manifestVersion":"1.12.0","manifests":[{"path":"manifests/m/Medixant/RadiAntDICOMViewer/2026.1/Medixant.RadiAntDICOMViewer.yaml","sha256":"75077503ad26a276c6a77386813bf1dbdea1ffaa0dd7bfe31265c99ff8987149"},{"path":"manifests/m/Medixant/RadiAntDICOMViewer/2026.1/Medixant.RadiAntDICOMViewer.installer.yaml","sha256":"5a32907d1e0d54d8a4d959fe8c3762bd41f77864fe3b09ec3063e3f240fa7e92"},{"path":"manifests/m/Medixant/RadiAntDICOMViewer/2026.1/Medixant.RadiAntDICOMViewer.locale.en-US.yaml","sha256":"2a51f9aeb9714d9ffe32e6ba4cf56859d2763d71eecbc7739af4658493f3b5c6"},{"path":"manifests/m/Medixant/RadiAntDICOMViewer/2026.1/Medixant.RadiAntDICOMViewer.locale.zh-CN.yaml","sha256":"efa6728cd38545becb5787df9b1e8ece49c6d96f8708cd26537d458b914699f2"}],"repository":"microsoft/winget-pkgs"},"version":"2026.1"}