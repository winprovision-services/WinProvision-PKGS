{"defaultLocale":"en-US","id":"MBrassey.agtop","installers":[{"architecture":"x64","dependencies":[],"id":"x64-zip","nestedInstallerFiles":[{"PortableCommandAlias":"agtop","RelativeFilePath":"agtop-windows-x86_64\\agtop.exe"}],"nestedInstallerType":"portable","priority":4,"sha256":"60bc4fd3915b7537e87f8edbbd7ecf1fef87ddce3c02726e971df0c5e09a2b62","successCodes":[],"type":"zip","url":"https://github.com/MBrassey/agtop/releases/download/v2.4.19/agtop-windows-x86_64.zip"}],"licenseUrl":"https://github.com/MBrassey/agtop/blob/main/LICENSE","packageLocalizations":{"en-US":{"description":"Process monitor for AI coding agents (Claude Code, Codex, Aider, Gemini, Goose).","license":"MIT","licenseUrl":"https://github.com/MBrassey/agtop/blob/main/LICENSE","locale":"en-US","longDescription":"agtop is a top-style ratatui TUI that walks /proc on Linux\n(sysinfo on Windows / macOS / *BSD) plus the on-disk session\ntranscripts of Claude Code, OpenAI Codex, Block Goose, Aider,\nand Google Gemini.  For each detected agent it reports CPU,\nRSS, status, current tool / task, in-flight subagents,\ncumulative token usage, estimated cost, context-window fill,\nloaded skills, and a live transcript preview.\n\nOn Windows, writable-FD enumeration uses NtQuerySystemInformation\n+ DuplicateHandle to surface what files each agent has open.\nPer-process IO byte counters come from sysinfo's disk_usage().","moniker":"agtop","name":"agtop","packageUrl":"https://github.com/MBrassey/agtop","publisher":"Matt Brassey","publisherUrl":"https://github.com/MBrassey","releaseNotesUrl":"https://github.com/MBrassey/agtop/releases/tag/v2.4.19","tags":["agent","ai","aider","claude","cli","codex","gemini","goose","htop","monitor","process","top","tui"]}},"publisherUrl":"https://github.com/MBrassey","releaseDate":"2026-05-13","releaseDateSource":"manifest","releaseNotesUrl":"https://github.com/MBrassey/agtop/releases/tag/v2.4.19","schemaVersion":1,"source":"winget","upstream":{"commit":"97d6aa2689f0a05f7847653a62b