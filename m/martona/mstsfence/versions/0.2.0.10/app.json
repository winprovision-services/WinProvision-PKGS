{"defaultLocale":"en-US","id":"martona.mstsfence","installers":[{"architecture":"arm64","dependencies":[],"id":"arm64-msix","minimumOSVersion":"10.0.18362.0","platforms":["Windows.Desktop"],"priority":3,"sha256":"8a38acb80375273f45f197df08b863a8dd5c043013dd25ec30e7652ce2711d2e","successCodes":[],"type":"msix","uninstall":{"type":"packageFamilyName","value":"MartonAnka.mstsfence_k7d8219edqwtj"},"url":"https://github.com/martona/mstsfence/releases/download/v0.2.0.10/mstsfence-windows-arm64.msix"},{"architecture":"x64","dependencies":[],"id":"x64-msix","minimumOSVersion":"10.0.18362.0","platforms":["Windows.Desktop"],"priority":3,"sha256":"bc2419e4c07249a18c78165e695264ac2142ff2d18eed918bcb6655b49dc1674","successCodes":[],"type":"msix","uninstall":{"type":"packageFamilyName","value":"MartonAnka.mstsfence_k7d8219edqwtj"},"url":"https://github.com/martona/mstsfence/releases/download/v0.2.0.10/mstsfence-windows-amd64.msix"}],"licenseUrl":"https://github.com/martona/mstsfence/blob/master/LICENSE.md","packageLocalizations":{"en-US":{"description":"Keep full-screen Remote Desktop (mstsc) sized to the monitor work area, so the host taskbar stays visible and the session renders 1:1.","license":"MIT","licenseUrl":"https://github.com/martona/mstsfence/blob/master/LICENSE.md","locale":"en-US","longDescription":"mstsfence makes mstsc.exe, in full-screen mode, size itself to the monitor's work area\ninstead of the whole monitor -- so the host taskbar stays visible (host taskbar on the\nbottom, session taskbar on top) and the remote desktop renders 1:1, with no scaling or\nletterboxing.\n\nA small tray controller installs a global hook that the OS maps into mstsc however it was\nlaunched (.rdp file, jump list, Start menu); outside mstsc it does nothing. Inside mstsc it\nclamps the monitor-geometry APIs the client reads to the work area, tracking DPI and\nresolution changes live. An optional dark-mode pass and a host display-scaling (DPI)\noverride are included. Staying on stock mstsc keeps all of its credential UX, Credential\nManager integration, and certificate/consent dialogs.","moniker":"mstsfence","name":"mstsfence","packageUrl":"https://github.com/martona/mstsfence","publisher":"martona","publisherUrl":"https://anka.me","releaseNotesUrl":"https://github.com/martona/mstsfence/releases/tag/v0.2.0.10","tags":["remote-desktop","rdp","mstsc","terminal-services","taskbar","fullscreen","multi-monitor","dpi","detours","windows"]}},"publisherUrl":"https://anka.me","releaseDate":"2026-08-18","releaseDateSource":"manifest","releaseNotesUrl":"https://github.com/martona/mstsfence/releases/tag/v0.2.0.10","schemaVersion":1,"source":"winget","upstream":{"commit":"97d6aa2689f0a05f7847653a62b8624720d15b5d","manifestVersion":"1.12.0","manifests":[{"path":"manifests/m/martona/mstsfence/0.2.0.10/martona.mstsfence.yaml","sha256":"b960ac9fcd0b0bca4dd8a5859402f0bbaab00a64e14360a61d84e3770f83b72f"},{"path":"manifests/m/martona/mstsfence/0.2.0.10/martona.mstsfence.installer.yaml","sha256":"455b01ac948042c4e6202c6761f2e464412417c4751c09c6f019a8770aa46753"},{"path":"manifests/m/martona/mstsfence/0.2.0.10/martona.mstsfence.locale.en-US.yaml","sha256":"a31a34ab75872970d0d7cd43208ba89d84ef7bfcd21be59431152dd4ba338576"}],"repository":"microsoft/winget-pkgs"},"version":"0.2.0.10"}