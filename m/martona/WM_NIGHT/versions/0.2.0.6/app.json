_NIGHT","publisher":"martona","publisherUrl":"https://anka.me","releaseNotesUrl":"https://github.com/martona/WM_NIGHT/releases/tag/v0.2.0.6","tags":["dark-mode","dark-theme","theming","win32","explorer","regedit","control-panel","tray","desktop","windows"]}},"publisherUrl":"https://anka.me","releaseDate":"2026-07-28","releaseDateSource":"manifest","releaseNotesUrl":"https://github.com/martona/WM_NIGHT/releases/tag/v0.2.0.6","schemaVersion":1,"source":"winget","upstream":{"commit":"97d6aa2689f0a05f7847653a62b8624720d15b5d","manifestVersion":"1.12.0","manifests":[{"path":"manifests/m/martona/WM_NIGHT/0.2.0.6/martona.WM_NIGHT.yaml","sha256":"b75dca6dd64b2d68cdca71a4648dff7cb652a7c73860d15cace7cebf4159d212"},{"path":"manifests/m/martona/WM_NIGHT/0.2.0.6/martona.WM_NIGHT.installer.yaml","sha256":"00e7517a7b257d6f956068158d7cc2767a514985caef379ce40906af67ca9dc1"},{"path":"manifests/m/martona/WM_NIGHT/0.2.0.6/martona.WM_NIGHT.locale.en-US.yaml","sha256":"b33f9540c256ab6942ad1f8140ef2c9d815c0ddfe52e005a556c37419dea78da"}],"repository":"microsoft/winget-pkgs"},"version":"0.2.0.6"}