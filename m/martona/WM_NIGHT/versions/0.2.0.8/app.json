_NIGHT","publisher":"martona","publisherUrl":"https://anka.me","releaseNotesUrl":"https://github.com/martona/WM_NIGHT/releases/tag/v0.2.0.8","tags":["dark-mode","dark-theme","theming","win32","explorer","regedit","control-panel","tray","desktop","windows"]}},"publisherUrl":"https://anka.me","releaseDate":"2026-07-30","releaseDateSource":"manifest","releaseNotesUrl":"https://github.com/martona/WM_NIGHT/releases/tag/v0.2.0.8","schemaVersion":1,"source":"winget","upstream":{"commit":"97d6aa2689f0a05f7847653a62b8624720d15b5d","manifestVersion":"1.12.0","manifests":[{"path":"manifests/m/martona/WM_NIGHT/0.2.0.8/martona.WM_NIGHT.yaml","sha256":"b3ed22ce5c828faa111041addbcf3f1deab000564dfdaf0c61da350249ef77d6"},{"path":"manifests/m/martona/WM_NIGHT/0.2.0.8/martona.WM_NIGHT.installer.yaml","sha256":"13a2452fb7499863823d370d95219b802cbfb3dd5a3753fe8fee20362915ef7b"},{"path":"manifests/m/martona/WM_NIGHT/0.2.0.8/martona.WM_NIGHT.locale.en-US.yaml","sha256":"cee27eb20a090076c7a18277ab0b785bba0f474ebe72b2b9da4890f57a381d36"}],"repository":"microsoft/winget-pkgs"},"version":"0.2.0.8"}