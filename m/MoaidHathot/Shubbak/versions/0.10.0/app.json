ilePath":"shubbak.exe"},{"PortableCommandAlias":"shubbak-wm","RelativeFilePath":"shubbak-wm.exe"},{"PortableCommandAlias":"taj","RelativeFilePath":"taj.exe"},{"PortableCommandAlias":"dalil","RelativeFilePath":"dalil.exe"},{"PortableCommandAlias":"ayn","RelativeFilePath":"ayn.exe"}],"nestedInstallerType":"portable","priority":4,"sha256":"03a7ba7ce3cfbdbd6eebe2786642652656ab344e940d6c82a5d956c22cb16ede","successCodes":[],"type":"zip","upgradeBehavior":"install","url":"https://github.com/MoaidHathot/Shubbak/releases/download/v0.10.0/shubbak-0.10.0-win-arm64.zip"},{"architecture":"x64","dependencies":[],"id":"x64-zip","installModes":["silent","silentWithProgress"],"minimumOSVersion":"10.0.19041.0","nestedInstallerFiles":[{"PortableCommandAlias":"shubbak","RelativeFilePath":"shubbak.exe"},{"PortableCommandAlias":"shubbak-wm","RelativeFilePath":"shubbak-wm.exe"},{"PortableCommandAlias":"taj","RelativeFilePath":"taj.exe"},{"PortableCommandAlias":"dalil","RelativeFilePath":"dalil.exe"},{"PortableCommandAlias":"ayn","RelativeFilePath":"ayn.exe"}],"nestedInstallerType":"portable","priority":4,"sha256":"7fb9b6bc600d4c1fd18239c6522bb215d9d163d2f45ab40eeee245f7e883cb57","successCodes":[],"type":"zip","upgradeBehavior":"install","url":"https://github.com/MoaidHathot/Shubbak/releases/download/v0.10.0/shubbak-0.10.0-win-x64.zip"}],"licenseUrl":"https://github.com/MoaidHathot/Shubbak/blob/v0.10.0/LICENSE","packageLocalizations":{"en-US":{"description":"A tiling window manager for Windows, with an animation engine, a status bar, a command palette and a configuration language that tells you when you have made a mistake.","license":"MIT","licenseUrl":"https://github.com/MoaidHathot/Shubbak/blob/v0.10.0/LICENSE","locale":"en-US","longDescription":"Shubbak tiles windows on Windows. It is named for شبّاك, \"window\"; the status bar is\nTaj (تاج, crown), the command palette is Dalil (دليل, guide) and the camera and\nmicrophone watcher is Ayn (عين, eye). Five small executables, compiled ahead of\ntime, with no runtime to install first.\n\nLayouts are a property of a container rather than of a workspace, so a fibonacci\nregion can sit inside a columns region with no special case. Available layouts are\nsplith, splitv, fibonacci, fibonacci-v, fibonacci-mirrored, master-left,\nmaster-right, master-top, master-bottom, grid and monocle.\n\nConfiguration is one KDL file, shared by the window manager, the bar and the\npalette, with diagnostics that point at the problem with a caret rather than a line\nnumber. Mistakes that other window managers accept silently - a regex wrapped in\nslashes that therefore never matched, a duplicate binding, a rule that would match\nevery window - are reported rather than ignored. Contexts layer overrides on the\nconfig while a condition on the desktop holds: a presentation, a docked monitor, a\ncall with the microphone open.\n\nWindows on inactive workspaces are cloaked rather than hidden, so they still report\nas visible to Win32. If Shubbak exits, crashes or is killed, the next run adopts\nthem and brings them back.\n\n`shubbak inspect` prints every matchable attribute of a window, whether Shubbak\nwill tile it and why not if it will not, and which rules matched.","moniker":"shubbak","name":"Shubbak","packageUrl":"https://github.com/MoaidHathot/Shubbak","publisher":"Moaid Hathot","publisherUrl":"https://github.com/MoaidHathot","releaseNotesUrl":"https://github.com/MoaidHathot/Shubbak/blob/v0.10.0/CHANGELOG.md","tags":["tiling","window-manager","tiling-window-manager","workspaces","productivity","keyboard","status-bar","command-palette","dotnet","kdl"]}},"publisherUrl":"https://github.com/MoaidHathot","releaseDate":"2026-09-12","releaseDateSource":"manifest","releaseNotesUrl":"https://github.com/MoaidHathot/Shubbak/blob/v0.10.0/CHANGELOG.md","schemaVersion":1,"source":"winget","upstream":{"commit":"97d6aa2689f0a05f7847653a62b8624720d15b5d","manifestVersion":"1.12.0","manifests":[{"path":"manifests/m/MoaidHathot/Shubbak/0.10.0/MoaidHathot.Shubbak.yaml","sha256":"feb7ec3eb2d38da673e02453c9a9aecf64ce918a7ab13f8de9bd2f18af3cf43e"},{"path":"manifests/m/MoaidHathot/Shubbak/0.10.0/MoaidHathot.Shubbak.installer.yaml","sha256":"1c6ff31c6c3dbdeea9e8649bffa8338194fd2456fb58cfe7b4260551ad558020"},{"path":"manifests/m/MoaidHathot/Shubbak/0.10.0/MoaidHathot.Shubbak.locale.en-US.yaml","sha256":"851682fe512ba5dc676709a59aab6110165b168eb4405cb897c87197fb4e1581"}],"repository":"microsoft/winget-pkgs"},"version":"0.10.0"}