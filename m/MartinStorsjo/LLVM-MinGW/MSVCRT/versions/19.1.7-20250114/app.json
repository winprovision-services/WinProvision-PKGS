-20250114-msvcrt-i686\\bin\\armv7-w64-mingw32-g++.exe"},{"RelativeFilePath":"llvm-mingw-20250114-msvcrt-i686\\bin\\armv7-w64-mingw32uwp-as.exe"},{"RelativeFilePath":"llvm-mingw-20250114-msvcrt-i686\\bin\\llvm-readelf.exe"},{"RelativeFilePath":"llvm-mingw-20250114-msvcrt-i686\\bin\\llvm-addr2line.exe"},{"RelativeFilePath":"llvm-mingw-20250114-msvcrt-i686\\bin\\x86_64-w64-mingw32uwp-readelf.exe"},{"RelativeFilePath":"llvm-mingw-20250114-msvcrt-i686\\bin\\i686-w64-mingw32uwp-addr2line.exe"},{"RelativeFilePath":"llvm-mingw-20250114-msvcrt-i686\\bin\\llvm-ml.exe"},{"RelativeFilePath":"llvm-mingw-20250114-msvcrt-i686\\bin\\aarch64-w64-mingw32-clang-scan-deps.exe"},{"RelativeFilePath":"llvm-mingw-20250114-msvcrt-i686\\bin\\armv7-w64-mingw32-nm.exe"},{"RelativeFilePath":"llvm-mingw-20250114-msvcrt-i686\\bin\\armv7-w64-mingw32-ar.exe"}],"nestedInstallerType":"portable","priority":4,"sha256":"17712f007e48da9f466ba7cced7cc255b24ec3a248abac29a3b4ba11e09c934f","successCodes":[],"type":"zip","url":"https://github.com/mstorsjo/llvm-mingw/releases/download/20250114/llvm-mingw-20250114-msvcrt-i686.zip"}],"licenseUrl":"https://github.com/mstorsjo/llvm-mingw/blob/HEAD/LICENSE.txt","packageLocalizations":{"en-US":{"description":"An LLVM/Clang/LLD based mingw-w64 toolchain, with MSVCRT runtime library","license":"ISC","licenseUrl":"https://github.com/mstorsjo/llvm-mingw/blob/HEAD/LICENSE.txt","locale":"en-US","longDescription":"This is a recipe for reproducibly building a LLVM/Clang/LLD based mingw-w64 toolchain.\nBenefits of a LLVM based MinGW toolchain are:\n- Support for targeting ARM/ARM64 (while GCC obviously does support these architectures, it doesn't support Windows on ARM)\n- A single toolchain targeting all four architectures (i686, x86_64, armv7 and arm64) instead of separate compiler binaries for each architecture\n- Support for generating debug info in PDB format\n- Support for Address Sanitizer and Undefined Behaviour Sanitizer\n- Since LLVM 16: Support for Control Flow Guard (-mguard=cf compile and link flags)\nClang on its own can also be used as compiler in the normal GNU binutils based environments though, so the main difference lies in replacing binutils with LLVM based tools.","name":"LLVM MinGW (MSVCRT runtime)","packageUrl":"https://github.com/mstorsjo/llvm-mingw","publisher":"Martin Storsjö","publisherUrl":"https://github.com/mstorsjo","releaseNotesUrl":"https://github.com/mstorsjo/llvm-mingw/releases/tag/20250114","tags":["binutils","c","c++","clang","compiler","cpp","gcc","llvm","make","mingw","mingw-w64"]},"zh-CN":{"description":"基于 LLVM/Clang/LLD 的 mingw-w64 工具链，包含 MSVCRT 运行时库","locale":"zh-CN","longDescription":"这是一个用于可复现构建基于 LLVM/Clang/LLD 的 mingw-w64 工具链的配方。\n基于 LLVM 的 MinGW 工具链的优点有\n- 支持 ARM/ARM64（GCC 显然支持这些架构，但不支持 Windows on ARM）\n- 针对所有四种架构（i686、x86_64、armv7 和 arm64）的单一工具链，而不是针对每种架构的单独编译器二进制文件\n- 支持生成 PDB 格式的调试信息\n- 支持地址检测器（Address Sanitizer）和未定义行为检测器（Undefined Behaviour Sanitizer）\n- 自 LLVM 16 起：支持控制流保护（-mguard=cf 编译和链接标志）\nClang 本身也可在基于 binutils 的普通 GNU 环境中用作编译器，因此主要区别在于用基于 LLVM 的工具取代 binutils。","name":"LLVM MinGW (MSVCRT 运行时库)","releaseNotesUrl":"https://github.com/mstorsjo/llvm-mingw/releases/tag/20250114","tags":["binutils","c","c++","clang","cpp","gcc","llvm","make","mingw","mingw-w64","编译器"]}},"publisherUrl":"https://github.com/mstorsjo","releaseDate":"2025-01-14","releaseDateSource":"manifest","releaseNotesUrl":"https://github.com/mstorsjo/llvm-mingw/releases/tag/20250114","schemaVersion":1,"source":"winget","upstream":{"commit":"97d6aa2689f0a05f7847653a62b8624720d15b5d","manifestVersion":"1.9.0","manifests":[{"path":"manifests/m/MartinStorsjo/LLVM-MinGW/MSVCRT/19.1.7-20250114/MartinStorsjo.LLVM-MinGW.MSVCRT.yaml","sha256":"ada34e8acf3f353af544fa87cc492a1e74298af7bdd6b9671ac135dbb9afefe2"},{"path":"manifests/m/MartinStorsjo/LLVM-MinGW/MSVCRT/19.1.7-20250114/MartinStorsjo.LLVM-MinGW.MSVCRT.installer.yaml","sha256":"941edc3a4fef265b167a098b64c53c1d619ef8385d5202cf71b106c25545213a"},{"path":"manifests/m/Martin