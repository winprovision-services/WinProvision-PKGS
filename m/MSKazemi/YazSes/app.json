{"architectures":["arm64","x64"],"id":"MSKazemi.YazSes","latestVersion":"2.48.1","media":{"icons":[{"mimeType":"image/png","path":"media/icon.e17cd473.png","priority":1,"sha256":"e17cd473d6c19075ddba1c1f50eb2afa3d333a26d6005cccdf3c116bfd62b02e","source":"winget-legacy"}],"screenshots":[]},"package":{"description":"Offline voice dictation — hold a key, speak, release. No cloud, no API key, no subscription.","license":"Apache-2.0","licenseUrl":"https://github.com/MSKazemi/yazses/blob/main/LICENSE","locale":"en-US","localizations":{"en-US":{"description":"Offline voice dictation — hold a key, speak, release. No cloud, no API key, no subscription.","license":"Apache-2.0","licenseUrl":"https://github.com/MSKazemi/yazses/blob/main/LICENSE","locale":"en-US","longDescription":"YazSes is a free, open-source, offline voice dictation and speech-to-text\ntool. Hold a key, speak, release — your words are transcribed on your own CPU\nand typed into whatever window has focus.\n\nEverything runs on-device with faster-whisper. There is no cloud service, no\nAPI key, no account and no subscription, and no telemetry of any kind. Use it\nwhen audio must not be sent to a third party — a confidential meeting, an\nair-gapped machine, or simply a preference not to rent your own voice.\n\nIt also transcribes recordings (`yazses transcribe talk.m4a`, with optional\nspeaker labels) and can capture a whole meeting into a speaker-labelled\ntranscript with locally generated minutes.","moniker":"yazses","name":"YazSes","packageUrl":"https://mskazemi.com/yazses/","publisher":"MSKazemi","publisherUrl":"https://github.com/MSKazemi","releaseNotesUrl":"https://github.com/MSKazemi/yazses/releases/tag/v2.48.1","tags":["voice","dictation","voice-typing","speech-to-text","speech-recognition","whisper","transcription","offline","on-device","privacy","accessibility","productivity","open-source"]}},"longDescription":"YazSes is a free, open-source, offline voice dictation and speech-to-text\ntool. Hold a key, speak, release — your words are transcribed on your own CPU\nand typed into whatever window has focus.\n\nEverything runs on-device with faster-whisper. There is no cloud service, no\nAPI key, no account and no subscription, and no telemetry of any kind. Use it\nwhen audio must not be sent to a third party — a confidential meeting, an\nair-gapped machine, or simply a preference not to rent your own voice.\n\nIt also transcribes recordings (`yazses transcribe talk.m4a`, with optional\nspeaker labels) and can capture a whole meeting into a speaker-labelled\ntranscript with locally generated minutes.","moniker":"yazses","name":"YazSes","packageUrl":"https://mskazemi.com/yazses/","publisher":"MSKazemi","publisherUrl":"https://github.com/MSKazemi","releaseNotesUrl":"https://github.com/MSKazemi/yazses/releases/tag/v2.48.1","tags":["voice","dictation","voice-typing","speech-to-text","speech-recognition","whisper","transcription","offline","on-device","privacy","accessibility","productivity","open-source"]},"schemaVersion":1,"source":"winget","versions":[{"architectures":["x64"],"detailPath":"versions/2.48.1/app.json","detailSha256":"98468e98ed5d50ced42e372976d99706d538df2667ea65e41727d35a1557c0eb","releaseDate":"2026-11-03","releaseDateSource":"manifest","version":"2.48.1"},{"architectures":["x64"],"detailPath":"versions/2.48.0/app.json","detailSha256":"26bfb652d8af3546a6a194f45fac6a4fbec582fbc47eed86784f90c4a83d705e","releaseDate":"2026-11-02","releaseDateSource":"manifest","version":"2.48.0"},{"architectures":["x64"],"detailPath":"versions/2.47.0/app.json","detailSha256":"02bb8477286b855c111eb2ef9c9088c0cdca354c7c310641234739d9425e04b2","releaseDate":"2026-10-31","releaseDateSource":"manifest","version":"2.47.0"},{"architectures":["x64"],"detailPath":"versions/2.46.0/app.json","detailSha256":"df087f9e99737dfb980ba3127fc1fe30dd4f95c601e640e9e1ba341be31733b2","releaseDate":"2026-10-24","releaseDateSource":"manifest","version":"2.46.0"},{"architectures":["x64"],"detailPath