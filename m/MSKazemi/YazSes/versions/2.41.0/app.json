ty — a confidential meeting, an\nair-gapped machine, or simply a preference not to rent your own voice.\n\nIt also transcribes recordings (`yazses transcribe talk.m4a`, with optional\nspeaker labels) and can capture a whole meeting into a speaker-labelled\ntranscript with locally generated minutes.","moniker":"yazses","name":"YazSes","packageUrl":"https://mskazemi.com/yazses/","publisher":"MSKazemi","publisherUrl":"https://github.com/MSKazemi","releaseNotesUrl":"https://github.com/MSKazemi/yazses/releases/tag/v2.41.0","tags":["voice","dictation","voice-typing","speech-to-text","speech-recognition","whisper","transcription","offline","on-device","privacy","accessibility","productivity","open-source"]}},"publisherUrl":"https://github.com/MSKazemi","releaseDate":"2026-10-04","releaseDateSource":"manifest","releaseNotesUrl":"https://github.com/MSKazemi/yazses/releases/tag/v2.41.0","schemaVersion":1,"source":"winget","upstream":{"commit":"97d6aa2689f0a05f7847653a62b8624720d15b5d","manifestVersion":"1.6.0","manifests":[{"path":"manifests/m/MSKazemi/YazSes/2.41.0/MSKazemi.YazSes.yaml","sha256":"0abfb39866d2d53cde9e65bba0bb7f5ccdcaf11facb279aa200f683d91b508cb"},{"path":"manifests/m/MSKazemi/YazSes/2.41.0/MSKazemi.YazSes.installer.yaml","sha256":"28df7364cb53f196b88674e61e4b328ad9509e03c426d6cf1ef341d50447a374"},{"path":"manifests/m/MSKazemi/YazSes/2.41.0/MSKazemi.YazSes.locale.en-US.yaml","sha256":"619e159b6882051a2e8725bf0ab747e4f4e3644d29c6f16338c1abe8ba16ab83"}],"repository":"microsoft/winget-pkgs"},"version":"2.41.0"}