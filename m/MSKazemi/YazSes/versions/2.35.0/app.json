ty — a confidential meeting, an\nair-gapped machine, or simply a preference not to rent your own voice.\n\nIt also transcribes recordings (`yazses transcribe talk.m4a`, with optional\nspeaker labels) and can capture a whole meeting into a speaker-labelled\ntranscript with locally generated minutes.","moniker":"yazses","name":"YazSes","packageUrl":"https://mskazemi.com/yazses/","publisher":"MSKazemi","publisherUrl":"https://github.com/MSKazemi","releaseNotesUrl":"https://github.com/MSKazemi/yazses/releases/tag/v2.35.0","tags":["voice","dictation","voice-typing","speech-to-text","speech-recognition","whisper","transcription","offline","on-device","privacy","accessibility","productivity","open-source"]}},"publisherUrl":"https://github.com/MSKazemi","releaseDate":"2026-08-27","releaseDateSource":"manifest","releaseNotesUrl":"https://github.com/MSKazemi/yazses/releases/tag/v2.35.0","schemaVersion":1,"source":"winget","upstream":{"commit":"97d6aa2689f0a05f7847653a62b8624720d15b5d","manifestVersion":"1.6.0","manifests":[{"path":"manifests/m/MSKazemi/YazSes/2.35.0/MSKazemi.YazSes.yaml","sha256":"68459ef9902607f016cc4d260fd67c222a6b0a674b8570412eddfd5d1fba5d39"},{"path":"manifests/m/MSKazemi/YazSes/2.35.0/MSKazemi.YazSes.installer.yaml","sha256":"f564ae0712bb8db9e8c4345d54499840e1d54b79858fe3bbf4cd34593de361cc"},{"path":"manifests/m/MSKazemi/YazSes/2.35.0/MSKazemi.YazSes.locale.en-US.yaml","sha256":"d24a1bfe7a429134fc4c9c03e7068b7d5a8b9e7abd40a9ea5b198cd8de626cce"}],"repository":"microsoft/winget-pkgs"},"version":"2.35.0"}