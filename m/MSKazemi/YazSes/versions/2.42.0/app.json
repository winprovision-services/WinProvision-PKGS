ty — a confidential meeting, an\nair-gapped machine, or simply a preference not to rent your own voice.\n\nIt also transcribes recordings (`yazses transcribe talk.m4a`, with optional\nspeaker labels) and can capture a whole meeting into a speaker-labelled\ntranscript with locally generated minutes.","moniker":"yazses","name":"YazSes","packageUrl":"https://mskazemi.com/yazses/","publisher":"MSKazemi","publisherUrl":"https://github.com/MSKazemi","releaseNotesUrl":"https://github.com/MSKazemi/yazses/releases/tag/v2.42.0","tags":["voice","dictation","voice-typing","speech-to-text","speech-recognition","whisper","transcription","offline","on-device","privacy","accessibility","productivity","open-source"]}},"publisherUrl":"https://github.com/MSKazemi","releaseDate":"2026-10-04","releaseDateSource":"manifest","releaseNotesUrl":"https://github.com/MSKazemi/yazses/releases/tag/v2.42.0","schemaVersion":1,"source":"winget","upstream":{"commit":"97d6aa2689f0a05f7847653a62b8624720d15b5d","manifestVersion":"1.6.0","manifests":[{"path":"manifests/m/MSKazemi/YazSes/2.42.0/MSKazemi.YazSes.yaml","sha256":"f14a34047bb75532713d0f7afc5651a76aef9f88fdb8ddfd066ca2b39f8751da"},{"path":"manifests/m/MSKazemi/YazSes/2.42.0/MSKazemi.YazSes.installer.yaml","sha256":"75bc26be13c8b35de9551b828ed258f76606ef5453a6a011feb733c5d318ff24"},{"path":"manifests/m/MSKazemi/YazSes/2.42.0/MSKazemi.YazSes.locale.en-US.yaml","sha256":"d18429011e4d91d29652c975e5c2fc7052875d73515d7b58825d0a8300681089"}],"repository":"microsoft/winget-pkgs"},"version":"2.42.0"}