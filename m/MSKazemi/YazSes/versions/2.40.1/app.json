ty — a confidential meeting, an\nair-gapped machine, or simply a preference not to rent your own voice.\n\nIt also transcribes recordings (`yazses transcribe talk.m4a`, with optional\nspeaker labels) and can capture a whole meeting into a speaker-labelled\ntranscript with locally generated minutes.","moniker":"yazses","name":"YazSes","packageUrl":"https://mskazemi.com/yazses/","publisher":"MSKazemi","publisherUrl":"https://github.com/MSKazemi","releaseNotesUrl":"https://github.com/MSKazemi/yazses/releases/tag/v2.40.1","tags":["voice","dictation","voice-typing","speech-to-text","speech-recognition","whisper","transcription","offline","on-device","privacy","accessibility","productivity","open-source"]}},"publisherUrl":"https://github.com/MSKazemi","releaseDate":"2026-09-25","releaseDateSource":"manifest","releaseNotesUrl":"https://github.com/MSKazemi/yazses/releases/tag/v2.40.1","schemaVersion":1,"source":"winget","upstream":{"commit":"97d6aa2689f0a05f7847653a62b8624720d15b5d","manifestVersion":"1.6.0","manifests":[{"path":"manifests/m/MSKazemi/YazSes/2.40.1/MSKazemi.YazSes.yaml","sha256":"d579f3d8abd5a2c8ee385abb86f43d9164b10d64ab706d4941d3fc5df95deb56"},{"path":"manifests/m/MSKazemi/YazSes/2.40.1/MSKazemi.YazSes.installer.yaml","sha256":"1cf1ce496e9e17bfc635aa7ef42bb6060690fa3bd0cdb9bd48b49695980ba552"},{"path":"manifests/m/MSKazemi/YazSes/2.40.1/MSKazemi.YazSes.locale.en-US.yaml","sha256":"4a89fe9d580b443f6fd93e5d81e79ac630fd0e6b4d32cd9c6bf5e5d000a06526"}],"repository":"microsoft/winget-pkgs"},"version":"2.40.1"}