ty — a confidential meeting, an\nair-gapped machine, or simply a preference not to rent your own voice.\n\nIt also transcribes recordings (`yazses transcribe talk.m4a`, with optional\nspeaker labels) and can capture a whole meeting into a speaker-labelled\ntranscript with locally generated minutes.","moniker":"yazses","name":"YazSes","packageUrl":"https://mskazemi.com/yazses/","publisher":"MSKazemi","publisherUrl":"https://github.com/MSKazemi","releaseNotesUrl":"https://github.com/MSKazemi/yazses/releases/tag/v2.36.0","tags":["voice","dictation","voice-typing","speech-to-text","speech-recognition","whisper","transcription","offline","on-device","privacy","accessibility","productivity","open-source"]}},"publisherUrl":"https://github.com/MSKazemi","releaseDate":"2026-08-30","releaseDateSource":"manifest","releaseNotesUrl":"https://github.com/MSKazemi/yazses/releases/tag/v2.36.0","schemaVersion":1,"source":"winget","upstream":{"commit":"97d6aa2689f0a05f7847653a62b8624720d15b5d","manifestVersion":"1.6.0","manifests":[{"path":"manifests/m/MSKazemi/YazSes/2.36.0/MSKazemi.YazSes.yaml","sha256":"3fb9cb03776a0b41289dcd7f9ee4a8e860a765bac9651b19dc3004caf6f36af7"},{"path":"manifests/m/MSKazemi/YazSes/2.36.0/MSKazemi.YazSes.installer.yaml","sha256":"0b84eba426e482c3a5aa0c0601d3ab971450da86499c1f15bafd6e549f5c21ee"},{"path":"manifests/m/MSKazemi/YazSes/2.36.0/MSKazemi.YazSes.locale.en-US.yaml","sha256":"b35aa45d03bf8a00097157033e594473228e81696cc1a935deb74649691cf95e"}],"repository":"microsoft/winget-pkgs"},"version":"2.36.0"}