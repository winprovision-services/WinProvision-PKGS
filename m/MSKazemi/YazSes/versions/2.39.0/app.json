ty — a confidential meeting, an\nair-gapped machine, or simply a preference not to rent your own voice.\n\nIt also transcribes recordings (`yazses transcribe talk.m4a`, with optional\nspeaker labels) and can capture a whole meeting into a speaker-labelled\ntranscript with locally generated minutes.","moniker":"yazses","name":"YazSes","packageUrl":"https://mskazemi.com/yazses/","publisher":"MSKazemi","publisherUrl":"https://github.com/MSKazemi","releaseNotesUrl":"https://github.com/MSKazemi/yazses/releases/tag/v2.39.0","tags":["voice","dictation","voice-typing","speech-to-text","speech-recognition","whisper","transcription","offline","on-device","privacy","accessibility","productivity","open-source"]}},"publisherUrl":"https://github.com/MSKazemi","releaseDate":"2026-09-24","releaseDateSource":"manifest","releaseNotesUrl":"https://github.com/MSKazemi/yazses/releases/tag/v2.39.0","schemaVersion":1,"source":"winget","upstream":{"commit":"97d6aa2689f0a05f7847653a62b8624720d15b5d","manifestVersion":"1.6.0","manifests":[{"path":"manifests/m/MSKazemi/YazSes/2.39.0/MSKazemi.YazSes.yaml","sha256":"2c6e9038f4a65fdbd3848946ddeb3475c7d33d0b3c245aca725cb2116fa81cef"},{"path":"manifests/m/MSKazemi/YazSes/2.39.0/MSKazemi.YazSes.installer.yaml","sha256":"34cb71ae5f57e25d0a9fe57f14590906118c74831cd56355db9f46f0114012eb"},{"path":"manifests/m/MSKazemi/YazSes/2.39.0/MSKazemi.YazSes.locale.en-US.yaml","sha256":"b5f7672a32401c61112902f79f434f8c7620ef8accf8040122973632e078d848"}],"repository":"microsoft/winget-pkgs"},"version":"2.39.0"}