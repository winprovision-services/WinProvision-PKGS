{"defaultLocale":"en-US","id":"martsg666.qbPortWeaver","installers":[{"architecture":"x64","dependencies":[],"elevation":{"requirement":"elevationRequired","source":"inferred"},"id":"x64-machine-wix","installModes":["interactive","silent","silentWithProgress"],"minimumOSVersion":"10.0.0.0","platforms":["Windows.Desktop"],"priority":2,"scope":"machine","sha256":"966d3e98cd968cd70a60d6b29a86c2df64441b9a05d20250002ee37d86095f44","silent":{"arguments":"/quiet /norestart","source":"default"},"successCodes":[],"type":"wix","uninstall":{"type":"productCode","value":"{96B4B805-5E36-4728-9324-DF9E40508C8A}"},"upgradeBehavior":"install","url":"https://github.com/martsg666/qbPortWeaver/releases/download/v2.6.2/qbPortWeaver_2.6.2_Setup.msi"}],"licenseUrl":"https://github.com/martsg666/qbPortWeaver/blob/master/LICENSE","packageLocalizations":{"en-US":{"description":"Syncs the listening port of qBittorrent, Transmission, or Deluge with the VPN-assigned port, and imports media files into Plex-compatible library folders","license":"Free of use and distribution","licenseUrl":"https://github.com/martsg666/qbPortWeaver/blob/master/LICENSE","locale":"en-US","longDescription":"qbPortWeaver is a Windows system tray application that keeps the listening port of qBittorrent, Transmission, or Deluge synchronized with the port assigned by ProtonVPN, PIA, or any NAT-PMP capable VPN gateway.\nIt monitors the VPN's forwarded port on a configurable interval, updates the client automatically when the port changes, verifies the port is reachable, and can recover the VPN connection automatically when port detection fails. A Status panel shows the live sync chain, recent port changes, and session statistics, and a built-in Media Manager can import media files into Plex-compatible library folders.","moniker":"qbportweaver","name":"qbPortWeaver","packageUrl":"https://github.com/martsg666/qbPortWeaver","publisher":"martsg666","publisherUrl":"https://github.com/martsg666","releaseNotesUrl":"https://githu