{"defaultLocale":"en-US","id":"mightymorgs.remotefs","installers":[{"architecture":"x64","commands":["remotefs"],"dependencies":[{"PackageDependencies":[{"PackageIdentifier":"WinFsp.WinFsp"}]}],"id":"x64-zip","nestedInstallerFiles":[{"PortableCommandAlias":"remotefs","RelativeFilePath":"remotefs/remotefs.exe"}],"nestedInstallerType":"portable","priority":4,"sha256":"dcb4d137e262b17f79d4576e3ea859df9a44dbb262c0c5e6cf48d784d82564b2","successCodes":[],"type":"zip","url":"https://github.com/mightymorgs/remote-fs-browser/releases/download/v0.4.0/remotefs-0.4.0-windows-x64.zip"}],"licenseUrl":"https://github.com/mightymorgs/remote-fs-browser/blob/main/LICENSE","packageLocalizations":{"en-US":{"description":"Manage local, NAS and cloud files through a browser","license":"MIT","licenseUrl":"https://github.com/mightymorgs/remote-fs-browser/blob/main/LICENSE","locale":"en-US","longDescription":"remotefs provides a browser-based file manager and JSON API for local folders,\nSMB shares, NFS exports and optional rclone cloud storage. Add cloud connections\nin the GUI or CLI and copy files and folders between storage connections.\nFeatures include password sign-in, uploads, text editing, saved locations,\nnetwork scanning and staged multipart ZIP downloads. Optional libvirt support\nprovides read-only storage inventory. Mount on this computer shows a share,\nexport or cloud connection as a drive letter that reconnects after restarts and\nsign-in. The portable package includes Python, libnfs and rclone; WinFsp is\ninstalled as a dependency for drive letters.","name":"remotefs","packageUrl":"https://github.com/mightymorgs/remote-fs-browser","publisher":"mightymorgs","publisherUrl":"https://github.com/mightymorgs","releaseNotesUrl":"https://github.com/mightymorgs/remote-fs-browser/releases/tag/v0.4.0","tags":["nfs","smb","file-browser","http","cloud-storage","rclone","mount"]}},"publisherUrl":"https://github.com/mightymorgs","releaseNotesUrl":"https://github.com/mightymorgs/remote-f