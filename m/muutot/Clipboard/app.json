{"architectures":["x64"],"id":"muutot.Clipboard","latestVersion":"1.8.0","media":{"icons":[{"mimeType":"image/png","path":"media/icon.5eefa763.png","priority":1,"sha256":"5eefa7630c737cbcca185f2445a8c890b4e0dc62dfa8b99cec88c233aa3ea904","source":"winget-legacy"}],"screenshots":[]},"package":{"description":"高性能 · 本地优先 · 全平台剪贴板管理器。","license":"AGPL-3.0","licenseUrl":"https://github.com/muutot/Clipboard/blob/HEAD/LICENSE","locale":"zh-CN","localizations":{"en-US":{"description":"A high-performance, local-first, cross-platform clipboard manager.","locale":"en-US","longDescription":"Clipboard Desktop is a high-performance, cross-platform, local-first clipboard manager. It quietly runs in the background and keeps recording your clipboard history; a global hotkey (Alt+V by default) summons the launcher with full-text search (including Chinese word segmentation), image OCR text recognition, favorites, editing, and quick paste. It handles four content types — text, links, images, and files — with smart content recognition, rich-text formatted paste, a Tantivy full-text search engine with N-gram Chinese tokenization, and local PP-OCR text recognition. All data stays on your machine with no telemetry or uploads, and OCR runs fully offline without network access.","tags":["clipboard"]},"zh-CN":{"description":"高性能 · 本地优先 · 全平台剪贴板管理器。","license":"AGPL-3.0","licenseUrl":"https://github.com/muutot/Clipboard/blob/HEAD/LICENSE","locale":"zh-CN","longDescription":"Clipboard Desktop 是一款高性能、跨平台、本地优先的剪贴板管理工具。它在后台静默运行，持续记录剪贴板历史；通过全局热键（默认 Alt+V）一键唤起，支持全文搜索（含中文分词）、图片 OCR 文字识别、收藏、编辑、快速粘贴等操作。支持文本、链接、图片、文件四种内容类型，智能内容识别与富文本带格式粘贴，Tantivy 全文检索引擎与 N-gram 中文分词，PP-OCR 本地离线文字识别。所有数据存储在本地，不包含任何遥测或上传行为，OCR 完全离线运行，无需联网。","name":"Clipboard","packageUrl":"https://github.com/muutot/Clipboard","publisher":"muutot","publisherUrl":"https://github.com/muutot","releaseNotesUrl":"https://github.com/muutot/Clipboard/releases/tag/v1.8.0","tags":["剪贴板"]}},"longDescription":"Clipboard Desktop 是一款高性能、跨平台、本地优先的剪贴板管理工具。它在后台静默运行，持续记录剪贴板历史；通过全局热键（默认 Alt+V）一键唤起，支持全文搜索（含中文分词）、图片 OCR 文字识别、收藏、编辑、快速粘贴等操作。支持文本、链接、图片、文件四种内容类型，智能内容识别与富文本带格式粘贴，Tantivy 全文检索引擎与 N-gram 中文分词，PP-OCR 本地离线文字识别。所有数据存储在本地，不包含任何遥测或上传行为，OCR 完全离线运行，无需联网。","name":"Clipboard","packageUrl":"https://github.com/muutot/Clipboard","publisher":"muutot","publisherUrl":"https://github.com/muutot","releaseNotesUrl":"https://github.com/muutot/Clipboard/releases/tag/v1.8.0","tags":["剪贴板"]},"schemaVersion":1,"source":"winget","versions":[{"architectures":["x64"],"detailPath":"versions/1.8.0/app.json","detailSha256":"123dc0731fc2cd627c732e11f83f632759a98c9109a6f69a2586ca888610f355","releaseDate":"2026-10-11","releaseDateSource":"manifest","version":"1.8.0"},{"architectures":["x64"],"detailPath":"versions/1.7.4/app.json","detailSha256":"63667ad77b3e0ba89c6c1964a16ff3cdea207185518e6fdde97bfe66e38fe2c0","releaseDate":"2026-10-08","releaseDateSource":"manifest","version":"1.7.4"},{"architectures":["x64"],"detailPath":"versions/1.7.3/app.json","detailSha256":"d035718b06505eb25a85bcc4cddc7b9ec1bb41ed40bd544ba66c1bb98db08a58","releaseDate":"2026-09-30","releaseDateSource":"manifest","version":"1.7.3"},{"architectures":["x64"],"detailPath":"versions/1.7.2/app.json","detailSha256":"dd8fe4878f7a6e27faeb2444073d260eee126b08e2a91f7d3b131e650e14f448","releaseDate":"2026-09-29","releaseDateSource":"manifest","version":"1.7.2"},{"architectures":["x64"],"detailPath":"versions/1.7.1/app.json","detailSha256":"35b136418313ff94fd705f1c7f8ae56e618611fb1c45ccb118a075f891304309","releaseDate":"2026-09-24","releaseDateSource":"manifest","version":"1.7.1"},{"architectures":["x64"],"detailPath":"versions/1.7.0/app.json","detailSha256":"40d07e97d14c5ea0fd2953a668858c6cbabf36a9c5ab129024266752bf0b9541","releaseDate":"2026-09-22","releaseDateSource":"manifest","version":"1.7.0"},{"architectures":["x64"],"detailPath":"versions/1.6.0/app.json","detailSha256":"6c241de1d5c5720da7fec709f7f45a6459f2f1c20c3f6eb22a245fb70c884ca7","releaseDate":"2026-09-16","releaseDateS