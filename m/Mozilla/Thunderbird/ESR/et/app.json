{"architectures":["x64","x86"],"id":"Mozilla.Thunderbird.ESR.et","latestVersion":"153.6.0","media":{"icons":[{"mimeType":"image/png","path":"media/icon.910507de.png","priority":1,"sha256":"910507de10d7bc63e691e4bf12abf15a009ee06ea330242b4b62607cded933f6","source":"winget-legacy"}],"screenshots":[]},"package":{"description":"The official annual extended support release of Thunderbird intended for users who want all available new features on an annual basis and stability/security fixes on a monthly basis.","license":"MPL-2.0","licenseUrl":"https://www.mozilla.org/MPL/2.0","locale":"en-US","localizations":{"en-US":{"description":"The official annual extended support release of Thunderbird intended for users who want all available new features on an annual basis and stability/security fixes on a monthly basis.","license":"MPL-2.0","licenseUrl":"https://www.mozilla.org/MPL/2.0","locale":"en-US","longDescription":"Thunderbird is a free and open source email, newsfeed, chat, and calendaring client, that’s easy to set up and customize. One of the core principles of Thunderbird is the use and promotion of open standards - this focus is a rejection of our world of closed platforms and services that can’t communicate with each other. We want our users to have freedom and choice in how they communicate.\nThis is the official annual extended support release. Thie release is intended for users who want all available new features on an annual basis and stability/security fixes on a monthly basis.","moniker":"thunderbird-esr","name":"Mozilla Thunderbird ESR (et)","packageUrl":"https://www.thunderbird.net/","publisher":"Mozilla","publisherUrl":"https://www.mozilla.org/","releaseNotesUrl":"https://www.thunderbird.net/thunderbird/153.6.0esr/releasenotes/","tags":["email","mail"]},"zh-CN":{"description":"Thunderbird 官方年度延长支持版，面向希望按年获取所有新功能、按月获取稳定性/安全性修复的用户。","locale":"zh-CN","longDescription":"Thunderbird 是一款免费开源的电子邮件、新闻订阅、即时通信、日历客户端，配置简单，定制自由。Thunderbird 的核心准则之一是使用和推广开放标准——重点就是拒绝世界上我们无法相互通信的封闭平台和服务。我们希望我们的用户在沟通方式上拥有自由和选择。\n这是官方年度延长支持版本。此版本面向希望按年获取所有新功能、按月获取稳定性/安全性修复的用户。","packageUrl":"https://www.thunderbird.net/zh-CN/","publisherUrl":"https://www.mozilla.org/zh-CN/","releaseNotesUrl":"https://www.thunderbird.net/thunderbird/153.6.0esr/releasenotes/","tags":["电子邮件","邮件"]}},"longDescription":"Thunderbird is a free and open source email, newsfeed, chat, and calendaring client, that’s easy to set up and customize. One of the core principles of Thunderbird is the use and promotion of open standards - this focus is a rejection of our world of closed platforms and services that can’t communicate with each other. We want our users to have freedom and choice in how they communicate.\nThis is the official annual extended support release. Thie release is intended for users who want all available new features on an annual basis and stability/security fixes on a monthly basis.","moniker":"thunderbird-esr","name":"Mozilla Thunderbird ESR (et)","packageUrl":"https://www.thunderbird.net/","publisher":"Mozilla","publisherUrl":"https://www.mozilla.org/","releaseNotesUrl":"https://www.thunderbird.net/thunderbird/153.6.0esr/releasenotes/","tags":["email","mail"]},"schemaVersion":1,"source":"winget","versions":[{"architectures":["x64","x86"],"detailPath":"versions/153.6.0/app.json","detailSha256":"5989789d258250b3c52fa8fcf5968205d7aef8f83954a43c1e3b582883ffd839","releaseDate":"2026-10-27","releaseDateSource":"manifest","version":"153.6.0"},{"architectures":["x64","x86"],"detailPath":"versions/153.5.1/app.json","detailSha256":"09bbd04c4f19cfe163c5b5e31975212ebf1a4967151b86afd4794caffab06d96","releaseDate":"2026-10-20","releaseDateSource":"manifest","version":"153.5.1"},{"architectures":["x64","x86"],"detailPath":"versions/153.5.0/app.json","detailSha256":"b758610b7331b789ab49a05d9e55001777f9c1accc4cebd20433cd776b11c104","releaseDate":"2026-10-13","releaseDateSource":"manifest","version":"153.5.0"},{"architectures":["x64","x86"],"detailPath":"versions/153.4.0/app.jso