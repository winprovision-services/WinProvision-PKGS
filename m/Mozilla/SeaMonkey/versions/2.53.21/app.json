tall":{"type":"productCode","value":"SeaMonkey 2.53.21 (x86 fr)"},"upgradeBehavior":"install","url":"https://archive.seamonkey-project.org/releases/2.53.21/win32/fr/seamonkey-2.53.21.fr.win32.installer.exe"}],"licenseUrl":"https://www.seamonkey-project.org/legal/eula","packageLocalizations":{"en-US":{"description":"Web-browser, advanced e-mail, newsgroup and feed client, IRC chat, and HTML editing made simple—all your Internet needs in one application.","license":"MPL-2.0","licenseUrl":"https://www.seamonkey-project.org/legal/eula","locale":"en-US","longDescription":"The SeaMonkey project is a community effort to develop the SeaMonkey all-in-one internet application suite. Such a software suite was previously made popular by Netscape and Mozilla, and the SeaMonkey project continues to develop and deliver high-quality updates as well as new features and improvements to this concept. Containing an Internet browser, email & newsgroup client, HTML editor, IRC chat and web development tools, SeaMonkey is sure to appeal to advanced users, web developers and corporate users.\nSeaMonkey is built on the open source Mozilla Gecko engine, the same code which underlies the highly successful Thunderbird and is the base for the Firefox browser. SeaMonkey benefits from the cross-fertilization with these other projects, by gaining (and contributing) new features and the ongoing security updates which are a modern necessity. The SeaMonkey Association provides legal backing for the SeaMonkey Project.","moniker":"seamonkey","name":"SeaMonkey","packageUrl":"https://www.seamonkey-project.org/releases/","publisher":"SeaMonkey e.V.","publisherUrl":"https://www.seamonkey-project.org/","releaseNotesUrl":"https://www.seamonkey-project.org/news#2025-06-05","tags":["browser","email","gecko","internet","mail","web","web-browser","webpage"]},"zh-CN":{"description":"网页浏览、高级电子邮件、新闻组与订阅源客户端、IRC 聊天及简易 HTML 编辑——满足您所有网络需求的一站式应用。","locale":"zh-CN","longDescription":"SeaMonkey 项目是一个由社区推动开发的互联网全能应用套件。这种软件套装曾因 Netscape 和 Mozilla 而广受欢迎，如今 SeaMonkey 项目持续为这一理念开发高质量更新，并不断增添新功能和改进。该套件包含网页浏览器、电子邮件与新闻组客户端、HTML 编辑器、IRC 聊天工具及网页开发工具，必将吸引高级用户、网页开发者和企业用户。\nSeaMonkey 基于开源的 Mozilla Gecko 引擎构建，该引擎同样支撑着广受欢迎的 Thunderbird 邮件客户端，也是 Firefox 浏览器的基础。通过与这些项目的交叉协作，SeaMonkey 既能获取（同时贡献）新功能，又能持续获得现代互联网应用必备的安全更新。SeaMonkey 协会为该项目提供法律支持。","tags":["gecko","浏览器","电子邮件","网页","网页浏览器","邮件"]}},"publisherUrl":"https://www.seamonkey-project.org/","releaseDate":"2025-06-05","releaseDateSource":"manifest","releaseNotesUrl":"https://www.seamonkey-project.org/news#2025-06-05","schemaVersion":1,"source":"winget","upstream":{"commit":"97d6aa2689f0a05f7847653a62b8624720d15b5d","manifestVersion":"1.10.0","manifests":[{"path":"manifests/m/Mozilla/SeaMonkey/2.53.21/Mozilla.SeaMonkey.yaml","sha256":"fbe9b4807dee993b9c24c9463eb1b16748d0ef88686a2e1d4ff85dc98f6a903d"},{"path":"manifests/m/Mozilla/SeaMonkey/2.53.21/Mozilla.SeaMonkey.installer.yaml","sha256":"32fc8b0626782824d676801e2f7aad1c0c343ced66c8daa40a0b3fb7c7990b9e"},{"path":"manifests/m/Mozilla/SeaMonkey/2.53.21/Mozilla.SeaMonkey.locale.en-US.yaml","sha256":"34229fa6ffb0c7e2911023fe2c83317e081f13029effe863dcd0c6eb293149c2"},{"path":"manifests/m/Mozilla/SeaMonkey/2.53.21/Mozilla.SeaMonkey.locale.zh-CN.yaml","sha256":"416a78203eb65e98e5220dd8ec730bdbfd374eaebb895ded0d53c46eb583beec"}],"repository":"microsoft/winget-pkgs"},"version":"2.53.21"}