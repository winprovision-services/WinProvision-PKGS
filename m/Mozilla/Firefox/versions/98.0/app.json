:"296b4637e6b6afcebac6b555440d77c21193d3a83fec474f0ad711463c5c9ae9","successCodes":[],"type":"msix","uninstall":{"type":"packageFamilyName","value":"Mozilla.MozillaFirefox_gmpnhwe7bv608"},"upgradeBehavior":"install","url":"https://download-installer.cdn.mozilla.net/pub/firefox/releases/98.0/win64/multi/Firefox%20Setup%2098.0.msix"},{"architecture":"x86","commands":["firefox"],"dependencies":[],"fileExtensions":["htm","html","url"],"id":"x86-msix","installModes":["silentWithProgress"],"minimumOSVersion":"10.0.0.0","platforms":["Windows.Desktop"],"priority":3,"protocols":["http","https"],"sha256":"3981bf9a8e57a2e78669aa36c4120cddb7af4c1182aecda57c9d08386bf19ff5","successCodes":[],"type":"msix","uninstall":{"type":"packageFamilyName","value":"Mozilla.MozillaFirefox_gmpnhwe7bv608"},"upgradeBehavior":"install","url":"https://download-installer.cdn.mozilla.net/pub/firefox/releases/98.0/win32/multi/Firefox%20Setup%2098.0.msix"}],"licenseUrl":"https://www.mozilla.org/en-US/MPL/2.0","packageLocalizations":{"de-DE":{"description":"Mozilla Firefox ist ein freier und quelloffener Webbrowser.","license":"Mozilla Public License Version 2.0","licenseUrl":"https://www.mozilla.org/en-US/MPL/2.0","locale":"de-DE","longDescription":"Mozilla Firefox, kurz Firefox genannt, ist ein freier Webbrowser des Mozilla-Projektes. Er wurde im September 2002 veröffentlicht. Firefox verwendet die Gecko-Layout-Engine zum Rendern von Webseiten, die aktuelle und erwartete Webstandards implementiert. Im Jahr 2017 begann Firefox mit der Einführung neuer Technologien unter dem Codenamen Quantum, um Parallelität und eine intuitivere Benutzeroberfläche zu fördern. Seine inoffiziellen Ports sind für verschiedene Unix- und Unix-ähnliche Betriebssysteme verfügbar, darunter FreeBSD, OpenBSD, NetBSD, illumos und Solaris Unix.","name":"Mozilla Firefox","packageUrl":"https://www.mozilla.org/de/firefox/","publisher":"Mozilla","publisherUrl":"https://www.mozilla.org/de/","tags":["webbrowser"]},"el-GR":{"description":"Firefox, ένα δωρεάν πρόγραμμα περιήγησης από τη Mozilla, μια μη κερδοσκοπική οργάνωση αφιερωμένη στην υγεία και το απόρρητο του διαδικτύου.","license":"Mozilla Public License Version 2.0","licenseUrl":"https://www.mozilla.org/MPL/2.0/","locale":"el-GR","name":"Mozilla Firefox","packageUrl":"https://www.mozilla.org/el/firefox/","publisher":"Mozilla","publisherUrl":"https://www.mozilla.org/el/","tags":[]},"en-US":{"description":"Mozilla Firefox is free and open source software, built by a community of thousands from all over the world.","license":"Mozilla Public License Version 2.0","licenseUrl":"https://www.mozilla.org/en-US/MPL/2.0","locale":"en-US","longDescription":"Firefox Browser, also known as Mozilla Firefox or simply Firefox, is a free and open-source web browser developed by the Mozilla Foundation and its subsidiary, the Mozilla Corporation.\nFirefox uses the Gecko layout engine to render web pages, which implements current and anticipated web standards.\nIn 2017, Firefox began incorporating new technology under the code name Quantum to promote parallelism and a more intuitive user interface.\nFirefox is officially available for Windows 7 or newer, macOS, and Linux.\nIts unofficial ports are available for various Unix and Unix-like operating systems including FreeBSD, OpenBSD, NetBSD, illumos, and Solaris Unix.","moniker":"firefox","name":"Mozilla Firefox","packageUrl":"https://www.mozilla.org/en-US/firefox/","publisher":"Mozilla","publisherUrl":"https://www.mozilla.org/en-US/","releaseNotesUrl":"https://www.mozilla.org/en-US/firefox/98.0/releasenotes/","tags":["browser","cross-platform","foss","gecko","quantum","spidermonkey","web","web-browser"]},"es-MX":{"description":"Mozilla Firefox es un software gratuito y de código abierto, creado por una comunidad de miles de personas de todo el mundo.","license":"Mozilla Public License Version 2.0","licenseUrl":"https://www.mozilla.org/es-MX/MPL/2.0/","locale":"es-MX","longDescription":"Firefox Browser, también conocido como Mozilla Firefox o simplemente Firefox, es un navegador web gratuito y de código abierto desarrollado por Mozilla Foundation y su subsidiaria, Mozilla Corporation. Firefox utiliza el motor de diseño Gecko para representar páginas web, que implementa estándares web actuales y anticipados. En 2017, Firefox comenzó a incorporar nueva tecnología con el nombre en código Quantum para promover el paralelismo y una interfaz de usuario más intuitiva. Firefox está disponible oficialmente para Windows 7 o más reciente, macOS y Linux. Sus puertos no oficiales están disponibles para varios sistemas operativos Unix y similares a Unix, incluidos FreeBSD, OpenBSD, NetBSD, illumos y Solaris Unix.","name":"Mozilla Firefox","packageUrl":"https://www.mozilla.org/es-MX/firefox/","publisher":"Mozilla","publisherUrl":"https://www.mozilla.org/es-MX/","tags":["navegador","navegador-web","web"]},"ja-JP":{"description":"高速で軽量、プライバシー重視のブラウザー","license":"Mozilla Public License Version 2.0","licenseUrl":"https://www.mozilla.org/en-US/MPL/2.0/","locale":"ja-JP","longDescription":"Mozilla Firefox は無料のオープンソースソフトウェアであり、世界中の多数のコミュニティによって開発されています。","name":"Mozilla Firefox","packageUrl":"https://www.mozilla.org/ja/firefox/","publisher":"Mozilla","publisherUrl":"https://www.mozilla.org/ja/","releaseNotesUrl":"https://www.mozilla.org/en-US/firefox/98.0/releasenotes/","tags":["browser","cross-platform","foss","gecko","quantum","spidermonkey","web","web-browser"]},"nb-NO":{"description":"Mozilla Firefox er gratis programvare med åpen kildekode, bygget av et samfunn på tusenvis fra hele verden.","license":"Mozilla Public License Version 2.0","licenseUrl":"https://www.mozilla.org/en-US/MPL/2.0","locale":"nb-NO","longDescription":"Firefox Browser, også kjent som Mozilla Firefox eller bare Firefox, er en gratis nettleser med åpen kildekode utviklet av Mozilla Foundation og dets datterselskap, Mozilla Corporation. Firefox bruker Gecko-layoutmotoren til å gjengi nettsider, som implementerer gjeldende og forventede webstandarder. I 2017 begynte Firefox å innlemme ny teknologi under kodenavnet Quantum for å fremme parallellitet og et mer intuitivt brukergrensesnitt. Firefox er offisielt tilgjengelig for Windows 7 eller nyere, macOS og Linux. Dens uoffisielle porter er tilgjengelige for forskjellige Unix og Unix-lignende operativsystemer, inkludert FreeBSD, OpenBSD, NetBSD, illumos og Solaris Unix.","name":"Mozilla Firefox","packageUrl":"https://www.mozilla.org/nb-NO/firefox/","publisher":"Mozilla","publisherUrl":"https://www.mozilla.org/nb-NO/","tags":["nettleser"]},"ru-RU":{"description":"Mozilla Firefox это бесплатное программное обеспечение с открытым исходным кодом, созданное сообществом тысяч людей со всего мира.","license":"Mozilla Public License Version 2.0","licenseUrl":"https://www.mozilla.org/en-US/MPL/2.0","locale":"ru-RU","longDescription":"Браузер Firefox, также известный как Mozilla Firefox или просто Firefox, - это бесплатный веб-браузер с открытым исходным кодом, разработанный Mozilla Foundation и его дочерней компанией Mozilla Corporation. Firefox использует механизм компоновки Gecko для отображения веб-страниц, который реализует текущие и ожидаемые веб-стандарты. В 2017 году Firefox начал включать новую технологию под кодовым названием Quantum, чтобы способствовать параллелизму и более интуитивному пользовательскому интерфейсу. Firefox официально доступен для Windows 7 или новее, macOS и Linux. Его неофициальные порты доступны для различных Unix и Unix-подобных операционных систем, включая FreeBSD, OpenBSD, NetBSD, illumos и Solaris Unix.","name":"Mozilla Firefox","packageUrl":"https://www.mozilla.org/ru/firefox/","publisher":"Mozilla","publisherUrl":"https://www.mozilla.org/ru/","tags":["браузер","веб-браузер"]},"zh-CN":{"description":"开放安全的开源浏览器","license":"MPL-2.0","licenseUrl":"https://www.mozilla.org/en-US/MPL/2.0/","locale":"zh-CN","longDescription":"Firefox 浏览器是唯一一款由非营利组织支持，不会将您的个人数据买给广告商，还能保护您个人信息的主流浏览器。","name":"Mozilla Firefox","packa