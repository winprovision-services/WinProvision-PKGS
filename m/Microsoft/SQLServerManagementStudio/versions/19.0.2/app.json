ame":"Microsoft SQL Server Management Studio - 19.0.2","DisplayVersion":"19.0.20209.0","ProductCode":"{ea092b38-5813-4490-aaa5-f90dae4163eb}"}],"architecture":"x64","dependencies":[],"elevation":{"requirement":"elevatesSelf","source":"manifest"},"fileExtensions":["SQL"],"id":"x64-machine-burn-8","installModes":["interactive","silent","silentWithProgress"],"installerSwitches":{"Custom":"/norestart"},"locale":"pt-BR","minimumOSVersion":"10.0.0.0","platforms":["Windows.Desktop"],"priority":1,"scope":"machine","sha256":"c88c84cd110af86868088a1ffcea7586f2b5a75ae1b76fe1d7d410f046eb9b9a","silent":{"arguments":"/quiet /norestart","source":"default"},"successCodes":[],"type":"burn","url":"https://go.microsoft.com/fwlink/?linkid=2226343&clcid=0x416"},{"appsAndFeaturesEntries":[{"DisplayName":"Microsoft SQL Server Management Studio - 19.0.2","DisplayVersion":"19.0.20209.0","ProductCode":"{cdcc27a2-5e24-4999-80a2-397e13d267a1}"}],"architecture":"x64","dependencies":[],"elevation":{"requirement":"elevatesSelf","source":"manifest"},"fileExtensions":["SQL"],"id":"x64-machine-burn-9","installModes":["interactive","silent","silentWithProgress"],"installerSwitches":{"Custom":"/norestart"},"locale":"ru-RU","minimumOSVersion":"10.0.0.0","platforms":["Windows.Desktop"],"priority":1,"scope":"machine","sha256":"6ab2e415255cc13f1ce668e2ca3270192a47566084a37431451d2a04f8c4c6a8","silent":{"arguments":"/quiet /norestart","source":"default"},"successCodes":[],"type":"burn","url":"https://go.microsoft.com/fwlink/?linkid=2226343&clcid=0x419"}],"packageLocalizations":{"de-DE":{"description":"SQL Server Management Studio (SSMS) ist eine integrierte Umgebung zum Verwalten jeder beliebigen SQL-Infrastruktur, von SQL Server bis hin zur Azure SQL-Datenbank","license":"Proprietary","locale":"de-DE","longDescription":"SQL Server Management Studio (SSMS) ist eine integrierte Umgebung zum Verwalten jeder beliebigen SQL-Infrastruktur, von SQL Server bis hin zur Azure SQL-Datenbank. SSMS stellt Tools zum Konfigurieren, Überwachen und Verwalten von Instanzen von SQL Server und Datenbanken zur Verfügung. Verwenden Sie SSMS, um Abfragen und Skripts zu erstellen sowie die Datenebenenkomponenten bereitzustellen, zu überwachen und zu aktualisieren, die von Ihren Anwendungen verwendet werden.","name":"Microsoft SQL Server Management Studio","packageUrl":"https://docs.microsoft.com/de-DE/sql/ssms/download-sql-server-management-studio-ssms","publisher":"Microsoft Corporation","publisherUrl":"https://www.microsoft.com/","releaseNotesUrl":"https://docs.microsoft.com/de-DE/sql/ssms/release-notes-ssms?view=sql-server-ver15#1902","tags":[]},"en-US":{"description":"SQL Server Management Studio (SSMS) is an integrated environment for managing any SQL infrastructure","license":"Proprietary","locale":"en-US","longDescription":"SQL Server Management Studio (SSMS) is an integrated environment for managing any SQL infrastructure, from SQL Server to Azure SQL Database. SSMS provides tools to configure, monitor, and administer instances of SQL Server and databases. Use SSMS to deploy, monitor, and upgrade the data-tier components used by your applications, and build queries and scripts.","moniker":"ssms","name":"Microsoft SQL Server Management Studio","packageUrl":"https://docs.microsoft.com/en-US/sql/ssms/download-sql-server-management-studio-ssms","publisher":"Microsoft Corporation","publisherUrl":"https://www.microsoft.com/","releaseNotesUrl":"https://docs.microsoft.com/en-US/sql/ssms/release-notes-ssms?view=sql-server-ver15#1902","tags":["management-studio","sql","sql-management-studio","sql-server","ssms"]},"es-ES":{"description":"SQL Server Management Studio (SSMS) es un entorno integrado para administrar cualquier infraestructura de SQL, desde SQL Server a Azure SQL Database","license":"Proprietary","locale":"es-ES","longDescription":"SQL Server Management Studio (SSMS) es un entorno integrado para administrar cualquier infraestructura de SQL, desde SQL Server a Azure SQL Database. SSMS proporciona herramientas para configurar, supervisar y administrar instancias de SQL Server y bases de datos. Use SSMS para implementar, supervisar y actualizar los componentes de nivel de datos que usan las aplicaciones, además de compilar consultas y scripts.","name":"Microsoft SQL Server Management Studio","packageUrl":"https://docs.microsoft.com/es-ES/sql/ssms/download-sql-server-management-studio-ssms","publisher":"Microsoft Corporation","publisherUrl":"https://www.microsoft.com/","releaseNotesUrl":"https://docs.microsoft.com/es-ES/sql/ssms/release-notes-ssms?view=sql-server-ver15#1902","tags":[]},"fr-FR":{"description":"SQL Server Management Studio (SSMS) est un environnement intégré pour la gestion des infrastructures SQL, de SQL Server à Azure SQL Database","license":"Proprietary","locale":"fr-FR","longDescription":"SQL Server Management Studio (SSMS) est un environnement intégré pour la gestion des infrastructures SQL, de SQL Server à Azure SQL Database. SSMS fournit des outils permettant de configurer, de superviser et d’administrer des instances de SQL Server et des bases de données. Utilisez SSMS pour déployer, superviser et mettre à niveau les composants de la couche Données utilisés par vos applications, ainsi que pour créer des requêtes et des scripts.","name":"Microsoft SQL Server Management Studio","packageUrl":"https://docs.microsoft.com/fr-FR/sql/ssms/download-sql-server-management-studio-ssms","publisher":"Microsoft Corporation","publisherUrl":"https://www.microsoft.com/","releaseNotesUrl":"https://docs.microsoft.com/fr-FR/sql/ssms/release-notes-ssms?view=sql-server-ver15#1902","tags":[]},"it-IT":{"description":"SQL Server Management Studio (SSMS) è un ambiente integrato per la gestione di qualsiasi infrastruttura SQL, da SQL Server al database SQL di Azure","license":"Proprietary","locale":"it-IT","longDescription":"SQL Server Management Studio (SSMS) è un ambiente integrato per la gestione di qualsiasi infrastruttura SQL, da SQL Server al database SQL di Azure. SSMS offre gli strumenti per configurare, monitorare e amministrare le istanze di SQL Server e i database. Usare SSMS per distribuire, monitorare e aggiornare i componenti del livello dati usati dalle applicazioni, nonché per creare query e script.","name":"Microsoft SQL Server Management Studio","packageUrl":"https://docs.microsoft.com/it-IT/sql/ssms/download-sql-server-management-studio-ssms","publisher":"Microsoft Corporation","publisherUrl":"https://www.microsoft.com/","releaseNotesUrl":"https://docs.microsoft.com/it-IT/sql/ssms/release-notes-ssms?view=sql-server-ver15#1902","tags":[]},"ja-JP":{"description":"SQL Server Management Studio (SSMS) は、SQL Server から Azure SQL Database まで、SQL インフラストラクチャを管理するための統合環境です","license":"Proprietary","locale":"ja-JP","longDescription":"SQL Server Management Studio (SSMS) は、SQL Server から Azure SQL Database まで、SQL インフラストラクチャを管理するための統合環境です。 SSMS には、SQL Server とデータベースのインスタンスを構成、監視、および管理するためのツールが備わっています。 SSMS を使用して、ご利用のアプリケーションで使われるデータ層コンポーネントを配置、監視、アップグレードしたり、クエリとスクリプトを作成したりすることができます。","name":"Microsoft SQL Server Management Studio","packageUrl":"https://docs.microsoft.com/ja-JP/sql/ssms/download-sql-server-management-studio-ssms","publisher":"Microsoft Corporation","publisherUrl":"https://www.microsoft.com/","releaseNotesUrl":"https://docs.microsoft.com/ja-JP/sql/ssms/release-notes-ssms?view=sql-server-ver15#1902","tags":[]},"ko-KR":{"description":"SSMS(SQL Server Management Studio)는 SQL Server에서 Azure SQL Database까지 모든 SQL 인프라를 관리하기 위한 통합 환경입니다","license":"Proprietary","locale":"ko-KR","longDescription":"SSMS(SQL Server Management Studio)는 SQL Server에서 Azure SQL Database까지 모든 SQL 인프라를 관리하기 위한 통합 환경입니다. SSMS는 SQL Server 및 데이터베이스의 인스턴스를 구성, 모니터링 및 관리하는 도구를 제공합니다. SSMS를 사용하면 애플리케이션에 사용되는 데이터 계층 구성 요소를 배포, 모니터링 및 업그레이드하고 쿼리 및 스크립트를 작성할 수 있습니다.","name":"Microsoft SQL Server Management Studio","packageUrl":"https://docs.microsoft.com/ko-KR/sql/ssms/download-sql-server-management-studio-ssms","publisher":"Microsoft Corporation","publisherUrl":"https://www.microsoft.com/","releaseNotesUrl":"https://docs.microsoft.com/ko-KR/sql/ssms/release-notes-ssms?view=sql-server-ver15#1902","tags":[]},"pt-BR":{"description":"O SSMS (SQL Server Management Studio) é um ambiente integrado para gerenciar qualquer infraestrutura de SQL, do SQL Server para o Banco de Dados SQL do Azure","license":"Proprietary","locale":"pt-BR","longDescription":"O SSMS (SQL Server Management Studio) é um ambiente integrado para gerenciar qualquer infraestrutura de SQL, do SQL Server para o Banco de Dados SQL do Azure. O SSMS fornece ferramentas para configurar, monitorar e administrar instâncias do SQL Server e bancos de dados. Use o SSMS para implantar, monitorar e atualizar os componentes da camada de dados usados pelos seus aplicativos, além de criar consultas e scripts.","name":"Microsoft SQL Server Management Studio","packageUrl":"https://docs.microsoft.com/pt-BR/sql/ssms/download-sql-server-management-studio-ssms","publisher":"Microsoft Corporation","publisherUrl":"https://www.microsoft.com/","releaseNotesUrl":"https://docs.microsoft.com/pt-BR/sql/ssms/release-notes-ssms?view=sql-server-ver15#1902","tags":[]},"ru-RU":{"description":"SQL Server Management Studio (SSMS) — это интегрированная среда для управления любой инфраструктурой SQL, от SQL Server до баз данных SQL Azure","license":"Proprietary","locale":"ru-RU","longDescription":"SQL Server Management Studio (SSMS) — это интегрированная среда для управления любой инфраструктурой SQL, от SQL Server до баз данных SQL Azure. SSMS предоставляет средства для настройки, наблюдения и администрирования экземпляров SQL Server и баз данных. С помощью SSMS можно развертывать, отслеживать и обновлять компоненты уровня данных, используемые вашими приложениями, а также создавать запросы и скрипты.","name":"Microsoft SQL Server Management Studio","packageUrl":"https://docs.microsoft.com/ru-RU/sql/ssms/download-sql-server-management-studio-ssms","publisher":"Microsoft