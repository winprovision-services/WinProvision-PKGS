lp files. It does not contain non-troubleshooting tools like the BSOD Screen Saver.\n\nThe Suite is a bundling of the following selected Sysinternals Utilities: AccessChk, AccessEnum, AdExplorer, AdInsight, AdRestore, Autologon, Autoruns, BgInfo, BlueScreen, CacheSet, ClockRes, Contig, Coreinfo, Ctrl2Cap, DebugView, Desktops, Disk2vhd, DiskExt, DiskMon, DiskView, Disk Usage (DU), EFSDump, FindLinks, Handle, Hex2dec, Junction, LDMDump, ListDLLs, LiveKd, LoadOrder, LogonSessions, MoveFile, NotMyFault, NTFSInfo, PendMoves, PipeList, PortMon, ProcDump, Process Explorer, Process Monitor, PsExec, PsFile, PsGetSid, PsInfo, PsKill, PsList, PsLoggedOn, PsLogList, PsPasswd, PsPing, PsService, PsShutdown, PsSuspend, PsTools, RAMMap, RDCMan, RegDelNull, RegHide, RegJump, Registry Usage (RU), SDelete, ShareEnum, ShellRunas, Sigcheck, Streams, Strings, Sync, Sysmon, TCPView, VMMap, VolumeID, WhoIs, WinObj, ZoomIt","moniker":"sysinternals","name":"Sysinternals Suite","packageUrl":"https://learn.microsoft.com/en-us/sysinternals/downloads/sysinternals-suite","publisher":"Sysinternals","publisherUrl":"https://www.sysinternals.com/","tags":["sysinternals"]}},"publisherUrl":"https://www.sysinternals.com/","releaseDate":"2026-10-15","releaseDateSource":"manifest","schemaVersion":1,"source":"winget","upstream":{"commit":"97d6aa2689f0a05f7847653a62b8624720d15b5d","manifestVersion":"1.28.0","manifests":[{"path":"manifests/m/Microsoft/Sysinternals/Suite/2026-10-15/Microsoft.Sysinternals.Suite.yaml","sha256":"43723957158bf4729478564c9c0410c9a16652802c2893a4c0c85a461705823b"},{"path":"manifests/m/Microsoft/Sysinternals/Suite/2026-10-15/Microsoft.Sysinternals.Suite.installer.yaml","sha256":"dc16893e9987ed80cd36fec3ab0c78d72edf4ddd41e51a4d008569b06479c295"},{"path":"manifests/m/Microsoft/Sysinternals/Suite/2026-10-15/Microsoft.Sysinternals.Suite.locale.en-US.yaml","sha256":"ca8f5716f0759038e858982c20e6c73dc0820d62d7aeb11166bf609bfdf9bc6b"}],"repository":"microsoft/winget-pkgs"},"version":"2026-