{"defaultLocale":"en-US","id":"Microsoft.Sysinternals.RAMMap","installers":[{"architecture":"arm64","commands":["rammap"],"dependencies":[],"id":"arm64-zip","installModes":["interactive","silent","silentWithProgress"],"locale":"en-US","nestedInstallerFiles":[{"PortableCommandAlias":"rammap","RelativeFilePath":"RAMMap64a.exe"}],"nestedInstallerType":"portable","priority":4,"sha256":"6536a8107a3fb391e4443f2742366067341a7da50de89f99ca0b2390120dd0cc","successCodes":[],"type":"zip","upgradeBehavior":"uninstallPrevious","url":"https://download.sysinternals.com/files/RAMMap.zip"},{"architecture":"x64","commands":["rammap"],"dependencies":[],"id":"x64-zip","installModes":["interactive","silent","silentWithProgress"],"locale":"en-US","nestedInstallerFiles":[{"PortableCommandAlias":"rammap","RelativeFilePath":"RAMMap64.exe"}],"nestedInstallerType":"portable","priority":4,"sha256":"6536a8107a3fb391e4443f2742366067341a7da50de89f99ca0b2390120dd0cc","successCodes":[],"type":"zip","upgradeBehavior":"uninstallPrevious","url":"https://download.sysinternals.com/files/RAMMap.zip"},{"architecture":"x86","commands":["rammap"],"dependencies":[],"id":"x86-zip","installModes":["interactive","silent","silentWithProgress"],"locale":"en-US","nestedInstallerFiles":[{"PortableCommandAlias":"rammap","RelativeFilePath":"RAMMap.exe"}],"nestedInstallerType":"portable","priority":4,"sha256":"6536a8107a3fb391e4443f2742366067341a7da50de89f99ca0b2390120dd0cc","successCodes":[],"type":"zip","upgradeBehavior":"uninstallPrevious","url":"https://download.sysinternals.com/files/RAMMap.zip"}],"licenseUrl":"https://learn.microsoft.com/en-us/sysinternals/license-terms","packageLocalizations":{"en-US":{"description":"An advanced physical memory usage analysis utility for Windows Vista and higher.","license":"Proprietary","licenseUrl":"https://learn.microsoft.com/en-us/sysinternals/license-terms","locale":"en-US","longDescription":"Have you ever wondered exactly how Windows is assigning physical memory, how much file data is cached in RAM, or how much RAM is used by the kernel and device drivers? RAMMap makes answering those questions easy. \nRAMMap is an advanced physical memory usage analysis utility for Windows Vista and higher.\n\nIt presents usage information in different ways on its several different tabs:\n- Use Counts: usage summary by type and paging list\n- Processes: process working set sizes\n- Priority Summary: prioritized standby list sizes\n- Physical Pages: per-page use for all physical memory\n- Physical Ranges: physical memory addresses\n- File Summary: file data in RAM by file\n- File Details: individual physical pages by file\n\nUse RAMMap to gain understanding of the way Windows manages memory, to analyze application memory usage, or to answer specific questions about how RAM is being allocated. RAMMap’s refresh feature enables you to update the display and it includes support for saving and loading memory snapshots.","moniker":"rammap","name":"RAMMap","packageUrl":"https://learn.microsoft.com/en-us/sysinternals/downloads/rammap","publisher":"Sysinternals","publisherUrl":"https://www.sysinternals.com/","tags":["sysinternals"]}},"publisherUrl":"https://www.sysinternals.com/","releaseDate":"2026-03-26","releaseDateSource":"manifest","schemaVersion":1,"source":"winget","upstream":{"commit":"97d6aa2689f0a05f7847653a62b8624720d15b5d","manifestVersion":"1.12.0","manifests":[{"path":"manifests/m/Microsoft/Sysinternals/RAMMap/1.63/Microsoft.Sysinternals.RAMMap.yaml","sha256":"f618c0936726167abea66da09acee23c71a03b8e4449c6955d85e9f695f8865a"},{"path":"manifests/m/Microsoft/Sysinternals/RAMMap/1.63/Microsoft.Sysinternals.RAMMap.installer.yaml","sha256":"9e1c12fd0ff972bb3dcd12ab12e4af9cc78b7affe687e07c4fd9a7bca3e13383"},{"path":"manifests/m/Microsoft/Sysinternals/RAMMap/1.63/Microsoft.Sysinternals.RAMMap.locale.en-US.yaml","sha256":"f13590528f8f5f6317e3fb59d0efc882a23434033192d58529dcb949f852f0c0"}],"repository":"microsoft/winget-pkgs"},"version":"1.63"}