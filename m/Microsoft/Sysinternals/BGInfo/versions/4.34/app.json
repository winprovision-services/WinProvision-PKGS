{"defaultLocale":"en-US","id":"Microsoft.Sysinternals.BGInfo","installers":[{"architecture":"x86","commands":["bginfo"],"dependencies":[],"id":"x86-zip","installModes":["interactive","silent","silentWithProgress"],"nestedInstallerFiles":[{"PortableCommandAlias":"bginfo","RelativeFilePath":"Bginfo.exe"}],"nestedInstallerType":"portable","priority":4,"sha256":"675cc582e1057b357e4f4cd37be9cecad2e811da7d841e5d0631a0b1816b9e51","successCodes":[],"type":"zip","upgradeBehavior":"uninstallPrevious","url":"https://download.sysinternals.com/files/BGInfo.zip"},{"architecture":"x64","commands":["bginfo"],"dependencies":[],"id":"x64-zip","installModes":["interactive","silent","silentWithProgress"],"nestedInstallerFiles":[{"PortableCommandAlias":"bginfo","RelativeFilePath":"Bginfo64.exe"}],"nestedInstallerType":"portable","priority":4,"sha256":"675cc582e1057b357e4f4cd37be9cecad2e811da7d841e5d0631a0b1816b9e51","successCodes":[],"type":"zip","upgradeBehavior":"uninstallPrevious","url":"https://download.sysinternals.com/files/BGInfo.zip"}],"licenseUrl":"https://learn.microsoft.com/en-us/sysinternals/license-terms","packageLocalizations":{"en-US":{"author":"Mark Russinovich","copyright":"Copyright © 1996-2025 Mark Russinovich","description":"Automatically display relevant information about a Windows computer on the desktop's background.","documentations":[{"DocumentLabel":"Sysinternals Blog","DocumentUrl":"https://techcommunity.microsoft.com/category/windows/blog/sysinternals-blog"},{"DocumentLabel":"Sysinternals Resources","DocumentUrl":"https://learn.microsoft.com/en-us/sysinternals/resources/"},{"DocumentLabel":"Sysinternals Utilities Index","DocumentUrl":"https://learn.microsoft.com/en-us/sysinternals/downloads/"},{"DocumentLabel":"Troubleshooting with the Windows Sysinternals Tools","DocumentUrl":"https://learn.microsoft.com/en-us/sysinternals/resources/troubleshooting-book"}],"license":"Proprietary","licenseUrl":"https://learn.microsoft.com/en-us/sysinternals/license-terms","locale":"en-US","longDescription":"BGInfo  automatically displays relevant information about a Windows computer on the desktop's background, such as the computer name, IP address, service pack version, and more. You can edit any field as well as the font and background colors, and can place it in your startup folder so that it runs every boot, or even configure it to display as the background for the logon screen.\n\nBecause BGInfo simply writes a new desktop bitmap and exits, you don't have to worry about it consuming system resources or interfering with other applications.\n\nBy placing BGInfo in your Startup folder, you can ensure that the system information being displayed is up to date each time you boot. Once you've settled on the information to be displayed, use the command-line option /timer:0 to update the display without showing the dialog box.\n\nYou can also use the Windows Scheduler to run BGInfo on a regular basis to ensure long-running systems are kept up to date.","moniker":"bginfo","name":"BGInfo","packageUrl":"https://learn.microsoft.com/en-us/sysinternals/downloads/bginfo","privacyUrl":"https://learn.microsoft.com/en-us/sysinternals/license-terms","publisher":"Sysinternals","publisherSupportUrl":"https://learn.microsoft.com/en-us/answers/tags/435/sysinternals","publisherUrl":"https://www.sysinternals.com/","tags":["sysinternals"]}},"publisherSupportUrl":"https://learn.microsoft.com/en-us/answers/tags/435/sysinternals","publisherUrl":"https://www.sysinternals.com/","releaseDate":"2026-11-06","releaseDateSource":"commit","schemaVersion":1,"source":"winget","upstream":{"commit":"a4a78ef7dd5a1ec000e60392173b33bed55f7cbb","manifestVersion":"1.28.0","manifests":[{"path":"manifests/m/Microsoft/Sysinternals/BGInfo/4.34/Microsoft.Sysinternals.BGInfo.installer.yaml","sha256":"cac9fbea187bc078d2c6401059bbf720c1a5cdb791472d359bb1a1ecd8e0aebb"},{"path":"manifests/m/Microsoft/Sysinternals/BGInfo/4.34/Microsoft.Sysinternals.BGInfo.locale.en-US.yaml","sha256":"7123