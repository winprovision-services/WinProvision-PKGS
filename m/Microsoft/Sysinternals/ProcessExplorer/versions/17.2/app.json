{"defaultLocale":"en-US","id":"Microsoft.Sysinternals.ProcessExplorer","installers":[{"architecture":"arm64","commands":["procexp"],"dependencies":[],"id":"arm64-zip","installModes":["interactive","silent","silentWithProgress"],"nestedInstallerFiles":[{"PortableCommandAlias":"procexp","RelativeFilePath":"procexp64a.exe"}],"nestedInstallerType":"portable","priority":4,"sha256":"dab147316264b89ae46ae2ad7d8a94116848ef0b703bcac8de9ff22689ce9d51","successCodes":[],"type":"zip","upgradeBehavior":"uninstallPrevious","url":"https://download.sysinternals.com/files/ProcessExplorer.zip"},{"architecture":"x64","commands":["procexp"],"dependencies":[],"id":"x64-zip","installModes":["interactive","silent","silentWithProgress"],"nestedInstallerFiles":[{"PortableCommandAlias":"procexp","RelativeFilePath":"procexp64.exe"}],"nestedInstallerType":"portable","priority":4,"sha256":"dab147316264b89ae46ae2ad7d8a94116848ef0b703bcac8de9ff22689ce9d51","successCodes":[],"type":"zip","upgradeBehavior":"uninstallPrevious","url":"https://download.sysinternals.com/files/ProcessExplorer.zip"},{"architecture":"x86","commands":["procexp"],"dependencies":[],"id":"x86-zip","installModes":["interactive","silent","silentWithProgress"],"nestedInstallerFiles":[{"PortableCommandAlias":"procexp","RelativeFilePath":"procexp.exe"}],"nestedInstallerType":"portable","priority":4,"sha256":"dab147316264b89ae46ae2ad7d8a94116848ef0b703bcac8de9ff22689ce9d51","successCodes":[],"type":"zip","upgradeBehavior":"uninstallPrevious","url":"https://download.sysinternals.com/files/ProcessExplorer.zip"}],"licenseUrl":"https://learn.microsoft.com/en-us/sysinternals/license-terms","packageLocalizations":{"en-US":{"description":"Process Explorer shows you information about which handles and DLLs processes have opened or loaded.","license":"Proprietary","licenseUrl":"https://learn.microsoft.com/en-us/sysinternals/license-terms","locale":"en-US","longDescription":"Ever wondered which program has a particular file or directory open? Now you can find out. Process Explorer shows you information about which handles and DLLs processes have opened or loaded.\n\nThe Process Explorer display consists of two sub-windows. The top window always shows a list of the currently active processes, including the names of their owning accounts, whereas the information displayed in the bottom window depends on the mode that Process Explorer is in: if it is in handle mode you'll see the handles that the process selected in the top window has opened; if Process Explorer is in DLL mode you'll see the DLLs and memory-mapped files that the process has loaded. Process Explorer also has a powerful search capability that will quickly show you which processes have particular handles opened or DLLs loaded.\n\nThe unique capabilities of Process Explorer make it useful for tracking down DLL-version problems or handle leaks, and provide insight into the way Windows and applications work.","moniker":"procexp","name":"Process Explorer","packageUrl":"https://learn.microsoft.com/en-us/sysinternals/downloads/process-explorer","publisher":"Sysinternals","publisherUrl":"https://www.sysinternals.com/","tags":["diagnostics","dll","handle","process","process-explorer","sysinternals","system-monitoring","task-manager","thread","windows"]}},"publisherUrl":"https://www.sysinternals.com/","releaseDate":"2026-10-15","releaseDateSource":"manifest","schemaVersion":1,"source":"winget","upstream":{"commit":"97d6aa2689f0a05f7847653a62b8624720d15b5d","manifestVersion":"1.28.0","manifests":[{"path":"manifests/m/Microsoft/Sysinternals/ProcessExplorer/17.2/Microsoft.Sysinternals.ProcessExplorer.yaml","sha256":"253176aaa06696baadd9c7cea8f9829413122c14c91fe3d5d877d94538a3d956"},{"path":"manifests/m/Microsoft/Sysinternals/ProcessExplorer/17.2/Microsoft.Sysinternals.ProcessExplorer.installer.yaml","sha256":"5d17bb15dac5333b6736b5e53927763e329f817ac575c60a6cecff95821db8cc"},{"path":"manifests/m/Microsoft/Sysinternals/ProcessExplorer/17.2/Microsoft.Sysi