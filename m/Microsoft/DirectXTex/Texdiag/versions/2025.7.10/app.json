{"defaultLocale":"en-US","id":"Microsoft.DirectXTex.Texdiag","installers":[{"architecture":"arm64","commands":["texdiag"],"dependencies":[{"PackageDependencies":[{"PackageIdentifier":"Microsoft.VCRedist.2015+.arm64"}]}],"fileExtensions":["bmp","dds","hdr","jpg","jxr","png","tga"],"id":"arm64-portable","priority":4,"sha256":"94e2ff96529ba29815cd3cc50e0581f1b916735efded59ee316153daa6422792","successCodes":[],"type":"portable","url":"https://github.com/microsoft/DirectXTex/releases/download/jul2025/texdiag_arm64.exe"},{"architecture":"x64","commands":["texdiag"],"dependencies":[{"PackageDependencies":[{"PackageIdentifier":"Microsoft.VCRedist.2015+.x64"}]}],"fileExtensions":["bmp","dds","hdr","jpg","jxr","png","tga"],"id":"x64-portable","priority":4,"sha256":"eee45afd12009c92c93a4c253816a5f57655a523f9297dd0b15dfe10b71efd6c","successCodes":[],"type":"portable","url":"https://github.com/microsoft/DirectXTex/releases/download/jul2025/texdiag.exe"}],"licenseUrl":"https://github.com/microsoft/DirectXTex/raw/refs/heads/main/LICENSE","packageLocalizations":{"en-US":{"description":"Texdiag is a diagnostic command-line tool from Microsoft's DirectXTex library, designed for analyzing and debugging texture files (e.g., DDS, PNG, TGA).","license":"MIT","licenseUrl":"https://github.com/microsoft/DirectXTex/raw/refs/heads/main/LICENSE","locale":"en-US","longDescription":"Texdiag is a diagnostic command-line tool from Microsoft's DirectXTex library, designed for analyzing and debugging texture files (e.g., DDS, PNG, TGA). Unlike texconv (conversion) and texassemble (texture combining), texdiag focuses on inspecting texture properties, validating data, and detecting errors.\n\nKey Features:\n- Texture Info Dump: Displays metadata (format, dimensions, mip levels, array size, etc.).\n- Error Detection: Checks for corrupted or malformed texture files.\n- Pixel Analysis: Examines specific pixel values (useful for debugging artifacts).\n- Comparison Mode: Compares two textures (e.g., before/after compression).\n- DDS Validation: Verifies if a DDS file follows format specifications.","moniker":"texdiag","name":"DirectX Texture Diagnostic Tool","packageUrl":"https://github.com/microsoft/DirectXTex/wiki/Texdiag","publisher":"Microsoft Corporation","publisherUrl":"https://www.microsoft.com/","releaseNotesUrl":"https://github.com/microsoft/DirectXTex/releases/tag/jul2025","tags":["dds","direct3d","direct3d-texture-resources","directx","directx-11","directx-12","directxtex","microsoft","textures","wic-codec","xbox","command-line"]}},"publisherUrl":"https://www.microsoft.com/","releaseDate":"2025-07-10","releaseDateSource":"manifest","releaseNotesUrl":"https://github.com/microsoft/DirectXTex/releases/tag/jul2025","schemaVersion":1,"source":"winget","upstream":{"commit":"97d6aa2689f0a05f7847653a62b8624720d15b5d","manifestVersion":"1.10.0","manifests":[{"path":"manifests/m/Microsoft/DirectXTex/Texdiag/2025.7.10/Microsoft.DirectXTex.Texdiag.yaml","sha256":"96d424a7a0709fa13ed35e59fd723d4454b859f5bfc40704366e164a8b1885cf"},{"path":"manifests/m/Microsoft/DirectXTex/Texdiag/2025.7.10/Microsoft.DirectXTex.Texdiag.installer.yaml","sha256":"350b1645c285790b3298e21ab727698891010cd1872ea1aa23f4d19db45c8e35"},{"path":"manifests/m/Microsoft/DirectXTex/Texdiag/2025.7.10/Microsoft.DirectXTex.Texdiag.locale.en-US.yaml","sha256":"2e96bca59d3827afc7fa5a0a0e03bced9ec7b2fa81dae0b7113f1128685f772b"}],"repository":"microsoft/winget-pkgs"},"version":"2025.7.10"}