{"defaultLocale":"en-US","id":"Microsoft.DirectXTex.Texassemble","installers":[{"architecture":"arm64","commands":["texassemble"],"dependencies":[{"PackageDependencies":[{"PackageIdentifier":"Microsoft.VCRedist.2015+.arm64"}]}],"fileExtensions":["bmp","dds","hdr","jpg","jxr","png","tga"],"id":"arm64-portable","priority":4,"sha256":"e8293f4e285f2039388f52a80b107f58f466b403084ee0a69930a1f9efd5003c","successCodes":[],"type":"portable","url":"https://github.com/microsoft/DirectXTex/releases/download/may2026/texassemble_arm64.exe"},{"architecture":"x64","commands":["texassemble"],"dependencies":[{"PackageDependencies":[{"PackageIdentifier":"Microsoft.VCRedist.2015+.x64"}]}],"fileExtensions":["bmp","dds","hdr","jpg","jxr","png","tga"],"id":"x64-portable","priority":4,"sha256":"324721a80cf954eccfd888a6c587f6602146f043a01d0181af25884c549e8f46","successCodes":[],"type":"portable","url":"https://github.com/microsoft/DirectXTex/releases/download/may2026/texassemble.exe"}],"licenseUrl":"https://github.com/microsoft/DirectXTex/raw/refs/heads/main/LICENSE","packageLocalizations":{"en-US":{"description":"Texassemble is a command-line tool from Microsoft's DirectXTex library, designed for assembling and processing texture arrays, cubemaps, volume maps, and other complex texture types.","license":"MIT","licenseUrl":"https://github.com/microsoft/DirectXTex/raw/refs/heads/main/LICENSE","locale":"en-US","longDescription":"Texassemble is a command-line tool from Microsoft's DirectXTex library, designed for assembling and processing texture arrays, cubemaps, volume maps, and other complex texture types. It works alongside texconv (which handles single-texture operations) to create combined texture resources.\n\nKey Features:\n- Texture Arrays: Combines multiple 2D textures into a single texture array (.dds).\n- Cubemaps: Assembles six faces (or a strip) into a cubemap texture.\n- Volume Maps: Constructs 3D textures from a series of 2D slices.\n- Mipmap Support: Generates mipmaps for assembled textures.\n- Format Conversion: Supports standard formats (DDS, PNG, TGA, etc.) and block compression (BC1-BC7).\n- Alpha & Metadata Handling: Preserves transparency and metadata where applicable.","moniker":"texassemble","name":"DirectX Texture Assembler","packageUrl":"https://github.com/microsoft/DirectXTex/wiki/Texassemble","publisher":"Microsoft Corporation","publisherUrl":"https://www.microsoft.com/","releaseNotesUrl":"https://github.com/microsoft/DirectXTex/releases/tag/may2026","tags":["dds","direct3d","direct3d-texture-resources","directx","directx-11","directx-12","directxtex","microsoft","textures","wic-codec","xbox","command-line"]}},"publisherUrl":"https://www.microsoft.com/","releaseDate":"2026-05-07","releaseDateSource":"manifest","releaseNotesUrl":"https://github.com/microsoft/DirectXTex/releases/tag/may2026","schemaVersion":1,"source":"winget","upstream":{"commit":"97d6aa2689f0a05f7847653a62b8624720d15b5d","manifestVersion":"1.12.0","manifests":[{"path":"manifests/m/Microsoft/DirectXTex/Texassemble/2026.5.7/Microsoft.DirectXTex.Texassemble.yaml","sha256":"39952fad95cf319a2d70e226f3ca712b51b48caba281bd2989c8b25611617b9a"},{"path":"manifests/m/Microsoft/DirectXTex/Texassemble/2026.5.7/Microsoft.DirectXTex.Texassemble.installer.yaml","sha256":"2896c21de719a8712cfaf4a91941c061fc99995ecf6e8622e1d8d322bebcc078"},{"path":"manifests/m/Microsoft/DirectXTex/Texassemble/2026.5.7/Microsoft.DirectXTex.Texassemble.locale.en-US.yaml","sha256":"f469e9e3be36d024e859d61e3b1baa4491875fe424681c3713bc3b944a25e88b"}],"repository":"microsoft/winget-pkgs"},"version":"2026.5.7"}