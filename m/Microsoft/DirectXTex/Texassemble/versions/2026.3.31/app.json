{"defaultLocale":"en-US","id":"Microsoft.DirectXTex.Texassemble","installers":[{"architecture":"arm64","commands":["texassemble"],"dependencies":[{"PackageDependencies":[{"PackageIdentifier":"Microsoft.VCRedist.2015+.arm64"}]}],"fileExtensions":["bmp","dds","hdr","jpg","jxr","png","tga"],"id":"arm64-portable","priority":4,"sha256":"4c2effaf5e0a1381bd4113210891f693184661426d2fec291ec023b859d9fc0a","successCodes":[],"type":"portable","url":"https://github.com/microsoft/DirectXTex/releases/download/mar2026/texassemble_arm64.exe"},{"architecture":"x64","commands":["texassemble"],"dependencies":[{"PackageDependencies":[{"PackageIdentifier":"Microsoft.VCRedist.2015+.x64"}]}],"fileExtensions":["bmp","dds","hdr","jpg","jxr","png","tga"],"id":"x64-portable","priority":4,"sha256":"50ea15177c71612bedc3f045462e719c38f02a6a6ee7978962c44b052746cc86","successCodes":[],"type":"portable","url":"https://github.com/microsoft/DirectXTex/releases/download/mar2026/texassemble.exe"}],"licenseUrl":"https://github.com/microsoft/DirectXTex/raw/refs/heads/main/LICENSE","packageLocalizations":{"en-US":{"description":"Texassemble is a command-line tool from Microsoft's DirectXTex library, designed for assembling and processing texture arrays, cubemaps, volume maps, and other complex texture types.","license":"MIT","licenseUrl":"https://github.com/microsoft/DirectXTex/raw/refs/heads/main/LICENSE","locale":"en-US","longDescription":"Texassemble is a command-line tool from Microsoft's DirectXTex library, designed for assembling and processing texture arrays, cubemaps, volume maps, and other complex texture types. It works alongside texconv (which handles single-texture operations) to create combined texture resources.\n\nKey Features:\n- Texture Arrays: Combines multiple 2D textures into a single texture array (.dds).\n- Cubemaps: Assembles six faces (or a strip) into a cubemap texture.\n- Volume Maps: Constructs 3D textures from a series of 2D slices.\n- Mipmap Support: Generates mipmaps for assembled textures.\n- Format Conversion: Supports standard formats (DDS, PNG, TGA, etc.) and block compression (BC1-BC7).\n- Alpha & Metadata Handling: Preserves transparency and metadata where applicable.","moniker":"texassemble","name":"DirectX Texture Assembler","packageUrl":"https://github.com/microsoft/DirectXTex/wiki/Texassemble","publisher":"Microsoft Corporation","publisherUrl":"https://www.microsoft.com/","releaseNotesUrl":"https://github.com/microsoft/DirectXTex/releases/tag/mar2026","tags":["dds","direct3d","direct3d-texture-resources","directx","directx-11","directx-12","directxtex","microsoft","textures","wic-codec","xbox","command-line"]}},"publisherUrl":"https://www.microsoft.com/","releaseDate":"2026-03-31","releaseDateSource":"manifest","releaseNotesUrl":"https://github.com/microsoft/DirectXTex/releases/tag/mar2026","schemaVersion":1,"source":"winget","upstream":{"commit":"97d6aa2689f0a05f7847653a62b8624720d15b5d","manifestVersion":"1.12.0","manifests":[{"path":"manifests/m/Microsoft/DirectXTex/Texassemble/2026.3.31/Microsoft.DirectXTex.Texassemble.yaml","sha256":"6e389a56c1d45d03c4f960af84bd7df4008965296b852a8b1fa51a66131a79a4"},{"path":"manifests/m/Microsoft/DirectXTex/Texassemble/2026.3.31/Microsoft.DirectXTex.Texassemble.installer.yaml","sha256":"99182fae92741bced13e147b677036839044f857a4ad1255157d21da650a70fb"},{"path":"manifests/m/Microsoft/DirectXTex/Texassemble/2026.3.31/Microsoft.DirectXTex.Texassemble.locale.en-US.yaml","sha256":"8be62ae607db99ca85b2bda8bdcae4c5d32c519d9861fbd83dd77a46f4a8e6aa"}],"repository":"microsoft/winget-pkgs"},"version":"2026.3.31"}