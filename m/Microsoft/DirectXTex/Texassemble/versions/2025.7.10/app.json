{"defaultLocale":"en-US","id":"Microsoft.DirectXTex.Texassemble","installers":[{"architecture":"arm64","commands":["texassemble"],"dependencies":[{"PackageDependencies":[{"PackageIdentifier":"Microsoft.VCRedist.2015+.arm64"}]}],"fileExtensions":["bmp","dds","hdr","jpg","jxr","png","tga"],"id":"arm64-portable","priority":4,"sha256":"b834102bb587685abf6db48f626fb4801c30f8db1ea2761e6f5ce521edc082bd","successCodes":[],"type":"portable","url":"https://github.com/microsoft/DirectXTex/releases/download/jul2025/texassemble_arm64.exe"},{"architecture":"x64","commands":["texassemble"],"dependencies":[{"PackageDependencies":[{"PackageIdentifier":"Microsoft.VCRedist.2015+.x64"}]}],"fileExtensions":["bmp","dds","hdr","jpg","jxr","png","tga"],"id":"x64-portable","priority":4,"sha256":"44880736036a88a143f420bb6c4b8e59cf9c9ea0cc0b4759010d809ad3925ae8","successCodes":[],"type":"portable","url":"https://github.com/microsoft/DirectXTex/releases/download/jul2025/texassemble.exe"}],"licenseUrl":"https://github.com/microsoft/DirectXTex/raw/refs/heads/main/LICENSE","packageLocalizations":{"en-US":{"description":"Texassemble is a command-line tool from Microsoft's DirectXTex library, designed for assembling and processing texture arrays, cubemaps, volume maps, and other complex texture types.","license":"MIT","licenseUrl":"https://github.com/microsoft/DirectXTex/raw/refs/heads/main/LICENSE","locale":"en-US","longDescription":"Texassemble is a command-line tool from Microsoft's DirectXTex library, designed for assembling and processing texture arrays, cubemaps, volume maps, and other complex texture types. It works alongside texconv (which handles single-texture operations) to create combined texture resources.\n\nKey Features:\n- Texture Arrays: Combines multiple 2D textures into a single texture array (.dds).\n- Cubemaps: Assembles six faces (or a strip) into a cubemap texture.\n- Volume Maps: Constructs 3D textures from a series of 2D slices.\n- Mipmap Support: Generates mipmaps for assembled textures.\n- Format Conversion: Supports standard formats (DDS, PNG, TGA, etc.) and block compression (BC1-BC7).\n- Alpha & Metadata Handling: Preserves transparency and metadata where applicable.","moniker":"texassemble","name":"DirectX Texture Assembler","packageUrl":"https://github.com/microsoft/DirectXTex/wiki/Texassemble","publisher":"Microsoft Corporation","publisherUrl":"https://www.microsoft.com/","releaseNotesUrl":"https://github.com/microsoft/DirectXTex/releases/tag/jul2025","tags":["dds","direct3d","direct3d-texture-resources","directx","directx-11","directx-12","directxtex","microsoft","textures","wic-codec","xbox","command-line"]}},"publisherUrl":"https://www.microsoft.com/","releaseDate":"2025-07-10","releaseDateSource":"manifest","releaseNotesUrl":"https://github.com/microsoft/DirectXTex/releases/tag/jul2025","schemaVersion":1,"source":"winget","upstream":{"commit":"97d6aa2689f0a05f7847653a62b8624720d15b5d","manifestVersion":"1.10.0","manifests":[{"path":"manifests/m/Microsoft/DirectXTex/Texassemble/2025.7.10/Microsoft.DirectXTex.Texassemble.yaml","sha256":"90fa8fbaea2fc5c3fa2aff524690d5364f888fd76e124277b9819166b0a89fe6"},{"path":"manifests/m/Microsoft/DirectXTex/Texassemble/2025.7.10/Microsoft.DirectXTex.Texassemble.installer.yaml","sha256":"385e1f8e78941ec501e1e0fed145e5e44d2b0bfb23a25eefe70b9b6c5040295e"},{"path":"manifests/m/Microsoft/DirectXTex/Texassemble/2025.7.10/Microsoft.DirectXTex.Texassemble.locale.en-US.yaml","sha256":"1cb3c4120eefd9d973ebd1f10e046b64e7422a17f794e111c672f96bb1f616a1"}],"repository":"microsoft/winget-pkgs"},"version":"2025.7.10"}