{"defaultLocale":"en-US","id":"Microsoft.DirectXTex.Texconv","installers":[{"architecture":"arm64","commands":["texconv"],"dependencies":[{"PackageDependencies":[{"PackageIdentifier":"Microsoft.VCRedist.2015+.arm64"}]}],"fileExtensions":["bmp","dds","hdr","heif","jpg","jxr","pfm","phm","png","ppm","tga","wepb"],"id":"arm64-portable","priority":4,"sha256":"343cde2523805a7fe397acafdb7d7befc3493ac235d0864b4fc5fe394a8b210b","successCodes":[],"type":"portable","url":"https://github.com/microsoft/DirectXTex/releases/download/jul2025/texconv_arm64.exe"},{"architecture":"x64","commands":["texconv"],"dependencies":[{"PackageDependencies":[{"PackageIdentifier":"Microsoft.VCRedist.2015+.x64"}]}],"fileExtensions":["bmp","dds","hdr","heif","jpg","jxr","pfm","phm","png","ppm","tga","wepb"],"id":"x64-portable","priority":4,"sha256":"786c80f0ff579e053b3c8b73d17628aafb2fee2f1f713f858abedc1677ce60cf","successCodes":[],"type":"portable","url":"https://github.com/microsoft/DirectXTex/releases/download/jul2025/texconv.exe"}],"licenseUrl":"https://github.com/microsoft/DirectXTex/raw/refs/heads/main/LICENSE","packageLocalizations":{"en-US":{"description":"This DirectXTex sample is an implementation of the texconv command-line texture utility from the legacy DirectX SDK utilizing DirectXTex rather than D3DX.","license":"MIT","licenseUrl":"https://github.com/microsoft/DirectXTex/raw/refs/heads/main/LICENSE","locale":"en-US","longDescription":"Texconv is a command-line texture conversion tool developed by Microsoft as part of the DirectXTex library. It is designed for processing and converting texture files (e.g., DDS, PNG, TGA, BMP, etc.) with support for various formats, mipmaps, compression, and other texture operations.\n\nKey Features:\n- Format Conversion: Supports common formats like DDS, PNG, JPEG, TGA, BMP, HDR, and more.\n- Mipmap Generation: Automatically generates mipmaps for textures.\n- Compression: Supports BC (Block Compression) formats (BC1-BC7) for DDS files.\n- Cube Maps & Arrays: Handles texture arrays and cube maps.\n- Metadata & Alpha Handling: Preserves or modifies alpha channels and metadata.\n- HDR & WIC Support: Works with high dynamic range (HDR) images and Windows Imaging Component (WIC) codecs.","moniker":"Texconv","name":"DirectX Texture Converter","packageUrl":"https://github.com/Microsoft/DirectXTex/wiki/Texconv","publisher":"Microsoft Corporation","publisherUrl":"https://www.microsoft.com/","releaseNotesUrl":"https://github.com/microsoft/DirectXTex/releases/tag/jul2025","tags":["dds","direct3d","directx","directx-11","directx-12","directxtex","microsoft","textures","wic-codec","xbox","command-line"]}},"publisherUrl":"https://www.microsoft.com/","releaseDate":"2025-07-10","releaseDateSource":"manifest","releaseNotesUrl":"https://github.com/microsoft/DirectXTex/releases/tag/jul2025","schemaVersion":1,"source":"winget","upstream":{"commit":"97d6aa2689f0a05f7847653a62b8624720d15b5d","manifestVersion":"1.10.0","manifests":[{"path":"manifests/m/Microsoft/DirectXTex/Texconv/2025.7.10/Microsoft.DirectXTex.Texconv.yaml","sha256":"2d88ca01ec41650e48ef307c515cda6d2a057d64779b6892c36ed1530ba0fb1a"},{"path":"manifests/m/Microsoft/DirectXTex/Texconv/2025.7.10/Microsoft.DirectXTex.Texconv.installer.yaml","sha256":"34c97f41ef13b349ac731fa6fe520250f0d26baf58982f54a473565789b8b32d"},{"path":"manifests/m/Microsoft/DirectXTex/Texconv/2025.7.10/Microsoft.DirectXTex.Texconv.locale.en-US.yaml","sha256":"f438626d49bd335c9283e5396e9cbb3289352403082ad80120806677372df405"}],"repository":"microsoft/winget-pkgs"},"version":"2025.7.10"}