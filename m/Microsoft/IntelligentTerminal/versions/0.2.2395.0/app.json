load/v0.2.23/Microsoft.IntelligentTerminal_0.2.2395.0_8wekyb3d8bbwe.msixbundle"}],"licenseUrl":"https://github.com/microsoft/intelligent-terminal/blob/main/LICENSE","packageLocalizations":{"en-US":{"description":"Intelligent Terminal is an experimental terminal with native agent integration, forked from Windows Terminal.","license":"MIT","licenseUrl":"https://github.com/microsoft/intelligent-terminal/blob/main/LICENSE","locale":"en-US","longDescription":"Intelligent Terminal is an experimental terminal with native agent integration, forked from Windows Terminal. Key features include an agent in a dedicated pane that sees your shell context, catches errors as they happen, and helps you fix them without copy-pasting. Ask it to explain failures, generate commands, or work through multi-step tasks while your shell stays unblocked.\n\nThis is an open source project and we welcome community participation. To participate please visit https://aka.ms/intelligent-terminal","moniker":"intelligent-terminal","name":"Intelligent Terminal","packageUrl":"https://github.com/microsoft/intelligent-terminal","publisher":"Microsoft Corporation","publisherUrl":"https://www.microsoft.com","releaseNotesUrl":"https://github.com/microsoft/intelligent-terminal/releases/tag/v0.2.23","tags":["ai","agent","cli","cmd","command-line","command-prompt","console","copilot","developer-tools","powershell","ps","shell","terminal","utilities","wsl"]},"fr-FR":{"description":"Terminal intelligent est un terminal expérimental avec intégration native d'agents, dérivé de Terminal Windows.","locale":"fr-FR","publisher":"Microsoft","tags":[]},"it-IT":{"description":"Terminal Intelligente è un terminal sperimentale con integrazione nativa di agenti, derivato da Terminale Windows.","locale":"it-IT","publisher":"Microsoft","tags":[]},"ja-JP":{"description":"インテリジェント ターミナルは、Windows ターミナル からフォークされたネイティブ エージェント統合を備えた実験的なターミナルです。主な機能には、専用ペインで実行されるエージェントが含まれます。これは shell コンテキストを認識し、エラーをリアルタイムで捕捉し、コピー アンド ペーストなしで修正するのに役立ちます。エージェントに失敗を説明させたり、コマンドを生成させたり、複数ステップのタスクに取り組ませたりできます。その間、shell はブロックされません。","locale":"ja-JP","publisher":"Microsoft","tags":[]},"ko-KR":{"description":"지능형 터미널은 Windows 터미널에서 포크된 네이티브 에이전트 통합을 갖춘 실험 터미널입니다.","locale":"ko-KR","publisher":"Microsoft","tags":[]},"pt-BR":{"description":"Terminal Inteligente é um terminal experimental com integração nativa de agentes, derivado do Terminal do Windows.","locale":"pt-BR","publisher":"Microsoft","tags":[]},"ru-RU":{"description":"Интеллектуальный Терминал — это экспериментальный терминал с встроенной интеграцией агентов, разветвленный от Терминал Windows.","locale":"ru-RU","publisher":"Microsoft","tags":[]},"zh-CN":{"description":"智能终端是一个具有原生智能体集成的实验性终端，基于 Windows 终端 进行分支。主要功能包括在专用窗格中的智能体，可以看到您的 shell 上下文，实时捕获错误，并帮助您修复它们而无需复制粘贴。要求它解释失败、生成命令或处理多步任务，同时您的 shell 保持畅通。","locale":"zh-CN","publisher":"Microsoft","tags":[]},"zh-TW":{"description":"智慧終端機是一個具有原生智慧代理整合的實驗性終端機，由 Windows 終端機 分支而來。主要功能包括在專用窗格中的智慧代理，可以看到您的 shell 內容、實時捕捉錯誤，並幫助您修正它們而無需複製貼上。要求它解釋失敗、產生命令或處理多步驟工作，同時您的 shell 保持暢通。","locale":"zh-TW","publisher":"Microsoft","tags":[]}},"publisherUrl":"https://www.microsoft.com","releaseDate":"2026-08-28","releaseDateSource":"manifest","releaseNotesUrl":"https://github.com/microsoft/intelligent-terminal/releases/tag/v0.2.23","schemaVersion":1,"source":"winget","upstream":{"commit":"97d6aa2689f0a05f7847653a62b8624720d15b5d","manifestVersion":"1.12.0","manifests":[{"path":"manifests/m/Microsoft/IntelligentTerminal/0.2.2395.0/Microsoft.IntelligentTerminal.yaml","sha256":"03066e6b510827d453fd95d19d7aa4b36630c1345ccb9ee7e5caa674619c5ca8"},{"path":"manifests/m/Microsoft/IntelligentTerminal/0.2.2395.0/Microsoft.IntelligentTerminal.installer.yaml","sha256":"5c84539db8a1014c0427536c3019eac9ccdf71c928fd79b54e5385c146b9505b"},{"path":"manifests/m/Microsoft/IntelligentTerminal/0.2.2395.0/Microsoft.IntelligentTerminal.locale.en-US.yaml","sha256":"9a03659b57ef093c3c7116c2f56338b358b53449a11c50557f983b983f4d9cfc"},{"path":"manifests/m/Microsof