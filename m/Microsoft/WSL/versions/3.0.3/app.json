ft/WSL/pull/41765\n- Update Microsoft.WSL.Kernel to 6.18.54.1 by @chessturo in https://github.com/microsoft/WSL/pull/41822\n- Add logic to reject commands with extra arguments by @OneBlue in https://github.com/microsoft/WSL/pull/41821\n- Improve wslc event filters by @beena352 in https://github.com/microsoft/WSL/pull/41809\n- Make the binfmt mount writable by @OneBlue in https://github.com/microsoft/WSL/pull/41808\n- Match container and network filters across event types by @beena352 in https://github.com/microsoft/WSL/pull/41818\n- Fix incorrect wsl.conf warnings being displayed when creating a new distribution by @OneBlue in https://github.com/microsoft/WSL/pull/41820\n- Convert EnsureCaseSensitiveDirectoryRecursive to iterative traversal by @benhillis in https://github.com/microsoft/WSL/pull/40347\nFull Changelog: https://github.com/microsoft/WSL/compare/3.0.2...3.0.3","releaseNotesUrl":"https://github.com/microsoft/WSL/releases/tag/3.0.3","tags":["9p9tqf7mrm4r","linux","linux-subsystem","windows-subsystem-for-linux","windowssubsystemforlinux","wsl"]},"es-ES":{"locale":"es-ES","name":"Subsistema de Windows para Linux","releaseNotesUrl":"https://github.com/microsoft/WSL/releases/tag/3.0.3","tags":["9p9tqf7mrm4r","subsistema-de-windows-para-linux","subsistemadewindowsparalinux","windows-subsystem-for-linux","wsl"]},"fi-FI":{"locale":"fi-FI","name":"Windows-alijärjestelmä Linuxille","releaseNotesUrl":"https://github.com/microsoft/WSL/releases/tag/3.0.3","tags":["9p9tqf7mrm4r","windows-alijärjestelmä-linuxille","windows-subsystem-for-linux","windowsalijärjestelmälinuxille","wsl"]},"fr-FR":{"locale":"fr-FR","name":"Sous-système Windows pour Linux","releaseNotesUrl":"https://github.com/microsoft/WSL/releases/tag/3.0.3","tags":["9p9tqf7mrm4r","sous-systeme-windows-pour-linux","sous-système-windows-pour-linux","soussystemewindowspourlinux","soussystèmewindowspourlinux","windows-subsystem-for-linux","wsl"]},"hu-HU":{"locale":"hu-HU","name":"Linuxos Windows-alrendszer","re