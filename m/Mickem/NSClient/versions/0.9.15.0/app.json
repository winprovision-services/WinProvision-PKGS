{"defaultLocale":"en-US","id":"Mickem.NSClient","installers":[{"appsAndFeaturesEntries":[{"UpgradeCode":"{0B36E3B7-0042-452D-B376-57E0C07ADDBB}"}],"architecture":"x64","dependencies":[{"PackageDependencies":[{"PackageIdentifier":"Microsoft.VCRedist.2015+.x64"}]}],"id":"x64-wix","installerSwitches":{"InstallLocation":"INSTALLLOCATION=\"<INSTALLPATH>\""},"priority":2,"sha256":"f26473e6a52afb7a8b5fa1ea099b2eb39eb57e57ca7d3547c0bf29334638cbe1","silent":{"arguments":"/quiet /norestart","source":"default"},"successCodes":[],"type":"wix","uninstall":{"type":"productCode","value":"{125A3BB1-6446-4E76-A790-D53D4D84DA6A}"},"url":"https://github.com/mickem/nscp/releases/download/0.9.15/NSCP-0.9.15-x64.msi"},{"appsAndFeaturesEntries":[{"UpgradeCode":"{0B36E3B7-0042-452D-B376-57E0C07ADDBB}"}],"architecture":"x86","dependencies":[{"PackageDependencies":[{"PackageIdentifier":"Microsoft.VCRedist.2015+.x86"}]}],"id":"x86-wix","installerSwitches":{"InstallLocation":"INSTALLLOCATION=\"<INSTALLPATH>\""},"priority":2,"sha256":"391fe5b1f4c8f42450915b9452e73f0318b8dcb54a8b038081914c8ad79ef445","silent":{"arguments":"/quiet /norestart","source":"default"},"successCodes":[],"type":"wix","uninstall":{"type":"productCode","value":"{81188C90-8CDB-4FA7-B9F8-4E2CA1CD47BA}"},"url":"https://github.com/mickem/nscp/releases/download/0.9.15/NSCP-0.9.15-Win32.msi"}],"licenseUrl":"https://github.com/mickem/nscp/blob/HEAD/COPYING","packageLocalizations":{"en-US":{"description":"A fully fledged monitoring agent which can be used with many monitoring tools.","license":"GPL-2.0","licenseUrl":"https://github.com/mickem/nscp/blob/HEAD/COPYING","locale":"en-US","longDescription":"NSClient++ (nscp) aims to be a simple yet powerful and secure monitoring daemon. It was built for Nagios/Icinga, but nothing in the daemon is Nagios/Icinga specific and it can be used in many other scenarios where you want to receive/distribute check metrics.\nThe daemon has 3 main functions:\n- Allow a remote machine (monitoring server) to request commands to be run on this machine (the monitored machine) which return the status of the machine.\n- Submit the same results to a remote (monitoring server).\n- Take action and perform tasks.","moniker":"nscp","name":"NSClient++","packageUrl":"https://nsclient.org/","publisher":"MySolutions NORDIC","publisherUrl":"https://medin.name/","releaseNotesUrl":"https://github.com/mickem/nscp/releases/tag/0.9.15","tags":["icinga","naemon","nagios"]},"zh-CN":{"description":"可与多种监控工具协同使用的全功能监控代理","locale":"zh-CN","longDescription":"NSClient++（nscp）旨在成为一个简单而强大且安全的监控守护进程。它最初为 Nagios/Icinga 设计，但守护进程本身并不局限于 Nagios/Icinga，可广泛应用于需要接收或分发检查指标的其他场景中。\n该守护进程主要具备三项核心功能：\n- 允许远程主机（监控服务器）请求在本机（被监控主机）上执行命令，以获取主机状态信息。\n- 将相同的检测结果主动提交至远程（监控服务器）。\n- 执行预设操作并完成任务处理。","releaseNotesUrl":"https://github.com/mickem/nscp/releases/tag/0.9.15","tags":[]}},"publisherUrl":"https://medin.name/","releaseDate":"2025-08-17","releaseDateSource":"manifest","releaseNotesUrl":"https://github.com/mickem/nscp/releases/tag/0.9.15","schemaVersion":1,"source":"winget","upstream":{"commit":"97d6aa2689f0a05f7847653a62b8624720d15b5d","manifestVersion":"1.10.0","manifests":[{"path":"manifests/m/Mickem/NSClient/0.9.15.0/Mickem.NSClient.yaml","sha256":"2c332e24e0497ebf8ef451481c8389acef766c608ddcfdfe7e5f665eb6cd94ab"},{"path":"manifests/m/Mickem/NSClient/0.9.15.0/Mickem.NSClient.installer.yaml","sha256":"ae76ce5498581aa81311735e0e8c0f3246e2ffb049d6cb05b074cb19ca780e50"},{"path":"manifests/m/Mickem/NSClient/0.9.15.0/Mickem.NSClient.locale.en-US.yaml","sha256":"7a8502b65b9339e7271e17af19f06b87c78e9a6e5d449ed1644a4d146f3899bc"},{"path":"manifests/m/Mickem/NSClient/0.9.15.0/Mickem.NSClient.locale.zh-CN.yaml","sha256":"dd480075c6f395365a8297c34dad7840ea9614a7cb6b9ddd621b3b836d08b816"}],"repository":"microsoft/winget-pkgs"},"version":"0.9.15.0"}