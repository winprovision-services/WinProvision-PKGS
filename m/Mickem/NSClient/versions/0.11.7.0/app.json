{"defaultLocale":"en-US","id":"Mickem.NSClient","installers":[{"appsAndFeaturesEntries":[{"UpgradeCode":"{0B36E3B7-0042-452D-B376-57E0C07ADDBB}"}],"architecture":"x64","dependencies":[{"PackageDependencies":[{"PackageIdentifier":"Microsoft.VCRedist.2015+.x64"}]}],"id":"x64-wix","installerSwitches":{"InstallLocation":"INSTALLLOCATION=\"<INSTALLPATH>\""},"priority":2,"sha256":"55246fc63b132b67bbeb4027ec24087f3f385c81f69f7188c509c327d488cb8f","silent":{"arguments":"/quiet /norestart","source":"default"},"successCodes":[],"type":"wix","uninstall":{"type":"productCode","value":"{781C750A-6B54-4109-AB3F-8309C2F8F84F}"},"url":"https://github.com/mickem/nscp/releases/download/0.11.7/NSCP-0.11.7-x64.msi"},{"appsAndFeaturesEntries":[{"UpgradeCode":"{0B36E3B7-0042-452D-B376-57E0C07ADDBB}"}],"architecture":"x86","dependencies":[{"PackageDependencies":[{"PackageIdentifier":"Microsoft.VCRedist.2015+.x86"}]}],"id":"x86-wix","installerSwitches":{"InstallLocation":"INSTALLLOCATION=\"<INSTALLPATH>\""},"priority":2,"sha256":"f166f31a2ce129d7d8b8510afd6d2d4757f996bd8a5706af5189f74ada2be8db","silent":{"arguments":"/quiet /norestart","source":"default"},"successCodes":[],"type":"wix","uninstall":{"type":"productCode","value":"{A0214B3B-7622-4D85-B408-36B674A4AF7F}"},"url":"https://github.com/mickem/nscp/releases/download/0.11.7/NSCP-0.11.7-Win32-legacy-xp.msi"}],"licenseUrl":"https://github.com/mickem/nscp/blob/HEAD/COPYING","packageLocalizations":{"en-US":{"description":"A fully fledged monitoring agent which can be used with many monitoring tools.","license":"GPL-2.0","licenseUrl":"https://github.com/mickem/nscp/blob/HEAD/COPYING","locale":"en-US","longDescription":"NSClient++ (nscp) aims to be a simple yet powerful and secure monitoring daemon. It was built for Nagios/Icinga, but nothing in the daemon is Nagios/Icinga specific and it can be used in many other scenarios where you want to receive/distribute check metrics.\nThe daemon has 3 main functions:\n- Allow a remote machine (monitoring server) to request commands to be run on this machine (the monitored machine) which return the status of the machine.\n- Submit the same results to a remote (monitoring server).\n- Take action and perform tasks.","moniker":"nscp","name":"NSClient++","packageUrl":"https://nsclient.org/","publisher":"MySolutions NORDIC","publisherUrl":"https://medin.name/","releaseNotesUrl":"https://github.com/mickem/nscp/releases/tag/0.11.7","tags":["icinga","naemon","nagios"]},"zh-CN":{"description":"可与多种监控工具协同使用的全功能监控代理","locale":"zh-CN","longDescription":"NSClient++（nscp）旨在成为一个简单而强大且安全的监控守护进程。它最初为 Nagios/Icinga 设计，但守护进程本身并不局限于 Nagios/Icinga，可广泛应用于需要接收或分发检查指标的其他场景中。\n该守护进程主要具备三项核心功能：\n- 允许远程主机（监控服务器）请求在本机（被监控主机）上执行命令，以获取主机状态信息。\n- 将相同的检测结果主动提交至远程（监控服务器）。\n- 执行预设操作并完成任务处理。","releaseNotesUrl":"https://github.com/mickem/nscp/releases/tag/0.11.7","tags":[]}},"publisherUrl":"https://medin.name/","releaseDate":"2026-01-13","releaseDateSource":"manifest","releaseNotesUrl":"https://github.com/mickem/nscp/releases/tag/0.11.7","schemaVersion":1,"source":"winget","upstream":{"commit":"97d6aa2689f0a05f7847653a62b8624720d15b5d","manifestVersion":"1.12.0","manifests":[{"path":"manifests/m/Mickem/NSClient/0.11.7.0/Mickem.NSClient.yaml","sha256":"43f0508a84fbdba2fb3d0375a88859314406c2e5dc58f9c1ea06c1e3924d393f"},{"path":"manifests/m/Mickem/NSClient/0.11.7.0/Mickem.NSClient.installer.yaml","sha256":"488ff053f096d7478b4e0f4b6e0e2896a1c094ca28cfb3774aa9fad3cf4712e2"},{"path":"manifests/m/Mickem/NSClient/0.11.7.0/Mickem.NSClient.locale.en-US.yaml","sha256":"81535e4118cb0881712f59fe4e121b8fe199fd31d69f3de12277b9dcac5f5c71"},{"path":"manifests/m/Mickem/NSClient/0.11.7.0/Mickem.NSClient.locale.zh-CN.yaml","sha256":"0f51ee77e2998f1ff9c44eb772d68a24460409f8f2fb1d58a186e2f3428d211b"}],"repository":"microsoft/winget-pkgs"},"version":"0.11.7.0"}