{"defaultLocale":"en-US","id":"Mickem.NSClient","installers":[{"appsAndFeaturesEntries":[{"UpgradeCode":"{0B36E3B7-0042-452D-B376-57E0C07ADDBB}"}],"architecture":"x64","dependencies":[{"PackageDependencies":[{"PackageIdentifier":"Microsoft.VCRedist.2015+.x64"}]}],"id":"x64-wix","installerSwitches":{"InstallLocation":"INSTALLLOCATION=\"<INSTALLPATH>\""},"priority":2,"sha256":"c9074f3473f2da8b6a73f2c2b99f4ef8d8e8fb8641091ccab3867ddc1a7073ce","silent":{"arguments":"/quiet /norestart","source":"default"},"successCodes":[],"type":"wix","uninstall":{"type":"productCode","value":"{98750E9C-620E-4570-A527-15E3F994E1C1}"},"url":"https://github.com/mickem/nscp/releases/download/0.9.12/NSCP-0.9.12-x64.msi"},{"appsAndFeaturesEntries":[{"UpgradeCode":"{0B36E3B7-0042-452D-B376-57E0C07ADDBB}"}],"architecture":"x86","dependencies":[{"PackageDependencies":[{"PackageIdentifier":"Microsoft.VCRedist.2015+.x86"}]}],"id":"x86-wix","installerSwitches":{"InstallLocation":"INSTALLLOCATION=\"<INSTALLPATH>\""},"priority":2,"sha256":"a284cea543a26ab6fe2a04f851b343b18feccbd36f0591ca89d1eb90801a9e85","silent":{"arguments":"/quiet /norestart","source":"default"},"successCodes":[],"type":"wix","uninstall":{"type":"productCode","value":"{41F7703A-24F6-481D-8705-9E091D68ABDD}"},"url":"https://github.com/mickem/nscp/releases/download/0.9.12/NSCP-0.9.12-Win32.msi"}],"licenseUrl":"https://github.com/mickem/nscp/blob/HEAD/COPYING","packageLocalizations":{"en-US":{"description":"A fully fledged monitoring agent which can be used with many monitoring tools.","license":"GPL-2.0","licenseUrl":"https://github.com/mickem/nscp/blob/HEAD/COPYING","locale":"en-US","longDescription":"NSClient++ (nscp) aims to be a simple yet powerful and secure monitoring daemon. It was built for Nagios/Icinga, but nothing in the daemon is Nagios/Icinga specific and it can be used in many other scenarios where you want to receive/distribute check metrics.\nThe daemon has 3 main functions:\n- Allow a remote machine (monitoring server) to request commands to be run on this machine (the monitored machine) which return the status of the machine.\n- Submit the same results to a remote (monitoring server).\n- Take action and perform tasks.","moniker":"nscp","name":"NSClient++","packageUrl":"https://nsclient.org/","publisher":"MySolutions NORDIC","publisherUrl":"https://medin.name/","releaseNotesUrl":"https://github.com/mickem/nscp/releases/tag/0.9.12","tags":["icinga","naemon","nagios"]},"zh-CN":{"description":"可与多种监控工具协同使用的全功能监控代理","locale":"zh-CN","longDescription":"NSClient++（nscp）旨在成为一个简单而强大且安全的监控守护进程。它最初为 Nagios/Icinga 设计，但守护进程本身并不局限于 Nagios/Icinga，可广泛应用于需要接收或分发检查指标的其他场景中。\n该守护进程主要具备三项核心功能：\n- 允许远程主机（监控服务器）请求在本机（被监控主机）上执行命令，以获取主机状态信息。\n- 将相同的检测结果主动提交至远程（监控服务器）。\n- 执行预设操作并完成任务处理。","releaseNotesUrl":"https://github.com/mickem/nscp/releases/tag/0.9.12","tags":[]}},"publisherUrl":"https://medin.name/","releaseDate":"2025-07-28","releaseDateSource":"manifest","releaseNotesUrl":"https://github.com/mickem/nscp/releases/tag/0.9.12","schemaVersion":1,"source":"winget","upstream":{"commit":"97d6aa2689f0a05f7847653a62b8624720d15b5d","manifestVersion":"1.10.0","manifests":[{"path":"manifests/m/Mickem/NSClient/0.9.12.0/Mickem.NSClient.yaml","sha256":"df6f86f2a1ce41eee160647f2f2072fac82a8cf39516b033b5527313e11edfbf"},{"path":"manifests/m/Mickem/NSClient/0.9.12.0/Mickem.NSClient.installer.yaml","sha256":"1634656be883a24bad775b28c1bc5a8b60bd206a60166694eda19002f0763141"},{"path":"manifests/m/Mickem/NSClient/0.9.12.0/Mickem.NSClient.locale.en-US.yaml","sha256":"4f2d06b993a8ee89289198f704ecc0fdb74a3c4f26ea34372b7ba708450734ed"},{"path":"manifests/m/Mickem/NSClient/0.9.12.0/Mickem.NSClient.locale.zh-CN.yaml","sha256":"a311b0314836ae8d28914fb614df082bd40c2d823e4f1372d58873dfe7704567"}],"repository":"microsoft/winget-pkgs"},"version":"0.9.12.0"}