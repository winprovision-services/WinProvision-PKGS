{"defaultLocale":"en-US","id":"Mickem.NSClient","installers":[{"appsAndFeaturesEntries":[{"UpgradeCode":"{0B36E3B7-0042-452D-B376-57E0C07ADDBB}"}],"architecture":"x64","dependencies":[{"PackageDependencies":[{"PackageIdentifier":"Microsoft.VCRedist.2015+.x64"}]}],"id":"x64-wix","installerSwitches":{"InstallLocation":"INSTALLLOCATION=\"<INSTALLPATH>\""},"priority":2,"sha256":"2cf1fc203925e3231806af237e046dcee835fc8588749cb97493ff7602e7ab02","silent":{"arguments":"/quiet /norestart","source":"default"},"successCodes":[],"type":"wix","uninstall":{"type":"productCode","value":"{E991FC6C-9106-474A-A294-4A5CFD5D2D70}"},"url":"https://github.com/mickem/nscp/releases/download/0.9.14/NSCP-0.9.14-x64.msi"},{"appsAndFeaturesEntries":[{"UpgradeCode":"{0B36E3B7-0042-452D-B376-57E0C07ADDBB}"}],"architecture":"x86","dependencies":[{"PackageDependencies":[{"PackageIdentifier":"Microsoft.VCRedist.2015+.x86"}]}],"id":"x86-wix","installerSwitches":{"InstallLocation":"INSTALLLOCATION=\"<INSTALLPATH>\""},"priority":2,"sha256":"a5d554231523e870f682fc9be2f3b7accd807d15faa6b56e60962f79885927dc","silent":{"arguments":"/quiet /norestart","source":"default"},"successCodes":[],"type":"wix","uninstall":{"type":"productCode","value":"{4FE18DBB-1A38-433E-8986-26A5926F12AD}"},"url":"https://github.com/mickem/nscp/releases/download/0.9.14/NSCP-0.9.14-Win32.msi"}],"licenseUrl":"https://github.com/mickem/nscp/blob/HEAD/COPYING","packageLocalizations":{"en-US":{"description":"A fully fledged monitoring agent which can be used with many monitoring tools.","license":"GPL-2.0","licenseUrl":"https://github.com/mickem/nscp/blob/HEAD/COPYING","locale":"en-US","longDescription":"NSClient++ (nscp) aims to be a simple yet powerful and secure monitoring daemon. It was built for Nagios/Icinga, but nothing in the daemon is Nagios/Icinga specific and it can be used in many other scenarios where you want to receive/distribute check metrics.\nThe daemon has 3 main functions:\n- Allow a remote machine (monitoring server) to request commands to be run on this machine (the monitored machine) which return the status of the machine.\n- Submit the same results to a remote (monitoring server).\n- Take action and perform tasks.","moniker":"nscp","name":"NSClient++","packageUrl":"https://nsclient.org/","publisher":"MySolutions NORDIC","publisherUrl":"https://medin.name/","releaseNotesUrl":"https://github.com/mickem/nscp/releases/tag/0.9.14","tags":["icinga","naemon","nagios"]},"zh-CN":{"description":"可与多种监控工具协同使用的全功能监控代理","locale":"zh-CN","longDescription":"NSClient++（nscp）旨在成为一个简单而强大且安全的监控守护进程。它最初为 Nagios/Icinga 设计，但守护进程本身并不局限于 Nagios/Icinga，可广泛应用于需要接收或分发检查指标的其他场景中。\n该守护进程主要具备三项核心功能：\n- 允许远程主机（监控服务器）请求在本机（被监控主机）上执行命令，以获取主机状态信息。\n- 将相同的检测结果主动提交至远程（监控服务器）。\n- 执行预设操作并完成任务处理。","releaseNotesUrl":"https://github.com/mickem/nscp/releases/tag/0.9.14","tags":[]}},"publisherUrl":"https://medin.name/","releaseDate":"2025-08-13","releaseDateSource":"manifest","releaseNotesUrl":"https://github.com/mickem/nscp/releases/tag/0.9.14","schemaVersion":1,"source":"winget","upstream":{"commit":"97d6aa2689f0a05f7847653a62b8624720d15b5d","manifestVersion":"1.10.0","manifests":[{"path":"manifests/m/Mickem/NSClient/0.9.14.0/Mickem.NSClient.yaml","sha256":"31edabaca8d1653e98e638775053d34c477a5262d81fccf26cd39aa80c99b8b5"},{"path":"manifests/m/Mickem/NSClient/0.9.14.0/Mickem.NSClient.installer.yaml","sha256":"f78eb2ae2a46f73be491693a62f07350f669974129bc6f72221df2f046d62b4d"},{"path":"manifests/m/Mickem/NSClient/0.9.14.0/Mickem.NSClient.locale.en-US.yaml","sha256":"0923fd8e2d3e58d41cebbddd08f4cad4bcc5101a316402d7572f4df425458207"},{"path":"manifests/m/Mickem/NSClient/0.9.14.0/Mickem.NSClient.locale.zh-CN.yaml","sha256":"0ef17a235f98ba2c1f78e3bcff22a3b161165303b9d92dc90c95a61c88835009"}],"repository":"microsoft/winget-pkgs"},"version":"0.9.14.0"}