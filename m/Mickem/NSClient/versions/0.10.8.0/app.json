{"defaultLocale":"en-US","id":"Mickem.NSClient","installers":[{"appsAndFeaturesEntries":[{"UpgradeCode":"{0B36E3B7-0042-452D-B376-57E0C07ADDBB}"}],"architecture":"x64","dependencies":[{"PackageDependencies":[{"PackageIdentifier":"Microsoft.VCRedist.2015+.x64"}]}],"id":"x64-wix","installerSwitches":{"InstallLocation":"INSTALLLOCATION=\"<INSTALLPATH>\""},"priority":2,"sha256":"d98a46e06078c3542018fabea877e3de28dfa8818a00e482552809f18e3231fa","silent":{"arguments":"/quiet /norestart","source":"default"},"successCodes":[],"type":"wix","uninstall":{"type":"productCode","value":"{9E105A89-D013-481F-83E4-3011DA2949D7}"},"url":"https://github.com/mickem/nscp/releases/download/0.10.8/NSCP-0.10.8-x64.msi"},{"appsAndFeaturesEntries":[{"UpgradeCode":"{0B36E3B7-0042-452D-B376-57E0C07ADDBB}"}],"architecture":"x86","dependencies":[{"PackageDependencies":[{"PackageIdentifier":"Microsoft.VCRedist.2015+.x86"}]}],"id":"x86-wix","installerSwitches":{"InstallLocation":"INSTALLLOCATION=\"<INSTALLPATH>\""},"priority":2,"sha256":"fdfa57c7026c3ed5da574dff2e5ccc5862b8be4001e203e27eb372db26539118","silent":{"arguments":"/quiet /norestart","source":"default"},"successCodes":[],"type":"wix","uninstall":{"type":"productCode","value":"{8D8E524C-5637-44CB-BEA7-F21EB8136700}"},"url":"https://github.com/mickem/nscp/releases/download/0.10.8/NSCP-0.10.8-Win32-legacy-xp.msi"}],"licenseUrl":"https://github.com/mickem/nscp/blob/HEAD/COPYING","packageLocalizations":{"en-US":{"description":"A fully fledged monitoring agent which can be used with many monitoring tools.","license":"GPL-2.0","licenseUrl":"https://github.com/mickem/nscp/blob/HEAD/COPYING","locale":"en-US","longDescription":"NSClient++ (nscp) aims to be a simple yet powerful and secure monitoring daemon. It was built for Nagios/Icinga, but nothing in the daemon is Nagios/Icinga specific and it can be used in many other scenarios where you want to receive/distribute check metrics.\nThe daemon has 3 main functions:\n- Allow a remote machine (monitoring server) to request commands to be run on this machine (the monitored machine) which return the status of the machine.\n- Submit the same results to a remote (monitoring server).\n- Take action and perform tasks.","moniker":"nscp","name":"NSClient++","packageUrl":"https://nsclient.org/","publisher":"MySolutions NORDIC","publisherUrl":"https://medin.name/","releaseNotesUrl":"https://github.com/mickem/nscp/releases/tag/0.10.8","tags":["icinga","naemon","nagios"]},"zh-CN":{"description":"可与多种监控工具协同使用的全功能监控代理","locale":"zh-CN","longDescription":"NSClient++（nscp）旨在成为一个简单而强大且安全的监控守护进程。它最初为 Nagios/Icinga 设计，但守护进程本身并不局限于 Nagios/Icinga，可广泛应用于需要接收或分发检查指标的其他场景中。\n该守护进程主要具备三项核心功能：\n- 允许远程主机（监控服务器）请求在本机（被监控主机）上执行命令，以获取主机状态信息。\n- 将相同的检测结果主动提交至远程（监控服务器）。\n- 执行预设操作并完成任务处理。","releaseNotesUrl":"https://github.com/mickem/nscp/releases/tag/0.10.8","tags":[]}},"publisherUrl":"https://medin.name/","releaseDate":"2025-11-23","releaseDateSource":"manifest","releaseNotesUrl":"https://github.com/mickem/nscp/releases/tag/0.10.8","schemaVersion":1,"source":"winget","upstream":{"commit":"97d6aa2689f0a05f7847653a62b8624720d15b5d","manifestVersion":"1.10.0","manifests":[{"path":"manifests/m/Mickem/NSClient/0.10.8.0/Mickem.NSClient.yaml","sha256":"bd14bfed18a93472856c6006e94893027c85f6e036d48226fd540ec0dde8a238"},{"path":"manifests/m/Mickem/NSClient/0.10.8.0/Mickem.NSClient.installer.yaml","sha256":"d4a1814ca7bac7aa7035f319ddd815de9b0f0979145c4f79ac8bc3211d047316"},{"path":"manifests/m/Mickem/NSClient/0.10.8.0/Mickem.NSClient.locale.en-US.yaml","sha256":"cbe10e16de07a84cf1ee7496e005b6c5f59c30e2e3d068206088748c3e0c4000"},{"path":"manifests/m/Mickem/NSClient/0.10.8.0/Mickem.NSClient.locale.zh-CN.yaml","sha256":"17a4eb4fae3fda1a89f0c9d32d1efdbc553ce3309dcb9eec692c7aa1f8907264"}],"repository":"microsoft/winget-pkgs"},"version":"0.10.8.0"}