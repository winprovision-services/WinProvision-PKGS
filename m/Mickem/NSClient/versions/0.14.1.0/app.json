{"defaultLocale":"en-US","id":"Mickem.NSClient","installers":[{"appsAndFeaturesEntries":[{"UpgradeCode":"{0B36E3B7-0042-452D-B376-57E0C07ADDBB}"}],"architecture":"x64","dependencies":[{"PackageDependencies":[{"PackageIdentifier":"Microsoft.VCRedist.2015+.x64"}]}],"id":"x64-wix","installerSwitches":{"InstallLocation":"INSTALLLOCATION=\"<INSTALLPATH>\""},"priority":2,"sha256":"3ba1caa877b67ecb54d3da72e9968bd20b51001c362974a30524d7e88b5110a6","silent":{"arguments":"/quiet /norestart","source":"default"},"successCodes":[],"type":"wix","uninstall":{"type":"productCode","value":"{73F6EDA0-4056-412E-8A9C-922697B711D2}"},"url":"https://github.com/mickem/nscp/releases/download/0.14.1/NSCP-0.14.1-x64.msi"},{"appsAndFeaturesEntries":[{"UpgradeCode":"{0B36E3B7-0042-452D-B376-57E0C07ADDBB}"}],"architecture":"x86","dependencies":[{"PackageDependencies":[{"PackageIdentifier":"Microsoft.VCRedist.2015+.x86"}]}],"id":"x86-wix","installerSwitches":{"InstallLocation":"INSTALLLOCATION=\"<INSTALLPATH>\""},"priority":2,"sha256":"ee3dfdde334d6420a7e3ade471e64190749837a6077a2bb27ac7910b6328dc9d","silent":{"arguments":"/quiet /norestart","source":"default"},"successCodes":[],"type":"wix","uninstall":{"type":"productCode","value":"{87AF8842-2B5C-4D78-802F-14D7A5DDF744}"},"url":"https://github.com/mickem/nscp/releases/download/0.14.1/NSCP-0.14.1-Win32-legacy-xp.msi"}],"licenseUrl":"https://github.com/mickem/nscp/blob/HEAD/COPYING","packageLocalizations":{"en-US":{"description":"A fully fledged monitoring agent which can be used with many monitoring tools.","license":"GPL-2.0","licenseUrl":"https://github.com/mickem/nscp/blob/HEAD/COPYING","locale":"en-US","longDescription":"NSClient++ (nscp) aims to be a simple yet powerful and secure monitoring daemon. It was built for Nagios/Icinga, but nothing in the daemon is Nagios/Icinga specific and it can be used in many other scenarios where you want to receive/distribute check metrics.\nThe daemon has 3 main functions:\n- Allow a remote machine (monitoring server) to request commands to be run on this machine (the monitored machine) which return the status of the machine.\n- Submit the same results to a remote (monitoring server).\n- Take action and perform tasks.","moniker":"nscp","name":"NSClient++","packageUrl":"https://nsclient.org/","publisher":"MySolutions NORDIC","publisherUrl":"https://medin.name/","releaseNotesUrl":"https://github.com/mickem/nscp/releases/tag/0.14.1","tags":["icinga","naemon","nagios"]},"zh-CN":{"description":"可与多种监控工具协同使用的全功能监控代理","locale":"zh-CN","longDescription":"NSClient++（nscp）旨在成为一个简单而强大且安全的监控守护进程。它最初为 Nagios/Icinga 设计，但守护进程本身并不局限于 Nagios/Icinga，可广泛应用于需要接收或分发检查指标的其他场景中。\n该守护进程主要具备三项核心功能：\n- 允许远程主机（监控服务器）请求在本机（被监控主机）上执行命令，以获取主机状态信息。\n- 将相同的检测结果主动提交至远程（监控服务器）。\n- 执行预设操作并完成任务处理。","releaseNotesUrl":"https://github.com/mickem/nscp/releases/tag/0.14.1","tags":[]}},"publisherUrl":"https://medin.name/","releaseDate":"2026-07-06","releaseDateSource":"manifest","releaseNotesUrl":"https://github.com/mickem/nscp/releases/tag/0.14.1","schemaVersion":1,"source":"winget","upstream":{"commit":"97d6aa2689f0a05f7847653a62b8624720d15b5d","manifestVersion":"1.12.0","manifests":[{"path":"manifests/m/Mickem/NSClient/0.14.1.0/Mickem.NSClient.yaml","sha256":"b3d091e8726849e023c47ae6da7f171a98ec809a12501363eb20b159d6031e1b"},{"path":"manifests/m/Mickem/NSClient/0.14.1.0/Mickem.NSClient.installer.yaml","sha256":"c77ddbb9bce6f2604cf71f4db697578c3c3d670b5f249dea1afa3f9274b867f4"},{"path":"manifests/m/Mickem/NSClient/0.14.1.0/Mickem.NSClient.locale.en-US.yaml","sha256":"aa93feb513b31291ed58afbd1e22e5e53702bedebce0c516db994aeb9df3d153"},{"path":"manifests/m/Mickem/NSClient/0.14.1.0/Mickem.NSClient.locale.zh-CN.yaml","sha256":"620f50a506e140643b94cc1c1cf0e7401eb25a00a4f072c91077c65fe23985af"}],"repository":"microsoft/winget-pkgs"},"version":"0.14.1.0"}