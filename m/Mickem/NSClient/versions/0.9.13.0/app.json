{"defaultLocale":"en-US","id":"Mickem.NSClient","installers":[{"appsAndFeaturesEntries":[{"UpgradeCode":"{0B36E3B7-0042-452D-B376-57E0C07ADDBB}"}],"architecture":"x64","dependencies":[{"PackageDependencies":[{"PackageIdentifier":"Microsoft.VCRedist.2015+.x64"}]}],"id":"x64-wix","installerSwitches":{"InstallLocation":"INSTALLLOCATION=\"<INSTALLPATH>\""},"priority":2,"sha256":"1192a8dbf26434ce8b334aba228e12a641836974176d1c69f3011eaa70a0f569","silent":{"arguments":"/quiet /norestart","source":"default"},"successCodes":[],"type":"wix","uninstall":{"type":"productCode","value":"{426B813E-E88F-4E52-ABCB-E16B303265DD}"},"url":"https://github.com/mickem/nscp/releases/download/0.9.13/NSCP-0.9.13-x64.msi"},{"appsAndFeaturesEntries":[{"UpgradeCode":"{0B36E3B7-0042-452D-B376-57E0C07ADDBB}"}],"architecture":"x86","dependencies":[{"PackageDependencies":[{"PackageIdentifier":"Microsoft.VCRedist.2015+.x86"}]}],"id":"x86-wix","installerSwitches":{"InstallLocation":"INSTALLLOCATION=\"<INSTALLPATH>\""},"priority":2,"sha256":"69f46bbf884f3def34501090299838132d97d6ec55c4770b87b21a6f012b36d6","silent":{"arguments":"/quiet /norestart","source":"default"},"successCodes":[],"type":"wix","uninstall":{"type":"productCode","value":"{4BA752DD-D2B6-489E-9D9C-5294EE7B6864}"},"url":"https://github.com/mickem/nscp/releases/download/0.9.13/NSCP-0.9.13-Win32.msi"}],"licenseUrl":"https://github.com/mickem/nscp/blob/HEAD/COPYING","packageLocalizations":{"en-US":{"description":"A fully fledged monitoring agent which can be used with many monitoring tools.","license":"GPL-2.0","licenseUrl":"https://github.com/mickem/nscp/blob/HEAD/COPYING","locale":"en-US","longDescription":"NSClient++ (nscp) aims to be a simple yet powerful and secure monitoring daemon. It was built for Nagios/Icinga, but nothing in the daemon is Nagios/Icinga specific and it can be used in many other scenarios where you want to receive/distribute check metrics.\nThe daemon has 3 main functions:\n- Allow a remote machine (monitoring server) to request commands to be run on this machine (the monitored machine) which return the status of the machine.\n- Submit the same results to a remote (monitoring server).\n- Take action and perform tasks.","moniker":"nscp","name":"NSClient++","packageUrl":"https://nsclient.org/","publisher":"MySolutions NORDIC","publisherUrl":"https://medin.name/","releaseNotesUrl":"https://github.com/mickem/nscp/releases/tag/0.9.13","tags":["icinga","naemon","nagios"]},"zh-CN":{"description":"可与多种监控工具协同使用的全功能监控代理","locale":"zh-CN","longDescription":"NSClient++（nscp）旨在成为一个简单而强大且安全的监控守护进程。它最初为 Nagios/Icinga 设计，但守护进程本身并不局限于 Nagios/Icinga，可广泛应用于需要接收或分发检查指标的其他场景中。\n该守护进程主要具备三项核心功能：\n- 允许远程主机（监控服务器）请求在本机（被监控主机）上执行命令，以获取主机状态信息。\n- 将相同的检测结果主动提交至远程（监控服务器）。\n- 执行预设操作并完成任务处理。","releaseNotesUrl":"https://github.com/mickem/nscp/releases/tag/0.9.13","tags":[]}},"publisherUrl":"https://medin.name/","releaseDate":"2025-08-11","releaseDateSource":"manifest","releaseNotesUrl":"https://github.com/mickem/nscp/releases/tag/0.9.13","schemaVersion":1,"source":"winget","upstream":{"commit":"97d6aa2689f0a05f7847653a62b8624720d15b5d","manifestVersion":"1.10.0","manifests":[{"path":"manifests/m/Mickem/NSClient/0.9.13.0/Mickem.NSClient.yaml","sha256":"30437488ba9f340c6b1c754eadb76d81d8113bde3f4d71392994cdfa26af6b85"},{"path":"manifests/m/Mickem/NSClient/0.9.13.0/Mickem.NSClient.installer.yaml","sha256":"f1637b56ec375d02bfdb730bd143e1b71d873b8baba5650df405955759b29097"},{"path":"manifests/m/Mickem/NSClient/0.9.13.0/Mickem.NSClient.locale.en-US.yaml","sha256":"931cfdf7d300fc8ac732a935b3209d988cb7f840847f4b3c6b76a987325453f5"},{"path":"manifests/m/Mickem/NSClient/0.9.13.0/Mickem.NSClient.locale.zh-CN.yaml","sha256":"c0f5f2837153c5a954263c7ecc883fa014ce348036500abc4808892f291a8558"}],"repository":"microsoft/winget-pkgs"},"version":"0.9.13.0"}