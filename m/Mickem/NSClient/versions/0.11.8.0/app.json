{"defaultLocale":"en-US","id":"Mickem.NSClient","installers":[{"appsAndFeaturesEntries":[{"UpgradeCode":"{0B36E3B7-0042-452D-B376-57E0C07ADDBB}"}],"architecture":"x64","dependencies":[{"PackageDependencies":[{"PackageIdentifier":"Microsoft.VCRedist.2015+.x64"}]}],"id":"x64-wix","installerSwitches":{"InstallLocation":"INSTALLLOCATION=\"<INSTALLPATH>\""},"priority":2,"sha256":"7586b43dc18dc7e99a744d62c7b3f464f2bb3059a048dbb1584048530111ca65","silent":{"arguments":"/quiet /norestart","source":"default"},"successCodes":[],"type":"wix","uninstall":{"type":"productCode","value":"{64E3B638-6021-4BE6-B5D6-51051B41C59D}"},"url":"https://github.com/mickem/nscp/releases/download/0.11.8/NSCP-0.11.8-x64.msi"},{"appsAndFeaturesEntries":[{"UpgradeCode":"{0B36E3B7-0042-452D-B376-57E0C07ADDBB}"}],"architecture":"x86","dependencies":[{"PackageDependencies":[{"PackageIdentifier":"Microsoft.VCRedist.2015+.x86"}]}],"id":"x86-wix","installerSwitches":{"InstallLocation":"INSTALLLOCATION=\"<INSTALLPATH>\""},"priority":2,"sha256":"430876cb770bcc348915ac170253c8f56815c8e5d60cda39b9014a7d39a35923","silent":{"arguments":"/quiet /norestart","source":"default"},"successCodes":[],"type":"wix","uninstall":{"type":"productCode","value":"{D9EABF90-D4CB-45D2-A69B-99B41F6DFE4D}"},"url":"https://github.com/mickem/nscp/releases/download/0.11.8/NSCP-0.11.8-Win32-legacy-xp.msi"}],"licenseUrl":"https://github.com/mickem/nscp/blob/HEAD/COPYING","packageLocalizations":{"en-US":{"description":"A fully fledged monitoring agent which can be used with many monitoring tools.","license":"GPL-2.0","licenseUrl":"https://github.com/mickem/nscp/blob/HEAD/COPYING","locale":"en-US","longDescription":"NSClient++ (nscp) aims to be a simple yet powerful and secure monitoring daemon. It was built for Nagios/Icinga, but nothing in the daemon is Nagios/Icinga specific and it can be used in many other scenarios where you want to receive/distribute check metrics.\nThe daemon has 3 main functions:\n- Allow a remote machine (monitoring server) to request commands to be run on this machine (the monitored machine) which return the status of the machine.\n- Submit the same results to a remote (monitoring server).\n- Take action and perform tasks.","moniker":"nscp","name":"NSClient++","packageUrl":"https://nsclient.org/","publisher":"MySolutions NORDIC","publisherUrl":"https://medin.name/","releaseNotesUrl":"https://github.com/mickem/nscp/releases/tag/0.11.8","tags":["icinga","naemon","nagios"]},"zh-CN":{"description":"可与多种监控工具协同使用的全功能监控代理","locale":"zh-CN","longDescription":"NSClient++（nscp）旨在成为一个简单而强大且安全的监控守护进程。它最初为 Nagios/Icinga 设计，但守护进程本身并不局限于 Nagios/Icinga，可广泛应用于需要接收或分发检查指标的其他场景中。\n该守护进程主要具备三项核心功能：\n- 允许远程主机（监控服务器）请求在本机（被监控主机）上执行命令，以获取主机状态信息。\n- 将相同的检测结果主动提交至远程（监控服务器）。\n- 执行预设操作并完成任务处理。","releaseNotesUrl":"https://github.com/mickem/nscp/releases/tag/0.11.8","tags":[]}},"publisherUrl":"https://medin.name/","releaseDate":"2026-01-24","releaseDateSource":"manifest","releaseNotesUrl":"https://github.com/mickem/nscp/releases/tag/0.11.8","schemaVersion":1,"source":"winget","upstream":{"commit":"97d6aa2689f0a05f7847653a62b8624720d15b5d","manifestVersion":"1.12.0","manifests":[{"path":"manifests/m/Mickem/NSClient/0.11.8.0/Mickem.NSClient.yaml","sha256":"b41fb05f86a13d8649cdd31d4b1551ae24c65dee5c53759911e339a2749f910d"},{"path":"manifests/m/Mickem/NSClient/0.11.8.0/Mickem.NSClient.installer.yaml","sha256":"f54acfdcefa2622f93b2016a2591eada6a1ad8468e422db6379b123f7e3354ac"},{"path":"manifests/m/Mickem/NSClient/0.11.8.0/Mickem.NSClient.locale.en-US.yaml","sha256":"186057752b576240baa82a26ca53fa3d8fc53bef6ee85f5f2458897440fd941f"},{"path":"manifests/m/Mickem/NSClient/0.11.8.0/Mickem.NSClient.locale.zh-CN.yaml","sha256":"ebffb7e6d063789cf9a496678137aee6da4acd0fab4c521487b9325d874b50fa"}],"repository":"microsoft/winget-pkgs"},"version":"0.11.8.0"}