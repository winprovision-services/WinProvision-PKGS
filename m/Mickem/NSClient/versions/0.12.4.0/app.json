{"defaultLocale":"en-US","id":"Mickem.NSClient","installers":[{"appsAndFeaturesEntries":[{"UpgradeCode":"{0B36E3B7-0042-452D-B376-57E0C07ADDBB}"}],"architecture":"x64","dependencies":[{"PackageDependencies":[{"PackageIdentifier":"Microsoft.VCRedist.2015+.x64"}]}],"id":"x64-wix","installerSwitches":{"InstallLocation":"INSTALLLOCATION=\"<INSTALLPATH>\""},"priority":2,"sha256":"d85ff028621ce5dfcc382d631ee7c75e4dbd382027caf5e79b15a3347f6420ab","silent":{"arguments":"/quiet /norestart","source":"default"},"successCodes":[],"type":"wix","uninstall":{"type":"productCode","value":"{B63D5EE6-8EC4-4132-998D-2EE3E2CF6BA0}"},"url":"https://github.com/mickem/nscp/releases/download/0.12.4/NSCP-0.12.4-x64.msi"},{"appsAndFeaturesEntries":[{"UpgradeCode":"{0B36E3B7-0042-452D-B376-57E0C07ADDBB}"}],"architecture":"x86","dependencies":[{"PackageDependencies":[{"PackageIdentifier":"Microsoft.VCRedist.2015+.x86"}]}],"id":"x86-wix","installerSwitches":{"InstallLocation":"INSTALLLOCATION=\"<INSTALLPATH>\""},"priority":2,"sha256":"603376ef822c13f8ea81d0180858a93e68627daa4684390affd7ccc9076bfa7a","silent":{"arguments":"/quiet /norestart","source":"default"},"successCodes":[],"type":"wix","uninstall":{"type":"productCode","value":"{0CB78D98-DCF7-4734-81E6-AE2D70B75F89}"},"url":"https://github.com/mickem/nscp/releases/download/0.12.4/NSCP-0.12.4-Win32-legacy-xp.msi"}],"licenseUrl":"https://github.com/mickem/nscp/blob/HEAD/COPYING","packageLocalizations":{"en-US":{"description":"A fully fledged monitoring agent which can be used with many monitoring tools.","license":"GPL-2.0","licenseUrl":"https://github.com/mickem/nscp/blob/HEAD/COPYING","locale":"en-US","longDescription":"NSClient++ (nscp) aims to be a simple yet powerful and secure monitoring daemon. It was built for Nagios/Icinga, but nothing in the daemon is Nagios/Icinga specific and it can be used in many other scenarios where you want to receive/distribute check metrics.\nThe daemon has 3 main functions:\n- Allow a remote machine (monitoring server) to request commands to be run on this machine (the monitored machine) which return the status of the machine.\n- Submit the same results to a remote (monitoring server).\n- Take action and perform tasks.","moniker":"nscp","name":"NSClient++","packageUrl":"https://nsclient.org/","publisher":"MySolutions NORDIC","publisherUrl":"https://medin.name/","releaseNotesUrl":"https://github.com/mickem/nscp/releases/tag/0.12.4","tags":["icinga","naemon","nagios"]},"zh-CN":{"description":"可与多种监控工具协同使用的全功能监控代理","locale":"zh-CN","longDescription":"NSClient++（nscp）旨在成为一个简单而强大且安全的监控守护进程。它最初为 Nagios/Icinga 设计，但守护进程本身并不局限于 Nagios/Icinga，可广泛应用于需要接收或分发检查指标的其他场景中。\n该守护进程主要具备三项核心功能：\n- 允许远程主机（监控服务器）请求在本机（被监控主机）上执行命令，以获取主机状态信息。\n- 将相同的检测结果主动提交至远程（监控服务器）。\n- 执行预设操作并完成任务处理。","releaseNotesUrl":"https://github.com/mickem/nscp/releases/tag/0.12.4","tags":[]}},"publisherUrl":"https://medin.name/","releaseDate":"2026-05-13","releaseDateSource":"manifest","releaseNotesUrl":"https://github.com/mickem/nscp/releases/tag/0.12.4","schemaVersion":1,"source":"winget","upstream":{"commit":"97d6aa2689f0a05f7847653a62b8624720d15b5d","manifestVersion":"1.12.0","manifests":[{"path":"manifests/m/Mickem/NSClient/0.12.4.0/Mickem.NSClient.yaml","sha256":"5c862ddf87bd2eee525cd8761712db9fd7a7daea96bfd056cfa39cb386f5960c"},{"path":"manifests/m/Mickem/NSClient/0.12.4.0/Mickem.NSClient.installer.yaml","sha256":"c31a9005c349fd61ec7b35a8bac14c4148c8e9605858c94240d45eb3ee78c8cd"},{"path":"manifests/m/Mickem/NSClient/0.12.4.0/Mickem.NSClient.locale.en-US.yaml","sha256":"8b20a99f4857109a9344cd6b530d31953a71fe3b04250025f38312bccfe55ae8"},{"path":"manifests/m/Mickem/NSClient/0.12.4.0/Mickem.NSClient.locale.zh-CN.yaml","sha256":"9323db38b404a39a3d24cd42c6a8055692bb6ea20f8dbc7304e29ac4b477861b"}],"repository":"microsoft/winget-pkgs"},"version":"0.12.4.0"}