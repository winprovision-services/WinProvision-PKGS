{"defaultLocale":"en-US","id":"Mickem.NSClient","installers":[{"appsAndFeaturesEntries":[{"UpgradeCode":"{0B36E3B7-0042-452D-B376-57E0C07ADDBB}"}],"architecture":"x64","dependencies":[{"PackageDependencies":[{"PackageIdentifier":"Microsoft.VCRedist.2015+.x64"}]}],"id":"x64-wix","installerSwitches":{"InstallLocation":"INSTALLLOCATION=\"<INSTALLPATH>\""},"priority":2,"sha256":"48a55fddaddc371a465582d389103b87b8801d6f6893a328224772978317bdca","silent":{"arguments":"/quiet /norestart","source":"default"},"successCodes":[],"type":"wix","uninstall":{"type":"productCode","value":"{1B7B125C-AD5E-44B0-A48B-7FB69F04F102}"},"url":"https://github.com/mickem/nscp/releases/download/0.10.7/NSCP-0.10.7-x64.msi"},{"appsAndFeaturesEntries":[{"UpgradeCode":"{0B36E3B7-0042-452D-B376-57E0C07ADDBB}"}],"architecture":"x86","dependencies":[{"PackageDependencies":[{"PackageIdentifier":"Microsoft.VCRedist.2015+.x86"}]}],"id":"x86-wix","installerSwitches":{"InstallLocation":"INSTALLLOCATION=\"<INSTALLPATH>\""},"priority":2,"sha256":"c5b7805e5d35416ad9f4f4610229303450027da86786bedda0e74703480e5fb8","silent":{"arguments":"/quiet /norestart","source":"default"},"successCodes":[],"type":"wix","uninstall":{"type":"productCode","value":"{D56D364E-4456-4BA8-893E-3E2E6B9D94A8}"},"url":"https://github.com/mickem/nscp/releases/download/0.10.7/NSCP-0.10.7-Win32-legacy-xp.msi"}],"licenseUrl":"https://github.com/mickem/nscp/blob/HEAD/COPYING","packageLocalizations":{"en-US":{"description":"A fully fledged monitoring agent which can be used with many monitoring tools.","license":"GPL-2.0","licenseUrl":"https://github.com/mickem/nscp/blob/HEAD/COPYING","locale":"en-US","longDescription":"NSClient++ (nscp) aims to be a simple yet powerful and secure monitoring daemon. It was built for Nagios/Icinga, but nothing in the daemon is Nagios/Icinga specific and it can be used in many other scenarios where you want to receive/distribute check metrics.\nThe daemon has 3 main functions:\n- Allow a remote machine (monitoring server) to request commands to be run on this machine (the monitored machine) which return the status of the machine.\n- Submit the same results to a remote (monitoring server).\n- Take action and perform tasks.","moniker":"nscp","name":"NSClient++","packageUrl":"https://nsclient.org/","publisher":"MySolutions NORDIC","publisherUrl":"https://medin.name/","releaseNotesUrl":"https://github.com/mickem/nscp/releases/tag/0.10.7","tags":["icinga","naemon","nagios"]},"zh-CN":{"description":"可与多种监控工具协同使用的全功能监控代理","locale":"zh-CN","longDescription":"NSClient++（nscp）旨在成为一个简单而强大且安全的监控守护进程。它最初为 Nagios/Icinga 设计，但守护进程本身并不局限于 Nagios/Icinga，可广泛应用于需要接收或分发检查指标的其他场景中。\n该守护进程主要具备三项核心功能：\n- 允许远程主机（监控服务器）请求在本机（被监控主机）上执行命令，以获取主机状态信息。\n- 将相同的检测结果主动提交至远程（监控服务器）。\n- 执行预设操作并完成任务处理。","releaseNotesUrl":"https://github.com/mickem/nscp/releases/tag/0.10.7","tags":[]}},"publisherUrl":"https://medin.name/","releaseDate":"2025-11-09","releaseDateSource":"manifest","releaseNotesUrl":"https://github.com/mickem/nscp/releases/tag/0.10.7","schemaVersion":1,"source":"winget","upstream":{"commit":"97d6aa2689f0a05f7847653a62b8624720d15b5d","manifestVersion":"1.10.0","manifests":[{"path":"manifests/m/Mickem/NSClient/0.10.7.0/Mickem.NSClient.yaml","sha256":"242b2795ca4e48c84c77acd40b55a1e7b24f93778c0b0f26757b3fab1cf896f0"},{"path":"manifests/m/Mickem/NSClient/0.10.7.0/Mickem.NSClient.installer.yaml","sha256":"6437f1a481bca85570fb684162b705c23ad8e9a9e58be1e9750570ad23db0aed"},{"path":"manifests/m/Mickem/NSClient/0.10.7.0/Mickem.NSClient.locale.en-US.yaml","sha256":"a81ea1db85d5e5ee298fcb1779318834d4ea70e2a0605e5d14df3a3aadb92ffa"},{"path":"manifests/m/Mickem/NSClient/0.10.7.0/Mickem.NSClient.locale.zh-CN.yaml","sha256":"5a9fc06114e56ad6c2cc7d7c0a2788dc11191b044a87dd4532a8cf49faae04fe"}],"repository":"microsoft/winget-pkgs"},"version":"0.10.7.0"}