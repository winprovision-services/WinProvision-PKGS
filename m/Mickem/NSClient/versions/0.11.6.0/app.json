{"defaultLocale":"en-US","id":"Mickem.NSClient","installers":[{"appsAndFeaturesEntries":[{"UpgradeCode":"{0B36E3B7-0042-452D-B376-57E0C07ADDBB}"}],"architecture":"x64","dependencies":[{"PackageDependencies":[{"PackageIdentifier":"Microsoft.VCRedist.2015+.x64"}]}],"id":"x64-wix","installerSwitches":{"InstallLocation":"INSTALLLOCATION=\"<INSTALLPATH>\""},"priority":2,"sha256":"a4f7bbde55d5489d7e2e09e1143a8367955c46cf6e05303c6b4c9b0ddddc9f76","silent":{"arguments":"/quiet /norestart","source":"default"},"successCodes":[],"type":"wix","uninstall":{"type":"productCode","value":"{C9D714A2-6790-439D-A97F-5B69C91AC4D6}"},"url":"https://github.com/mickem/nscp/releases/download/0.11.6/NSCP-0.11.6-x64.msi"},{"appsAndFeaturesEntries":[{"UpgradeCode":"{0B36E3B7-0042-452D-B376-57E0C07ADDBB}"}],"architecture":"x86","dependencies":[{"PackageDependencies":[{"PackageIdentifier":"Microsoft.VCRedist.2015+.x86"}]}],"id":"x86-wix","installerSwitches":{"InstallLocation":"INSTALLLOCATION=\"<INSTALLPATH>\""},"priority":2,"sha256":"2dfaf0e5ea313ff30cf69b772bf3cc88db06bb13ff839bb2d01c5414b44eb351","silent":{"arguments":"/quiet /norestart","source":"default"},"successCodes":[],"type":"wix","uninstall":{"type":"productCode","value":"{9D19D480-43A7-4718-99F5-F3E1BBBBE88E}"},"url":"https://github.com/mickem/nscp/releases/download/0.11.6/NSCP-0.11.6-Win32-legacy-xp.msi"}],"licenseUrl":"https://github.com/mickem/nscp/blob/HEAD/COPYING","packageLocalizations":{"en-US":{"description":"A fully fledged monitoring agent which can be used with many monitoring tools.","license":"GPL-2.0","licenseUrl":"https://github.com/mickem/nscp/blob/HEAD/COPYING","locale":"en-US","longDescription":"NSClient++ (nscp) aims to be a simple yet powerful and secure monitoring daemon. It was built for Nagios/Icinga, but nothing in the daemon is Nagios/Icinga specific and it can be used in many other scenarios where you want to receive/distribute check metrics.\nThe daemon has 3 main functions:\n- Allow a remote machine (monitoring server) to request commands to be run on this machine (the monitored machine) which return the status of the machine.\n- Submit the same results to a remote (monitoring server).\n- Take action and perform tasks.","moniker":"nscp","name":"NSClient++","packageUrl":"https://nsclient.org/","publisher":"MySolutions NORDIC","publisherUrl":"https://medin.name/","releaseNotesUrl":"https://github.com/mickem/nscp/releases/tag/0.11.6","tags":["icinga","naemon","nagios"]},"zh-CN":{"description":"可与多种监控工具协同使用的全功能监控代理","locale":"zh-CN","longDescription":"NSClient++（nscp）旨在成为一个简单而强大且安全的监控守护进程。它最初为 Nagios/Icinga 设计，但守护进程本身并不局限于 Nagios/Icinga，可广泛应用于需要接收或分发检查指标的其他场景中。\n该守护进程主要具备三项核心功能：\n- 允许远程主机（监控服务器）请求在本机（被监控主机）上执行命令，以获取主机状态信息。\n- 将相同的检测结果主动提交至远程（监控服务器）。\n- 执行预设操作并完成任务处理。","releaseNotesUrl":"https://github.com/mickem/nscp/releases/tag/0.11.6","tags":[]}},"publisherUrl":"https://medin.name/","releaseDate":"2026-01-11","releaseDateSource":"manifest","releaseNotesUrl":"https://github.com/mickem/nscp/releases/tag/0.11.6","schemaVersion":1,"source":"winget","upstream":{"commit":"97d6aa2689f0a05f7847653a62b8624720d15b5d","manifestVersion":"1.12.0","manifests":[{"path":"manifests/m/Mickem/NSClient/0.11.6.0/Mickem.NSClient.yaml","sha256":"7e891a70d5a7e754350466861170a2b69d8eab006184dcf65da9317274841389"},{"path":"manifests/m/Mickem/NSClient/0.11.6.0/Mickem.NSClient.installer.yaml","sha256":"cc1593413217f7a5b002e2da68032f81f6b659701975404692b68c995c76d567"},{"path":"manifests/m/Mickem/NSClient/0.11.6.0/Mickem.NSClient.locale.en-US.yaml","sha256":"fafbd13fe58d3c6e2bc6f7928460583b52d41e51c733b1aa1b41326a24dd3216"},{"path":"manifests/m/Mickem/NSClient/0.11.6.0/Mickem.NSClient.locale.zh-CN.yaml","sha256":"e218312347649b3fd1f98b1d146db1d2de38e63fd8c728735d9135b398fa9fa5"}],"repository":"microsoft/winget-pkgs"},"version":"0.11.6.0"}