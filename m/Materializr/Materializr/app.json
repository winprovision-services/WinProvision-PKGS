{"architectures":["x64"],"id":"Materializr.Materializr","latestVersion":"1.7.5","media":{"icons":[],"screenshots":[]},"package":{"description":"Maker 3D CAD - the middle ground between Tinkercad and FreeCAD.","license":"GPL-3.0","licenseUrl":"https://github.com/materializr-cad/materializr/blob/HEAD/LICENSE","locale":"en-US","localizations":{"en-US":{"description":"Maker 3D CAD - the middle ground between Tinkercad and FreeCAD.","license":"GPL-3.0","licenseUrl":"https://github.com/materializr-cad/materializr/blob/HEAD/LICENSE","locale":"en-US","longDescription":"Materializr is open-source 3D CAD for makers - the middle ground between\ndead-simple tools like Tinkercad and full professional suites like FreeCAD.\nSketch on a plane, pull it into a solid (extrude, revolve, loft, sweep),\nfillet and chamfer, run booleans, cut threads, and edit any step of the\nhistory later. Sketches export to SVG and DXF at 1:1 mm for laser cutters and\n2.5D CNC; it imports STEP, IGES, BREP, STL, SVG and DXF, and exports STEP,\nSTL, IGES, BREP, glTF, OBJ, 3MF, SVG and DXF. Real B-rep solids on the\nOpenCASCADE kernel.","moniker":"materializr","name":"Materializr","packageUrl":"https://github.com/materializr-cad/materializr","publisher":"Materializr","publisherUrl":"https://github.com/materializr-cad","releaseNotesUrl":"https://github.com/materializr-cad/materializr/releases/tag/v1.7.5","tags":["3d","3d-printing","cad","engineering","laser","modeling","opencascade","svg"]}},"longDescription":"Materializr is open-source 3D CAD for makers - the middle ground between\ndead-simple tools like Tinkercad and full professional suites like FreeCAD.\nSketch on a plane, pull it into a solid (extrude, revolve, loft, sweep),\nfillet and chamfer, run booleans, cut threads, and edit any step of the\nhistory later. Sketches export to SVG and DXF at 1:1 mm for laser cutters and\n2.5D CNC; it imports STEP, IGES, BREP, STL, SVG and DXF, and exports STEP,\nSTL, IGES, BREP, glTF, OBJ, 3MF, SVG and DXF. Real B-rep solids on the\nOpenCASCADE kernel.","moniker":"materializr","name":"Materializr","packageUrl":"https://github.com/materializr-cad/materializr","publisher":"Materializr","publisherUrl":"https://github.com/materializr-cad","releaseNotesUrl":"https://github.com/materializr-cad/materializr/releases/tag/v1.7.5","tags":["3d","3d-printing","cad","engineering","laser","modeling","opencascade","svg"]},"schemaVersion":1,"source":"winget","versions":[{"architectures":["x64"],"detailPath":"versions/1.7.5/app.json","detailSha256":"c23af229dbc8b95c7b710c76d8b8f97c83ea6a1394150729f59683f10691eab2","releaseDate":"2026-10-25","releaseDateSource":"manifest","version":"1.7.5"},{"architectures":["x64"],"detailPath":"versions/1.7.3/app.json","detailSha256":"0bdaae9aab1e0f76804d98cfae1466e4e6d2b78e752b1376c88b5a928caba835","releaseDate":"2026-10-10","releaseDateSource":"manifest","version":"1.7.3"},{"architectures":["x64"],"detailPath":"versions/1.7.2/app.json","detailSha256":"4491664b5196ffce499f28f63c192c5912506ca38409235f0def72063d81d1e4","releaseDate":"2026-10-03","releaseDateSource":"manifest","version":"1.7.2"},{"architectures":["x64"],"detailPath":"versions/1.6.4/app.json","detailSha256":"6a4fb00affa8247d657c926911c4c13ac66e0a0f799d7e64f9b2c139c2cabc43","releaseDate":"2026-09-05","releaseDateSource":"manifest","version":"1.6.4"},{"architectures":["x64"],"detailPath":"versions/1.6.3/app.json","detailSha256":"33ff8fa628163f18349be6f6a820689ccb0f5411201d24b3789b43469a9e7b99","releaseDate":"2026-08-29","releaseDateSource":"manifest","version":"1.6.3"},{"architectures":["x64"],"detailPath":"versions/1.6.0/app.json","detailSha256":"553b7eb8e0e5df227e2eae39ef9e1b6ca44e371c995c65e9df70115d6308d75b","releaseDate":"2026-08-02","releaseDateSource":"manifest","version":"1.6.0"},{"architectures":["x64"],"detailPath":"versions/1.5.0/app.json","detailSha256":"6be6bf5e978d040a4dcab2261864786a0ae6502550ec621f1885a8ca3ac6b762","releaseDate":"2026-07-19","releaseDateSource":"manifest","version":