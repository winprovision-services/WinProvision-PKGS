{"defaultLocale":"en-US","id":"Graphviz.Graphviz","installers":[{"architecture":"x64","dependencies":[],"elevation":{"requirement":"elevationRequired","source":"inferred"},"id":"x64-machine-nullsoft","priority":1,"scope":"machine","sha256":"d8f32c9ad65bc93aba009d4baf600e987c6c36f72ad21ac77b0292ebd5746799","silent":{"arguments":"/S","source":"default"},"successCodes":[],"type":"nullsoft","uninstall":{"type":"productCode","value":"Graphviz"},"upgradeBehavior":"install","url":"https://gitlab.com/api/v4/projects/4207231/packages/generic/graphviz-releases/14.1.3/windows_10_cmake_Release_graphviz-install-14.1.3-win64.exe"},{"architecture":"x86","dependencies":[],"elevation":{"requirement":"elevationRequired","source":"inferred"},"id":"x86-machine-nullsoft","priority":1,"scope":"machine","sha256":"cbcefff55501e26d4ea7392d2c4005e9cceb0fae9e9ad9869ac71ef362762b15","silent":{"arguments":"/S","source":"default"},"successCodes":[],"type":"nullsoft","uninstall":{"type":"productCode","value":"Graphviz"},"upgradeBehavior":"install","url":"https://gitlab.com/api/v4/projects/4207231/packages/generic/graphviz-releases/14.1.3/windows_10_cmake_Release_graphviz-install-14.1.3-win32.exe"}],"licenseUrl":"https://graphviz.org/license","packageLocalizations":{"en-US":{"description":"Open source graph visualization software","license":"CPL-1.0","licenseUrl":"https://graphviz.org/license","locale":"en-US","longDescription":"Graphviz is open source graph visualization software. Graph visualization is a way of representing structural information as diagrams of abstract graphs and networks. It has important applications in networking, bioinformatics, software engineering, database and web design, machine learning, and in visual interfaces for other technical domains.\nThe Graphviz layout programs take descriptions of graphs in a simple text language, and make diagrams in useful formats, such as images and SVG for web pages; PDF or Postscript for inclusion in other documents; or display in an interactive graph browser. Graphviz has many useful features for concrete diagrams, such as options for colors, fonts, tabular node layouts, line styles, hyperlinks, and custom shapes.","moniker":"graphviz","name":"Graphviz","packageUrl":"https://graphviz.org/download","publisher":"Graphviz","publisherUrl":"https://graphviz.org/","releaseNotesUrl":"https://gitlab.com/graphviz/graphviz/-/releases/14.1.2","tags":["diagram","graph","graphics","plot","visualization"]},"zh-CN":{"description":"开源图形可视化软件","locale":"zh-CN","longDescription":"Graphviz 是开源的图形可视化软件。图形可视化是一种将结构信息表示为抽象图形和网络图的方法。它在网络、生物信息学、软件工程、数据库和网页设计、机器学习，以及其他技术领域的可视化界面中具有重要应用。\nGraphviz 的布局程序接受用简单文本语言描述的图形，并生成多种实用格式的图表，例如用于网页的图像和 SVG 格式；用于插入其他文档的 PDF 或 PostScript 格式；或在交互式图形浏览器中显示。Graphviz 具有多种适用于具体图表的实用功能，例如颜色、字体、表格节点布局、线条样式、超链接以及自定义形状等选项。","tags":["可视化","图形","图示","图表","绘图"]}},"publisherUrl":"https://graphviz.org/","releaseDate":"2026-03-03","releaseDateSource":"manifest","releaseNotesUrl":"https://gitlab.com/graphviz/graphviz/-/releases/14.1.2","schemaVersion":1,"source":"winget","upstream":{"commit":"97d6aa2689f0a05f7847653a62b8624720d15b5d","manifestVersion":"1.12.0","manifests":[{"path":"manifests/g/Graphviz/Graphviz/14.1.3/Graphviz.Graphviz.yaml","sha256":"7fd9661db9cf88774b61bfd828345ace627e08c86d54fcde649c2e48a91327fa"},{"path":"manifests/g/Graphviz/Graphviz/14.1.3/Graphviz.Graphviz.installer.yaml","sha256":"c83d42c1b1c4944c1408fe326590240730aa4a994c4f2fcb23107c07821a73c9"},{"path":"manifests/g/Graphviz/Graphviz/14.1.3/Graphviz.Graphviz.locale.en-US.yaml","sha256":"a03a4ce78f7c8a29aa271363c112c54b84ad5e7ebabbe2f88332fd19ad70c451"},{"path":"manifests/g/Graphviz/Graphviz/14.1.3/Graphviz.Graphviz.locale.zh-CN.yaml","sha256":"c9009940708e36ba8a12c010d57d4e0a3601d10379d059c16fe2dab68985b529"}],"repository":"microsoft/winget-pkgs"},"version":"14.1.3"}