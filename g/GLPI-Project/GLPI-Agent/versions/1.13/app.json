{"defaultLocale":"en-US","id":"GLPI-Project.GLPI-Agent","installers":[{"appsAndFeaturesEntries":[{"ProductCode":"{65E8448B-6BF5-1014-A322-BE7C01B770C9}","UpgradeCode":"{0DEF72A8-E5EE-4116-97DC-753718E19CD5}"}],"architecture":"x64","commands":["glpi-agent","glpi-injector","glpi-inventory","glpi-remote"],"dependencies":[],"elevation":{"requirement":"elevatesSelf","source":"manifest"},"id":"x64-machine-wix","installerSwitches":{"InstallLocation":"INSTALLDIR=\"<INSTALLPATH>\""},"priority":2,"scope":"machine","sha256":"9d0410f87927e83545b227ef10fa4eeb227561513cb03551a394a4d3975e588a","silent":{"arguments":"/quiet /norestart","source":"default"},"successCodes":[],"type":"wix","uninstall":{"type":"productCode","value":"{65E8448B-6BF5-1014-A322-BE7C01B770C9}"},"upgradeBehavior":"install","url":"https://github.com/glpi-project/glpi-agent/releases/download/1.13/GLPI-Agent-1.13-x64.msi"}],"licenseUrl":"https://github.com/glpi-project/glpi-agent/blob/HEAD/LICENSE","packageLocalizations":{"en-US":{"description":"The GLPI Agent is a generic management agent. It can perform a certain number of tasks, according to its own execution plan, or on behalf of a GLPI server acting as a control point.","license":"GPL-2.0","licenseUrl":"https://github.com/glpi-project/glpi-agent/blob/HEAD/LICENSE","locale":"en-US","longDescription":"The GLPI Agent is a generic management agent. It can perform a certain number of tasks, according to its own execution plan, or on behalf of a GLPI server acting as a control point.\nThis agent is based on a fork of FusionInventory agent and so works mainly like FusionInventory agent. It introduces new features and a new protocol to communicate directly with a GLPI server and its native inventory feature. Anyway it also keeps the compatibility with FusionInventory for GLPI plugin.","moniker":"glpi-agent","name":"GLPI Agent","packageUrl":"https://github.com/glpi-project/glpi-agent/releases/","publisher":"Teclib'","publisherUrl":"https://glpi-project.org/","releas