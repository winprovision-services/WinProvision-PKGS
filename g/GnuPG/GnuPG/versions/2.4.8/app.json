{"defaultLocale":"en-US","id":"GnuPG.GnuPG","installers":[{"architecture":"x86","commands":["dirmngr","dirmngr_ldap","gpg","gpg-agent","gpg-card","gpg-check-pattern","gpg-connect-agent","gpg-preset-passphrase","gpg-wks-client","gpgconf","gpgme-w32spawn","gpgsm","gpgtar","gpgv","keyboxd","scdaemon"],"dependencies":[],"elevation":{"requirement":"elevatesSelf","source":"manifest"},"id":"x86-machine-nullsoft","priority":1,"scope":"machine","sha256":"2cd239a8301c59da3737f44566c8c6f9c1779a148af3561e77fb866a0a90de4e","silent":{"arguments":"/S","source":"default"},"successCodes":[],"type":"nullsoft","uninstall":{"type":"productCode","value":"GnuPG"},"upgradeBehavior":"install","url":"https://gnupg.org/ftp/gcrypt/binary/gnupg-w32-2.4.8_20250514.exe"}],"licenseUrl":"https://git.gnupg.org/cgi-bin/gitweb.cgi?p=gnupg.git;a=blob;f=COPYING;hb=HEAD","packageLocalizations":{"en-US":{"description":"GNU Privacy Guard (GnuPG or GPG) is a free-software replacement for Symantec's PGP cryptographic software suite.","license":"GPL-3.0","licenseUrl":"https://git.gnupg.org/cgi-bin/gitweb.cgi?p=gnupg.git;a=blob;f=COPYING;hb=HEAD","locale":"en-US","longDescription":"GnuPG is a complete and free implementation of the OpenPGP standard as defined by RFC4880 (also known as PGP). GnuPG allows you to encrypt and sign your data and communications; it features a versatile key management system, along with access modules for all kinds of public key directories. GnuPG, also known as GPG, is a command line tool with features for easy integration with other applications. A wealth of frontend applications and libraries are available. GnuPG also provides support for S/MIME and Secure Shell (ssh).","moniker":"gnupg","name":"GNU Privacy Guard","packageUrl":"https://gnupg.org/","publisher":"The GnuPG Project","publisherUrl":"https://gnupg.org/","releaseNotesUrl":"https://git.gnupg.org/cgi-bin/gitweb.cgi?p=gnupg.git;a=blob;f=NEWS;hb=HEAD","tags":["crypto","cryptography","encrypt","encryption","gnupg","gpg","pgp","privacy","s/mime","security","sign","signature","x.509"]},"zh-CN":{"description":"GNU Privacy Guard（GnuPG 或 GPG）是赛门铁克 PGP 密码软件套件的免费替代软件。","license":"GPL-3.0","licenseUrl":"https://git.gnupg.org/cgi-bin/gitweb.cgi?p=gnupg.git;a=blob;f=COPYING;hb=HEAD","locale":"zh-CN","longDescription":"GnuPG 是 RFC4880 定义的 OpenPGP 标准（又称 PGP）的完整免费/自由实现。GnuPG 允许你对数据和通信进行加密和签名；它拥有一个多功能密钥管理系统，以及各种公共密钥目录的访问模块。GnuPG 又称 GPG，是一种命令行工具，具有与其他应用程序轻松集成的功能，并且有大量的前端应用程序和库可供使用。GnuPG 还支持 S/MIME 和安全 Shell (ssh)。","name":"GNU Privacy Guard","packageUrl":"https://gnupg.org/","publisher":"The GnuPG Project","publisherUrl":"https://gnupg.org/","releaseNotesUrl":"https://git.gnupg.org/cgi-bin/gitweb.cgi?p=gnupg.git;a=blob;f=NEWS;hb=HEAD","tags":["gnupg","gpg","pgp","s/mime","x.509","加密","安全","密码学","签名","隐私"]}},"publisherUrl":"https://gnupg.org/","releaseDate":"2025-05-14","releaseDateSource":"manifest","releaseNotesUrl":"https://git.gnupg.org/cgi-bin/gitweb.cgi?p=gnupg.git;a=blob;f=NEWS;hb=HEAD","schemaVersion":1,"source":"winget","upstream":{"commit":"97d6aa2689f0a05f7847653a62b8624720d15b5d","manifestVersion":"1.10.0","manifests":[{"path":"manifests/g/GnuPG/GnuPG/2.4.8/GnuPG.GnuPG.yaml","sha256":"655daa314cf2b26b941f3980dc24dba8ca1485b17e7e4e8b460ce8c10c21295b"},{"path":"manifests/g/GnuPG/GnuPG/2.4.8/GnuPG.GnuPG.installer.yaml","sha256":"79146dcc475fdaa8bad94ee3dc3aead74d7a37a5a5fd0f0cc8662f8c5b3f324e"},{"path":"manifests/g/GnuPG/GnuPG/2.4.8/GnuPG.GnuPG.locale.en-US.yaml","sha256":"6789d71439c9ff730c71d4ed68155a24bb05c9bdce4223d38bb21408cd02dec6"},{"path":"manifests/g/GnuPG/GnuPG/2.4.8/GnuPG.GnuPG.locale.zh-CN.yaml","sha256":"baa5c9a86e405492335025046cbcf183622ffb0b871303fa8ae644e261831901"}],"repository":"microsoft/winget-pkgs"},"version":"2.4.8"}