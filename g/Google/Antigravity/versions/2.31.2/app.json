{"defaultLocale":"en-US","id":"Google.Antigravity","installers":[{"architecture":"x64","dependencies":[],"id":"x64-user-nullsoft","installerSwitches":{"Upgrade":"--updated"},"priority":1,"protocols":["antigravity"],"scope":"user","sha256":"c8c5112e2e6fec74220a7ff016bd19bb3fa6e08d44438dcb14b5ecc23ffa2ba0","successCodes":[],"type":"nullsoft","uninstall":{"type":"productCode","value":"121a0be4-63bd-531e-acf8-fc3924c7e984"},"upgradeBehavior":"install","url":"https://storage.googleapis.com/antigravity-public/antigravity-hub/2.31.2-6470801290035200/windows-x64/Antigravity-x64.exe"},{"architecture":"arm64","dependencies":[],"id":"arm64-user-nullsoft","installerSwitches":{"Upgrade":"--updated"},"priority":1,"protocols":["antigravity"],"scope":"user","sha256":"1d140a44fc2abcd10208bcaad3e1bb66333707f4735134880f755086822e03b4","successCodes":[],"type":"nullsoft","uninstall":{"type":"productCode","value":"121a0be4-63bd-531e-acf8-fc3924c7e984"},"upgradeBehavior":"install","url":"https://storage.googleapis.com/antigravity-public/antigravity-hub/2.31.2-6470801290035200/windows-arm/Antigravity-arm64.exe"}],"licenseUrl":"https://antigravity.google/terms","packageLocalizations":{"en-US":{"author":"Google LLC","copyrightUrl":"https://antigravity.google/terms","description":"Experience liftoff with the next-gen agent platform.","documentations":[{"DocumentLabel":"Docs","DocumentUrl":"https://antigravity.google/docs"}],"license":"Proprietary","licenseUrl":"https://antigravity.google/terms","locale":"en-US","longDescription":"Antigravity 2.0 serves as your AI agents' central command center, providing a unified platform to launch, monitor, and orchestrate their activities. Unlike its predecessor, the Agent Manager, Antigravity 2.0 is a standalone application that functions independently of an IDE.\nWithin this interface, you can orchestrate agents both synchronously and asynchronously to:\n- Execute system commands\n- Perform file read/write operations\n- Conduct web searches\n- Integrate with external tools via skills and MCP servers\n- Manage subagents\n- Interact with Chrome\n- Create artifacts / implementation plans\nWhether you are performing deep research or building new applications, Antigravity offers a streamlined interface for all types of knowledge work.","name":"Antigravity","packageUrl":"https://antigravity.google/","privacyUrl":"https://policies.google.com/privacy","publisher":"Google","publisherSupportUrl":"https://antigravity.google/support","publisherUrl":"https://www.google.com/","purchaseUrl":"https://antigravity.google/pricing","releaseNotesUrl":"https://antigravity.google/changelog","tags":["agent","agentic","ai","artificial-intelligence","artificialintellicence","code","coding","develop","development","large-language-model","llm","programming"]},"zh-CN":{"description":"体验次世代智能体平台，开启飞跃之旅","documentations":[{"DocumentLabel":"文档","DocumentUrl":"https://antigravity.google/docs"}],"license":"专有软件","locale":"zh-CN","longDescription":"Antigravity 2.0 是您 AI 智能体的中央指挥中心，提供了一个统一的平台来启动、监控和编排它们的活动。与前身 Agent Manager 不同，Antigravity 2.0 是一个独立于 IDE 运行的应用程序。\n通过该界面，您可以同步或异步地编排智能体，以实现以下功能：\n- 执行系统命令\n- 进行文件读写操作\n- 开展网页搜索\n- 通过技能（Skills）和 MCP 服务器集成外部工具\n- 管理子智能体（Subagents）\n- 与 Chrome 浏览器交互\n- 创建制品（Artifacts）/ 实施计划\n无论您是进行深入研究还是构建新应用，Antigravity 都能为各类知识型工作提供流线型的操作界面。","privacyUrl":"https://policies.google.com/privacy?hl=zh-CN","tags":["人工智能","代码","大语言模型","开发","智能体","编程","自主智能"]}},"publisherSupportUrl":"https://antigravity.google/support","publisherUrl":"https://www.google.com/","releaseDate":"2026-11-11","releaseDateSource":"commit","releaseNotesUrl":"https://antigravity.google/changelog","schemaVersion":1,"source":"winget","upstream":{"commit":"2a5cec868a5770941e79dfb90d24e9d115fd85fd","manifestVersion":"1.28.0","manifests":[{"path":"manifests/g/Google/Antigravity/2.31.2/Google.Antigravity.installer.yaml","sha256":"1ac5a28aa179fa6bc631952935af8b2b098ab4d6e9f3a511c2c1525f0f708919"},{"path":"manifests/g/Google/Antigravity/2.31.2/Google.Antigravity.