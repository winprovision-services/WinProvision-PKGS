{"architectures":["arm64","x64"],"id":"Google.AntigravityCLI","latestVersion":"1.5.1","media":{"icons":[],"screenshots":[]},"package":{"author":"Google LLC","copyrightUrl":"https://antigravity.google/terms","description":"Work with Antigravity directly in your codebase. Build, debug, and ship from your terminal. Describe what you need, and Antigravity handles the rest.","documentations":[{"DocumentLabel":"Docs","DocumentUrl":"https://antigravity.google/docs"}],"license":"Proprietary","licenseUrl":"https://antigravity.google/terms","locale":"en-US","localizations":{"en-US":{"author":"Google LLC","copyrightUrl":"https://antigravity.google/terms","description":"Work with Antigravity directly in your codebase. Build, debug, and ship from your terminal. Describe what you need, and Antigravity handles the rest.","documentations":[{"DocumentLabel":"Docs","DocumentUrl":"https://antigravity.google/docs"}],"license":"Proprietary","licenseUrl":"https://antigravity.google/terms","locale":"en-US","longDescription":"The Antigravity CLI is the lightweight Terminal User Interface (TUI) surface of Antigravity. It brings the same core agentic capabilities as Antigravity 2.0—including multi-step reasoning, multi-file editing, tool calling, and conversation history—directly to your terminal.\nThe CLI is the ideal tool for keyboard-centric developers and remote SSH workflows, optimized for speed and low resource overhead.","name":"Antigravity CLI","packageUrl":"https://antigravity.google/","privacyUrl":"https://policies.google.com/privacy","publisher":"Google","publisherSupportUrl":"https://antigravity.google/support","publisherUrl":"https://www.google.com/","purchaseUrl":"https://antigravity.google/pricing","releaseNotesUrl":"https://antigravity.google/changelog","tags":["agent","agentic","ai","code","coding","develop","development","gemini","large-language-model","llm","programming"]},"zh-CN":{"description":"直接在您的代码库中使用 Antigravity。在终端中完成构建、调试和发布。只需描述您的需求，剩下的交给 Antigravity 即可。","docum