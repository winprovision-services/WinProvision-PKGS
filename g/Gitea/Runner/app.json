{"architectures":["x64"],"id":"Gitea.Runner","latestVersion":"6.0.0","media":{"icons":[{"mimeType":"image/png","path":"media/icon.b1768792.png","priority":1,"sha256":"b17687927e06aa7c91195e957ff845161cb3b58fb0534b33a0a7c776118a82e9","source":"winget-legacy"}],"screenshots":[]},"package":{"author":"The Gitea Authors","copyright":"Copyright (c) 2026 The Gitea Authors","copyrightUrl":"https://gitea.com/gitea/runner/src/branch/HEAD/LICENSE","description":"Gitea Actions Runner is the agent that powers Gitea Actions, our built-in CI/CD system. It runs your jobs on the infrastructure you choose, with the same workflow syntax as GitHub Actions.","license":"MIT","licenseUrl":"https://gitea.com/gitea/runner/src/branch/HEAD/LICENSE","locale":"en-US","localizations":{"en-US":{"author":"The Gitea Authors","copyright":"Copyright (c) 2026 The Gitea Authors","copyrightUrl":"https://gitea.com/gitea/runner/src/branch/HEAD/LICENSE","description":"Gitea Actions Runner is the agent that powers Gitea Actions, our built-in CI/CD system. It runs your jobs on the infrastructure you choose, with the same workflow syntax as GitHub Actions.","license":"MIT","licenseUrl":"https://gitea.com/gitea/runner/src/branch/HEAD/LICENSE","locale":"en-US","longDescription":"Gitea Actions Runner is the agent that powers Gitea Actions, our built-in CI/CD system. It works alongside Gitea's built-in Git server and auxiliary services to create an isolated environment in which the tasks that make up your CI/CD pipeline run.\n\nThe runner works on a simple yet effective premise: it listens for any job dispatched from a Gitea server and runs those jobs in the environment you configure. Whenever a commit or a pull request is made, the runner kicks into action and provides immediate feedback about the impact of the change.","moniker":"gitea-runner","name":"Gitea Runner","packageUrl":"https://about.gitea.com/products/runner/","publisher":"The Gitea Authors","publisherSupportUrl":"https://docs.gitea.com/help/support","publisherUrl":"https://about.gitea.com/","tags":["cd","ci","ci-cd","continuous-delivery","continuous-integration","gitea","gitea-actions"]}},"longDescription":"Gitea Actions Runner is the agent that powers Gitea Actions, our built-in CI/CD system. It works alongside Gitea's built-in Git server and auxiliary services to create an isolated environment in which the tasks that make up your CI/CD pipeline run.\n\nThe runner works on a simple yet effective premise: it listens for any job dispatched from a Gitea server and runs those jobs in the environment you configure. Whenever a commit or a pull request is made, the runner kicks into action and provides immediate feedback about the impact of the change.","moniker":"gitea-runner","name":"Gitea Runner","packageUrl":"https://about.gitea.com/products/runner/","publisher":"The Gitea Authors","publisherSupportUrl":"https://docs.gitea.com/help/support","publisherUrl":"https://about.gitea.com/","tags":["cd","ci","ci-cd","continuous-delivery","continuous-integration","gitea","gitea-actions"]},"schemaVersion":1,"source":"winget","versions":[{"architectures":["x64"],"detailPath":"versions/6.0.0/app.json","detailSha256":"92faeed99d2b1d10fb3d604776dc3ae7a2e87986183be494f584bbb9db841be6","releaseDate":"2026-11-11","releaseDateSource":"commit","version":"6.0.0"},{"architectures":["x64"],"detailPath":"versions/5.4.1/app.json","detailSha256":"31c6456ad6f55b9bf7ee87351035dcbb13fd2b5e28dfeef12228f2f6e52669af","releaseDate":"2026-11-05","releaseDateSource":"commit","version":"5.4.1"},{"architectures":["x64"],"detailPath":"versions/5.4.0/app.json","detailSha256":"09bc5b1fc78ea197106d0a2205cff287130040f29aff6e6014992fac1aca90a7","releaseDate":"2026-11-04","releaseDateSource":"commit","version":"5.4.0"},{"architectures":["x64"],"detailPath":"versions/5.3.0/app.json","detailSha256":"9000bd0fc463e19cdd8f56b87cb23cd24e9cb99f0c292f5c368684acbd12428e","releaseDate":"2026-11-02","releaseDateSource":"manifest","version":"5.3.0"},{"architectures":[