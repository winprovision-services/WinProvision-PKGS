":"/S /V/passive /V/norestart"},"priority":1,"scope":"machine","sha256":"6985e6909d51d38572c8f2d8790907203c732e1d7d632d8be3cc1828868194e6","silent":{"arguments":"/S /V/quiet /V/norestart","source":"manifest"},"successCodes":[],"type":"exe","uninstall":{"type":"productCode","value":"{22CD3BBB-8454-47A1-AADC-8B7CE3E6F8C4}"},"url":"https://github.com/OlapPivotTableExtensions/OlapPivotTableExtensions/releases/download/v0.9.7/OLAP.PivotTable.Extensions.Setup.v0.9.7.exe"}],"licenseUrl":"https://github.com/OlapPivotTableExtensions/OlapPivotTableExtensions/blob/HEAD/license.md","packageLocalizations":{"en-US":{"description":"An Excel add-in which extends the functionality of PivotTables on Analysis Services cubes, Excel Data Model (Power Pivot), and Power BI","license":"MS-PL","licenseUrl":"https://github.com/OlapPivotTableExtensions/OlapPivotTableExtensions/blob/HEAD/license.md","locale":"en-US","longDescription":"OLAP PivotTable Extensions is an Excel add-in which extends the functionality of PivotTables on all types Analysis Services cubes. It supports Analysis Services Tabular, Analysis Services Multidimensional, Azure Analysis Services, and Power BI (both Analyze in Excel and the XMLA endpoint).\nThe Excel API has certain PivotTable functionality which is not exposed in the UI. OLAP PivotTable Extensions provides an interface for some of this functionality. It also adds some new features like searching cubes, configuring default settings, and filtering to a list in your clipboard. The add-in can be launched from the menu option in the right-click menu for PivotTables.","name":"OLAP PivotTable Extensions","packageUrl":"https://olappivottableextensions.github.io/","publisher":"OLAP PivotTable Extensions","publisherUrl":"https://olappivottableextensions.github.io/","releaseNotesUrl":"https://github.com/OlapPivotTableExtensions/OlapPivotTableExtensions/releases/tag/v0.9.7","tags":["excel","pivot-table"]},"zh-CN":{"description":"一款 Excel 插件，可扩展数据透视表在 Analysis Services 多维数据集、Excel 数据模型（Power Pivot）和 Power BI 中的功能","locale":"zh-CN","longDescription":"OLAP PivotTable 扩展插件是一款 Excel 加载项，可增强所有类型 Analysis Services 多维数据集上数据透视表的功能。它支持 Analysis Services 表格模型、Analysis Services 多维模型、Azure Analysis Services 以及 Power BI（包括“在 Excel 中分析”功能和 XMLA 端点）。\nExcel API 中某些数据透视表功能未在用户界面中开放。OLAP PivotTable 扩展插件为部分此类功能提供了操作界面，同时还新增了多维数据集搜索、默认设置配置、剪贴板列表筛选等实用特性。用户可通过数据透视表右键菜单中的选项启动该插件。","tags":["excel","透视表"]}},"publisherUrl":"https://olappivottableextensions.github.io/","releaseDate":"2022-09-14","releaseDateSource":"manifest","releaseNotesUrl":"https://github.com/OlapPivotTableExtensions/OlapPivotTableExtensions/releases/tag/v0.9.7","schemaVersion":1,"source":"winget","upstream":{"commit":"97d6aa2689f0a05f7847653a62b8624720d15b5d","manifestVersion":"1.10.0","manifests":[{"path":"manifests/g/GregGalloway/OLAPPivotTableExtensions/0.9.7/GregGalloway.OLAPPivotTableExtensions.yaml","sha256":"3640ff893313608ef85bd17e649724462cfe1323f0e35d3ae52b3a32c452bed5"},{"path":"manifests/g/GregGalloway/OLAPPivotTableExtensions/0.9.7/GregGalloway.OLAPPivotTableExtensions.installer.yaml","sha256":"5555f3abd5594142980b4c85727eab63c541a5dba4452631b62f2b267eade8b3"},{"path":"manifests/g/GregGalloway/OLAPPivotTableExtensions/0.9.7/GregGalloway.OLAPPivotTableExtensions.locale.en-US.yaml","sha256":"93f239aa72af07aa533fb5b24cae92e1bdcebb0e9d5f9cbdbd4a399a60289a2c"},{"path":"manifests/g/GregGalloway/OLAPPivotTableExtensions/0.9.7/GregGalloway.OLAPPivotTableExtensions.locale.zh-CN.yaml","sha256":"8af4c97336300b99257425918c6c200f5db6d21beb1ceef83e217fd586fb70a1"}],"repository":"microsoft/winget-pkgs"},"version":"0.9.7"}