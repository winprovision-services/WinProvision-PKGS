{"defaultLocale":"en-US","id":"GiulioSorrentino.CBriscola.WPF","installers":[{"architecture":"arm64","dependencies":[{"PackageDependencies":[{"PackageIdentifier":"Microsoft.DotNet.DesktopRuntime.8"}]}],"id":"arm64-wix","priority":2,"sha256":"2579eb4a667f5e8aee108fe377194b959fdc5b18acb9d93b7f1804a7a8a5bc15","silent":{"arguments":"/quiet /norestart","source":"default"},"successCodes":[],"type":"wix","uninstall":{"type":"productCode","value":"{DD0F1B46-75C9-4672-AFD4-398586A536E7}"},"url":"https://github.com/GiulianoSpaghetti/CBriscola.WPF/releases/download/0.7/CBriscolaWPF-0.7.0-arm64.msi"},{"architecture":"x64","dependencies":[{"PackageDependencies":[{"PackageIdentifier":"Microsoft.DotNet.DesktopRuntime.8"}]}],"id":"x64-wix","priority":2,"sha256":"4d90514124abfa62962aacee48a1e07bc51654737cf13cf2d58e0a496cbd4897","silent":{"arguments":"/quiet /norestart","source":"default"},"successCodes":[],"type":"wix","uninstall":{"type":"productCode","value":"{DD0F1B46-75C9-4672-AFD4-398586A536E7}"},"url":"https://github.com/GiulianoSpaghetti/CBriscola.WPF/releases/download/0.7/CBriscolaWPF-0.7.0-amd64.msi"}],"licenseUrl":"https://raw.githubusercontent.com/numerunix/CBriscola.WPF/master/LICENSE.txt","packageLocalizations":{"en-US":{"description":"Simulatore del gioco della briscola a due giocatori senza multiplayer in WPF","license":"GPLv3+","licenseUrl":"https://raw.githubusercontent.com/numerunix/CBriscola.WPF/master/LICENSE.txt","locale":"en-US","longDescription":"Simulatore del gioco della briscola a due giocatori senza multiplayer in WPF. L'algoritmo è brevettato: i punti in totale sono 120, ossia 4 assi che valgono 11 punti ciascuno, 4 3 che valgono 10 punti ciascuno, 4 10 che valgono 4 punti ciascuno, 4 9 che valgono 3 punti ciascuno, 4 8 che valgono 2 punti ciascuno. Dal momento che la matematica non è una opinione: 4*11+4*10=84. 4*4+4*3+4*2=16+12+8=36 84+36=120 punti totali 120/2 = 60, servono 61 punti per vincere basandosi solo sui carichi si rischia di perdere, perché 84-61=23, bisogna prenderli quasi tutti e lasciare solo 23 punti di carichi 60-36=24, prendendo tutte le altre carte bastano solo 3 carichi per vincere. Per cui non metto i livelli, ma vi lascio imparare la teoria delle carte a lungo, da me inventata a 18 anni, con la wxbriscola.","name":"CBriscola.WPF","packageUrl":"https://github.com/numerunix/CBriscola.WPF","publisher":"Giulio Sorrentino","publisherUrl":"http://numerone.altervista.org","tags":["cardgame"]}},"publisherUrl":"http://numerone.altervista.org","schemaVersion":1,"source":"winget","upstream":{"commit":"97d6aa2689f0a05f7847653a62b8624720d15b5d","manifestVersion":"1.6.0","manifests":[{"path":"manifests/g/GiulioSorrentino/CBriscola/WPF/0.7.0/GiulioSorrentino.CBriscola.WPF.yaml","sha256":"b09788fdde3ce95ae60d4afc3d8f0c87a9f82ee845c9a04f34d740be6da2c15f"},{"path":"manifests/g/GiulioSorrentino/CBriscola/WPF/0.7.0/GiulioSorrentino.CBriscola.WPF.installer.yaml","sha256":"17ba37efe2f5df91b245b4b3eac6c61e1ea1d6452bd1eb493574309c93b05e27"},{"path":"manifests/g/GiulioSorrentino/CBriscola/WPF/0.7.0/GiulioSorrentino.CBriscola.WPF.locale.en-US.yaml","sha256":"7503bf9c0baf0186a442fe27f3abe99d0162fa8d058fe4c4b4914c8562f48e04"}],"repository":"microsoft/winget-pkgs"},"version":"0.7.0"}