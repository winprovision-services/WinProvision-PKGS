{"defaultLocale":"en-US","id":"GiulioSorrentino.CBriscola.WPF","installers":[{"architecture":"arm64","dependencies":[{"PackageDependencies":[{"PackageIdentifier":"Microsoft.DotNet.DesktopRuntime.8"}]}],"id":"arm64-wix","priority":2,"sha256":"4967104534590787d33e4008c47659e8e8cf3c544e5519d4c34354817a10e060","silent":{"arguments":"/quiet /norestart","source":"default"},"successCodes":[],"type":"wix","uninstall":{"type":"productCode","value":"{DD0F1B46-75C9-4672-AFD4-39858695A6E7}"},"url":"https://github.com/numerunix/CBriscola.WPF/releases/download/0.6.7/CBriscola.WPF-0.6.7-arm64.msi"},{"architecture":"x64","dependencies":[{"PackageDependencies":[{"PackageIdentifier":"Microsoft.DotNet.DesktopRuntime.8"}]}],"id":"x64-wix","priority":2,"sha256":"43efa91a8fa1cb425438b9bbe7d3264180df92277add12ce239f93fdfa7e6675","silent":{"arguments":"/quiet /norestart","source":"default"},"successCodes":[],"type":"wix","uninstall":{"type":"productCode","value":"{DD0F1B46-75C9-4672-AFD4-39858695A6E7}"},"url":"https://github.com/numerunix/CBriscola.WPF/releases/download/0.6.7/CBriscola.WPF-0.6.7-amd64.msi"}],"licenseUrl":"https://raw.githubusercontent.com/numerunix/CBriscola.WPF/master/LICENSE.txt","packageLocalizations":{"en-US":{"description":"Simulatore del gioco della briscola a due giocatori senza multiplayer in WPF","license":"GPLv3+","licenseUrl":"https://raw.githubusercontent.com/numerunix/CBriscola.WPF/master/LICENSE.txt","locale":"en-US","longDescription":"Simulatore del gioco della briscola a due giocatori senza multiplayer in WPF. L'algoritmo è brevettato: i punti in totale sono 120, ossia 4 assi che valgono 11 punti ciascuno, 4 3 che valgono 10 punti ciascuno, 4 10 che valgono 4 punti ciascuno, 4 9 che valgono 3 punti ciascuno, 4 8 che valgono 2 punti ciascuno. Dal momento che la matematica non è una opinione: 4*11+4*10=84. 4*4+4*3+4*2=16+12+8=36 84+36=120 punti totali 120/2 = 60, servono 61 punti per vincere basandosi solo sui carichi si rischia di perdere, perché 84-61=23, bisogna prenderli quasi tutti e lasciare solo 23 punti di carichi 60-36=24, prendendo tutte le altre carte bastano solo 3 carichi per vincere. Per cui non metto i livelli, ma vi lascio imparare la teoria delle carte a lungo, da me inventata a 18 anni, con la wxbriscola.","name":"CBriscola.WPF","packageUrl":"https://github.com/numerunix/CBriscola.WPF","publisher":"Giulio Sorrentino","publisherUrl":"http://numerone.altervista.org","tags":["cardgame"]}},"publisherUrl":"http://numerone.altervista.org","schemaVersion":1,"source":"winget","upstream":{"commit":"97d6aa2689f0a05f7847653a62b8624720d15b5d","manifestVersion":"1.6.0","manifests":[{"path":"manifests/g/GiulioSorrentino/CBriscola/WPF/0.6.7/GiulioSorrentino.CBriscola.WPF.yaml","sha256":"ae6f3383148e3b995f47c803676a4c9cc35d2963473796489ae347119930373e"},{"path":"manifests/g/GiulioSorrentino/CBriscola/WPF/0.6.7/GiulioSorrentino.CBriscola.WPF.installer.yaml","sha256":"8515e1cf9944daf9c0ece130915c9c0166965f3d635df84d321fb2ce4d256555"},{"path":"manifests/g/GiulioSorrentino/CBriscola/WPF/0.6.7/GiulioSorrentino.CBriscola.WPF.locale.en-US.yaml","sha256":"1f7355e4f4c78f60a300249dc64106d9008b5ef5dfb62e1d7ed5f439ffefb4f1"}],"repository":"microsoft/winget-pkgs"},"version":"0.6.7"}