{"defaultLocale":"en-US","id":"GiulioSorrentino.CBriscola.WPF","installers":[{"architecture":"arm64","dependencies":[{"PackageDependencies":[{"PackageIdentifier":"Microsoft.DotNet.DesktopRuntime.8"}]}],"id":"arm64-wix","priority":2,"sha256":"62171f83bf529f10721c4ebfe7f83c7e55ae653f0bd22cd79824725ce8eab6a5","silent":{"arguments":"/quiet /norestart","source":"default"},"successCodes":[],"type":"wix","uninstall":{"type":"productCode","value":"{DD0F1B46-75C9-4672-AFD4-398586A526EA}"},"url":"https://github.com/GiulianoSpaghetti/CBriscola.WPF/releases/download/0.7/CBriscolaWPF-0.7.0.2-arm64.msi"},{"architecture":"x64","dependencies":[{"PackageDependencies":[{"PackageIdentifier":"Microsoft.DotNet.DesktopRuntime.8"}]}],"id":"x64-wix","priority":2,"sha256":"5850867a805816f06e4e6debcd5eb2dac9b1f131048702dda789062715ee6c4c","silent":{"arguments":"/quiet /norestart","source":"default"},"successCodes":[],"type":"wix","uninstall":{"type":"productCode","value":"{DD0F1B46-75C9-4672-AFD4-398586A526EA}"},"url":"https://github.com/GiulianoSpaghetti/CBriscola.WPF/releases/download/0.7/CBriscolaWPF-0.7.0.2-amd64.msi"}],"licenseUrl":"https://raw.githubusercontent.com/numerunix/CBriscola.WPF/master/LICENSE.txt","packageLocalizations":{"en-US":{"description":"Simulatore del gioco della briscola a due giocatori senza multiplayer in WPF","license":"GPLv3+","licenseUrl":"https://raw.githubusercontent.com/numerunix/CBriscola.WPF/master/LICENSE.txt","locale":"en-US","longDescription":"Simulatore del gioco della briscola a due giocatori senza multiplayer in WPF. L'algoritmo è brevettato: i punti in totale sono 120, ossia 4 assi che valgono 11 punti ciascuno, 4 3 che valgono 10 punti ciascuno, 4 10 che valgono 4 punti ciascuno, 4 9 che valgono 3 punti ciascuno, 4 8 che valgono 2 punti ciascuno. Dal momento che la matematica non è una opinione: 4*11+4*10=84. 4*4+4*3+4*2=16+12+8=36 84+36=120 punti totali 120/2 = 60, servono 61 punti per vincere basandosi solo sui carichi si rischia di perdere, perché 84-61=23, bisogna prenderli quasi tutti e lasciare solo 23 punti di carichi 60-36=24, prendendo tutte le altre carte bastano solo 3 carichi per vincere. Per cui non metto i livelli, ma vi lascio imparare la teoria delle carte a lungo, da me inventata a 18 anni, con la wxbriscola.","name":"CBriscola.WPF","packageUrl":"https://github.com/numerunix/CBriscola.WPF","publisher":"Giulio Sorrentino","publisherUrl":"http://numerone.altervista.org","tags":["cardgame"]}},"publisherUrl":"http://numerone.altervista.org","schemaVersion":1,"source":"winget","upstream":{"commit":"97d6aa2689f0a05f7847653a62b8624720d15b5d","manifestVersion":"1.6.0","manifests":[{"path":"manifests/g/GiulioSorrentino/CBriscola/WPF/0.7.0.2/GiulioSorrentino.CBriscola.WPF.yaml","sha256":"5d0abc239fcb75d21c5f662791f08f8a7d95fa89bd1e52d34eba9a3140eb2095"},{"path":"manifests/g/GiulioSorrentino/CBriscola/WPF/0.7.0.2/GiulioSorrentino.CBriscola.WPF.installer.yaml","sha256":"ad6e89be5064be323bf8dd3b8e92434127f0750470f069da0ac6e24c327f33ac"},{"path":"manifests/g/GiulioSorrentino/CBriscola/WPF/0.7.0.2/GiulioSorrentino.CBriscola.WPF.locale.en-US.yaml","sha256":"f5d731411e0f1a458a00655bc92d1b274a6d728f4493275b5054a00a5dbd4160"}],"repository":"microsoft/winget-pkgs"},"version":"0.7.0.2"}