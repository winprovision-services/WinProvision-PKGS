perché 84-61=23, bisogna prenderli quasi tutti e lasciare solo 23 punti di carichi 60-36=24, prendendo tutte le altre carte bastano solo 3 carichi per vincere. Per cui non metto i livelli, ma vi lascio imparare la teoria delle carte a lungo, da me inventata a 18 anni, con la wxbriscola.","name":"CBriscola.WPF","packageUrl":"https://github.com/numerunix/CBriscola.WPF","publisher":"Giulio Sorrentino","publisherUrl":"http://numerone.altervista.org","releaseNotesUrl":"https://github.com/GiulianoSpaghetti/CBriscola.WPF/releases/tag/0.7.1-1","tags":["cardgame"]}},"publisherUrl":"http://numerone.altervista.org","releaseDate":"2024-10-28","releaseDateSource":"manifest","releaseNotesUrl":"https://github.com/GiulianoSpaghetti/CBriscola.WPF/releases/tag/0.7.1-1","schemaVersion":1,"source":"winget","upstream":{"commit":"97d6aa2689f0a05f7847653a62b8624720d15b5d","manifestVersion":"1.6.0","manifests":[{"path":"manifests/g/GiulioSorrentino/CBriscola/WPF/0.7.1/GiulioSorrentino.CBriscola.WPF.yaml","sha256":"df582108e5ebe584f76a7d80562bec1b06096cbd11395027a4788d8dc9ac7618"},{"path":"manifests/g/GiulioSorrentino/CBriscola/WPF/0.7.1/GiulioSorrentino.CBriscola.WPF.installer.yaml","sha256":"7856bb700a7f0ec2b7e8a6479548e930560af7f2773d61cb2e682105361eefe0"},{"path":"manifests/g/GiulioSorrentino/CBriscola/WPF/0.7.1/GiulioSorrentino.CBriscola.WPF.locale.en-US.yaml","sha256":"588da0d8dbe5faaf3874b59ec64da9bd9ec119e3785b0286faf84952bb5b9eaa"}],"repository":"microsoft/winget-pkgs"},"version":"0.7.1"}