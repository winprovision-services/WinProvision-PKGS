{"defaultLocale":"en-US","id":"GiulioSorrentino.CBriscola.WPF","installers":[{"architecture":"arm64","dependencies":[{"PackageDependencies":[{"PackageIdentifier":"Microsoft.DotNet.DesktopRuntime.10"}]}],"id":"arm64-wix","priority":2,"sha256":"c687de063f5bb43d556d4f9d9d941c2c36126a627b5a687e3a6830300d23e845","silent":{"arguments":"/quiet /norestart","source":"default"},"successCodes":[],"type":"wix","uninstall":{"type":"productCode","value":"{DD0F1B46-75C9-4672-AFD4-398586A546E9}"},"url":"https://github.com/GiulianoSpaghetti/CBriscola.WPF/releases/download/0.7.2/CBriscolaWPF-0.7.2.1-arm64.msi"},{"architecture":"x64","dependencies":[{"PackageDependencies":[{"PackageIdentifier":"Microsoft.DotNet.DesktopRuntime.10"}]}],"id":"x64-wix","priority":2,"sha256":"6340c0e3247f79377b888465e6a7846f77c1cde503e1d615eeb09a74e154b93f","silent":{"arguments":"/quiet /norestart","source":"default"},"successCodes":[],"type":"wix","uninstall":{"type":"productCode","value":"{DD0F1B46-75C9-4672-AFD4-398586A546E9}"},"url":"https://github.com/GiulianoSpaghetti/CBriscola.WPF/releases/download/0.7.2/CBriscolaWPF-0.7.2.1-amd64.msi"}],"licenseUrl":"https://raw.githubusercontent.com/GiulianoSpaghetti/CBriscola.WPF/master/LICENSE.txt","packageLocalizations":{"en-US":{"description":"Simulatore del gioco della briscola a due giocatori senza multiplayer in WPF","license":"GPLv3+","licenseUrl":"https://raw.githubusercontent.com/GiulianoSpaghetti/CBriscola.WPF/master/LICENSE.txt","locale":"en-US","longDescription":"Simulatore del gioco della briscola a due giocatori senza multiplayer in WPF. L'algoritmo è brevettato: i punti in totale sono 120, ossia 4 assi che valgono 11 punti ciascuno, 4 3 che valgono 10 punti ciascuno, 4 10 che valgono 4 punti ciascuno, 4 9 che valgono 3 punti ciascuno, 4 8 che valgono 2 punti ciascuno. Dal momento che la matematica non è una opinione: 4*11+4*10=84. 4*4+4*3+4*2=16+12+8=36 84+36=120 punti totali 120/2 = 60, servono 61 punti per vincere basandosi solo sui carichi si rischia di perdere, perché 84-61=23, bisogna prenderli quasi tutti e lasciare solo 23 punti di carichi 60-36=24, prendendo tutte le altre carte bastano solo 3 carichi per vincere. Per cui non metto i livelli, ma vi lascio imparare la teoria delle carte a lungo, da me inventata a 18 anni, con la wxbriscola.","name":"CBriscola.WPF","packageUrl":"https://github.com/GiulianoSpaghetti/CBriscola.WPF","publisher":"Giulio Sorrentino","publisherUrl":"https://giulianospaghetti.altervista.org","releaseNotesUrl":"https://github.com/GiulianoSpaghetti/CBriscola.WPF/releases/tag/0.7.2","tags":["cardgame"]}},"publisherUrl":"https://giulianospaghetti.altervista.org","releaseDate":"2024-11-13","releaseDateSource":"manifest","releaseNotesUrl":"https://github.com/GiulianoSpaghetti/CBriscola.WPF/releases/tag/0.7.2","schemaVersion":1,"source":"winget","upstream":{"commit":"97d6aa2689f0a05f7847653a62b8624720d15b5d","manifestVersion":"1.12.0","manifests":[{"path":"manifests/g/GiulioSorrentino/CBriscola/WPF/0.7.2.1/GiulioSorrentino.CBriscola.WPF.yaml","sha256":"caeac1e9f7f32cb2e7567856dce2e34859598f45c3e452abb837fe6556d8a406"},{"path":"manifests/g/GiulioSorrentino/CBriscola/WPF/0.7.2.1/GiulioSorrentino.CBriscola.WPF.installer.yaml","sha256":"7d2dd4c539cfa2bd7cb7caf1a8b88449b2204444bddeca0ef004c6454178dcf5"},{"path":"manifests/g/GiulioSorrentino/CBriscola/WPF/0.7.2.1/GiulioSorrentino.CBriscola.WPF.locale.en-US.yaml","sha256":"8e8d4ede680dcc574c1194c6560fcd011bcb66ab3219e232e709624a8d76b6f5"}],"repository":"microsoft/winget-pkgs"},"version":"0.7.2.1"}