{"defaultLocale":"en-US","id":"GiulioSorrentino.CBriscola.WPF","installers":[{"architecture":"arm64","dependencies":[{"PackageDependencies":[{"PackageIdentifier":"Microsoft.DotNet.DesktopRuntime.8"}]}],"id":"arm64-wix","priority":2,"sha256":"ca2cbc242fef6548e404f2c8efc80e5027ae03f18dc753da2537d8fb173eeaff","silent":{"arguments":"/quiet /norestart","source":"default"},"successCodes":[],"type":"wix","uninstall":{"type":"productCode","value":"{DD0F1B46-75C9-4672-AFD4-398586A536E9}"},"url":"https://github.com/GiulianoSpaghetti/CBriscola.WPF/releases/download/0.7.1.1-1/CBriscolaWPF-0.7.1.1-arm64.msi"},{"architecture":"x64","dependencies":[{"PackageDependencies":[{"PackageIdentifier":"Microsoft.DotNet.DesktopRuntime.8"}]}],"id":"x64-wix","priority":2,"sha256":"451c1cbece96bd01a9b87eed845d8cc372d118dc6cd9056b17e444e2be9d7b1e","silent":{"arguments":"/quiet /norestart","source":"default"},"successCodes":[],"type":"wix","uninstall":{"type":"productCode","value":"{DD0F1B46-75C9-4672-AFD4-398586A536E9}"},"url":"https://github.com/GiulianoSpaghetti/CBriscola.WPF/releases/download/0.7.1.1-1/CBriscolaWPF-0.7.1.1-amd64.msi"}],"licenseUrl":"https://raw.githubusercontent.com/numerunix/CBriscola.WPF/master/LICENSE.txt","packageLocalizations":{"en-US":{"description":"Simulatore del gioco della briscola a due giocatori senza multiplayer in WPF","license":"GPLv3+","licenseUrl":"https://raw.githubusercontent.com/numerunix/CBriscola.WPF/master/LICENSE.txt","locale":"en-US","longDescription":"Simulatore del gioco della briscola a due giocatori senza multiplayer in WPF. L'algoritmo è brevettato: i punti in totale sono 120, ossia 4 assi che valgono 11 punti ciascuno, 4 3 che valgono 10 punti ciascuno, 4 10 che valgono 4 punti ciascuno, 4 9 che valgono 3 punti ciascuno, 4 8 che valgono 2 punti ciascuno. Dal momento che la matematica non è una opinione: 4*11+4*10=84. 4*4+4*3+4*2=16+12+8=36 84+36=120 punti totali 120/2 = 60, servono 61 punti per vincere basandosi solo sui carichi si rischia di perdere, perché 84-61=23, bisogna prenderli quasi tutti e lasciare solo 23 punti di carichi 60-36=24, prendendo tutte le altre carte bastano solo 3 carichi per vincere. Per cui non metto i livelli, ma vi lascio imparare la teoria delle carte a lungo, da me inventata a 18 anni, con la wxbriscola.","name":"CBriscola.WPF","packageUrl":"https://github.com/numerunix/CBriscola.WPF","publisher":"Giulio Sorrentino","publisherUrl":"http://numerone.altervista.org","releaseNotesUrl":"https://github.com/GiulianoSpaghetti/CBriscola.WPF/releases/tag/0.7.1.1-1","tags":["cardgame"]}},"publisherUrl":"http://numerone.altervista.org","releaseDate":"2024-10-31","releaseDateSource":"manifest","releaseNotesUrl":"https://github.com/GiulianoSpaghetti/CBriscola.WPF/releases/tag/0.7.1.1-1","schemaVersion":1,"source":"winget","upstream":{"commit":"97d6aa2689f0a05f7847653a62b8624720d15b5d","manifestVersion":"1.6.0","manifests":[{"path":"manifests/g/GiulioSorrentino/CBriscola/WPF/0.7.1.1/GiulioSorrentino.CBriscola.WPF.yaml","sha256":"2bfd35fdd47d178e84d43264c7b13a990d1d99057264f0d66edeabce419a0b8a"},{"path":"manifests/g/GiulioSorrentino/CBriscola/WPF/0.7.1.1/GiulioSorrentino.CBriscola.WPF.installer.yaml","sha256":"011a5d841c8fde9dcaa4a71299e329c41d6ccd7ab49e2cc328a8c587770def2a"},{"path":"manifests/g/GiulioSorrentino/CBriscola/WPF/0.7.1.1/GiulioSorrentino.CBriscola.WPF.locale.en-US.yaml","sha256":"43009699aa851f5c8f31d9f3dec0d5153c3ecf12ba5316d89d082595910c82ff"}],"repository":"microsoft/winget-pkgs"},"version":"0.7.1.1"}