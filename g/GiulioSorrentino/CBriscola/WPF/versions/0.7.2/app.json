{"defaultLocale":"en-US","id":"GiulioSorrentino.CBriscola.WPF","installers":[{"architecture":"arm64","dependencies":[{"PackageDependencies":[{"PackageIdentifier":"Microsoft.DotNet.DesktopRuntime.9"}]}],"id":"arm64-wix","priority":2,"sha256":"ccc363ac3b5252656c230a8d9cab9887aee2f06856c87ce5d2bf343904655023","silent":{"arguments":"/quiet /norestart","source":"default"},"successCodes":[],"type":"wix","uninstall":{"type":"productCode","value":"{DD0F1B46-75C9-4672-AFD4-398586A556E7}"},"url":"https://github.com/GiulianoSpaghetti/CBriscola.WPF/releases/download/0.7.2/CBriscolaWPF-0.7.2-arm64.msi"},{"architecture":"x64","dependencies":[{"PackageDependencies":[{"PackageIdentifier":"Microsoft.DotNet.DesktopRuntime.9"}]}],"id":"x64-wix","priority":2,"sha256":"7b6e87b6a8022ba8ee91a47b5958f53a02df166ad1d2df5a8cd3d53eea19a15f","silent":{"arguments":"/quiet /norestart","source":"default"},"successCodes":[],"type":"wix","uninstall":{"type":"productCode","value":"{DD0F1B46-75C9-4672-AFD4-398586A556E7}"},"url":"https://github.com/GiulianoSpaghetti/CBriscola.WPF/releases/download/0.7.2/CBriscolaWPF-0.7.2-amd64.msi"}],"licenseUrl":"https://raw.githubusercontent.com/numerunix/CBriscola.WPF/master/LICENSE.txt","packageLocalizations":{"en-US":{"description":"Simulatore del gioco della briscola a due giocatori senza multiplayer in WPF","license":"GPLv3+","licenseUrl":"https://raw.githubusercontent.com/numerunix/CBriscola.WPF/master/LICENSE.txt","locale":"en-US","longDescription":"Simulatore del gioco della briscola a due giocatori senza multiplayer in WPF. L'algoritmo è brevettato: i punti in totale sono 120, ossia 4 assi che valgono 11 punti ciascuno, 4 3 che valgono 10 punti ciascuno, 4 10 che valgono 4 punti ciascuno, 4 9 che valgono 3 punti ciascuno, 4 8 che valgono 2 punti ciascuno. Dal momento che la matematica non è una opinione: 4*11+4*10=84. 4*4+4*3+4*2=16+12+8=36 84+36=120 punti totali 120/2 = 60, servono 61 punti per vincere basandosi solo sui carichi si rischia di perdere, perché 84-61=23, bisogna prenderli quasi tutti e lasciare solo 23 punti di carichi 60-36=24, prendendo tutte le altre carte bastano solo 3 carichi per vincere. Per cui non metto i livelli, ma vi lascio imparare la teoria delle carte a lungo, da me inventata a 18 anni, con la wxbriscola.","name":"CBriscola.WPF","packageUrl":"https://github.com/numerunix/CBriscola.WPF","publisher":"Giulio Sorrentino","publisherUrl":"http://numerone.altervista.org","releaseNotesUrl":"https://github.com/GiulianoSpaghetti/CBriscola.WPF/releases/tag/0.7.2","tags":["cardgame"]}},"publisherUrl":"http://numerone.altervista.org","releaseDate":"2024-11-13","releaseDateSource":"manifest","releaseNotesUrl":"https://github.com/GiulianoSpaghetti/CBriscola.WPF/releases/tag/0.7.2","schemaVersion":1,"source":"winget","upstream":{"commit":"97d6aa2689f0a05f7847653a62b8624720d15b5d","manifestVersion":"1.6.0","manifests":[{"path":"manifests/g/GiulioSorrentino/CBriscola/WPF/0.7.2/GiulioSorrentino.CBriscola.WPF.yaml","sha256":"f59b7fabd098fb9e938e630aca85d0c504909bd16c1220cef2037b56bce74143"},{"path":"manifests/g/GiulioSorrentino/CBriscola/WPF/0.7.2/GiulioSorrentino.CBriscola.WPF.installer.yaml","sha256":"22b49f5827cdf221fd057d1c071683591126477aab5b4427ec05ac32ec3e1b3b"},{"path":"manifests/g/GiulioSorrentino/CBriscola/WPF/0.7.2/GiulioSorrentino.CBriscola.WPF.locale.en-US.yaml","sha256":"cf288c6de26de706dbcada6e3ed576439e3b44907191ab31715a0c8615a25aca"}],"repository":"microsoft/winget-pkgs"},"version":"0.7.2"}