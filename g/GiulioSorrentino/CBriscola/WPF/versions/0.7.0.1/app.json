{"defaultLocale":"en-US","id":"GiulioSorrentino.CBriscola.WPF","installers":[{"architecture":"arm64","dependencies":[{"PackageDependencies":[{"PackageIdentifier":"Microsoft.DotNet.DesktopRuntime.8"}]}],"id":"arm64-wix","priority":2,"sha256":"e7da4063f0fbaefbdeaf184126146d7ecfceba4e9a50926dca2e4a595280a7aa","silent":{"arguments":"/quiet /norestart","source":"default"},"successCodes":[],"type":"wix","uninstall":{"type":"productCode","value":"{DD0F1B46-75C9-4672-AFD4-398586A526E9}"},"url":"https://github.com/GiulianoSpaghetti/CBriscola.WPF/releases/download/0.7/CBriscolaWPF-0.7.0.1-arm64.msi"},{"architecture":"x64","dependencies":[{"PackageDependencies":[{"PackageIdentifier":"Microsoft.DotNet.DesktopRuntime.8"}]}],"id":"x64-wix","priority":2,"sha256":"cca3bfbd2cbc8958800c11408d3e04dd5552c62c0fbd448f6dba88d016f65890","silent":{"arguments":"/quiet /norestart","source":"default"},"successCodes":[],"type":"wix","uninstall":{"type":"productCode","value":"{DD0F1B46-75C9-4672-AFD4-398586A526E9}"},"url":"https://github.com/GiulianoSpaghetti/CBriscola.WPF/releases/download/0.7/CBriscolaWPF-0.7.0.1-amd64.msi"}],"licenseUrl":"https://raw.githubusercontent.com/numerunix/CBriscola.WPF/master/LICENSE.txt","packageLocalizations":{"en-US":{"description":"Simulatore del gioco della briscola a due giocatori senza multiplayer in WPF","license":"GPLv3+","licenseUrl":"https://raw.githubusercontent.com/numerunix/CBriscola.WPF/master/LICENSE.txt","locale":"en-US","longDescription":"Simulatore del gioco della briscola a due giocatori senza multiplayer in WPF. L'algoritmo è brevettato: i punti in totale sono 120, ossia 4 assi che valgono 11 punti ciascuno, 4 3 che valgono 10 punti ciascuno, 4 10 che valgono 4 punti ciascuno, 4 9 che valgono 3 punti ciascuno, 4 8 che valgono 2 punti ciascuno. Dal momento che la matematica non è una opinione: 4*11+4*10=84. 4*4+4*3+4*2=16+12+8=36 84+36=120 punti totali 120/2 = 60, servono 61 punti per vincere basandosi solo sui carichi si rischia di perdere, perché 84-61=23, bisogna prenderli quasi tutti e lasciare solo 23 punti di carichi 60-36=24, prendendo tutte le altre carte bastano solo 3 carichi per vincere. Per cui non metto i livelli, ma vi lascio imparare la teoria delle carte a lungo, da me inventata a 18 anni, con la wxbriscola.","name":"CBriscola.WPF","packageUrl":"https://github.com/numerunix/CBriscola.WPF","publisher":"Giulio Sorrentino","publisherUrl":"http://numerone.altervista.org","tags":["cardgame"]}},"publisherUrl":"http://numerone.altervista.org","schemaVersion":1,"source":"winget","upstream":{"commit":"97d6aa2689f0a05f7847653a62b8624720d15b5d","manifestVersion":"1.6.0","manifests":[{"path":"manifests/g/GiulioSorrentino/CBriscola/WPF/0.7.0.1/GiulioSorrentino.CBriscola.WPF.yaml","sha256":"2f1b6d0f3c304e88d609bd2a5702be8291bea1e8b17add5324cac26c579e88c4"},{"path":"manifests/g/GiulioSorrentino/CBriscola/WPF/0.7.0.1/GiulioSorrentino.CBriscola.WPF.installer.yaml","sha256":"13152348d4a9a7ce3284867e6b052c734db17b9b4bb29761ccf7e307da0412d7"},{"path":"manifests/g/GiulioSorrentino/CBriscola/WPF/0.7.0.1/GiulioSorrentino.CBriscola.WPF.locale.en-US.yaml","sha256":"a7d5b41f3a9a7a13500ed5a5212a4c38ada663b325d11378ffcd302cf65871b2"}],"repository":"microsoft/winget-pkgs"},"version":"0.7.0.1"}