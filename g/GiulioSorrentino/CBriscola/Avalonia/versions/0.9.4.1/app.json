{"defaultLocale":"en-US","id":"GiulioSorrentino.CBriscola.Avalonia","installers":[{"architecture":"arm64","dependencies":[{"PackageDependencies":[{"PackageIdentifier":"Microsoft.DotNet.DesktopRuntime.9"}]}],"id":"arm64-wix","priority":2,"sha256":"15e3d976eb48e02782bc56203dacb8d03096f055a06995ce1a7fac38a6258ef1","silent":{"arguments":"/quiet /norestart","source":"default"},"successCodes":[],"type":"wix","uninstall":{"type":"productCode","value":"{68B61DE0-07A0-499E-B3FB-F15873F45EB6}"},"url":"https://github.com/GiulianoSpaghetti/CBriscola.Avalonia/releases/download/0.9.4/CBriscola.Avalonia-0.9.4.1-arm64.msi"},{"architecture":"x64","dependencies":[{"PackageDependencies":[{"PackageIdentifier":"Microsoft.DotNet.DesktopRuntime.9"}]}],"id":"x64-wix","priority":2,"sha256":"16d19968cf3c08c2ae06b12efd2e1ab11a4bdecaeeb8af1dae68a54b98124575","silent":{"arguments":"/quiet /norestart","source":"default"},"successCodes":[],"type":"wix","uninstall":{"type":"productCode","value":"{68B61DE0-07A0-499E-B3FB-F15873F45EB6}"},"url":"https://github.com/GiulianoSpaghetti/CBriscola.Avalonia/releases/download/0.9.4/CBriscola.Avalonia-0.9.4.1-amd64.msi"}],"licenseUrl":"https://raw.githubusercontent.com/numerunix/CBriscola.Avalonia/master/LICENSE.txt","packageLocalizations":{"en-US":{"description":"Il gioco della briscola in c# con avalonia 11, senza multiplayer e coi livelli","license":"GPLv3","licenseUrl":"https://raw.githubusercontent.com/numerunix/CBriscola.Avalonia/master/LICENSE.txt","locale":"en-US","longDescription":"Simulatore del gioco della briscola a due giocatori senza multiplayer in Avalonia 11. L'algoritmo è brevettato: i punti in totale sono 120, ossia 4 assi che valgono 11 punti ciascuno, 4 3 che valgono 10 punti ciascuno, 4 10 che valgono 4 punti ciascuno, 4 9 che valgono 3 punti ciascuno, 4 8 che valgono 2 punti ciascuno. Dal momento che la matematica non è una opinione: 4*11+4*10=84. 4*4+4*3+4*2=16+12+8=36 84+36=120 punti totali 120/2 = 60, servono 61 punti per vincere basandosi solo sui carichi si rischia di perdere, perché 84-61=23, bisogna prenderli quasi tutti e lasciare solo 23 punti di carichi 60-36=24, prendendo tutte le altre carte bastano solo 3 carichi per vincere. IL livello 1 gioca prendendo con la briscola, i livelli 2 e 3 seguono questa teoria.","name":"CBriscola.Avalonia","packageUrl":"https://github.com/numerunix/CBriscola.Avalonia","publisher":"Giulio Sorrentino","publisherUrl":"https://numerone.altervista.org","releaseNotesUrl":"https://github.com/GiulianoSpaghetti/CBriscola.Avalonia/releases/tag/0.9.4","tags":["trump suit","card game"]}},"publisherUrl":"https://numerone.altervista.org","releaseDate":"2024-11-13","releaseDateSource":"manifest","releaseNotesUrl":"https://github.com/GiulianoSpaghetti/CBriscola.Avalonia/releases/tag/0.9.4","schemaVersion":1,"source":"winget","upstream":{"commit":"97d6aa2689f0a05f7847653a62b8624720d15b5d","manifestVersion":"1.6.0","manifests":[{"path":"manifests/g/GiulioSorrentino/CBriscola/Avalonia/0.9.4.1/GiulioSorrentino.CBriscola.Avalonia.yaml","sha256":"d9ab284be100c34ca52f90ec1a3f0116f8ca86f2ca33d9781c44633e5ac83a8c"},{"path":"manifests/g/GiulioSorrentino/CBriscola/Avalonia/0.9.4.1/GiulioSorrentino.CBriscola.Avalonia.installer.yaml","sha256":"124523bd226fe50d4540fb91ea0d303f3ab036160fe007b4c1cdf193a81a306a"},{"path":"manifests/g/GiulioSorrentino/CBriscola/Avalonia/0.9.4.1/GiulioSorrentino.CBriscola.Avalonia.locale.en-US.yaml","sha256":"525ecff0d22d3adb8c559a93c080b6fe56df7139617fc95cabb66dfe5cd75e7a"}],"repository":"microsoft/winget-pkgs"},"version":"0.9.4.1"}