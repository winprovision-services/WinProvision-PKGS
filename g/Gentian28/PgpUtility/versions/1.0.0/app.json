{"defaultLocale":"en-US","id":"Gentian28.PgpUtility","installers":[{"architecture":"x64","dependencies":[],"id":"x64-user-exe","installModes":["interactive","silent"],"installerSwitches":{"Silent":"--silent","SilentWithProgress":"--silent"},"priority":1,"scope":"user","sha256":"ca0dbae436593723f2aae04bda44c955af348a753702cffc5059feb1c1e07e40","silent":{"arguments":"--silent","source":"manifest"},"successCodes":[],"type":"exe","upgradeBehavior":"install","url":"https://github.com/Gentian28/pgp-utility/releases/download/v1.0.0/PgpUtility-win-Setup.exe"}],"licenseUrl":"https://github.com/Gentian28/pgp-utility/blob/main/LICENSE","packageLocalizations":{"en-US":{"description":"Local OpenPGP tool for key management, file and text encryption, signing and verification.","license":"MIT","licenseUrl":"https://github.com/Gentian28/pgp-utility/blob/main/LICENSE","locale":"en-US","longDescription":"A desktop OpenPGP tool that runs entirely on your machine. Generate Ed25519 or RSA key pairs,\nencrypt and decrypt files and text with AES-256, sign and verify with detached or clear-signed\nsignatures, and save a revocation certificate the moment a key is created.\n\nEverything is interoperable with GnuPG in both directions: keys generated here import into\ngpg, gpg can encrypt to them, and this app reads what gpg produces.\n\nNothing leaves your machine. There is no keyserver upload, no account, no telemetry and no\nnetwork use at all.","moniker":"pgp-utility","name":"PGP Utility","packageUrl":"https://github.com/Gentian28/pgp-utility","publisher":"Gentian Shkembi","publisherUrl":"https://www.gentianshkembi.com","releaseNotesUrl":"https://github.com/Gentian28/pgp-utility/releases/tag/v1.0.0","tags":["aes-256","avalonia","cryptography","dotnet","encryption","gnupg","gpg","offline","open-source","openpgp","pgp","privacy","security"]}},"publisherUrl":"https://www.gentianshkembi.com","releaseDate":"2026-07-31","releaseDateSource":"manifest","releaseNotesUrl":"https://github.com/Gentian2