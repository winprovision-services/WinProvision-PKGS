{"architectures":["x86"],"id":"Pidgin.Pidgin","latestVersion":"2.14.14","media":{"icons":[],"screenshots":[]},"package":{"description":"Pidgin is a universal chat client, allowing you to consolidate all your different messaging apps into a single tool.","license":"GPL-2.0","licenseUrl":"https://keep.imfreedom.org/pidgin/pidgin/file/tip/COPYING","locale":"en-US","localizations":{"en-US":{"description":"Pidgin is a universal chat client, allowing you to consolidate all your different messaging apps into a single tool.","license":"GPL-2.0","licenseUrl":"https://keep.imfreedom.org/pidgin/pidgin/file/tip/COPYING","locale":"en-US","longDescription":"Pidgin is a chat program which lets you log in to accounts on multiple chat networks simultaneously. This means that you can be chatting with friends on MSN, talking to a friend on Google Talk, and sitting in a Yahoo chat room all at the same time.","moniker":"pidgin","name":"Pidgin","packageUrl":"https://pidgin.im/","publisher":"Pidgin IM","publisherUrl":"https://pidgin.im/","tags":["aim","bonjour","chat","facebook","icq","irc","jabber","messenger","xmpp"]},"zh-CN":{"description":"Pidgin 是一款通用聊天客户端，可将所有不同的消息应用程序整合到一个工具中。","locale":"zh-CN","longDescription":"Pidgin 是一款聊天程序，可让您同时登录多个聊天网络的账户。这意味着您可以同时与 MSN 上的朋友聊天，与 Google Talk 上的朋友聊天，还可以在雅虎聊天室里聊天。","tags":["aim","bonjour","facebook","icq","irc","jabber","messenger","xmpp","聊天"]}},"longDescription":"Pidgin is a chat program which lets you log in to accounts on multiple chat networks simultaneously. This means that you can be chatting with friends on MSN, talking to a friend on Google Talk, and sitting in a Yahoo chat room all at the same time.","moniker":"pidgin","name":"Pidgin","packageUrl":"https://pidgin.im/","publisher":"Pidgin IM","publisherUrl":"https://pidgin.im/","tags":["aim","bonjour","chat","facebook","icq","irc","jabber","messenger","xmpp"]},"schemaVersion":1,"source":"winget","versions":[{"architectures":["x86"],"detailPath":"versions/2.14.14/app.json","detailSha256"