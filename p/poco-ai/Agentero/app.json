{"architectures":["x64"],"id":"poco-ai.Agentero","latestVersion":"0.15.0","media":{"icons":[{"mimeType":"image/png","path":"media/icon.80a5919f.png","priority":1,"sha256":"80a5919f5cc3fb7d512aa323e74b8cbf8abd60ff02a9e2cb8baf8104fa352fe1","source":"winget-legacy"}],"screenshots":[]},"package":{"description":"Agent 友好的文献管理方式。","license":"MIT","licenseUrl":"https://github.com/poco-ai/Agentero/blob/HEAD/LICENSE","locale":"zh-CN","localizations":{"en-US":{"description":"Agent-friendly reference management.","locale":"en-US","longDescription":"Traditional reference managers are not agent-friendly: highlights and notes stay locked inside single files, making it hard for agents to reuse knowledge across papers; every conversation starts from scratch without a stable local knowledge map; PDFs are human-friendly but not the most comfortable reading material for agents. Agentero aims to build an agent-friendly, agent-native way to manage references, exploring how humans and agents collaborate on reference management. Connect your local agent via ACP (BYOA), select-text chat, import papers and Skills, stay compatible with the Zotero ecosystem, and get paper translation, bidirectional links with a knowledge graph, and deep PDF reading.","releaseNotesUrl":"https://github.com/poco-ai/Agentero/releases/tag/v0.15.0","tags":["academics","agent","article","literature","paper","pdf","reference","research","thesis","zotero"]},"zh-CN":{"description":"Agent 友好的文献管理方式。","license":"MIT","licenseUrl":"https://github.com/poco-ai/Agentero/blob/HEAD/LICENSE","locale":"zh-CN","longDescription":"传统文献管理器对 Agent 并不友好：阅读高亮和笔记被锁在单篇文件里，Agent 很难跨论文复用；每次对话都要重新提供上下文，缺少稳定的本地知识地图；PDF 对人友好，但对 Agent 来讲不是最舒服的阅读材料。Agentero 旨在构建 Agent 友好、Agent 原生的文献管理方式，探索人与 Agent 在文献管理中的协作方式。通过 ACP 连接本机 Agent（BYOA），支持划词对话、论文导入与 Skill 导入，兼容 Zotero 生态，提供论文翻译、双链与知识图谱、PDF 深度阅读等功能。","name":"Agentero","packageUrl":"https://github.com/poco-ai/Agentero","publisher":"poco-ai","publisherUrl":"https://github.com/poco-ai","releaseNotesUrl":"https://github.com/poco-ai/Agentero/releases/tag/v0.15.0","tags":["agent","pdf","zotero","学术","引用","文献","文献管理","研究","论文"]}},"longDescription":"传统文献管理器对 Agent 并不友好：阅读高亮和笔记被锁在单篇文件里，Agent 很难跨论文复用；每次对话都要重新提供上下文，缺少稳定的本地知识地图；PDF 对人友好，但对 Agent 来讲不是最舒服的阅读材料。Agentero 旨在构建 Agent 友好、Agent 原生的文献管理方式，探索人与 Agent 在文献管理中的协作方式。通过 ACP 连接本机 Agent（BYOA），支持划词对话、论文导入与 Skill 导入，兼容 Zotero 生态，提供论文翻译、双链与知识图谱、PDF 深度阅读等功能。","name":"Agentero","packageUrl":"https://github.com/poco-ai/Agentero","publisher":"poco-ai","publisherUrl":"https://github.com/poco-ai","releaseNotesUrl":"https://github.com/poco-ai/Agentero/releases/tag/v0.15.0","tags":["agent","pdf","zotero","学术","引用","文献","文献管理","研究","论文"]},"schemaVersion":1,"source":"winget","versions":[{"architectures":["x64"],"detailPath":"versions/0.15.0/app.json","detailSha256":"5177d9325a12a2782fa4f579ceb819caeb635c8ef27d4d0a734d34dbd8f3a515","releaseDate":"2026-11-04","releaseDateSource":"manifest","version":"0.15.0"},{"architectures":["x64"],"detailPath":"versions/0.12.0/app.json","detailSha256":"d28f9f1256d2a000ed7541f55d2316a12801221059d90124647276e35441c956","releaseDate":"2026-10-19","releaseDateSource":"manifest","version":"0.12.0"},{"architectures":["x64"],"detailPath":"versions/0.11.9/app.json","detailSha256":"9926d29fb695e7b3fcb3df564730c241916ca30275e5052aedc7f479e9f6e393","releaseDate":"2026-10-16","releaseDateSource":"manifest","version":"0.11.9"},{"architectures":["x64"],"detailPath":"versions/0.11.8/app.json","detailSha256":"1ff395255a8b53bf510e356eab00ef0c541f5f44f6ed5d26780ae892aebd213e","releaseDate":"2026-10-14","releaseDateSource":"manifest","version":"0.11.8"},{"architectures":["x64"],"detailPath":"versions/0.11.7/app.json","detailSha256":"1e07121d4327e86e536a315d0f607a47f84f8c6cd64d0c824b3a3c9cc483c817","releaseDate":"2026-10-08","releaseDateSource":"manifest","version":"0.11.7"},{"architectures":["x64"],"detailPath":"versions/0.11.6/app.json","detailSha256":"3ce90a6ea4c53b9a06c020bf32e9b24bf5f3b24ed69b786f870a3dbdf0ba47cf",