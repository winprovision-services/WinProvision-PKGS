{"defaultLocale":"zh-CN","id":"poco-ai.Agentero","installers":[{"architecture":"x64","dependencies":[],"id":"x64-user-nullsoft","priority":1,"scope":"user","sha256":"b4584752d214345e9a7da30609860eb1543713831a77fa0b2493adffddb17fe4","silent":{"arguments":"/S","source":"default"},"successCodes":[],"type":"nullsoft","uninstall":{"type":"productCode","value":"Agentero"},"url":"https://github.com/poco-ai/Agentero/releases/download/v0.8.0/Agentero_0.8.0_x64-setup.exe"},{"appsAndFeaturesEntries":[{"UpgradeCode":"{402FD5B4-C60B-569F-BEDA-586DD7712EAB}"}],"architecture":"x64","dependencies":[],"elevation":{"requirement":"elevationRequired","source":"inferred"},"id":"x64-machine-wix","installerSwitches":{"InstallLocation":"INSTALLDIR=\"<INSTALLPATH>\""},"priority":2,"scope":"machine","sha256":"39b449124ed02ba910c0196d0e7db6d4c7fea8d53f78ab6fe09a8d19ffa9f15c","silent":{"arguments":"/quiet /norestart","source":"default"},"successCodes":[],"type":"wix","uninstall":{"type":"productCode","value":"{58C50D4E-D378-49F6-B7CC-8CED403190ED}"},"url":"https://github.com/poco-ai/Agentero/releases/download/v0.8.0/Agentero_0.8.0_x64_en-US.msi"}],"licenseUrl":"https://github.com/poco-ai/Agentero/blob/HEAD/LICENSE","packageLocalizations":{"en-US":{"description":"Agent-friendly reference management.","locale":"en-US","longDescription":"Traditional reference managers are not agent-friendly: highlights and notes stay locked inside single files, making it hard for agents to reuse knowledge across papers; every conversation starts from scratch without a stable local knowledge map; PDFs are human-friendly but not the most comfortable reading material for agents. Agentero aims to build an agent-friendly, agent-native way to manage references, exploring how humans and agents collaborate on reference management. Connect your local agent via ACP (BYOA), select-text chat, import papers and Skills, stay compatible with the Zotero ecosystem, and get paper translation, bidirectional links with a knowledge graph, and deep PDF reading.","releaseNotesUrl":"https://github.com/poco-ai/Agentero/releases/tag/v0.8.0","tags":["academics","agent","article","literature","paper","pdf","reference","research","thesis","zotero"]},"zh-CN":{"description":"Agent 友好的文献管理方式。","license":"MIT","licenseUrl":"https://github.com/poco-ai/Agentero/blob/HEAD/LICENSE","locale":"zh-CN","longDescription":"传统文献管理器对 Agent 并不友好：阅读高亮和笔记被锁在单篇文件里，Agent 很难跨论文复用；每次对话都要重新提供上下文，缺少稳定的本地知识地图；PDF 对人友好，但对 Agent 来讲不是最舒服的阅读材料。Agentero 旨在构建 Agent 友好、Agent 原生的文献管理方式，探索人与 Agent 在文献管理中的协作方式。通过 ACP 连接本机 Agent（BYOA），支持划词对话、论文导入与 Skill 导入，兼容 Zotero 生态，提供论文翻译、双链与知识图谱、PDF 深度阅读等功能。","name":"Agentero","packageUrl":"https://github.com/poco-ai/Agentero","publisher":"poco-ai","publisherUrl":"https://github.com/poco-ai","releaseNotesUrl":"https://github.com/poco-ai/Agentero/releases/tag/v0.8.0","tags":["agent","pdf","zotero","学术","引用","文献","文献管理","研究","论文"]}},"publisherUrl":"https://github.com/poco-ai","releaseDate":"2026-08-23","releaseDateSource":"manifest","releaseNotesUrl":"https://github.com/poco-ai/Agentero/releases/tag/v0.8.0","schemaVersion":1,"source":"winget","upstream":{"commit":"97d6aa2689f0a05f7847653a62b8624720d15b5d","manifestVersion":"1.12.0","manifests":[{"path":"manifests/p/poco-ai/Agentero/0.8.0/poco-ai.Agentero.yaml","sha256":"658c1a83dbb429995a728b2cb66e6d437ab01f1d14e603e764ec557e8b656168"},{"path":"manifests/p/poco-ai/Agentero/0.8.0/poco-ai.Agentero.installer.yaml","sha256":"1ef93329b4a1953ffa4be50acadc564b340c25f6e97c8b4286118ba936538d75"},{"path":"manifests/p/poco-ai/Agentero/0.8.0/poco-ai.Agentero.locale.en-US.yaml","sha256":"b67246be4d92fbece33a74ed71ec74cf6aed44ed4cbdf7bc522fe9c2309b96eb"},{"path":"manifests/p/poco-ai/Agentero/0.8.0/poco-ai.Agentero.locale.zh-CN.yaml","sha256":"2791f92b3443051d67b53a37963c99d20273d91d2aac88aab016dd4f0ab412f8"}],"repository":"microsoft/winget-pkgs"},"version":"0.8.0"}