{"defaultLocale":"zh-CN","id":"poco-ai.Agentero","installers":[{"architecture":"x64","dependencies":[],"id":"x64-user-nullsoft","priority":1,"scope":"user","sha256":"68820765adb115a1b1cba84493fece3a430604c471e93ad61c58acff0a2fee00","silent":{"arguments":"/S","source":"default"},"successCodes":[],"type":"nullsoft","uninstall":{"type":"productCode","value":"Agentero"},"url":"https://github.com/poco-ai/Agentero/releases/download/v0.5.0/Agentero_0.5.0_x64-setup.exe"},{"appsAndFeaturesEntries":[{"UpgradeCode":"{402FD5B4-C60B-569F-BEDA-586DD7712EAB}"}],"architecture":"x64","dependencies":[],"elevation":{"requirement":"elevationRequired","source":"inferred"},"id":"x64-machine-wix","installerSwitches":{"InstallLocation":"INSTALLDIR=\"<INSTALLPATH>\""},"priority":2,"scope":"machine","sha256":"c723002a4f7ea3337d0773aea8e07005fb3c859d6554796036fc8fd88444eab2","silent":{"arguments":"/quiet /norestart","source":"default"},"successCodes":[],"type":"wix","uninstall":{"type":"productCode","value":"{D11343F5-90E3-4B34-BBFC-8057F2DF5AB3}"},"url":"https://github.com/poco-ai/Agentero/releases/download/v0.5.0/Agentero_0.5.0_x64_en-US.msi"}],"licenseUrl":"https://github.com/poco-ai/Agentero/blob/HEAD/LICENSE","packageLocalizations":{"en-US":{"description":"Agent-friendly reference management.","locale":"en-US","longDescription":"Traditional reference managers are not agent-friendly: highlights and notes stay locked inside single files, making it hard for agents to reuse knowledge across papers; every conversation starts from scratch without a stable local knowledge map; PDFs are human-friendly but not the most comfortable reading material for agents. Agentero aims to build an agent-friendly, agent-native way to manage references, exploring how humans and agents collaborate on reference management. Connect your local agent via ACP (BYOA), select-text chat, import papers and Skills, stay compatible with the Zotero ecosystem, and get paper translation, bidirectional links with a knowledge graph, and deep PDF reading.","releaseNotesUrl":"https://github.com/poco-ai/Agentero/releases/tag/v0.5.0","tags":["academics","agent","article","literature","paper","pdf","reference","research","thesis","zotero"]},"zh-CN":{"description":"Agent 友好的文献管理方式。","license":"MIT","licenseUrl":"https://github.com/poco-ai/Agentero/blob/HEAD/LICENSE","locale":"zh-CN","longDescription":"传统文献管理器对 Agent 并不友好：阅读高亮和笔记被锁在单篇文件里，Agent 很难跨论文复用；每次对话都要重新提供上下文，缺少稳定的本地知识地图；PDF 对人友好，但对 Agent 来讲不是最舒服的阅读材料。Agentero 旨在构建 Agent 友好、Agent 原生的文献管理方式，探索人与 Agent 在文献管理中的协作方式。通过 ACP 连接本机 Agent（BYOA），支持划词对话、论文导入与 Skill 导入，兼容 Zotero 生态，提供论文翻译、双链与知识图谱、PDF 深度阅读等功能。","name":"Agentero","packageUrl":"https://github.com/poco-ai/Agentero","publisher":"poco-ai","publisherUrl":"https://github.com/poco-ai","releaseNotesUrl":"https://github.com/poco-ai/Agentero/releases/tag/v0.5.0","tags":["agent","pdf","zotero","学术","引用","文献","文献管理","研究","论文"]}},"publisherUrl":"https://github.com/poco-ai","releaseDate":"2026-08-07","releaseDateSource":"manifest","releaseNotesUrl":"https://github.com/poco-ai/Agentero/releases/tag/v0.5.0","schemaVersion":1,"source":"winget","upstream":{"commit":"97d6aa2689f0a05f7847653a62b8624720d15b5d","manifestVersion":"1.12.0","manifests":[{"path":"manifests/p/poco-ai/Agentero/0.5.0/poco-ai.Agentero.yaml","sha256":"d035b59a91979210efc2108fd3844c8ec8c3d3c64dd2dafb8e076574128d10df"},{"path":"manifests/p/poco-ai/Agentero/0.5.0/poco-ai.Agentero.installer.yaml","sha256":"ab85d1a10a640e26e6fe25059956e5158a53f9c6b41fcb6f79088ea7bf86bb76"},{"path":"manifests/p/poco-ai/Agentero/0.5.0/poco-ai.Agentero.locale.en-US.yaml","sha256":"4e0284336722f5ad8816e40756c585dac82df103f2cdccf2d5bffad87b392e1a"},{"path":"manifests/p/poco-ai/Agentero/0.5.0/poco-ai.Agentero.locale.zh-CN.yaml","sha256":"0417bca263ed4dffbf14536ca83ed935386b0ea682882aec1f0a545db2221448"}],"repository":"microsoft/winget-pkgs"},"version":"0.5.0"}