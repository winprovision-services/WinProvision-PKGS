{"defaultLocale":"zh-CN","id":"poco-ai.Agentero","installers":[{"architecture":"x64","dependencies":[],"id":"x64-user-nullsoft","priority":1,"scope":"user","sha256":"819fbaf5d2118a1feb1c3feed50fd55af66e8ec2b9c911c6673c702df90e209d","silent":{"arguments":"/S","source":"default"},"successCodes":[],"type":"nullsoft","uninstall":{"type":"productCode","value":"Agentero"},"url":"https://github.com/poco-ai/Agentero/releases/download/v0.8.2/Agentero_0.8.2_x64-setup.exe"},{"appsAndFeaturesEntries":[{"UpgradeCode":"{402FD5B4-C60B-569F-BEDA-586DD7712EAB}"}],"architecture":"x64","dependencies":[],"elevation":{"requirement":"elevationRequired","source":"inferred"},"id":"x64-machine-wix","installerSwitches":{"InstallLocation":"INSTALLDIR=\"<INSTALLPATH>\""},"priority":2,"scope":"machine","sha256":"a5ce64a774d99ca70380c8739bf40491b74d278d6b80f2bca194c049f54348ee","silent":{"arguments":"/quiet /norestart","source":"default"},"successCodes":[],"type":"wix","uninstall":{"type":"productCode","value":"{73A6836E-47A2-4A5A-94F5-71FE4E9E3CD1}"},"url":"https://github.com/poco-ai/Agentero/releases/download/v0.8.2/Agentero_0.8.2_x64_en-US.msi"}],"licenseUrl":"https://github.com/poco-ai/Agentero/blob/HEAD/LICENSE","packageLocalizations":{"en-US":{"description":"Agent-friendly reference management.","locale":"en-US","longDescription":"Traditional reference managers are not agent-friendly: highlights and notes stay locked inside single files, making it hard for agents to reuse knowledge across papers; every conversation starts from scratch without a stable local knowledge map; PDFs are human-friendly but not the most comfortable reading material for agents. Agentero aims to build an agent-friendly, agent-native way to manage references, exploring how humans and agents collaborate on reference management. Connect your local agent via ACP (BYOA), select-text chat, import papers and Skills, stay compatible with the Zotero ecosystem, and get paper translation, bidirectional links with a knowledge graph, and deep PDF reading.","releaseNotesUrl":"https://github.com/poco-ai/Agentero/releases/tag/v0.8.2","tags":["academics","agent","article","literature","paper","pdf","reference","research","thesis","zotero"]},"zh-CN":{"description":"Agent 友好的文献管理方式。","license":"MIT","licenseUrl":"https://github.com/poco-ai/Agentero/blob/HEAD/LICENSE","locale":"zh-CN","longDescription":"传统文献管理器对 Agent 并不友好：阅读高亮和笔记被锁在单篇文件里，Agent 很难跨论文复用；每次对话都要重新提供上下文，缺少稳定的本地知识地图；PDF 对人友好，但对 Agent 来讲不是最舒服的阅读材料。Agentero 旨在构建 Agent 友好、Agent 原生的文献管理方式，探索人与 Agent 在文献管理中的协作方式。通过 ACP 连接本机 Agent（BYOA），支持划词对话、论文导入与 Skill 导入，兼容 Zotero 生态，提供论文翻译、双链与知识图谱、PDF 深度阅读等功能。","name":"Agentero","packageUrl":"https://github.com/poco-ai/Agentero","publisher":"poco-ai","publisherUrl":"https://github.com/poco-ai","releaseNotesUrl":"https://github.com/poco-ai/Agentero/releases/tag/v0.8.2","tags":["agent","pdf","zotero","学术","引用","文献","文献管理","研究","论文"]}},"publisherUrl":"https://github.com/poco-ai","releaseDate":"2026-08-26","releaseDateSource":"manifest","releaseNotesUrl":"https://github.com/poco-ai/Agentero/releases/tag/v0.8.2","schemaVersion":1,"source":"winget","upstream":{"commit":"97d6aa2689f0a05f7847653a62b8624720d15b5d","manifestVersion":"1.12.0","manifests":[{"path":"manifests/p/poco-ai/Agentero/0.8.2/poco-ai.Agentero.yaml","sha256":"50a756aa9650922b91599b7264afc39888d0083dd91d72fb6ab3af36178603c3"},{"path":"manifests/p/poco-ai/Agentero/0.8.2/poco-ai.Agentero.installer.yaml","sha256":"e04b5e852067af89790c8a446f1df11db9435783ff7af41b460d5b70bdfbcdc2"},{"path":"manifests/p/poco-ai/Agentero/0.8.2/poco-ai.Agentero.locale.en-US.yaml","sha256":"8a7df13e2020db27fb2b039d090c412627e2d2199e8c79d0187873cefc24dfc1"},{"path":"manifests/p/poco-ai/Agentero/0.8.2/poco-ai.Agentero.locale.zh-CN.yaml","sha256":"600177a670d4939f551e307a4a3a6c3746963e8fb775327b8feb76a806ea0ab4"}],"repository":"microsoft/winget-pkgs"},"version":"0.8.2"}