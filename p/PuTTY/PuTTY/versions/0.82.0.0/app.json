"x86-machine-wix","installerSwitches":{"InstallLocation":"INSTALLDIR=\"<INSTALLPATH>\""},"priority":2,"scope":"machine","sha256":"6ceef1975c85394e6a5d1b5d87277b7bf04489e679d36e80f5378489d0790d9e","silent":{"arguments":"/quiet /norestart","source":"default"},"successCodes":[],"type":"wix","uninstall":{"type":"productCode","value":"{A38E1B43-5F51-4936-BD2B-DFC7DD8D37A1}"},"upgradeBehavior":"uninstallPrevious","url":"https://the.earth.li/~sgtatham/putty/0.82/w32/putty-0.82-installer.msi"}],"licenseUrl":"https://www.chiark.greenend.org.uk/~sgtatham/putty/licence.html","packageLocalizations":{"en-US":{"description":"A free implementation of SSH and Telnet for Windows and Unix platforms, along with an xterm terminal emulator.","license":"MIT","licenseUrl":"https://www.chiark.greenend.org.uk/~sgtatham/putty/licence.html","locale":"en-US","longDescription":"PuTTY is a client program for the SSH, Telnet, Rlogin, and SUPDUP network protocols.\nThese protocols are all used to run a remote session on a computer, over a network. PuTTY implements the client end of that session: the end at which the session is displayed, rather than the end at which it runs.\nIn really simple terms: you run PuTTY on a Windows machine, and tell it to connect to (for example) a Unix machine. PuTTY opens a window. Then, anything you type into that window is sent straight to the Unix machine, and everything the Unix machine sends back is displayed in the window. So you can work on the Unix machine as if you were sitting at its console, while actually sitting somewhere else.","moniker":"putty","name":"PuTTY","packageUrl":"https://www.chiark.greenend.org.uk/~sgtatham/putty/","publisher":"Simon Tatham","publisherUrl":"https://www.chiark.greenend.org.uk/","releaseNotesUrl":"https://www.chiark.greenend.org.uk/~sgtatham/putty/changes.html","tags":["ssh","telnet","tty","xterm"]},"zh-CN":{"description":"SSH 和 Telnet 在 Windows 和 Unix 平台的免费实现，以及 xterm 终端模拟器。","locale":"zh-CN","longDescription":"PuTTY 是 SSH、Telnet、Rlogin、SUPDUP 网络协议的客户端程序。\n这些协议都用于在计算机上通过网络运行远程会话。PuTTY 实现了会话的客户端：显示会话的终端，而不是运行会话的终端。\n简单来说：在 Windows 机器上运行 PuTTY，然后让它连接（例如）Unix 机器。PuTTY 会打开一个窗口。然后，你在窗口中输入的任何内容都会直接发送到 Unix 机器上，而 Unix 机器发回的所有内容都会显示在窗口中。这样，你就可以在 Unix 机器上工作，就像坐在它的控制台一样，而实际上你坐在其它地方。","tags":[]}},"publisherUrl":"https://www.chiark.greenend.org.uk/","releaseDate":"2024-11-27","releaseDateSource":"manifest","releaseNotesUrl":"https://www.chiark.greenend.org.uk/~sgtatham/putty/changes.html","schemaVersion":1,"source":"winget","upstream":{"commit":"97d6aa2689f0a05f7847653a62b8624720d15b5d","manifestVersion":"1.6.0","manifests":[{"path":"manifests/p/PuTTY/PuTTY/0.82.0.0/PuTTY.PuTTY.yaml","sha256":"8b61dee360de8d00da277809a9d9ae3e8fe8583a4d0a3a4cbae90208123d6a6d"},{"path":"manifests/p/PuTTY/PuTTY/0.82.0.0/PuTTY.PuTTY.installer.yaml","sha256":"82e73bdbac1154d93e8dc5f81df0267b8669a55ea5a50f59b43197826b1d3376"},{"path":"manifests/p/PuTTY/PuTTY/0.82.0.0/PuTTY.PuTTY.locale.en-US.yaml","sha256":"4ef4647d0711792affbe81cbfbf7b17fe3121cc0b6ba25e2f4398e2580e81b6b"},{"path":"manifests/p/PuTTY/PuTTY/0.82.0.0/PuTTY.PuTTY.locale.zh-CN.yaml","sha256":"78d9f8121edc8102e8a9d1a65f2cf6e823c108dc3f77d1721e175b6716d6ed25"}],"repository":"microsoft/winget-pkgs"},"version":"0.82.0.0"}