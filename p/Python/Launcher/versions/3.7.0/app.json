{"defaultLocale":"en-US","id":"Python.Launcher","installers":[{"appsAndFeaturesEntries":[{"DisplayName":"Python Launcher","DisplayVersion":"3.7.150.0","ProductCode":"{D6BDDB48-938A-4384-A7BE-2B4E4931B111}"}],"architecture":"x86","commands":["py","python","pythonw","pyw"],"dependencies":[],"fileExtensions":["py","pyc","pyd","pyo","pyw","pyz","pyzw"],"id":"x86-wix","priority":2,"sha256":"558bdc856eb9a847123060d97e377bf71df44018f828ff9e5b2d46435d48153e","silent":{"arguments":"/quiet /norestart","source":"default"},"successCodes":[],"type":"wix","uninstall":{"type":"productCode","value":"{D6BDDB48-938A-4384-A7BE-2B4E4931B111}"},"upgradeBehavior":"install","url":"https://www.python.org/ftp/python/3.7.0/win32/launcher.msi"}],"licenseUrl":"https://docs.python.org/3/license.html","packageLocalizations":{"en-US":{"description":"The Python launcher for Windows is a utility which aids in locating and executing of different Python versions.","license":"PSF-2.0","licenseUrl":"https://docs.python.org/3/license.html","locale":"en-US","longDescription":"The Python launcher for Windows is a utility which aids in locating and executing of different Python versions.\nIt allows scripts (or the command-line) to indicate a preference for a specific Python version, and will locate and execute that version.\n\nUnlike the PATH variable, the launcher will correctly select the most appropriate version of Python.\nIt will prefer per-user installations over system-wide ones, and orders by language version rather than using the most recently installed version.\n\nThe launcher was originally specified in PEP 397.","moniker":"python-launcher","name":"Python Launcher","packageUrl":"https://www.python.org/","publisher":"Python Software Foundation","publisherUrl":"https://www.python.org/","tags":["language","programming","programming-language","python","python3","script"]}},"publisherUrl":"https://www.python.org/","schemaVersion":1,"source":"winget","upstream":{"commit":"97d6aa2689f0a05f7847653a62b86