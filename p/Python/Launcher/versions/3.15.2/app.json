ntly installed version.\n\nThe launcher was originally specified in PEP 397.","moniker":"python-launcher","name":"Python Launcher","packageUrl":"https://www.python.org/","privacyUrl":"https://www.python.org/privacy/","publisher":"Python Software Foundation","publisherSupportUrl":"https://www.python.org/about/help/","publisherUrl":"https://www.python.org/","tags":["language","programming","programming-language","python","python3","script"]}},"publisherSupportUrl":"https://www.python.org/about/help/","publisherUrl":"https://www.python.org/","releaseDate":"2026-11-05","releaseDateSource":"commit","schemaVersion":1,"source":"winget","upstream":{"commit":"a4a78ef7dd5a1ec000e60392173b33bed55f7cbb","manifestVersion":"1.12.0","manifests":[{"path":"manifests/p/Python/Launcher/3.15.2/Python.Launcher.installer.yaml","sha256":"6f79c22bd8d66c85c6749751e0aadc4ebf031907d0d6d3404bf9ff4a19a069a0"},{"path":"manifests/p/Python/Launcher/3.15.2/Python.Launcher.locale.en-US.yaml","sha256":"cafe0488b76d2d89615ab55b79b4f111a006e79d1c1014ccd7f8c6014bdee6ab"},{"path":"manifests/p/Python/Launcher/3.15.2/Python.Launcher.yaml","sha256":"b556987d49c15f3d6d3be890608f1e65c30b874f592f090d8fbebb03a5fdb7f6"}],"repository":"microsoft/winget-pkgs"},"version":"3.15.2"}