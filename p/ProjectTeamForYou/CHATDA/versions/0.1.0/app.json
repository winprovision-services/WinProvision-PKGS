{"defaultLocale":"en-US","id":"ProjectTeamForYou.CHATDA","installers":[{"architecture":"x64","dependencies":[],"id":"x64-user-exe","installModes":["interactive","silent","silentWithProgress"],"installerSwitches":{"Silent":"-Quiet -NoDesktop","SilentWithProgress":"-Quiet"},"minimumOSVersion":"10.0.17763.0","platforms":["Windows.Desktop"],"priority":1,"scope":"user","sha256":"37f6f943e7832687aaa00aaf9bf8644748198529bf44b3be9e86e2ee78582677","silent":{"arguments":"-Quiet -NoDesktop","source":"manifest"},"successCodes":[],"type":"exe","uninstall":{"type":"productCode","value":"chatda"},"upgradeBehavior":"install","url":"https://github.com/work517/chatda-releases/releases/download/v0.1.0/chatda-0.1.0-win-x64-setup.exe"}],"licenseUrl":"https://chatda.dev/legal/en.html","packageLocalizations":{"en-US":{"description":"Find the file by a word inside it, not by its name.","license":"Proprietary","licenseUrl":"https://chatda.dev/legal/en.html","locale":"en-US","longDescription":"CHATDA indexes the text inside HWP, PDF, Word, Excel and PowerPoint files, so you can\nfind a document by a phrase you remember rather than by its filename. It also reads\ntext out of scanned images using the recognizer Windows already ships.\nSearch understands 12 languages, including Korean initial-consonant search and\nkeyboard-layout typos. One executable, no third-party libraries, and no network\naccess at all - the interface binds to 127.0.0.1 only.","moniker":"chatda","name":"CHATDA","packageUrl":"https://chatda.dev","publisher":"Project Team For You","publisherUrl":"https://chatda.dev","releaseNotesUrl":"https://github.com/work517/chatda-releases/releases/tag/v0.1.0","tags":["desktop-search","file-search","full-text-search","hwp","korean","ocr","offline","pdf","search"]},"ko-KR":{"description":"파일 이름이 아니라 문서 안의 낱말로 찾는 검색기입니다.","license":"개인 사용 무료","licenseUrl":"https://chatda.dev/legal/ko.html","locale":"ko-KR","longDescription":"한/글(HWP·HWPX)·PDF·워드·엑셀·파워포인트 안쪽 글자까지 색인해서, 파일 이름이\n기억나지 않아도 문서 안의 한 낱말로 찾습니다. 스캔한 그림 속 글자도 윈도에 이미\n들어 있는 인식기로 읽습니다.\n초성 검색, 자판을 바꿔 친 오타, 12개 언어를 함께 다룹니다. 실행 파일 하나이고,\n외부 라이브러리를 하나도 쓰지 않으며, 밖으로 나가는 통신이 없습니다.","name":"찾다(CHATDA)","packageUrl":"https://chatda.dev","publisher":"프로젝트팀포유","publisherUrl":"https://chatda.dev","tags":[]}},"publisherUrl":"https://chatda.dev","releaseDate":"2026-09-08","releaseDateSource":"manifest","releaseNotesUrl":"https://github.com/work517/chatda-releases/releases/tag/v0.1.0","schemaVersion":1,"source":"winget","upstream":{"commit":"97d6aa2689f0a05f7847653a62b8624720d15b5d","manifestVersion":"1.6.0","manifests":[{"path":"manifests/p/ProjectTeamForYou/CHATDA/0.1.0/ProjectTeamForYou.CHATDA.yaml","sha256":"a0c2b2ac1bdbe60ce385212154c256996d438477fdbfd574dd36fbf91eebe88f"},{"path":"manifests/p/ProjectTeamForYou/CHATDA/0.1.0/ProjectTeamForYou.CHATDA.installer.yaml","sha256":"3e0a4bccb85fb2aa0da29064cfb1052ef34570c69c6c98013fddca69c2dcaf68"},{"path":"manifests/p/ProjectTeamForYou/CHATDA/0.1.0/ProjectTeamForYou.CHATDA.locale.en-US.yaml","sha256":"aeb533f306d1560f2fe562152697f67e575ffe8338e6312421af35cab436bff1"},{"path":"manifests/p/ProjectTeamForYou/CHATDA/0.1.0/ProjectTeamForYou.CHATDA.locale.ko-KR.yaml","sha256":"7facadd3e2fb0ccbff1034f10ff0883d2df3a48fa540c85d107146c44e3d4bc1"}],"repository":"microsoft/winget-pkgs"},"version":"0.1.0"}