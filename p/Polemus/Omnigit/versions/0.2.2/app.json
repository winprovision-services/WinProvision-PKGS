{"defaultLocale":"en-US","id":"Polemus.Omnigit","installers":[{"architecture":"x64","dependencies":[],"elevation":{"requirement":"elevatesSelf","source":"manifest"},"id":"x64-machine-inno","installerSwitches":{"Silent":"/SP- /VERYSILENT /SUPPRESSMSGBOXES /NORESTART /ALLUSERS","SilentWithProgress":"/SP- /SILENT /SUPPRESSMSGBOXES /NORESTART /ALLUSERS"},"priority":1,"scope":"machine","sha256":"100a9d06b65380c8fc855be7dea8621a954ef6232f684b279be5ca7e56d684df","silent":{"arguments":"/SP- /VERYSILENT /SUPPRESSMSGBOXES /NORESTART /ALLUSERS","source":"manifest"},"successCodes":[],"type":"inno","uninstall":{"type":"productCode","value":"{9F2C6B31-7A4E-4D18-9C55-2E7B1A4F8D30}_is1"},"upgradeBehavior":"install","url":"https://github.com/Polemus/Omnigit/releases/download/v0.2.2/Omnigit-0.2.2-win-x64-setup.exe"}],"licenseUrl":"https://github.com/Polemus/Omnigit/blob/main/LICENSE","packageLocalizations":{"en-US":{"description":"Desktop git client for GitHub, Gitea and other forges","license":"MIT","licenseUrl":"https://github.com/Polemus/Omnigit/blob/main/LICENSE","locale":"en-US","longDescription":"A desktop git client in the spirit of GitHub Desktop, except it is not tied to GitHub. Omnigit talks to GitHub, Gitea and GitLab - including self-hosted instances behind your own domain - and to anything else you describe in a JSON file, without writing any code.\nNo git installation is required. The native libgit2 library ships inside the app, so there is nothing else to install.\nDay to day it does the usual work of a git client: working-tree status, unified diffs, staging and committing, history with tag badges, branching, tags, and fetch, push and pull. Branch switching asks what to do with uncommitted work instead of refusing, and merges, reverts and cherry-picks that stop on conflicts are finished from inside the app.\nAccess tokens go to your system keyring, never to a settings file.","moniker":"omnigit","name":"Omnigit","packageUrl":"https://github.com/Polemus/Omnigit","publisher":"Polemus","publisherUrl":"https://github.com/Polemus","releaseNotesUrl":"https://github.com/Polemus/Omnigit/releases/tag/v0.2.2","tags":["diff","forge","git","gitea","github","gitlab","source-control","vcs","version-control"]}},"publisherUrl":"https://github.com/Polemus","releaseDate":"2026-08-17","releaseDateSource":"manifest","releaseNotesUrl":"https://github.com/Polemus/Omnigit/releases/tag/v0.2.2","schemaVersion":1,"source":"winget","upstream":{"commit":"97d6aa2689f0a05f7847653a62b8624720d15b5d","manifestVersion":"1.12.0","manifests":[{"path":"manifests/p/Polemus/Omnigit/0.2.2/Polemus.Omnigit.yaml","sha256":"bd58960bd9abb1a31d854120ff062500a095bb06f9df9175b07fb63c7609f86a"},{"path":"manifests/p/Polemus/Omnigit/0.2.2/Polemus.Omnigit.installer.yaml","sha256":"024431c2316475d7ad21cbd046a26103d65d37956463ac46914dbe1330edc6ce"},{"path":"manifests/p/Polemus/Omnigit/0.2.2/Polemus.Omnigit.locale.en-US.yaml","sha256":"7482645f2c67221669e2ef8fb48df26b06368c4ed88d1e6ad7ec1850f9e075cb"}],"repository":"microsoft/winget-pkgs"},"version":"0.2.2"}