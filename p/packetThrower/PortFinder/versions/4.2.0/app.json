PL-3.0","licenseUrl":"https://github.com/packetThrower/PortFinder/blob/HEAD/LICENSE","locale":"en-US","longDescription":"PortFinder identifies which switch, switchport, and VLAN your\nmachine is currently plugged into by listening for the discovery\npackets the switch is already broadcasting. No agent on the\nswitch, no SNMP, no login — just a passive 30-second listen on\nthe wire.\n\nSupported protocols:\n- LLDP (universal: Aruba, HP, Juniper, Extreme, Cisco, MikroTik)\n- CDP (Cisco)\n- MNDP (MikroTik RouterOS fallback)\n\nShips a desktop GUI and a headless CLI in one binary. The CLI\ntakes `portfinder capture --interface <NIC> --protocol LLDP\n[--json]`. Requires Npcap (with \"Allow non-administrators to\ncapture\" enabled) for non-administrator capture.","moniker":"portfinder","name":"PortFinder","packageUrl":"https://packetthrower.github.io/PortFinder/","publisher":"packetThrower","publisherUrl":"https://github.com/packetThrower","releaseNotesUrl":"https://github.com/packetThrower/PortFinder/releases/tag/v4.2.0","tags":["cdp","discovery","lldp","mndp","network","networking","npcap","packet-capture","pcap","switch","vlan"]}},"publisherUrl":"https://github.com/packetThrower","releaseDate":"2026-10-26","releaseDateSource":"manifest","releaseNotesUrl":"https://github.com/packetThrower/PortFinder/releases/tag/v4.2.0","schemaVersion":1,"source":"winget","upstream":{"commit":"97d6aa2689f0a05f7847653a62b8624720d15b5d","manifestVersion":"1.12.0","manifests":[{"path":"manifests/p/packetThrower/PortFinder/4.2.0/packetThrower.PortFinder.yaml","sha256":"1411201cdba27ea720f77ec8dfb3d5b4ac343e0cbf385accdc2aa27d85d77e70"},{"path":"manifests/p/packetThrower/PortFinder/4.2.0/packetThrower.PortFinder.installer.yaml","sha256":"b0c383a8149b7b04373a0a4f0c0cea2b90402ed90929b3e4249a26ef4ba0074d"},{"path":"manifests/p/packetThrower/PortFinder/4.2.0/packetThrower.PortFinder.locale.en-US.yaml","sha256":"8147e7c9bdddf65c7eab2c0f369cdb25b4c3bf75beae89421f567eeb8f734803"}],"repository":"micr