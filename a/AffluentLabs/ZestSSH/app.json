vice, all backed by a single shared connection library.","moniker":"zestssh","name":"ZestSSH","packageUrl":"https://zestssh.com","publisher":"Affluent Labs","publisherSupportUrl":"https://zestssh.com/support","publisherUrl":"https://zestssh.com","releaseNotes":"ZestSSH 3.3.3: no silent lock of your data on a Mac when the sign-in cannot be read, Reset never deletes (it sets the data aside), and data from before an update stays yours.","releaseNotesUrl":"https://zestssh.com/changelog","tags":["ssh","sftp","terminal","console","shell","port-forwarding","tunnel","remote","devops","sysadmin"]},"schemaVersion":1,"source":"winget","versions":[{"architectures":["x64"],"detailPath":"versions/3.3.3/app.json","detailSha256":"a13821e589c085ae1d10d5751486fb64e2c1c9f04326aef69f8ab63094ed6bd5","releaseDate":"2026-11-07","releaseDateSource":"commit","version":"3.3.3"},{"architectures":["x64"],"detailPath":"versions/3.3.2/app.json","detailSha256":"d56869e9c3ab961de8a4fbfb963395c2d436867cf940d19b31d0c82cd3f7efd1","releaseDate":"2026-11-06","releaseDateSource":"commit","version":"3.3.2"},{"architectures":["x64"],"detailPath":"versions/3.3.0/app.json","detailSha256":"3a38ce789c9a3dd95440175fb683217c39826daa169d9faebcdd2417c2dd1e8a","releaseDate":"2026-11-05","releaseDateSource":"commit","version":"3.3.0"},{"architectures":["x64"],"detailPath":"versions/3.2.7/app.json","detailSha256":"a04be6376fe5ab1e61c955f663f11f8c1b2702cbb45bc148802d4a49708a80b2","releaseDate":"2026-10-28","releaseDateSource":"manifest","version":"3.2.7"},{"architectures":["x64"],"detailPath":"versions/3.2.6/app.json","detailSha256":"f2bce9653422195b8f2ad13960f59829de7a1814fb7feef1603d23477cb2537d","releaseDate":"2026-10-28","releaseDateSource":"manifest","version":"3.2.6"},{"architectures":["x64"],"detailPath":"versions/3.2.5/app.json","detailSha256":"bb1fa7361d813a2c44953b35a0f017c819f924ca581a92521b404a5940705d4e","releaseDate":"2026-10-27","releaseDateSource":"manifest","version":"3.2.5"},{"architectures":["x64"]