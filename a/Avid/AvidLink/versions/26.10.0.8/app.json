ic、TikTok、Amazon Prime Music、Anghami 以及全球数十个主流流媒体平台。此外，您可保留 100% 的权利和收益。通过社交链接分享您的最新作品。","tags":["音乐","音频"]}},"publisherUrl":"https://www.avid.com/","releaseDate":"2026-10-26","releaseDateSource":"manifest","schemaVersion":1,"source":"winget","upstream":{"commit":"97d6aa2689f0a05f7847653a62b8624720d15b5d","manifestVersion":"1.28.0","manifests":[{"path":"manifests/a/Avid/AvidLink/26.10.0.8/Avid.AvidLink.yaml","sha256":"e87e230919f5190e356fad5fcc5d81f6ad14593b03cbddd03ecdc036c9113a0f"},{"path":"manifests/a/Avid/AvidLink/26.10.0.8/Avid.AvidLink.installer.yaml","sha256":"ebe8054930ecbdd9fd1724cb1c7d5335e0ad0a2142ef802b64a14fee09bb3741"},{"path":"manifests/a/Avid/AvidLink/26.10.0.8/Avid.AvidLink.locale.en-US.yaml","sha256":"1c7e4b41a55fc464d7c453d7fa58dbc9927df084a8efb379b2c107caeb8d7c7c"},{"path":"manifests/a/Avid/AvidLink/26.10.0.8/Avid.AvidLink.locale.zh-CN.yaml","sha256":"a6175bd815eeaacd43d05d0613a14079a4c9405b47aa927d8bf8bdb72ea4a685"}],"repository":"microsoft/winget-pkgs"},"version":"26.10.0.8"}