{"architectures":["arm64","x64"],"id":"AuthorMore.PenpotDesktop","latestVersion":"1.0.1","media":{"icons":[{"mimeType":"image/png","path":"media/icon.97f69cac.png","priority":1,"sha256":"97f69cacb14fd7d0f3c12e684c33bd6025f364e4bdd7e877a871e4ddc18846b0","source":"winget-legacy"}],"screenshots":[]},"package":{"description":"A desktop application for Penpot, an open-source design tool.","license":"AGPL-3.0","licenseUrl":"https://github.com/author-more/penpot-desktop/blob/HEAD/LICENSE","locale":"en-US","localizations":{"en-US":{"description":"A desktop application for Penpot, an open-source design tool.","license":"AGPL-3.0","licenseUrl":"https://github.com/author-more/penpot-desktop/blob/HEAD/LICENSE","locale":"en-US","longDescription":"Penpot Desktop is an unofficial desktop application for the open-source design tool, Penpot.\nIt provides you with access to the functionality of the browser version of Penpot with an experience of a desktop application. It comes with\n- system-level application experience e.g. a dedicated window, file extension association,\n- versatile dark-light mode setup,\n- tab interface for easy navigation between projects,\n- ability to connect to different instances e.g. officially hosted, local for offline work,\n- and more are coming.","name":"Penpot Desktop","packageUrl":"https://github.com/author-more/penpot-desktop","publisher":"Author More","publisherUrl":"https://authormore.com/","releaseNotesUrl":"https://github.com/author-more/penpot-desktop/releases/tag/v1.0.1","tags":["build","design","diagram","flow","flowchart","interface","mockup","present","prototype","slides","specification","ui","user-experience","user-interface","ux","wireframe"]},"zh-CN":{"description":"开源设计工具 Penpot 的桌面应用程序","locale":"zh-CN","longDescription":"Penpot Desktop 是开源设计工具 Penpot 的非官方桌面应用程序。\n它可以让您访问 Penpot 浏览器版本的功能，并获得桌面应用程序的体验。它具有\n- 系统级应用体验，如专用窗口、文件扩展名关联；\n- 多功能暗光模式设置；\n- 标签界面，便于在项目间导航；\n- 能够连接到不同的实例，如官方托管实例和本地离线工作实例；\n- 以及更多即将推出的功能。","releaseNotesUrl":"https://github.com/author-more/penpot-desktop/releases/tag/v1.0.1","tags":["人机交互","原型","图表","模型","流程","流程图","用户界面","界面","线框图","规格","设计"]}},"longDescription":"Penpot Desktop is an unofficial desktop application for the open-source design tool, Penpot.\nIt provides you with access to the functionality of the browser version of Penpot with an experience of a desktop application. It comes with\n- system-level application experience e.g. a dedicated window, file extension association,\n- versatile dark-light mode setup,\n- tab interface for easy navigation between projects,\n- ability to connect to different instances e.g. officially hosted, local for offline work,\n- and more are coming.","name":"Penpot Desktop","packageUrl":"https://github.com/author-more/penpot-desktop","publisher":"Author More","publisherUrl":"https://authormore.com/","releaseNotesUrl":"https://github.com/author-more/penpot-desktop/releases/tag/v1.0.1","tags":["build","design","diagram","flow","flowchart","interface","mockup","present","prototype","slides","specification","ui","user-experience","user-interface","ux","wireframe"]},"schemaVersion":1,"source":"winget","versions":[{"architectures":["arm64","x64"],"detailPath":"versions/1.0.1/app.json","detailSha256":"65689345c8a9577b7cfa3bb83af04ea91f31c34c99019049e0dc0fe5641443b9","releaseDate":"2026-11-01","releaseDateSource":"manifest","version":"1.0.1"},{"architectures":["arm64","x64"],"detailPath":"versions/1.0.0/app.json","detailSha256":"d0c8dde90e9fcad2d5ab8829b0a2412ca009a59a42f6ef8d833f1d63c8da642e","releaseDate":"2026-09-30","releaseDateSource":"manifest","version":"1.0.0"},{"architectures":["arm64","x64"],"detailPath":"versions/0.25.0/app.json","detailSha256":"7442ab285578db984d9c798b302c0e03830650d39c4a074cc85ed8282d6bc68a","releaseDate":"2026-09-10","releaseDateSource":"manifest","version":"0.25.0"},{"architectures":["arm64","x64"],"detailPath":"versions/0.24.0/app.json","detailSha256":"4539565627154beae5c9aac1fdb64607abdb456f3da9fb89625bbb95e38c3ad