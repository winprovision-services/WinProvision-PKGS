满足电气行业专业人士在不断变化的市场中的需求。\ne-Design 让电气系统的设计成为可能，通过直观、简单的功能来访问可以协同使用的产品套件，最大限度地优化了生产时间。\n该套件外观新颖，极具吸引力，同时对 ABB 软件一贯的功能进行了全面优化，使其成为与当前行业技术同步的创新工具。","publisherUrl":"https://new.abb.com/cn","tags":[]}},"publisherUrl":"https://global.abb/","releaseDate":"2025-10-17","releaseDateSource":"manifest","releaseNotesUrl":"https://search.abb.com/library/Download.aspx?DocumentID=9AKK106103A4633&LanguageCode=en&Action=Launch","schemaVersion":1,"source":"winget","upstream":{"commit":"97d6aa2689f0a05f7847653a62b8624720d15b5d","manifestVersion":"1.10.0","manifests":[{"path":"manifests/a/ABB/e-Design/1.15.0.0007/ABB.e-Design.yaml","sha256":"a8603c607ef968807010b37e0b871b6bb74be1653a515be1c48abfd7815adc3f"},{"path":"manifests/a/ABB/e-Design/1.15.0.0007/ABB.e-Design.installer.yaml","sha256":"a7f9128a30674bee6692320e025ac34fba7a1b839edb7cca6d21efdc476bbc16"},{"path":"manifests/a/ABB/e-Design/1.15.0.0007/ABB.e-Design.locale.en-US.yaml","sha256":"bd7fc612fea23a099498e1b0619de236100b514b2163fd4408cbb4f6804372fc"},{"path":"manifests/a/ABB/e-Design/1.15.0.0007/ABB.e-Design.locale.zh-CN.yaml","sha256":"d66a7db6d2f721de8cdff388edfc15dcaa874048a1f8c23b0e96323d66eb352e"}],"repository":"microsoft/winget-pkgs"},"version":"1.15.0.0007"}