满足电气行业专业人士在不断变化的市场中的需求。\ne-Design 让电气系统的设计成为可能，通过直观、简单的功能来访问可以协同使用的产品套件，最大限度地优化了生产时间。\n该套件外观新颖，极具吸引力，同时对 ABB 软件一贯的功能进行了全面优化，使其成为与当前行业技术同步的创新工具。","publisherUrl":"https://new.abb.com/cn","tags":[]}},"publisherUrl":"https://global.abb/","releaseDate":"2026-02-17","releaseDateSource":"manifest","releaseNotesUrl":"https://search.abb.com/library/Download.aspx?DocumentID=9AKK106103A4633&LanguageCode=en&Action=Launch","schemaVersion":1,"source":"winget","upstream":{"commit":"97d6aa2689f0a05f7847653a62b8624720d15b5d","manifestVersion":"1.12.0","manifests":[{"path":"manifests/a/ABB/e-Design/1.15.0.0009/ABB.e-Design.yaml","sha256":"8fac92e39824d83c76b6bf5316cc59d24424507ebbbeabce30e012e12a0727ce"},{"path":"manifests/a/ABB/e-Design/1.15.0.0009/ABB.e-Design.installer.yaml","sha256":"697d2ea931352cef4ea4c9f212e2b300f3c03487b7bf2c3c2e820a32fd2e483d"},{"path":"manifests/a/ABB/e-Design/1.15.0.0009/ABB.e-Design.locale.en-US.yaml","sha256":"557295d0541c5f1dba6fc6555d97cb6958de6129401539f292fef92cc1554fe6"},{"path":"manifests/a/ABB/e-Design/1.15.0.0009/ABB.e-Design.locale.zh-CN.yaml","sha256":"d05a38accdca57817b67b644a402d2e8944de543bf7c3f0d4e3f7ad4e7959842"}],"repository":"microsoft/winget-pkgs"},"version":"1.15.0.0009"}