sive /V/norestart"},"priority":1,"scope":"machine","sha256":"df911e882ebc4c00eff08dcc944e617d827e7237593e2620e1fc0792169777b4","silent":{"arguments":"/S /V/quiet /V/norestart","source":"manifest"},"successCodes":[],"type":"exe","uninstall":{"type":"productCode","value":"{5B48D20E-9BAD-4798-902E-501E719F27F2}"},"url":"https://d1kpmuwb7gvu1i.cloudfront.net/AccessData_Registry_Viewer_2.0.0.exe"}],"licenseUrl":"https://www.exterro.com/website-terms-of-use","packageLocalizations":{"en-US":{"description":"Free Windows forensic registry viewer that lets you view the contents of Windows operating system registries.","license":"Proprietary","licenseUrl":"https://www.exterro.com/website-terms-of-use","locale":"en-US","longDescription":"AccessData Registry Viewer lets you view the contents of Windows operating system registries. Unlike the Windows Registry Editor, which can only display the current computer's registry, Registry Viewer lets you view registry files from any computer. It provides access to a registry's protected storage, which can contain passwords, usernames, and other information not accessible in Windows Registry Editor. The Full Registry view shows all contents of a registry file, the Common Areas view displays the sections most likely to contain significant data, and the Report view prints only the keys you select. Compatible with 64-bit Windows 10, 11, and Server 2016/2019/2022.","name":"AccessData Registry Viewer","packageUrl":"https://www.exterro.com/ftk-downloads/registry-viewer-2-0-0","publisher":"AccessData","publisherUrl":"https://www.exterro.com/","releaseNotesUrl":"https://d1kpmuwb7gvu1i.cloudfront.net/RegistryViewer/RegistryViewer_2.0.0._RN.pdf","tags":["analysis","registry","viewer"]},"zh-CN":{"description":"免费的 Windows 取证注册表查看器，可查看 Windows 操作系统注册表的内容。","locale":"zh-CN","longDescription":"AccessData Registry Viewer 可以查看 Windows 操作系统注册表的内容。与只能显示当前计算机注册表的 Windows 注册表编辑器不同，Registry Viewer 可以查看任何计算机的注册表文件。它可以访问注册表的受保护存储区，其中可能包含 Windows 注册表编辑器中无法访问的密码、用户名和其他信息。完整注册表视图显示注册表文件的全部内容，常见区域视图显示最可能包含重要数据的部分，报告视图只打印你选择的项。兼容 64 位 Windows 10、11 与 Server 2016/2019/2022。","releaseNotesUrl":"https://d1kpmuwb7gvu1i.cloudfront.net/RegistryViewer/RegistryViewer_2.0.0._RN.pdf","tags":["取证","查看器","注册表"]}},"publisherUrl":"https://www.exterro.com/","releaseDate":"2017-11-21","releaseDateSource":"manifest","releaseNotesUrl":"https://d1kpmuwb7gvu1i.cloudfront.net/RegistryViewer/RegistryViewer_2.0.0._RN.pdf","schemaVersion":1,"source":"winget","upstream":{"commit":"97d6aa2689f0a05f7847653a62b8624720d15b5d","manifestVersion":"1.12.0","manifests":[{"path":"manifests/a/AccessData/RegistryViewer/2.0.0.7/AccessData.RegistryViewer.yaml","sha256":"0c756c5fa912a68649c54ba27cde9d540da70de3b5d085fbb848d5239edbac9b"},{"path":"manifests/a/AccessData/RegistryViewer/2.0.0.7/AccessData.RegistryViewer.installer.yaml","sha256":"bcfecd766cb3f12ce03d0305e49297664d2b5bc2af133075d4051ef950b6ed18"},{"path":"manifests/a/AccessData/RegistryViewer/2.0.0.7/AccessData.RegistryViewer.locale.en-US.yaml","sha256":"f332da52af89184a37b5d88b64202a1ca18eaf84ab5b5f75ffe60328385e90ac"},{"path":"manifests/a/AccessData/RegistryViewer/2.0.0.7/AccessData.RegistryViewer.locale.zh-CN.yaml","sha256":"5521950599204088dd0842215375900ce994cffde44688729960c16bcd86eb04"}],"repository":"microsoft/winget-pkgs"},"version":"2.0.0.7"}