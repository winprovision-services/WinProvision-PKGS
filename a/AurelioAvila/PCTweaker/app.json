{"architectures":["x64"],"id":"AurelioAvila.PCTweaker","latestVersion":"1.20.1","media":{"icons":[],"screenshots":[]},"package":{"description":"Inspect Windows settings, audio diagnostics and scan findings, with recorded changes and restore tools for supported settings.","license":"Proprietary","licenseUrl":"https://github.com/AurelioAvila/pc-tweaker-app/blob/HEAD/LICENSE","locale":"en-US","localizations":{"en-US":{"description":"Inspect Windows settings, audio diagnostics and scan findings, with recorded changes and restore tools for supported settings.","license":"Proprietary","licenseUrl":"https://github.com/AurelioAvila/pc-tweaker-app/blob/HEAD/LICENSE","locale":"en-US","longDescription":"PC Tweaker brings Windows tuning, audio diagnostics, privacy and maintenance into one review workflow for Windows 10/11 x64. Inspect scan findings and a control's trade-offs before choosing a supported change.\n\nThe Audio section shows device formats, effects, spatial sound and Equalizer APO status, with findings such as a Bluetooth headset in call mode or a muted microphone. Hardware information and driver DPC/ISR traces help investigate a specific workload. Change history records previous values for supported restoration.\n\nThe current catalog has 84 controls: 48 Free and 36 Pro. Free requires no account or card; optional paid plans add advanced tools. Features depend on Windows, hardware and drivers. Cleanup, repair and driver operations have separate recovery limits, and no FPS increase or lower latency is guaranteed. PC Tweaker is proprietary/freemium.","name":"PC Tweaker","packageUrl":"https://pctweaker.app/","publisher":"Aurelio Avila","publisherUrl":"https://github.com/AurelioAvila","releaseNotesUrl":"https://github.com/AurelioAvila/pc-tweaker-app/releases/tag/v1.20.1","tags":["gaming","optimizer","performance","privacy","tweak","windows","windows-10","windows-11","audio-diagnostics","dpc-latency","hardware-monitoring","maintenance"]}},"longDescription":"PC Tweaker brings Windows tuning, audio diagnostics, privacy and maintenance into one review workflow for Windows 10/11 x64. Inspect scan findings and a control's trade-offs before choosing a supported change.\n\nThe Audio section shows device formats, effects, spatial sound and Equalizer APO status, with findings such as a Bluetooth headset in call mode or a muted microphone. Hardware information and driver DPC/ISR traces help investigate a specific workload. Change history records previous values for supported restoration.\n\nThe current catalog has 84 controls: 48 Free and 36 Pro. Free requires no account or card; optional paid plans add advanced tools. Features depend on Windows, hardware and drivers. Cleanup, repair and driver operations have separate recovery limits, and no FPS increase or lower latency is guaranteed. PC Tweaker is proprietary/freemium.","name":"PC Tweaker","packageUrl":"https://pctweaker.app/","publisher":"Aurelio Avila","publisherUrl":"https://github.com/AurelioAvila","releaseNotesUrl":"https://github.com/AurelioAvila/pc-tweaker-app/releases/tag/v1.20.1","tags":["gaming","optimizer","performance","privacy","tweak","windows","windows-10","windows-11","audio-diagnostics","dpc-latency","hardware-monitoring","maintenance"]},"schemaVersion":1,"source":"winget","versions":[{"architectures":["x64"],"detailPath":"versions/1.20.1/app.json","detailSha256":"1ee5468e036149b2fe48d9cc46b92c8896f5176fe109ade7f0b4186a9606b948","releaseDate":"2026-11-04","releaseDateSource":"manifest","version":"1.20.1"},{"architectures":["x64"],"detailPath":"versions/1.20.0/app.json","detailSha256":"2c817f76da7cd05717e20c7951019a3bce11a3a301ddfb169a792ef5bc5adee2","releaseDate":"2026-11-03","releaseDateSource":"manifest","version":"1.20.0"},{"architectures":["x64"],"detailPath":"versions/1.19.0/app.json","detailSha256":"f33c5aee355aac7ede1270be7556a1ae8f7be00f7ffda7eb5541a4526c279e09","releaseDate":"2026-11-02","releaseDateSource":"manifest","version":"1.19.0"},{"architectures":["x64"],