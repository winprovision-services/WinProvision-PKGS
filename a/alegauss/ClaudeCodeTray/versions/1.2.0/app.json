{"defaultLocale":"en-US","id":"alegauss.ClaudeCodeTray","installers":[{"appsAndFeaturesEntries":[{"DisplayName":"Claude Code Tray","DisplayVersion":"1.2.0","InstallerType":"inno","ProductCode":"{8F3C2A14-7B6D-4E9A-9C21-CLAUDETRAY001}_is1","Publisher":"Alexandre Oliveira"}],"architecture":"x64","dependencies":[],"id":"x64-user-inno","installModes":["interactive","silent","silentWithProgress"],"priority":1,"scope":"user","sha256":"0b9c516038ed574c036c6cb4b5ff679f3ab31ea5adf1ea4d06d5e10bdd86f289","silent":{"arguments":"/VERYSILENT /SUPPRESSMSGBOXES /NORESTART /SP-","source":"default"},"successCodes":[],"type":"inno","upgradeBehavior":"install","url":"https://github.com/alegauss/claude-tray/releases/download/v1.2.0/ClaudeTray-Setup.exe"}],"licenseUrl":"https://github.com/alegauss/claude-tray/blob/main/LICENSE","packageLocalizations":{"en-US":{"description":"Unofficial native Windows tray monitor for Claude Code usage — shows your rate-limit %, projects when you'll run out, and turns the icon red before you hit the limit.","license":"Apache-2.0","licenseUrl":"https://github.com/alegauss/claude-tray/blob/main/LICENSE","locale":"en-US","longDescription":"Claude Code Tray is an unofficial, community-built Windows system-tray monitor for your Claude Code rate-limit usage. It draws a crisp, DPI-aware icon showing the current usage percentage, tracks your burn rate to project when you'll hit 100%, and turns the icon red when you're on pace to run out before the window resets. A right-click submenu shows a local 24h usage breakdown (from subagents, large-context share, and a by-model split) computed from your own Claude Code session transcripts — no extra API calls. It reuses the OAuth token Claude Code already stores, so there is nothing to configure.","moniker":"claude-tray","name":"Claude Code Tray (unofficial)","packageUrl":"https://github.com/alegauss/claude-tray","publisher":"Alexandre Oliveira","publisherUrl":"https://github.com/alegauss","releaseNotesUrl":"https://githu