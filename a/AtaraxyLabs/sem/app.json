{"architectures":["x64"],"id":"AtaraxyLabs.sem","latestVersion":"0.29.1","media":{"icons":[],"screenshots":[]},"package":{"copyright":"Copyright (c) 2025 Ataraxy Labs","copyrightUrl":"https://github.com/Ataraxy-Labs/sem/blob/main/LICENSE-MIT","description":"Semantic version control built on Git.","license":"MIT or Apache-2.0","licenseUrl":"https://github.com/Ataraxy-Labs/sem/blob/main/README.md#license","locale":"en-US","localizations":{"en-US":{"copyright":"Copyright (c) 2025 Ataraxy Labs","copyrightUrl":"https://github.com/Ataraxy-Labs/sem/blob/main/LICENSE-MIT","description":"Semantic version control built on Git.","license":"MIT or Apache-2.0","licenseUrl":"https://github.com/Ataraxy-Labs/sem/blob/main/README.md#license","locale":"en-US","longDescription":"Semantic version control => entity-level diffs, blame, and impact analysis on top of git. 26\nlanguages via tree-sitter. Built for coding agents.\n\nInstead of lines changed, sem tells you what entities changed: functions, methods, classes.\n\nsem is a semantic version control tool that works on top of Git. It parses your code with\ntree-sitter, extracts every function, class, and method as an entity, and diffs at the entity level\ninstead of lines. This means you see \"function blahh was modified\" instead of \"lines x-y changed.\"\n\nIt works in any Git repo with no setup.","name":"sem","packageUrl":"https://github.com/Ataraxy-Labs/sem","publisher":"Ataraxy Labs Inc.","publisherSupportUrl":"https://github.com/Ataraxy-Labs/sem/issues","publisherUrl":"https://github.com/Ataraxy-Labs","releaseNotesUrl":"https://github.com/Ataraxy-Labs/sem/releases/tag/v0.29.1","tags":["ai-agents","code-intelligence","coding-agents","developer-tools","git","llm-tools","semantic-diff","tree-sitter","typescript","version-control"]}},"longDescription":"Semantic version control => entity-level diffs, blame, and impact analysis on top of git. 26\nlanguages via tree-sitter. Built for coding agents.\n\nInstead of lines changed, sem tells you what entities changed: functions, methods, classes.\n\nsem is a semantic version control tool that works on top of Git. It parses your code with\ntree-sitter, extracts every function, class, and method as an entity, and diffs at the entity level\ninstead of lines. This means you see \"function blahh was modified\" instead of \"lines x-y changed.\"\n\nIt works in any Git repo with no setup.","name":"sem","packageUrl":"https://github.com/Ataraxy-Labs/sem","publisher":"Ataraxy Labs Inc.","publisherSupportUrl":"https://github.com/Ataraxy-Labs/sem/issues","publisherUrl":"https://github.com/Ataraxy-Labs","releaseNotesUrl":"https://github.com/Ataraxy-Labs/sem/releases/tag/v0.29.1","tags":["ai-agents","code-intelligence","coding-agents","developer-tools","git","llm-tools","semantic-diff","tree-sitter","typescript","version-control"]},"schemaVersion":1,"source":"winget","versions":[{"architectures":["x64"],"detailPath":"versions/0.29.1/app.json","detailSha256":"49c470d48d5a6be493dff23813bcc1c1333e90cc8d1747c7f9c866b4a38fe280","releaseDate":"2026-11-10","releaseDateSource":"commit","version":"0.29.1"},{"architectures":["x64"],"detailPath":"versions/0.29.0/app.json","detailSha256":"6fb8cf6b9573d42bac22faa105fc470d89e5bf2468c006d6630f58acdc091050","releaseDate":"2026-10-30","releaseDateSource":"manifest","version":"0.29.0"},{"architectures":["x64"],"detailPath":"versions/0.28.2/app.json","detailSha256":"1478086bf3a4ea953382fc257dfdfce8facbb07a7e87639876837b540e76f92a","releaseDate":"2026-10-26","releaseDateSource":"manifest","version":"0.28.2"},{"architectures":["x64"],"detailPath":"versions/0.28.1/app.json","detailSha256":"cd01d383a8d4454f7d172c78ffc88de15837bacfe45d491d0b47209abde07522","releaseDate":"2026-10-19","releaseDateSource":"manifest","version":"0.28.1"},{"architectures":["x64"],"detailPath":"versions/0.27.0/app.json","detailSha256":"1ee37a0f82aa7285c3f49802bffbcb4cab6389dc2e4c9f1ee5e1c63ed8d3facc","releaseDate":"2026-10-04","releaseDateSource":"manifest","ver