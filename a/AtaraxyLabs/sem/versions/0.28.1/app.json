{"defaultLocale":"en-US","id":"AtaraxyLabs.sem","installers":[{"architecture":"x64","dependencies":[{"PackageDependencies":[{"PackageIdentifier":"Microsoft.VCRedist.2015+.x64"}]}],"id":"x64-zip","installModes":["silent"],"nestedInstallerFiles":[{"PortableCommandAlias":"sem.exe","RelativeFilePath":"sem.exe"}],"nestedInstallerType":"portable","priority":4,"sha256":"83be71ef7d9765672ef976ba653517ee4a670765019df7e5b527658e1daf0f66","successCodes":[],"type":"zip","upgradeBehavior":"uninstallPrevious","url":"https://github.com/Ataraxy-Labs/sem/releases/download/v0.28.1/sem-windows-x86_64.zip"}],"licenseUrl":"https://github.com/Ataraxy-Labs/sem/blob/main/README.md#license","packageLocalizations":{"en-US":{"description":"Semantic version control built on Git.","license":"MIT or Apache-2.0","licenseUrl":"https://github.com/Ataraxy-Labs/sem/blob/main/README.md#license","locale":"en-US","longDescription":"Semantic version control => entity-level diffs, blame, and impact analysis on top of git. 26\nlanguages via tree-sitter. Built for coding agents.\n\nInstead of lines changed, sem tells you what entities changed: functions, methods, classes.\n\nsem is a semantic version control tool that works on top of Git. It parses your code with\ntree-sitter, extracts every function, class, and method as an entity, and diffs at the entity level\ninstead of lines. This means you see \"function blahh was modified\" instead of \"lines x-y changed.\"\n\nIt works in any Git repo with no setup.","name":"sem","packageUrl":"https://github.com/Ataraxy-Labs/sem","publisher":"Ataraxy Labs Inc.","publisherUrl":"https://github.com/Ataraxy-Labs","releaseNotesUrl":"https://github.com/Ataraxy-Labs/sem/releases/tag/v0.28.1","tags":["ai-agents","code-intelligence","coding-agents","developer-tools","git","llm-tools","semantic-diff","tree-sitter","typescript","version-control"]}},"publisherUrl":"https://github.com/Ataraxy-Labs","releaseDate":"2026-10-19","releaseDateSource":"manifest","releaseNotesUrl":"https