{"defaultLocale":"en-US","id":"agavra.tuicr","installers":[{"architecture":"x64","dependencies":[{"PackageDependencies":[{"PackageIdentifier":"Microsoft.VCRedist.2015+.x64"}]}],"id":"x64-zip","nestedInstallerFiles":[{"PortableCommandAlias":"tuicr","RelativeFilePath":"tuicr.exe"}],"nestedInstallerType":"portable","priority":4,"sha256":"c1d68e051b2fdbed1cf0c641bcb1b26f63ef7b9b2ce38d23035a2dd8c616819c","successCodes":[],"type":"zip","url":"https://github.com/agavra/tuicr/releases/download/v0.27.0/tuicr-0.27.0-x86_64-pc-windows-msvc.zip"}],"licenseUrl":"https://github.com/agavra/tuicr/blob/HEAD/LICENSE","packageLocalizations":{"en-US":{"description":"A code review TUI with vim keybindings. Export to GitHub, GitLab, Bitbucket, or clipboard.","license":"MIT","licenseUrl":"https://github.com/agavra/tuicr/blob/HEAD/LICENSE","locale":"en-US","longDescription":"tuicr is a terminal code review tool with vim keybindings. It shows a GitHub-style continuous diff\nso you can scroll through every changed file in one stream, and supports pull request style comments\nat the line, range, file, and review level. Review progress is tracked at file or hunk granularity and\npersisted across sessions. Finished reviews can be pushed to GitHub, GitLab, or Bitbucket, copied to\nthe clipboard as structured markdown, or piped to stdout. It works with git, jj, and mercurial, and can\nreview uncommitted changes, commit ranges, or an existing GitHub PR, GitLab MR, or Bitbucket PR.","moniker":"tuicr","name":"tuicr","packageUrl":"https://tuicr.dev/","publisher":"Almog Gavra","publisherUrl":"https://github.com/agavra","releaseNotesUrl":"https://github.com/agavra/tuicr/releases/tag/v0.27.0","tags":["cli","code-review","diff","git","review","rust","terminal","tui","vim"]}},"publisherUrl":"https://github.com/agavra","releaseDate":"2026-09-23","releaseDateSource":"manifest","releaseNotesUrl":"https://github.com/agavra/tuicr/releases/tag/v0.27.0","schemaVersion":1,"source":"winget","upstream":{"commit":"9