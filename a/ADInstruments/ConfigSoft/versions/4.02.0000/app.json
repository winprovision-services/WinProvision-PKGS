eturnResponse":"systemNotSupported"},{"InstallerReturnCode":3010,"ReturnResponse":"rebootRequiredToFinish"}],"id":"x86-machine-zip","installModes":["interactive","silent","silentWithProgress"],"installerSwitches":{"InstallLocation":"/V\"INSTALLDIR=\"\"<INSTALLPATH>\"\"\"","Log":"/V\"/log \"\"<LOGPATH>\"\"\"","Silent":"/S /V/quiet /V/norestart","SilentWithProgress":"/S /V/passive /V/norestart"},"nestedInstallerFiles":[{"RelativeFilePath":"ConfigSoft 32bit\\setup.exe"}],"nestedInstallerType":"exe","priority":4,"scope":"machine","sha256":"02161a6c349ca7954a4cafcf953fef7515e3922c907fd01f0b1127f95d2062e9","silent":{"arguments":"/S /V/quiet /V/norestart","source":"manifest"},"successCodes":[],"type":"zip","uninstall":{"type":"productCode","value":"{FDAAFA83-8EAC-45B1-BB3C-E74ADB0ED27E}"},"url":"https://cdn.adinstruments.com/Installers/win/ConfigSoft%20V4.2.0.zip"}],"packageLocalizations":{"en-US":{"description":"ConfigSoft telemetry software is part of the Configurator System for wirelessly controlling and configuring telemeters, SmartPads and tBases.","license":"Proprietary","locale":"en-US","longDescription":"ConfigSoft telemetry software is part of the Configurator System, which is used to wirelessly control and configure telemeters, SmartPads and tBases. Using ConfigSoft allows 100% control of the telemeters and SmartPad and/or tBases and therefore reduces handling of the animals and associated stress, it is all done through the software. The software also collects and outputs telemeter, SmartPad and tBase diagnostic information and manages their settings. The channel numbers of the Kaha Sciences Telemetry system tell the components (telemeters, SmartPads and Configurator) which frequencies to communicate on.\nConfigSoft also allows you to select from up to 40 independent transmission or receiving channels, this ensures these no crossovers, data loss, or interference between different telemeters and receivers.","name":"ConfigSoft","publisher":"KahaTelemetry","tags":["kaha"]},"zh-CN":{"description":"ConfigSoft 遥测软件是 Configurator 系统的组成部分，用于无线控制和配置遥测仪、SmartPads 及 tBases 设备。","license":"专有软件","locale":"zh-CN","longDescription":"ConfigSoft 遥测软件是 Configurator 系统的组成部分，用于无线控制和配置遥测仪、SmartPads 及 tBases 设备。通过 ConfigSoft 可实现 100% 远程操控遥测仪、SmartPad 和/或 tBases，从而减少对实验动物的直接操作及相关应激反应，所有操作均可通过软件完成。该软件还能收集并输出遥测仪、SmartPad 和 tBase 的诊断信息，并管理其参数设置。Kaha Sciences 遥测系统中的频道编号用于指示各组件（遥测仪、SmartPads 和 Configurator）进行通信的工作频率。\nConfigSoft 支持从多达 40 个独立传输/接收频道中进行选择，这一功能可确保不同遥测仪与接收器之间不会出现信号串扰、数据丢失或相互干扰现象。","tags":[]}},"schemaVersion":1,"source":"winget","upstream":{"commit":"97d6aa2689f0a05f7847653a62b8624720d15b5d","manifestVersion":"1.10.0","manifests":[{"path":"manifests/a/ADInstruments/ConfigSoft/4.02.0000/ADInstruments.ConfigSoft.yaml","sha256":"e508961e377a3addbabae413f0ada0c3bfddeeb5ce0e94b91c4d10c6b48a1cac"},{"path":"manifests/a/ADInstruments/ConfigSoft/4.02.0000/ADInstruments.ConfigSoft.installer.yaml","sha256":"fcd46a5266dd71c9b212c3380c97ee6321e5ce045a459372da4652dacb38de23"},{"path":"manifests/a/ADInstruments/ConfigSoft/4.02.0000/ADInstruments.ConfigSoft.locale.en-US.yaml","sha256":"1b6a9cdcd9db934bca56ef224fba54006a2edb74c8c2942686dede31e1e8c348"},{"path":"manifests/a/ADInstruments/ConfigSoft/4.02.0000/ADInstruments.ConfigSoft.locale.zh-CN.yaml","sha256":"23971c7f52d0c3599acc5c1ea965104ddfd5f561b8752a29b56db6d8e1b45545"}],"repository":"microsoft/winget-pkgs"},"version":"4.02.0000"}