{"defaultLocale":"en-US","id":"ADInstruments.LabChart.DeviceEnabler.WiiBalanceBoard","installers":[{"appsAndFeaturesEntries":[{"UpgradeCode":"{BC916C5B-9444-40DC-89E5-C20A976A9A72}"}],"architecture":"x86","dependencies":[{"PackageDependencies":[{"MinimumVersion":"8","PackageIdentifier":"ADInstruments.LabChart"}]}],"elevation":{"requirement":"elevationRequired","source":"inferred"},"id":"x86-machine-msi","installerSwitches":{"InstallLocation":"DIR_LABCHART=\"<INSTALLPATH>\""},"priority":2,"scope":"machine","sha256":"a1fb85e477484a2cafd01450abf5d4d642f8304426101f639fe93d3f171a2e23","silent":{"arguments":"/quiet /norestart","source":"default"},"successCodes":[],"type":"msi","uninstall":{"type":"productCode","value":"{E943D573-3F15-45D5-87F7-EE06A63C02D7}"},"url":"https://cdn.adinstruments.com/Installers/win/WiiBalanceBoard_v1.1.msi"}],"packageLocalizations":{"en-US":{"description":"The Wii Balance Board Device Enabler for LabChart facilitates communication between a Nintendo Wii Balance Board and LabChart over a wireless Bluetooth connection.","license":"Proprietary","locale":"en-US","longDescription":"The Wii Balance Board Device Enabler for LabChart facilitates communication between a Nintendo Wii Balance Board and LabChart over a wireless Bluetooth connection. Data from four load sensors within the board can be streamed into LabChart with each sensor's data mapped to a separate LabChart channel. Combining channel data in LabChart allows for measurements such as a person's weight or center of balance.","name":"ADInstruments Wii Balance Board","publisher":"ADInstruments","tags":[]},"zh-CN":{"description":"Wii 平衡板设备启用器（LabChart 专用）实现了任天堂 Wii 平衡板与 LabChart 软件间的无线蓝牙通信。","license":"专有软件","locale":"zh-CN","longDescription":"Wii 平衡板设备启用器（LabChart 专用）实现了任天堂 Wii 平衡板与 LabChart 软件间的无线蓝牙通信。该平衡板内置的四个压力传感器数据可实时传输至 LabChart，每个传感器的读数均对应独立的软件通道。通过整合多通道数据，LabChart 可进行人体重量测量及重心平衡分析等计算。","tags":[]}},"releaseDate":"2013-11-15","releaseDateSource":"manifest","schemaVersion":1,"source":"wi