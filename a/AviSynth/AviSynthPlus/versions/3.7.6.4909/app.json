pl.txt","locale":"zh-CN","longDescription":"AviSynth+ 是著名的帧服务器的一个分支，但其社区贡献直到现在都在避免包含主线。为了能够促进 AviSynth 现代化以满足当今的需求和期望，该项目鼓励每个人帮助实现我们的目标：添加一直寻求的特性，为社区注入活力，并提高开发者和用户的友好性。AviSynth+ 与为 AviSynth 编写的插件和脚本完全兼容。","name":"AviSynth+","packageUrl":"https://avs-plus.net/","publisher":"The Public","publisherSupportUrl":"https://github.com/AviSynth/AviSynthPlus/issues","publisherUrl":"https://avs-plus.net/","releaseNotesUrl":"https://github.com/AviSynth/AviSynthPlus/releases/tag/v3.7.6","tags":["avisynth","avs","avs+","帧服务器"]}},"publisherSupportUrl":"https://github.com/AviSynth/AviSynthPlus/issues","publisherUrl":"https://avs-plus.net/","releaseDate":"2026-11-05","releaseDateSource":"commit","releaseNotesUrl":"https://github.com/AviSynth/AviSynthPlus/releases/tag/v3.7.6","schemaVersion":1,"source":"winget","upstream":{"commit":"a4a78ef7dd5a1ec000e60392173b33bed55f7cbb","manifestVersion":"1.28.0","manifests":[{"path":"manifests/a/AviSynth/AviSynthPlus/3.7.6.4909/AviSynth.AviSynthPlus.installer.yaml","sha256":"e6d07fea8823ae630747f13ee9bc6543c932ba8ede070650714d0356eb53ecd4"},{"path":"manifests/a/AviSynth/AviSynthPlus/3.7.6.4909/AviSynth.AviSynthPlus.locale.en-US.yaml","sha256":"bdb66d34f9f01f823a0eae7231125fe1311eb230fefc4ceb2a720e81b0476469"},{"path":"manifests/a/AviSynth/AviSynthPlus/3.7.6.4909/AviSynth.AviSynthPlus.locale.zh-CN.yaml","sha256":"8072df9ee56981ed129eebca5c5354cb6456fd2aa52d621799c067f06db53439"},{"path":"manifests/a/AviSynth/AviSynthPlus/3.7.6.4909/AviSynth.AviSynthPlus.yaml","sha256":"47730e3565b3221f1461a30b088a0da328832b09afc864b7fef24649e5ef6366"}],"repository":"microsoft/winget-pkgs"},"version":"3.7.6.4909"}