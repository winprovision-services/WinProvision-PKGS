{"defaultLocale":"en-US","id":"amys94fr.Snap2Link","installers":[{"architecture":"x64","dependencies":[],"id":"x64-user-nullsoft","installModes":["interactive","silent","silentWithProgress"],"installerSwitches":{"Silent":"/S","SilentWithProgress":"/S"},"priority":1,"scope":"user","sha256":"9b31c1abe68e4c5e856b254b36356ae6215ab4e0183a07ba5433286c4e701674","silent":{"arguments":"/S","source":"manifest"},"successCodes":[],"type":"nullsoft","upgradeBehavior":"install","url":"https://github.com/amys94fr/Snap2Link/releases/download/v1.5.0/Snap2Link_1.5.0_x64-setup.exe"}],"licenseUrl":"https://github.com/amys94fr/Snap2Link/blob/main/LICENSE","packageLocalizations":{"en-US":{"description":"Capture a screen region and instantly get a Google Drive share link.","license":"MIT","licenseUrl":"https://github.com/amys94fr/Snap2Link/blob/main/LICENSE","locale":"en-US","longDescription":"Snap2Link is a tray-resident screenshot tool for Windows. Press the\nconfigurable global hotkey (default Ctrl+PrintScreen), drag a rectangle,\nand a public Google Drive share link is automatically copied to your\nclipboard.\n\nFeatures:\n- Region selection overlay with live size readout\n- One-click upload to your own Google Drive (OAuth, no third-party server)\n- Configurable global hotkey\n- Auto-cleanup of old screenshots (configurable retention)\n- Optional \"Start with Windows\"\n- Built-in updater (Settings or tray > Check for Updates)\n\nBuilt with Tauri v2 + React/TypeScript. Source code on GitHub.","moniker":"snap2link","name":"Snap2Link","packageUrl":"https://github.com/amys94fr/Snap2Link","publisher":"Steven Abittan","publisherUrl":"https://github.com/amys94fr","releaseNotesUrl":"https://github.com/amys94fr/Snap2Link/releases/tag/v1.5.0","tags":["screenshot","screen-capture","google-drive","productivity","clipboard","tauri"]}},"publisherUrl":"https://github.com/amys94fr","releaseDate":"2026-10-11","releaseDateSource":"manifest","releaseNotesUrl":"https://github.com/amys94fr/Snap2Link/rele