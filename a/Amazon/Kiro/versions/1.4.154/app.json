properties","ps1","psd1","psgi","psm1","py","pyi","r","rb","rhistory","rprofile","rs","rst","rt","sass","scss","sh","shtml","sql","svgz","t","tex","toml","ts","tsx","txt","vb","vue","wxi","wxl","wxs","xaml","xhtml","xml","yaml","yml","zsh"],"id":"arm64-machine-inno","installationMetadata":{"DefaultInstallLocation":"%ProgramFiles%\\Kiro"},"installerSwitches":{"Custom":"/mergetasks=!runcode"},"priority":1,"protocols":["kiro"],"scope":"machine","sha256":"bde63f9377d50f2c865dc8d6b79d879b6ad89f63db11926a4aec2c718b2d6a6a","successCodes":[],"type":"inno","uninstall":{"type":"registryKey","value":"{CF58DB1E-C697-42DB-9C64-722B37182E61}_is1"},"upgradeBehavior":"install","url":"https://prod.download.desktop.kiro.dev/releases/stable/win32-arm64/signed/1.4.154/kiro-ide-1.4.154-stable-win32-arm64-system.exe"}],"licenseUrl":"https://kiro.dev/license/","packageLocalizations":{"en-US":{"author":"Amazon Web Services, Inc","copyright":"© 2026 Amazon.com, Inc. or its affiliates (collectively, \"Amazon\"). All Rights Reserved.","copyrightUrl":"https://kiro.dev/license/","description":"An agentic IDE that helps you do your best work with features such as specs, steering, and hooks.","documentations":[{"DocumentLabel":"Docs","DocumentUrl":"https://kiro.dev/docs/index"},{"DocumentLabel":"FAQ","DocumentUrl":"https://kiro.dev/faq/"}],"license":"Proprietary","licenseUrl":"https://kiro.dev/license/","locale":"en-US","longDescription":"Kiro is an agentic IDE that helps you go from prototype to production with spec-driven development. From simple to complex tasks, Kiro works alongside you to turn prompts into detailed specs, then into working code, docs, and tests—so what you build is exactly what you want and ready to share with your team. Kiro's agents help you solve challenging problems and automate tasks like generating documentation and unit tests. With Kiro, you can build beyond prototypes while being in the driver's seat every step of the way.","name":"Kiro","packageUrl":"https://kiro.dev/downloads/","privacyUrl":"https://aws.amazon.com/privacy/","publisher":"Amazon Web Services","publisherSupportUrl":"https://github.com/kirodotdev/Kiro/issues","publisherUrl":"https://kiro.dev/","purchaseUrl":"https://kiro.dev/pricing/","releaseNotes":"Compaction Hooks, Workflow Run Search, and Memory for Sub-Agents\nThis release adds Pre Compaction and Post Compaction Hook triggers, so a Hook can run before or after Kiro compacts a conversation. It also adds search to the Workflow Runs view, compact workflow run cards, web fetches that ask sites for Markdown, and read-only Memory access for sub-agents. It fixes Agent Focus stalling on a window that did not finish connecting, an MCP token refresh outage forcing a new sign-in, and very large sessions that would not open.\nRun a Hook before or after Kiro compacts a conversation\nTwo new triggers in the Hook editor, in the Compaction Hooks group, run a Hook when Kiro compacts a conversation automatically. A Pre Compaction Hook runs before the summary is written and can cancel the compaction by exiting with code 2, with its error output shown as the reason. A Post Compaction Hook runs after the summary replaces the older history, and its output is added to the conversation so the agent keeps what the summary left out. Neither trigger takes a matcher. Learn more ->\nImprovements\n\nFixes","releaseNotesUrl":"https://kiro.dev/changelog/ide/1-4-121/","tags":["code","coding","develop","development","editing","editor","programming"]},"zh-CN":{"description":"一款智能代理 IDE，助您高效工作，具备规范制定、方向引导和钩子功能等特性。","documentations":[{"DocumentLabel":"常见问题","DocumentUrl":"https://kiro.dev/faq/"},{"DocumentLabel":"文档","DocumentUrl":"https://kiro.dev/docs/index"}],"license":"专有软件","locale":"zh-CN","longDescription":"Kiro 是一款智能代理 IDE，通过规范驱动开发帮助您从原型阶段直达生产部署。无论是简单任务还是复杂需求，Kiro 都能将您的指令转化为详细规范，继而生成可运行代码、文档及测试用例——确保最终成果完全符合预期并可直接交付团队使用。其智能代理系统不仅能协助攻克技术难题，还能自动完成文档生成、单元测试等任务。使用 Kiro，您能在全程掌控开发进程的同时，突破原型限制打造真正可落地的产品。","privacyUrl":"https://aws.amazon.com/cn/privacy/","tags":["代码","开发","编程","编辑","编辑器"]}},"publisherSupportUrl":"https://github.com/kirodotdev/Kiro/issues","publisherUrl":"https://kiro.dev/","releaseDate":"2026-11-10","releaseDateSource":"commit","releaseNotesUrl":"https://kiro.dev/changelog/ide/1-4-121/","schemaVersion":1,"source":"winget","upstream":{"commit":"632bf61f1b8aa48414da2bac607c9567bf1814b3","manifestVersion":"1.28.0","manifests":[{"path":"manifests/a/Amazon/Kiro/1.4.154/Amazon.Kiro.installer.yaml","sha256":"d207791bd92317c01412713bf0b4455c438bc8fe88a18148532094c866b69d38"},{"path":"manifests/a/Amazon/Kiro/1.4.154/Amazon.Kiro.locale.en-US.yaml","sha256":"5596562bd89c77e5d1b7e90f1ef6da050a6f1409169b7ef13dca915a4ea95812"},{"path":"manifests/a/Amazon/Kiro/1.4.154/Amazon.Kiro.locale.zh-CN.yaml","sha256":"e17389fbfeabde6e42c91c5374a8f34d10eae2f502844641c0bd9fbb9efd8f38"},{"path":"manifests/a/Amazon/Kiro/1.4.154/Amazon.Kiro.yaml","sha256":"1794a06f25d4ac4659ecfc18fbe9e09f20b4e4234dba067529e7889e663239d6"}],"repository":"microsoft/winget-pkgs"},"version":"1.4.154"}