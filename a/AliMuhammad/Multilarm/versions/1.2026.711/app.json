rcial use; a commercial licence is required for\nany business or institutional deployment.","moniker":"multilarm","name":"Multilarm","packageUrl":"https://multilarm.com/","publisher":"Ali Muhammad","publisherUrl":"https://multilarm.com/","releaseNotesUrl":"https://multilarm.com/downloads.html","tags":["adhan","announcements","audio","bell-scheduler","pa-system","prayer-times","public-address","raspberry-pi","scheduler","school-bell","text-to-speech","tts"]}},"publisherUrl":"https://multilarm.com/","releaseDate":"2026-07-19","releaseDateSource":"manifest","releaseNotesUrl":"https://multilarm.com/downloads.html","schemaVersion":1,"source":"winget","upstream":{"commit":"97d6aa2689f0a05f7847653a62b8624720d15b5d","manifestVersion":"1.6.0","manifests":[{"path":"manifests/a/AliMuhammad/Multilarm/1.2026.711/AliMuhammad.Multilarm.yaml","sha256":"f2f14637e6c34b46ffc15e280a9f13996bd956892612a6a6a5c338929b317008"},{"path":"manifests/a/AliMuhammad/Multilarm/1.2026.711/AliMuhammad.Multilarm.installer.yaml","sha256":"268df946a84415babf88e2921ea7561f75a45bfa1ee426974cd2a71801f11a58"},{"path":"manifests/a/AliMuhammad/Multilarm/1.2026.711/AliMuhammad.Multilarm.locale.en-US.yaml","sha256":"918eb1e41e804de45226d797383e4d22a032e3f1184d17e4bb6c8da5b52d059f"}],"repository":"microsoft/winget-pkgs"},"version":"1.2026.711"}