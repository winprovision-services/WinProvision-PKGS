4 volumes.\nPlug an ext4 SD card or USB stick into Windows and the bundled\nExtFsWatcher service mounts it on a free drive letter in the active\nconsole session via WinFsp; detach and it unmounts cleanly. The\ninstaller also wires a \"Mount as ext4\" right-click verb on .img\nfiles for offline disk-image inspection, and ships a CLI for\nbrowsing without mounting (info, ls, stat, cat, tree, parts, audit).\n\nSetup.exe chains the WinFsp redistributable so end users only run\none installer. Read-write is the default mount mode; pass --ro to\nthe CLI or -ReadOnly to the right-click verb for safe inspection.\n","moniker":"ext4-win-driver","name":"ext4-win-driver","packageUrl":"https://github.com/antimatter-studios/ext4-win-driver","publisher":"Antimatter Studios","publisherUrl":"https://github.com/antimatter-studios","releaseNotesUrl":"https://github.com/antimatter-studios/ext4-win-driver/releases/tag/v0.2.0","tags":["ext4","filesystem","mount","winfsp","linux","sd-card","usb"]}},"publisherUrl":"https://github.com/antimatter-studios","releaseDate":"2026-05-09","releaseDateSource":"manifest","releaseNotesUrl":"https://github.com/antimatter-studios/ext4-win-driver/releases/tag/v0.2.0","schemaVersion":1,"source":"winget","upstream":{"commit":"97d6aa2689f0a05f7847653a62b8624720d15b5d","manifestVersion":"1.12.0","manifests":[{"path":"manifests/a/AntimatterStudios/ext4-win-driver/0.2.0/AntimatterStudios.ext4-win-driver.yaml","sha256":"1eb5d4a2ca60d2a8409b85e64993cc336aaa37765b2191020a48780d08f6a93b"},{"path":"manifests/a/AntimatterStudios/ext4-win-driver/0.2.0/AntimatterStudios.ext4-win-driver.installer.yaml","sha256":"085d8f69a65cb456a5e30fb4402a2775d3966f5a542c3db935f7536d944e0bd3"},{"path":"manifests/a/AntimatterStudios/ext4-win-driver/0.2.0/AntimatterStudios.ext4-win-driver.locale.en-US.yaml","sha256":"07d497d50ce9e9c4e1f4862a5b3eb9a12a0de12c87e8e81db262718280522675"}],"repository":"microsoft/winget-pkgs"},"version":"0.2.0"}