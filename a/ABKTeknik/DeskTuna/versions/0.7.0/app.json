{"defaultLocale":"en-US","id":"ABKTeknik.DeskTuna","installers":[{"appsAndFeaturesEntries":[{"DisplayName":"DeskTuna","DisplayVersion":"0.7.0","Publisher":"ABKTeknik"}],"architecture":"x64","dependencies":[],"id":"x64-user-exe","installModes":["interactive","silent"],"installerSwitches":{"Silent":"--silent","SilentWithProgress":"--silent"},"locale":"tr-TR","minimumOSVersion":"10.0.17763.0","platforms":["Windows.Desktop"],"priority":1,"scope":"user","sha256":"a4d00c60b4fa0a52f52bcfdcb3c10ce1f01a3b30373201fe6b3413e4d8412c1f","silent":{"arguments":"--silent","source":"manifest"},"successCodes":[],"type":"exe","upgradeBehavior":"install","url":"https://desktuna.com/DeskTuna-win-Setup-0.7.0.exe"}],"packageLocalizations":{"en-US":{"description":"Free desktop organizer that groups your desktop icons into smart fences.","license":"Freeware","locale":"en-US","longDescription":"DeskTuna is a free, ad-free desktop organizer for Windows 10 and 11. It lets you group\nyour desktop icons into named, colored, resizable fences with drag-and-drop.\nFences stay in place — immune to \"Show Desktop\" (Win+D), minimize gestures and restarts.\nIncludes folder portals (live folder contents as a fence), roll-up, layout snapshots\nwith one-click restore, full multi-monitor support, themes and automatic delta updates.\nInstalls per-user without administrator rights. Privacy-friendly: no personal data is\ncollected (anonymous usage counters only, opt-out available in Settings).","moniker":"desktuna","name":"DeskTuna","packageUrl":"https://desktuna.com","publisher":"ABKTeknik","publisherUrl":"https://desktuna.com","releaseNotesUrl":"https://desktuna.com/releases.html","tags":["desktop","desktop-organizer","fences","icons","organizer","productivity"]}},"publisherUrl":"https://desktuna.com","releaseNotesUrl":"https://desktuna.com/releases.html","schemaVersion":1,"source":"winget","upstream":{"commit":"97d6aa2689f0a05f7847653a62b8624720d15b5d","manifestVersion":"1.12.0","manifests":[{"path":"manif