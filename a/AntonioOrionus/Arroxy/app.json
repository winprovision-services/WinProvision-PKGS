{"architectures":["x64"],"id":"AntonioOrionus.Arroxy","latestVersion":"0.7.4","media":{"icons":[],"screenshots":[]},"package":{"description":"Free, open-source video downloader for YouTube and 2000+ other sites. Save videos, playlists, channels and audio in up to 8K HDR, and sign in through the built-in browser for private or members-only videos. No ads.","license":"GPL-3.0-or-later","licenseUrl":"https://github.com/antonio-orionus/Arroxy/blob/HEAD/LICENSE","locale":"en-US","localizations":{"en-US":{"description":"Free, open-source video downloader for YouTube and 2000+ other sites. Save videos, playlists, channels and audio in up to 8K HDR, and sign in through the built-in browser for private or members-only videos. No ads.","license":"GPL-3.0-or-later","licenseUrl":"https://github.com/antonio-orionus/Arroxy/blob/HEAD/LICENSE","locale":"en-US","longDescription":"Arroxy is a free, open-source desktop app for downloading video and audio from YouTube and 2000+ other sites. Paste a link, or browse any site in the built-in Explore browser and download what you are watching: videos, Shorts, playlists and channels in up to 8K HDR at 60 fps, or audio as MP3, M4A or Opus. Download profiles remember how you like each download, and subtitles, SponsorBlock and partial downloads are built in. Sign in once in Explore to download private, members-only and age-restricted videos your account can watch, without exporting cookies. No ads, no upsells, and files go straight to the folder you choose.","moniker":"arroxy","name":"Arroxy","packageUrl":"https://github.com/antonio-orionus/Arroxy","publisher":"Antonio Orionus","publisherUrl":"https://github.com/antonio-orionus","releaseNotesUrl":"https://github.com/antonio-orionus/Arroxy/releases/tag/v0.7.4","tags":["audio-downloader","cross-platform","desktop-app","downloader-for-youtube","media-downloader","mp4-downloader","video-download","video-download-tool","video-downloader","youtube-4k-downloader","youtube-download","youtube-downloader","youtube-shorts-download"]}},"longDescription":"Arroxy is a free, open-source desktop app for downloading video and audio from YouTube and 2000+ other sites. Paste a link, or browse any site in the built-in Explore browser and download what you are watching: videos, Shorts, playlists and channels in up to 8K HDR at 60 fps, or audio as MP3, M4A or Opus. Download profiles remember how you like each download, and subtitles, SponsorBlock and partial downloads are built in. Sign in once in Explore to download private, members-only and age-restricted videos your account can watch, without exporting cookies. No ads, no upsells, and files go straight to the folder you choose.","moniker":"arroxy","name":"Arroxy","packageUrl":"https://github.com/antonio-orionus/Arroxy","publisher":"Antonio Orionus","publisherUrl":"https://github.com/antonio-orionus","releaseNotesUrl":"https://github.com/antonio-orionus/Arroxy/releases/tag/v0.7.4","tags":["audio-downloader","cross-platform","desktop-app","downloader-for-youtube","media-downloader","mp4-downloader","video-download","video-download-tool","video-downloader","youtube-4k-downloader","youtube-download","youtube-downloader","youtube-shorts-download"]},"schemaVersion":1,"source":"winget","versions":[{"architectures":["x64"],"detailPath":"versions/0.7.4/app.json","detailSha256":"e0bce63ba71946d6f79c6906c355990d71c00571a02a40876fd3c47e6f2518ec","releaseDate":"2026-10-22","releaseDateSource":"manifest","version":"0.7.4"},{"architectures":["x64"],"detailPath":"versions/0.7.3/app.json","detailSha256":"d74f9d4f8ff8eeb0ee84574a72aa6954a1145c9da2ac5fd115400d9a0b267416","releaseDate":"2026-10-21","releaseDateSource":"manifest","version":"0.7.3"},{"architectures":["x64"],"detailPath":"versions/0.7.2/app.json","detailSha256":"dd26d3ad35d9e65be6b9d36f577621816f2fcebd08867dd342ee2ee0bd0ff248","releaseDate":"2026-10-20","releaseDateSource":"manifest","version":"0.7.2"},{"architectures":["x64"],"detailPath":"versions/0.7.1/app.json","detailSha256