{"defaultLocale":"en-US","id":"Hotdogee.ToggleAudio","installers":[{"appsAndFeaturesEntries":[{"DisplayName":"Toggle Audio","InstallerType":"wix","ProductCode":"{9F03B824-00E3-45F7-9B6C-17BF741FE81D}","Publisher":"Han Lin","UpgradeCode":"{C82A4013-F2FF-448E-A4AE-63CD73760A63}"}],"architecture":"x64","commands":["toggle-audio","toggle-audiow"],"dependencies":[],"elevation":{"requirement":"elevationRequired","source":"inferred"},"id":"x64-machine-wix","installModes":["interactive","silent","silentWithProgress"],"priority":2,"scope":"machine","sha256":"474b295a402dc412508bf5e21f77d975a32ee38c0525c096856d870eb2eb4316","silent":{"arguments":"/quiet /norestart","source":"default"},"successCodes":[],"type":"wix","uninstall":{"type":"productCode","value":"{9F03B824-00E3-45F7-9B6C-17BF741FE81D}"},"upgradeBehavior":"install","url":"https://github.com/hotdogee/toggle-audio/releases/download/v0.1.0/toggle-audio-0.1.0-x64.msi"}],"licenseUrl":"https://github.com/hotdogee/toggle-audio/blob/main/LICENSE","packageLocalizations":{"en-US":{"author":"Han Lin","copyright":"Copyright (c) 2026 Han Lin","copyrightUrl":"https://github.com/hotdogee/toggle-audio/blob/main/LICENSE","description":"Flip the Windows default audio output between two devices in milliseconds.","documentations":[{"DocumentLabel":"README","DocumentUrl":"https://github.com/hotdogee/toggle-audio#readme"}],"license":"MIT","licenseUrl":"https://github.com/hotdogee/toggle-audio/blob/main/LICENSE","locale":"en-US","longDescription":"Toggle Audio switches the Windows default playback device between two outputs you choose\n(for example monitor speakers and a Bluetooth headphone transmitter), then exits. It is a\nnative x64 executable with no runtime dependencies and no background process, made to sit\nbehind a macro key in Logitech G HUB, Stream Deck, AutoHotkey or a Windows shortcut.\nA full toggle takes about 40 ms. It includes a small settings dialog to pick the two devices,\na command line (list, get, set) with documented exit codes, and a console-free launcher\nexecutable for hotkeys.","moniker":"toggle-audio","name":"Toggle Audio","packageUrl":"https://github.com/hotdogee/toggle-audio","publisher":"Han Lin","publisherSupportUrl":"https://github.com/hotdogee/toggle-audio/issues","publisherUrl":"https://github.com/hotdogee","releaseNotes":"Initial native release: instant default-playback toggle with unplugged-device fallback,\nlist/get/set command line, settings dialog, two executables (console and console-free),\nper-user JSON configuration, MSI installer with Start Menu entry and optional PATH, and\nreproducible benchmarks in C, Rust, C#, Go, Zig and PowerShell.","releaseNotesUrl":"https://github.com/hotdogee/toggle-audio/releases/tag/v0.1.0","tags":["audio","audio-device","audio-switcher","default-audio-device","headphones","hotkey","logitech-g-hub","sound","speakers","stream-deck","windows"]}},"publisherSupportUrl":"https://github.com/hotdogee/toggle-audio/issues","publisherUrl":"https://github.com/hotdogee","releaseDate":"2026-11-12","releaseDateSource":"commit","releaseNotesUrl":"https://github.com/hotdogee/toggle-audio/releases/tag/v0.1.0","schemaVersion":1,"source":"winget","upstream":{"commit":"fdc60013f4df0211101ea20a94e0c14aaeaff6e0","manifestVersion":"1.28.0","manifests":[{"path":"manifests/h/Hotdogee/ToggleAudio/0.1.0/Hotdogee.ToggleAudio.installer.yaml","sha256":"671446e8ec5a219cd824e3cd613cd2452fb928bf5cd18db62bda14546f4f9099"},{"path":"manifests/h/Hotdogee/ToggleAudio/0.1.0/Hotdogee.ToggleAudio.locale.en-US.yaml","sha256":"e31726176e92489a2889ba2147458e1ec6fb4bfb5b29cac08c0dc56d8914e7c9"},{"path":"manifests/h/Hotdogee/ToggleAudio/0.1.0/Hotdogee.ToggleAudio.yaml","sha256":"7f7decd27150f4eab6eec262bb49f62ad710d44b059f690198eb8877234d71fe"}],"repository":"microsoft/winget-pkgs"},"version":"0.1.0"}