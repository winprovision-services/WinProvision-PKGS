{"defaultLocale":"en-US","id":"HomeOps.wmux","installers":[{"architecture":"x64","dependencies":[],"id":"x64-zip","nestedInstallerFiles":[{"RelativeFilePath":"wmux.exe"}],"nestedInstallerType":"portable","priority":4,"sha256":"915d9f6cc35b487efd168fcc91be3afc8c0ca8e1d47edbdb036d4943d4b67e8e","successCodes":[],"type":"zip","url":"https://github.com/HomeOps/wmux/releases/download/v0.4.0/wmux-0.4.0-x64.zip"}],"licenseUrl":"https://github.com/HomeOps/wmux/blob/main/LICENSE","packageLocalizations":{"en-US":{"description":"Terminal session persistence for Windows","license":"MIT","licenseUrl":"https://github.com/HomeOps/wmux/blob/main/LICENSE","locale":"en-US","longDescription":"wmux keeps a console session alive after its window closes. Start a session, detach with Ctrl-B d, close the terminal, and reattach later with the shell and everything running in it intact.\nIt is deliberately scoped to session persistence alone: no panes, no splits, no status bar. Windows Terminal already provides tabs, splits, and search, so wmux does the one thing Windows lacks and leaves the rest to your terminal.\nBuilt directly on ConPTY. A detached server process owns the pseudoconsole and holds no console of its own, so the close event sent to the window that started it never reaches the session. Scripts can also drive a session without a terminal at all.","moniker":"wmux","name":"wmux","packageUrl":"https://github.com/HomeOps/wmux","publisher":"HomeOps","publisherUrl":"https://github.com/HomeOps","releaseNotesUrl":"https://github.com/HomeOps/wmux/releases/tag/v0.4.0","tags":["conpty","console","detach","multiplexer","powershell","reattach","session","terminal","tmux"]}},"publisherUrl":"https://github.com/HomeOps","releaseDate":"2026-10-15","releaseDateSource":"manifest","releaseNotesUrl":"https://github.com/HomeOps/wmux/releases/tag/v0.4.0","schemaVersion":1,"source":"winget","upstream":{"commit":"97d6aa2689f0a05f7847653a62b8624720d15b5d","manifestVersion":"1.12.0","manifests":[{"path":"m