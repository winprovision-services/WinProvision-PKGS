{"defaultLocale":"en-US","id":"HermannSchinagl.LinkShellExtension","installers":[{"architecture":"x64","dependencies":[{"PackageDependencies":[{"PackageIdentifier":"Microsoft.VCRedist.2015+.x64"}]}],"elevation":{"requirement":"elevationRequired","source":"inferred"},"id":"x64-machine-nullsoft","installerSwitches":{"Custom":"/noredist"},"minimumOSVersion":"10.0.0.0","priority":1,"scope":"machine","sha256":"ca3f26ebf49dc4ea8b5d8c0154acca0de59a8689e5907fe748ffaeaa357ff3a0","silent":{"arguments":"/S","source":"default"},"successCodes":[],"type":"nullsoft","uninstall":{"type":"productCode","value":"HardlinkShellExt"},"upgradeBehavior":"install","url":"https://schinagl.priv.at/nt/hardlinkshellext/save/3935/HardLinkShellExt_X64.exe"},{"architecture":"x86","dependencies":[{"PackageDependencies":[{"PackageIdentifier":"Microsoft.VCRedist.2015+.x86"}]}],"elevation":{"requirement":"elevationRequired","source":"inferred"},"id":"x86-machine-nullsoft","installerSwitches":{"Custom":"/noredist"},"minimumOSVersion":"10.0.0.0","priority":1,"scope":"machine","sha256":"b7e7227e960f025be992c398dafacd03c416adf5210d3fc0ff1d5b5771afdc4b","silent":{"arguments":"/S","source":"default"},"successCodes":[],"type":"nullsoft","uninstall":{"type":"productCode","value":"HardlinkShellExt"},"upgradeBehavior":"install","url":"https://schinagl.priv.at/nt/hardlinkshellext/save/3935/HardLinkShellExt_win32.exe"}],"licenseUrl":"https://schinagl.priv.at/nt/hardlinkshellext/license.txt","packageLocalizations":{"en-US":{"description":"Explorer extension for easy creation of Hardlinks, Junctions, Volume Mountpoints and Symbolic Links","license":"Freeware","licenseUrl":"https://schinagl.priv.at/nt/hardlinkshellext/license.txt","locale":"en-US","longDescription":"Link Shell Extension (LSE) provides for the creation of Hardlinks, Junctions, Volume Mountpoints, and Symbolic Links, (herein referred to collectively as Links) a folder cloning process that utilises Hardlinks or Symbolic Links and a copy process taking care of Junctions, Symbolic Links, and Hardlinks. LSE, as its name implies is implemented as a Shell extension and is accessed from Windows Explorer, or similar file/folder managers. The extension allows the user to select one or many files or folders, then using the mouse, complete the creation of the required Links - Hardlinks, Junctions or Symbolic Links or in the case of folders to create Clones consisting of Hard or Symbolic Links. LSE is supported on all Windows versions that support NTFS, Windows 7/8/10. Hardlinks, Junctions and Symbolic Links are NOT supported on FAT file systems, and nor is the Cloning and Smart Copy process supported on FAT file systems.","name":"Link Shell Extension","packageUrl":"https://schinagl.priv.at/nt/hardlinkshellext/hardlinkshellext.html","publisher":"Hermann Schinagl","publisherUrl":"https://schinagl.priv.at/","releaseNotesUrl":"https://schinagl.priv.at/nt/hardlinkshellext/hardlinkshellext.html#history","tags":["directory","file","file-system","filesystem","folder","hardlink","junction","link","mountpoint","symbolic","symlink","volume"]},"zh-CN":{"description":"用于轻松创建硬链接、连接点、卷挂载点和符号链接的资源管理器扩展","license":"免费软件","licenseUrl":"https://schinagl.priv.at/nt/hardlinkshellext/license.txt","locale":"zh-CN","longDescription":"Link Shell Extension（LSE）提供了创建硬链接、连接点、卷挂载点和符号链接（这里统称为链接）的功能，利用硬链接或符号链接克隆文件夹，并在复制时处理连接点、符号链接和硬链接。LSE，正如其名，是通过 Shell 扩展实现的，可以从 Windows 资源管理器或类似的文件/文件夹管理器中访问。该扩展允许用户选择一个或多个文件或文件夹，然后用鼠标创建所需链接（硬链接、连接点或符号链接），或者对于文件夹，创建由硬链接或符号链接组成的克隆。LSE 可以在所有支持 NTFS 的 Windows 版本（Windows 7/8/10）中使用。FAT 文件系统既不支持硬链接、连接点和符号链接，也不支持克隆和智能复制。","name":"Link Shell Extension","packageUrl":"https://schinagl.priv.at/nt/hardlinkshellext/hardlinkshellext.html","publisher":"Hermann Schinagl","publisherUrl":"https://schinagl.priv.at/","releaseNotesUrl":"https://schinagl.priv.at/nt/hardlinkshellext/hardlinkshellext.html#history","tags":["卷","挂载点","文件","文件夹","文件系统","目录","目录联接","目录连接点","硬连接","硬链接","符号连接","符号链接","连接","链接"]}},"publisherUrl":"https://schinagl.priv.at/","releaseDate":"2021-01-16","releaseDateSource":"manifest","releaseNotesUrl":"https://schinagl.priv.at/nt/hardlinkshellext/hardlinkshellext.html#history","schemaVersion":1,"source":"winget","upstream":{"commit":"97d6aa2689f0a05f7847653a62b8624720d15b5d","manifestVersion":"1.1.0","manifests":[{"path":"manifests/h/HermannSchinagl/LinkShellExtension/3.9.3.5/HermannSchinagl.LinkShellExtension.yaml","sha256":"1fee58ba996a0916eb5eae816014cf24167a5a6852f242e067f43f9fa0961ffd"},{"path":"manifests/h/HermannSchinagl/LinkShellExtension/3.9.3.5/HermannSchinagl.LinkShellExtension.installer.yaml","sha256":"875c2a631b7dd98a5be5f5bb9e616509833f13d852c6fbb77418d0b82f4ffe94"},{"path":"manifests/h/HermannSchinagl/LinkShellExtension/3.9.3.5/HermannSchinagl.LinkShellExtension.locale.en-US.yaml","sha256":"1439eb9ee21dfbe2036a5c69b42aac3023f491cb42ab9fb2c953b274c5babd61"},{"path":"manifests/h/HermannSchinagl/LinkShellExtension/3.9.3.5/HermannSchinagl.LinkShellExtension.locale.zh-CN.yaml","sha256":"3de3420ae77e307ead9be1d8b066dc06ac0a80608f19f93cbb4d68d03c112cff"}],"repository":"microsoft/winget-pkgs"},"version":"3.9.3.5"}