{"architectures":["x64"],"id":"HiToysMaker.fontplayer","latestVersion":"0.4.1","media":{"icons":[],"screenshots":[]},"package":{"description":"一款开源的字体设计工具。","license":"MIT","licenseUrl":"https://github.com/HiToysMaker/fontplayer/blob/HEAD/License","locale":"zh-CN","localizations":{"zh-CN":{"description":"一款开源的字体设计工具。","license":"MIT","licenseUrl":"https://github.com/HiToysMaker/fontplayer/blob/HEAD/License","locale":"zh-CN","longDescription":"一款用于生成个人字库（或图标字库）的开源创意工具。使用字玩，用户可以通过钢笔工具等图形编辑工具绘制字形，然后导出OTF字体文件。同时，字玩支持从图片中导入字形，也支持自定义字形组件功能，并提供了可编程脚本模块。字玩内嵌了一款用于测试的参数化字体模板，导入该模板，可以尝试体验字玩的参数化设计功能。字玩希望通过探索更多的创意，帮助字体（或图标）设计师或爱好者，简化设计流程，提高设计效率，为字体设计领域添砖加瓦。","moniker":"FontPlayer","name":"字玩","packageUrl":"https://www.font-player.com/","publisher":"HiToysMaker","publisherUrl":"https://github.com/HiToysMaker","releaseNotesUrl":"https://github.com/HiToysMaker/fontplayer/releases/tag/v0.4.1","tags":["OTF","element-ui","图形","字体","字体文件","字体设计","字玩","工具","开源","文字","设计"]}},"longDescription":"一款用于生成个人字库（或图标字库）的开源创意工具。使用字玩，用户可以通过钢笔工具等图形编辑工具绘制字形，然后导出OTF字体文件。同时，字玩支持从图片中导入字形，也支持自定义字形组件功能，并提供了可编程脚本模块。字玩内嵌了一款用于测试的参数化字体模板，导入该模板，可以尝试体验字玩的参数化设计功能。字玩希望通过探索更多的创意，帮助字体（或图标）设计师或爱好者，简化设计流程，提高设计效率，为字体设计领域添砖加瓦。","moniker":"FontPlayer","name":"字玩","packageUrl":"https://www.font-player.com/","publisher":"HiToysMaker","publisherUrl":"https://github.com/HiToysMaker","releaseNotesUrl":"https://github.com/HiToysMaker/fontplayer/releases/tag/v0.4.1","tags":["OTF","element-ui","图形","字体","字体文件","字体设计","字玩","工具","开源","文字","设计"]},"schemaVersion":1,"source":"winget","versions":[{"architectures":["x64"],"detailPath":"versions/0.4.1/app.json","detailSha256":"e931a8336be67c5b6bd832080fd57e39ef9f33875e1e6cab27c0d7482e4d5637","releaseDate":"2025-11-30","releaseDateSource":"manifest","version":"0.4.1"},{"architectures":["x64"],"detailPath":"versions/0.2.0/app.json","detailSha256":"db947ccfa16b4f7c1d209942244667848b85beceac0fdcf8b0a67567cac7b4cf","releaseDate":"2025-05-09","releaseDateSource":"manifest","version":"0.2.0"}