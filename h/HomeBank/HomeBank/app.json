{"architectures":["x86"],"id":"HomeBank.HomeBank","latestVersion":"5.10.3","media":{"icons":[],"screenshots":[]},"package":{"description":"HomeBank is a free software (as in \"free speech\" and also as in \"free beer\") that will assist you to manage your personal accounting.","license":"GPL-2.0-or-later","licenseUrl":"http://homebank.free.fr/en/support.php","locale":"en-US","localizations":{"en-US":{"description":"HomeBank is a free software (as in \"free speech\" and also as in \"free beer\") that will assist you to manage your personal accounting.","license":"GPL-2.0-or-later","licenseUrl":"http://homebank.free.fr/en/support.php","locale":"en-US","longDescription":"HomeBank is a free, open source, personal finance and money management application that can be used to manage your daily and monthly finance details easily as well as effectively.\nIt has built-in powerful filtering tools and graphs that will help you to analyze your everyday transactions.\nIt is a cross platform tool which will work on almost all common devices and operating systems, including Linux, Windows, FreeBSD, and Mac OS X.","name":"HomeBank","packageUrl":"http://homebank.free.fr/","publisher":"Maxime DOYEN","tags":["accounting","budget","finance","money"]}},"longDescription":"HomeBank is a free, open source, personal finance and money management application that can be used to manage your daily and monthly finance details easily as well as effectively.\nIt has built-in powerful filtering tools and graphs that will help you to analyze your everyday transactions.\nIt is a cross platform tool which will work on almost all common devices and operating systems, including Linux, Windows, FreeBSD, and Mac OS X.","name":"HomeBank","packageUrl":"http://homebank.free.fr/","publisher":"Maxime DOYEN","tags":["accounting","budget","finance","money"]},"schemaVersion":1,"source":"winget","versions":[{"architectures":["x86"],"detailPath":"versions/5.10.3/app.json","detailSha256":"509be6357d5380306106f88cb2e2