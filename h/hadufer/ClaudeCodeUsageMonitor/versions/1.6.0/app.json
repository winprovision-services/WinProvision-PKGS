{"defaultLocale":"en-US","id":"hadufer.ClaudeCodeUsageMonitor","installers":[{"architecture":"x64","commands":["claude-code-usage-monitor"],"dependencies":[],"id":"x64-portable","priority":4,"sha256":"68afcda986181ddd1cf797f0b5ffcda7bcb0cb9f9437581b4deed860abb551d4","successCodes":[],"type":"portable","url":"https://github.com/hadufer/Claude-Code-Usage-Monitor/releases/download/v1.6.0/claude-code-usage-monitor.exe"}],"licenseUrl":"https://github.com/hadufer/Claude-Code-Usage-Monitor/blob/main/LICENSE","packageLocalizations":{"en-US":{"description":"Windows taskbar widget showing Claude Code usage, coloured by consumption pace.","license":"MIT","licenseUrl":"https://github.com/hadufer/Claude-Code-Usage-Monitor/blob/main/LICENSE","locale":"en-US","longDescription":"A fork of CodeZeno.ClaudeCodeUsageMonitor. The taskbar widget is drawn as an\ninstrument panel: each usage window is a tape whose fill is what was used and\nwhose marker is where the clock says you should be, coloured by consumption\npace rather than raw percentage. A click opens a panel with every limit,\nincluding the per-model weekly one, its exact reset time and a warning when\nthe limit would arrive before the reset at the current rate. Codex and\nAntigravity usage can be shown alongside Claude Code. Thresholds and band\ncolours are configurable from the settings file.","name":"Claude Code Usage Monitor (hadufer fork)","packageUrl":"https://github.com/hadufer/Claude-Code-Usage-Monitor","publisher":"Hassan Dufer","publisherUrl":"https://github.com/hadufer","releaseNotesUrl":"https://github.com/hadufer/Claude-Code-Usage-Monitor/releases/tag/v1.6.0","tags":["claude","monitor","taskbar","tray","usage"]}},"publisherUrl":"https://github.com/hadufer","releaseDate":"2026-09-28","releaseDateSource":"manifest","releaseNotesUrl":"https://github.com/hadufer/Claude-Code-Usage-Monitor/releases/tag/v1.6.0","schemaVersion":1,"source":"winget","upstream":{"commit":"97d6aa2689f0a05f7847653a62b8624720d15b5d","manifestVer