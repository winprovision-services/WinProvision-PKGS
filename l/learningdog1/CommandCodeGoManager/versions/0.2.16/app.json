ationRequired","source":"inferred"},"id":"arm64-machine-nullsoft","installationMetadata":{"DefaultInstallLocation":"%ProgramFiles(x86)%\\CommandCodeGo Manager"},"installerSwitches":{"Custom":"/AllUsers"},"priority":1,"scope":"machine","sha256":"4db90df74247e11ce4dda9ac7cc6830ad63a581f137a2b174403f03df86d5d3e","successCodes":[],"type":"nullsoft","uninstall":{"type":"productCode","value":"ad8143e7-e3a2-53e4-a3ac-117c59a97e08"},"upgradeBehavior":"install","url":"https://github.com/learningdog1/CommandCodeGo-manager/releases/download/v0.2.16/CommandCodeGo.Manager-Setup-0.2.16-arm64.exe"}],"licenseUrl":"https://github.com/learningdog1/CommandCodeGo-manager/blob/HEAD/LICENSE","packageLocalizations":{"en-US":{"copyright":"Copyright © 2026 CommandCodeGo Manager","description":"Command Code subscription reverse proxy with OpenAI/Anthropic-compatible endpoints.","license":"MIT","licenseUrl":"https://github.com/learningdog1/CommandCodeGo-manager/blob/HEAD/LICENSE","locale":"en-US","longDescription":"CommandCodeGo Manager is a desktop app that reverse-proxies a Command Code subscription into OpenAI-compatible (/v1/chat/completions, /v1/responses) and Anthropic-compatible (/v1/messages) endpoints for any harness or SDK. It includes a Chinese web administration interface with a dashboard, live request logs, usage statistics, model lists, key management, device fingerprint inspection, and settings. The service keeps running in the background with a tray icon after the window closes.","name":"CommandCodeGo Manager","packageUrl":"https://github.com/learningdog1/CommandCodeGo-manager","privacyUrl":"https://github.com/learningdog1/CommandCodeGo-manager/blob/HEAD/PRIVACY.md","publisher":"colmidad","publisherSupportUrl":"https://github.com/learningdog1/CommandCodeGo-manager/issues","publisherUrl":"https://github.com/learningdog1","tags":["ai","api","command-code","proxy"]},"zh-CN":{"description":"Command Code 订阅反向代理，提供 OpenAI/Anthropic 兼容端点。","locale":"zh-CN","longDescription":"CommandCodeGo Manager 是一款桌面应用，把 Command Code 订阅额度反代为 OpenAI 兼容（/v1/chat/completions、/v1/responses）与 Anthropic 兼容（/v1/messages）端点，供任意 harness 和 SDK 使用。自带中文 Web 管理界面（仪表盘、实时日志、用量统计、模型列表、密钥管理、设备指纹、设置）。关闭窗口后服务在后台继续运行（托盘常驻）。","releaseNotes":"What's Changed\nfix(rotation): 额度耗尽自动轮转三处失灵(#12)\n- 固定/绑定不再越过账户状态：「切到此账号」与密钥绑定原先不检查 status,锁定一个已耗尽/已停用的账户后永远不会再换号。现在固定与绑定都只是偏好，不可用时按同一套可用性规则兜底。\n- 429 额度语义认得出：真身 RATE_LIMITED + 「weekly usage limit … limit resets at 」文本原先认不出(只认 USAGE_EXCEEDED/rateLimit.window)。现在额度码或额度措辞都认，重置时间优先取 rateLimit.reset,其次取报文里的 ISO 时间；瞬态 429 与请求类错误(Bad Request / 模型不可用 / 地区限制)仍不轮转。\n- 额度耗尽回 200 也认：上游把「no credits remaining」塞进 200 的 SSE 体里时，转发前窥探响应首段(≤16KB / ≤3s,见到正文事件立即放行),命中错误事件按额度耗尽处理并当笔轮转重试。\n- 月度信用归零：用量刷新发现 totalRemaining === 0 时标记到当期结束(补额度自动解除),不再每笔请求都打到一个必然失败的账户上。\nfix(rotation): thinking 流首字节延迟\n窥探正则 CONTENT_STARTED 漏了本协议的 reasoning-start/reasoning-delta,推理先行的流会被扣满 3s 预算才放行；已补上(含 tool-call 兜底)并加回归用例。\nNew Contributors\n- @bixianzuose made their first contribution in https://github.com/learningdog1/CommandCodeGo-manager/pull/12\nFull Changelog: https://github.com/learningdog1/CommandCodeGo-manager/compare/v0.2.15...v0.2.16","releaseNotesUrl":"https://github.com/learningdog1/CommandCodeGo-manager/releases/tag/v0.2.16","tags":["api","人工智能","代理","大模型"]}},"publisherSupportUrl":"https://github.com/learningdog1/CommandCodeGo-manager/issues","publisherUrl":"https://github.com/learningdog1","releaseDate":"2026-11-11","releaseDateSource":"commit","schemaVersion":1,"source":"winget","upstream":{"commit":"06fe0c1922ea63380b4e7a9b4a957cc117ac9fe3","manifestVersion":"1.28.0","manifests":[{"path":"manifests/l/learningdog1/CommandCodeGoManager/0.2.16/learningdog1.CommandCodeGoManager.installer.yaml","sha256":"c5902886aa2212b70566dc81823f48ed0d5bd8cd325fb308a3233ff9dc9258d5"},{"path":"manifests/l/learningdog1/CommandCodeGoManager/0.2.16/learningdog1.CommandCodeGoManager.locale.en-US.yaml","sha256":"b09993bc701f44500b3564e1305c41fdc511fff07183c41ee19e32746622abc8"},{"path":"manifests/l/learningdog1/CommandCodeGoManager/0.2.16/learningdog1.CommandCodeGoManager.locale.zh-CN.yaml","sha256":"7bad3eff13e7cafb7c3c28b3f4c76a58b654b2eae90d02fa5075febc00abfbf1"},{"path":"manifests/l/learningdog1/CommandCodeGoManager/0.2.16/learningdog1.CommandCodeGoManager.yaml","sha256":"7ff603e0d2ec973f9629b65c21aa20a305193e56a76ce3016c6271a4e2bb4e09"}],"repository":"microsoft/winget-pkgs"},"version":"0.2.16"}