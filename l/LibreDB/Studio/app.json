{"architectures":["x64"],"id":"LibreDB.Studio","latestVersion":"1.3.0","media":{"icons":[],"screenshots":[]},"package":{"copyright":"Copyright (c) 2025 LibreDB","description":"Web-based SQL IDE for PostgreSQL, MySQL, SQLite, Oracle, SQL Server, MongoDB, and Redis with AI query assistance.","documentations":[{"DocumentLabel":"Distribution & Install Guide","DocumentUrl":"https://github.com/libredb/libredb-studio/blob/main/docs/DISTRIBUTION.md"}],"license":"MIT","licenseUrl":"https://github.com/libredb/libredb-studio/blob/main/LICENSE","locale":"en-US","localizations":{"en-US":{"copyright":"Copyright (c) 2025 LibreDB","description":"Web-based SQL IDE for PostgreSQL, MySQL, SQLite, Oracle, SQL Server, MongoDB, and Redis with AI query assistance.","documentations":[{"DocumentLabel":"Distribution & Install Guide","DocumentUrl":"https://github.com/libredb/libredb-studio/blob/main/docs/DISTRIBUTION.md"}],"license":"MIT","licenseUrl":"https://github.com/libredb/libredb-studio/blob/main/LICENSE","locale":"en-US","longDescription":"LibreDB Studio is an open-source, web-based SQL IDE for cloud-native teams.\nIt connects to PostgreSQL, MySQL, SQLite, Oracle, SQL Server, MongoDB, and\nRedis, and ships a Monaco-powered editor with AI query assistance, schema\nbrowsing, ER diagrams, charts, and import/export tooling. This package\ninstalls the standalone server with a bundled Node.js runtime; run\n`libredb-studio` and open http://127.0.0.1:3000 - the first run prints\ngenerated admin credentials to the terminal (zero-config bootstrap).","moniker":"libredb-studio","name":"LibreDB Studio","packageUrl":"https://github.com/libredb/libredb-studio","publisher":"LibreDB","publisherSupportUrl":"https://github.com/libredb/libredb-studio/issues","publisherUrl":"https://libredb.org","releaseNotesUrl":"https://github.com/libredb/libredb-studio/releases/tag/1.3.0","tags":["database","db","ide","mongodb","mysql","oracle","postgres","postgresql","redis","sql","sqlite"]}},"longDescription":"LibreD