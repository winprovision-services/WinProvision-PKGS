{"architectures":["x64"],"id":"LMCP.LocalMCP","latestVersion":"3.0.445","media":{"icons":[{"mimeType":"image/png","path":"media/icon.d57abdbd.png","priority":1,"sha256":"d57abdbd942da8f5de971fde187c26cd41ec8709cd61acf9b93a6e59107aa803","source":"winget-legacy"}],"screenshots":[]},"package":{"author":"LMCP","description":"Local tools that let your AI use Mail, Calendar, Contacts, Teams, WhatsApp, Telegram, OneDrive, Google Drive, SharePoint, Outlook and Office files on Windows. Runs on your computer.","license":"Proprietary","licenseUrl":"https://www.local-mcp.com/en/tos","locale":"en-US","localizations":{"en-US":{"author":"LMCP","description":"Local tools that let your AI use Mail, Calendar, Contacts, Teams, WhatsApp, Telegram, OneDrive, Google Drive, SharePoint, Outlook and Office files on Windows. Runs on your computer.","license":"Proprietary","licenseUrl":"https://www.local-mcp.com/en/tos","locale":"en-US","longDescription":"LMCP is a local MCP server that lets your AI assistant work with the apps and files on your own computer: Outlook, Teams, OneDrive, SharePoint, Google Drive, WhatsApp, Telegram, Word, Excel, PowerPoint and PDF files, local files, web and UI automation, and more.\nInstall the LMCP app first; your AI client then starts the server with npx -y local-mcp@latest. Web assistants such as ChatGPT and Claude.ai connect through an optional relay that is off by default.\nYour AI provider still receives the content you ask it to process.","name":"LMCP","packageUrl":"https://www.local-mcp.com","publisher":"LMCP","publisherSupportUrl":"https://github.com/colibird-ai/local-mcp-releases/issues","publisherUrl":"https://www.local-mcp.com","tags":["ai","mcp","automation","email","outlook","teams","onedrive","excel","productivity"]}},"longDescription":"LMCP is a local MCP server that lets your AI assistant work with the apps and files on your own computer: Outlook, Teams, OneDrive, SharePoint, Google Drive, WhatsApp, Telegram, Word, Excel, PowerPoint and PDF fil