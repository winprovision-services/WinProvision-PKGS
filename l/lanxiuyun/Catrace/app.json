{"architectures":["x64"],"id":"lanxiuyun.Catrace","latestVersion":"26.10.15","media":{"icons":[{"mimeType":"image/png","path":"media/icon.49f1464c.png","priority":1,"sha256":"49f1464c46222bedd3d2b9a94aef330c20e0c0e00bfd3b3f7a53be85c946f5d0","source":"winget-legacy"}],"screenshots":[]},"package":{"description":"帮你平衡工作与休息的小工具：久坐提醒 · 喝水打卡 · Agent 通知。","license":"AGPL-3.0","licenseUrl":"https://github.com/lanxiuyun/Catrace/blob/HEAD/LICENSE","locale":"zh-CN","localizations":{"en-US":{"description":"A small tool that helps you balance work and rest: sedentary reminder, water check-in, and agent notifications.","locale":"en-US","longDescription":"Catrace quietly watches your activity in the background (it only detects mouse and keyboard activity — no screen capture, no reading what you do) and reminds you to stand up and rest when you have been working continuously for too long. Two reminder modes are supported: notification cards (floating cards with postpone/skip actions and a rest liquid-ball timer) and fullscreen reminders (with customizable background image, fit mode, and overlay opacity). You can customize the work window and rest-detection durations, and set water reminders at your own interval that only interrupt you while active. Custom plugins and agent notifications are supported.","tags":["break","health","productivity","reminder","sedentary","water"]},"zh-CN":{"description":"帮你平衡工作与休息的小工具：久坐提醒 · 喝水打卡 · Agent 通知。","license":"AGPL-3.0","licenseUrl":"https://github.com/lanxiuyun/Catrace/blob/HEAD/LICENSE","locale":"zh-CN","longDescription":"Catrace 在后台观察你的活动状态（只检测鼠标键盘活动，不偷拍屏幕、不读取你在做什么），发现你连续工作太久就会提醒你站起来休息一会儿。支持两种提醒模式：通知提醒（右下角浮动通知卡片，支持推迟、跳过与休息液体球计时器）与全屏提醒（可自定义背景图片、适配方式和遮罩透明度）。可以自定义工作时长和休息判定时长，也可以按设定间隔提醒喝水，只在你活跃时打扰。支持自定义插件与 Agent 通知。","name":"catrace","packageUrl":"https://github.com/lanxiuyun/Catrace","publisher":"lanxiuyun","publisherUrl":"https://github.com/lanxiuyun","releaseNotesUrl":"https://github.com/lanxiuyun/Catrace/releases/tag/v26.10.15","tags":["久坐","休息","健康","提醒","生产力"]}},"longDescription":"Catrace 在后台观察你的活动状态（只检测鼠标键盘活动，不偷拍屏幕、不读取你在做什么），发现你连续工作太久就会提醒你站起来休息一会儿。支持两种提醒模式：通知提醒（右下角浮动通知卡片，支持推迟、跳过与休息液体球计时器）与全屏提醒（可自定义背景图片、适配方式和遮罩透明度）。可以自定义工作时长和休息判定时长，也可以按设定间隔提醒喝水，只在你活跃时打扰。支持自定义插件与 Agent 通知。","name":"catrace","packageUrl":"https://github.com/lanxiuyun/Catrace","publisher":"lanxiuyun","publisherUrl":"https://github.com/lanxiuyun","releaseNotesUrl":"https://github.com/lanxiuyun/Catrace/releases/tag/v26.10.15","tags":["久坐","休息","健康","提醒","生产力"]},"schemaVersion":1,"source":"winget","versions":[{"architectures":["x64"],"detailPath":"versions/26.10.15/app.json","detailSha256":"144789ffde900d09fdd8222056010f154e1c0371bd8c530cbfe49dc99c546d79","releaseDate":"2026-10-15","releaseDateSource":"manifest","version":"26.10.15"},{"architectures":["x64"],"detailPath":"versions/26.10.10/app.json","detailSha256":"aaa42bba9a9c67de0ccc3fffc6b62ca7e5bb6bfd9a02c98ff1dd93f1e386f88e","releaseDate":"2026-10-10","releaseDateSource":"manifest","version":"26.10.10"},{"architectures":["x64"],"detailPath":"versions/26.10.9/app.json","detailSha256":"078eafc6ceb17f38dc6fc8f89754cb35f184d4439e0d95cca07f86998bd10e9e","releaseDate":"2026-10-09","releaseDateSource":"manifest","version":"26.10.9"},{"architectures":["x64"],"detailPath":"versions/26.10.7/app.json","detailSha256":"dd3b86966b9e8eab98f2fd5b57942298b1c807de63bdc7be2fb6d9a7e7aaafd4","releaseDate":"2026-10-07","releaseDateSource":"manifest","version":"26.10.7"},{"architectures":["x64"],"detailPath":"versions/26.10.2/app.json","detailSha256":"7351ba7b2a12030607c686eb89d3adbb1436570282376013ac0a91106a65c065","releaseDate":"2026-10-01","releaseDateSource":"manifest","version":"26.10.2"},{"architectures":["x64"],"detailPath":"versions/26.10.1/app.json","detailSha256":"31614a2ab5a65a4602cacabe3547a30794f13c4b25cf2ad00932cbf77110edb4","releaseDate":"2026-10-01","releaseDateSource":"manifest","version":"26.10.1"},{"architectures":["x64"],"detailPath":"versions/26.9.26/app.json","detailSha256":"ad6a5ecac6f