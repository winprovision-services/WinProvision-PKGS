{"defaultLocale":"en-US","id":"LogTag.LogTagXpress","installers":[{"appsAndFeaturesEntries":[{"InstallerType":"msi","UpgradeCode":"{9AC95DE8-A823-467A-99F7-A164913D12DE}"}],"architecture":"x86","dependencies":[{"PackageDependencies":[{"PackageIdentifier":"Microsoft.VCRedist.2015+.x86"}]}],"elevation":{"requirement":"elevationRequired","source":"inferred"},"expectedReturnCodes":[{"InstallerReturnCode":-1,"ReturnResponse":"cancelledByUser"},{"InstallerReturnCode":1,"ReturnResponse":"invalidParameter"},{"InstallerReturnCode":87,"ReturnResponse":"invalidParameter"},{"InstallerReturnCode":1601,"ReturnResponse":"contactSupport"},{"InstallerReturnCode":1602,"ReturnResponse":"cancelledByUser"},{"InstallerReturnCode":1618,"ReturnResponse":"installInProgress"},{"InstallerReturnCode":1623,"ReturnResponse":"systemNotSupported"},{"InstallerReturnCode":1625,"ReturnResponse":"blockedByPolicy"},{"InstallerReturnCode":1628,"ReturnResponse":"invalidParameter"},{"InstallerReturnCode":1633,"ReturnResponse":"systemNotSupported"},{"InstallerReturnCode":1638,"ReturnResponse":"alreadyInstalled"},{"InstallerReturnCode":1639,"ReturnResponse":"invalidParameter"},{"InstallerReturnCode":1641,"ReturnResponse":"rebootInitiated"},{"InstallerReturnCode":1640,"ReturnResponse":"blockedByPolicy"},{"InstallerReturnCode":1643,"ReturnResponse":"blockedByPolicy"},{"InstallerReturnCode":1644,"ReturnResponse":"blockedByPolicy"},{"InstallerReturnCode":1649,"ReturnResponse":"blockedByPolicy"},{"InstallerReturnCode":1650,"ReturnResponse":"invalidParameter"},{"InstallerReturnCode":1654,"ReturnResponse":"systemNotSupported"},{"InstallerReturnCode":3010,"ReturnResponse":"rebootRequiredToFinish"}],"fileExtensions":["config"],"id":"x86-machine-zip","installModes":["interactive","silent","silentWithProgress"],"installerSwitches":{"InstallLocation":"APPDIR=\"<INSTALLPATH>\"","Log":"/log \"<LOGPATH>\"","Silent":"/exenoui /quiet /norestart","SilentWithProgress":"/exenoui /passive /norestart"},"nestedInstallerFiles":[{"RelativeFilePath":"LTXpress_12r6.exe"}],"nestedInstallerType":"exe","priority":4,"scope":"machine","sha256":"f3555cce7190fa88d9d7d7de69684104ba970b2e5b5778d551e6d3770c8fd29a","silent":{"arguments":"/exenoui /quiet /norestart","source":"manifest"},"successCodes":[],"type":"zip","uninstall":{"type":"productCode","value":"{E94D8424-17AD-43CB-A125-C16DFCE8EA55}"},"url":"https://logtagrecorders.com/app/uploads/2023/09/LTXpress_12r6-2.zip"}],"licenseUrl":"https://logtagrecorders.com/software-license/","packageLocalizations":{"en-US":{"description":"A sophisticated lightweight alternative to the powerful LogTag Analyzer software, that deliberately comes without a rich feature set and instead focuses on as little interaction required as possible.","license":"Proprietary","licenseUrl":"https://logtagrecorders.com/software-license/","locale":"en-US","longDescription":"LogTag Xpress is a sophisticated alternative to the powerful LogTag Analyzer software. With a stripped-down feature set, LogTag Xpress focuses on efficiently configuring and downloading the complete range of LogTag data logging products, with as little user interaction as possible. You can use this program to quickly and efficiently arrange data to be downloaded, assessed and transferred to other information stakeholders, and to automatically re-configure the logger with little or no user input. LogTag Xpress is ideally suited to applications such as shipment data monitoring which may require quick data upload to LogTag Online without creating an account. Automatically download, upload and reconfigure LogTag loggers. Automatically upload to LogTag Online (LTO), via FTP or email files upon download. Export from multiple customizable file types including LTD, PDF and CSV.","name":"LogTag Xpress","packageUrl":"https://logtagrecorders.com/software/logtag-xpress/","publisher":"LogTag Recorders","publisherUrl":"https://logtagrecorders.com/","releaseNotesUrl":"https://logtagrecorders.com/dss/release-notes/","tags":[]},"zh-CN":{"description":"一款精巧轻量的替代方案，旨在取代功能强大的 LogTag Analyzer 软件。其设计理念刻意摒弃繁复功能，专注于实现极简交互体验。","license":"专有软件","locale":"zh-CN","longDescription":"LogTag Xpress 是功能强大的 LogTag Analyzer 软件的一个精简替代方案。通过精简的功能集，LogTag Xpress 专注于高效配置和下载完整系列的 LogTag 数据记录产品，并尽可能减少用户交互。您可以使用此程序快速高效地整理数据，进行下载、评估并传输给其他信息相关方，同时几乎无需用户输入即可自动重新配置记录器。LogTag Xpress 非常适合如运输数据监控等应用场景，这些场景可能需要快速将数据上传至 LogTag Online 而无需创建账户。自动下载、上传并重新配置 LogTag 记录器。通过 FTP 或电子邮件在下载时自动上传至 LogTag Online (LTO)。支持从包括 LTD、PDF 和 CSV 在内的多种可自定义文件类型中导出。","tags":[]}},"publisherUrl":"https://logtagrecorders.com/","releaseNotesUrl":"https://logtagrecorders.com/dss/release-notes/","schemaVersion":1,"source":"winget","upstream":{"commit":"97d6aa2689f0a05f7847653a62b8624720d15b5d","manifestVersion":"1.10.0","manifests":[{"path":"manifests/l/LogTag/LogTagXpress/1.2.6.2/LogTag.LogTagXpress.yaml","sha256":"dbd4016474fdec652e7e98e20820e9ae3773795bcedfbbbb6eb71996770d0982"},{"path":"manifests/l/LogTag/LogTagXpress/1.2.6.2/LogTag.LogTagXpress.installer.yaml","sha256":"d9ea2e8be2bac5e10c96c7d8566ac02f41f8c2b3377c320e20db81a5c6edc48f"},{"path":"manifests/l/LogTag/LogTagXpress/1.2.6.2/LogTag.LogTagXpress.locale.en-US.yaml","sha256":"030d685ed17f7a6298f55b52e4b9606f00fa946cd4ad7478fbfa22d4b5a3bb29"},{"path":"manifests/l/LogTag/LogTagXpress/1.2.6.2/LogTag.LogTagXpress.locale.zh-CN.yaml","sha256":"d057fab0bc2ea981ee07ce20d24618e2249519b1951a773cfa051e7d4432815a"}],"repository":"microsoft/winget-pkgs"},"version":"1.2.6.2"}