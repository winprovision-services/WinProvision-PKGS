start"},"priority":1,"protocols":["lztnavpn","ncpsaml"],"scope":"machine","sha256":"3be63daaf76442dc00d8ab77bac7e11b0c0786b0a91e5be7c1e51d71f189933f","silent":{"arguments":"/S /V/quiet /V/norestart","source":"manifest"},"successCodes":[3010],"type":"exe","uninstall":{"type":"productCode","value":"{9D0B2D07-B79D-41AA-9C6A-F46EF86E55BF}"},"url":"https://www.lancom-systems.com/fileadmin/download/LC-Trusted-Access-Client/LC-Trusted-Access-Client-Win-625-Rel-x86-64.exe"}],"licenseUrl":"https://www.lancom-systems.com/pdf/LCS/LANCOM-general-terms-and-conditions.pdf","packageLocalizations":{"en-US":{"description":"Cloud-managed secure network access","license":"Proprietary","licenseUrl":"https://www.lancom-systems.com/pdf/LCS/LANCOM-general-terms-and-conditions.pdf","locale":"en-US","longDescription":"LANCOM Trusted Access is the trusted network access security solution for enterprise networks. It enables secure and scalable access to enterprise applications for employees in the office, at home, or on the road, protecting modern hybrid working from anywhere, anytime. The LANCOM Trusted Access solution adapts to increasing security requirements in your organization and enables both cloud-managed VPN client networking for access to entire networks and the move to a Zero Trust security architecture for comprehensive network security. Based on granular access rights, users are only granted access to applications that have been assigned to them (Zero Trust principle). Existing systems for managing users and user groups (Active Directory) can be fully integrated into the LANCOM Management Cloud (LMC). For smaller networks, the LMC alternatively offers internal user management. LANCOM Trusted Access 100% GDPR compliant and scales for small businesses as well as for very large networks with several thousand users.","name":"LANCOM Trusted Access Client","packageUrl":"https://www.lancom-systems.com/products/remote-mobile-access/lancom-trusted-access-client","publisher":"NCP engineering GmbH","publisherUrl":"https://www.lancom-systems.com/","releaseNotesUrl":"https://www.lancom-systems.com/fileadmin/download/LC-Trusted-Access-Client/RN_LTA-Client-Windows-625-Rel_EN.pdf","tags":["network","security","vpn"]},"zh-CN":{"description":"云托管安全网络接入","license":"专有软件","locale":"zh-CN","longDescription":"LANCOM Trusted Access 是企业网络可信赖的接入安全解决方案。该方案能为办公室、居家或移动办公的员工提供安全可扩展的企业应用访问，全方位保障现代混合办公模式的安全。LANCOM Trusted Access 可灵活适应企业不断增长的安全需求，既支持通过云管理 VPN 客户端实现整网访问，又能过渡到零信任安全架构实现全面网络安全防护。基于细粒度权限控制，用户仅能访问被授权的应用（零信任原则）。现有用户及用户组管理系统（Active Directory）可完全集成至 LANCOM 管理云平台（LMC），小型网络也可选择使用 LMC 内置的用户管理功能。该方案 100% 符合 GDPR 规范，既能满足小型企业需求，也能支撑数千用户规模的超大型网络部署。","tags":["vpn","安全","网络"]}},"publisherUrl":"https://www.lancom-systems.com/","releaseNotesUrl":"https://www.lancom-systems.com/fileadmin/download/LC-Trusted-Access-Client/RN_LTA-Client-Windows-625-Rel_EN.pdf","schemaVersion":1,"source":"winget","upstream":{"commit":"97d6aa2689f0a05f7847653a62b8624720d15b5d","manifestVersion":"1.12.0","manifests":[{"path":"manifests/l/LANCOM/TrustedAccessClient/6.25.30791/LANCOM.TrustedAccessClient.yaml","sha256":"c669fcc5d8fe9b711a04a0183809eb605b03bbaf8027f7548bf8f9694899980f"},{"path":"manifests/l/LANCOM/TrustedAccessClient/6.25.30791/LANCOM.TrustedAccessClient.installer.yaml","sha256":"1e2aa9d026fff4051f3c28a3e3fa1bc42d3b20285631ff82716089b02d95530c"},{"path":"manifests/l/LANCOM/TrustedAccessClient/6.25.30791/LANCOM.TrustedAccessClient.locale.en-US.yaml","sha256":"9d54529c775f8762fd2ccf0f556bc872edbe2bb6208f5e8aeac587bb042a70cb"},{"path":"manifests/l/LANCOM/TrustedAccessClient/6.25.30791/LANCOM.TrustedAccessClient.locale.zh-CN.yaml","sha256":"a54d08c25edb73b5e2a8e783f8be700ba8c87e09cedffbe25ce1ea985cf7fc0f"}],"repository":"microsoft/winget-pkgs"},"version":"6.25.30791"}