{"architectures":["arm64","x64","x86"],"id":"LibreWolf.LibreWolf","latestVersion":"159.0.1-1","media":{"icons":[],"screenshots":[]},"package":{"description":"A custom version of Firefox, focused on privacy, security and freedom.","license":"MPL-2.0","licenseUrl":"https://librewolf.net/license-disclaimers/","locale":"en-US","localizations":{"en-US":{"description":"A custom version of Firefox, focused on privacy, security and freedom.","license":"MPL-2.0","licenseUrl":"https://librewolf.net/license-disclaimers/","locale":"en-US","longDescription":"This project is a custom and independent version of Firefox, with the primary goals of privacy, security and user freedom.\nLibreWolf is designed to increase protection against tracking and fingerprinting techniques, while also including a few security improvements. This is achieved through our privacy and security oriented settings and patches. LibreWolf also aims to remove all the telemetry, data collection and annoyances, as well as disabling anti-freedom features like DRM.","moniker":"librewolf","name":"LibreWolf","packageUrl":"https://librewolf.net/","publisher":"LibreWolf","publisherUrl":"https://librewolf.net/","releaseNotesUrl":"https://codeberg.org/librewolf/bsys6/releases/tag/159.0.1-1","tags":["browser","firefox","gecko","internet","quantum","spidermonkey","web","web-browser","webpage"]},"zh-CN":{"description":"火狐浏览器的定制版本，注重隐私、安全和自由。","locale":"zh-CN","longDescription":"该项目是火狐浏览器的一个独立定制版本，主要目标是保护隐私、确保安全和用户自由。\nLibreWolf 旨在加强对抗跟踪和指纹技术，同时还包括一些安全方面的改进。这些都是通过我们以隐私和安全为导向的设置和补丁实现的。LibreWolf 还旨在移除所有遥测、数据收集和干扰，以及禁用 DRM 等反自由功能。","tags":["gecko","quantum","spidermonkey","浏览器","火狐","火狐浏览器","网页","网页浏览器"]}},"longDescription":"This project is a custom and independent version of Firefox, with the primary goals of privacy, security and user freedom.\nLibreWolf is designed to increase protection against tracking and fingerprinting techniques, while also including a few security improvements. This is achieved through our privacy and security oriented settings and patches. LibreWolf also aims to remove all the telemetry, data collection and annoyances, as well as disabling anti-freedom features like DRM.","moniker":"librewolf","name":"LibreWolf","packageUrl":"https://librewolf.net/","publisher":"LibreWolf","publisherUrl":"https://librewolf.net/","releaseNotesUrl":"https://codeberg.org/librewolf/bsys6/releases/tag/159.0.1-1","tags":["browser","firefox","gecko","internet","quantum","spidermonkey","web","web-browser","webpage"]},"schemaVersion":1,"source":"winget","versions":[{"architectures":["arm64","x64"],"detailPath":"versions/159.0.1-1/app.json","detailSha256":"00db5276ec6cd79973847280806f175d3c59df3dd2226ceb16c6d4eaa035a841","releaseDate":"2026-10-28","releaseDateSource":"manifest","version":"159.0.1-1"},{"architectures":["arm64","x64"],"detailPath":"versions/159.0-1/app.json","detailSha256":"66283b4cf1f70bb597b2b9f35308d8110cf928b74538db096d01121c75a93418","releaseDate":"2026-10-27","releaseDateSource":"manifest","version":"159.0-1"},{"architectures":["arm64","x64"],"detailPath":"versions/158.0.1-2/app.json","detailSha256":"89a690c36002c56396c1b88b0c6dd387d293570244cedd74e08a430bda580092","releaseDate":"2026-10-16","releaseDateSource":"manifest","version":"158.0.1-2"},{"architectures":["arm64","x64"],"detailPath":"versions/158.0.1-1/app.json","detailSha256":"0d4148ef7a89757b1fa8a2544fcd95424d3c3ab60c461194e95e6ced4066dd99","releaseDate":"2026-10-16","releaseDateSource":"manifest","version":"158.0.1-1"},{"architectures":["arm64","x64"],"detailPath":"versions/158.0-1/app.json","detailSha256":"533d9c24ee03da5662b190e775b55c3c3b10c7d3ca34e296e35697209c73b6d6","releaseDate":"2026-10-13","releaseDateSource":"manifest","version":"158.0-1"},{"architectures":["arm64","x64"],"detailPath":"versions/157.0.1-1/app.json","detailSha256":"6464ec2a2be8ed5b44b207eecf304948f3172b9717c850fff35a1473d87790c0","releaseDate":"2026-10-05","releaseDateSource":"manifest","version":"157.0.1-1"},{"architectures":["arm