ype":"productCode","value":"{97644DA6-1889-4132-9F4D-7895DB659745}"},"upgradeBehavior":"install","url":"https://cdn.textexpander.com/electron-windows/908.6.999.0/TextExpander_x86.msi"},{"appsAndFeaturesEntries":[{"UpgradeCode":"{F6F4E16E-F3FD-4CD1-A4E5-587808F9C886}"}],"architecture":"x64","dependencies":[],"elevation":{"requirement":"elevationRequired","source":"inferred"},"id":"x64-machine-wix","priority":2,"protocols":["textexpander","web+textexpander"],"scope":"machine","sha256":"dffc3278b609d8b3bf0b4f777efe850e619fba33739bea53c90da561e513f768","silent":{"arguments":"/quiet /norestart","source":"default"},"successCodes":[],"type":"wix","uninstall":{"type":"productCode","value":"{3D85A8F8-5FBD-4C99-A49B-BA00D144077E}"},"upgradeBehavior":"install","url":"https://cdn.textexpander.com/electron-windows/908.6.999.0/TextExpander_x64.msi"}],"licenseUrl":"https://textexpander.com/terms","packageLocalizations":{"en-US":{"author":"TextExpander, Inc.","copyright":"Copyright © 2006-2026 TextExpander, Inc. TextExpander is a registered trademark.","copyrightUrl":"https://textexpander.com/terms","description":"Create snippets of text for support responses, sales outreach, or even common emails and save them in TextExpander.","documentations":[{"DocumentLabel":"Learning Center","DocumentUrl":"https://textexpander.com/learn"}],"license":"Proprietary","licenseUrl":"https://textexpander.com/terms","locale":"en-US","name":"TextExpander","packageUrl":"https://textexpander.com/download","privacyUrl":"https://textexpander.com/privacy","publisher":"TextExpander, Inc.","publisherSupportUrl":"https://textexpander.com/contact","publisherUrl":"https://textexpander.com/","purchaseUrl":"https://textexpander.com/pricing","releaseNotes":"What's new in TextExpander 8.6\nImprovements\n- Labels for Conditional Sections. Give a Conditional Section a label in the branch manager. The label shows on the section in the editor and next to the branch dropdown when you expand the snippet, so you know what you’re choosing.\n- Search finds text in every branch. Search now matches text inside every branch of a Conditional Section, including nested ones, not only the branch shown by default.\n- Updated sign-in screen. The sign-in screen matches the app’s new design.\n- Other improvements: Conditional Sections use new design colors in light and dark mode. The About window shows a simpler version number.\nBug fixes\n- Clipboard content from password managers. The Clipboard macro now inserts content copied from password managers, and TextExpander restores your clipboard after the expansion, then clears sensitive content after 90 seconds.\n- Show at top with Conditional Sections. With Show at top turned on, the fill-in window now shows only the fill-ins from the branch you select. Fill-ins from other branches no longer appear, and fields in the selected branch no longer show twice.\n- Quick Actions on multiple displays. New Snippet, New from Clipboard, and Edit Last now open on the display you’re using.\n- Reusing a cleared hotkey. After you clear a hotkey, you can assign the same key combination again without relaunching TextExpander.\nSecurity\n- Updated third-party components, including the app runtime, to address published security advisories.","tags":["text-expander"]},"zh-CN":{"description":"为客服回答、销售推广乃至常用电子邮件创建文本片段，并将其保存在 TextExpander 中。","documentations":[{"DocumentLabel":"学习中心","DocumentUrl":"https://textexpander.com/learn"}],"license":"专有软件","locale":"zh-CN","tags":["文本扩展器"]}},"publisherSupportUrl":"https://textexpander.com/contact","publisherUrl":"https://textexpander.com/","releaseDate":"2026-11-04","releaseDateSource":"commit","schemaVersion":1,"source":"winget","upstream":{"commit":"8ab5b6a34a787eee24b0430c2fbd72515bd43638","manifestVersion":"1.28.0","manifests":[{"path":"manifests/t/TextExpander/TextExpander/254.8.6.999/TextExpander.TextExpander.installer.yaml","sha256":"9fb3076e7bab4851863795884bc3b5bd9e2571707439cea63ce311df92809c0c"},{"path":"manifests/t/T