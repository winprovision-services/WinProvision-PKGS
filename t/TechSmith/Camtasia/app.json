{"architectures":["x64","x86"],"id":"TechSmith.Camtasia","latestVersion":"26.2.5.21144","media":{"icons":[{"mimeType":"image/png","path":"media/icon.ede9a832.png","priority":1,"sha256":"ede9a83272c5a3e46a283ca579debcd1a96a14ffde8d243ed07bf644b6886353","source":"winget-legacy"}],"screenshots":[]},"package":{"description":"The best all-in-one screen recorder and video editor. Record your screen, add video effects, transitions and more.","license":"Proprietary","licenseUrl":"https://www.techsmith.com/camtasia-eula.html","locale":"en-US","localizations":{"en-US":{"description":"The best all-in-one screen recorder and video editor. Record your screen, add video effects, transitions and more.","license":"Proprietary","licenseUrl":"https://www.techsmith.com/camtasia-eula.html","locale":"en-US","longDescription":"Camtasia is a video-based screen capture program that enables users to demonstrate and communicate ideas or share knowledge using video. From quick video demos to extensive video projects, Camtasia has a wide range of editing tools to create video content from a variety of sources. Users can record from webcam or screen, introduce a variety of effects, and easily share videos over multiple channels.","moniker":"camtasia","name":"Camtasia","packageUrl":"https://www.techsmith.com/camtasia/","publisher":"TechSmith Corporation","publisherUrl":"https://www.techsmith.com/","releaseNotesUrl":"https://support.techsmith.com/hc/articles/41261973472269","tags":["capture","record","recording","screen-capture","screen-record","screencast","screenshot","video"]},"zh-CN":{"description":"最佳多合一屏幕录制器和视频编辑器。录制屏幕，添加视频特效、转场效果等。","license":"专有软件","locale":"zh-CN","longDescription":"Camtasia 是一款基于视频的屏幕捕获程序，用户可以用它来演示和交流想法，或通过视频分享知识。无论是快速视频演示，还是大型视频项目，Camtasia 都有对应的编辑工具，可从各种来源创建视频内容。用户可以通过网络摄像头或屏幕进行录制，引入各种特效，并轻松分享视频到多个频道。","tags":["屏幕录制","录制","录屏","截图","捕获","视频"]}},"longDescription":"Camtasia is a video-based screen capture program that enables users to demonstrate and communicate ideas or share knowledge using video. From quick video demos to extensive video projects, Camtasia has a wide range of editing tools to create video content from a variety of sources. Users can record from webcam or screen, introduce a variety of effects, and easily share videos over multiple channels.","moniker":"camtasia","name":"Camtasia","packageUrl":"https://www.techsmith.com/camtasia/","publisher":"TechSmith Corporation","publisherUrl":"https://www.techsmith.com/","releaseNotesUrl":"https://support.techsmith.com/hc/articles/41261973472269","tags":["capture","record","recording","screen-capture","screen-record","screencast","screenshot","video"]},"schemaVersion":1,"source":"winget","versions":[{"architectures":["x64"],"detailPath":"versions/26.2.5.21144/app.json","detailSha256":"0528942acfed815bef206ed11c8c87d67b969ec9999f16c3495f72d62b140fa0","releaseDate":"2026-11-03","releaseDateSource":"manifest","version":"26.2.5.21144"},{"architectures":["x64"],"detailPath":"versions/26.2.4.20997/app.json","detailSha256":"7d5f485713f881e570bd52c2e0447484fbfb5400e96bf5c013964d4f22d5fbb4","releaseDate":"2026-10-28","releaseDateSource":"manifest","version":"26.2.4.20997"},{"architectures":["x64"],"detailPath":"versions/26.2.3.20804/app.json","detailSha256":"cebe1a72eefb2f2f60270472967766ecffe2ac261e50cca381798763158f69cc","releaseDate":"2026-10-22","releaseDateSource":"manifest","version":"26.2.3.20804"},{"architectures":["x64"],"detailPath":"versions/26.2.2.19936/app.json","detailSha256":"751d5d497181c653b69360d850e4d878c5e29cc7afd74afaa3e975f4d7ef672a","releaseDate":"2026-09-22","releaseDateSource":"manifest","version":"26.2.2.19936"},{"architectures":["x64"],"detailPath":"versions/26.2.1.19299/app.json","detailSha256":"9d3b6eab8bdec80336283ca1709556ba4ed1ed5ae01cad7302d8ea20bb9c7067","releaseDate":"2026-08-18","releaseDateSource":"manifest","version":"26.2.1.19299"},{"architectures":["x64"],"detailPath":"versions/26.2.0.19099/app.json","detailSha256":"29d785208d4686a8517226d27d90