rt","source":"default"},"successCodes":[],"type":"wix","uninstall":{"type":"productCode","value":"{9EB4260F-F0F7-42F0-99D1-3A48536E33DF}"},"upgradeBehavior":"install","url":"https://downloads.pdf-xchange.com/11.0.1.0/EditorV11.x86.msi"}],"licenseUrl":"https://www.pdf-xchange.com/terms-of-use","packageLocalizations":{"en-US":{"description":"The smallest, fastest and most feature-rich free PDF viewer/editor on the market.","license":"Proprietary","licenseUrl":"https://www.pdf-xchange.com/terms-of-use","locale":"en-US","longDescription":"PDF-XChange Editor is a fast, lightweight, and feature-rich PDF viewer, editor, and annotation tool for Windows. It is known for its high performance and extensive functionality, positioning itself as a powerful alternative to Adobe Acrobat.\n\nKey Features:\n- Editing Tools: Directly edit text and images in PDF documents.\n- Annotation & Markup: A vast array of tools for highlighting, adding comments, stamps, shapes, and handwritten notes.\n- OCR (Optical Character Recognition): Convert scanned documents into searchable and editable text.\n- Form Creation & Filling: Create, edit, and fill interactive PDF forms.\n- Security Features: Add passwords, redact sensitive information, and manage digital signatures.\n- Customization: Highly customizable interface and toolbar layouts.\n- Low System Impact: Noted for its small footprint and fast operation, even with large files.","name":"PDF-XChange Editor","packageUrl":"https://www.pdf-xchange.com/product/pdf-xchange-editor","publisher":"PDF-XChange Co Ltd.","publisherUrl":"https://www.pdf-xchange.com/","releaseNotesUrl":"https://www.pdf-xchange.com/product/pdf-xchange-editor/history?build=11.0.1.0","tags":["annotate","annotation","comment","ebook","edit","editor","ocr","pdf","read","reader","viewer"]},"zh-CN":{"description":"市场上体积最小、速度最快、功能最丰富的免费 PDF 查看器/编辑器。","license":"专有软件","locale":"zh-CN","longDescription":"PDF-XChange Editor 是一款适用于 Windows 系统的快速、轻量且功能丰富的 PDF 查看、编辑和注释工具。它以高性能和广泛的功能著称，是 Adobe Acrobat 的强力替代方案。\n\n主要特性：\n- 编辑工具：直接编辑 PDF 文档中的文本和图像。\n- 注释与标记：提供丰富的工具用于高亮、添加评论、印章、形状和手写笔记。\n- OCR（光学字符识别）：将扫描文档转换为可搜索且可编辑的文本。\n- 表单创建与填写：创建、编辑并填写交互式 PDF 表单。\n- 安全特性：添加密码、涂黑敏感信息以及管理数字签名。\n- 自定义：高度可定制的界面和工具栏布局。\n- 低系统占用：以占用空间小、运行速度快著称，即使处理大型文件也是如此。","tags":["ocr","pdf","批注","查看器","标注","注释","电子书","编辑","编辑器","阅读","阅读器"]}},"publisherUrl":"https://www.pdf-xchange.com/","releaseDate":"2026-06-08","releaseDateSource":"manifest","releaseNotesUrl":"https://www.pdf-xchange.com/product/pdf-xchange-editor/history?build=11.0.1.0","schemaVersion":1,"source":"winget","upstream":{"commit":"97d6aa2689f0a05f7847653a62b8624720d15b5d","manifestVersion":"1.12.0","manifests":[{"path":"manifests/t/TrackerSoftware/PDF-XChangeEditor/11.0.1.0/TrackerSoftware.PDF-XChangeEditor.yaml","sha256":"705ae7f61e0239509dbcea5b58eb444b358e2ec87e359ca22df68ddb11a3ccbf"},{"path":"manifests/t/TrackerSoftware/PDF-XChangeEditor/11.0.1.0/TrackerSoftware.PDF-XChangeEditor.installer.yaml","sha256":"241d73309fcdc60e8a1ec6bad4487e9e5d314d8f893c4d5caf348876625dd0a0"},{"path":"manifests/t/TrackerSoftware/PDF-XChangeEditor/11.0.1.0/TrackerSoftware.PDF-XChangeEditor.locale.en-US.yaml","sha256":"6d0bfc9ee4976303822d3bdbd8ed6f81722a118b95cb23d8384356ca277f0292"},{"path":"manifests/t/TrackerSoftware/PDF-XChangeEditor/11.0.1.0/TrackerSoftware.PDF-XChangeEditor.locale.zh-CN.yaml","sha256":"f5302945b1e7d80b7b94347160d0e3c530682dbfe5a04fc140d050d049e03a9f"}],"repository":"microsoft/winget-pkgs"},"version":"11.0.1.0"}