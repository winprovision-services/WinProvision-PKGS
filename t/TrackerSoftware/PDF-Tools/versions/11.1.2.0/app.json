,"xfdf","xps"],"id":"arm64-machine-wix","installationMetadata":{"DefaultInstallLocation":"%ProgramFiles%/Tracker Software"},"priority":2,"protocols":["pxce"],"scope":"machine","sha256":"7f9faa2e0a705d70ee30b7e00c29326add741047a2134569c609e1d43c9a873e","silent":{"arguments":"/quiet /norestart","source":"default"},"successCodes":[],"type":"wix","uninstall":{"type":"productCode","value":"{54E87880-D854-4BB3-B4B5-8445C6B38A24}"},"upgradeBehavior":"install","url":"https://downloads.pdf-xchange.com/11.1.2.0/ToolsV11.ARM64.msi"}],"licenseUrl":"https://www.pdf-xchange.com/terms-of-use","packageLocalizations":{"en-US":{"author":"PDF-XChange Co Ltd.","copyright":"Copyright © 2001-26 by PDF-XChange Co Ltd.","copyrightUrl":"https://www.pdf-xchange.com/terms-of-use","description":"A flexible, powerful and wizard-driven application for the batch creation, manipulation and modification of PDF files - ideal for working with large PDFs or a number of PDFs simultaneously.","documentations":[{"DocumentLabel":"Help","DocumentUrl":"https://help.pdf-xchange.com/"},{"DocumentLabel":"Knowledge Base","DocumentUrl":"https://www.pdf-xchange.com/knowledgebase"}],"license":"Proprietary","licenseUrl":"https://www.pdf-xchange.com/terms-of-use","locale":"en-US","longDescription":"PDF-Tools is a dynamic and user-friendly solution for the creation and manipulation of PDF and image files. It features eighty-eight default tools, as well as the option to clone, edit and create fully-customizable tools, which makes it the ideal software to complement your existing PDF facilities. Two additional PDF-XChange applications are included with this product:\nPDF-XChange Editor – one of the fastest and most feature-rich applications used worldwide to create, view, edit and annotate PDF files.\nPDF-XChange Lite – our award-winning technology that installs as a virtual printer, and can be used to print-to-PDF from Windows applications. It features an optimized hybrid engine that significantly increases the quality of conversion for images and image-based text characters, and prints to both GDI and XPS.","name":"PDF-Tools","packageUrl":"https://www.tracker-software.com/product/pdf-tools","privacyUrl":"https://www.pdf-xchange.com/privacy-policy","publisher":"PDF-XChange Co Ltd.","publisherSupportUrl":"https://www.pdf-xchange.com/support","publisherUrl":"https://www.pdf-xchange.com/","purchaseUrl":"https://www.pdf-xchange.com/product/pdf-tools/pricing","releaseNotesUrl":"https://www.pdf-xchange.com/product/pdf-tools/history","tags":["annotate","annotation","comment","conversion","convert","ebook","edit","editor","ocr","pdf","read","reader","viewer"]},"zh-CN":{"description":"一款灵活且功能强大的向导式应用程序，专门用于批量创建、处理及修改 PDF 文件。它是处理大型 PDF 文件或同时处理多个 PDF 文件的理想选择。","documentations":[{"DocumentLabel":"帮助","DocumentUrl":"https://help.pdf-xchange.com/"},{"DocumentLabel":"知识库","DocumentUrl":"https://www.pdf-xchange.com/knowledgebase"}],"license":"专有软件","locale":"zh-CN","longDescription":"PDF-Tools 是一款功能强大且易于使用的解决方案，用于创建和处理 PDF 及图像文件。它内置了 88 个默认工具，并支持对工具进行克隆、编辑以及创建完全自定义的工具，是完善您现有 PDF 设施的理想软件。本产品还附带了另外两个 PDF-XChange 应用程序：\nPDF-XChange Editor —— 全球范围内速度最快、功能最丰富的应用程序之一，用于创建、查看、编辑和批注 PDF 文件。\nPDF-XChange Lite —— 我们屡获殊荣的技术，可作为虚拟打印机安装，能够从 Windows 应用程序中执行“打印到 PDF”。它采用了优化的混合引擎，显著提升了图像及基于图像的文本字符的转换质量，并支持打印到 GDI 和 XPS。","tags":["ocr","pdf","批注","查看器","标注","注释","电子书","编辑","编辑器","转换","阅读","阅读器"]}},"publisherSupportUrl":"https://www.pdf-xchange.com/support","publisherUrl":"https://www.pdf-xchange.com/","releaseDate":"2026-11-11","releaseDateSource":"commit","releaseNotesUrl":"https://www.pdf-xchange.com/product/pdf-tools/history","schemaVersion":1,"source":"winget","upstream":{"commit":"06fe0c1922ea63380b4e7a9b4a957cc117ac9fe3","manifestVersion":"1.28.0","manifests":[{"path":"manifests/t/TrackerSoftware/PDF-Tools/11.1.2.0/TrackerSoftware.PDF-Tools.installer.yaml","sha256":"84b849fc3e07a9a419c7ceb1b3b7d7426b00bbfd619cd441e72e7d2fd57a7764"},{"path":"manifests/t/TrackerSoftware/PDF-Tools/11.1.2.0/TrackerSoftware.PD