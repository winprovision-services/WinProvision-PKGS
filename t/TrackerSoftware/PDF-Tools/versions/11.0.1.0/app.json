lent":{"arguments":"/quiet /norestart","source":"default"},"successCodes":[],"type":"wix","uninstall":{"type":"productCode","value":"{AFA3D823-EC68-4683-B783-44A7C63B4716}"},"upgradeBehavior":"install","url":"https://downloads.pdf-xchange.com/11.0.1.0/ToolsV11.x86.msi"}],"licenseUrl":"https://www.pdf-xchange.com/terms-of-use","packageLocalizations":{"en-US":{"description":"A flexible, powerful and wizard-driven application for the batch creation, manipulation and modification of PDF files - ideal for working with large PDFs or a number of PDFs simultaneously.","license":"Proprietary","licenseUrl":"https://www.pdf-xchange.com/terms-of-use","locale":"en-US","longDescription":"PDF-Tools is a dynamic and user-friendly solution for the creation and manipulation of PDF and image files. It features eighty-eight default tools, as well as the option to clone, edit and create fully-customizable tools, which makes it the ideal software to complement your existing PDF facilities. Two additional PDF-XChange applications are included with this product:\nPDF-XChange Editor – one of the fastest and most feature-rich applications used worldwide to create, view, edit and annotate PDF files.\nPDF-XChange Lite – our award-winning technology that installs as a virtual printer, and can be used to print-to-PDF from Windows applications. It features an optimized hybrid engine that significantly increases the quality of conversion for images and image-based text characters, and prints to both GDI and XPS.","name":"PDF-Tools","packageUrl":"https://www.tracker-software.com/product/pdf-tools","publisher":"PDF-XChange Co Ltd.","publisherUrl":"https://www.pdf-xchange.com/","releaseNotesUrl":"https://www.pdf-xchange.com/product/pdf-tools/history?build=11.0.1.0","tags":["annotate","annotation","comment","conversion","convert","ebook","edit","editor","ocr","pdf","read","reader","viewer"]},"zh-CN":{"description":"一款灵活且功能强大的向导式应用程序，专门用于批量创建、处理及修改 PDF 文件。它是处理大型 PDF 文件或同时处理多个 PDF 文件的理想选择。","license":"专有软件","locale":"zh-CN","longDescription":"PDF-Tools 是一款功能强大且易于使用的解决方案，用于创建和处理 PDF 及图像文件。它内置了 88 个默认工具，并支持对工具进行克隆、编辑以及创建完全自定义的工具，是完善您现有 PDF 设施的理想软件。本产品还附带了另外两个 PDF-XChange 应用程序：\nPDF-XChange Editor —— 全球范围内速度最快、功能最丰富的应用程序之一，用于创建、查看、编辑和批注 PDF 文件。\nPDF-XChange Lite —— 我们屡获殊荣的技术，可作为虚拟打印机安装，能够从 Windows 应用程序中执行“打印到 PDF”。它采用了优化的混合引擎，显著提升了图像及基于图像的文本字符的转换质量，并支持打印到 GDI 和 XPS。","tags":["ocr","pdf","批注","查看器","标注","注释","电子书","编辑","编辑器","转换","阅读","阅读器"]}},"publisherUrl":"https://www.pdf-xchange.com/","releaseDate":"2026-06-09","releaseDateSource":"manifest","releaseNotesUrl":"https://www.pdf-xchange.com/product/pdf-tools/history?build=11.0.1.0","schemaVersion":1,"source":"winget","upstream":{"commit":"97d6aa2689f0a05f7847653a62b8624720d15b5d","manifestVersion":"1.12.0","manifests":[{"path":"manifests/t/TrackerSoftware/PDF-Tools/11.0.1.0/TrackerSoftware.PDF-Tools.yaml","sha256":"351f9488ac31f2eacc2326aee5048e079d4858deb81a8ce522ba529b6881bf02"},{"path":"manifests/t/TrackerSoftware/PDF-Tools/11.0.1.0/TrackerSoftware.PDF-Tools.installer.yaml","sha256":"0c58472029ed105be6f4d951e5999ff1312e91b7bdd6d46909eba16f8df6612e"},{"path":"manifests/t/TrackerSoftware/PDF-Tools/11.0.1.0/TrackerSoftware.PDF-Tools.locale.en-US.yaml","sha256":"05ea0c3bfe710e5a2301bd5e55d23a6885bc6ae5396171c889e58fa166f061d8"},{"path":"manifests/t/TrackerSoftware/PDF-Tools/11.0.1.0/TrackerSoftware.PDF-Tools.locale.zh-CN.yaml","sha256":"cc24e46f5459fa08911b24031be088bc0545022e3539bcdd9698d85ca2006791"}],"repository":"microsoft/winget-pkgs"},"version":"11.0.1.0"}