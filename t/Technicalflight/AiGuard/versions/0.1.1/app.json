{"defaultLocale":"zh-CN","id":"Technicalflight.AiGuard","installers":[{"architecture":"x64","dependencies":[],"id":"x64-user-nullsoft","priority":1,"scope":"user","sha256":"496095db691ccf9329835cfda1306f7fe560afa47d5169c2d1cef25b1e6e17de","silent":{"arguments":"/S","source":"default"},"successCodes":[],"type":"nullsoft","uninstall":{"type":"productCode","value":"AI 安全卫士"},"url":"https://github.com/Technicalflight/AiGuard/releases/download/v0.1.1/AI._0.1.1_x64-setup.exe"},{"appsAndFeaturesEntries":[{"UpgradeCode":"{92EB4B3F-719D-5C29-AE8D-08B85A1AC44E}"}],"architecture":"x64","dependencies":[],"elevation":{"requirement":"elevationRequired","source":"inferred"},"id":"x64-machine-wix","installerSwitches":{"InstallLocation":"INSTALLDIR=\"<INSTALLPATH>\""},"priority":2,"scope":"machine","sha256":"5d8b4171bcfd898e1aa80f2ae70a168a6f8fc10002abfe529460680a3b999255","silent":{"arguments":"/quiet /norestart","source":"default"},"successCodes":[],"type":"wix","uninstall":{"type":"productCode","value":"{225449BB-135B-4992-BCA9-F6683A5CB226}"},"url":"https://github.com/Technicalflight/AiGuard/releases/download/v0.1.1/AI._0.1.1_x64_zh-CN.msi"}],"licenseUrl":"https://github.com/Technicalflight/AiGuard/blob/HEAD/LICENSE","packageLocalizations":{"en-US":{"description":"A local-first security gateway for AI traffic.","locale":"en-US","longDescription":"AiGuard is a local-first security gateway for AI traffic. It takes over HTTPS traffic destined for AI services through a local MITM reverse proxy, replaces sensitive values such as ID numbers, phone numbers, bank cards, emails, API keys, and IP addresses with reversible placeholders before requests leave the machine, and streams them back into the real data locally when the AI reply arrives. The original text never leaves the machine and never touches disk, and seven risk signals such as error-message leaks and model-swap attacks are detected.","tags":["ai","privacy","proxy","security"]},"zh-CN":{"description":"本地优先的 AI 流量安全网关。","license":"AGPL-3.0-or-later","licenseUrl":"https://github.com/Technicalflight/AiGuard/blob/HEAD/LICENSE","locale":"zh-CN","longDescription":"AiGuard 是一个本地优先的 AI 流量安全网关：以系统代理 + PAC 只接管 AI 域名流量，在请求出网前把身份证、手机号、银行卡、邮箱、API Key、IP 等敏感信息替换为可还原占位符，AI 回复到达后在本地流式还原为真实数据，原文不落盘、不上传，并识别报错泄密、模型偷换等七类风险信号。","name":"AI 安全卫士","packageUrl":"https://github.com/Technicalflight/AiGuard","publisher":"technicalflight","publisherUrl":"https://github.com/Technicalflight","releaseNotesUrl":"https://github.com/Technicalflight/AiGuard/releases/tag/v0.1.1","tags":["人工智能","代理","安全防护","敏感信息脱敏","脱敏","隐私","隐私保护"]}},"publisherUrl":"https://github.com/Technicalflight","releaseDate":"2026-09-15","releaseDateSource":"manifest","releaseNotesUrl":"https://github.com/Technicalflight/AiGuard/releases/tag/v0.1.1","schemaVersion":1,"source":"winget","upstream":{"commit":"97d6aa2689f0a05f7847653a62b8624720d15b5d","manifestVersion":"1.12.0","manifests":[{"path":"manifests/t/Technicalflight/AiGuard/0.1.1/Technicalflight.AiGuard.yaml","sha256":"e21ce47404db97a85899eda0f2c88c594efa0309242163f751e4cbb328737181"},{"path":"manifests/t/Technicalflight/AiGuard/0.1.1/Technicalflight.AiGuard.installer.yaml","sha256":"652bcdf5c10492b78947610770d6654e52d10eba4d22d77e0596646d852498e0"},{"path":"manifests/t/Technicalflight/AiGuard/0.1.1/Technicalflight.AiGuard.locale.en-US.yaml","sha256":"b2c9949292dcd92c083cd9e59d3c2658fd4daed4dfde8281a26c6e0c848cc11a"},{"path":"manifests/t/Technicalflight/AiGuard/0.1.1/Technicalflight.AiGuard.locale.zh-CN.yaml","sha256":"1293af39c5196b354b92655ad3845d13e2b74c2de772bbffc81c135df667c67a"}],"repository":"microsoft/winget-pkgs"},"version":"0.1.1"}