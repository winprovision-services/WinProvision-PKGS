{"architectures":["x64"],"id":"tisun2.OofManager","latestVersion":"1.1.22","media":{"icons":[],"screenshots":[]},"package":{"description":"Manage Microsoft 365 / Exchange Online Out-of-Office (Automatic Reply) settings without opening Outlook.","license":"MIT","licenseUrl":"https://github.com/tisun2/OofManager/blob/main/LICENSE","locale":"en-US","localizations":{"en-US":{"description":"Manage Microsoft 365 / Exchange Online Out-of-Office (Automatic Reply) settings without opening Outlook.","license":"MIT","licenseUrl":"https://github.com/tisun2/OofManager/blob/main/LICENSE","locale":"en-US","longDescription":"OOF Manager is a lightweight Windows desktop tool that manages your Microsoft 365 mailbox's\nOut-of-Office (Automatic Reply) state for you. Sign in once, configure your weekly work hours\nand reply text, and OOF Manager auto-toggles your OOF on/off at the schedule boundaries.\nIt also pushes the next off-hours window to Exchange as a Scheduled OOF, so the server keeps\nswitching auto-replies even when this app is closed.","moniker":"oofmanager","name":"OOF Manager","packageUrl":"https://github.com/tisun2/OofManager","publisher":"tisun2","publisherUrl":"https://github.com/tisun2","releaseNotesUrl":"https://github.com/tisun2/OofManager/releases/tag/v1.1.22","tags":["exchange","microsoft-365","office-365","out-of-office","oof","outlook","autoreply"]}},"longDescription":"OOF Manager is a lightweight Windows desktop tool that manages your Microsoft 365 mailbox's\nOut-of-Office (Automatic Reply) state for you. Sign in once, configure your weekly work hours\nand reply text, and OOF Manager auto-toggles your OOF on/off at the schedule boundaries.\nIt also pushes the next off-hours window to Exchange as a Scheduled OOF, so the server keeps\nswitching auto-replies even when this app is closed.","moniker":"oofmanager","name":"OOF Manager","packageUrl":"https://github.com/tisun2/OofManager","publisher":"tisun2","publisherUrl":"https://github.com/tisun2","releaseNotesUrl":"