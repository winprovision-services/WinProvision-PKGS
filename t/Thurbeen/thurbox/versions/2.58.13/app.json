{"defaultLocale":"en-US","id":"Thurbeen.thurbox","installers":[{"architecture":"x64","dependencies":[{"PackageDependencies":[{"PackageIdentifier":"Microsoft.VCRedist.2015+.x64"}]}],"id":"x64-zip","nestedInstallerFiles":[{"PortableCommandAlias":"thurbox-cli","RelativeFilePath":"thurbox-cli.exe"},{"PortableCommandAlias":"thurbox","RelativeFilePath":"thurbox.exe"}],"nestedInstallerType":"portable","priority":4,"sha256":"317575a25ed39e2f9380187d1790514c2669699a3903ca18dffd4b852c2493be","successCodes":[],"type":"zip","url":"https://github.com/Thurbeen/thurbox/releases/download/v2.58.13/thurbox-v2.58.13-x86_64-pc-windows-msvc.zip"}],"licenseUrl":"https://github.com/Thurbeen/thurbox/blob/main/LICENSE","packageLocalizations":{"en-US":{"description":"TUI for orchestrating multiple coding-agent CLI sessions in persistent panels.","license":"MIT","licenseUrl":"https://github.com/Thurbeen/thurbox/blob/main/LICENSE","locale":"en-US","longDescription":"thurbox is a TUI for orchestrating multiple coding-agent CLI sessions\n(claude, codex, gemini, opencode, aider, ...) in persistent multiplexer\npanels. Sessions survive crashes/restarts because the multiplexer keeps the\nprocesses alive.\n\nWindows support is experimental for now — it sees less testing than\nLinux/macOS, so expect rough edges and please report issues. This package\ninstalls the prebuilt x86_64 Windows release binaries (thurbox.exe +\nthurbox-cli.exe) as portable commands on your PATH.\n\nNot installed by this package: psmux (the native-Windows tmux clone thurbox\ndrives as its session backend — https://github.com/psmux/psmux) and a\ncoding-agent CLI (claude, codex, gemini, opencode, aider, ...).","moniker":"thurbox","name":"thurbox","packageUrl":"https://thurbeen.github.io/thurbox/","publisher":"LeTuR","publisherUrl":"https://github.com/Thurbeen","releaseNotesUrl":"https://github.com/Thurbeen/thurbox/releases/tag/v2.58.13","tags":["agent","aider","claude","cli","coding-agent","codex","developer-tools","orchestrator