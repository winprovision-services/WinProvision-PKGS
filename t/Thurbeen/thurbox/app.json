{"architectures":["x64"],"id":"Thurbeen.thurbox","latestVersion":"2.82.0","media":{"icons":[],"screenshots":[]},"package":{"description":"TUI for orchestrating multiple coding-agent CLI sessions in persistent panels.","license":"MIT","licenseUrl":"https://github.com/Thurbeen/thurbox/blob/main/LICENSE","locale":"en-US","localizations":{"en-US":{"description":"TUI for orchestrating multiple coding-agent CLI sessions in persistent panels.","license":"MIT","licenseUrl":"https://github.com/Thurbeen/thurbox/blob/main/LICENSE","locale":"en-US","longDescription":"thurbox is a TUI for orchestrating multiple coding-agent CLI sessions\n(claude, codex, gemini, opencode, aider, ...) in persistent multiplexer\npanels. Sessions survive crashes/restarts because the multiplexer keeps the\nprocesses alive.\n\nWindows support is experimental for now — it sees less testing than\nLinux/macOS, so expect rough edges and please report issues. This package\ninstalls the prebuilt x86_64 Windows release binaries (thurbox.exe +\nthurbox-cli.exe) as portable commands on your PATH.\n\nNot installed by this package: psmux (the native-Windows tmux clone thurbox\ndrives as its session backend — https://github.com/psmux/psmux) and a\ncoding-agent CLI (claude, codex, gemini, opencode, aider, ...).","moniker":"thurbox","name":"thurbox","packageUrl":"https://thurbeen.github.io/thurbox/","publisher":"LeTuR","publisherUrl":"https://github.com/Thurbeen","releaseNotesUrl":"https://github.com/Thurbeen/thurbox/releases/tag/v2.82.0","tags":["agent","aider","claude","cli","coding-agent","codex","developer-tools","orchestrator","terminal","tui"]}},"longDescription":"thurbox is a TUI for orchestrating multiple coding-agent CLI sessions\n(claude, codex, gemini, opencode, aider, ...) in persistent multiplexer\npanels. Sessions survive crashes/restarts because the multiplexer keeps the\nprocesses alive.\n\nWindows support is experimental for now — it sees less testing than\nLinux/macOS, so expect rough edges and please report issues. This package\ninstalls the prebuilt x86_64 Windows release binaries (thurbox.exe +\nthurbox-cli.exe) as portable commands on your PATH.\n\nNot installed by this package: psmux (the native-Windows tmux clone thurbox\ndrives as its session backend — https://github.com/psmux/psmux) and a\ncoding-agent CLI (claude, codex, gemini, opencode, aider, ...).","moniker":"thurbox","name":"thurbox","packageUrl":"https://thurbeen.github.io/thurbox/","publisher":"LeTuR","publisherUrl":"https://github.com/Thurbeen","releaseNotesUrl":"https://github.com/Thurbeen/thurbox/releases/tag/v2.82.0","tags":["agent","aider","claude","cli","coding-agent","codex","developer-tools","orchestrator","terminal","tui"]},"schemaVersion":1,"source":"winget","versions":[{"architectures":["x64"],"detailPath":"versions/2.82.0/app.json","detailSha256":"3443a4b63c045f41201e2fc63d122eb7877135e322b506ed59b85e5f9b7305c0","releaseDate":"2026-11-03","releaseDateSource":"manifest","version":"2.82.0"},{"architectures":["x64"],"detailPath":"versions/2.81.2/app.json","detailSha256":"3986b21d22b92c9dc4953e405a658c02287f5f06212c5b4e8d82cb22a2cb34da","releaseDate":"2026-11-02","releaseDateSource":"manifest","version":"2.81.2"},{"architectures":["x64"],"detailPath":"versions/2.81.1/app.json","detailSha256":"a804efa46849348612199f044effc3ab83196e4a1495c4065e20c735ab5fd41d","releaseDate":"2026-11-01","releaseDateSource":"manifest","version":"2.81.1"},{"architectures":["x64"],"detailPath":"versions/2.78.3/app.json","detailSha256":"e9ce0be01a0aa995692917c6a6eed13c3e37eb311bfb6d196cad2f2794a7a236","releaseDate":"2026-10-30","releaseDateSource":"manifest","version":"2.78.3"},{"architectures":["x64"],"detailPath":"versions/2.76.1/app.json","detailSha256":"456a98ebaa35a539ecc2f68756ba4791c75af7f539ef57b2c82a0eedfa1214da","releaseDate":"2026-10-27","releaseDateSource":"manifest","version":"2.76.1"},{"architectures":["x64"],"detailPath":"versions/2.72.6/app.json","detailSha256":"960a765cae596ce73289642ffbfc14