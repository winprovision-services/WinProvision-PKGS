{"defaultLocale":"en-US","id":"tth05.Reverything","installers":[{"architecture":"x64","dependencies":[],"elevation":{"requirement":"elevatesSelf","source":"manifest"},"id":"x64-machine-inno","installModes":["interactive","silent","silentWithProgress"],"installerSwitches":{"Custom":"/MANAGED=winget"},"priority":1,"scope":"machine","sha256":"046cdc12e5c58d15041c8ae24fa9d789d9984a440e1966be7b1048abed88a375","successCodes":[],"type":"inno","uninstall":{"type":"registryKey","value":"{6B0E2F47-9C1D-4E4B-A6E8-3F2C8D9B5A71}_is1"},"upgradeBehavior":"install","url":"https://github.com/tth05/reverything/releases/download/v1.2.2/reverything-setup-1.2.2.exe"}],"licenseUrl":"https://github.com/tth05/reverything/blob/master/LICENSE","packageLocalizations":{"en-US":{"author":"tth05","copyright":"Copyright (c) 2026 tth05","description":"Blazingly fast, resource-efficient global file search for Windows. Can index millions of files in seconds.","license":"Proprietary (indexing library MIT)","licenseUrl":"https://github.com/tth05/reverything/blob/master/LICENSE","locale":"en-US","longDescription":"Reverything finds any file on your PC by name, as you type. It reads the file tables of NTFS drives directly, so millions of files are indexed in seconds, and keeps the index up to date through the NTFS change journal.\nSearches support wildcards, folders, exclusions and size or date filters. Results can be opened, dragged into other programs, copied or shown in Explorer.\nA small background service, running as the system account, keeps the index and answers the searches; the search window runs as the user, lives in the tray and comes up with a global shortcut. While the window is not in use, the service uses almost no CPU or memory.","moniker":"reverything","name":"Reverything","packageUrl":"https://github.com/tth05/reverything","publisher":"tth05","publisherSupportUrl":"https://github.com/tth05/reverything/issues","publisherUrl":"https://github.com/tth05","releaseNotesUrl":"https://github.c