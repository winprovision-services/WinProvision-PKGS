{"defaultLocale":"en-US","id":"tanakamasayuki.WSLUSBIdentityManager","installers":[{"architecture":"x64","dependencies":[],"id":"x64-user-nullsoft","priority":1,"scope":"user","sha256":"0d2ceea4a1d6e6d72fcdcc055eea8cd187065c187790ab34bf2dfe5f3ab9bdaf","silent":{"arguments":"/S","source":"default"},"successCodes":[],"type":"nullsoft","url":"https://github.com/tanakamasayuki/wsl-usb-identity-manager/releases/download/v1.0.1/wsl-usb-identity-manager_1.0.1_x64_setup.exe"}],"licenseUrl":"https://github.com/tanakamasayuki/wsl-usb-identity-manager/blob/main/LICENSE","packageLocalizations":{"en-US":{"description":"Track which physical device is which when forwarding USB devices to WSL","license":"MIT","licenseUrl":"https://github.com/tanakamasayuki/wsl-usb-identity-manager/blob/main/LICENSE","locale":"en-US","longDescription":"Works with usbipd-win to tell identical USB devices apart. A CH340 reports no serial number, and a bus id changes when hubs are re-enumerated, so this asks the board itself: an ESP32 by its eFuse MAC, a CH32 RISC-V part by its factory UUID through a WCH-Link. It shares, attaches and detaches devices, identifies them on arrival, and can attach matching devices to WSL automatically.","moniker":"wsl-usb-identity-manager","name":"WSL USB Identity Manager","packageUrl":"https://github.com/tanakamasayuki/wsl-usb-identity-manager","publisher":"TANAKA Masayuki","publisherUrl":"https://github.com/tanakamasayuki","releaseNotesUrl":"https://github.com/tanakamasayuki/wsl-usb-identity-manager/releases","tags":["wsl","usb","usbipd","usbipd-win","esp32","ch32","serial"]}},"publisherUrl":"https://github.com/tanakamasayuki","releaseNotesUrl":"https://github.com/tanakamasayuki/wsl-usb-identity-manager/releases","schemaVersion":1,"source":"winget","upstream":{"commit":"97d6aa2689f0a05f7847653a62b8624720d15b5d","manifestVersion":"1.12.0","manifests":[{"path":"manifests/t/tanakamasayuki/WSLUSBIdentityManager/1.0.1/tanakamasayuki.WSLUSBIdentityManager.yaml","sha256":"53f34