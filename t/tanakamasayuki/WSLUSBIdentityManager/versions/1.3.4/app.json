{"defaultLocale":"en-US","id":"tanakamasayuki.WSLUSBIdentityManager","installers":[{"appsAndFeaturesEntries":[{"ProductCode":"WSL USB Identity Manager"}],"architecture":"x64","dependencies":[],"id":"x64-user-nullsoft","locale":"en-US","priority":1,"scope":"user","sha256":"481247d1d948cb4fb21fd7b782f483c809042a847e34ee8f7d5a6b18d0aef541","silent":{"arguments":"/S","source":"default"},"successCodes":[],"type":"nullsoft","uninstall":{"type":"productCode","value":"WSL USB Identity Manager"},"url":"https://github.com/tanakamasayuki/wsl-usb-identity-manager/releases/download/v1.3.4/wsl-usb-identity-manager_1.3.4_x64_setup.exe"}],"licenseUrl":"https://github.com/tanakamasayuki/wsl-usb-identity-manager/blob/HEAD/LICENSE","packageLocalizations":{"en-US":{"description":"Track which physical device is which when forwarding USB devices to WSL","license":"MIT","licenseUrl":"https://github.com/tanakamasayuki/wsl-usb-identity-manager/blob/HEAD/LICENSE","locale":"en-US","longDescription":"Works with usbipd-win to tell identical USB devices apart. A CH340 reports no serial number, and a bus id changes when hubs are re-enumerated, so this asks the board itself: an ESP32 by its eFuse MAC, a CH32 RISC-V part by its factory UUID through a WCH-Link. It shares, attaches and detaches devices, identifies them on arrival, and can attach matching devices to WSL automatically.","moniker":"wsl-usb-identity-manager","name":"WSL USB Identity Manager","packageUrl":"https://github.com/tanakamasayuki/wsl-usb-identity-manager","publisher":"TANAKA Masayuki","publisherUrl":"https://github.com/tanakamasayuki","releaseNotesUrl":"https://github.com/tanakamasayuki/wsl-usb-identity-manager/releases/tag/v1.3.4","tags":["ch32","esp32","serial","usb","usbipd","usbipd-win","wsl"]}},"publisherUrl":"https://github.com/tanakamasayuki","releaseDate":"2026-10-14","releaseDateSource":"manifest","releaseNotesUrl":"https://github.com/tanakamasayuki/wsl-usb-identity-manager/releases/tag/v1.3.4","schemaVersion":1,"source