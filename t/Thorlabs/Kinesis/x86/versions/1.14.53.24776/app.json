软件","locale":"zh-CN","longDescription":"Kinesis 软件支持用户通过 PC 的 USB 总线与任意数量的硬件控制单元进行交互。该程序可同时显示多个图形化仪器面板，实现对多台设备的集中控制。用户可通过软件配置所有基础运行参数，并执行基本操作（如电机运动）。硬件配置与参数设置支持保存和重新加载功能，极大简化了系统部署流程。","tags":[]}},"publisherUrl":"https://www.thorlabs.com/","releaseDate":"2025-04-16","releaseDateSource":"manifest","releaseNotesUrl":"https://www.thorlabs.com/Software/Motion%20Control/KINESIS/Application/v1.14.53/History.txt","schemaVersion":1,"source":"winget","upstream":{"commit":"97d6aa2689f0a05f7847653a62b8624720d15b5d","manifestVersion":"1.10.0","manifests":[{"path":"manifests/t/Thorlabs/Kinesis/x86/1.14.53.24776/Thorlabs.Kinesis.x86.yaml","sha256":"786006539e0c0ff87d98ec3f3f087b5cd6dc729563b28d806196ccefd1f117bc"},{"path":"manifests/t/Thorlabs/Kinesis/x86/1.14.53.24776/Thorlabs.Kinesis.x86.installer.yaml","sha256":"34054fb477e9af10345ca58e11e149c129d31ec1945be77ad91e3789906ea4f4"},{"path":"manifests/t/Thorlabs/Kinesis/x86/1.14.53.24776/Thorlabs.Kinesis.x86.locale.en-US.yaml","sha256":"321ecd98c011111eb38ad3d28ff93ff378d73a6e55f59c7d570169481dab5314"},{"path":"manifests/t/Thorlabs/Kinesis/x86/1.14.53.24776/Thorlabs.Kinesis.x86.locale.zh-CN.yaml","sha256":"553a894e58f7ede57db426ed196f5cc4234945de74470902755b21f0e49016a3"}],"repository":"microsoft/winget-pkgs"},"version":"1.14.53.24776"}