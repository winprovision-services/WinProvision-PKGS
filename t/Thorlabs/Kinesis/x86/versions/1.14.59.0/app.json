urnCode":1654,"ReturnResponse":"systemNotSupported"},{"InstallerReturnCode":3010,"ReturnResponse":"rebootRequiredToFinish"}],"id":"x86-machine-exe","installModes":["interactive","silent","silentWithProgress"],"installerSwitches":{"InstallLocation":"/V\"INSTALLDIR=\"\"<INSTALLPATH>\"\"\"","Log":"/V\"/log \"\"<LOGPATH>\"\"\"","Silent":"/S /V/quiet /V/norestart","SilentWithProgress":"/S /V/passive /V/norestart"},"priority":1,"scope":"machine","sha256":"fe073773316e6ca472eeeb47cafaada8324303c6d9a1e25788875fcafd27d888","silent":{"arguments":"/S /V/quiet /V/norestart","source":"manifest"},"successCodes":[],"type":"exe","uninstall":{"type":"productCode","value":"{BD611F7B-0DC6-4213-A776-CDEB213C09D5}"},"url":"https://thin01mstroc282prod.dxcloud.episerver.net/contentassets/fb56e416e2b248f5a7888aae3fcf71d3/thorlabs_kinesis_setup_26708_x86.exe?v=0126103520"}],"licenseUrl":"https://www.thorlabs.com/Software/Motion%20Control/KINESIS/License%20Agreement.htm","packageLocalizations":{"en-US":{"description":"Interact with Thorlabs hardware control units via USB.","license":"Proprietary","licenseUrl":"https://www.thorlabs.com/Software/Motion%20Control/KINESIS/License%20Agreement.htm","locale":"en-US","longDescription":"The Kinesis software allows the user to interact with any number of hardware control units connected to the PC USB Bus. This program allows multiple graphical instrument panels to be displayed so that multiple units can be controlled. All basic operating parameters can be set through the software, and all basic operations (such as motor moves) can be initiated. Hardware configurations and parameter settings can be saved and reloaded, which simplifies system set up.","name":"Thorlabs Kinesis (x86)","packageUrl":"https://www.thorlabs.com/software_pages/ViewSoftwarePage.cfm?Code=Motion_Control","publisher":"Thorlabs","publisherUrl":"https://www.thorlabs.com/","releaseNotesUrl":"https://thin01mstroc282prod.dxcloud.episerver.net/contentassets/c2be2cc1f41f4b0d9df0c93dd2eeb1da/history.txt?v=0126103457","tags":[]},"zh-CN":{"description":"通过 USB 与 Thorlabs 硬件控制单元进行交互。","license":"专有软件","locale":"zh-CN","longDescription":"Kinesis 软件支持用户通过 PC 的 USB 总线与任意数量的硬件控制单元进行交互。该程序可同时显示多个图形化仪器面板，实现对多台设备的集中控制。用户可通过软件配置所有基础运行参数，并执行基本操作（如电机运动）。硬件配置与参数设置支持保存和重新加载功能，极大简化了系统部署流程。","tags":[]}},"publisherUrl":"https://www.thorlabs.com/","releaseDate":"2026-01-23","releaseDateSource":"manifest","releaseNotesUrl":"https://thin01mstroc282prod.dxcloud.episerver.net/contentassets/c2be2cc1f41f4b0d9df0c93dd2eeb1da/history.txt?v=0126103457","schemaVersion":1,"source":"winget","upstream":{"commit":"97d6aa2689f0a05f7847653a62b8624720d15b5d","manifestVersion":"1.12.0","manifests":[{"path":"manifests/t/Thorlabs/Kinesis/x86/1.14.59.0/Thorlabs.Kinesis.x86.yaml","sha256":"d74af0932a6e9320b9517f86beec93e931154c6dcc634d63412ecd10bb9ea4ff"},{"path":"manifests/t/Thorlabs/Kinesis/x86/1.14.59.0/Thorlabs.Kinesis.x86.installer.yaml","sha256":"5ca6c5cf000da519f19be0c80008deee76b65b94fbf0feab268df540cb875a45"},{"path":"manifests/t/Thorlabs/Kinesis/x86/1.14.59.0/Thorlabs.Kinesis.x86.locale.en-US.yaml","sha256":"1a996e8fc866ea3b23900c44cf92fa529c71c60e5350bb06c30fa944d034ac59"},{"path":"manifests/t/Thorlabs/Kinesis/x86/1.14.59.0/Thorlabs.Kinesis.x86.locale.zh-CN.yaml","sha256":"b580e363670433298c6a39d35c8937cc9e95c7df185b9bc6431f6263722d7711"}],"repository":"microsoft/winget-pkgs"},"version":"1.14.59.0"}