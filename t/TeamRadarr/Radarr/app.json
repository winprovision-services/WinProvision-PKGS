{"architectures":["x64","x86"],"id":"TeamRadarr.Radarr","latestVersion":"6.0.4","media":{"icons":[],"screenshots":[]},"package":{"description":"Radarr is a movie collection manager for Usenet and BitTorrent users.","license":"GPL-3.0","licenseUrl":"https://github.com/Radarr/Radarr/blob/HEAD/LICENSE","locale":"en-US","localizations":{"en-US":{"description":"Radarr is a movie collection manager for Usenet and BitTorrent users.","license":"GPL-3.0","licenseUrl":"https://github.com/Radarr/Radarr/blob/HEAD/LICENSE","locale":"en-US","longDescription":"Radarr is a movie collection manager for Usenet and BitTorrent users.\nIt can monitor multiple RSS feeds for new movies and will interface with clients and indexers to grab, sort, and rename them.\nIt can also be configured to automatically upgrade the quality of existing files in the library when a better quality format becomes available.\nNote that only one type of a given movie is supported.\nIf you want both an 4k version and 1080p version of a given movie you will need multiple instances.","moniker":"radarr","name":"Radarr","packageUrl":"https://github.com/Radarr/Radarr/releases/tag/v6.0.4.10291","publisher":"Team Radarr","publisherUrl":"https://radarr.video/","releaseNotesUrl":"https://github.com/Radarr/Radarr/releases/tag/v6.0.4.10291","tags":["bazarr","pvr","sonarr","torrent","usenet"]}},"longDescription":"Radarr is a movie collection manager for Usenet and BitTorrent users.\nIt can monitor multiple RSS feeds for new movies and will interface with clients and indexers to grab, sort, and rename them.\nIt can also be configured to automatically upgrade the quality of existing files in the library when a better quality format becomes available.\nNote that only one type of a given movie is supported.\nIf you want both an 4k version and 1080p version of a given movie you will need multiple instances.","moniker":"radarr","name":"Radarr","packageUrl":"https://github.com/Radarr/Radarr/releases/tag/v6.0.4.10291","publisher":"