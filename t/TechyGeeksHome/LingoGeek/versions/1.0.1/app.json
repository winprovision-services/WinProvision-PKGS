{"defaultLocale":"en-GB","id":"TechyGeeksHome.LingoGeek","installers":[{"architecture":"x64","dependencies":[],"id":"x64-user-inno","installModes":["interactive","silent","silentWithProgress"],"priority":1,"scope":"user","sha256":"5838594255ecd584efaffc21490850e7773e125a664a08aecb41983b73cabeaa","silent":{"arguments":"/VERYSILENT /SUPPRESSMSGBOXES /NORESTART /SP-","source":"default"},"successCodes":[],"type":"inno","uninstall":{"type":"productCode","value":"{2E6F9A41-7C08-4B3D-9A15-6D48E0C7B932}_is1"},"upgradeBehavior":"install","url":"https://github.com/techygeekshome/LingoGeek/releases/download/v1.0.1/LingoGeekSetup.exe"}],"licenseUrl":"https://github.com/techygeekshome/LingoGeek/blob/main/LICENSE","packageLocalizations":{"en-GB":{"description":"A document translator that runs on the machine, with no account and no character limit.","license":"GPL-3.0","licenseUrl":"https://github.com/techygeekshome/LingoGeek/blob/main/LICENSE","locale":"en-GB","longDescription":"LingoGeek translates Word documents, PDFs, SRT and VTT subtitles, Markdown and plain text on the machine itself, writing a translated copy beside the original rather than over it. Word structure is preserved: headings, bullet lists, tables, headers and footers. Subtitle cue numbers and timestamps are copied through unchanged. PDFs are read as text and written out as an editable Word document rather than a rebuilt layout. Around a hundred language pairs are available from the openly licensed Argos and OPUS-MT collections; a pack is downloaded once, between 40 and 80 MB, and works with no connection from then on. There is no account, no subscription and no monthly document allowance.","moniker":"lingogeek","name":"LingoGeek","packageUrl":"https://techygeekshome.info/lingogeek/","publisher":"TechyGeeksHome","publisherUrl":"https://techygeekshome.info","releaseNotesUrl":"https://github.com/techygeekshome/LingoGeek/releases/tag/v1.0.1","tags":["translation","translator","document","docx","pdf","subtitles","srt