{"defaultLocale":"en-GB","id":"TechyGeeksHome.AuthGeek","installers":[{"architecture":"x64","dependencies":[],"id":"x64-user-inno","installModes":["interactive","silent","silentWithProgress"],"priority":1,"scope":"user","sha256":"004e1ba38c37bf60e6cc65396511ebcae0d554bccb4be9eec78762af1f9be302","silent":{"arguments":"/VERYSILENT /SUPPRESSMSGBOXES /NORESTART /SP-","source":"default"},"successCodes":[],"type":"inno","uninstall":{"type":"productCode","value":"{9D5E4A17-72C3-4E80-B6F1-8C42D07A3B95}_is1"},"upgradeBehavior":"install","url":"https://github.com/techygeekshome/AuthGeek/releases/download/v1.0.0/AuthGeekSetup.exe"}],"licenseUrl":"https://github.com/techygeekshome/AuthGeek/blob/main/LICENSE","packageLocalizations":{"en-GB":{"description":"A desktop two-factor authenticator that keeps your codes in one encrypted file.","license":"GPL-3.0","licenseUrl":"https://github.com/techygeekshome/AuthGeek/blob/main/LICENSE","locale":"en-GB","longDescription":"AuthGeek generates TOTP and HOTP codes on the desktop and keeps every account in one encrypted file on the machine, with no account, no server and no sync. Accounts are added by pasting an otpauth link, by reading a QR code out of a picture, or by importing a Google Authenticator transfer link in one go, and any account can be shown as a QR code to move it to a phone. The vault is AES-256-GCM with the key derived by Argon2id, and encrypted backup, plain text export and restore are all built in and tested on every build.","moniker":"authgeek","name":"AuthGeek","packageUrl":"https://techygeekshome.info/authgeek/","publisher":"TechyGeeksHome","publisherUrl":"https://techygeekshome.info","releaseNotesUrl":"https://github.com/techygeekshome/AuthGeek/releases/tag/v1.0.0","tags":["2fa","totp","hotp","authenticator","security","otp","offline","windows","free","open-source"]}},"publisherUrl":"https://techygeekshome.info","releaseDate":"2026-09-01","releaseDateSource":"manifest","releaseNotesUrl":"https://github.com/techygeeksh