{"defaultLocale":"en-US","id":"TechyGeeksHome.DriverGeek","installers":[{"architecture":"x64","dependencies":[],"id":"x64-user-inno","installModes":["interactive","silent","silentWithProgress"],"priority":1,"scope":"user","sha256":"b2afc746124b57bf954603b4ca76462defc254fed40a8461f9f12e1b040f0960","silent":{"arguments":"/VERYSILENT /SUPPRESSMSGBOXES /NORESTART /SP-","source":"default"},"successCodes":[],"type":"inno","uninstall":{"type":"productCode","value":"{E1F5AC9E-3E9F-478D-BD69-40D637942B89}_is1"},"upgradeBehavior":"install","url":"https://github.com/techygeekshome/DriverGeek/releases/download/v1.1.2/DriverGeekSetup.exe"}],"licenseUrl":"https://github.com/techygeekshome/DriverGeek/blob/main/LICENSE","packageLocalizations":{"en-US":{"description":"Lists every driver on your PC and shows which ones have a newer release.","license":"GPL-3.0","licenseUrl":"https://github.com/techygeekshome/DriverGeek/blob/main/LICENSE","locale":"en-US","longDescription":"DriverGeek lists every device on the machine with its current driver version, date and\nprovider, then checks which of them have a newer release available.\n\nWindows Update only offers the drivers Microsoft has certified for your hardware and stays\nquiet about the rest, so a machine can sit on a driver that is years out of date without ever\nbeing told. DriverGeek shows the whole picture and leaves the decision to you.\n\nNothing is installed behind your back, there is no bundled driver pack and there is no paid\ntier. It reads the driver inventory locally and only reaches the network to ask whether a\nnewer version exists.","moniker":"drivergeek","name":"DriverGeek","packageUrl":"https://techygeekshome.info/drivergeek/","publisher":"TechyGeeksHome","publisherUrl":"https://techygeekshome.info","releaseNotesUrl":"https://github.com/techygeekshome/DriverGeek/releases/tag/v1.1.2","tags":["driver","drivers","driver-updater","hardware","system","utility","windows"]}},"publisherUrl":"https://techygeekshome.info","relea