InstallerReturnCode":3010,"ReturnResponse":"rebootRequiredToFinish"}],"id":"x86-machine-exe","installModes":["interactive","silent","silentWithProgress"],"installerSwitches":{"InstallLocation":"/V\"INSTALLDIR=\"\"<INSTALLPATH>\"\"\"","Log":"/V\"/log \"\"<LOGPATH>\"\"\"","Silent":"/S /V/quiet /V/norestart","SilentWithProgress":"/S /V/passive /V/norestart"},"priority":1,"scope":"machine","sha256":"22a197fbf2ce29515e47547a7f7e8216b6a32c843887267226b390965619f48c","silent":{"arguments":"/S /V/quiet /V/norestart","source":"manifest"},"successCodes":[],"type":"exe","uninstall":{"type":"productCode","value":"{B6CAC9AF-4AE3-470A-8675-C9DC28E8662F}"},"upgradeBehavior":"install","url":"https://www.prosysdev.com/downloads/setup_digiCentralXML_3_21.exe"}],"licenseUrl":"https://www.tachosys.com/Terms","packageLocalizations":{"en-US":{"description":"digicentral licenced software on your local network","license":"Proprietary","licenseUrl":"https://www.tachosys.com/Terms","locale":"en-US","longDescription":"digicentral XML Server was designed for situations where a company is not able to utilise digicentral cloud services or where they are using stand-alone analysis software. The software resides on a company’s own PC or Server and is licensed by use of a USB dongle. The server supports the digipostpro, digiDL, digiDL-E and digiDL-H to provide a central data repository for a local network.\nThe server provides support for remote tachograph download and detailed download scheduling. There is no support for additional features such as real-time information from the digiDL devices, GPS Tracking or in the case of digipostpro, time and attendance logging. For these higher level services you need to use the cloud version of digicentral available through your Tachosys reseller.\nThe licence is controlled via a USB software dongle which will provide a defined number of tokens.\nProduct token values:\n1. digiDL, digiDL-E & digiDL-H = 1 token\n2. digipostpro = 5 tokens\nThere are two versions of the licence available; a 50 token version and a 100 token version.\nThe software automatically calculates and displays the current token usage.\nPlease contact your Tachosys reseller for pricing.","name":"digiCentral","packageUrl":"https://tachosys.com/Product/digicentral-XML","publisher":"Tachosys","publisherUrl":"https://www.tachosys.com/","tags":[]},"zh-CN":{"description":"digicentral 授权软件在您的本地网络中","license":"专有软件","locale":"zh-CN","longDescription":"digicentral XML 服务器适用于公司无法使用 digicentral 云服务，或正在使用独立分析软件的情况。该软件安装在公司自有 PC 或服务器上，通过 USB 加密狗进行授权。服务器支持 digipostpro、digiDL、digiDL-E 和 digiDL-H，为本地网络提供中央数据存储库。\n该服务器支持远程下载行驶记录仪数据以及详细的下载计划安排。但不支持更高级的功能，例如来自 digiDL 设备的实时信息、GPS 跟踪，以及在 digipostpro 情况下的考勤记录功能。如需使用这些高级服务，请通过您的 Tachosys 经销商获取基于云版本的 digicentral。\n授权通过 USB 软件加密狗控制，并提供指定数量的令牌。\n产品令牌值如下：\n1. digiDL、digiDL-E 和 digiDL-H = 1 个令牌\n2. digipostpro = 5 个令牌\n授权提供两种版本：50 令牌版和 100 令牌版。\n软件将自动计算并显示当前的令牌使用情况。\n请联络您的 Tachosys 经销商获取价格信息。","tags":[]}},"publisherUrl":"https://www.tachosys.com/","releaseDate":"2026-09-07","releaseDateSource":"manifest","schemaVersion":1,"source":"winget","upstream":{"commit":"97d6aa2689f0a05f7847653a62b8624720d15b5d","manifestVersion":"1.12.0","manifests":[{"path":"manifests/t/Tachosys/digiCentral/3.21/Tachosys.digiCentral.yaml","sha256":"58628a74c8542a46274b91103607f33704e2d6a7db8cd4526582b4469b33754a"},{"path":"manifests/t/Tachosys/digiCentral/3.21/Tachosys.digiCentral.installer.yaml","sha256":"1cb2384bebe7626929a6ba97f6161bc5a1f4441db07d358cabea875994f92ca7"},{"path":"manifests/t/Tachosys/digiCentral/3.21/Tachosys.digiCentral.locale.en-US.yaml","sha256":"6731c696a50eafb0712e9268cbb5eca8ba7133cba384e67380dc08804efa562a"},{"path":"manifests/t/Tachosys/digiCentral/3.21/Tachosys.digiCentral.locale.zh-CN.yaml","sha256":"858494c539e0f55d12f37804211104ec1565cb8bb12d628640dc0ade80cacc46"}],"repository":"microsoft/winget-pkgs"},"version":"3.21"}