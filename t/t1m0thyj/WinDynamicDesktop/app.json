{"architectures":["arm64","neutral","x64","x86"],"id":"t1m0thyj.WinDynamicDesktop","latestVersion":"5.7.0","media":{"icons":[{"mimeType":"image/png","path":"media/icon.d4b95a76.png","priority":1,"sha256":"d4b95a76b64c514bd4c11dae78b17bd656e5f134235535cb2b4ce6f1b76d0cfe","source":"winget-legacy"}],"screenshots":[]},"package":{"description":"Port of macOS Mojave Dynamic Desktop feature to Windows","license":"MPL-2.0","licenseUrl":"https://github.com/t1m0thyj/WinDynamicDesktop/blob/HEAD/LICENSE","locale":"en-US","localizations":{"en-US":{"description":"Port of macOS Mojave Dynamic Desktop feature to Windows","license":"MPL-2.0","licenseUrl":"https://github.com/t1m0thyj/WinDynamicDesktop/blob/HEAD/LICENSE","locale":"en-US","longDescription":"WinDynamicDesktop ports the Dynamic Desktop feature from macOS Mojave to Windows.\nIt uses your location to determine the times of sunrise and sunset, and changes your desktop wallpaper based on the time of day.\nChoose a theme and enter your location the first time you run the app, then it will minimize to your system tray and change the wallpaper in the background.\nYou can import custom themes or create your own, and customize the app to automatically change the Windows 10 theme color or update your location periodically.","moniker":"windynamicdesktop","name":"WinDynamicDesktop","packageUrl":"https://windd.info/","publisher":"Timothy Johnson","publisherUrl":"https://github.com/t1m0thyj/WinDynamicDesktop","releaseNotesUrl":"https://github.com/t1m0thyj/WinDynamicDesktop/releases/tag/v5.7.0","tags":["dynamic-desktop","wallpaper","windows10"]}},"longDescription":"WinDynamicDesktop ports the Dynamic Desktop feature from macOS Mojave to Windows.\nIt uses your location to determine the times of sunrise and sunset, and changes your desktop wallpaper based on the time of day.\nChoose a theme and enter your location the first time you run the app, then it will minimize to your system tray and change the wallpaper in the background.\nYou ca