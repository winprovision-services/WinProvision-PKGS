{"defaultLocale":"en-US","id":"VirtualGL.TurboVNC","installers":[{"architecture":"x64","dependencies":[],"elevation":{"requirement":"elevationRequired","source":"inferred"},"fileExtensions":["turbovnc","vnc"],"id":"x64-machine-inno","priority":1,"scope":"machine","sha256":"7171a097c1a2a181c0a92bbef87918800ca047f68ebf866a5744df557e3befda","silent":{"arguments":"/VERYSILENT /SUPPRESSMSGBOXES /NORESTART /SP-","source":"default"},"successCodes":[],"type":"inno","uninstall":{"type":"productCode","value":"TurboVNC_is1"},"upgradeBehavior":"install","url":"https://github.com/TurboVNC/turbovnc/releases/download/3.2.1/TurboVNC-3.2.1.exe"}],"licenseUrl":"https://github.com/TurboVNC/turbovnc/blob/HEAD/LICENSE.txt","packageLocalizations":{"en-US":{"description":"High-speed, 3D-friendly, TightVNC-compatible remote desktop software","license":"GPL-2.0","licenseUrl":"https://github.com/TurboVNC/turbovnc/blob/HEAD/LICENSE.txt","locale":"en-US","longDescription":"TurboVNC is a high-performance, enterprise-quality version of VNC based on TightVNC, TigerVNC, and X.org.\nIt contains a variant of Tight encoding that is tuned for maximum performance and compression with 3D applications (VirtualGL), video, and other image-intensive workloads.\nTurboVNC, in combination with VirtualGL, provides a complete solution for remotely displaying 3D applications with interactive performance.\nTurboVNC's high-speed encoding methods have been adopted by TigerVNC and libvncserver, and TurboVNC is also compatible with any other TightVNC derivative.","name":"TurboVNC","packageUrl":"https://turbovnc.org/","publisher":"The VirtualGL Project","publisherUrl":"https://turbovnc.org/","releaseNotesUrl":"https://github.com/TurboVNC/turbovnc/releases/tag/3.2.1","tags":["remote-access","remote-desktop","remoteaccess","remotedesktop","vnc"]},"zh-CN":{"description":"高速、3D 友好、兼容 TightVNC 的远程桌面软件","locale":"zh-CN","longDescription":"TurboVNC 是基于 TightVNC、TigerVNC 和 X.org 的高性能企业级 VNC 版本。\n它包含 Tight 编码的一个变种，经过调整后可在 3D 应用