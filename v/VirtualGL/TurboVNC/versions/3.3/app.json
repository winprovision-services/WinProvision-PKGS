{"defaultLocale":"en-US","id":"VirtualGL.TurboVNC","installers":[{"architecture":"x64","dependencies":[],"elevation":{"requirement":"elevationRequired","source":"inferred"},"fileExtensions":["turbovnc","vnc"],"id":"x64-machine-inno","priority":1,"scope":"machine","sha256":"29882a078de6cc9c12da97be4eab42299c1206c6a78ba77bbd89377c45d7d89d","silent":{"arguments":"/VERYSILENT /SUPPRESSMSGBOXES /NORESTART /SP-","source":"default"},"successCodes":[],"type":"inno","uninstall":{"type":"productCode","value":"TurboVNC_is1"},"upgradeBehavior":"install","url":"https://github.com/TurboVNC/turbovnc/releases/download/3.3/TurboVNC-3.3.exe"}],"licenseUrl":"https://github.com/TurboVNC/turbovnc/blob/HEAD/LICENSE.txt","packageLocalizations":{"en-US":{"description":"High-speed, 3D-friendly, TightVNC-compatible remote desktop software","license":"GPL-2.0","licenseUrl":"https://github.com/TurboVNC/turbovnc/blob/HEAD/LICENSE.txt","locale":"en-US","longDescription":"TurboVNC is a high-performance, enterprise-quality version of VNC based on TightVNC, TigerVNC, and X.org.\nIt contains a variant of Tight encoding that is tuned for maximum performance and compression with 3D applications (VirtualGL), video, and other image-intensive workloads.\nTurboVNC, in combination with VirtualGL, provides a complete solution for remotely displaying 3D applications with interactive performance.\nTurboVNC's high-speed encoding methods have been adopted by TigerVNC and libvncserver, and TurboVNC is also compatible with any other TightVNC derivative.","name":"TurboVNC","packageUrl":"https://turbovnc.org/","publisher":"The VirtualGL Project","publisherUrl":"https://turbovnc.org/","releaseNotesUrl":"https://github.com/TurboVNC/turbovnc/releases/tag/3.3","tags":["remote-access","remote-desktop","remoteaccess","remotedesktop","vnc"]},"zh-CN":{"description":"高速、3D 友好、兼容 TightVNC 的远程桌面软件","locale":"zh-CN","longDescription":"TurboVNC 是基于 TightVNC、TigerVNC 和 X.org 的高性能企业级 VNC 版本。\n它包含 Tight 编码的一个变种，经过调整后可在 3D 应用程序 (VirtualGL)、视频和其它图像密集型工作负载实现最高性能和压缩。\nTurboVNC 与 VirtualGL 相结合，为远程显示具有交互性能的 3D 应用程序提供了完整的解决方案。\nTurboVNC 的高速编码方法已被 TigerVNC 和 libvncserver 采用，TurboVNC 还与其它任何 TightVNC 衍生产品兼容。","releaseNotesUrl":"https://github.com/TurboVNC/turbovnc/releases/tag/3.3","tags":["vnc"]}},"publisherUrl":"https://turbovnc.org/","releaseDate":"2026-02-06","releaseDateSource":"manifest","releaseNotesUrl":"https://github.com/TurboVNC/turbovnc/releases/tag/3.3","schemaVersion":1,"source":"winget","upstream":{"commit":"97d6aa2689f0a05f7847653a62b8624720d15b5d","manifestVersion":"1.12.0","manifests":[{"path":"manifests/v/VirtualGL/TurboVNC/3.3/VirtualGL.TurboVNC.yaml","sha256":"d3022cb7989e961d3d338cee5c88b0d3426e1522b6087322c306433d0e028885"},{"path":"manifests/v/VirtualGL/TurboVNC/3.3/VirtualGL.TurboVNC.installer.yaml","sha256":"84975df4b949d2b164b640c72f5ed62cb940070afc534a6476b289e8448904af"},{"path":"manifests/v/VirtualGL/TurboVNC/3.3/VirtualGL.TurboVNC.locale.en-US.yaml","sha256":"fe50879e4dedef99b91fb16cf53b2bd21242aee5879c150f42d2ceb05c5605a3"},{"path":"manifests/v/VirtualGL/TurboVNC/3.3/VirtualGL.TurboVNC.locale.zh-CN.yaml","sha256":"253e6856f725264c6889e1166a8a0bcc1958be437de9e8c8f5ac2e9ba531c633"}],"repository":"microsoft/winget-pkgs"},"version":"3.3"}