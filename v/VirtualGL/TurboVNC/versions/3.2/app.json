{"defaultLocale":"en-US","id":"VirtualGL.TurboVNC","installers":[{"architecture":"x64","dependencies":[],"elevation":{"requirement":"elevationRequired","source":"inferred"},"fileExtensions":["turbovnc","vnc"],"id":"x64-machine-inno","priority":1,"scope":"machine","sha256":"d35ef091593ec40eff10d29b4fbdd35cb3a58cd053f1cb183ff0847bbc767a97","silent":{"arguments":"/VERYSILENT /SUPPRESSMSGBOXES /NORESTART /SP-","source":"default"},"successCodes":[],"type":"inno","uninstall":{"type":"productCode","value":"TurboVNC_is1"},"upgradeBehavior":"install","url":"https://github.com/TurboVNC/turbovnc/releases/download/3.2/TurboVNC-3.2.exe"}],"licenseUrl":"https://github.com/TurboVNC/turbovnc/blob/HEAD/LICENSE.txt","packageLocalizations":{"en-US":{"description":"High-speed, 3D-friendly, TightVNC-compatible remote desktop software","license":"GPL-2.0","licenseUrl":"https://github.com/TurboVNC/turbovnc/blob/HEAD/LICENSE.txt","locale":"en-US","longDescription":"TurboVNC is a high-performance, enterprise-quality version of VNC based on TightVNC, TigerVNC, and X.org.\nIt contains a variant of Tight encoding that is tuned for maximum performance and compression with 3D applications (VirtualGL), video, and other image-intensive workloads.\nTurboVNC, in combination with VirtualGL, provides a complete solution for remotely displaying 3D applications with interactive performance.\nTurboVNC's high-speed encoding methods have been adopted by TigerVNC and libvncserver, and TurboVNC is also compatible with any other TightVNC derivative.","name":"TurboVNC","packageUrl":"https://turbovnc.org/","publisher":"The VirtualGL Project","publisherUrl":"https://turbovnc.org/","releaseNotesUrl":"https://github.com/TurboVNC/turbovnc/releases/tag/3.2","tags":["vnc","remoteaccess","remotedesktop","remote-access","remote-desktop"]},"zh-CN":{"description":"高速、3D 友好、兼容 TightVNC 的远程桌面软件","locale":"zh-CN","longDescription":"TurboVNC 是基于 TightVNC、TigerVNC 和 X.org 的高性能企业级 VNC 版本。\n它包含 Tight 编码的一个变种，经过调整后可在 3D 应用程序 (VirtualGL)、视频和其它图像密集型工作负载实现最高性能和压缩。\nTurboVNC 与 VirtualGL 相结合，为远程显示具有交互性能的 3D 应用程序提供了完整的解决方案。\nTurboVNC 的高速编码方法已被 TigerVNC 和 libvncserver 采用，TurboVNC 还与其它任何 TightVNC 衍生产品兼容。","releaseNotesUrl":"https://github.com/TurboVNC/turbovnc/releases/tag/3.2","tags":["vnc"]}},"publisherUrl":"https://turbovnc.org/","releaseDate":"2025-05-06","releaseDateSource":"manifest","releaseNotesUrl":"https://github.com/TurboVNC/turbovnc/releases/tag/3.2","schemaVersion":1,"source":"winget","upstream":{"commit":"97d6aa2689f0a05f7847653a62b8624720d15b5d","manifestVersion":"1.10.0","manifests":[{"path":"manifests/v/VirtualGL/TurboVNC/3.2/VirtualGL.TurboVNC.yaml","sha256":"e6fbbb9a1305146bc7c1b8ed24c18a63c7fd3471b8647fd16c548439bfc7bd15"},{"path":"manifests/v/VirtualGL/TurboVNC/3.2/VirtualGL.TurboVNC.installer.yaml","sha256":"d8638e1a37f00a291b32bc7e3e2a38d9587b2afbb40a35a846a7a84b51c62abf"},{"path":"manifests/v/VirtualGL/TurboVNC/3.2/VirtualGL.TurboVNC.locale.en-US.yaml","sha256":"4bc5f7fd8a53a76b25aafb71fa42682311a9e470c3c3c3f8e886b35bfbc32131"},{"path":"manifests/v/VirtualGL/TurboVNC/3.2/VirtualGL.TurboVNC.locale.zh-CN.yaml","sha256":"301fadbe98d2af1289bd4faf0e5c1f11f2850885e29bfd294072e5fedee07a76"}],"repository":"microsoft/winget-pkgs"},"version":"3.2"}