{"defaultLocale":"en-US","id":"v2matosevic.WinSnipper","installers":[{"architecture":"x64","commands":["winsnipper"],"dependencies":[{"PackageDependencies":[{"PackageIdentifier":"Microsoft.DotNet.DesktopRuntime.8"}]}],"id":"x64-portable","minimumOSVersion":"10.0.17763.0","platforms":["Windows.Desktop"],"priority":4,"sha256":"b317d1a10ef8922c888f0446ff7efc9ba474cb05553fe1ef69d131f5e66b24e9","successCodes":[],"type":"portable","url":"https://github.com/v2matosevic/WinSnipper/releases/download/v0.5.1/WinSnipper.exe"}],"licenseUrl":"https://github.com/v2matosevic/WinSnipper/blob/master/LICENSE","packageLocalizations":{"en-US":{"description":"Ultra-lightweight Win+Shift+S replacement - snip, floating thumbnail, annotate, paste.","license":"MIT","licenseUrl":"https://github.com/v2matosevic/WinSnipper/blob/master/LICENSE","locale":"en-US","longDescription":"WinSnipper replaces the built-in Windows snip with a faster flow: press the\nhotkey, drag a region, and the snip is saved, copied to the clipboard, and\npinned as a small floating thumbnail. Click the thumbnail to annotate\n(rectangle, freehand, ellipse, arrow, text, numbered step badges,\nredact/pixelate, crop) or drag it straight into any app as a file.\nNo confirmation dialogs anywhere - closing the editor saves silently and\nrefreshes the clipboard. Built for fast feedback loops, especially pasting\nannotated screenshots into AI coding chats.","moniker":"winsnipper","name":"WinSnipper","packageUrl":"https://github.com/v2matosevic/WinSnipper","publisher":"Marko Matošević","publisherUrl":"https://github.com/v2matosevic","releaseNotesUrl":"https://github.com/v2matosevic/WinSnipper/releases/tag/v0.5.1","tags":["annotation","capture","ocr","productivity","screen-capture","screenshot","snip","snipping-tool"]}},"publisherUrl":"https://github.com/v2matosevic","releaseNotesUrl":"https://github.com/v2matosevic/WinSnipper/releases/tag/v0.5.1","schemaVersion":1,"source":"winget","upstream":{"commit":"97d6aa2689f0a05f7847653a62b