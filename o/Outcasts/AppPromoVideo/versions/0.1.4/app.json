{"defaultLocale":"en-US","id":"Outcasts.AppPromoVideo","installers":[{"architecture":"x64","dependencies":[],"elevation":{"requirement":"elevationRequired","source":"inferred"},"id":"x64-machine-wix","installModes":["interactive","silent","silentWithProgress"],"platforms":["Windows.Desktop"],"priority":2,"scope":"machine","sha256":"bec91ad5ee34914409da066dc2d8f00d013e229f2e364b101d406eb9148fd64b","silent":{"arguments":"/quiet /norestart","source":"default"},"successCodes":[],"type":"wix","uninstall":{"type":"productCode","value":"{E3C61415-A415-4621-B914-8172412284DA}"},"upgradeBehavior":"install","url":"https://github.com/betyourluck/AppPromoVideo/releases/download/v0.1.4/AppPromoVideo_0.1.4_x64_en-US.msi"}],"licenseUrl":"https://github.com/betyourluck/AppPromoVideo/blob/main/LICENSE","packageLocalizations":{"en-US":{"description":"Turns an existing app repository and UI snapshots into scene-by-scene prompts and reference images ready to paste into video-generation AIs.","license":"MIT","licenseUrl":"https://github.com/betyourluck/AppPromoVideo/blob/main/LICENSE","locale":"en-US","longDescription":"AppPromoVideo is a desktop tool for making promotional videos of your own software with video-generation AIs. Point it at an app repository and a few UI screenshots, and it produces a scene-by-scene brief - copy lines, motion and video prompts, and reference images in which the real screenshots are composited onto AI-generated backdrops, so the product UI stays faithful to the original. The output is meant to be pasted directly into an image-to-video service; the tool does not render the video itself. Code analysis is delegated to a locally installed LLM CLI, and reference images can be generated with OpenAI Images, Gemini, or a local ComfyUI.","moniker":"apppromovideo","name":"Outcasts AppPromoVideo","packageUrl":"https://github.com/betyourluck/AppPromoVideo","publisher":"Outcasts","publisherUrl":"https://outcasts.jp","releaseNotesUrl":"https://github.com/betyourluck/Ap