{"defaultLocale":"en-US","id":"Outcasts.Lorekeel","installers":[{"architecture":"x64","dependencies":[],"elevation":{"requirement":"elevationRequired","source":"inferred"},"id":"x64-machine-wix","installModes":["interactive","silent","silentWithProgress"],"platforms":["Windows.Desktop"],"priority":2,"scope":"machine","sha256":"65b6c0a19afd81d53609ff48fe093d8e554233e01878c7019a3b675b07046cd4","silent":{"arguments":"/quiet /norestart","source":"default"},"successCodes":[],"type":"wix","uninstall":{"type":"productCode","value":"{B9B0A177-99A5-45B3-B222-33D5924507E9}"},"upgradeBehavior":"install","url":"https://github.com/betyourluck/Lorekeel/releases/download/v0.7.3/Lorekeel_0.7.3_x64_en-US.msi"}],"licenseUrl":"https://github.com/betyourluck/Lorekeel/blob/main/LICENSE","packageLocalizations":{"en-US":{"description":"A TRPG game master that never forgets or contradicts - an LLM narrates while a deterministic Rust engine owns the game state.","license":"MIT","licenseUrl":"https://github.com/betyourluck/Lorekeel/blob/main/LICENSE","locale":"en-US","longDescription":"Lorekeel is a desktop TRPG game master. A cloud or local LLM writes the narration, while a deterministic Rust engine owns the game state - HP, inventory, flags, dice rolls, and location. The engine adjudicates every change the model proposes, so the GM cannot forget what you carry, who died, or what was decided last turn. Because the engine backs up the model's mistakes, coherent play does not require a frontier model. Scenario packages are plain YAML folders you can write, share, and download from a community archive.","moniker":"lorekeel","name":"Outcasts Lorekeel","packageUrl":"https://github.com/betyourluck/Lorekeel","publisher":"Outcasts","publisherUrl":"https://outcasts.jp","releaseNotesUrl":"https://github.com/betyourluck/Lorekeel/releases/tag/v0.7.3","tags":["ai","game-master","llm","narrative","roleplaying","rpg","storytelling","tabletop","trpg","ttrpg"]}},"publisherUrl":"https://outcasts.jp","release