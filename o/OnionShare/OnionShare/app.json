{"architectures":["x64","x86"],"id":"OnionShare.OnionShare","latestVersion":"2.7.1","media":{"icons":[],"screenshots":[]},"package":{"description":"OnionShare is an open source tool that lets you securely and anonymously share files, host websites, and chat with friends using the Tor network","license":"GPL-3.0","licenseUrl":"https://github.com/onionshare/onionshare/blob/HEAD/LICENSE.txt","locale":"en-US","localizations":{"en-US":{"description":"OnionShare is an open source tool that lets you securely and anonymously share files, host websites, and chat with friends using the Tor network","license":"GPL-3.0","licenseUrl":"https://github.com/onionshare/onionshare/blob/HEAD/LICENSE.txt","locale":"en-US","longDescription":"OnionShare lets you securely and anonymously share files of any size.\nIt works by starting a web server, making it accessible as a Tor onion service, and generating an unguessable URL to access and download the files.\nIt doesn't require setting up a server on the internet somewhere or using a third party file-sharing service.\nYou host the file on your own computer and use a Tor onion service to make it temporarily accessible over the internet.\nThe other user just needs to use Tor Browser to download the file from you.","moniker":"onionshare","name":"OnionShare","packageUrl":"https://onionshare.org/","publisher":"Micah Lee, et al.","publisherUrl":"https://github.com/onionshare/onionshare","releaseNotesUrl":"https://github.com/onionshare/onionshare/releases/tag/v2.7.1","tags":["cross-platform","file-sharing","foss","open-source","privacy","security","sharing","tor","tor-onion-service"]}},"longDescription":"OnionShare lets you securely and anonymously share files of any size.\nIt works by starting a web server, making it accessible as a Tor onion service, and generating an unguessable URL to access and download the files.\nIt doesn't require setting up a server on the internet somewhere or using a third party file-sharing service.\nYou host the file on your own computer and use a Tor onion service to make it temporarily accessible over the internet.\nThe other user just needs to use Tor Browser to download the file from you.","moniker":"onionshare","name":"OnionShare","packageUrl":"https://onionshare.org/","publisher":"Micah Lee, et al.","publisherUrl":"https://github.com/onionshare/onionshare","releaseNotesUrl":"https://github.com/onionshare/onionshare/releases/tag/v2.7.1","tags":["cross-platform","file-sharing","foss","open-source","privacy","security","sharing","tor","tor-onion-service"]},"schemaVersion":1,"source":"winget","versions":[{"architectures":["x64"],"detailPath":"versions/2.7.1/app.json","detailSha256":"906adcd8603d1a48e606dbb74e8f5c20f2ddeb679d3dee6df957a5a92de7e839","releaseDate":"2026-10-29","releaseDateSource":"manifest","version":"2.7.1"},{"architectures":["x64"],"detailPath":"versions/2.7/app.json","detailSha256":"d56c8bc1aa029d42129f1ce957c41104eaa0b6eb0609764f2687289fa2a9fffe","releaseDate":"2026-10-16","releaseDateSource":"manifest","version":"2.7"},{"architectures":["x64"],"detailPath":"versions/2.6.5/app.json","detailSha256":"676497999eb361e7182977277e122153db39eb8257dea0a3923db25cec0b4c38","releaseDate":"2026-07-28","releaseDateSource":"manifest","version":"2.6.5"},{"architectures":["x64"],"detailPath":"versions/2.6.3/app.json","detailSha256":"fc217d07f6e0129bb5d8aecfadfeec18562d24d2d3c014a6e2f373c6b1da40b9","releaseDate":"2025-02-25","releaseDateSource":"manifest","version":"2.6.3"},{"architectures":["x64"],"detailPath":"versions/2.6.2/app.json","detailSha256":"8ce19aecb014eadbd28872dbfbbe38021f27b53af2e26f7e86143e80372d8693","releaseDate":"2024-03-21","releaseDateSource":"manifest","version":"2.6.2"},{"architectures":["x64"],"detailPath":"versions/2.6.1/app.json","detailSha256":"ba59fba98ae19666a2fcbf7837f739cd0461d596d56acb8462b0d6790b4d21ec","releaseDate":"2024-02-28","releaseDateSource":"manifest","version":"2.6.1"},{"architectures":["x64","x86"],"detailPath":"versions/2.6/app.js