{"architectures":["x64"],"id":"Opera.OperaAir","latestVersion":"139.0.6053.62","media":{"icons":[{"mimeType":"image/png","path":"media/icon.befac2ed.png","priority":1,"sha256":"befac2ed479219f6f843ee20165b71c6ca19be3b9d2f42b80a6da77cdc99635f","source":"winget-legacy"}],"screenshots":[]},"package":{"author":"Opera Norway AS","copyright":"Copyright © 1995-2026 Opera Software AS. All rights reserved.","copyrightUrl":"https://legal.opera.com/terms/","description":"The world’s first browser with mindfulness at its core - no subscriptions, no app juggling. Discover a focused, balanced, and stress-free web.","documentations":[{"DocumentLabel":"Tutorial","DocumentUrl":"https://www.opera.com/tutorials"},{"DocumentLabel":"FAQ","DocumentUrl":"https://help.opera.com/faq/"}],"license":"Freeware","licenseUrl":"https://legal.opera.com/eula/computers/","locale":"en-US","localizations":{"en-US":{"author":"Opera Norway AS","copyright":"Copyright © 1995-2026 Opera Software AS. All rights reserved.","copyrightUrl":"https://legal.opera.com/terms/","description":"The world’s first browser with mindfulness at its core - no subscriptions, no app juggling. Discover a focused, balanced, and stress-free web.","documentations":[{"DocumentLabel":"Tutorial","DocumentUrl":"https://www.opera.com/tutorials"},{"DocumentLabel":"FAQ","DocumentUrl":"https://help.opera.com/faq/"}],"license":"Freeware","licenseUrl":"https://legal.opera.com/eula/computers/","locale":"en-US","longDescription":"Opera Air is a brand new browser with mindfulness at its core, that meets the needs of our busy lives by reducing distractions and helping you focus. It integrates features that support relaxation and well-being, such as meditation and breathing practices, binaural beats, and neck stretches.\nDeveloped with tried and true methods, Opera Air creates an environment that helps boost productivity and creativity while promoting mental health and creating a calmer, more focused browsing experience.","name":"Opera Air","packageUrl":"https://www.opera.com/air","privacyUrl":"https://legal.opera.com/privacy/","publisher":"Opera Software","publisherSupportUrl":"https://www.opera.com/help","publisherUrl":"https://www.opera.com/","tags":["browser","chromium","internet","manifestv2","mv2","web","webpage"]},"zh-CN":{"copyright":"版权所有 © 1995-2026 Opera Software AS。保留所有权利。","description":"全球首款以“专注”为核心的浏览器--无需订阅，无需玩转各种应用。探索一个专注、平衡、无压力的网络。","documentations":[{"DocumentLabel":"教程","DocumentUrl":"https://www.opera.com/tutorials"},{"DocumentLabel":"常见问题","DocumentUrl":"https://help.opera.com/faq/"}],"license":"免费软件","locale":"zh-CN","longDescription":"Opera Air 是一款全新的浏览器，其核心是“心智”，通过减少干扰和帮助您集中注意力，从而满足我们在繁忙生活中的需求。它集成了放松与健康功能，如冥想和呼吸练习、双耳节拍和颈部拉伸。\nOpera Air 基于久经考验的方法开发，创造了一种有助于提高工作效率和创造力的环境，同时促进了心理健康，创造了一种更平静、更专注的浏览体验。","packageUrl":"https://www.opera.com/zh-cn/air","publisherSupportUrl":"https://www.opera.com/zh-cn/help","publisherUrl":"https://www.opera.com/zh-cn","tags":["chromium","互联网","浏览器","网页"]}},"longDescription":"Opera Air is a brand new browser with mindfulness at its core, that meets the needs of our busy lives by reducing distractions and helping you focus. It integrates features that support relaxation and well-being, such as meditation and breathing practices, binaural beats, and neck stretches.\nDeveloped with tried and true methods, Opera Air creates an environment that helps boost productivity and creativity while promoting mental health and creating a calmer, more focused browsing experience.","name":"Opera Air","packageUrl":"https://www.opera.com/air","privacyUrl":"https://legal.opera.com/privacy/","publisher":"Opera Software","publisherSupportUrl":"https://www.opera.com/help","publisherUrl":"https://www.opera.com/","tags":["browser","chromium","internet","manifestv2","mv2","web","webpage"]},"schemaVersion":1,"source":"winget","versions":[{"architectures":["x64"],"detailPath":"versions/139.0.6053.62/app.json","detailSha256":"9af1f3aa7d4d2bc79363b0c8ffc7f00c74c7d3b9bd7a0059886ef6600b4