{"defaultLocale":"en-US","id":"open-policy-agent.opa","installers":[{"architecture":"x64","commands":["opa"],"dependencies":[],"id":"x64-portable","priority":4,"sha256":"ef8bd2e56a329f91192053da7e4adfb09fbfdaee07de588d6c10b939d581bc64","successCodes":[],"type":"portable","url":"https://github.com/open-policy-agent/opa/releases/download/v1.22.2/opa_windows_amd64.exe"}],"licenseUrl":"https://github.com/open-policy-agent/opa/blob/main/LICENSE","packageLocalizations":{"en-US":{"description":"Open Policy Agent (OPA) is an open source, general-purpose policy engine that enables unified, context-aware policy enforcement across the entire stack.","license":"Apache-2.0","licenseUrl":"https://github.com/open-policy-agent/opa/blob/main/LICENSE","locale":"en-US","name":"Open Policy Agent","packageUrl":"https://www.openpolicyagent.org/","publisher":"Open Policy Agent","publisherSupportUrl":"https://github.com/open-policy-agent/opa/issues","publisherUrl":"https://www.openpolicyagent.org/","releaseNotes":"This is a bugfix release for a type checker regression in v1.21.0.\n\n### Iterating an empty collection is rejected by the type checker\n\nPolicies that iterate a collection known to be empty, such as `some x in []` or `m[_]` where `m := {}`,\nwere rejected with `rego_type_error：undefined ref`. Iteration with a non-constant key is valid again, and simply\nyields nothing. Comparing or unifying the elements of such a collection with a value is accepted as well.\nConstant keys, like `[][0]`, are still reported as undefined.\n\nReported by @kholia.","releaseNotesUrl":"https://github.com/open-policy-agent/opa/releases/tag/v1.22.2"}},"publisherSupportUrl":"https://github.com/open-policy-agent/opa/issues","publisherUrl":"https://www.openpolicyagent.org/","releaseDate":"2026-11-07","releaseDateSource":"commit","releaseNotesUrl":"https://github.com/open-policy-agent/opa/releases/tag/v1.22.2","schemaVersion":1,"source":"winget","upstream":{"commit":"1e3956241368fadff8aa69834eecd687c8ed7276