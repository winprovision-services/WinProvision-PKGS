{"architectures":["x64"],"id":"Oksion.XiControl","latestVersion":"0.19.0","media":{"icons":[],"screenshots":[]},"package":{"description":"Tray utility for Xiaomi/Redmi laptops - battery charge limit, performance modes, OSD and Mi button, driver-free via the stock firmware WMI interface (MIFS).","license":"GPL-3.0","licenseUrl":"https://github.com/Oksion/XiControl/blob/HEAD/LICENSE","locale":"en-US","localizations":{"en-US":{"description":"Tray utility for Xiaomi/Redmi laptops - battery charge limit, performance modes, OSD and Mi button, driver-free via the stock firmware WMI interface (MIFS).","license":"GPL-3.0","licenseUrl":"https://github.com/Oksion/XiControl/blob/HEAD/LICENSE","locale":"en-US","longDescription":"Xi Control is a lightweight tray utility for Xiaomi / Redmi (Redmibook) laptops,\nbuilt primarily for the Xiaomi Book Pro 14 (2026) but not limited to it.\nBattery care (charge limit) with automatic re-arm after sleep, five performance\nmodes including the hidden Eco mode, OSD overlays, Mi button gestures, special\nkey fixes (Fn-Lock OSD, microphone mute, keyboard backlight levels) and an\nowl mode that keeps the system awake while the lid is closed on AC power.\nEverything is driven through the firmware's stock WMI interface - no WinRing0,\nno third-party drivers. Requires administrator rights (a firmware WMI\nrequirement); the app elevates itself via UAC on launch.","moniker":"xicontrol","name":"Xi Control","packageUrl":"https://github.com/Oksion/XiControl","publisher":"Oksion","publisherUrl":"https://github.com/Oksion","releaseNotesUrl":"https://github.com/Oksion/XiControl/releases/tag/v0.19.0","tags":["battery","charge-limit","laptop","redmi","redmibook","tray","wmi","xiaomi"]}},"longDescription":"Xi Control is a lightweight tray utility for Xiaomi / Redmi (Redmibook) laptops,\nbuilt primarily for the Xiaomi Book Pro 14 (2026) but not limited to it.\nBattery care (charge limit) with automatic re-arm after sleep, five performance\nmodes including the hidden Eco mode, OSD overlays, Mi button gestures, special\nkey fixes (Fn-Lock OSD, microphone mute, keyboard backlight levels) and an\nowl mode that keeps the system awake while the lid is closed on AC power.\nEverything is driven through the firmware's stock WMI interface - no WinRing0,\nno third-party drivers. Requires administrator rights (a firmware WMI\nrequirement); the app elevates itself via UAC on launch.","moniker":"xicontrol","name":"Xi Control","packageUrl":"https://github.com/Oksion/XiControl","publisher":"Oksion","publisherUrl":"https://github.com/Oksion","releaseNotesUrl":"https://github.com/Oksion/XiControl/releases/tag/v0.19.0","tags":["battery","charge-limit","laptop","redmi","redmibook","tray","wmi","xiaomi"]},"schemaVersion":1,"source":"winget","versions":[{"architectures":["x64"],"detailPath":"versions/0.19.0/app.json","detailSha256":"ca07da101b0b1b8ec37b4a0c0665e2c086642f54653efc30f5e87f06b96b29f0","releaseDate":"2026-10-29","releaseDateSource":"manifest","version":"0.19.0"},{"architectures":["x64"],"detailPath":"versions/0.18.0/app.json","detailSha256":"4e6e5d9a6b115bdb34864e84230c96719d5bd943fc0ea2a2b68060aab0998bb2","releaseDate":"2026-10-18","releaseDateSource":"manifest","version":"0.18.0"},{"architectures":["x64"],"detailPath":"versions/0.17.0/app.json","detailSha256":"b3f010f01601a6fc05f9485b874ddae53911cfd8437b0accbb2f22878e047915","releaseDate":"2026-10-11","releaseDateSource":"manifest","version":"0.17.0"},{"architectures":["x64"],"detailPath":"versions/0.16.1/app.json","detailSha256":"cd47642166e94b62cc04b25996687d906c2af4735b0d59e317c1ca6b41b0d991","releaseDate":"2026-10-10","releaseDateSource":"manifest","version":"0.16.1"},{"architectures":["x64"],"detailPath":"versions/0.16.0/app.json","detailSha256":"a648d1e416927837d1e7d67133858c4cef10ccd568f72a59133cb35853d07f07","releaseDate":"2026-09-24","releaseDateSource":"manifest","version":"0.16.0"},{"architectures":["x64"],"detailPath":"versions/0.15.0/app.json","detailSha256":"550f27