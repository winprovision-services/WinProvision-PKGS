{"architectures":["x64","x86"],"id":"Oracle.VirtualBox","latestVersion":"7.2.22","media":{"icons":[],"screenshots":[]},"package":{"description":"VirtualBox is a general-purpose full virtualization software for x86_64 hardware (with version 7.1 additionally for macOS/Arm), targeted at laptop, desktop, server and embedded use.","license":"GPL-3.0-only","licenseUrl":"https://www.virtualbox.org/wiki/Licensing_FAQ","locale":"en-US","localizations":{"en-US":{"description":"VirtualBox is a general-purpose full virtualization software for x86_64 hardware (with version 7.1 additionally for macOS/Arm), targeted at laptop, desktop, server and embedded use.","license":"GPL-3.0-only","licenseUrl":"https://www.virtualbox.org/wiki/Licensing_FAQ","locale":"en-US","longDescription":"VirtualBox is a general-purpose full virtualization software for x86_64 hardware (with version 7.1 additionally for macOS/Arm), targeted at laptop, desktop, server and embedded use.\n\nIt features a very user friendly graphical user interface and is available for many popular operating systems (Linux, Windows, macOS and Solaris). Flexible networking setup and interactive performance are the strong points.\n\nAnyone with the need to run multiple operating systems simultaneously with some basic knowledge about PCs and operating system installation can use it to reduce effort with a large number of tasks including software testing.","moniker":"virtualbox","name":"Oracle VirtualBox","packageUrl":"https://www.virtualbox.org/","publisher":"Oracle and/or its affiliates","publisherUrl":"https://www.oracle.com/","tags":["cross-platform","foss","virtual-machine","virtualization"]}},"longDescription":"VirtualBox is a general-purpose full virtualization software for x86_64 hardware (with version 7.1 additionally for macOS/Arm), targeted at laptop, desktop, server and embedded use.\n\nIt features a very user friendly graphical user interface and is available for many popular operating systems (Linux, Windows, macOS and Solaris). Flexible networking setup and interactive performance are the strong points.\n\nAnyone with the need to run multiple operating systems simultaneously with some basic knowledge about PCs and operating system installation can use it to reduce effort with a large number of tasks including software testing.","moniker":"virtualbox","name":"Oracle VirtualBox","packageUrl":"https://www.virtualbox.org/","publisher":"Oracle and/or its affiliates","publisherUrl":"https://www.oracle.com/","tags":["cross-platform","foss","virtual-machine","virtualization"]},"schemaVersion":1,"source":"winget","versions":[{"architectures":["x64"],"detailPath":"versions/7.2.22/app.json","detailSha256":"f6e11f9da7d868514640d851aa3e1fb63d03a8d4f460d9ff91b32bae9bff3801","releaseDate":"2026-10-20","releaseDateSource":"manifest","version":"7.2.22"},{"architectures":["x64"],"detailPath":"versions/7.2.20/app.json","detailSha256":"be6639f3e286756e9c6ab0c16968b3f2ec2c167988176739b937fb8ccefe5e2a","releaseDate":"2026-09-22","releaseDateSource":"manifest","version":"7.2.20"},{"architectures":["x64"],"detailPath":"versions/7.2.18/app.json","detailSha256":"d05ec93f9bf8322d5240de96a1204374e77abf71a5893a0ea0726486eb6b2c86","releaseDate":"2026-09-15","releaseDateSource":"manifest","version":"7.2.18"},{"architectures":["x64"],"detailPath":"versions/7.2.16/app.json","detailSha256":"5eb5b99e032b4339cf5b682c553be997edbeb0cb30a26fa21aec2ec0086f4778","releaseDate":"2026-08-14","releaseDateSource":"manifest","version":"7.2.16"},{"architectures":["x64"],"detailPath":"versions/7.2.14/app.json","detailSha256":"3b40649b058cb7d95c16244f6640d9b7d7baf5951928a9f49f5273eb82da102d","releaseDate":"2026-07-20","releaseDateSource":"manifest","version":"7.2.14"},{"architectures":["x64"],"detailPath":"versions/7.2.12/app.json","detailSha256":"4779dcbd66d68d1568be7bc1b06f9a6e603295672c18995b5a119f7fca1d7765","releaseDate":"2026-06-29","releaseDateSource":"manifest","version":"7.2.12"},{"architectures":["x64"],"detailPath"