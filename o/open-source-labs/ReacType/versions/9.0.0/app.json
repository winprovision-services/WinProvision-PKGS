{"defaultLocale":"en-US","id":"open-source-labs.ReacType","installers":[{"architecture":"x64","dependencies":[],"id":"x64-user-nullsoft","minimumOSVersion":"10.0.0.0","priority":1,"scope":"user","sha256":"5475e08884dbbf941911398c532c116f90cf45755973b0c979de1b90c0efd3f6","silent":{"arguments":"/S","source":"default"},"successCodes":[],"type":"nullsoft","url":"https://github.com/open-source-labs/ReacType/releases/download/9.0.0/ReacType.9.0.0.exe"}],"licenseUrl":"https://github.com/open-source-labs/ReacType/blob/master/LICENSE.md","packageLocalizations":{"en-US":{"description":"Prototyping tool for React/Typescript Applications.","license":"MIT License","licenseUrl":"https://github.com/open-source-labs/ReacType/blob/master/LICENSE.md","locale":"en-US","longDescription":"ReacType is a rapid prototyping tool for developers employing React component architecture alongside the comprehensive type-checking of TypeScript. In other words, you can draw prototypes and export React / TypeScript code!\n\nReacType allows users to visualize their application architecture dynamically, employing a drag-and-drop canvas display , a real-time demo render , a real-time component code preview. \nUsers can create components and drag instances of these components, as well as HTML elements, onto the canvas. \nThis architecture can then be exported as TypeScript application files to be used as a starter template for any repository.","name":"ReacType","packageUrl":"https://github.com/open-source-labs/ReacType","publisher":"OS Labs","publisherUrl":"https://github.com/open-source-labs/ReacType","tags":["developer","electron","prototype","react","reactnative","typescript"]}},"publisherUrl":"https://github.com/open-source-labs/ReacType","schemaVersion":1,"source":"winget","upstream":{"commit":"97d6aa2689f0a05f7847653a62b8624720d15b5d","manifestVersion":"1.1.0","manifests":[{"path":"manifests/o/open-source-labs/ReacType/9.0.0/open-source-labs.ReacType.yaml","sha256":"1d6cc3cf46e7bd43dbf13706dd4db8d