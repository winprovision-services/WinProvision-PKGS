 collect telemetry.","moniker":"renderpilot","name":"RenderPilot","packageUrl":"https://github.com/osyka-yuri/renderpilot","publisher":"osyka-yuri","publisherUrl":"https://github.com/osyka-yuri","releaseNotesUrl":"https://github.com/osyka-yuri/renderpilot/releases/tag/v1.15.0","tags":["d3d12","directstorage","dlss","frame-generation","fsr","game-tools","hdr","luma-framework","nvidia","optiscaler","pc-gaming","ray-reconstruction","renodx","reshade","upscaling","xess"]}},"publisherUrl":"https://github.com/osyka-yuri","releaseDate":"2026-10-04","releaseDateSource":"manifest","releaseNotesUrl":"https://github.com/osyka-yuri/renderpilot/releases/tag/v1.15.0","schemaVersion":1,"source":"winget","upstream":{"commit":"97d6aa2689f0a05f7847653a62b8624720d15b5d","manifestVersion":"1.12.0","manifests":[{"path":"manifests/o/osyka-yuri/RenderPilot/1.15.0/osyka-yuri.RenderPilot.yaml","sha256":"3c209da308ab22db783acf646240634bf500a06194ea0307238570221367adbb"},{"path":"manifests/o/osyka-yuri/RenderPilot/1.15.0/osyka-yuri.RenderPilot.installer.yaml","sha256":"ab04fe44129b33636987b654a0478796a07e9104153ebaf272adf59ba5f2faa8"},{"path":"manifests/o/osyka-yuri/RenderPilot/1.15.0/osyka-yuri.RenderPilot.locale.en-US.yaml","sha256":"4b30a7c041cd910dacc3e8eab3f59717407ca0818b6b25a0074a5b483dafb000"}],"repository":"microsoft/winget-pkgs"},"version":"1.15.0"}