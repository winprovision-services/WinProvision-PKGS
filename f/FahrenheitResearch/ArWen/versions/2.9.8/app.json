{"defaultLocale":"en-US","id":"FahrenheitResearch.ArWen","installers":[{"architecture":"x64","commands":["gfs_grib2_bridge","grib1_bridge","grib2_dump","grib2_inventory","hrrr_grib2_bridge","rw_fetch","rw_wrfbatch"],"dependencies":[],"id":"x64-zip","installModes":["interactive","silent","silentWithProgress"],"nestedInstallerFiles":[{"PortableCommandAlias":"gfs_grib2_bridge","RelativeFilePath":"gfs_grib2_bridge.exe"},{"PortableCommandAlias":"grib1_bridge","RelativeFilePath":"grib1_bridge.exe"},{"PortableCommandAlias":"grib2_dump","RelativeFilePath":"grib2_dump.exe"},{"PortableCommandAlias":"grib2_inventory","RelativeFilePath":"grib2_inventory.exe"},{"PortableCommandAlias":"hrrr_grib2_bridge","RelativeFilePath":"hrrr_grib2_bridge.exe"},{"PortableCommandAlias":"rw_fetch","RelativeFilePath":"rw_fetch.exe"},{"PortableCommandAlias":"rw_wrfbatch","RelativeFilePath":"rw_wrfbatch.exe"}],"nestedInstallerType":"portable","priority":4,"sha256":"b654dc442a42bf6f3f622a05d3d81ad956f9ca957a6cfb2c0d02cb06dd0707d4","successCodes":[],"type":"zip","upgradeBehavior":"uninstallPrevious","url":"https://github.com/FahrenheitResearch/arwen/releases/download/v2.9.8/gpuwm-bridges-v2.9.8-win-x86_64.zip"}],"licenseUrl":"https://github.com/FahrenheitResearch/arwen/blob/main/LICENSE","packageLocalizations":{"en-US":{"description":"ArWen: GPU-native WRF-ARW-class regional weather model, verified against WRF v4.6.1","license":"Apache-2.0","licenseUrl":"https://github.com/FahrenheitResearch/arwen/blob/main/LICENSE","locale":"en-US","longDescription":"ArWen is an independent, GPU-native implementation of a WRF-ARW-class regional atmospheric model. It is not affiliated with or endorsed by NCAR or UCAR. The name is a wordmark for \"the ARW solver, GPU-native\"; the Python package is currently named gpuwm. Safety. ArWen is a research and educational tool. It is never a substitute for official forecasts and warnings from your national meteorological service. Do not use it to make safety decisions. Regional numerical weather prediction at convective scale has mostly required institutional clusters, which means most of the world runs on global-model guidance at 10-25 km. ArWen's aim is to put a verified, kilometer-scale limited-area model on a single consumer GPU: pick a point, size a nest ladder to your card, pull public analysis data, and run a 1 km (or 500 m) simulation of your own area on hardware you own -- especially in places where no national convection-permitting model exists.","moniker":"arwen","name":"ArWen","packageUrl":"https://github.com/FahrenheitResearch/arwen","publisher":"Fahrenheit Research","publisherUrl":"https://github.com/FahrenheitResearch","releaseNotesUrl":"https://github.com/FahrenheitResearch/arwen/releases/tag/v2.9.8","tags":[]}},"publisherUrl":"https://github.com/FahrenheitResearch","releaseDate":"2026-10-26","releaseDateSource":"manifest","releaseNotesUrl":"https://github.com/FahrenheitResearch/arwen/releases/tag/v2.9.8","schemaVersion":1,"source":"winget","upstream":{"commit":"97d6aa2689f0a05f7847653a62b8624720d15b5d","manifestVersion":"1.28.0","manifests":[{"path":"manifests/f/FahrenheitResearch/ArWen/2.9.8/FahrenheitResearch.ArWen.yaml","sha256":"08dddb9600f72a04776a52d3a93475c9782194161075a8b4a40cfba93e90bc15"},{"path":"manifests/f/FahrenheitResearch/ArWen/2.9.8/FahrenheitResearch.ArWen.installer.yaml","sha256":"c63fb9740d0160841a23df9ebd116004070b127ff5b9eff851873a32ee594335"},{"path":"manifests/f/FahrenheitResearch/ArWen/2.9.8/FahrenheitResearch.ArWen.locale.en-US.yaml","sha256":"f32b6062548dc1633617502bafa613e168607520604a6eca3bf01b2dba960f99"}],"repository":"microsoft/winget-pkgs"},"version":"2.9.8"}