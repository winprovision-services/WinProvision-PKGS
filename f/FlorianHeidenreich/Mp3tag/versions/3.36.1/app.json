ag"]},"zh-CN":{"description":"通用标签编辑器，以及更多……","license":"免费软件","locale":"zh-CN","longDescription":"Mp3tag 是一款功能强大、简单易用的音频文件元数据编辑工具。\n支持批量编辑 ID3v1、ID3v2.3、ID3v2.4、iTunes MP4、WMA、Vorbis Comment 和 APE Tags，一次可编辑多个文件，涵盖+多种音频格式。\n此外，它还支持从 Discogs、MusicBrainz 或 freedb 等在线数据库查找，让你可以自动收集适当的标签，并为你的音乐库下载封面。\n你可以根据标签信息重新命名文件，替换标签和文件名中的字符或单词，导入/导出标签信息，创建播放列表等。","name":"Mp3tag","packageUrl":"https://www.mp3tag.de/en/","publisher":"Florian Heidenreich","publisherUrl":"https://www.mp3tag.de/en","releaseNotesUrl":"https://www.mp3tag.de/en/changelog.html","tags":["id3","mp3","标签","音乐","音频"]}},"publisherUrl":"https://www.mp3tag.de/en","releaseDate":"2026-08-29","releaseDateSource":"manifest","releaseNotesUrl":"https://www.mp3tag.de/en/changelog.html","schemaVersion":1,"source":"winget","upstream":{"commit":"97d6aa2689f0a05f7847653a62b8624720d15b5d","manifestVersion":"1.12.0","manifests":[{"path":"manifests/f/FlorianHeidenreich/Mp3tag/3.36.1/FlorianHeidenreich.Mp3tag.yaml","sha256":"688948dd50c837a2c9a6faef2f9efd07e09f741ccf0d739ce9156f05e57248fe"},{"path":"manifests/f/FlorianHeidenreich/Mp3tag/3.36.1/FlorianHeidenreich.Mp3tag.installer.yaml","sha256":"20cb4f63383669ec748099e089a53c2fe55b9ed5bd0d407edd97a98876774c62"},{"path":"manifests/f/FlorianHeidenreich/Mp3tag/3.36.1/FlorianHeidenreich.Mp3tag.locale.en-US.yaml","sha256":"4fd5208a36eb8dd3abe6f9916966878559e170d955cfe776fc4d2e6b0034a4d1"},{"path":"manifests/f/FlorianHeidenreich/Mp3tag/3.36.1/FlorianHeidenreich.Mp3tag.locale.zh-CN.yaml","sha256":"2f5f6e3b60fc95c4fef7c6451e9db46f1bb980183b9821839932227691dafd31"}],"repository":"microsoft/winget-pkgs"},"version":"3.36.1"}