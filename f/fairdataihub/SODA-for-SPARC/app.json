{"architectures":["x64","x86"],"id":"fairdataihub.SODA-for-SPARC","latestVersion":"19.0.2","media":{"icons":[{"mimeType":"image/png","path":"media/icon.e205ea0b.png","priority":1,"sha256":"e205ea0b9619aa109780bddbc885826c536a2f2ea6b1f198992f03d39268adc1","source":"winget-legacy"}],"screenshots":[]},"package":{"description":"Simplifying data curation for researchers funded by the NIH SPARC initiative","license":"MIT","licenseUrl":"https://github.com/fairdataihub/SODA-for-SPARC/blob/HEAD/LICENSE","locale":"en-US","localizations":{"en-US":{"description":"Simplifying data curation for researchers funded by the NIH SPARC initiative","license":"MIT","licenseUrl":"https://github.com/fairdataihub/SODA-for-SPARC/blob/HEAD/LICENSE","locale":"en-US","longDescription":"SODA (Software to Organize Data Automatically) for SPARC is an open-source and free cross-platform desktop software intended to facilitate the data organization and submission process for SPARC investigators according to the FAIR SPARC data curation guidelines.\nThe idea for a computer software that assists researchers in curating and sharing their data originated during the SPARC Hackathon in December 2018, where it won the Public's Choice Award, before receiving support from the National Institutes of Health (NIH) for further development.\nSODA for SPARC is designed such that users can accomplish all the requirements to submit a SPARC dataset rapidly through a single interface. Moreover, requirements have been broken down into easy-to-perform steps and automation has been integrated to reduce users' effort to a bare minimum during each step, often to just a few clicks.","name":"SODA for SPARC","packageUrl":"https://github.com/fairdataihub/SODA-for-SPARC","publisher":"SODA Team","publisherUrl":"https://github.com/fairdataihub","releaseNotesUrl":"https://github.com/fairdataihub/SODA-for-SPARC/releases/tag/v19.0.2","tags":["curation","mac","sparc-dataset","ubuntu","windows"]}},"longDescription":"SODA (Software to Organize Data Automatically) for SPARC is an open-source and free cross-platform desktop software intended to facilitate the data organization and submission process for SPARC investigators according to the FAIR SPARC data curation guidelines.\nThe idea for a computer software that assists researchers in curating and sharing their data originated during the SPARC Hackathon in December 2018, where it won the Public's Choice Award, before receiving support from the National Institutes of Health (NIH) for further development.\nSODA for SPARC is designed such that users can accomplish all the requirements to submit a SPARC dataset rapidly through a single interface. Moreover, requirements have been broken down into easy-to-perform steps and automation has been integrated to reduce users' effort to a bare minimum during each step, often to just a few clicks.","name":"SODA for SPARC","packageUrl":"https://github.com/fairdataihub/SODA-for-SPARC","publisher":"SODA Team","publisherUrl":"https://github.com/fairdataihub","releaseNotesUrl":"https://github.com/fairdataihub/SODA-for-SPARC/releases/tag/v19.0.2","tags":["curation","mac","sparc-dataset","ubuntu","windows"]},"schemaVersion":1,"source":"winget","versions":[{"architectures":["x64"],"detailPath":"versions/19.0.2/app.json","detailSha256":"3f784e10fd7806608c8f231af88f5e8ce18f365e20235925a913bdf386dfe4df","releaseDate":"2026-08-31","releaseDateSource":"manifest","version":"19.0.2"},{"architectures":["x86"],"detailPath":"versions/18.2.0/app.json","detailSha256":"df3d525a4870446556135d8f94960d60e266470e2ae15b4ebbc9cfbff43c7c0d","releaseDate":"2026-06-16","releaseDateSource":"manifest","version":"18.2.0"},{"architectures":["x86"],"detailPath":"versions/18.1.0/app.json","detailSha256":"d699b6ae2facd2f2ddbb1880ad0f130c4296a43142c257495b183ad915c5545c","releaseDate":"2026-06-16","releaseDateSource":"manifest","version":"18.1.0"},{"architectures":["x86"],"detailPath":"versions/18.0.1/app.json","detailSha256":"898183f88edb119f777e