{"defaultLocale":"en-US","id":"FinalWire.AIDA64.Engineer","installers":[{"architecture":"x64","dependencies":[],"elevation":{"requirement":"elevationRequired","source":"inferred"},"id":"x64-machine-inno","priority":1,"scope":"machine","sha256":"ceecdcd7cf583da96017030f7ab1b16c09512397aa04e4a67da2a0f988099ba0","successCodes":[],"type":"inno","uninstall":{"type":"registryKey","value":"AIDA64 Engineer_is1"},"upgradeBehavior":"install","url":"https://download.aida64.com/aida64engineer840.exe"}],"licenseUrl":"https://www.aida64.com/terms-use","packageLocalizations":{"en-US":{"author":"FinalWire Ltd.","copyright":"Copyright (c) 1995-2026 FinalWire Ltd.","copyrightUrl":"https://www.aida64.com/terms-use","description":"A cutting-edge system information tool for IT technicians","documentations":[{"DocumentLabel":"User Manual","DocumentUrl":"https://www.aida64.com/user-manual"},{"DocumentLabel":"FAQ","DocumentUrl":"https://www.aida64.com/support/faq"}],"license":"Proprietary","licenseUrl":"https://www.aida64.com/terms-use","locale":"en-US","longDescription":"AIDA64 Engineer has a hardware detection engine unrivaled in its class. It provides detailed information about installed software and offers diagnostic functions and support for overclocking. As it is monitoring sensors in real time, it can gather accurate voltage, temperature and fan speed readings, while its diagnostic functions help detect and prevent hardware issues. It also offers a couple of benchmarks for measuring the performance of individual hardware components or the whole system. It is compatible with all 32-bit and 64-bit Windows editions, including Windows 11 and Windows Server 2022.","moniker":"aida64-engineer","name":"AIDA64 Engineer","packageUrl":"https://www.aida64.com/products/aida64-engineer","privacyUrl":"https://www.aida64.com/privacy-policy","publisher":"FinalWire Ltd.","publisherSupportUrl":"https://www.aida64.com/support","publisherUrl":"https://www.aida64.com/","purchaseUrl":"https://www.aida64.c