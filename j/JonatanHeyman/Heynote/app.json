{"architectures":["x64"],"id":"JonatanHeyman.Heynote","latestVersion":"2.9.1","media":{"icons":[],"screenshots":[]},"package":{"description":"A dedicated scratchpad for developers","license":"“Commons Clause” License Condition v1.0","licenseUrl":"https://github.com/heyman/heynote/blob/main/LICENSE","locale":"en-US","localizations":{"en-US":{"description":"A dedicated scratchpad for developers","license":"“Commons Clause” License Condition v1.0","licenseUrl":"https://github.com/heyman/heynote/blob/main/LICENSE","locale":"en-US","longDescription":"Heynote is a dedicated scratchpad for developers. It functions as a large persistent text buffer where you can write down anything you like. Works great for that Slack message you don't want to accidentally send, a JSON response from an API you're working with, notes from a meeting, your daily to-do list, etc.\nThe Heynote buffer is divided into blocks, and each block can have its own Language set (e.g. JavaScript, JSON, Markdown, etc.). This gives you syntax highlighting and lets you auto-format that JSON response.\nAvailable for Mac, Windows, and Linux.","name":"Heynote","packageUrl":"https://heynote.com/","publisher":"Jonatan Heyman","publisherUrl":"https://heyman.info/","releaseNotesUrl":"https://github.com/heyman/heynote/releases/tag/v2.9.1","tags":[]},"zh-CN":{"description":"开发人员专用草稿本","license":"“Commons Clause” License Condition v1.0","licenseUrl":"https://github.com/heyman/heynote/blob/main/LICENSE","locale":"zh-CN","longDescription":"Heynote 是一款专为开发人员设计的草稿本。它就像一个大型的持久文本缓冲区，在这里你可以写下任何你想写的东西。对于不想意外发送的 Slack 消息、API 的 JSON 响应、会议记录、每日待办事项等，它都能发挥巨大作用。\nHeynote 缓冲区分为多个区块，每个区块都有自己的语言集（如 JavaScript、JSON、Markdown 等）。这样就可以突出显示语法，并自动格式化 JSON 响应。\n适用于 Mac、Windows 和 Linux。","name":"Heynote","packageUrl":"https://heynote.com/","publisher":"Jonatan Heyman","publisherUrl":"https://heyman.info/","releaseNotesUrl":"https://github.com/heyman/heynote/releases/tag/v2.9.1","tags":[]}},"longDescription":"Heynote is a dedicated scratchpad for developers. It functions as a large persistent text buffer where you can write down anything you like. Works great for that Slack message you don't want to accidentally send, a JSON response from an API you're working with, notes from a meeting, your daily to-do list, etc.\nThe Heynote buffer is divided into blocks, and each block can have its own Language set (e.g. JavaScript, JSON, Markdown, etc.). This gives you syntax highlighting and lets you auto-format that JSON response.\nAvailable for Mac, Windows, and Linux.","name":"Heynote","packageUrl":"https://heynote.com/","publisher":"Jonatan Heyman","publisherUrl":"https://heyman.info/","releaseNotesUrl":"https://github.com/heyman/heynote/releases/tag/v2.9.1","tags":[]},"schemaVersion":1,"source":"winget","versions":[{"architectures":["x64"],"detailPath":"versions/2.9.1/app.json","detailSha256":"acd35e539d0b7ba04547c082cf9d839827ccac5e3b2b1b2efa8bd30e1cc897c6","releaseDate":"2026-07-15","releaseDateSource":"manifest","version":"2.9.1"},{"architectures":["x64"],"detailPath":"versions/2.9.0/app.json","detailSha256":"606e915e159b3e0bc516d3e4332a6e08bfd272f3433a3576b1e4555cc9df35c6","releaseDate":"2026-05-06","releaseDateSource":"manifest","version":"2.9.0"},{"architectures":["x64"],"detailPath":"versions/2.8.2/app.json","detailSha256":"a7a68242b56aeb4bb1f90f3794fabc7717b12f8495dc6dd4c6b25e2add6ecf12","releaseDate":"2026-02-11","releaseDateSource":"manifest","version":"2.8.2"},{"architectures":["x64"],"detailPath":"versions/2.8.1/app.json","detailSha256":"4c9907e8ad406c0fc09f8728036b95b8f014dcd37335ed16fb01f81607e78288","releaseDate":"2026-02-09","releaseDateSource":"manifest","version":"2.8.1"},{"architectures":["x64"],"detailPath":"versions/2.8.0/app.json","detailSha256":"26308f56245f7feae52437572d2721dbaafb71e0694475716aea23e39a23211f","releaseDate":"2026-02-04","releaseDateSource":"manifest","version":"2.8.0"},{"architectures":["x64"],"detailPath":"versions/2.7.2/app.json","detailSha256":"64fbee9b8a1204ee9ffc436