{"defaultLocale":"en-US","id":"JoeTaylor.WSJT-X","installers":[{"architecture":"x64","dependencies":[],"elevation":{"requirement":"elevationRequired","source":"inferred"},"id":"x64-machine-nullsoft","priority":1,"scope":"machine","sha256":"55d2154266a65cafe52ff387e546575c42e2e73a99ffd56857cafe4bef90584b","silent":{"arguments":"/S","source":"default"},"successCodes":[],"type":"nullsoft","uninstall":{"type":"productCode","value":"wsjtx 3.0.0"},"upgradeBehavior":"install","url":"https://github.com/WSJTX/wsjtx/releases/download/v3.0.0/wsjtx-3.0.0-win64.exe"},{"architecture":"x86","dependencies":[],"elevation":{"requirement":"elevationRequired","source":"inferred"},"id":"x86-machine-nullsoft","priority":1,"scope":"machine","sha256":"21bb9f4fc1278ff9caf2542705c4e73b7c49fb48f6dfccebe95e4727592f2cbd","silent":{"arguments":"/S","source":"default"},"successCodes":[],"type":"nullsoft","uninstall":{"type":"productCode","value":"wsjtx 3.0.0"},"upgradeBehavior":"install","url":"https://github.com/WSJTX/wsjtx/releases/download/v3.0.0/wsjtx-3.0.0-win32.exe"}],"licenseUrl":"https://github.com/WSJTX/wsjtx/blob/master/COPYING","packageLocalizations":{"en-US":{"description":"Weak signal ham radio communication","license":"GPL-3.0","licenseUrl":"https://github.com/WSJTX/wsjtx/blob/master/COPYING","locale":"en-US","longDescription":"WSJT-X is a computer program designed to facilitate basic amateur radio communication using very weak signals. The first four letters in the program name stand for “Weak Signal communication by K1JT,” while the suffix “-X” indicates that WSJT-X started as an extended branch of an earlier program, WSJT, first released in 2001. WSJT-X implements communication protocols or \"modes\" called FST4, FST4W, FT4, FT8, JT4, JT9, JT65, Q65, MSK144, and WSPR, as well as one called Echo for detecting and measuring your own radio signals reflected from the Moon.  These modes were designed for making reliable, confirmed QSOs under extreme weak-signal conditions.","name":"WSJT-X: Digital Modes for Weak Signal Communications in Amateur Radio","packageUrl":"https://wsjtx.github.io/wsjtx/","publisher":"Joe Taylor, K1JT","publisherUrl":"https://wsjtx.github.io/wsjtx/","releaseNotesUrl":"https://github.com/WSJTX/wsjtx/releases/download/v3.0.0/Release_Notes.txt","tags":["amateur-radio","ham-radio","radio"]},"zh-CN":{"description":"业余无线电弱信号通信","locale":"zh-CN","longDescription":"WSJT-X 是一个旨在方便业余无线电爱好者使用极弱信号进行基本通信的计算机程序。程序名称中的前四个字母代表“Weak Signal communication by K1JT”（K1JT 弱信号通信），而后缀“-X”则表示 WSJT-X 是 2001 年首次发布的早期程序 WSJT 的扩展分支。WSJT-X 实现了名为 FST4、FST4W、FT4、FT8、JT4、JT9、JT65、Q65、MSK144 和 WSPR 的通信协议或“模式”，以及一种名为“回声”的模式，用于探测和测量从月球反射回来的无线电信号。这些模式的设计目的是在信号极弱的条件下进行可靠的、可确认的 QSO。","tags":["业余无线电","无线电"]}},"publisherUrl":"https://wsjtx.github.io/wsjtx/","releaseDate":"2026-04-05","releaseDateSource":"manifest","releaseNotesUrl":"https://github.com/WSJTX/wsjtx/releases/download/v3.0.0/Release_Notes.txt","schemaVersion":1,"source":"winget","upstream":{"commit":"97d6aa2689f0a05f7847653a62b8624720d15b5d","manifestVersion":"1.9.0","manifests":[{"path":"manifests/j/JoeTaylor/WSJT-X/3.0.0/JoeTaylor.WSJT-X.yaml","sha256":"f0e20c212607b073d1a307a430e29009ba83d9a965346016c30deee212bb3f3a"},{"path":"manifests/j/JoeTaylor/WSJT-X/3.0.0/JoeTaylor.WSJT-X.installer.yaml","sha256":"729159a5790ed11fa12950e2fc62859a5c588039828bb83cc4515e119b7ecb77"},{"path":"manifests/j/JoeTaylor/WSJT-X/3.0.0/JoeTaylor.WSJT-X.locale.en-US.yaml","sha256":"196a8dbb34bb0afc0258e713881cd3348622a83ccbd26fd1142d422479933691"},{"path":"manifests/j/JoeTaylor/WSJT-X/3.0.0/JoeTaylor.WSJT-X.locale.zh-CN.yaml","sha256":"ad5978b96d84ddcf70791782187cba69bedad5f5b429d8ec032fe06a403420a2"}],"repository":"microsoft/winget-pkgs"},"version":"3.0.0"}