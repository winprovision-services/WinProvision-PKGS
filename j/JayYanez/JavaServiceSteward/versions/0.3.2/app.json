{"defaultLocale":"en-US","id":"JayYanez.JavaServiceSteward","installers":[{"architecture":"x64","dependencies":[],"id":"x64-zip","nestedInstallerFiles":[{"PortableCommandAlias":"java-service-steward","RelativeFilePath":"java-service-steward-0.3.2-windows-x64\\wrapper.exe"}],"nestedInstallerType":"portable","priority":4,"sha256":"070ae370b2df57ab3c9b1b9ce99f4f913464e4a189379fff1b0f8fe2f8b253eb","successCodes":[],"type":"zip","url":"https://github.com/jayyanez/java-service-steward/releases/download/v0.3.2/java-service-steward-0.3.2-windows-x64.zip"}],"licenseUrl":"https://github.com/jayyanez/java-service-steward/blob/main/LICENSE-APACHE","packageLocalizations":{"en-US":{"description":"Runs, controls, and monitors Java applications as Windows services; reads wrapper.conf-style configuration files.","license":"Apache-2.0 OR MIT","licenseUrl":"https://github.com/jayyanez/java-service-steward/blob/main/LICENSE-APACHE","locale":"en-US","longDescription":"Java Service Steward is a Windows service host for Java applications, written in Rust and released under Apache-2.0 OR MIT. It installs a Java application as a Windows service, launches and supervises the JVM over an authenticated loopback channel, restarts it when it fails or stops responding, rotates its log, and provides thread and heap dumps on demand. It reads the widely deployed wrapper.conf configuration format and follows its command-line conventions, so existing installations can switch to it in place. The package contains wrapper.exe and the bridge wrapper.jar; copy both next to your wrapper.conf.","moniker":"java-service-steward","name":"Java Service Steward","packageUrl":"https://jayyanez.github.io/java-service-steward/","publisher":"Jay Yanez","publisherUrl":"https://github.com/jayyanez","releaseNotesUrl":"https://github.com/jayyanez/java-service-steward/releases/tag/v0.3.2","tags":["java","jvm","service","windows-service","wrapper","supervisor"]}},"publisherUrl":"https://github.com/jayyanez","releaseDate":"20