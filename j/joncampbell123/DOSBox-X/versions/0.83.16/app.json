ulations so that you can play DOS/V and PC-98 games with it.","moniker":"dosbox-x","name":"DOSBox-X","packageUrl":"https://github.com/joncampbell123/dosbox-x","publisher":"joncampbell123 [DOSBox-X Team]","publisherUrl":"https://dosbox-x.com","tags":["dos","dos-emulator","dosbox"]}},"publisherUrl":"https://dosbox-x.com","schemaVersion":1,"source":"winget","upstream":{"commit":"97d6aa2689f0a05f7847653a62b8624720d15b5d","manifestVersion":"1.9.0","manifests":[{"path":"manifests/j/joncampbell123/DOSBox-X/0.83.16/joncampbell123.DOSBox-X.yaml","sha256":"9bb96a3e9db03ecc0760d61a00c449463f2c4d7da6e92164b562db797ac0ca7a"},{"path":"manifests/j/joncampbell123/DOSBox-X/0.83.16/joncampbell123.DOSBox-X.installer.yaml","sha256":"ee3882792fdf7a4e9ed9ebfe0e69780af21fc7588cecab7367db497b146d9ab7"},{"path":"manifests/j/joncampbell123/DOSBox-X/0.83.16/joncampbell123.DOSBox-X.locale.en-US.yaml","sha256":"0923d8259f0ec6f4701ae3df28bf918130055cb8de69783330d604c5a69a152c"}],"repository":"microsoft/winget-pkgs"},"version":"0.83.16"}