bell123/dosbox-x/master/COPYING","packageLocalizations":{"en-US":{"description":"DOSBox-X is an open-source DOS emulator for running DOS games and applications.","license":"GPL-2.0","licenseUrl":"https://raw.githubusercontent.com/joncampbell123/dosbox-x/master/COPYING","locale":"en-US","longDescription":"DOSBox-X emulates a PC necessary for running many DOS games and applications that simply cannot be run on modern PCs and operating systems, similar to DOSBox.\nHowever, while the main focus of DOSBox is for running DOS games, DOSBox-X goes much further than this.\nStarted as a fork of the DOSBox project, it retains compatibility with the wide base of DOS games and DOS gaming DOSBox was designed for.\nBut it is also a platform for running DOS applications, including emulating the environments to run Windows 3.x, 9x and ME and software written for those versions of Windows.\nBy adding official support for Windows 95, 98, ME emulation and acceleration, we hope that those old Windows games and applications could be enjoyed or used once more.\nMoreover, DOSBox-X adds support for DOS/V and NEC PC-98 emulations so that you can play DOS/V and PC-98 games with it.","moniker":"dosbox-x","name":"DOSBox-X","packageUrl":"https://github.com/joncampbell123/dosbox-x","publisher":"joncampbell123 [DOSBox-X Team]","publisherUrl":"https://dosbox-x.com/","releaseNotesUrl":"https://github.com/joncampbell123/dosbox-x/releases/tag/dosbox-x-v2025.01.01","tags":["dos","dos-emulator","dosbox"]}},"publisherUrl":"https://dosbox-x.com/","releaseDate":"2025-01-01","releaseDateSource":"manifest","releaseNotesUrl":"https://github.com/joncampbell123/dosbox-x/releases/tag/dosbox-x-v2025.01.01","schemaVersion":1,"source":"winget","upstream":{"commit":"97d6aa2689f0a05f7847653a62b8624720d15b5d","manifestVersion":"1.9.0","manifests":[{"path":"manifests/j/joncampbell123/DOSBox-X/2025.01.01/joncampbell123.DOSBox-X.yaml","sha256":"c58671af3fbb158ca3b756b40dc24818a241ee168eb819a43beda126f41e536c"},{"path":"m