{"architectures":["arm64","x64"],"id":"JetBrains.GoLand","latestVersion":"2026.3","media":{"icons":[{"mimeType":"image/png","path":"media/icon.326cc2dc.png","priority":1,"sha256":"326cc2dcd02eca3908df80523ec5a67ddd2332e0ca4ce2b657f3bcf9733cee72","source":"winget-legacy"}],"screenshots":[]},"package":{"author":"JetBrains s.r.o.","copyright":"Copyright © 2000-2026 JetBrains s.r.o.","description":"The complete IDE crafted for Gophers","documentations":[{"DocumentLabel":"Quick Start","DocumentUrl":"https://www.jetbrains.com/go/learn/"}],"license":"Proprietary","licenseUrl":"https://www.jetbrains.com/legal/docs/toolbox/user/","locale":"en-US","localizations":{"en-US":{"author":"JetBrains s.r.o.","copyright":"Copyright © 2000-2026 JetBrains s.r.o.","description":"The complete IDE crafted for Gophers","documentations":[{"DocumentLabel":"Quick Start","DocumentUrl":"https://www.jetbrains.com/go/learn/"}],"license":"Proprietary","licenseUrl":"https://www.jetbrains.com/legal/docs/toolbox/user/","locale":"en-US","moniker":"goland","name":"GoLand","packageUrl":"https://www.jetbrains.com/go/","privacyUrl":"https://www.jetbrains.com/legal/docs/privacy/privacy/","publisher":"JetBrains s.r.o.","publisherSupportUrl":"https://www.jetbrains.com/support/","publisherUrl":"https://www.jetbrains.com/","purchaseUrl":"https://www.jetbrains.com/go/buy/","releaseNotes":"GoLand 2026.3 is now available!\nGoLand 2026.3 brings JetBrains Air into your Go workflow, giving you one place to run coding agents and review their changes. The bundled profiler skill helps agents investigate performance problems with GoLand's tools. This release also improves Git worktrees, remote development, and Kubernetes workflows.\nThe most prominent highlights of this release are:\n- Work with your preferred coding agents in JetBrains Air, use existing subscriptions, and give feedback directly from your code or the diff.\n- Capture and analyze Go profiles with an agent using the bundled profiler skill.\n- Copy local project settings and files into new Git worktrees and run custom setup scripts.\n- Start working on remote projects sooner with Light mode and use native OpenSSH support.\n- Create database connections for Kubernetes pods and Docker containers, and browse and edit files inside Kubernetes pods.\n- Send Figma design context to an agent with the Figma Connect plugin.\n- Use the new Home window for quick edits, terminal commands, and Git actions without opening a project.\n- Hear sound cues for IDE events, editor line marks, and agent activity.\n- Benefit from fixes to significant IDE freezes and automatic error and freeze reporting.\nFor a complete rundown of the new features, visit our What's New page.","releaseNotesUrl":"https://youtrack.jetbrains.com/articles/GO-A-231736104","tags":["code","coding","develop","development","go","golang","ide","programming"]},"zh-CN":{"description":"为 Go 开发者打造的完整 IDE","documentations":[{"DocumentLabel":"快速入门","DocumentUrl":"https://www.jetbrains.com/zh-cn/go/learn/"}],"license":"专有软件","locale":"zh-CN","packageUrl":"https://www.jetbrains.com/zh-cn/go/","publisherSupportUrl":"https://www.jetbrains.com/zh-cn/support/","publisherUrl":"https://www.jetbrains.com/zh-cn/","purchaseUrl":"https://www.jetbrains.com/zh-cn/go/buy/","releaseNotesUrl":"https://youtrack.jetbrains.com/articles/GO-A-231736104","tags":["go","golang","代码","开发","编程","集成开发环境"]}},"moniker":"goland","name":"GoLand","packageUrl":"https://www.jetbrains.com/go/","privacyUrl":"https://www.jetbrains.com/legal/docs/privacy/privacy/","publisher":"JetBrains s.r.o.","publisherSupportUrl":"https://www.jetbrains.com/support/","publisherUrl":"https://www.jetbrains.com/","purchaseUrl":"https://www.jetbrains.com/go/buy/","releaseNotes":"GoLand 2026.3 is now available!\nGoLand 2026.3 brings JetBrains Air into your Go workflow, giving you one place to run coding agents and review their changes. The bundled profiler skill helps agents investigate performance problems with GoLand's tools. This release also improves Git worktrees, remote development, and Kubernetes workflows.\nThe most prominent highlights of this release are:\n- Work with your preferred coding agents in JetBrains Air, use existing subscriptions, and give feedback directly from your code or the diff.\n- Capture and analyze Go profiles with an agent using the bundled profiler skill.\n- Copy local project settings and files into new Git worktrees and run custom setup scripts.\n- Start working on remote projects sooner with Light mode and use native OpenSSH support.\n- Create database connections for Kubernetes pods and Docker containers, and browse and edit files inside Kubernetes pods.\n- Send Figma design context to an agent with the Figma Connect plugin.\n- Use the new Home window for quick edits, terminal commands, and Git actions without opening a project.\n- Hear sound cues for IDE events, editor line marks, and agent activity.\n- Benefit from fixes to significant IDE freezes and automatic error and freeze reporting.\nFor a complete rundown of the new features, visit our What's New page.","releaseNotesUrl":"https://youtrack.jetbrains.com/articles/GO-A-231736104","tags":["code","coding","develop","development","go","golang","ide","programming"]},"schemaVersion":1,"source":"winget","versions":[{"architectures":["arm64","x64"],"detailPath":"versions/2026.3/app.json","detailSha256":"ae3fc08a2e56529187c6d53b1709c9c31e3c5809e2757185b90a7d608561db0f","releaseDate":"2026-11-05","releaseDateSource":"commit","version":"2026.3"},{"architectures":["arm64","x64"],"detailPath":"versions/2026.2.4/app.json","detailSha256":"b3be0bcd83b8ec6faf22fe8447f0f91cb32e50f06a034e842de711a7ce8fbff5","releaseDate":"2026-10-30","releaseDateSource":"manifest","version":"2026.2.4"},{"architectures":["arm64","x64"],"detailPath":"versions/2026.2.3/app.json","detailSha256":"e8981b60c10d8306886094e9552946bea23fbd5ba3a2a7b50b97bd97ff169582","releaseDate":"2026-09-16","releaseDateSource":"manifest","version":"2026.2.3"},{"