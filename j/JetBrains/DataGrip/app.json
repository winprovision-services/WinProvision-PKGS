{"architectures":["arm64","x64"],"id":"JetBrains.DataGrip","latestVersion":"2026.3","media":{"icons":[{"mimeType":"image/png","path":"media/icon.0bc851c0.png","priority":1,"sha256":"0bc851c0af01d645dc849bb2f63d0690d73740e0fe04c1bb769f5e4ba8424c9d","source":"winget-legacy"}],"screenshots":[]},"package":{"author":"JetBrains s.r.o.","copyright":"Copyright © 2000-2026 JetBrains s.r.o.","description":"The Cross-Platform IDE for Databases & SQL by JetBrains","documentations":[{"DocumentLabel":"Documentation","DocumentUrl":"https://www.jetbrains.com/help/datagrip/"}],"license":"Proprietary","licenseUrl":"https://www.jetbrains.com/legal/docs/toolbox/user/","locale":"en-US","localizations":{"en-US":{"author":"JetBrains s.r.o.","copyright":"Copyright © 2000-2026 JetBrains s.r.o.","description":"The Cross-Platform IDE for Databases & SQL by JetBrains","documentations":[{"DocumentLabel":"Documentation","DocumentUrl":"https://www.jetbrains.com/help/datagrip/"}],"license":"Proprietary","licenseUrl":"https://www.jetbrains.com/legal/docs/toolbox/user/","locale":"en-US","longDescription":"A powerful IDE from JetBrains for SQL on macOS, Windows, and Linux.","moniker":"datagrip","name":"DataGrip","packageUrl":"https://www.jetbrains.com/datagrip/","privacyUrl":"https://www.jetbrains.com/legal/docs/privacy/privacy/","publisher":"JetBrains s.r.o.","publisherSupportUrl":"https://www.jetbrains.com/support/","publisherUrl":"https://www.jetbrains.com/","purchaseUrl":"https://www.jetbrains.com/datagrip/buy/","releaseNotes":"AI\n- The bundled JetBrains Air lets you run SQL, explore data, and reference database objects directly in chats with AI agents.\nConnectivity\n- DataGrip now supports cross-database queries.\n- DuckDB is fully supported.\n- Database connections are disabled in untrusted projects.\nUI and UX improvements\n- Query results now appear in the dedicated Database Output tool window.\n- The tool window bar and default shortcuts have been updated.\nWorking with data\n- The new Open in Editor Tab toolbar button opens a query result set in a separate tab in the main editor area.\n- The new SQL toolbar button opens a query result set’s original query.\n- The ability to pin columns has been added to the data editor.\n- The new Manage Columns popup lets you find columns, select the ones to display, pin them, and adjust their order.\n- Automatic column sizing has been added to the data editor.\nQuery consoles\n- Transaction control in query consoles received a few improvements.\nDatabase support\n- MariaDB sequences and packages are now supported.\n- PostgreSQL 19 is now supported.","releaseNotesUrl":"https://youtrack.jetbrains.com/articles/DBE-A-83165563","tags":["database","db2","develop","development","ide","mssql","mysql","postgres","programming","sql","sqlite"]},"zh-CN":{"description":"由 JetBrains 开发的数据库和 SQL 跨平台 IDE","documentations":[{"DocumentLabel":"文档","DocumentUrl":"https://www.jetbrains.com/help/datagrip/"}],"license":"专有软件","locale":"zh-CN","longDescription":"JetBrains 为 macOS、Windows 和 Linux 的 SQL 开发的强大 IDE。","packageUrl":"https://www.jetbrains.com/zh-cn/datagrip/","publisherSupportUrl":"https://www.jetbrains.com/zh-cn/support/","publisherUrl":"https://www.jetbrains.com/zh-cn/","purchaseUrl":"https://www.jetbrains.com/zh-cn/datagrip/buy/","releaseNotesUrl":"https://youtrack.jetbrains.com/articles/DBE-A-83165563","tags":["db2","mssql","mysql","postgres","sql","sqlite","代码","开发","数据库","编程","集成开发环境"]}},"longDescription":"A powerful IDE from JetBrains for SQL on macOS, Windows, and Linux.","moniker":"datagrip","name":"DataGrip","packageUrl":"https://www.jetbrains.com/datagrip/","privacyUrl":"https://www.jetbrains.com/legal/docs/privacy/privacy/","publisher":"JetBrains s.r.o.","publisherSupportUrl":"https://www.jetbrains.com/support/","publisherUrl":"https://www.jetbrains.com/","purchaseUrl":"https://www.jetbrains.com/datagrip/buy/","releaseNotes":"AI\n- The bundled JetBrains Air lets you run SQL, explore data, and reference database objects directly in chats with AI agents.\nConnectivity\n- DataGrip now supports cross-database queries.\n- DuckDB is fully supported.\n- Database connections are disabled in untrusted projects.\nUI and UX improvements\n- Query results now appear in the dedicated Database Output tool window.\n- The tool window bar and default shortcuts have been updated.\nWorking with data\n- The new Open in Editor Tab toolbar button opens a query result set in a separate tab in the main editor area.\n- The new SQL toolbar button opens a query result set’s original query.\n- The ability to pin columns has been added to the data editor.\n- The new Manage Columns popup lets you find columns, select the ones to display, pin them, and adjust their order.\n- Automatic column sizing has been added to the data editor.\nQuery consoles\n- Transaction control in query consoles received a few improvements.\nDatabase support\n- MariaDB sequences and packages are now supported.\n- PostgreSQL 19 is now supported.","releaseNotesUrl":"https://youtrack.jetbrains.com/articles/DBE-A-83165563","tags":["database","db2","develop","development","ide","mssql","mysql","postgres","programming","sql","sqlite"]},"schemaVersion":1,"source":"winget","versions":[{"architectures":["arm64","x64"],"detailPath":"versions/2026.3/app.json","detailSha256":"8177313b3ff6e54438da22dac2bdf165ce8dc028834b419732e2a112d4d62710","releaseDate":"2026-11-05","releaseDateSource":"commit","version":"2026.3"},{"architectures":["arm64","x64"],"detailPath":"versions/2026.2.6.1/app.json","detailSha256":"5685e620c1f2699bc7e87766efaac9f61f9888f5d26091ae24d55d8de9dfd835","releaseDate":"2026-10-30","releaseDateSource":"manifest","version":"2026.2.6.1"},{"architectures":["arm64","x64"],"detailPath":"versions/2026.2.6/app.json","detailSha256":"39bf5877bb168578a1ebae81bd960f062781b1f5e43905656ceceab8db144ec8","releaseDate":"2026-09-29","releaseDateSource":"manifest","version":"2026.2.6"},{"architectures":["arm64","x64"],"detailPath":"versions/2026