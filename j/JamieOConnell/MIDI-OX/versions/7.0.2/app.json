{"defaultLocale":"en-US","id":"JamieOConnell.MIDI-OX","installers":[{"appsAndFeaturesEntries":[{"DisplayVersion":"7.02.372","ProductCode":"{A6457851-5EA9-45B0-AF1D-D2A0A4781CFB}"}],"architecture":"x86","dependencies":[],"elevation":{"requirement":"elevationRequired","source":"inferred"},"id":"x86-machine-exe","installerSwitches":{"Silent":"/auto /args=\"/quiet /norestart\"","SilentWithProgress":"/auto /args=\"/passive /norestart\""},"minimumOSVersion":"10.0.0.0","priority":1,"scope":"machine","sha256":"16469593531764aeeda2fde8819b894b76243e233fd009d732193daa9db72385","silent":{"arguments":"/auto /args=\"/quiet /norestart\"","source":"manifest"},"successCodes":[],"type":"exe","url":"http://www.midiox.com/zip/midioxse.exe"}],"packageLocalizations":{"en-US":{"description":"Multi-purpose MIDI tool","license":"Freeware","locale":"en-US","longDescription":"MIDI-OX is a multi-purpose tool: it is both a diagnostic tool and a System Exclusive librarian. It can perform filtering and mapping of MIDI data streams.\nIt displays incoming MIDI streams, and passes the data to a MIDI output driver or the MIDI Mapper. You can generate MIDI data using the computer keyboard\nor the built-in control panel. You can even record and log MIDI data and then convert it to a Standard MIDI File for playback by a sequencer.","name":"MIDI-OX","packageUrl":"http://www.midiox.com/","publisher":"MIDIOX Computing","releaseNotesUrl":"http://www.midiox.com/moxchg.htm","tags":["midi"]}},"releaseNotesUrl":"http://www.midiox.com/moxchg.htm","schemaVersion":1,"source":"winget","upstream":{"commit":"97d6aa2689f0a05f7847653a62b8624720d15b5d","manifestVersion":"1.2.0","manifests":[{"path":"manifests/j/JamieOConnell/MIDI-OX/7.0.2/JamieOConnell.MIDI-OX.yaml","sha256":"20ccc8874962dfdcbe5006aea73ff39a69accd30f4cfa0815023b35196242137"},{"path":"manifests/j/JamieOConnell/MIDI-OX/7.0.2/JamieOConnell.MIDI-OX.installer.yaml","sha256":"9ccf31b62d1409ba10d2646271d501471536daf9a2d49dd4b70cb4a1e0b19f54"},{"path":"manifes