{"defaultLocale":"en-US","id":"jefuriiij.PingMeter","installers":[{"architecture":"x64","commands":["pingmeter"],"dependencies":[{"PackageDependencies":[{"PackageIdentifier":"Microsoft.DotNet.DesktopRuntime.8"}]}],"id":"x64-portable","minimumOSVersion":"10.0.22000.0","platforms":["Windows.Desktop"],"priority":4,"sha256":"04c33219a8a75349983791fc101a8fbb2179fd5be4aa6af8c3ac10590fdf8af2","successCodes":[],"type":"portable","url":"https://github.com/jefuriiij/ping-meter/releases/download/v0.2.0/PingMeter.exe"}],"licenseUrl":"https://github.com/jefuriiij/ping-meter/blob/main/LICENSE","packageLocalizations":{"en-US":{"description":"Taskbar-embedded ping monitor for Windows 11","license":"MIT","licenseUrl":"https://github.com/jefuriiij/ping-meter/blob/main/LICENSE","locale":"en-US","longDescription":"PingMeter shows your live ping (ms) embedded directly in the Windows 11 taskbar,\nnext to the tray clock — on the primary taskbar, secondary-monitor taskbars, or all\nof them. It replaces keeping \"ping google.com -t\" open in a terminal: color-coded\nlatency with configurable thresholds, a sparkline of recent pings, hover stats\n(min/avg/max/loss), quick switching between preset targets, timeouts shown at a\nglance, and a daily network event log that records outages, latency spikes, and\nhourly summaries. Runs without admin rights and survives Explorer restarts.","name":"PingMeter","packageUrl":"https://github.com/jefuriiij/ping-meter","publisher":"jefuriiij","publisherUrl":"https://github.com/jefuriiij","releaseNotesUrl":"https://github.com/jefuriiij/ping-meter/releases/tag/v0.2.0","tags":["latency","monitor","network","ping","taskbar"]}},"publisherUrl":"https://github.com/jefuriiij","releaseDate":"2026-07-20","releaseDateSource":"manifest","releaseNotesUrl":"https://github.com/jefuriiij/ping-meter/releases/tag/v0.2.0","schemaVersion":1,"source":"winget","upstream":{"commit":"97d6aa2689f0a05f7847653a62b8624720d15b5d","manifestVersion":"1.6.0","manifests":[{"path":"manifests