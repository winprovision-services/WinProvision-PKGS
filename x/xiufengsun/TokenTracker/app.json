{"architectures":["x64"],"id":"xiufengsun.TokenTracker","latestVersion":"1.5.6","media":{"icons":[],"screenshots":[]},"package":{"description":"Local-first AI token usage & cost tracker for 29 AI coding tools — with native apps. Never reads prompts.","license":"MIT","licenseUrl":"https://github.com/xiufengsun/TokenTracker/blob/HEAD/LICENSE","locale":"en-US","localizations":{"en-US":{"description":"Local-first AI token usage & cost tracker for 29 AI coding tools — with native apps. Never reads prompts.","license":"MIT","licenseUrl":"https://github.com/xiufengsun/TokenTracker/blob/HEAD/LICENSE","locale":"en-US","longDescription":"TokenTracker is an accurate, local-first token usage and cost dashboard for 29 AI coding tools including Claude Code, Codex, Cursor, Gemini, and Qoder. It automatically collects token usage and aggregates everything locally, with a desktop pet, 4 native widgets, and 15 achievement tracks. No cloud account, no API keys, no setup. The Windows app runs as a system-tray companion that never reads your prompts.","name":"TokenTracker","packageUrl":"https://github.com/xiufengsun/TokenTracker","publisher":"xiufengsun","publisherUrl":"https://github.com/xiufengsun","releaseNotesUrl":"https://github.com/xiufengsun/TokenTracker/releases/tag/v1.5.6","tags":["ai","cost","tokens","tracker","usage"]},"zh-CN":{"description":"跨所有 CLI，看清你到底在 AI 上花了多少钱。","locale":"zh-CN","longDescription":"TokenTracker 自动采集 29 款 AI 编码工具（包括 Claude Code、Codex、Cursor、Gemini、Qoder 等）的 token 用量，全程本地聚合，用一套漂亮的 Dashboard 看真实成本与趋势。不需要云账号、不需要 API Key、不需要任何配置。桌面端以系统托盘形式常驻，附赠桌面宠物、4 个原生小组件与 15 条成就线。绝不读取你的提示词内容。","tags":["人工智能","消费","用量","花费","词元","跟踪"]}},"longDescription":"TokenTracker is an accurate, local-first token usage and cost dashboard for 29 AI coding tools including Claude Code, Codex, Cursor, Gemini, and Qoder. It automatically collects token usage and aggregates everything locally, with a desktop pet, 4 native widgets, and 15 achievement tracks. No cloud account, no API keys, no setup. The Windows app runs as a system-tray companion that never reads your prompts.","name":"TokenTracker","packageUrl":"https://github.com/xiufengsun/TokenTracker","publisher":"xiufengsun","publisherUrl":"https://github.com/xiufengsun","releaseNotesUrl":"https://github.com/xiufengsun/TokenTracker/releases/tag/v1.5.6","tags":["ai","cost","tokens","tracker","usage"]},"schemaVersion":1,"source":"winget","versions":[{"architectures":["x64"],"detailPath":"versions/1.5.6/app.json","detailSha256":"589420eb98d2bbb638b7355a7f0a14e61a0f2b7e35ecdef5fbc09d79ed2655f0","releaseDate":"2026-11-04","releaseDateSource":"manifest","version":"1.5.6"},{"architectures":["x64"],"detailPath":"versions/1.5.4/app.json","detailSha256":"e8c30a8c7958da582bf2447ac4a3158713ea8bc6d40e58e1d2ebcef5ed919f5d","releaseDate":"2026-11-03","releaseDateSource":"manifest","version":"1.5.4"},{"architectures":["x64"],"detailPath":"versions/1.5.3/app.json","detailSha256":"0677e3c8ee34537dfd2750752b97089f3a69a2c994144201953ebc16bfc741f3","releaseDate":"2026-11-02","releaseDateSource":"manifest","version":"1.5.3"},{"architectures":["x64"],"detailPath":"versions/1.5.2/app.json","detailSha256":"84faa318975aefd92319d0b67bb03b3643714a238ad4f864e09644a3e4041d29","releaseDate":"2026-10-31","releaseDateSource":"manifest","version":"1.5.2"},{"architectures":["x64"],"detailPath":"versions/1.5.1/app.json","detailSha256":"4f41fa8135c1f20c63e5ff484619121d4db2832d1f17d8cc2c1aff7c5be5f83f","releaseDate":"2026-10-29","releaseDateSource":"manifest","version":"1.5.1"},{"architectures":["x64"],"detailPath":"versions/1.5.0/app.json","detailSha256":"bc4e30bc60c1dd7238140a8219f810d9b65d4b37e2826f621756a335fe556ed2","releaseDate":"2026-10-28","releaseDateSource":"manifest","version":"1.5.0"},{"architectures":["x64"],"detailPath":"versions/1.4.14/app.json","detailSha256":"606001c084e25ff2d435a68a5505bbdf98bd20a3ba45e7c9d49155afd0fdfb6c","releaseDate":"2026-10-27","releaseDateSource":"manifest","version":"1.4.14"},{"architectures":