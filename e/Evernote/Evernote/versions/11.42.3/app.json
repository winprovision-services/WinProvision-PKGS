ches":{"Custom":"/allusers"},"priority":1,"protocols":["en","evernote"],"scope":"machine","sha256":"4dd45a4915fc9872668ebd95e3759eb3fc82cd0de2380e67e8412411384ea068","successCodes":[],"type":"nullsoft","uninstall":{"type":"productCode","value":"e4251011-875e-51f3-a464-121adaff5aaa"},"upgradeBehavior":"install","url":"https://win.desktop.evernote.com/builds/Evernote-11.42.3-win-ddl-stage-20261109120314-59b98c458b1a198f0c07138fdde4b619ec3c2870-setup.exe"}],"licenseUrl":"https://evernote.com/legal/terms-of-service","packageLocalizations":{"en-US":{"author":"Evernote Corporation","copyright":"© 2019 - 2026 Evernote Corporation. All rights reserved.","copyrightUrl":"https://evernote.com/legal/trademark-use","description":"Remember everything and tackle any project with your notes, tasks, and schedule all in one place.","license":"Proprietary","licenseUrl":"https://evernote.com/legal/terms-of-service","locale":"en-US","longDescription":"Evernote helps you focus on what matters most and have access to your information when you need it. Input typed notes or scan handwritten notes. Add to-do’s, photos, images, web pages, or audio ... and it’s all instantly searchable. Organize notes any way you want and share with anyone. And Evernote syncs across your devices so your information is always with you, everywhere you go.","moniker":"evernote","name":"Evernote","packageUrl":"https://evernote.com/download","privacyUrl":"https://evernote.com/privacy/policy","publisher":"Evernote Corporation","publisherSupportUrl":"https://help.evernote.com/","publisherUrl":"https://evernote.com/","purchaseUrl":"https://evernote.com/compare-plans","releaseNotes":"✨ Features:\n- Keep your table headers in view: freeze columns so they stay visible as you scroll horizontally.\n- Reactions are here: select any text, pick an emoji from the inline toolbar, and everyone with access to the note can react.\n- Meeting recordings started from notifications are saved in a note titled with the meeting's date and time, so you always know which call it was.\n\n🛠️ Fixes:\n- Templates: additional import fixes.\n- After verifying your email via a shared notebook invite, you go directly to the notebook you were trying to open.\n- Transcribing an image immediately after adding it no longer fails with a generic error.\n- Hovering over the disabled transcript button on an audio recording now explains why there is no transcript and lets you enable automatic transcription.\n- A table's horizontal scrollbar now appears only when the table overflows.\n- On touchscreens, tabs and filter chips no longer remain highlighted after you tap them.","tags":["9wzdncrfj3mb","ai-assistant","artificial-intelligence-assistant","calendar","checklist","collaborate","collaboration","list","memo","memorandum","notes","schedule","task","to-do","todo"]},"zh-CN":{"copyright":"© 2019 - 2026 Evernote Corporation。保留所有权利。","description":"在一处记住所有内容，并通过笔记、任务和日程处理一切。","license":"专有软件","locale":"zh-CN","longDescription":"Evernote 可帮助您专注于最重要的事情，并在需要时获取信息。输入打字笔记或扫描手写笔记，添加待办事项、照片、图片、网页或音频……并且所有内容都可即时搜索。以任何方式组织笔记，并与任何人共享。Evernote 还能在您的设备间同步，让你的信息随时随地与你同在。","tags":["任务","列表","协作","协同","备忘","备忘录","待办","待办事项","提醒事项","日历","日程","清单","笔记"]}},"publisherSupportUrl":"https://help.evernote.com/","publisherUrl":"https://evernote.com/","releaseDate":"2026-11-12","releaseDateSource":"commit","schemaVersion":1,"source":"winget","upstream":{"commit":"d0a62575c1d9c1074cee2276033c43cc6776e313","manifestVersion":"1.28.0","manifests":[{"path":"manifests/e/Evernote/Evernote/11.42.3/Evernote.Evernote.installer.yaml","sha256":"68ec70183c697398ffa77e082b1715e1de9daa27c08b68a1ac1ec8f169c111bf"},{"path":"manifests/e/Evernote/Evernote/11.42.3/Evernote.Evernote.locale.en-US.yaml","sha256":"59975a7fcad26cf763f17947c32f5d242ff51cdcef3be2c8cbc7dbfeab4532d1"},{"path":"manifests/e/Evernote/Evernote/11.42.3/Evernote.Evernote.locale.zh-CN.yaml","sha256":"795cb92996206f641652c69dab4bde0afbd2328f6e9a98d67679ff37b5ea921e"},{"path":"manifests/e/Evernote/