icant deviations from the Chromium, such as branding, configuration formats, file locations, and other interface changes.\nungoogled-chromium will not modify the Chromium browser outside of the project's goals.\nSince these goals and requirements are not precise, unclear situations are discussed and decided on a case-by-case basis.","moniker":"ungoogled-chromium","name":"Chromium","packageUrl":"https://github.com/ungoogled-software/ungoogled-chromium-windows/releases","publisher":"The Chromium Authors","publisherUrl":"https://github.com/ungoogled-software/ungoogled-chromium-windows","tags":["browser","chromium","ungoogled"]}},"publisherUrl":"https://github.com/ungoogled-software/ungoogled-chromium-windows","releaseDate":"2022-08-04","releaseDateSource":"manifest","schemaVersion":1,"source":"winget","upstream":{"commit":"97d6aa2689f0a05f7847653a62b8624720d15b5d","manifestVersion":"1.9.0","manifests":[{"path":"manifests/e/eloston/ungoogled-chromium/123.0.6312.105/eloston.ungoogled-chromium.yaml","sha256":"01a192d78d7111654cf2a456f89b8e4349061a7947fb4e2964f58bd5b25464a7"},{"path":"manifests/e/eloston/ungoogled-chromium/123.0.6312.105/eloston.ungoogled-chromium.installer.yaml","sha256":"72dc896e8b85faee7169988096efd471ed991e46f30d3761f00720b37fc9a2bb"},{"path":"manifests/e/eloston/ungoogled-chromium/123.0.6312.105/eloston.ungoogled-chromium.locale.en-US.yaml","sha256":"b9a1cf59976affd8c53c25176b1ce0997712d14a7466cdde5b737e1ee08c09f8"}],"repository":"microsoft/winget-pkgs"},"version":"123.0.6312.105"}