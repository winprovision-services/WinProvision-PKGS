icant deviations from the Chromium, such as branding, configuration formats, file locations, and other interface changes.\nungoogled-chromium will not modify the Chromium browser outside of the project's goals.\nSince these goals and requirements are not precise, unclear situations are discussed and decided on a case-by-case basis.","moniker":"ungoogled-chromium","name":"Chromium","packageUrl":"https://github.com/ungoogled-software/ungoogled-chromium-windows/releases","publisher":"The Chromium Authors","publisherUrl":"https://github.com/ungoogled-software/ungoogled-chromium-windows","tags":["browser","chromium","ungoogled"]}},"publisherUrl":"https://github.com/ungoogled-software/ungoogled-chromium-windows","releaseDate":"2022-08-04","releaseDateSource":"manifest","schemaVersion":1,"source":"winget","upstream":{"commit":"97d6aa2689f0a05f7847653a62b8624720d15b5d","manifestVersion":"1.9.0","manifests":[{"path":"manifests/e/eloston/ungoogled-chromium/121.0.6167.160/eloston.ungoogled-chromium.yaml","sha256":"15b532ab2dbb697b498d83c3a74722f0e73b0c889958967ffbc56d0e03990c9a"},{"path":"manifests/e/eloston/ungoogled-chromium/121.0.6167.160/eloston.ungoogled-chromium.installer.yaml","sha256":"3efd8431dfb134dd48991a893d7a356450c3c9f59c380459d7a53788de2278fb"},{"path":"manifests/e/eloston/ungoogled-chromium/121.0.6167.160/eloston.ungoogled-chromium.locale.en-US.yaml","sha256":"92754b151df989f02fa9048e21f537958d4e12975907ccf521ba118def3f8ff2"}],"repository":"microsoft/winget-pkgs"},"version":"121.0.6167.160"}