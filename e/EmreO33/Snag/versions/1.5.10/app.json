{"defaultLocale":"en-US","id":"EmreO33.Snag","installers":[{"appsAndFeaturesEntries":[{"DisplayName":"Snag","InstallerType":"inno","ProductCode":"{CF8CC397-F68D-4940-8897-10A39126914A}_is1","Publisher":"EmreO33"}],"architecture":"x64","dependencies":[],"id":"x64-user-inno","installModes":["interactive","silent","silentWithProgress"],"installerSwitches":{"Custom":"/CURRENTUSER"},"priority":1,"scope":"user","sha256":"c60ec47fbc06c69d16ab77580579ba5f983329be1290abafc1755864e1b4a8c5","successCodes":[],"type":"inno","uninstall":{"type":"registryKey","value":"{CF8CC397-F68D-4940-8897-10A39126914A}_is1"},"upgradeBehavior":"install","url":"https://github.com/EmreO33/snag/releases/download/v1.5.10/Snag-1.5.10-windows-setup.exe"},{"appsAndFeaturesEntries":[{"DisplayName":"Snag","InstallerType":"inno","ProductCode":"{CF8CC397-F68D-4940-8897-10A39126914A}_is1","Publisher":"EmreO33"}],"architecture":"x64","dependencies":[],"elevation":{"requirement":"elevatesSelf","source":"manifest"},"id":"x64-machine-inno","installModes":["interactive","silent","silentWithProgress"],"installerSwitches":{"Custom":"/ALLUSERS"},"priority":1,"scope":"machine","sha256":"c60ec47fbc06c69d16ab77580579ba5f983329be1290abafc1755864e1b4a8c5","successCodes":[],"type":"inno","uninstall":{"type":"registryKey","value":"{CF8CC397-F68D-4940-8897-10A39126914A}_is1"},"upgradeBehavior":"install","url":"https://github.com/EmreO33/snag/releases/download/v1.5.10/Snag-1.5.10-windows-setup.exe"}],"licenseUrl":"https://github.com/EmreO33/snag/blob/main/LICENSE","packageLocalizations":{"en-US":{"description":"A small, fast, native desktop video downloader built on yt-dlp.","license":"GPL-3.0-or-later","licenseUrl":"https://github.com/EmreO33/snag/blob/main/LICENSE","locale":"en-US","longDescription":"Snag is a native desktop front end for yt-dlp, written in Rust with no webview\nand no bundled runtime. Paste a link, choose whether you want video with audio,\naudio only, or video with the audio dropped, and it downloads.\n\nIt also remuxes files you already have: change container, extract audio, mute,\nor convert to GIF, all through ffmpeg.\n\nRestricted YouTube videos work too. Snag has no login form and never asks for\na password: you sign in to YouTube in your own browser, pick that browser, and\nSnag borrows the session for YouTube links only.\n\nSnag does not ship yt-dlp. On first launch it offers to download the current\nrelease from the yt-dlp project's own GitHub releases, and keeps it updated for\nyou. It also finds ffmpeg, which merging and converting need, or installs it\nfor you through winget (Gyan.FFmpeg).","moniker":"snag","name":"Snag","packageUrl":"https://github.com/EmreO33/snag","privacyUrl":"https://github.com/EmreO33/snag/blob/main/PRIVACY.md","publisher":"EmreO33","publisherSupportUrl":"https://github.com/EmreO33/snag/issues","publisherUrl":"https://github.com/EmreO33","releaseNotesUrl":"https://github.com/EmreO33/snag/releases/tag/v1.5.10","tags":["download","downloader","ffmpeg","media","video","youtube","yt-dlp"]}},"publisherSupportUrl":"https://github.com/EmreO33/snag/issues","publisherUrl":"https://github.com/EmreO33","releaseDate":"2026-11-06","releaseDateSource":"commit","releaseNotesUrl":"https://github.com/EmreO33/snag/releases/tag/v1.5.10","schemaVersion":1,"source":"winget","upstream":{"commit":"e0f8888d5e5cba2c0dff68718561442a5ca3345e","manifestVersion":"1.28.0","manifests":[{"path":"manifests/e/EmreO33/Snag/1.5.10/EmreO33.Snag.installer.yaml","sha256":"92719fbe1e700763782b0b9796f360573a160af5c4ac0052651f11919eaa2652"},{"path":"manifests/e/EmreO33/Snag/1.5.10/EmreO33.Snag.locale.en-US.yaml","sha256":"6d824e2180081f6dbafae6bda42d8322a5937a9ed6af0a4f2c88afd7b92cb370"},{"path":"manifests/e/EmreO33/Snag/1.5.10/EmreO33.Snag.yaml","sha256":"e85ed78f2092851e8144e79a62f078af3ad3bec890c061ef45398a7c967ffbdf"}],"repository":"microsoft/winget-pkgs"},"version":"1.5.10"}