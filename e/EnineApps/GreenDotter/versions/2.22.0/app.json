{"defaultLocale":"en-US","id":"EnineApps.GreenDotter","installers":[{"architecture":"x64","dependencies":[],"id":"x64-user-nullsoft","installModes":["interactive","silent","silentWithProgress"],"priority":1,"scope":"user","sha256":"f866d26bfc2f03d9f384a354ccfa5752b14cf27332ac4aa5dff65b83c91a48b1","successCodes":[],"type":"nullsoft","upgradeBehavior":"install","url":"https://green-dotter.com/download/windows/2.22.0"}],"packageLocalizations":{"en-US":{"description":"Keeps your computer active with gentle mouse movement or controlled clicks in an area you choose.","license":"Proprietary","locale":"en-US","longDescription":"Green Dotter keeps a computer registering as active, so it does not go idle, sleep or start the\nscreensaver while you are still at your desk.\n\nTwo modes: Wiggle moves the cursor in a smooth, natural pattern without clicking anything, and\nClick sends clicks only inside a screen area you draw yourself, at a randomised interval you set.\nIt pauses automatically the moment you touch the mouse or keyboard, and resumes after a delay you\nchoose. A global emergency stop is always available.\n\nNo account, no sign-in, and no ads.","name":"Green Dotter","packageUrl":"https://green-dotter.com/","privacyUrl":"https://green-dotter.com/privacy/","publisher":"EnineApps","publisherSupportUrl":"https://green-dotter.com/contact/","publisherUrl":"https://green-dotter.com/","tags":["auto-clicker","automation","idle","keep-awake","mouse","mouse-jiggler","mouse-mover","presence","screensaver","utility"]}},"publisherSupportUrl":"https://green-dotter.com/contact/","publisherUrl":"https://green-dotter.com/","releaseDate":"2026-11-11","releaseDateSource":"commit","schemaVersion":1,"source":"winget","upstream":{"commit":"06fe0c1922ea63380b4e7a9b4a957cc117ac9fe3","manifestVersion":"1.6.0","manifests":[{"path":"manifests/e/EnineApps/GreenDotter/2.22.0/EnineApps.GreenDotter.installer.yaml","sha256":"b29945c3dfc666503be467d2139cf150dd1aad620d27e72378b8c9fe3cb57642"},{"path":"